open Finset
section Ledger
variable {K L X : Type*} (E : K → X → Type*)
  (target : ∀ k x, E k x → X) (update : ∀ k, L → (x : X) → E k x → L)

def finiteLedgerEventTarget (k : K) (s : L × X) (e : E k s.2) : L × X :=
  (update k s.1 s.2 e, target k s.2 e)

def finiteEventPathLedger : ∀ ks, L → (x : X) → FiniteEventPath E target ks x → L
  | [], l, _, _ => l
  | k :: ks, l, x, ⟨e, p⟩ =>
      finiteEventPathLedger ks (update k l x e) (target k x e) p

def finiteLedgerEventPathEquiv : ∀ ks (l : L) (x : X),
    FiniteEventPath (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) ks (l, x) ≃ FiniteEventPath E target ks x
  | [], _, _ => Equiv.refl _
  | k :: ks, l, x =>
      Equiv.sigmaCongrRight (fun e : E k x =>
        finiteLedgerEventPathEquiv ks (update k l x e) (target k x e))

theorem finite_ledger_event_path_terminal (ks : List K) (l : L) (x : X)
    (p : FiniteEventPath (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) ks (l, x)) :
    finiteEventPathTerminal (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) ks (l, x) p =
    (finiteEventPathLedger E target update ks l x (finiteLedgerEventPathEquiv E target update ks l x p),
      finiteEventPathTerminal E target ks x (finiteLedgerEventPathEquiv E target update ks l x p)) := by
  induction ks generalizing l x with
  | nil => rfl
  | cons k ks ih =>
      rcases p with ⟨e, p⟩
      exact ih (update k l x e) (target k x e) p

theorem finite_ledger_event_path_weight (w : ∀ k x, E k x → ℝ)
    (ks : List K) (l : L) (x : X)
    (p : FiniteEventPath (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) ks (l, x)) :
    finiteEventPathWeight (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) (fun k s => w k s.2) ks (l, x) p =
      finiteEventPathWeight E target w ks x (finiteLedgerEventPathEquiv E target update ks l x p) := by
  induction ks generalizing l x with
  | nil => rfl
  | cons k ks ih =>
      rcases p with ⟨e, p⟩
      exact congrArg (w k x e * ·) (ih (update k l x e) (target k x e) p)

variable [∀ k x, Fintype (E k x)]

/- A deterministic ledger can be removed from the state of the path sum.
Every dependence on its history is retained in a pulled-back path phase. -/
theorem finite_ledger_event_path_action_memory
    (w : ∀ k x, E k x → ℝ) (ks : List K)
    (phase : ∀ s : L × X, FiniteEventPath (fun k s => E k s.2)
      (finiteLedgerEventTarget E target update) ks s → ℂ)
    (F : X → ℂ) (l : L) (x : X) :
    finiteEventPathAction (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) (fun k s => w k s.2) ks phase
      (fun s => F s.2) (l, x) =
    finiteEventPathAction E target w ks
      (fun y p => phase (l, y) ((finiteLedgerEventPathEquiv E target update ks l y).symm p)) F x := by
  classical
  let _ := finiteEventPathFintype E target ks x
  let _ := finiteEventPathFintype (fun k (s : L × X) => E k s.2)
    (finiteLedgerEventTarget E target update) ks (l, x)
  unfold finiteEventPathAction
  rw [← (finiteLedgerEventPathEquiv E target update ks l x).symm.sum_comp]
  apply sum_congr rfl
  intro p _
  rw [finite_ledger_event_path_weight, finite_ledger_event_path_terminal]
  simp only [Equiv.apply_symm_apply]

end Ledger
end

