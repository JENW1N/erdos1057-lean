/- All groups retain their tags in the cumulative birth ledger of the actual path. -/

open Finset
open scoped Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  [∀ g, DecidableEq (P g)] (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)

noncomputable def fullMixedLedgerTaggedImage
    (s : FullMixedLedgerState n (M := M) B) : Finset ((g : Fin N) × P g) :=
  univ.biUnion (fullMixedLedgerGroupImage n B s)

noncomputable def fullMixedLedgerPriorBirths (steps : List (Option (J ⊕ K)))
    (x : FullMixedLedgerState n (M := M) B)
    (p : FullMixedLedgerPath n S B A Δ D steps x) (cut : ℕ) :
    Finset ((g : Fin N) × P g) :=
  univ.biUnion fun a : FullMixedBirthAddress S B steps => if a.1.val < cut then
    (fullMixedLedgerPathBirthLabel n S B A Δ D steps x p a).toFinset else ∅

theorem mem_full_mixed_ledger_tagged (x : FullMixedLedgerState n (M := M) B)
    (z : (g : Fin N) × P g) :
    z ∈ fullMixedLedgerTaggedImage n B x ↔ z.2 ∈ x.1 z.1 := by
  rcases z with ⟨g, z⟩
  simp only [fullMixedLedgerTaggedImage, fullMixedLedgerGroupImage, mem_biUnion,
    mem_univ, true_and, mem_image]
  constructor
  · rintro ⟨h, y, hy, hzy⟩
    cases hzy
    exact hy
  · intro hz
    exact ⟨g, z, hz, rfl⟩

theorem mem_full_mixed_ledger_prior_births (steps : List (Option (J ⊕ K)))
    (x : FullMixedLedgerState n (M := M) B)
    (p : FullMixedLedgerPath n S B A Δ D steps x) (cut : ℕ) (z : (g : Fin N) × P g) :
    z ∈ fullMixedLedgerPriorBirths n S B A Δ D steps x p cut ↔
      ∃ a : FullMixedBirthAddress S B steps, a.1.val < cut ∧
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p a = some z := by
  simp only [fullMixedLedgerPriorBirths, mem_biUnion, mem_univ, true_and]
  apply exists_congr
  intro a
  split_ifs <;> simp_all only [Option.mem_toFinset, Option.mem_def,
    Finset.notMem_empty, false_and, true_and, iff_self]

theorem full_mixed_ledger_prior_births_eq_groups (steps : List (Option (J ⊕ K)))
    (x : FullMixedLedgerState n (M := M) B)
    (p : FullMixedLedgerPath n S B A Δ D steps x) (cut : ℕ) :
    fullMixedLedgerPriorBirths n S B A Δ D steps x p cut =
      univ.biUnion (fullMixedLedgerPriorGroupBirths n S B A Δ D steps x p cut) := by
  ext z
  rw [mem_full_mixed_ledger_prior_births]
  simp only [mem_biUnion, mem_univ, true_and, mem_full_mixed_prior_group_births]
  constructor
  · rintro ⟨⟨j, g, b⟩, hj, hb⟩
    exact ⟨g, j, hj, b, hb⟩
  · rintro ⟨g, j, hj, b, hb⟩
    exact ⟨⟨j, g, b⟩, hj, hb⟩

variable (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

theorem full_mixed_ledger_tagged_union_before (steps : List (Option (J ⊕ K)))
    (x : FullMixedLedgerState n (M := M) B)
    (p : FullMixedLedgerPath n S B A Δ D steps x)
    (hx : FullMixedLedgerCovers n B x)
    (hp : finiteEventPathWeight
      (fun tag (s : FullMixedLedgerState n (M := M) B) =>
        FullPermutationMixedEvent n S B A Δ D tag s.2)
      (fullMixedLedgerTarget n S B A Δ D)
      (fun tag s => fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag s.2)
      steps x p ≠ 0) (i : Fin steps.length) :
    fullMixedLedgerTaggedImage n B
      (finiteEventPathOccurrence
        (fun tag (s : FullMixedLedgerState n (M := M) B) =>
          FullPermutationMixedEvent n S B A Δ D tag s.2)
        (fullMixedLedgerTarget n S B A Δ D) steps x p i).1 =
      fullMixedLedgerTaggedImage n B x ∪
        fullMixedLedgerPriorBirths n S B A Δ D steps x p i.val := by
  have hw := finite_event_path_occurrence_weight_ne_zero _ _ _ steps x p hp
  simp only [fullMixedLedgerTaggedImage, full_mixed_ledger_prior_births_eq_groups]
  ext z
  simp only [mem_biUnion, mem_univ, true_and, mem_union]
  have hg := fun g => full_mixed_ledger_group_union_before n S B A Δ D ω μ q ρ V
    steps x p hx hw i g
  simp_rw [hg, mem_union, exists_or]

theorem full_mixed_ledger_mem_before (steps : List (Option (J ⊕ K)))
    (x : FullMixedLedgerState n (M := M) B)
    (p : FullMixedLedgerPath n S B A Δ D steps x)
    (hx : FullMixedLedgerCovers n B x)
    (hp : finiteEventPathWeight
      (fun tag (s : FullMixedLedgerState n (M := M) B) =>
        FullPermutationMixedEvent n S B A Δ D tag s.2)
      (fullMixedLedgerTarget n S B A Δ D)
      (fun tag s => fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag s.2)
      steps x p ≠ 0) (i : Fin steps.length) (g : Fin N) (r : P g) :
    r ∈ (finiteEventPathOccurrence
        (fun tag (s : FullMixedLedgerState n (M := M) B) =>
          FullPermutationMixedEvent n S B A Δ D tag s.2)
        (fullMixedLedgerTarget n S B A Δ D) steps x p i).1.1 g ↔
      r ∈ x.1 g ∨ ∃ a : FullMixedBirthAddress S B steps, a.1.val < i.val ∧
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p a = some ⟨g, r⟩ := by
  have h := congrArg (fun H => (⟨g, r⟩ : (h : Fin N) × P h) ∈ H)
    (full_mixed_ledger_tagged_union_before n S B A Δ D ω μ q ρ V steps x p hx hp i)
  simpa only [mem_full_mixed_ledger_tagged, mem_union,
    mem_full_mixed_ledger_prior_births, eq_iff_iff] using h

end Full
end Bounty
end

