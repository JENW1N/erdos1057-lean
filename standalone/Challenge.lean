section

/- Actual kernel pairings vanish when a probe meets an omitted coordinate. -/

open Finset
open scoped Classical

namespace Bounty

section

variable
  {I : Type*}
  [sharedInstance1 : Fintype I]
  [sharedInstance2 : DecidableEq I]
  {X : I → Type*}
  [sharedInstance4 : ∀ i, Fintype (X i)]
  {Y : Type*}
  [sharedInstance6 : Fintype Y]
  (μ : ∀ i, X i → ℝ)
  (hmass : ∀ i, ∑ v, μ i v = 1)

include I sharedInstance1 sharedInstance2 X sharedInstance4 Y sharedInstance6 μ hmass

theorem clean_kernel_component_zero_left 
    (U S : Finset I) (hS : S ⊆ U) (i : I) (hiS : i ∈ S)
    (K : (∀ i, X i) → Y → ℂ) (f : (∀ i, X i) → ℂ) (g : Y → ℂ)
    (hK : ∀ x y v, K (Function.update x i v) y = K x y) :
    cleanKernelPairing (finiteProductWeight μ) K
      (finiteCoordinateComponent μ S U.toList f) g = 0 := by
  have hzero := finite_probe_component_pairing_zero_left μ hmass U S hS i hiS f
    (fun x => ∑ y, K x y * g y) (by
      intro x v
      apply sum_congr rfl
      intro y _
      rw [hK])
  simpa only [cleanKernelPairing, mul_sum, mul_assoc] using hzero

theorem clean_kernel_component_zero_right 
    (V T : Finset I) (hT : T ⊆ V) (i : I) (hiT : i ∈ T)
    (w : Y → ℝ) (H : Y → (∀ i, X i) → ℂ) (f : Y → ℂ) (g : (∀ i, X i) → ℂ)
    (hH : ∀ x y v, H x (Function.update y i v) = H x y) :
    cleanKernelPairing w (fun x y => (finiteProductWeight μ y : ℂ) * H x y)
      f (finiteCoordinateComponent μ T V.toList g) = 0 := by
  unfold cleanKernelPairing
  apply sum_eq_zero
  intro x _
  have hzero : (∑ y, (finiteProductWeight μ y : ℂ) *
      (H x y * finiteCoordinateComponent μ T V.toList g y)) = 0 := by
    simpa using finite_probe_component_pairing_zero_right μ hmass V T hT i hiT g
      (fun y => (starRingEnd ℂ) (H x y)) (by
        intro y v
        rw [hH])
  calc
    _ = ((w x : ℂ) * (starRingEnd ℂ) (f x)) *
        ∑ y, (finiteProductWeight μ y : ℂ) *
          (H x y * finiteCoordinateComponent μ T V.toList g y) := by
      rw [mul_sum]
      apply sum_congr rfl
      intro y _
      ring
    _ = 0 := by rw [hzero, mul_zero]

end


theorem clean_kernel_components_zero_of_not_admissible
    {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)]
    (μ : ∀ i, X i → ℝ) (hmass : ∀ i, ∑ v, μ i v = 1)
    (U V S T A B : Finset I) (hS : S ⊆ U) (hT : T ⊆ V)
    (hA : A ⊆ U) (hB : B ⊆ V)
    (H : (∀ i, X i) → (∀ i, X i) → ℂ) (f g : (∀ i, X i) → ℂ)
    (hleft : ∀ i ∈ A, ∀ x y v, H (Function.update x i v) y = H x y)
    (hright : ∀ i ∈ B, ∀ x y v, H x (Function.update y i v) = H x y)
    (hnot : ¬(A ⊆ U \ S ∧ B ⊆ V \ T)) :
    cleanKernelPairing (finiteProductWeight μ)
      (fun x y => (finiteProductWeight μ y : ℂ) * H x y)
      (finiteCoordinateComponent μ S U.toList f)
      (finiteCoordinateComponent μ T V.toList g) = 0 := by
  by_cases hAS : A ⊆ U \ S
  · have hBT : ¬ B ⊆ V \ T := fun h => hnot ⟨hAS, h⟩
    obtain ⟨i, hiB, hi⟩ := not_subset.mp hBT
    have hiT : i ∈ T := by simpa [mem_sdiff, hB hiB] using hi
    exact clean_kernel_component_zero_right μ hmass V T hT i hiT
      (finiteProductWeight μ) H (finiteCoordinateComponent μ S U.toList f) g
      (hright i hiB)
  · obtain ⟨i, hiA, hi⟩ := not_subset.mp hAS
    have hiS : i ∈ S := by simpa [mem_sdiff, hA hiA] using hi
    apply clean_kernel_component_zero_left μ hmass U S hS i hiS
      (fun x y => (finiteProductWeight μ y : ℂ) * H x y) f
      (finiteCoordinateComponent μ T V.toList g)
    intro x y v
    rw [hleft i hiA]

end Bounty
end

section

/- The literal fresh-coordinate transition and its exact product-law density. -/

namespace Bounty

open Finset
open scoped Classical

def finiteCoordinateRestrict {I : Type*} {X : I → Type*}
    (s : Finset I) (x : ∀ i, X i) : ∀ i : s, X i.val := fun i => x i.val

theorem finite_coordinate_restrict_update {I : Type*} [DecidableEq I] {X : I → Type*}
    (s : Finset I) (i : I) (hi : i ∉ s) (x : ∀ i, X i) (v : X i) :
    finiteCoordinateRestrict s (Function.update x i v) = finiteCoordinateRestrict s x := by
  funext j
  have hj : j.val ≠ i := fun he => hi (he ▸ j.property)
  exact Function.update_of_ne hj _ _

def finiteSharedCompatible {I : Type*} {X : I → Type*}
    (s : Finset I) (x y : ∀ i, X i) : Prop := ∀ i ∈ s, x i = y i

noncomputable def finiteSharedDensity {I : Type*} {X : I → Type*}
    (μ : ∀ i, X i → ℝ) (s : Finset I) (x y : ∀ i, X i) : ℝ :=
  ∏ i ∈ s, if x i = y i then (μ i (y i))⁻¹ else 0

noncomputable def finiteFreshMass {I : Type*} [Fintype I] [DecidableEq I] {X : I → Type*}
    (μ : ∀ i, X i → ℝ) (s : Finset I) (y : ∀ i, X i) : ℝ :=
  ∏ i ∈ sᶜ, μ i (y i)

theorem finite_shared_density_of_compatible {I : Type*} {X : I → Type*}
    (μ : ∀ i, X i → ℝ) (s : Finset I) (x y : ∀ i, X i)
    (hxy : finiteSharedCompatible s x y) :
    finiteSharedDensity μ s x y = (∏ i ∈ s, μ i (y i))⁻¹ := by
  unfold finiteSharedDensity
  simp only [← Finset.prod_inv_distrib]
  apply prod_congr rfl
  intro i hi
  rw [if_pos (hxy i hi)]

theorem finite_shared_density_of_not_compatible {I : Type*} {X : I → Type*}
    (μ : ∀ i, X i → ℝ) (s : Finset I) (x y : ∀ i, X i)
    (hxy : ¬ finiteSharedCompatible s x y) : finiteSharedDensity μ s x y = 0 := by
  classical
  obtain ⟨i, hi, hne⟩ : ∃ i ∈ s, x i ≠ y i := by
    simpa only [finiteSharedCompatible, not_forall, exists_prop] using hxy
  exact prod_eq_zero hi (if_neg hne)

theorem finite_product_weight_mul_shared_density {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} (μ : ∀ i, X i → ℝ) (s : Finset I)
    (hμ : ∀ i ∈ s, ∀ v, μ i v ≠ 0) (x y : ∀ i, X i) :
    finiteProductWeight μ y * finiteSharedDensity μ s x y =
      if finiteSharedCompatible s x y then finiteFreshMass μ s y else 0 := by
  by_cases hxy : finiteSharedCompatible s x y
  · rw [if_pos hxy, finite_shared_density_of_compatible μ s x y hxy]
    have hp : (∏ i ∈ s, μ i (y i)) ≠ 0 := prod_ne_zero_iff.mpr (fun i hi => hμ i hi _)
    have he := prod_mul_prod_compl s (fun i => μ i (y i))
    change (∏ i, μ i (y i)) * (∏ i ∈ s, μ i (y i))⁻¹ = ∏ i ∈ sᶜ, μ i (y i)
    rw [← he]
    field_simp
  · rw [if_neg hxy, finite_shared_density_of_not_compatible μ s x y hxy, mul_zero]




noncomputable def finiteAsymmetricKernel {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} (μ : ∀ i, X i → ℝ) (shared A B : Finset I)
    (F : (∀ i : shared, X i.val) → (∀ i : A, X i.val) → (∀ i : B, X i.val) → ℂ)
    (x y : ∀ i, X i) : ℂ :=
  if finiteSharedCompatible shared x y then
    (finiteFreshMass μ shared y : ℂ) *
      F (finiteCoordinateRestrict shared x) (finiteCoordinateRestrict A y) (finiteCoordinateRestrict B x)
  else 0

noncomputable def finiteAsymmetricDensity {I : Type*} {X : I → Type*}
    (μ : ∀ i, X i → ℝ) (shared A B : Finset I)
    (F : (∀ i : shared, X i.val) → (∀ i : A, X i.val) → (∀ i : B, X i.val) → ℂ)
    (x y : ∀ i, X i) : ℂ :=
  (finiteSharedDensity μ shared x y : ℂ) *
    F (finiteCoordinateRestrict shared x) (finiteCoordinateRestrict A y) (finiteCoordinateRestrict B x)

theorem finite_asymmetric_kernel_eq_density {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} (μ : ∀ i, X i → ℝ) (shared A B : Finset I)
    (hμ : ∀ i ∈ shared, ∀ v, μ i v ≠ 0)
    (F : (∀ i : shared, X i.val) → (∀ i : A, X i.val) → (∀ i : B, X i.val) → ℂ)
    (x y : ∀ i, X i) :
    finiteAsymmetricKernel μ shared A B F x y =
      (finiteProductWeight μ y : ℂ) * finiteAsymmetricDensity μ shared A B F x y := by
  unfold finiteAsymmetricKernel finiteAsymmetricDensity
  rw [← mul_assoc, ← Complex.ofReal_mul, finite_product_weight_mul_shared_density μ shared hμ x y]
  split_ifs <;> simp only [Complex.ofReal_zero, zero_mul]

end Bounty
end

section

/- The actual asymmetric prime value. The A tuple is taken from the target
endpoint, and the B tuple from the source endpoint; the shared tuple is fixed. -/

open scoped BigOperators Classical

namespace Bounty

noncomputable def primeTuplePhase (ζ Θ : ℝ) (N : ℕ) : ℂ :=
  physicalPhase ζ N * physicalReturnPhase Θ (N : ℤ)

theorem prime_tuple_phase_eq_exp (ζ Θ : ℝ) (N : ℕ) :
    primeTuplePhase ζ Θ N =
      Complex.exp (Complex.I * (ζ * Real.log (N : ℝ) + 2 * Real.pi * Θ * N : ℝ)) := by
  unfold primeTuplePhase physicalPhase physicalReturnPhase
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem prime_tuple_phase_norm (ζ Θ : ℝ) (N : ℕ) :
    ‖primeTuplePhase ζ Θ N‖ = 1 := by
  rw [prime_tuple_phase_eq_exp, Complex.norm_exp]
  simp only [Complex.mul_re, Complex.I_re, Complex.I_im, Complex.ofReal_re,
    Complex.ofReal_im, zero_mul, mul_zero, sub_zero, Real.exp_zero]

theorem prime_tuple_phase_shared_mul (ζ Θ : ℝ) (C N : ℕ)
    (hC : 0 < C) (hN : 0 < N) :
    primeTuplePhase ζ Θ (C * N) =
      physicalPhase ζ C * primeTuplePhase ζ (Θ * C) N := by
  rw [prime_tuple_phase_eq_exp, prime_tuple_phase_eq_exp, physicalPhase, ← Complex.exp_add]
  have hCr : (C : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hC)
  have hNr : (N : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hN)
  simp only [Nat.cast_mul, Real.log_mul hCr hNr]
  congr 1
  push_cast
  ring

noncomputable def primeAsymmetricValue {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (shared A B : Finset I)
    (Q : ℕ) (h : ℝ) (keptA keptB : Finset ℤ) (ζ Θ : ℝ)
    (c : ∀ i : shared, P i.1) (a : ∀ i : A, P i.1) (b : ∀ i : B, P i.1) : ℂ :=
  finiteTwoKernelAverage
    (finiteProductWeight (physicalLabelLaw (P := fun i : A => P i.1) (fun i => V i.1)))
    (finiteProductWeight (physicalLabelLaw (P := fun i : B => P i.1) (fun i => V i.1)))
    (primeProductIdealKernel (fun i : A => P i.1) (fun i => V i.1) Q h keptA)
    (primeProductIdealKernel (fun i : B => P i.1) (fun i => V i.1) Q h keptB) a b
    (fun d e => primeTuplePhase ζ Θ
      ((∏ i : shared, (c i).val) * (∏ i : A, (d i).val) * (∏ i : B, (e i).val)))

theorem prime_asymmetric_value_eq_sum {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (shared A B : Finset I)
    (Q : ℕ) (h : ℝ) (keptA keptB : Finset ℤ) (ζ Θ : ℝ)
    (c : ∀ i : shared, P i.1) (a : ∀ i : A, P i.1) (b : ∀ i : B, P i.1) :
    primeAsymmetricValue P V shared A B Q h keptA keptB ζ Θ c a b =
      ∑ d : ∀ i : A, P i.1, ∑ e : ∀ i : B, P i.1,
        ((finiteProductWeight (physicalLabelLaw (P := fun i : A => P i.1)
          (fun i => V i.1)) d : ℂ) *
          primeProductIdealKernel (fun i : A => P i.1) (fun i => V i.1) Q h keptA d a) *
        ((finiteProductWeight (physicalLabelLaw (P := fun i : B => P i.1)
          (fun i => V i.1)) e : ℂ) *
          primeProductIdealKernel (fun i : B => P i.1) (fun i => V i.1) Q h keptB e b) *
        primeTuplePhase ζ Θ
          ((∏ i : shared, (c i).val) * (∏ i : A, (d i).val) * (∏ i : B, (e i).val)) := rfl

end Bounty
end

section

/- A full-state continuation can be read on raw memory with fixed active
labels. The zero extension agrees exactly on every decoded bounded state. -/

open scoped Classical
namespace Bounty

section Fixed
variable {N : ℕ} {P : Fin N → Type*} (n : (g : Fin N) → P g → ℕ)
  {M : Fin N → ℕ} (B : ℕ) (active : (g : Fin N) → Fin (M g) → P g)

noncomputable def fixedActiveRawExtension
    (F : FullMixedLedgerState n (M := M) B → ℂ)
    (s : GlobalBirthJointState (fun g p => ZMod (n g p))) : ℂ :=
  if h : ∀ g, (s g).2.1 ≤ B then
    F (fun g => (s g).1,
      fun g => (active g, ⟨⟨(s g).2.1, Nat.lt_succ_of_le (h g)⟩, (s g).2.2⟩))
  else 0

theorem fixed_active_raw_extension_decode
    (F : FullMixedLedgerState n (M := M) B → ℂ)
    (s : FullMixedLedgerState n (M := M) B) :
    fixedActiveRawExtension n B active F (fullMixedLedgerDecode n B s) =
      F (s.1, fun g => (active g, (s.2 g).2)) := by
  unfold fixedActiveRawExtension fullMixedLedgerDecode
  rw [dif_pos (fun g => boundedOrderedTupleToFinite_length_le (s.2 g).2)]
  rfl

theorem fixed_active_raw_extension_self
    (F : FullMixedLedgerState n (M := M) B → ℂ)
    (s : FullMixedLedgerState n (M := M) B)
    (hactive : ∀ g, (s.2 g).1 = active g) :
    fixedActiveRawExtension n B active F (fullMixedLedgerDecode n B s) = F s := by
  rw [fixed_active_raw_extension_decode]
  congr 1
  apply Prod.ext
  · rfl
  · funext g
    exact Prod.ext (hactive g).symm rfl

end Fixed
end Bounty
end

section

/- Extend the physical endpoint phase to every full active state. On an
injective state its physical list is uniquely decoded; elsewhere the phase
vanishes. No change is made to the full event type or weight. -/

open scoped Classical
namespace Bounty

section Physical
variable {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin N → Finset (Fin J)) (k : ℤ)
  (H : (g : Fin N) → Finset ↥(P g))
  (ω : ∀ _c : SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C g)), PhysicalAuxLabels P C → ℝ)
  (μ : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

noncomputable def physicalFullGlobalEdgePhase (x : PhysicalFullBoundedState P J ell B)
    (e : PhysicalFullEdgeEvent C k x) : ℂ :=
  if hx : FullActiveInjective x then
    physicalFullEndpointPhase C k (physicalFullStateLabels C x hx) H (fun g => (x g).2)
      ω μ ρ V (Eq.mpr (congrArg (PhysicalFullEdgeEvent C k)
        (physical_full_state_encode_labels C x hx)) e)
  else 0

theorem physical_full_global_edge_phase_norm_le (x : PhysicalFullBoundedState P J ell B)
    (e : PhysicalFullEdgeEvent C k x) :
    ‖physicalFullGlobalEdgePhase C k H ω μ ρ V x e‖ ≤ 1 := by
  unfold physicalFullGlobalEdgePhase
  split_ifs
  · exact physical_full_endpoint_phase_norm_le _ _ _ _ _ _ _ _ _ _
  · simp only [norm_zero, zero_le_one]

theorem physical_full_global_edge_phase_encode (L : PhysicalMarkLists P J ell)
    (q : (g : Fin N) → BoundedOrderedTuple
      (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
    (e : PhysicalFullEdgeEvent C k (physicalFullMemoryState C L q)) :
    physicalFullGlobalEdgePhase C k H ω μ ρ V (physicalFullMemoryState C L q) e =
      physicalFullEndpointPhase C k L H q ω μ ρ V e := by
  unfold physicalFullGlobalEdgePhase
  rw [dif_pos (physical_full_state_injective C L q)]
  have ht (L' : PhysicalMarkLists P J ell) (hL : L' = L)
      (he : PhysicalFullEdgeEvent C k (physicalFullMemoryState C L' q) =
        PhysicalFullEdgeEvent C k (physicalFullMemoryState C L q)) :
      physicalFullEndpointPhase C k L' H q ω μ ρ V (Eq.mpr he e) =
        physicalFullEndpointPhase C k L H q ω μ ρ V e := by
    subst L'
    rfl
  exact ht _ (physical_full_state_labels_encode C L q) _

end Physical
end Bounty
end

section

/- Changing the chosen slot enumeration between vertices is incorporated
into the permutation bijection. Normalization and the complete dependence
on the original permutation are retained together. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalTransitionPermutationEquiv {G : Type*} {J ell : ℕ}
    (C D : G → Finset (Fin J)) :
    PhysicalPermutations G J ell ≃ FullActiveSlotPermutations (fun _ : G => J + ell) where
  toFun σ g := ((physicalFullSlotIndex (D g)).trans (σ g)).trans (physicalFullSlotIndex (C g)).symm
  invFun τ g := ((physicalFullSlotIndex (D g)).symm.trans (τ g)).trans (physicalFullSlotIndex (C g))
  left_inv σ := by
    funext g
    apply Equiv.ext
    intro i
    simp only [Equiv.trans_apply, Equiv.apply_symm_apply]
  right_inv τ := by
    funext g
    apply Equiv.ext
    intro i
    simp only [Equiv.trans_apply, Equiv.symm_apply_apply]

theorem physical_full_memory_transition_permute {G : Type*} {P : G → Finset ℕ}
    {Z : G → Type*} {J ell B : ℕ} (C D : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ∀ g, BoundedOrderedTuple (Z g) B)
    (σ : PhysicalPermutations G J ell) :
    physicalFullMemoryState D (physicalPermuteLabels σ L) q =
      fullActivePermutation (physicalTransitionPermutationEquiv C D σ) (physicalFullMemoryState C L q) := by
  funext g
  apply Prod.ext
  · funext i
    change L g (σ g (physicalFullSlotIndex (D g) i)) =
      L g (physicalFullSlotIndex (C g) ((physicalFullSlotIndex (C g)).symm
        (σ g (physicalFullSlotIndex (D g) i))))
    rw [Equiv.apply_symm_apply]
  · rfl

theorem physical_full_transition_permutation_weight {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (C D : G → Finset (Fin J)) (σ : PhysicalPermutations G J ell) :
    (Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ =
      fullActivePermutationWeight (fun _ : G => J + ell) (physicalTransitionPermutationEquiv C D σ) := by
  unfold fullActivePermutationWeight
  rw [Fintype.card_congr (physicalTransitionPermutationEquiv C D)]

theorem physical_full_transition_phase_reindex {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {Z : G → Type*} {J ell B : ℕ}
    (C D : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell)
    (q : ∀ g, BoundedOrderedTuple (Z g) B)
    (F : PhysicalPermutations G J ell →
      ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ : G => J + ell) B → ℂ) :
    (∑ σ : PhysicalPermutations G J ell,
      ((Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ : ℂ) *
        F σ (physicalFullMemoryState D (physicalPermuteLabels σ L) q)) =
    ∑ τ : FullActiveSlotPermutations (fun _ : G => J + ell),
      (fullActivePermutationWeight (fun _ : G => J + ell) τ : ℂ) *
        F ((physicalTransitionPermutationEquiv C D).symm τ)
          (fullActivePermutation τ (physicalFullMemoryState C L q)) := by
  calc
    _ = ∑ σ : PhysicalPermutations G J ell,
        (fullActivePermutationWeight (fun _ : G => J + ell) (physicalTransitionPermutationEquiv C D σ) : ℂ) *
          F σ (fullActivePermutation (physicalTransitionPermutationEquiv C D σ) (physicalFullMemoryState C L q)) := by
      apply sum_congr rfl
      intro σ _
      rw [physical_full_memory_transition_permute C D L q σ]
      have hw := congrArg Complex.ofReal (physical_full_transition_permutation_weight C D σ)
      simpa only [Complex.ofReal_inv] using congrArg
        (fun z : ℂ => z * F σ (fullActivePermutation (physicalTransitionPermutationEquiv C D σ)
          (physicalFullMemoryState C L q))) hw
    _ = _ := by
      simpa only [Equiv.symm_apply_apply] using
        (physicalTransitionPermutationEquiv C D).sum_comp
          (fun τ => (fullActivePermutationWeight (fun _ : G => J + ell) τ : ℂ) *
            F ((physicalTransitionPermutationEquiv C D).symm τ)
              (fullActivePermutation τ (physicalFullMemoryState C L q)))




end Bounty
end

