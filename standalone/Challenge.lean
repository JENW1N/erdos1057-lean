      ∀ (qP qT : ℕ) (χP : DirichletCharacter ℂ qP) (χT : DirichletCharacter ℂ qT)
        (τP τT : ℝ) (lo hi : ℕ) (F : Finset ℕ) (UM UT : ℝ),
      0 < UM → 1 ≤ UT →
