theorem finite_event_path_weight_abs {K X : Type*} (E : K → X → Type*)
    (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (x : X) (p : FiniteEventPath E target ks x) :
    |finiteEventPathWeight E target w ks x p| =
      finiteEventPathWeight E target (fun k x e => |w k x e|) ks x p := by
  induction ks generalizing x with
  | nil => exact abs_one
  | cons k ks ih =>
    rcases p with ⟨e, p⟩
    exact (abs_mul _ _).trans (congrArg (fun a => |w k x e| * a) (ih _ p))

theorem finite_event_path_norm_le_abs_list_re {K X : Type*}
    (E : K → X → Type*) [∀ k x, Fintype (E k x)]
    (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (phase : ∀ x, FiniteEventPath E target ks x → ℂ)
    (hphase : ∀ x p, ‖phase x p‖ ≤ 1) (f : X → ℂ) (x : X) :
    ‖finiteEventPathAction E target w ks phase f x‖ ≤
      (finiteOperatorListAction
        (finiteLocalEventAction E (fun k x e => |w k x e|) target) ks (complexNormEnvelope f) x).re := by
  rw [← finite_event_path_positive_eq_list]
  let _ := finiteEventPathFintype E target ks x
  have hpos : (finiteEventPathPositive E target (fun k x e => |w k x e|)
      ks (complexNormEnvelope f) x).re =
      ∑ p : FiniteEventPath E target ks x,
        |finiteEventPathWeight E target w ks x p| * ‖f (finiteEventPathTerminal E target ks x p)‖ := by
    simp only [finiteEventPathPositive, complexNormEnvelope, Complex.re_sum, Complex.mul_re,
      Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero, ← finite_event_path_weight_abs]
  rw [hpos]
  unfold finiteEventPathAction
  refine (norm_sum_le _ _).trans (sum_le_sum fun p _ => ?_)
  rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs]
  calc
    _ ≤ (|finiteEventPathWeight E target w ks x p| * 1) *
        ‖f (finiteEventPathTerminal E target ks x p)‖ :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hphase x p) (abs_nonneg _))
        (norm_nonneg _)
    _ = _ := by rw [mul_one]
end

