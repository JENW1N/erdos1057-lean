theorem carmichaelCounting_nonneg (x : ℝ) :
    0 ≤ Erdos1057.carmichaelCounting x := by
  unfold Erdos1057.carmichaelCounting
  positivity

theorem carmichaelCounting_le {x : ℝ} (hx : 0 ≤ x) :
    Erdos1057.carmichaelCounting x ≤ x := by
  have hsub : {n : ℕ | IsCarmichael n ∧ (n : ℝ) ≤ x} ⊆
      Set.Icc 1 ⌊x⌋₊ := by
    intro n hn
    refine ⟨?_, (Nat.le_floor_iff hx).2 hn.2⟩
    have hn' := hn.1 1 (by omega) (Nat.coprime_one_right n)
    exact Nat.le_of_lt hn'.2.2
  have hcard := Set.ncard_le_ncard hsub (Set.finite_Icc 1 ⌊x⌋₊)
  simp only [Set.ncard_Icc_nat, Nat.add_sub_cancel] at hcard
  exact (Nat.cast_le.mpr hcard).trans (Nat.floor_le hx)

theorem log_ratio_le_one {x : ℝ} (hx : 1 < x) :
    Real.log (Erdos1057.carmichaelCounting x) / Real.log x ≤ 1 := by
  have hx0 : 0 < x := lt_trans zero_lt_one hx
  apply (div_le_iff₀ (Real.log_pos hx)).2
  rw [one_mul]
  by_cases hc : Erdos1057.carmichaelCounting x = 0
  · simpa [hc] using (Real.log_pos hx).le
  · exact Real.log_le_log
      (lt_of_le_of_ne (carmichaelCounting_nonneg x) (Ne.symm hc))
      (carmichaelCounting_le hx0.le)

/- The lower bound still needed from the number-theoretic argument. -/
def NearLinearLowerBound : Prop :=
  ∀ ε : ℝ, 0 < ε → ∀ᶠ x : ℝ in atTop,
    x ^ (1 - ε) ≤ Erdos1057.carmichaelCounting x

/- The final analytic step, conditional on a near-linear counting lower bound. -/
theorem counting_limit_of_lower_bound (h : NearLinearLowerBound) :
    Tendsto (fun x : ℝ => Real.log (Erdos1057.carmichaelCounting x) / Real.log x)
      atTop (𝓝 1) := by
  apply tendsto_order.2
  constructor
  · intro a ha
    have he : 0 < (1 - a) / 2 := by linarith
    filter_upwards [h ((1 - a) / 2) he, eventually_gt_atTop (1 : ℝ)] with x hl hx
    have hx0 : 0 < x := lt_trans zero_lt_one hx
    have hr : 0 < x ^ (1 - (1 - a) / 2) := Real.rpow_pos_of_pos hx0 _
    have hlog := Real.log_le_log hr hl
    rw [Real.log_rpow hx0] at hlog
    have hratio : 1 - (1 - a) / 2 ≤
        Real.log (Erdos1057.carmichaelCounting x) / Real.log x :=
      (le_div_iff₀ (Real.log_pos hx)).2 hlog
    linarith
  · intro a ha
    filter_upwards [eventually_gt_atTop (1 : ℝ)] with x hx
    exact lt_of_le_of_lt (log_ratio_le_one hx) ha







/- This has an extra hypothesis and is not the unconditional challenge target. -/
theorem target_of_lower_bound (h : NearLinearLowerBound) :
    fcTypeOfName% "Erdos1057.erdos_1057" := by
  exact ⟨fun _ => counting_limit_of_lower_bound h, fun _ => True.intro⟩



end

