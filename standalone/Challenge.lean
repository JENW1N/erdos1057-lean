variable
  (hs : List ℝ)
  (q a u lo hi : ℝ)
  (l r : ℤ)
  (hq : 0 < q)
  (hu : u ≠ 0)
  (hlr : l ≤ r)
  (hhs : ∀ h ∈ hs, 0 < h)
  (hlo : 0 < lo)
  (hlohi : lo ≤ hi)
  (hbox : ∀ x ∈ Set.Icc (l:ℝ) ((r:ℝ)+1),
      lo ≤ x+a/q ∧ x+a/q+hs.sum ≤ hi)

include hs q a u lo hi l r hq hu hlr hhs hlo hlohi hbox

theorem integer_mixed_logarithmic_sum_bound
     :
    let d := hs.length+2
    let lam := hs.prod * |u| * ((hs.length+1).factorial:ℝ) / hi^d
    let A := (hi/lo)^d
    ‖∑ n ∈ Icc l r, realUnitPhase
      (mixedForwardDifference hs (fun y => u * Real.log (q*y+a)) (n:ℝ))‖ ≤
      6*(A*((r:ℝ)-l+1)*Real.sqrt lam+2/Real.sqrt lam) := by
  dsimp only
  let lam := hs.prod * |u| * ((hs.length+1).factorial:ℝ) / hi^(hs.length+2)
  let A := (hi/lo)^(hs.length+2)
  have hhi : 0 < hi := lt_of_lt_of_le hlo hlohi
  have hprod : 0 < hs.prod := List.prod_pos hhs
  have hlam : 0 < lam := by dsimp only [lam]; positivity
  have hA : 1 ≤ A := by
    apply one_le_pow₀
    exact (le_div_iff₀ hlo).mpr (by simpa using hlohi)
  have hhs0 : ∀ h ∈ hs, 0 ≤ h := fun h hh => (hhs h hh).le
  have hcurv : hs.prod * |u| * ((1+hs.length).factorial:ℝ) /
        lo^(1+hs.length+1) = A*lam := by
    have hd : 1+hs.length+1 = hs.length+2 := by omega
    have hf : 1+hs.length = hs.length+1 := by omega
    rw [hd, hf]
    dsimp only [A, lam]
    rw [div_pow]
    field_simp
  have hcurvlow : hs.prod * |u| * ((1+hs.length).factorial:ℝ) /
        hi^(1+hs.length+1) = lam := by
    have hd : 1+hs.length+1 = hs.length+2 := by omega
    rw [hd, Nat.add_comm 1 hs.length]
  have hf : ∀ x ∈ Set.Icc (l:ℝ) ((r:ℝ)+1),
      HasDerivAt (mixedForwardDifference hs (fun y => u*Real.log (q*y+a)))
        (mixedForwardDifference hs (logarithmicDerivativeChain u (a/q) 1) x) x := by
    intro x hx
    exact (mixed_affine_logarithmic_phase_derivatives hs q a u x hq hhs0
      (lt_of_lt_of_le hlo (hbox x hx).1)).1
  have hf' : ∀ x ∈ Set.Icc (l:ℝ) ((r:ℝ)+1),
      HasDerivAt (mixedForwardDifference hs (logarithmicDerivativeChain u (a/q) 1))
        (mixedForwardDifference hs (logarithmicDerivativeChain u (a/q) 2) x) x := by
    intro x hx
    exact (mixed_affine_logarithmic_phase_derivatives hs q a u x hq hhs0
      (lt_of_lt_of_le hlo (hbox x hx).1)).2
  rcases le_total 0 (u*(-1:ℝ)^(1+hs.length)) with hp | hn
  · apply integer_second_derivative_sum_bound hlr hlam hA hf hf'
    intro x hx
    have hb := mixed_logarithmic_difference_positive_bounds_on_box hs u (a/q) 1 x lo hi
      hhs0 hlo (hbox x hx).1 (hbox x hx).2 hp
    rwa [hcurv, hcurvlow] at hb
  · apply integer_second_derivative_sum_bound_negative hlr hlam hA hf hf'
    intro x hx
    have hb := mixed_logarithmic_difference_negative_bounds_on_box hs u (a/q) 1 x lo hi
      hhs0 hlo (hbox x hx).1 (hbox x hx).2 hn
    rw [hcurv, hcurvlow] at hb
    simpa only [neg_mul] using hb


theorem integer_mixed_logarithmic_exp_sum_bound
     :
    let d := hs.length+2
    let lam := hs.prod * |u/(2*Real.pi)| * ((hs.length+1).factorial:ℝ) / hi^d
    let A := (hi/lo)^d
    ‖∑ n ∈ Icc l r, Complex.exp
      ((mixedForwardDifference hs (fun y => u * Real.log (q*y+a)) (n:ℝ) : ℂ)*Complex.I)‖ ≤
      6*(A*((r:ℝ)-l+1)*Real.sqrt lam+2/Real.sqrt lam) := by
  have hne : u/(2*Real.pi) ≠ 0 := div_ne_zero hu (by positivity)
  have hb := integer_mixed_logarithmic_sum_bound hs q a (u/(2*Real.pi)) lo hi l r
    hq hne hlr hhs hlo hlohi hbox
  have hf : (fun y => u/(2*Real.pi)*Real.log (q*y+a)) =
      (fun y => (u*Real.log (q*y+a))/(2*Real.pi)) := by funext y; ring
  rw [hf] at hb
  simpa only [real_unit_phase_mixed_div_two_pi] using hb

