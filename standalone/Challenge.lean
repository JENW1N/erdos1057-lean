section

/- Exact dyadic representations of the ordinary and sparse mean-square subproducts. -/

open Finset

namespace Bounty

theorem divisor_pair_dyadic_representation (S A B : Finset ℕ) (α β : ℕ → ℂ)
    (hA : ∀ a ∈ A, 0 < a) (hB : ∀ b ∈ B, 0 < b)
    (hα : ∀ a, a ∉ A → α a = 0) (hβ : ∀ b, b ∉ B → β b = 0)
    (hS : ∀ a ∈ A, ∀ b ∈ B, a*b ∈ S) (U : ℝ) (hU : 0 ≤ U) (K : ℕ)
    (hsize : ∀ a ∈ A, ∀ b ∈ B, U < (a*b : ℕ) ∧ (a*b : ℕ) ≤ (2 : ℝ)^K*U) (t : ℝ) :
    (∑ a ∈ A, α a*harmonicMellinWeight t a)*(∑ b ∈ B, β b*harmonicMellinWeight t b) =
      ∑ j : Fin K, ∑ n ∈ Icc (⌊(2 : ℝ)^j.val*U⌋₊+1) ⌊(2 : ℝ)^(j.val+1)*U⌋₊,
        (if n ∈ S then (∑ d ∈ n.divisors, α d*β (n/d))/(n : ℂ) else 0)*
          Complex.exp (((Real.log (n : ℝ)*t : ℝ) : ℂ)*Complex.I) := by
  rw [← divisor_pair_finite_mellin S A B α β hA hB hα hβ hS]
  apply finite_mellin_dyadic_representation S _ U hU K
  intro n hn hne
  obtain ⟨a,b,ha,hb,han,hbn,he⟩ := divisor_pair_nonzero_factors α β hne
  have haA : a ∈ A := by by_contra hz; exact han (hα a hz)
  have hbB : b ∈ B := by by_contra hz; exact hbn (hβ b hz)
  simpa only [he] using hsize a haA b hbB

theorem endpoint_triple_dyadic_representation (S A B C : Finset ℕ) (α β γ : ℕ → ℂ)
    (hA : ∀ a ∈ A, 0 < a) (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c)
    (hα : ∀ a, a ∉ A → α a = 0) (hβ : ∀ b, b ∉ B → β b = 0)
    (hγ : ∀ c, c ∉ C → γ c = 0)
    (hS : ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C, a*b*c ∈ S) (U : ℝ) (hU : 0 ≤ U) (K : ℕ)
    (hsize : ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C,
      U < (a*b*c : ℕ) ∧ (a*b*c : ℕ) ≤ (2 : ℝ)^K*U) (t : ℝ) :
    (∑ a ∈ A, α a*harmonicMellinWeight t a)*
      (∑ b ∈ B, β b*harmonicMellinWeight t b)*(∑ c ∈ C, γ c*harmonicMellinWeight t c) =
      ∑ j : Fin K, ∑ n ∈ Icc (⌊(2 : ℝ)^j.val*U⌋₊+1) ⌊(2 : ℝ)^(j.val+1)*U⌋₊,
        (if n ∈ S then endpointTripleConvolution α β γ n/(n : ℂ) else 0)*
          Complex.exp (((Real.log (n : ℝ)*t : ℝ) : ℂ)*Complex.I) := by
  rw [← endpoint_triple_finite_mellin S A B C α β γ hA hB hC hα hβ hγ hS]
  apply finite_mellin_dyadic_representation S _ U hU K
  intro n hn hne
  obtain ⟨a,b,c,ha,hb,hc,han,hbn,hcn,he⟩ := endpoint_triple_nonzero_factors α β γ hne
  have haA : a ∈ A := by by_contra hz; exact han (hα a hz)
  have hbB : b ∈ B := by by_contra hz; exact hbn (hβ b hz)
  have hcC : c ∈ C := by by_contra hz; exact hcn (hγ c hz)
  simpa only [he] using hsize a haA b hbB c hcC

end Bounty
end

