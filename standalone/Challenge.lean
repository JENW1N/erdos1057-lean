section

/- The actual normalized small-prime factor, including arbitrary unit phases. -/

open Finset Filter

namespace Bounty

theorem prime_reciprocal_polynomial_eq_harmonic_sum
    (s : Finset ℕ) (δ : ℕ → ℂ) (u : ℝ) :
    primeReciprocalPolynomial s (fun p => δ p.val) u =
      ∑ p ∈ s, δ p*harmonicMellinWeight u p := by
  unfold primeReciprocalPolynomial
  rw [← sum_coe_sort s (fun p => δ p*harmonicMellinWeight u p)]
  apply sum_congr rfl
  intro p _
  unfold harmonicMellinWeight
  have he : ((Real.log (p.val : ℝ)*u : ℝ) : ℂ)*Complex.I =
      Complex.I*((u*Real.log (p.val : ℝ) : ℝ) : ℂ) := by push_cast; ring
  rw [he]
  push_cast
  ring

theorem exists_candidate_small_prime_factor_data {c : ℝ} (hc : 0 < c) :
    ∃ Bcoeff : ℝ, 1 ≤ Bcoeff ∧ ∀ᶠ L : ℝ in atTop,
      ∀ g ∈ candidateSmallPIndices c L, ∀ (s : Finset ℕ) (P : ℝ),
      s ⊆ candidatePBand (c*L) g → s.Nonempty →
      (∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2*P) →
      (∀ p ∈ s, p.Prime) ∧
      Real.exp (L^(1/10 : ℝ))/2 ≤ P ∧ P ≤ Real.exp (L^(1/5 : ℝ)) ∧
      ∀ θ : ℕ → ℂ, (∀ p ∈ s, ‖θ p‖ ≤ 1) →
        ∀ p : s, ‖(1 / (((∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ)) : ℝ) : ℂ))*θ p.val‖ ≤ Bcoeff := by
  obtain ⟨v,V,hv,_,hgroups⟩ := eventually_candidate_P_groups
    (α := (1/10 : ℝ)) (β := (1/5 : ℝ)) hc (by norm_num) (by norm_num) (by norm_num)
  refine ⟨max 1 (1/v),le_max_left _ _,?_⟩
  filter_upwards [hgroups] with L hg
  intro g hgin s P hs hne hband
  have hdata := hg.2.2.2 g hgin
  obtain ⟨p,hp⟩ := hne
  have hpdata := hdata.2.2 p (hs hp)
  have hpband := hband p hp
  refine ⟨(fun p hp => (hdata.2.2 p (hs hp)).1),by linarith [hpdata.2.1],
    hpband.1.trans hpdata.2.2,?_⟩
  intro θ hθ p
  have hmass := hdata.1
  have hmasspos : 0 < ∑ p ∈ candidatePBand (c*L) g, 1/(p : ℝ) := hv.trans_le hmass
  rw [norm_mul,norm_div,norm_one,Complex.norm_real,Real.norm_eq_abs,abs_of_pos hmasspos]
  calc
    _ ≤ 1/v*1 := mul_le_mul (one_div_le_one_div_of_le hv hmass) (hθ p.val p.property)
      (norm_nonneg _) (by positivity)
    _ ≤ max 1 (1/v) := by simpa only [mul_one] using le_max_right 1 (1/v)

end Bounty
end

section

/- Exact finite pullback along multiplication, with a constructed finite cutoff. -/

open Finset
open scoped Classical
namespace Bounty

theorem integer_scaled_position_sum {s : ℤ} (hs : s ≠ 0)
    (Z positions : Finset ℤ) (hcover : ∀ z ∈ Z, s * z ∈ positions) (F : ℤ → ℂ) :
    (∑ n ∈ positions, if s ∣ n ∧ n / s ∈ Z then F (n / s) else 0) =
      ∑ z ∈ Z, F z := by
  have hsub : Z.image (fun z => s * z) ⊆ positions := by
    intro n hn
    obtain ⟨z, hz, rfl⟩ := mem_image.mp hn
    exact hcover z hz
  have ho : ∀ n ∈ positions, n ∉ Z.image (fun z => s * z) →
      (if s ∣ n ∧ n / s ∈ Z then F (n / s) else 0) = 0 := by
    intro n _ hn
    apply if_neg
    rintro ⟨hd, hz⟩
    exact hn (mem_image.mpr ⟨n / s, hz, Int.mul_ediv_cancel' hd⟩)
  rw [← sum_subset hsub ho]
  rw [sum_image]
  · apply sum_congr rfl
    intro z hz
    have he : s * z / s = z := by exact Int.mul_ediv_cancel_left z hs
    rw [he, if_pos ⟨dvd_mul_right s z, hz⟩]
  · intro a _ b _ hab
    exact mul_left_cancel₀ hs hab










end Bounty
end

section

/- Exact shared and unshared coordinates for the original marked slots. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalCutSlotMap {J ell : ℕ} (C : Finset (Fin J)) :
    ↥(univ \ C) ⊕ Fin (ell + C.card) → PhysicalSlots J ell :=
  Sum.elim (fun j => Sum.inl j.val) (fun j => (physicalGroupUnsharedIndex C j).val)

theorem physical_cut_slot_map_bijective {J ell : ℕ} (C : Finset (Fin J)) :
    Function.Bijective (physicalCutSlotMap (ell := ell) C) := by
  constructor
  · intro a b hab
    cases a with
    | inl a =>
      cases b with
      | inl b =>
        exact congrArg Sum.inl (Subtype.ext (Sum.inl.inj hab))
      | inr b =>
        have hs : Sum.inl a.val ∈ physicalSharedSlots (ell := ell) C :=
          (physical_mem_shared_slots_iff C _).mpr ⟨a.val, (mem_sdiff.mp a.property).2, rfl⟩
        have hn := (physicalGroupUnsharedIndex (ell := ell) C b).property
        change Sum.inl a.val = (physicalGroupUnsharedIndex C b).val at hab
        rw [hab] at hs
        exact False.elim ((mem_compl.mp hn) hs)
    | inr a =>
      cases b with
      | inl b =>
        have hs : Sum.inl b.val ∈ physicalSharedSlots (ell := ell) C :=
          (physical_mem_shared_slots_iff C _).mpr ⟨b.val, (mem_sdiff.mp b.property).2, rfl⟩
        have hn := (physicalGroupUnsharedIndex (ell := ell) C a).property
        change (physicalGroupUnsharedIndex C a).val = Sum.inl b.val at hab
        rw [← hab] at hs
        exact False.elim ((mem_compl.mp hn) hs)
      | inr b =>
        exact congrArg Sum.inr ((physicalGroupUnsharedIndex C).injective (Subtype.ext hab))
  · intro s
    by_cases hs : s ∈ physicalSharedSlots (ell := ell) C
    · obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff C s).mp hs
      exact ⟨Sum.inl ⟨j, mem_sdiff.mpr ⟨mem_univ _, hj⟩⟩, rfl⟩
    · have hu : s ∈ physicalUnsharedSlots (ell := ell) C := mem_compl.mpr hs
      refine ⟨Sum.inr ((physicalGroupUnsharedIndex C).symm ⟨s, hu⟩), ?_⟩
      exact congrArg Subtype.val ((physicalGroupUnsharedIndex C).apply_symm_apply ⟨s, hu⟩)

noncomputable def physicalCutSlotEquiv {J ell : ℕ} (C : Finset (Fin J)) :
    ↥(univ \ C) ⊕ Fin (ell + C.card) ≃ PhysicalSlots J ell :=
  Equiv.ofBijective (physicalCutSlotMap C) (physical_cut_slot_map_bijective C)







end Bounty
end

section

/- Shared-coordinate independence of a prime coefficient does not remove
the original auxiliary exclusions from the surrounding physical edge. -/

open Finset Classical
namespace Bounty

theorem physical_aux_avoids_shared_unshared_iff
    {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (L : PhysicalMarkLists P J ell) :
    physicalAuxAvoids C aux L ↔
      (∀ g (j : C g) (s : ↥(univ \ C g)), aux g j ≠ L g (Sum.inl s.val)) ∧
      (∀ g (j : C g) (u : Fin (ell + (C g).card)),
        aux g j ≠ physicalGroupUnsharedEmbedding C L g u) := by
  constructor
  · intro h
    exact ⟨fun g j s => h g j (Sum.inl s.val),
      fun g j u => h g j (physicalGroupUnsharedIndex (C g) u).val⟩
  · rintro ⟨hs, hu⟩ g j s
    by_cases hmem : s ∈ physicalUnsharedSlots (C g)
    · intro he
      exact hu g j ((physicalGroupUnsharedIndex (C g)).symm ⟨s, hmem⟩)
        (he.trans (physical_unshared_coordinate_embedding C L g s hmem).symm)
    · have hshared : s ∈ physicalSharedSlots (C g) := by
        simpa only [physicalUnsharedSlots, mem_compl, not_not] using hmem
      obtain ⟨v, hv, rfl⟩ := (physical_mem_shared_slots_iff (C g) s).mp hshared
      exact hs g j ⟨v, mem_sdiff.mpr ⟨mem_univ _, hv⟩⟩

end Bounty
end

