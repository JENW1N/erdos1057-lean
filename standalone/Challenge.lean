/- Exact small bare / big memory factorization along a fixed original labeled path. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_group_path_mass_subtype_factors {G : Type*} {J : ℕ}
    (V : G → ℝ) (groups : Finset G) (C : ℕ → G → Finset (Fin J)) (ell n : ℕ) :
    physicalGroupPathMass V groups C ell n =
      physicalStateMass (fun g : {g // g ∈ groups} => V g.val) J ell *
        ∏ j ∈ range n, physicalCompletionMass (fun g : {g // g ∈ groups} => V g.val)
          (fun g => C j g.val) ell := by
  rw [physical_group_path_mass_factors]
  congr 1
  · exact prod_subtype groups (fun _ => Iff.rfl) _
  · apply prod_congr rfl
    intro j hj
    exact prod_subtype groups (fun _ => Iff.rfl) _

theorem physical_group_fixed_path_factor
    {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (small : Finset G) (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : ℕ → I → ℝ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (n : ℕ) :
    (physicalGroupPathMass V small (fun j => C (a j).2.2.1.val) ell n : ℂ) *
      physicalMemoryWalkScalar V patterns C ζ K a L n =
    (physicalStateMass (fun g : {g // g ∈ small} => V g.val) J ell : ℂ) *
      physicalBareWalkScalar (fun g : {g // g ∈ small} => V g.val) patterns
        (fun i g => C i g.val) (fun _ _ => 0) (fun _ _ _ _ _ => 1)
        (fun j => physicalRestrictedEdge (fun g => g ∈ small) patterns C (a j))
        (fun j g => L j g.val) n *
      ∏ j ∈ range n, physicalMemoryLabeledScalar (fun g : {g // g ∉ small} => V g.val)
        patterns (fun i g => C i g.val) (fun _ => 0)
        (physicalFixedEdgeBigCoefficient (fun g => g ∈ small) patterns C
          (ζ (n - 1 - j)) (K (n - 1 - j)) (a j) (L j) (L (j + 1)))
        (physicalRestrictedEdge (fun g => g ∉ small) patterns C (a j))
        (fun g => L j g.val) (fun g => L (j + 1) g.val) := by
  rw [physical_group_path_mass_subtype_factors]
  simp only [Complex.ofReal_mul, Complex.ofReal_prod, physicalMemoryWalkScalar,
    physicalBareWalkScalar]
  rw [mul_assoc, mul_assoc]
  congr 1
  rw [← prod_mul_distrib, ← prod_mul_distrib]
  apply prod_congr rfl
  intro j hj
  have h := physical_partial_memory_labeled_group_factor (fun g => g ∈ small)
    V patterns C (ζ (n - 1 - j)) (K (n - 1 - j)) (a j) (L j) (L (j + 1))
  convert h using 1 <;> congr!




end Bounty
