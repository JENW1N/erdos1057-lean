lemma halfPrimary_lambda_dvd_three : (_root_.OAI.ActualEisensteinCubic.omega - 1 : _root_.OAI.ActualEisensteinCubic.O) ∣ (3:(_root_.OAI.ActualEisensteinCubic.O)) := by
  exact (dvd_pow_self (_root_.OAI.ActualEisensteinCubic.omega - 1 : _root_.OAI.ActualEisensteinCubic.O) (by decide : (2:ℕ)≠0)).trans lambda_sq_dvd_three

lemma halfPrimary_lambda_not_dvd_one : ¬(_root_.OAI.ActualEisensteinCubic.omega - 1 : _root_.OAI.ActualEisensteinCubic.O) ∣ (1:(_root_.OAI.ActualEisensteinCubic.O)) := by
  intro h
  exact PrimaryIdealUnitReindex.lambda_prime_actual.not_isUnit (isUnit_of_dvd_one h)

lemma halfPrimary_omega_pow (j:ℕ) : (_root_.OAI.ActualEisensteinCubic.omega - 1 : _root_.OAI.ActualEisensteinCubic.O) ∣ omega^j-1 := by
  simpa only [one_pow] using sub_dvd_pow_sub_pow omega (1:(_root_.OAI.ActualEisensteinCubic.O)) j

lemma halfPrimary_not_negative (j:ℕ) : ¬(_root_.OAI.ActualEisensteinCubic.omega - 1 : _root_.OAI.ActualEisensteinCubic.O) ∣ -(omega^j)-1 := by
  intro h
  have h2 : (_root_.OAI.ActualEisensteinCubic.omega - 1 : _root_.OAI.ActualEisensteinCubic.O) ∣ (2:(_root_.OAI.ActualEisensteinCubic.O)) := by
    have hh:=dvd_add h (halfPrimary_omega_pow j)
    convert dvd_neg.mpr hh using 1 ;ring
  apply halfPrimary_lambda_not_dvd_one
  convert dvd_sub halfPrimary_lambda_dvd_three h2 using 1 ;ring

abbrev HalfPrimary := {b:(_root_.OAI.ActualEisensteinCubic.O) // (_root_.OAI.ActualEisensteinCubic.omega - 1 : _root_.OAI.ActualEisensteinCubic.O) ∣ b-1}




lemma halfPrimary_not_dvd (b:HalfPrimary) : ¬(_root_.OAI.ActualEisensteinCubic.omega - 1 : _root_.OAI.ActualEisensteinCubic.O)∣b.val := by
  intro h
  apply halfPrimary_lambda_not_dvd_one
  convert dvd_sub h b.2 using 1 ;ring

def halfPrimaryFromAssociate (p:Fin 3×PrimaryLower) : HalfPrimary :=
  ⟨omega^p.1.val*p.2.val,by
    have ha:(_root_.OAI.ActualEisensteinCubic.omega - 1 : _root_.OAI.ActualEisensteinCubic.O)∣p.2.val-1:=halfPrimary_lambda_dvd_three.trans p.2.2
    convert dvd_add ((halfPrimary_omega_pow p.1.val).mul_right p.2.val) ha using 1 ;ring⟩

lemma halfPrimaryFromAssociate_injective : Function.Injective halfPrimaryFromAssociate := by
  intro p q hpq
  have he:omega^p.1.val*p.2.val=omega^q.1.val*q.2.val:=congrArg Subtype.val hpq
  have hunit (j:Fin 3):IsUnit (omega^j.val):=(omega_primitive.isUnit (by decide)).pow _
  have hs:(Ideal.span {p.2.val}:Ideal (_root_.OAI.ActualEisensteinCubic.O))=Ideal.span {q.2.val}:=by
    simpa only [Ideal.span_singleton_mul_left_unit (hunit p.1),
      Ideal.span_singleton_mul_left_unit (hunit q.1)] using
      congrArg (fun z:(_root_.OAI.ActualEisensteinCubic.O)=>(Ideal.span {z}:Ideal (_root_.OAI.ActualEisensteinCubic.O))) he
  have hab:p.2=q.2:=by
    apply Subtype.ext
    have hg:=congrArg primaryGenerator hs
    simpa only [primaryGenerator_span p.2.val (primaryLower_ne_zero p.2) (primaryLower_primary p.2),
      primaryGenerator_span q.2.val (primaryLower_ne_zero q.2) (primaryLower_primary q.2)] using hg
  have hj:p.1=q.1:=by
    apply Fin.ext
    apply omega_primitive.pow_inj p.1.isLt q.1.isLt
    rw [hab] at he
    exact mul_right_cancel₀ (primaryLower_ne_zero q.2) he
  exact Prod.ext hj hab

lemma halfPrimaryFromAssociate_surjective : Function.Surjective halfPrimaryFromAssociate := by
  intro b
  let z:GoodElement:=⟨b.val,PrimaryIdealUnitReindex.primaryGenerator_span_ne_zero_iff b.val |>.mpr
    (halfPrimary_not_dvd b)⟩
  let p:=PrimaryIdealUnitReindex.unitIdealEquiv.symm z
  have he:(p.1:(_root_.OAI.ActualEisensteinCubic.O))*primaryGenerator p.2.val=b.val:=
    congrArg Subtype.val (PrimaryIdealUnitReindex.unitIdealEquiv.apply_symm_apply z)
  let a:PrimaryLower:=primaryLowerIdealEquiv.symm p.2
  have ha:a.val=primaryGenerator p.2.val:=rfl
  have hea:(p.1:(_root_.OAI.ActualEisensteinCubic.O))*a.val=b.val:=by simpa only [ha] using he
  have hu:(_root_.OAI.ActualEisensteinCubic.omega - 1 : _root_.OAI.ActualEisensteinCubic.O)∣(p.1:(_root_.OAI.ActualEisensteinCubic.O))-1:=by
    have hpa:(_root_.OAI.ActualEisensteinCubic.omega - 1 : _root_.OAI.ActualEisensteinCubic.O)∣a.val-1:=halfPrimary_lambda_dvd_three.trans a.2
    have hh:=dvd_sub b.2 (hpa.mul_left (p.1:(_root_.OAI.ActualEisensteinCubic.O)))
    rw [←hea] at hh
    convert hh using 1 ;ring
  obtain ⟨j,hj|hj⟩:=unit_eq_sign_omega p.1
  · exact ⟨(j,a),Subtype.ext (by simpa only [halfPrimaryFromAssociate,hj] using hea)⟩
  · exact (halfPrimary_not_negative j.val (by simpa only [hj] using hu)).elim

def halfPrimaryAssociateEquiv : Fin 3×PrimaryLower ≃ HalfPrimary :=
  Equiv.ofBijective halfPrimaryFromAssociate
    ⟨halfPrimaryFromAssociate_injective,halfPrimaryFromAssociate_surjective⟩







