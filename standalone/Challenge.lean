def unitCuspUpper (b : (_root_.OAI.ActualEisensteinCubic.O)) : SL(2,(_root_.OAI.ActualEisensteinCubic.O)) := ⟨!![1,b;0,1],by simp [Matrix.det_fin_two]⟩
def unitCuspDiagonal (u : (_root_.OAI.ActualEisensteinCubic.O)ˣ) : SL(2,(_root_.OAI.ActualEisensteinCubic.O)) := ⟨!![(u:(_root_.OAI.ActualEisensteinCubic.O)),0;0,(↑u⁻¹:(_root_.OAI.ActualEisensteinCubic.O))],by
  simp [Matrix.det_fin_two]⟩

theorem rational_cusp_lower_factor (u : (_root_.OAI.ActualEisensteinCubic.O)ˣ) (n : ℤ) :
    rationalEmbedding ModularGroup.S*unitCuspUpper (n:(_root_.OAI.ActualEisensteinCubic.O))*lowerCuspMatrix (u:(_root_.OAI.ActualEisensteinCubic.O))=
      unitCuspDiagonal (-u)*lowerCuspMatrix (-(u:(_root_.OAI.ActualEisensteinCubic.O))*(1+(n:(_root_.OAI.ActualEisensteinCubic.O))*(u:(_root_.OAI.ActualEisensteinCubic.O))))*
        unitCuspUpper (↑u⁻¹:(_root_.OAI.ActualEisensteinCubic.O)) := by
  apply Subtype.ext
  change ((!![(0 : ℤ), -1; 1, 0]).map (Int.castRingHom (_root_.OAI.ActualEisensteinCubic.O)) *
    !![1, (n : (_root_.OAI.ActualEisensteinCubic.O)); 0, 1] * !![1, 0; (u : (_root_.OAI.ActualEisensteinCubic.O)), 1]) =
    (!![(↑(-u) : (_root_.OAI.ActualEisensteinCubic.O)), 0; 0, (↑(-u)⁻¹ : (_root_.OAI.ActualEisensteinCubic.O))] *
      !![1, 0; -(u : (_root_.OAI.ActualEisensteinCubic.O)) * (1 + (n : (_root_.OAI.ActualEisensteinCubic.O)) * (u : (_root_.OAI.ActualEisensteinCubic.O))), 1] *
      !![1, (↑u⁻¹ : (_root_.OAI.ActualEisensteinCubic.O)); 0, 1])
  funext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two, neg_mul, Units.val_neg,
      mul_add, add_mul, mul_assoc, add_comm]

lemma unitCuspUpper_section (b : (_root_.OAI.ActualEisensteinCubic.O)) (z : ℂ) (v : ℝ) (hv : 0<v) :
    integralComplexMatrix (unitCuspUpper b)*upperSection z v hv=
      upperSection (z+eisEmbedding b) v hv := by
  apply Subtype.ext
  change ((!![1, b; 0, 1] : Matrix (Fin 2) (Fin 2) (_root_.OAI.ActualEisensteinCubic.O)).map eisEmbedding *
    !![(Real.sqrt v : ℂ), z / Real.sqrt v; 0, (Real.sqrt v : ℂ)⁻¹]) =
    !![(Real.sqrt v : ℂ), (z + eisEmbedding b) / Real.sqrt v;
      0, (Real.sqrt v : ℂ)⁻¹]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two]
  ring




