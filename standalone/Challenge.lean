section
open Finset
structure ActiveGhostState (R : Type*) where
  unborn : ℝ
  pending : R → ℝ
  completed : ℝ

noncomputable def activeGhostStep {R : Type*} [DecidableEq R]
    (active : Bool) (hit : R) (η β : ℝ) (s : ActiveGhostState R) :
    ActiveGhostState R :=
  if active then
    { unborn := 0
      pending := fun r => if r = hit then s.pending r + β * s.unborn else 0
      completed := s.pending hit + β * s.unborn }
  else
    { unborn := s.unborn
      pending := fun r => s.pending r * (1 - η * (if r = hit then 1 else 0)) -
        β * s.unborn * η * (if r = hit then 1 else 0)
      completed := s.completed - η * s.pending hit }

noncomputable def activeGhostRun {R : Type*} [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) : ℕ → ActiveGhostState R
  | 0 => ⟨1, fun _ => 0, 0⟩
  | n + 1 => activeGhostStep (a n) (h n) (η n) β (activeGhostRun a h η β n)

noncomputable def activeGhostLocalFactor {R : Type*} [DecidableEq R]
    (active : Bool) (hit : R) (η : ℝ) (r : R) : ℝ :=
  if active then (if r = hit then 1 else 0)
  else 1 - η * (if r = hit then 1 else 0)




/- Each pending residue retains the full local product, with the surviving
unborn coefficient removed. The birth factor is paid exactly once. -/
theorem activeGhost_pending {R : Type*} [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) (r : R) :
    (activeGhostRun a h η β n).pending r =
      β * ((∏ i ∈ range n, activeGhostLocalFactor (a i) (h i) (η i) r) -
        (activeGhostRun a h η β n).unborn) := by
  induction n with
  | zero => simp [activeGhostRun]
  | succ n ih =>
    cases ha : a n <;>
      simp only [activeGhostRun, activeGhostStep, activeGhostLocalFactor,
        ha, Bool.false_eq_true, ↓reduceIte, prod_range_succ] <;>
      rw [ih] <;> simp only [activeGhostLocalFactor] <;> split <;> simp_all <;> ring

/- Signed conservation identity, including the unborn compensation term. -/
theorem activeGhost_completed_balance {R : Type*} [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) :
    (activeGhostRun a h η β n).completed =
      (∑ r : R, (activeGhostRun a h η β n).pending r) +
        β * (activeGhostRun a h η β n).unborn * ∑ i ∈ range n, η i := by
  induction n with
  | zero => simp [activeGhostRun]
  | succ n ih =>
    cases ha : a n
    · have hs : (∑ r : R, (activeGhostRun a h η β (n + 1)).pending r) =
          (∑ r : R, (activeGhostRun a h η β n).pending r) -
            η n * (activeGhostRun a h η β n).pending (h n) -
            β * (activeGhostRun a h η β n).unborn * η n := by
        simp only [activeGhostRun, activeGhostStep, ha, Bool.false_eq_true,
          ↓reduceIte, mul_sub, mul_one, sum_sub_distrib]
        simp only [mul_ite, mul_one, mul_zero, sum_ite_eq', mem_univ, if_true]
        ring
      rw [hs]
      simp only [activeGhostRun, activeGhostStep, ha, Bool.false_eq_true,
        ↓reduceIte, sum_range_succ]
      rw [ih]
      ring
    · simp [activeGhostRun, activeGhostStep, ha]

/- The local product splits into active indicator factors and inactive damping. -/
theorem activeGhost_product_eq_weight {R : Type*} [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (n : ℕ) (r : R) :
    (∏ i ∈ range n, activeGhostLocalFactor (a i) (h i) (η i) r) =
      activeResidueWeight (range n) ((range n).filter (fun i => a i = true)) h η r := by
  classical
  have hs : range n \ (range n).filter (fun i => a i = true) =
      (range n).filter (fun i => ¬ a i = true) := by
    ext i
    simp only [mem_sdiff, mem_filter]
    tauto
  rw [activeResidueWeight, hs]
  rw [← prod_filter_mul_prod_filter_not (range n) (fun i => a i = true)
    (fun i => activeGhostLocalFactor (a i) (h i) (η i) r)]
  congr 1
  · apply prod_congr rfl
    intro i hi
    simp only [mem_filter] at hi
    simp [activeGhostLocalFactor, hi.2]
  · apply prod_congr rfl
    intro i hi
    simp only [mem_filter] at hi
    simp [activeGhostLocalFactor, hi.2]




/- A product formula valid with any activity pattern. -/
theorem activeGhost_completed_product {R : Type*} [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) :
    (activeGhostRun a h η β n).completed =
      β * ((∑ r : R, ∏ i ∈ range n, activeGhostLocalFactor (a i) (h i) (η i) r) -
        (Fintype.card R : ℝ) * (activeGhostRun a h η β n).unborn +
        (activeGhostRun a h η β n).unborn * ∑ i ∈ range n, η i) := by
  rw [activeGhost_completed_balance]
  simp_rw [activeGhost_pending]
  rw [← mul_sum, sum_sub_distrib]
  simp only [sum_const, card_univ, nsmul_eq_mul]
  ring

/- The unborn-plus-completed coefficient is the normalized local expectation,
for every pattern of active and inactive visits. -/
theorem activeGhost_vacuum_identity {R : Type*} [Fintype R] [DecidableEq R]
    [Nonempty R] (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (n : ℕ) (b : ℝ)
    (hb : b = 1 - (∑ i ∈ range n, η i) / Fintype.card R) (hb0 : b ≠ 0) :
    (activeGhostRun a h η ((Fintype.card R : ℝ) * b)⁻¹ n).unborn +
      (activeGhostRun a h η ((Fintype.card R : ℝ) * b)⁻¹ n).completed =
      ((∑ r : R, ∏ i ∈ range n,
        activeGhostLocalFactor (a i) (h i) (η i) r) / Fintype.card R) / b := by
  have hc : (Fintype.card R : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have heq : b * Fintype.card R = Fintype.card R - ∑ i ∈ range n, η i := by
    rw [hb]
    field_simp
  have hcancel : 1 - ((Fintype.card R : ℝ) * b)⁻¹ * Fintype.card R +
      ((Fintype.card R : ℝ) * b)⁻¹ * (∑ i ∈ range n, η i) = 0 := by
    field_simp
    nlinarith [heq]
  rw [activeGhost_completed_product]
  calc
    _ = ((Fintype.card R : ℝ) * b)⁻¹ *
        (∑ r : R, ∏ i ∈ range n, activeGhostLocalFactor (a i) (h i) (η i) r) +
        (activeGhostRun a h η ((Fintype.card R : ℝ) * b)⁻¹ n).unborn *
        (1 - ((Fintype.card R : ℝ) * b)⁻¹ * Fintype.card R +
          ((Fintype.card R : ℝ) * b)⁻¹ * (∑ i ∈ range n, η i)) := by ring
    _ = _ := by rw [hcancel]; simp only [mul_zero, add_zero, div_eq_mul_inv, mul_inv_rev]; ring






end

section
open Finset
/- An active visit forces a hit. It may begin or finish an active lifespan,
but neither leaves an unborn prime nor revives a completed lifespan. -/
noncomputable def activeGhostFiniteKernel {R : Type*} [DecidableEq R]
    (active : Bool) (hit : R) (η β : ℝ) : GhostFiniteState R → GhostFiniteState R → ℝ :=
  if active then fun x y => match x, y with
    | none, _ => 0
    | some none, none => β
    | some none, some none => 0
    | some none, some (some r) => if r = hit then 1 else 0
    | some (some r), none => if r = hit then β else 0
    | some (some _), some none => 0
    | some (some r), some (some s) => if r = hit ∧ s = r then 1 else 0
  else ghostFiniteKernel hit η β

/- All three evolving coefficients form the finite state vector. -/
def activeGhostFiniteVector {R : Type*} (s : ActiveGhostState R) : GhostFiniteState R → ℝ
  | none => s.unborn
  | some none => s.completed
  | some (some r) => s.pending r

/- The transition matrix is exactly the unified ghost recurrence. -/
theorem active_ghost_finite_kernel_step {R : Type*} [Fintype R] [DecidableEq R]
    (active : Bool) (hit : R) (η β : ℝ) (s : ActiveGhostState R) (x : GhostFiniteState R) :
    (∑ y, activeGhostFiniteKernel active hit η β x y * activeGhostFiniteVector s y) =
      activeGhostFiniteVector (activeGhostStep active hit η β s) x := by
  cases active <;> rcases x with _ | (_ | r)
  · simp [activeGhostFiniteKernel, ghostFiniteKernel, activeGhostFiniteVector, activeGhostStep]
  · simp [activeGhostFiniteKernel, ghostFiniteKernel, activeGhostFiniteVector, activeGhostStep,
      sub_eq_add_neg, mul_comm]
  · simp [activeGhostFiniteKernel, ghostFiniteKernel, activeGhostFiniteVector, activeGhostStep]
    split <;> simp_all
    ring
  · simp [activeGhostFiniteKernel, activeGhostFiniteVector, activeGhostStep]
  · simp [activeGhostFiniteKernel, activeGhostFiniteVector, activeGhostStep, add_comm]
  · by_cases hr : r = hit
    · subst r
      simp [activeGhostFiniteKernel, activeGhostFiniteVector, activeGhostStep, add_comm]
    · simp [activeGhostFiniteKernel, activeGhostFiniteVector, activeGhostStep, hr]

/- Finite matrix evolution tracks the exact mixed active/inactive history. -/
theorem active_ghost_finite_action_eq_vector {R : Type*} [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) (x : GhostFiniteState R) :
    finitePathAction (fun j => activeGhostFiniteKernel (a j) (h j) (η j) β)
      ghostFiniteInitial n x = activeGhostFiniteVector (activeGhostRun a h η β n) x := by
  induction n generalizing x with
  | zero => rcases x with _ | (_ | r) <;> rfl
  | succ n ih =>
    simp only [finitePathAction, ih, activeGhostRun]
    exact active_ghost_finite_kernel_step (a n) (h n) (η n) β _ x
end

