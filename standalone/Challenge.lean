theorem stdAddChar_mul_eq_fourier {q : ℕ} [NeZero q] (n : ℤ) (k : ZMod q) :
    ZMod.stdAddChar ((n : ZMod q) * k) =
      fourier n (((k.val : ℝ) / q : ℝ) : AddCircle (1 : ℝ)) := by
  have hcast : (n : ZMod q) * k = ((n * (k.val : ℤ) : ℤ) : ZMod q) := by
    simp only [Int.cast_mul, Int.cast_natCast, ZMod.natCast_zmod_val]
  rw [hcast, ZMod.stdAddChar_coe, fourier_coe_apply]
