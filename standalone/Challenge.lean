section

/- The actual harmonic coefficient mass is controlled by endpoint square energies. -/

open Finset Real
namespace Bounty

theorem harmonic_coefficient_mass_le (S : Finset ℤ) (θ f g : ℤ → ℂ)
    {Y : ℝ} (hY : 0 < Y) (hYn : ∀ n ∈ S, Y ≤ (n : ℝ))
    (hθ : ∀ n ∈ S, ‖θ n‖ ≤ 1) :
    (∑ n ∈ S, ‖(θ n/(n : ℂ))*star (f n)*g n‖) ≤
      (1/Y)*sqrt (∑ n ∈ S, ‖f n‖^2)*sqrt (∑ n ∈ S, ‖g n‖^2) := by
  have hterm (n : ℤ) (hn : n ∈ S) : ‖θ n/(n : ℂ)‖ ≤ 1/Y := by
    have hn0 : (0 : ℝ) < n := hY.trans_le (hYn n hn)
    have hnorm : ‖(n : ℂ)‖ = (n : ℝ) := by
      rw [← Complex.ofReal_intCast, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hn0]
    rw [norm_div, hnorm]
    exact div_le_div₀ (by norm_num) (hθ n hn) hY (hYn n hn)
  calc
    _ ≤ ∑ n ∈ S, (1/Y)*(‖f n‖*‖g n‖) := by
      apply sum_le_sum
      intro n hn
      rw [norm_mul, norm_mul, norm_star]
      exact (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right (hterm n hn) (norm_nonneg _)) (norm_nonneg _)).trans_eq (by ring)
    _ = (1/Y)*∑ n ∈ S, ‖f n‖*‖g n‖ := (mul_sum ..).symm
    _ ≤ _ := by
      simpa only [mul_assoc] using mul_le_mul_of_nonneg_left
        (Real.sum_mul_le_sqrt_mul_sqrt S (fun n => ‖f n‖) (fun n => ‖g n‖))
        (one_div_nonneg.mpr hY.le)

end Bounty
end

