theorem finite_projected_probe_tensor_energy {G : Type*} [Fintype G] [DecidableEq G]
    {I X : G → Type*} [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (hμ : ∀ g x, 0 ≤ μ g x) (hmass : ∀ g, ∑ x, μ g x = 1)
    (A B : ∀ g, Finset (I g)) (hAB : ∀ g, Disjoint (A g) (B g)) (hm : ∀ g, 0 < (A g).card)
    (s : Finset G) (f : (∀ g, I g → X g) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g)))
      (finiteCoordinateFinsetAction (fun g v => finiteCoordinateComponent (fun _ : I g => μ g)
        (A g) (A g ∪ B g).toList (finiteSlotSymmetrize v)) s f) ≤
      (∏ g ∈ s, (((B g).card : ℝ) ^ (B g).card / ((A g).card : ℝ) ^ (B g).card)) *
        finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))) f := by
  apply finite_coordinate_finset_energy_le
    (fun g => finiteProductWeight (fun _ : I g => μ g))
    (fun g x => Finset.prod_nonneg (fun i _ => hμ g (x i)))
    (fun g v => finiteCoordinateComponent (fun _ : I g => μ g)
      (A g) (A g ∪ B g).toList (finiteSlotSymmetrize v))
    (fun g => (((B g).card : ℝ) ^ (B g).card / ((A g).card : ℝ) ^ (B g).card))
    (fun _ => by positivity)
  intro g v
  exact finite_projected_probe_energy (μ g) (hμ g) (hmass g) (A g) (B g) (hAB g) (hm g) v
end

