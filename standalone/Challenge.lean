theorem totient_sieve_interval_squarefree_prime_support (N : ℕ) :
    ∀ d ∈ (Icc 1 N).filter Squarefree,
      d.primeFactors ⊆ (Icc 1 N).filter Nat.Prime := by
  intro d hd p hp
  have hpri := Nat.prime_of_mem_primeFactors hp
  exact mem_filter.mpr ⟨mem_Icc.mpr ⟨hpri.one_le,
    (Nat.le_of_mem_primeFactors hp).trans (mem_Icc.mp (mem_filter.mp hd).1).2⟩, hpri⟩

theorem totient_sieve_interval_noncoprime_mass (N n : ℕ) (hn : n ≠ 0) :
    (∑ d ∈ (Icc 1 N).filter (fun d => Squarefree d ∧ ¬ Nat.Coprime d n),
      1 / (Nat.totient d : ℝ)) ≤
      (∑ p ∈ n.primeFactors.filter (fun p => p ≤ N), 1 / ((p : ℝ) - 1)) *
        ∏ p ∈ (Icc 1 N).filter Nat.Prime, (1 + 1 / ((p : ℝ) - 1)) := by
  have hprime : ∀ p ∈ (Icc 1 N).filter Nat.Prime, p.Prime :=
    fun p hp => (mem_filter.mp hp).2
  have hf : ((Icc 1 N).filter Nat.Prime).filter (fun p => p ∣ n) =
      n.primeFactors.filter (fun p => p ≤ N) := by
    ext p
    simp only [mem_filter, mem_Icc, Nat.mem_primeFactors, hn, ne_eq, not_false_eq_true,
      and_true]
    constructor
    · rintro ⟨⟨⟨_, hpN⟩, hp⟩, hpn⟩
      exact ⟨⟨hp, hpn⟩, hpN⟩
    · rintro ⟨⟨hp, hpn⟩, hpN⟩
      exact ⟨⟨⟨hp.one_le, hpN⟩, hp⟩, hpn⟩
  have hb := totient_sieve_squarefree_noncoprime_mass
    ((Icc 1 N).filter Nat.Prime) ((Icc 1 N).filter Squarefree) hprime
    (fun d hd => (mem_filter.mp hd).2)
    (totient_sieve_interval_squarefree_prime_support N) n
  simpa only [filter_filter, hf] using hb
end

