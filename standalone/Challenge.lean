theorem exists_rough_integer_polynomial :
    ∃ K : ℝ, 0 < K ∧ ∀ {z : ℝ}, 1 < z → ∀ h : ℕ, 1 ≤ h → Even h →
      ∃ lam : ℕ → ℝ,
        (∀ d, |lam d| ≤ 1) ∧
        (∀ d, lam d ≠ 0 → 0 < d ∧ (d : ℝ) ≤ z^(4 * (h : ℝ) + 2) ∧
          Squarefree d ∧ d ∣ ∏ p ∈ primeBand 0 z, p) ∧
        (∀ n : ℕ, n ≠ 0 → 0 ≤ ∑ d ∈ n.divisors, lam d ∧
          (if ∀ p ∈ n.primeFactors, z < (p : ℝ) then (1 : ℝ) else 0) ≤
            ∑ d ∈ n.divisors, lam d) ∧
        (∑' d : ℕ, |lam d| / (d : ℝ)) ≤ K * Real.log (2 * z) ∧
        ∀ a b : ℝ, 0 ≤ a → a ≤ b →
          let M := (∑ n ∈ Ioc ⌊a⌋₊ ⌊b⌋₊, ∑ d ∈ n.divisors, lam d) -
            ((roughBand a b z).card : ℝ)
