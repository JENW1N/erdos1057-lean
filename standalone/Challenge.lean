  split_ifs <;> simp

theorem full_mixed_ghost_sum_ulift [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)]
    [∀ k c, Fintype (A k c)] (j : J)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (F : CoupledGhostEvent M B s → ℂ) :
    let _ : ∀ (k : J ⊕ K) x, Fintype (FullMixedMemoryEvent n S B A Δ D k x) :=
      fullMixedMemoryEventFintype n S B A Δ D
    (∑ e : FullMixedMemoryEvent n S B A Δ D (.inl j) s, F e.down) =
      ∑ e : CoupledGhostEvent M B s, F e := by
  let _ : ∀ (k : J ⊕ K) x, Fintype (FullMixedMemoryEvent n S B A Δ D k x) :=
    fullMixedMemoryEventFintype n S B A Δ D
  refine Eq.trans ?_ (Equiv.sum_comp
    (Equiv.ulift : ULift.{uA} (CoupledGhostEvent M B s) ≃ CoupledGhostEvent M B s) F)
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _
    rfl

theorem full_mixed_ghost_ledger_event_sum [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
    [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (j : J) (F : GlobalBirthJointState (fun g p => ZMod (n g p)) → ℂ)
    (s : BoundedGhostJointLedgerState n M B) :
    let _ : ∀ (k : J ⊕ K) x, Fintype (FullMixedMemoryEvent n S B A Δ D k x) :=
      fullMixedMemoryEventFintype n S B A Δ D
    (∑ e : FullMixedMemoryEvent n S B A Δ D (.inl j) (fun g => (s g).2),
      (fullMixedMemoryEventWeight n S B A Δ D ω μ q ρ V (.inl j) (fun g => (s g).2) e : ℂ) *
        fullMixedGhostFreshnessPhase n S B A Δ D j s e *
        F (boundedGhostJointDecode n M B (fullMixedGhostLedgerTarget n S B A Δ D j s e))) =
    ∑ e : CoupledGhostEvent M B (fun g => (s g).2),
      (coupledGhostJointEventWeight
        (fun g => physicalGhostRetention (n g) (q j) ρ)
        (fun g => physicalGhostTermination (n g) (q j) ρ)
        (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) M B (fun g => (s g).2) e : ℂ) *
      (if boundedGhostJointFresh n M B s e then 1 else 0) *
        F (boundedGhostJointDecode n M B (boundedGhostJointTarget n M B s e)) := by
  let _ : ∀ (k : J ⊕ K) x, Fintype (FullMixedMemoryEvent n S B A Δ D k x) :=
    fullMixedMemoryEventFintype n S B A Δ D
  dsimp only
  simpa only [fullMixedMemoryEventWeight, fullMixedGhostFreshnessPhase, fullMixedGhostLedgerTarget] using
    full_mixed_ghost_sum_ulift n S B A Δ D j (fun g => (s g).2)
      (fun e => (coupledGhostJointEventWeight
        (fun g => physicalGhostRetention (n g) (q j) ρ)
        (fun g => physicalGhostTermination (n g) (q j) ρ)
        (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
        (fun g => unrestrictedResidueWeight (μ g)) M B (fun g => (s g).2) e : ℂ) *
        (if boundedGhostJointFresh n M B s e then 1 else 0) *
        F (boundedGhostJointDecode n M B (boundedGhostJointTarget n M B s e)))

theorem full_mixed_ghost_raw_visit_events [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
    [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)]
    (ω : ∀ k c, A k c → ℝ) (β : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (j : J) (a : ∀ g, P g → Bool) (hV : ∀ g, V g ≠ 0)
    (F : GlobalBirthJointState (fun g p => ZMod (n g p)) → ℂ)
    (s : BoundedGhostJointLedgerState n M B) :
    let _ : ∀ (k : J ⊕ K) x, Fintype (FullMixedMemoryEvent n S B A Δ D k x) :=
      fullMixedMemoryEventFintype n S B A Δ D
    globalBirthJointCutRawRow
      (fun g => GlobalBirthRawStep.visit (a := a g) (fun _ => 0) (β g)
        (1 - q j) (V g) ρ (hV g) B) B B F (boundedGhostJointDecode n M B s) =
    ∑ e : FullMixedMemoryEvent n S B A Δ D (.inl j) (fun g => (s g).2),
      (fullMixedMemoryEventWeight n S B A Δ D ω (fun g p => β g p / V g) q ρ V
        (.inl j) (fun g => (s g).2) e : ℂ) *
      fullMixedGhostFreshnessPhase n S B A Δ D j s e *
        F (boundedGhostJointDecode n M B (fullMixedGhostLedgerTarget n S B A Δ D j s e)) := by
  let _ : ∀ (k : J ⊕ K) x, Fintype (FullMixedMemoryEvent n S B A Δ D k x) :=
    fullMixedMemoryEventFintype n S B A Δ D
  dsimp only
  refine Eq.trans ?_ (full_mixed_ghost_ledger_event_sum n S B A Δ D ω
    (fun g p => β g p / V g) q ρ V j F s).symm
  simpa only [sub_sub_cancel] using global_birth_joint_visit_bounded_events n β
    (fun _ => 1 - q j) V (fun _ => ρ) M B a hV F s

end
