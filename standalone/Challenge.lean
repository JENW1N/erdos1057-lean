open scoped BigOperators ComplexConjugate
open MeasureTheory

namespace Bounty

theorem interval_gram_norm_symm (u v : ℝ → ℂ) (a b : ℝ) :
    ‖∫ t in a..b, u t * conj (v t)‖ = ‖∫ t in a..b, v t * conj (u t)‖ := by
  rw [← Complex.norm_conj (∫ t in a..b, v t * conj (u t)),
    ← intervalIntegral.intervalIntegral_conj]
  congr 1
  apply intervalIntegral.integral_congr
  intro t _
  simp only [map_mul, starRingEnd_self_apply]
  ring

theorem interval_finite_gram_row_bound {ι : Type*} (s : Finset ι)
    (u : ι → ℝ → ℂ) (c : ι → ℂ) (a b B : ℝ)
    (hu : ∀ i ∈ s, Continuous (u i))
    (hrow : ∀ i ∈ s, (∑ j ∈ s, ‖∫ t in a..b, u i t * conj (u j t)‖) ≤ B) :
    (∫ t in a..b, ‖∑ i ∈ s, c i * u i t‖ ^ 2) ≤ B * ∑ i ∈ s, ‖c i‖ ^ 2 := by
  let K (i j : ι) : ℂ := ∫ t in a..b, u i t * conj (u j t)
  have hterm (i j : ι) :
      2 * (c i * conj (c j) * K i j).re ≤
        ‖c i‖ ^ 2 * ‖K i j‖ + ‖c j‖ ^ 2 * ‖K i j‖ := by
    have hre := Complex.re_le_norm (c i * conj (c j) * K i j)
    simp only [norm_mul, Complex.norm_conj] at hre
    nlinarith [mul_nonneg (sq_nonneg (‖c i‖ - ‖c j‖)) (norm_nonneg (K i j))]
  have hs := Finset.sum_le_sum (fun i (_ : i ∈ s) =>
    Finset.sum_le_sum (fun j (_ : j ∈ s) => hterm i j))
  have hswap : (∑ i ∈ s, ∑ j ∈ s, ‖c j‖ ^ 2 * ‖K i j‖) =
      ∑ i ∈ s, ‖c i‖ ^ 2 * ∑ j ∈ s, ‖K i j‖ := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    rw [show ‖K j i‖ = ‖K i j‖ from interval_gram_norm_symm (u j) (u i) a b]
  simp only [Finset.sum_add_distrib] at hs
  simp_rw [← Finset.mul_sum] at hs
  rw [hswap] at hs
  have hm : (∑ i ∈ s, ∑ j ∈ s, (c i * conj (c j) * K i j).re) ≤
      ∑ i ∈ s, ‖c i‖ ^ 2 * ∑ j ∈ s, ‖K i j‖ := by linarith
  rw [interval_finite_gram_energy s u c a b hu]
  calc
    _ ≤ ∑ i ∈ s, ‖c i‖ ^ 2 * ∑ j ∈ s, ‖K i j‖ := hm
    _ ≤ ∑ i ∈ s, ‖c i‖ ^ 2 * B := Finset.sum_le_sum (fun i hi =>
      mul_le_mul_of_nonneg_left (hrow i hi) (sq_nonneg _))
    _ = _ := by rw [← Finset.sum_mul, mul_comm]

end Bounty
end

