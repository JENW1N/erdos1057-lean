theorem full_mixed_path_local_freshness_iff :
    (∀ i : Fin steps.length,
      let e := finiteEventPathOccurrence
        (fun tag (s : FullMixedLedgerState n (M := M) B) =>
          FullPermutationMixedEvent n S B A Δ D tag s.2)
        (fullMixedLedgerTarget n S B A Δ D) steps x p i
      FullMixedLocalBirthAvoids n S B A Δ D e.1.1 (steps.get i) e.1.2 e.2 ∧
        FullMixedLocalBirthDistinct n S B A Δ D (steps.get i) e.1.2 e.2) ↔
    ((∀ (a : FullMixedBirthAddress S B steps) (z : (g : Fin N) × P g),
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p a = some z →
        z.2 ∉ (finiteEventPathOccurrence
          (fun tag (s : FullMixedLedgerState n (M := M) B) =>
            FullPermutationMixedEvent n S B A Δ D tag s.2)
          (fullMixedLedgerTarget n S B A Δ D) steps x p a.1).1.1 z.1) ∧
      (∀ (a b : FullMixedBirthAddress S B steps) z, a.1.val = b.1.val →
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p a = some z →
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p b = some z → a = b)) := by
  constructor
  · intro h
    constructor
    · rintro ⟨i, a⟩ z hz
      exact (h i).1 a z hz
    · rintro ⟨i, a⟩ ⟨j, b⟩ z hij ha hb
      have heq : i = j := Fin.ext hij
      subst j
      exact congrArg (Sigma.mk i) ((h i).2 a b z ha hb)
  · rintro ⟨ha, hd⟩ i
    constructor
    · intro a z hz
      exact ha ⟨i, a⟩ z hz
    · intro a b z haz hbz
      have heq := hd ⟨i, a⟩ ⟨i, b⟩ z rfl haz hbz
      exact eq_of_heq (Sigma.mk.inj_iff.mp heq).2

theorem full_mixed_path_local_freshness_global_iff
    (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
    (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (hx : FullMixedLedgerCovers n B x)
    (hp : finiteEventPathWeight
      (fun tag (s : FullMixedLedgerState n (M := M) B) =>
        FullPermutationMixedEvent n S B A Δ D tag s.2)
      (fullMixedLedgerTarget n S B A Δ D)
      (fun tag s => fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag s.2)
      steps x p ≠ 0) :
    (∀ i : Fin steps.length,
      let e := finiteEventPathOccurrence
        (fun tag (s : FullMixedLedgerState n (M := M) B) =>
          FullPermutationMixedEvent n S B A Δ D tag s.2)
        (fullMixedLedgerTarget n S B A Δ D) steps x p i
      FullMixedLocalBirthAvoids n S B A Δ D e.1.1 (steps.get i) e.1.2 e.2 ∧
        FullMixedLocalBirthDistinct n S B A Δ D (steps.get i) e.1.2 e.2) ↔
    ((∀ (a : FullMixedBirthAddress S B steps) (z : (g : Fin N) × P g),
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p a = some z → z.2 ∉ x.1 z.1) ∧
      (∀ (a b : FullMixedBirthAddress S B steps) z,
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p a = some z →
        fullMixedLedgerPathBirthLabel n S B A Δ D steps x p b = some z → a = b)) :=
  (full_mixed_path_local_freshness_iff n S B A Δ D steps x p).trans
    (full_mixed_birth_freshness_iff n S B A Δ D ω μ q ρ V steps x p hx hp)

end Full
end Bounty
