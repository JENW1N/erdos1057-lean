  (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (t : G → ℕ) (B : ℕ)

theorem unrestricted_storage_only_product_energy_le
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (unrestrictedStorageOnlyProduct n Δ D μ ρ V t B f) ≤
      unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  exact unrestricted_coupled_cutoff_product_energy_le n Δ D μ ρ V t B
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht _
    (by intros; split_ifs <;> norm_num) f hf

theorem unrestricted_reverse_promotion_only_product_energy_le
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (unrestrictedReversePromotionOnlyProduct n Δ D μ ρ V t B f) ≤
      unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  apply finite_symmetric_transpose_energy_le
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ (fun g => unrestrictedResidueWeight (μ g))
      hμ (fun g z => hμ g z.1)) ProductMemorySymmetric
    (unrestrictedReversePromotionOnlyProduct n Δ D μ ρ V t B)
    (unrestrictedStorageOnlyProduct n Δ D μ ρ V t B)
  · intro q hq x i τ
    dsimp only
    rw [hq x i τ]
  · exact unrestricted_reverse_promotion_only_product_symmetric n Δ D μ ρ V t B
  · intro q r hq hr
    have hp := unrestricted_storage_only_product_pairing n Δ D μ ρ V t B
      (fun g => (hvmin.trans_le (hVlo g)).ne') r q hr hq
    simpa only [mul_assoc, mul_comm, mul_left_comm] using hp.symm
  · exact pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _
  · exact unrestricted_storage_only_product_energy_le n Δ D μ ρ V t B
      hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht
  · exact hf

end

