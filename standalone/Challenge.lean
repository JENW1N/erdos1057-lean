/- Every original structural condition and scalar product is invariant under group reindexing. -/

open Finset
open scoped Classical
namespace Bounty
section Reindex
variable {G H : Type*} (e : G ≃ H) {P : G → Finset ℕ} {J ell : ℕ}
  (C : G → Finset (Fin J)) (a : PhysicalAuxLabels P C) (L R : PhysicalMarkLists P J ell)

theorem physical_list_admissible_group_reindex :
    physicalListAdmissible (fun h => C (e.symm h)) (physicalAuxGroupReindex e P J C a)
      (physicalMarkGroupReindex e P J ell L) (physicalMarkGroupReindex e P J ell R) ↔
      physicalListAdmissible C a L R := by
  constructor
  · rintro ⟨hs, hL, hR⟩
    refine ⟨?_, ?_, ?_⟩
    · intro g
      obtain ⟨h, rfl⟩ := e.symm.surjective g
      exact hs h
    · intro g
      obtain ⟨h, rfl⟩ := e.symm.surjective g
      exact hL h
    · intro g
      obtain ⟨h, rfl⟩ := e.symm.surjective g
      exact hR h
  · rintro ⟨hs, hL, hR⟩
    exact ⟨(fun h => hs (e.symm h)), (fun h => hL (e.symm h)), (fun h => hR (e.symm h))⟩

variable [Fintype G] [Fintype H]

theorem physical_D_group_reindex :
    physicalD (fun h => C (e.symm h)) (physicalMarkGroupReindex e P J ell L)
      (physicalAuxGroupReindex e P J C a) = physicalD C L a :=
  Equiv.prod_comp e.symm (physicalGroupD C L a)

theorem physical_aux_mass_group_reindex (V : G → ℝ) :
    physicalAuxMass (fun h => V (e.symm h)) (fun h => C (e.symm h))
      (physicalAuxGroupReindex e P J C a) = physicalAuxMass V C a :=
  Equiv.prod_comp e.symm (fun g => ∏ j : C g, physicalLabelLaw V g (a g j))

theorem physical_completion_mass_group_reindex (V : G → ℝ) :
    physicalCompletionMass (fun h => V (e.symm h)) (fun h => C (e.symm h)) ell =
      physicalCompletionMass V C ell :=
  Equiv.prod_comp e.symm (fun g => 1 / (V g) ^ (ell + (C g).card))

theorem physical_state_mass_group_reindex (V : G → ℝ) :
    physicalStateMass (fun h => V (e.symm h)) J ell = physicalStateMass V J ell :=
  Equiv.prod_comp e.symm (fun g => 1 / (V g) ^ (J + ell))

include e in
theorem physical_permutation_group_reindex_card :
    Fintype.card (PhysicalPermutations H J ell) = Fintype.card (PhysicalPermutations G J ell) :=
  Fintype.card_congr (physicalPermutationGroupReindex e J ell).symm

end Reindex
end Bounty
end

