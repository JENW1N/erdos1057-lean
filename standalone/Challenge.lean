variable
  {A X Y : Type*}
  [sharedInstance1 : Fintype X]
  [sharedInstance2 : Fintype Y]
  (s : Finset A)
  (w : X → ℝ)

include A X Y sharedInstance1 sharedInstance2 s w

theorem clean_kernel_pairing_sum_left  (K : X → Y → ℂ) (F : A → X → ℂ) (g : Y → ℂ) :
    cleanKernelPairing w K (∑ a ∈ s, F a) g = ∑ a ∈ s, cleanKernelPairing w K (F a) g := by
  simp only [cleanKernelPairing, Finset.sum_apply, map_sum, mul_sum, sum_mul]
  simp_rw [sum_comm (s := (univ : Finset Y))]
  rw [sum_comm]

theorem clean_kernel_pairing_sum_right  (K : X → Y → ℂ) (f : X → ℂ) (H : A → Y → ℂ) :
    cleanKernelPairing w K f (∑ a ∈ s, H a) = ∑ a ∈ s, cleanKernelPairing w K f (H a) := by
  simp only [cleanKernelPairing, Finset.sum_apply, mul_sum]
  simp_rw [sum_comm (s := (univ : Finset Y))]
  rw [sum_comm]

theorem clean_kernel_pairing_sum_kernel  (K : A → X → Y → ℂ) (f : X → ℂ) (g : Y → ℂ) :
    cleanKernelPairing w (∑ a ∈ s, K a) f g = ∑ a ∈ s, cleanKernelPairing w (K a) f g := by
  simp only [cleanKernelPairing, Finset.sum_apply, mul_sum, sum_mul]
  simp_rw [sum_comm (s := (univ : Finset Y))]
  rw [sum_comm]

end


theorem clean_kernel_pairing_smul_kernel {X Y : Type*} [Fintype X] [Fintype Y]
    (w : X → ℝ) (K : X → Y → ℂ) (f : X → ℂ) (g : Y → ℂ) (a : ℂ) :
    cleanKernelPairing w (a • K) f g = a * cleanKernelPairing w K f g := by
  simp only [cleanKernelPairing, Pi.smul_apply, smul_eq_mul, mul_sum]
  apply sum_congr rfl
  intro x _
  apply sum_congr rfl
  intro y _
  ring

section

variable
  {I : Type*}
  [sharedInstance1 : DecidableEq I]
  {X : I → Type*}
  [sharedInstance3 : ∀ i, Fintype (X i)]
  (μ : ∀ i, X i → ℝ)
  (U : Finset I)
  (f : (∀ i, X i) → ℂ)

include I sharedInstance1 X sharedInstance3 μ U f

theorem clean_component_sum  :
    (∑ S ∈ U.powerset, finiteCoordinateComponent μ S U.toList f) = f := by
  simpa using finite_coordinate_component_sum μ U.toList U.nodup_toList f

theorem clean_component_erase_sum  :
    (∑ S ∈ U.powerset.erase U, finiteCoordinateComponent μ S U.toList f) =
      f - finiteCoordinateComponent μ U U.toList f := by
  apply eq_sub_iff_add_eq.mpr
  rw [sum_erase_add _ _ (show U ∈ U.powerset by simp), clean_component_sum]

end


