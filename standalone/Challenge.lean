section
open scoped BigOperators Classical
def finiteCoordinatePatternMatches {I : Type*} [DecidableEq I]
    (A : Finset I) (js : List I) (S : Finset I) : Prop :=
  ∀ i ∈ js, (i ∈ A ↔ i ∈ S)

theorem finite_coordinate_choice_component {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hmass : ∀ i, ∑ y, μ i y = 1) (A S : Finset I) (is : List I) (i : I)
    (hi : i ∈ is) (f : (∀ j, X j) → ℂ) :
    finiteCoordinateChoice μ i A (finiteCoordinateComponent μ S is f) =
      if (i ∈ A ↔ i ∈ S) then finiteCoordinateComponent μ S is f else 0 := by
  unfold finiteCoordinateChoice
  rw [finite_coordinate_component_average μ hmass S is i hi]
  by_cases hA : i ∈ A <;> by_cases hS : i ∈ S <;> simp only [hA, hS, if_true,
    if_false, iff_self, true_iff, false_iff, not_true_eq_false, sub_zero, sub_self]

theorem finite_coordinate_component_retains {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hmass : ∀ i, ∑ y, μ i y = 1) (A S : Finset I) (is js : List I)
    (hsub : ∀ i ∈ js, i ∈ is) (f : (∀ j, X j) → ℂ) :
    finiteCoordinateComponent μ A js (finiteCoordinateComponent μ S is f) =
      if (∀ i ∈ js, (i ∈ A ↔ i ∈ S)) then finiteCoordinateComponent μ S is f else 0 := by
  induction js with
  | nil => simp only [finiteCoordinateComponent, List.not_mem_nil, false_implies, implies_true, if_true]
  | cons j js ih =>
    rw [finiteCoordinateComponent, ih (fun i hi => hsub i (List.mem_cons_of_mem _ hi))]
    simp only [List.forall_mem_cons]
    by_cases ht : ∀ i ∈ js, (i ∈ A ↔ i ∈ S)
    · rw [if_pos ht, finite_coordinate_choice_component μ hmass A S is j (hsub j (List.mem_cons_self))]
      by_cases hh : (j ∈ A ↔ j ∈ S)
      · rw [if_pos hh, if_pos ⟨hh, ht⟩]
      · rw [if_neg hh, if_neg (fun h => hh h.1)]
    · rw [if_neg ht, finite_coordinate_choice_zero]
      simp only [ht, and_false, if_false]

theorem finite_coordinate_retained_decomposition {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hmass : ∀ i, ∑ y, μ i y = 1) (A : Finset I) (is js : List I)
    (hnodup : is.Nodup) (hsub : ∀ i ∈ js, i ∈ is) (f : (∀ j, X j) → ℂ) :
    finiteCoordinateComponent μ A js f =
      ∑ S ∈ is.toFinset.powerset.filter (finiteCoordinatePatternMatches A js),
        finiteCoordinateComponent μ S is f := by
  calc
    _ = finiteCoordinateComponent μ A js
        (∑ S ∈ is.toFinset.powerset, finiteCoordinateComponent μ S is f) := by
      rw [finite_coordinate_component_sum μ is hnodup]
    _ = ∑ S ∈ is.toFinset.powerset,
        if (∀ i ∈ js, (i ∈ A ↔ i ∈ S)) then finiteCoordinateComponent μ S is f else 0 := by
      rw [finite_coordinate_component_finset_sum]
      apply Finset.sum_congr rfl
      intro S _
      exact finite_coordinate_component_retains μ hmass A S is js hsub f
    _ = _ := by
      rw [Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro S _
      by_cases h : finiteCoordinatePatternMatches A js S
      · rw [if_pos h, if_pos (show ∀ i ∈ js, (i ∈ A ↔ i ∈ S) from h)]
      · rw [if_neg h, if_neg (show ¬ (∀ i ∈ js, (i ∈ A ↔ i ∈ S)) from h)]

theorem finite_coordinate_retained_energy {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ y, μ i y = 1)
    (A : Finset I) (is js : List I) (hnodup : is.Nodup)
    (hsub : ∀ i ∈ js, i ∈ is) (f : (∀ j, X j) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ A js f) =
      ∑ S ∈ is.toFinset.powerset.filter (finiteCoordinatePatternMatches A js),
        finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ S is f) := by
  rw [finite_coordinate_retained_decomposition μ hmass A is js hnodup hsub]
  refine finite_weighted_orthogonal_energy _ (finiteProductWeight μ)
    (fun x => Finset.prod_nonneg (fun i _ => hμ i (x i))) _ ?_
  intro S hS T hT hST
  exact finite_coordinate_components_orthogonal μ hmass is S T
    (Finset.mem_powerset.mp (Finset.mem_filter.mp hS).1)
    (Finset.mem_powerset.mp (Finset.mem_filter.mp hT).1) hST f f
end

section
open scoped BigOperators Classical
def finiteSlotRelabel {I X : Type*} (σ : Equiv.Perm I) : (I → X) ≃ (I → X) where
  toFun x i := x (σ i)
  invFun x i := x (σ.symm i)
  left_inv x := by funext i; simp
  right_inv x := by funext i; simp

def finiteSlotPermute {I X : Type*} (σ : Equiv.Perm I) (f : (I → X) → ℂ) : (I → X) → ℂ :=
  fun x => f (finiteSlotRelabel σ x)

theorem finite_slot_relabel_update {I X : Type*} [DecidableEq I]
    (σ : Equiv.Perm I) (x : I → X) (i : I) (y : X) :
    finiteSlotRelabel σ (Function.update x i y) =
      Function.update (finiteSlotRelabel σ x) (σ.symm i) y :=
  Function.update_comp_equiv x σ i y

theorem finite_slot_weight_invariant {I X : Type*} [Fintype I]
    (μ : X → ℝ) (σ : Equiv.Perm I) (x : I → X) :
    finiteProductWeight (fun _ : I => μ) (finiteSlotRelabel σ x) =
      finiteProductWeight (fun _ : I => μ) x :=
  Equiv.prod_comp σ (fun i => μ (x i))

theorem finite_slot_energy_invariant {I X : Type*} [Fintype I] [DecidableEq I] [Fintype X]
    (μ : X → ℝ) (σ : Equiv.Perm I) (f : (I → X) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight (fun _ : I => μ)) (finiteSlotPermute σ f) =
      finiteWeightedEnergy (finiteProductWeight (fun _ : I => μ)) f := by
  unfold finiteWeightedEnergy finiteSlotPermute
  have h := (finiteSlotRelabel (X := X) σ).sum_comp
    (fun x => finiteProductWeight (fun _ : I => μ) x * ‖f x‖ ^ 2)
  simpa only [finite_slot_weight_invariant] using h

section

variable
  {I X : Type*}
  [sharedInstance1 : DecidableEq I]
  [sharedInstance2 : Fintype X]
  (μ : X → ℝ)
  (σ : Equiv.Perm I)

include I X sharedInstance1 sharedInstance2 μ σ

theorem finite_slot_average_covariant  (i : I) (f : (I → X) → ℂ) :
    finiteCoordinateAverage (fun _ : I => μ) (σ i) (finiteSlotPermute σ f) =
      finiteSlotPermute σ (finiteCoordinateAverage (fun _ : I => μ) i f) := by
  funext x
  simp only [finite_coordinate_average_update, finiteSlotPermute,
    finite_slot_relabel_update, Equiv.symm_apply_apply]

theorem finite_slot_choice_covariant  (i : I) (S : Finset I) (f : (I → X) → ℂ) :
    finiteCoordinateChoice (fun _ : I => μ) (σ i) (S.map σ.toEmbedding) (finiteSlotPermute σ f) =
      finiteSlotPermute σ (finiteCoordinateChoice (fun _ : I => μ) i S f) := by
  have hm : σ i ∈ S.map σ.toEmbedding ↔ i ∈ S := by simp
  by_cases hi : i ∈ S
  · simp only [finiteCoordinateChoice, hm, if_pos hi, finite_slot_average_covariant]
    rfl
  · simp only [finiteCoordinateChoice, hm, if_neg hi, finite_slot_average_covariant]

theorem finite_slot_component_covariant  (S : Finset I) (is : List I) (f : (I → X) → ℂ) :
    finiteCoordinateComponent (fun _ : I => μ) (S.map σ.toEmbedding) (is.map σ)
        (finiteSlotPermute σ f) =
      finiteSlotPermute σ (finiteCoordinateComponent (fun _ : I => μ) S is f) := by
  induction is with
  | nil => rfl
  | cons i is ih =>
    simp only [List.map_cons, finiteCoordinateComponent, ih]
    exact finite_slot_choice_covariant μ σ i S _

end

end

