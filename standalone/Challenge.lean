section
open Finset
open scoped Classical
noncomputable def cleanHybridStep {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ}
    (k : ℤ) (C : G → Finset (Fin J)) (source : RepeatedBigLists Pb J ell)
    (aux : PhysicalAuxLabels Pb C) (d : PhysicalSharedLists Ps J) : ℤ :=
  (k * (repeatedBigD C source aux : ℤ)) * (physicalSharedProduct d : ℤ)




/- Both endpoint rho weights and each actual output cutoff remain explicit.
A clean edge has the same length at input and output. -/
noncomputable def cleanHybridMemoryFactor {G : Type*} [Fintype G]
    {Pb : G → Finset ℕ} {N : G → ℕ} (ρ : ℝ) (B : G → ℕ)
    (p : FixedOrderedMemoryLabels Pb N) (r : FixedOrderedResidues p) (Δ : ℤ) : ℝ := by
  classical
  exact ∏ g, if N g ≤ B g then
    ρ ^ orderedPredicateCount (fixedOrderedResidueMemory p r g) unrestrictedResidueHit *
      ρ ^ orderedPredicateCount
        (fixedOrderedResidueMemory p (fixedOrderedResidueTranslate p r Δ) g) unrestrictedResidueHit
    else 0

/- K receives big list coordinates only. Small shared labels affect this
coefficient solely through the common physical displacement. -/
noncomputable def cleanHybridBetweenKernel {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ) (B : G → ℕ) (p : FixedOrderedMemoryLabels Pb N)
    (r : FixedOrderedResidues p)
    (K : RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb C → ℂ)
    (d : PhysicalSharedLists Ps J) (aux : PhysicalAuxLabels Pb C)
    (source target : RepeatedBigLists Pb J ell) : ℂ :=
  repeatedBigKernel Vb b C ζ K aux source target *
    physicalReturnPhase θ (cleanHybridStep k C source aux d) *
    (cleanHybridMemoryFactor ρ B p r (cleanHybridStep k C source aux d) : ℂ)



end

