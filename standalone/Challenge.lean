section

/- The original four-step schedule has one offset increment and two
permutation normalizers per edge. -/

open Finset
namespace Bounty

def fourStepVertex (n : ℕ) (i : Fin (4 * n + 2)) : Fin (n + 1) :=
  ⟨(i.val + 1) / 4, by have := i.isLt; omega⟩

theorem four_step_vertex_zero (n : ℕ) : fourStepVertex n 0 = 0 := by
  apply Fin.ext
  simp only [fourStepVertex, Fin.val_zero, zero_add, Nat.reduceDiv]

theorem four_step_vertex_nonedge (n : ℕ) (i : Fin (4 * n + 1)) (hi : i.val % 4 ≠ 2) :
    fourStepVertex n i.castSucc = fourStepVertex n i.succ := by
  apply Fin.ext
  dsimp only [fourStepVertex, Fin.val_castSucc, Fin.val_succ]
  omega

theorem four_step_vertex_edge_before {n : ℕ} (j : Fin n) :
    fourStepVertex n ⟨4 * j.val + 2, by have := j.isLt; omega⟩ = j.castSucc := by
  apply Fin.ext
  dsimp only [fourStepVertex, Fin.val_castSucc]
  omega

theorem four_step_vertex_edge_after {n : ℕ} (j : Fin n) :
    fourStepVertex n ⟨4 * j.val + 3, by have := j.isLt; omega⟩ = j.succ := by
  apply Fin.ext
  dsimp only [fourStepVertex, Fin.val_succ]
  omega

theorem four_step_block_product (n : ℕ) (f : Fin (4 * n + 1) → ℂ) :
    (∏ i, f i) =
      (∏ j : Fin n, ∏ t : Fin 4, f ⟨4 * j.val + t.val, by have := j.isLt; have := t.isLt; omega⟩) *
        f (Fin.last (4 * n)) := by
  rw [Fin.prod_univ_castSucc]
  congr 1
  rw [← Fintype.prod_prod_type (fun jt : Fin n × Fin 4 =>
    f ⟨4 * jt.1.val + jt.2.val, by have := jt.1.isLt; have := jt.2.isLt; omega⟩)]
  symm
  apply prod_bij (fun (jt : Fin n × Fin 4) _ =>
    (⟨4 * jt.1.val + jt.2.val, by have := jt.1.isLt; have := jt.2.isLt; omega⟩ : Fin (4 * n)))
  · intros; exact mem_univ _
  · intro a _ b _ hab
    have hv := congrArg Fin.val hab
    have ha := a.2.isLt
    have hb := b.2.isLt
    apply Prod.ext <;> apply Fin.ext <;> dsimp only at hv ⊢ <;> omega
  · intro i _
    refine ⟨(⟨i.val / 4, by have := i.isLt; omega⟩, ⟨i.val % 4, by omega⟩), mem_univ _, ?_⟩
    apply Fin.ext
    dsimp only
    omega
  · intros; rfl

theorem four_step_normalized_product (n : ℕ) (c : ℂ) (f : Fin (4 * n + 1) → ℂ)
    (hvisit : ∀ j : Fin (n + 1), f ⟨4 * j.val, by have := j.isLt; omega⟩ = 1)
    (hleft : ∀ j : Fin n, f ⟨4 * j.val + 1, by have := j.isLt; omega⟩ = c)
    (hright : ∀ j : Fin n, f ⟨4 * j.val + 3, by have := j.isLt; omega⟩ = c) :
    (∏ i, f i) = ∏ j : Fin n, c * c * f ⟨4 * j.val + 2, by have := j.isLt; omega⟩ := by
  rw [four_step_block_product]
  have hlast : f (Fin.last (4 * n)) = 1 := hvisit (Fin.last n)
  rw [hlast, mul_one]
  apply prod_congr rfl
  intro j _
  rw [Fin.prod_univ_four]
  change f ⟨4 * j.val + 0, _⟩ * f ⟨4 * j.val + 1, _⟩ *
    f ⟨4 * j.val + 2, _⟩ * f ⟨4 * j.val + 3, _⟩ = _
  have hzero : f ⟨4 * j.val + 0, by have := j.isLt; omega⟩ = 1 := hvisit j.castSucc
  rw [hzero, hleft, hright]
  ring

end Bounty
end

section

/- Exact auxiliary shift averages reduce to the first endpoint's major
energy once the actual multiplier has been bounded on minor arcs. -/

open Finset MeasureTheory
open scoped Classical ComplexConjugate
namespace Bounty

theorem physical_aux_fourier_continuous
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ) :
    Continuous (physicalAuxFourierMultiplier P V A B hU hAB k bA bB) := by
  unfold physicalAuxFourierMultiplier
  apply continuous_finsetSum
  intro aux _
  exact continuous_const.mul (continuous_fourier_real _)

theorem physical_aux_shift_major_energy
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hA : ∀ a, ‖bA a‖ ≤ 1) (hB : ∀ b, ‖bB b‖ ≤ 1)
    (S T : Finset ℤ) (f g : ℤ → ℂ)
    (M : Set ℝ) (hM : MeasurableSet M) {ε : ℝ} (hε : 0 ≤ ε)
    (hminor : ∀ θ, θ ∉ M →
      ‖physicalAuxFourierMultiplier P V A B hU hAB k bA bB θ‖ ≤ ε) :
    ‖∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
      (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ) *
        bA (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
        bB (repeatedBigAuxSplitEquiv P A B hU hAB aux).2 *
        ∑ n ∈ S, let δ : ℤ := k * (∏ g, ∏ j : repeatedBigAuxCut A B g, (aux g j).val : ℕ)
          if n+δ ∈ T then conj (f n)*g (n+δ) else 0‖ ≤
      Real.sqrt (ε^2*(∑ n ∈ S, ‖f n‖^2) +
        ∫ x in M ∩ Set.Ioc 0 1, ‖finiteFourierSum S f x‖^2) *
      Real.sqrt (∑ n ∈ T, ‖g n‖^2) := by
  rw [physical_aux_averaged_shift_fourier]
  exact finite_fourier_major_energy S T f g _
    (physical_aux_fourier_continuous P V A B hU hAB k bA bB) M hM hε
    (physical_aux_fourier_norm P V A B hU hAB k bA bB hV hMass hA hB) hminor

end Bounty
end

section

/- Relabeling full-event edge keys preserves the actual dependent path and
every pulled-back deterministic phase. -/

namespace Bounty
section Keys
variable {I K J G : Type*} {P : G → Type*}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → G → ℤ) (f : I → K)

def fullPermutationKeyEventEquiv
    (tag : Option (J ⊕ I))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullPermutationMixedEvent n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) tag x ≃
    FullPermutationMixedEvent n S B A Δ D (tag.map (Sum.map id f)) x :=
  match tag with
  | none => Equiv.refl _
  | some (.inl _) => Equiv.refl _
  | some (.inr _) => Equiv.refl _

theorem full_permutation_key_target
    (tag : Option (J ⊕ I))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) tag x) :
    fullPermutationMixedEventTarget n S B A Δ D (tag.map (Sum.map id f)) x
        (fullPermutationKeyEventEquiv n S B A Δ D f tag x e) =
      fullPermutationMixedEventTarget n (fun i => S (f i)) B (fun i => A (f i))
        (fun i => Δ (f i)) (fun i => D (f i)) tag x e := by
  cases tag with
  | none => rfl
  | some tag => cases tag <;> rfl

noncomputable def fullPermutationKeyPathEquiv (steps : List (Option (J ⊕ I)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullPermutationMixedPath n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) steps x ≃
    FullPermutationMixedPath n S B A Δ D (steps.map (Option.map (Sum.map id f))) x :=
  (finiteEventPathEquiv _ _ _ _ id
    (fullPermutationKeyEventEquiv n S B A Δ D f)
    (fun tag x e => (full_permutation_key_target n S B A Δ D f tag x e).symm) steps x).trans
      (finiteEventPathMapEquiv (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D) (Option.map (Sum.map id f)) steps x)

theorem full_permutation_key_ledger_phase
    {L : Type*}
    (update : ∀ tag, L → (x : ProductBoundedOrderedState P
      (fun g => UnrestrictedResidueParticle (n g)) M B) → FullPermutationMixedEvent n S B A Δ D tag x → L)
    (phase : ∀ tag, L → (x : ProductBoundedOrderedState P
      (fun g => UnrestrictedResidueParticle (n g)) M B) → FullPermutationMixedEvent n S B A Δ D tag x → ℂ)
    (steps : List (Option (J ⊕ I))) (l : L)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) steps x) :
    deterministicLedgerPhase (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D) update phase
        (steps.map (Option.map (Sum.map id f))) l x
        (fullPermutationKeyPathEquiv n S B A Δ D f steps x p) =
      deterministicLedgerPhase
        (FullPermutationMixedEvent n (fun i => S (f i)) B (fun i => A (f i))
          (fun i => Δ (f i)) (fun i => D (f i)))
        (fullPermutationMixedEventTarget n (fun i => S (f i)) B (fun i => A (f i))
          (fun i => Δ (f i)) (fun i => D (f i)))
        (fun tag l x e => update (tag.map (Sum.map id f)) l x
          (fullPermutationKeyEventEquiv n S B A Δ D f tag x e))
        (fun tag l x e => phase (tag.map (Sum.map id f)) l x
          (fullPermutationKeyEventEquiv n S B A Δ D f tag x e)) steps l x p := by
  unfold fullPermutationKeyPathEquiv
  erw [Equiv.trans_apply]
  rw [← deterministic_ledger_phase_map]
  exact deterministic_ledger_phase_equiv _ _ _ _ id _ _ _ _ (by intros; rfl)
    _ _ (by intros; rfl) steps l x p

end Keys
end Bounty
end

