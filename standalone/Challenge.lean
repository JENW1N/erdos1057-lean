open Complex Filter Metric Set
open scoped Topology

theorem exists_normalized_log_on_ball (g : ℂ → ℂ) (R : ℝ) (hR : 0 < R)
    (hg : AnalyticOnNhd ℂ g (ball 0 R)) (hne : ∀ z ∈ ball 0 R, g z ≠ 0) :
    ∃ F : ℂ → ℂ, F 0 = 0 ∧ (∀ z ∈ ball 0 R, HasDerivAt F (logDeriv g z) z) ∧
      ∀ z ∈ ball 0 R, g z = g 0 * exp (F z) := by
  have hd : DifferentiableOn ℂ (logDeriv g) (ball 0 R) := by
    intro z hz
    exact ((hg z hz).deriv.div (hg z hz) (hne z hz)).differentiableWithinAt
  obtain ⟨F, hF0, hF⟩ := hd.isExactOn_ball.with_val_at 0 0
  refine ⟨F, hF0, hF, ?_⟩
  let H : ℂ → ℂ := fun z => g z * exp (-F z)
  have hH (z : ℂ) (hz : z ∈ ball 0 R) : HasDerivAt H 0 z := by
    have h := (hg z hz).differentiableAt.hasDerivAt.mul ((hF z hz).neg.cexp)
    have he : deriv g z * exp (-F z) + g z * (exp (-F z) * -logDeriv g z) = 0 := by
      rw [logDeriv_apply]
      field_simp [hne z hz]
      ring
    change HasDerivAt H (deriv g z * exp (-F z) + g z * (exp (-F z) * -logDeriv g z)) z at h
    rw [he] at h
    exact h
  have hHD : DifferentiableOn ℂ H (ball 0 R) := fun z hz => (hH z hz).differentiableAt.differentiableWithinAt
  intro z hz
  have hc := isOpen_ball.is_const_of_deriv_eq_zero (convex_ball (0 : ℂ) R).isPreconnected
    hHD (fun w hw => (hH w hw).deriv) hz (mem_ball_self hR)
  change g z * exp (-F z) = g 0 * exp (-F 0) at hc
  rw [hF0, neg_zero, exp_zero, mul_one, exp_neg] at hc
  have hmul := congrArg (fun w : ℂ => w * exp (F z)) hc
  simpa [mul_assoc, exp_ne_zero] using hmul

theorem normalized_log_re (g F : ℂ → ℂ) (z : ℂ) (hg0 : g 0 ≠ 0)
    (he : g z = g 0 * exp (F z)) :
    (F z).re = Real.log ‖g z‖ - Real.log ‖g 0‖ := by
  have hnorm := congrArg norm he
  rw [norm_mul, norm_exp] at hnorm
  have hh := congrArg Real.log hnorm
  rw [Real.log_mul (norm_ne_zero_iff.mpr hg0) (Real.exp_ne_zero _), Real.log_exp] at hh
  linarith


/- A zero-free analytic function has logarithmic derivative controlled by its
logarithmic modulus oscillation and the distance to the boundary of the disk. -/
theorem logDeriv_norm_le_margin_disk (g : ℂ → ℂ) (R A δ : ℝ)
    (hR : 0 < R) (hA : 0 < A) (hδ : 0 < δ)
    (hg : AnalyticOnNhd ℂ g (ball 0 R)) (hne : ∀ z ∈ ball 0 R, g z ≠ 0)
    (hlog : ∀ z ∈ ball 0 R, Real.log ‖g z‖ - Real.log ‖g 0‖ ≤ A)
    (w : ℂ) (hw : ‖w‖ ≤ R - δ) : ‖logDeriv g w‖ ≤ 8 * A * R / δ ^ 2 := by
  obtain ⟨F, hF0, hF, heF⟩ := exists_normalized_log_on_ball g R hR hg hne
  have hd : DifferentiableOn ℂ F (ball 0 R) := fun z hz =>
    (hF z hz).differentiableAt.differentiableWithinAt
  have hreal : MapsTo F (ball 0 R) {z : ℂ | z.re ≤ A} := by
    intro z hz
    change (F z).re ≤ A
    rw [normalized_log_re g F z (hne 0 (mem_ball_self hR)) (heF z hz)]
    exact hlog z hz
  have hv (v : ℂ) (hv : v ∈ closedBall w (δ / 2)) : ‖v‖ ≤ R - δ / 2 := by
    have hh := norm_le_norm_sub_add v w
    have hdist : ‖v - w‖ ≤ δ / 2 := by simpa only [mem_closedBall, dist_eq_norm] using hv
    linarith
  have hvball (v : ℂ) (h : v ∈ closedBall w (δ / 2)) : v ∈ ball 0 R := by
    rw [mem_ball, dist_zero_right]
    linarith [hv v h]
  have hdc : DiffContOnCl ℂ F (ball w (δ / 2)) := by
    apply DiffContOnCl.mk_ball
    · intro v hv'
      exact (hF v (hvball v (ball_subset_closedBall hv'))).differentiableAt.differentiableWithinAt
    · exact fun v hv' => (hF v (hvball v hv')).continuousAt.continuousWithinAt
  have hbound : ∀ v ∈ sphere w (δ / 2), ‖F v‖ ≤ 4 * A * R / δ := by
    intro v hv'
    have hvC := sphere_subset_closedBall hv'
    have hnv := hv v hvC
    have hden : 0 < R - ‖v‖ := by linarith
    have hh := Complex.borelCaratheodory_zero hA hd hreal hR (hvball v hvC) hF0
    apply hh.trans
    calc
      2 * A * ‖v‖ / (R - ‖v‖) ≤ 2 * A * R / (R - ‖v‖) := by
        apply div_le_div_of_nonneg_right _ hden.le
        gcongr
        linarith
      _ ≤ 2 * A * R / (δ / 2) :=
        div_le_div_of_nonneg_left (by positivity) (by positivity) (by linarith)
      _ = _ := by field_simp; ring
  have hh := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le
    (by positivity : 0 < δ / 2) hdc hbound
  have hwball : w ∈ ball 0 R := by rw [mem_ball, dist_zero_right]; linarith
  rw [(hF w hwball).deriv] at hh
  convert hh using 1
  field_simp
  ring
end

