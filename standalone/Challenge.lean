    ‖R‖ = ‖I * R‖ := by rw [norm_mul, Complex.norm_I, one_mul]
    _ = ‖I * L + U - D‖ := by rw [he]
    _ ≤ ‖I * L + U‖ + ‖D‖ := norm_sub_le _ _
    _ ≤ (‖I * L‖ + ‖U‖) + ‖D‖ := add_le_add (norm_add_le _ _) le_rfl
