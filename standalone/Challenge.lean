  let : MeasurableSpace E := instMeasurableSpaceSmoothing1 (E := E)
  let : BorelSpace E := instBorelSpaceSmoothing1 (E := E)
  let : OpensMeasurableSpace E := instOpensMeasurableSpaceSmoothing1 (E := E)
  let : MeasurableAdd E := instMeasurableAddSmoothing1 (E := E)
