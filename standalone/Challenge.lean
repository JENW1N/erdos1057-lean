section

/- Nonempty original probe subsets have products between superpolynomial and
subexponential scales, uniformly in their actual prime labels. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem eventually_candidate_subset_product_range {c ε : ℝ}
    (hc : 0 < c) (hε : 0 < ε) (J : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
      ∀ (ell : ℕ) (probes : S → Finset (Fin J)) (r : Finset S)
        (A : Finset (RepeatedBigFlatIndex S J ell)),
        A ⊆ r.sigma (repeatedBigPrimeProbeSlots probes) → A.Nonempty →
        ∀ a : (∀ i : A, candidatePBand (c*L) i.val.1.val),
          Real.exp (L^(1/10 : ℝ)) ≤ (∏ i, (a i).val : ℕ) ∧
          (∏ i, (a i).val : ℕ) ≤ Real.exp (ε*L) := by
  obtain ⟨v, W, _, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  let D : ℝ := (J : ℝ)*(2/(5*Real.log 2))
  filter_upwards [hpool, eventually_scaled_log_sublinear
    (A := D) (by dsimp [D]; positivity) (s := (2/5 : ℝ)) (by norm_num) hε]
    with L hp hscaled
  intro S hS ell probes r A hA hne a
  have hdata (i : A) := (hp.2.2.2.2.2 i.val.1.val (hS i.val.1.property)).2.2
    (a i).val (a i).property
  have hcard : (A.card : ℝ) ≤ D*Real.log L := by
    have hAcard : A.card ≤ J*S.card :=
      (card_le_card hA).trans ((repeated_big_prime_probe_sigma_card_le
        probes r (fun g => by simpa using card_le_univ (probes g))).trans
        (Nat.mul_le_mul_left J (by simpa only [Fintype.card_coe] using card_le_univ r)))
    have hScard : (S.card : ℝ) ≤ (2/(5*Real.log 2))*Real.log L :=
      (Nat.cast_le.mpr (card_le_card hS)).trans hp.2.2.2.1
    calc
      _ ≤ (J : ℝ)*S.card := by exact_mod_cast hAcard
      _ ≤ (J : ℝ)*((2/(5*Real.log 2))*Real.log L) :=
        mul_le_mul_of_nonneg_left hScard (Nat.cast_nonneg J)
      _ = _ := by dsimp [D]; ring
  constructor
  · obtain ⟨i, hi⟩ := hne
    have hsingle : (a ⟨i, hi⟩).val ≤ ∏ j : A, (a j).val :=
      single_le_prod' (fun j _ => (hdata j).1.one_le) (mem_univ (⟨i, hi⟩ : A))
    exact (hdata ⟨i, hi⟩).2.1.le.trans (by exact_mod_cast hsingle)
  · calc
      ((∏ i, (a i).val : ℕ) : ℝ) = ∏ i : A, ((a i).val : ℝ) := by simp only [Nat.cast_prod]
      _ ≤ ∏ _i : A, Real.exp (L^(2/5 : ℝ)) :=
        prod_le_prod₀ (fun _ _ => Nat.cast_nonneg _) (fun i _ => (hdata i).2.2)
      _ = Real.exp ((A.card : ℝ)*L^(2/5 : ℝ)) := by
        rw [← Real.exp_sum]
        simp only [sum_const, card_univ, Fintype.card_coe, nsmul_eq_mul]
      _ ≤ Real.exp (D*L^(2/5 : ℝ)*Real.log L) := Real.exp_le_exp.mpr (by
        have hh := mul_le_mul_of_nonneg_right hcard (Real.rpow_nonneg (zero_le_one.trans hp.1) (2/5))
        nlinarith)
      _ ≤ Real.exp (ε*L) := Real.exp_le_exp.mpr hscaled

end Bounty
