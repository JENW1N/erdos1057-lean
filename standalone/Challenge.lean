    (i : RepeatedBigPrimePatternIndex (ell := ell) probes (r.map f) (t.map f))
    (L R : PhysicalMarkLists P J ell)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes (r.map f) (t.map f) i)) :
