/- Exact original full-vertex pair sum on the shared good event. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_good_original_pair_sum_eq_marked_averages
    {G : Type*} [Fintype G] [dG : DecidableEq G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (V : G → ℝ) (q : ℝ) (aux : PhysicalAuxLabels P C)
    {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    (b : GroupMarkedLists P (fun g => ell + (C g).card) →
      GroupMarkedLists P (fun g => ell + (C g).card) → ℂ) :
    (∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
      if physicalSharedCompatible C L R then
        ((physicalStateMass V J ell * physicalCompletionMass V C ell /
          (physicalSharedFactor C L : ℝ) : ℝ) : ℂ) *
        (if ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z then
          ((physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * (w : ℤ)) *
            physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) * (z : ℤ)) : ℝ) : ℂ) *
          b (physicalGroupUnsharedEmbedding C L) (physicalGroupUnsharedEmbedding C R)
        else 0)
      else 0) =
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (w : ℤ) : ℂ) *
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (z : ℤ) : ℂ) *
      groupMarkedAverage P (fun g => ell + (C g).card) (w : ℤ) (fun u =>
        groupMarkedAverage P (fun g => ell + (C g).card) (z : ℤ) (fun v =>
          ∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
            if physicalRawCutGood C u v s then
              if ∀ g j, s g j ∉ physicalSharedForbidden C aux g w z
                then (physicalAuxMass V (fun g => univ \ C g) s : ℂ) * b u v else 0
            else 0)) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  calc
    _ = ∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
        if physicalSharedCompatible C L R then
          ((physicalStateMass V J ell * physicalCompletionMass V C ell /
            (physicalSharedFactor C L : ℝ) : ℝ) : ℂ) *
          ((physicalUnsharedVertex C L q (w : ℤ) : ℂ) *
            (physicalUnsharedVertex C R q (z : ℤ) : ℂ) *
            (if ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z then
              b (physicalGroupUnsharedEmbedding C L) (physicalGroupUnsharedEmbedding C R) else 0))
        else 0 := by
      apply sum_congr rfl
      intro L _
      apply sum_congr rfl
      intro R _
      by_cases hLR : physicalSharedCompatible C L R
      · simp only [if_pos hLR]
        by_cases ha : ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z
        · simp only [if_pos ha]
          rw [physical_shared_vertex_pair_of_draw_avoids C L R aux hLR hprime hdis q hw hz ha,
            Complex.ofReal_mul]
        · simp only [if_neg ha, mul_zero]
      · simp only [if_neg hLR]
    _ = _ := by
      have he := physical_stripped_pair_sum_eq_marked_averages P C V q (w : ℤ) (z : ℤ)
        (fun u v s => if ∀ g j, s g j ∉ physicalSharedForbidden C aux g w z then b u v else 0)
      refine he.trans ?_
      apply congrArg (fun x : ℂ =>
        (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (w : ℤ) : ℂ) *
        (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (z : ℤ) : ℂ) * x)
      apply congrArg (groupMarkedAverage P (fun g => ell + (C g).card) (w : ℤ))
      funext u
      apply congrArg (groupMarkedAverage P (fun g => ell + (C g).card) (z : ℤ))
      funext v
      apply sum_congr rfl
      intro s _
      by_cases hc : physicalRawCutGood C u v s
      · simp only [if_pos hc, mul_ite, mul_zero]
      · simp only [if_neg hc]

end Bounty
end

