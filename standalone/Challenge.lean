section

/- The shared-draw error decays uniformly for polynomial endpoint logarithms
on arbitrary subfamilies of the actual candidate pools. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem eventually_candidate_shared_polynomial_error {c F : ℝ} (hc : 0 < c)
    (hF : 0 ≤ F) (J : ℕ) (E D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
      ∀ (C : S → Finset (Fin J)) (w z : ℕ) (H : ℝ),
      0 < w → 0 < z → Real.log w ≤ L^F → Real.log z ≤ L^F →
      0 ≤ H → H ≤ L^E →
      (∑ g : S, (J - (C g).card : ℕ) *
          (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) /
          ((∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ)) * Real.exp (L^(1/10 : ℝ)))) *
        (H + H / (1/2 : ℝ) ^ (2 * ∑ g : S, (J - (C g).card))) ≤ L^(-D) := by
  obtain ⟨v, A, hv, hA, hinputs⟩ := exists_candidate_shared_error_inputs hc J
  have hB : 0 ≤ 2 / Real.log 2 + (J : ℝ) := by positivity
  filter_upwards [hinputs, eventually_physical_shared_error_polynomial_decay (c := (1/10 : ℝ))
    (by norm_num) hv hA hB E F D, eventually_ge_atTop (1 : ℝ)] with L hinputs hdec hL
  intro S hS C w z H hw hz hwlog hzlog hH hHL
  obtain ⟨hcount, hdata⟩ := hinputs S hS
  have h2 : 0 ≤ Real.log (2 : ℝ) := Real.log_nonneg (by norm_num)
  have hT : 0 ≤ Real.log w / Real.log 2 + Real.log z / Real.log 2 + J := by
    have hw1 : (1 : ℝ) ≤ w := by exact_mod_cast hw
    have hz1 : (1 : ℝ) ≤ z := by exact_mod_cast hz
    exact add_nonneg (add_nonneg (div_nonneg (Real.log_nonneg hw1) h2)
      (div_nonneg (Real.log_nonneg hz1) h2)) (Nat.cast_nonneg J)
  have hTL : Real.log w / Real.log 2 + Real.log z / Real.log 2 + J ≤
      (2 / Real.log 2 + (J : ℝ)) * L^F := by
    have hw' := div_le_div_of_nonneg_right hwlog h2
    have hz' := div_le_div_of_nonneg_right hzlog h2
    have hJ := mul_le_mul_of_nonneg_left (Real.one_le_rpow hL hF) (Nat.cast_nonneg J : (0 : ℝ) ≤ J)
    calc
      _ ≤ L^F / Real.log 2 + L^F / Real.log 2 + (J : ℝ)*L^F := by linarith
      _ = _ := by ring
  exact hdec S J C (fun g => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ))
    (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) H (Real.exp (L^(1/10 : ℝ)))
    (fun g => (hdata g).1) (by simpa only [Fintype.card_coe] using hcount)
    hT hTL hH hHL le_rfl

end Bounty
end

section

/- Bounded output values of the four-factor divisor convolution only see bounded positive inputs. -/

open Finset

namespace Bounty

theorem endpoint_four_convolution_truncate (δ α β γ : ℕ → ℂ) {N n : ℕ}
    (hn : n ≤ N) :
    endpointFourConvolution (fun d => if d ∈ Icc 1 N then δ d else 0)
      (fun a => if a ∈ Icc 1 N then α a else 0)
      (fun b => if b ∈ Icc 1 N then β b else 0)
      (fun c => if c ∈ Icc 1 N then γ c else 0) n =
      endpointFourConvolution δ α β γ n := by
  classical
  unfold endpointFourConvolution
  apply sum_congr rfl
  intro d hd
  have hdN : d ∈ Icc 1 N := mem_Icc.mpr
    ⟨Nat.pos_of_mem_divisors hd, (Nat.le_of_dvd (Nat.pos_of_ne_zero (Nat.ne_zero_of_mem_divisors hd)) (Nat.dvd_of_mem_divisors hd)).trans hn⟩
  simp only [if_pos hdN]
  congr 1
  unfold endpointTripleConvolution
  apply sum_congr rfl
  intro a ha
  have hnd : n / d ≤ N := (Nat.div_le_self n d).trans hn
  have haN : a ∈ Icc 1 N := mem_Icc.mpr
    ⟨Nat.pos_of_mem_divisors ha, (Nat.le_of_dvd (Nat.pos_of_ne_zero (Nat.ne_zero_of_mem_divisors ha)) (Nat.dvd_of_mem_divisors ha)).trans hnd⟩
  apply sum_congr rfl
  intro b hb
  have hna : n / d / a ≤ N := (Nat.div_le_self (n / d) a).trans hnd
  have hbN : b ∈ Icc 1 N := mem_Icc.mpr
    ⟨Nat.pos_of_mem_divisors hb, (Nat.le_of_dvd (Nat.pos_of_ne_zero (Nat.ne_zero_of_mem_divisors hb)) (Nat.dvd_of_mem_divisors hb)).trans hna⟩
  have hcpos : 0 < n / d / a / b := Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero (Nat.ne_zero_of_mem_divisors hb)) (Nat.dvd_of_mem_divisors hb))
    (Nat.pos_of_mem_divisors hb)
  have hcN : n / d / a / b ∈ Icc 1 N := mem_Icc.mpr
    ⟨hcpos, (Nat.div_le_self (n / d / a) b).trans hna⟩
  simp only [if_pos haN, if_pos hbN, if_pos hcN]

end Bounty
end

section

open MeasureTheory

namespace Bounty

theorem local_mellin_tail_power_saving (A B D : ℝ) :
    ∃ j : ℕ, 2 ≤ j ∧ ∀ (L Y h : ℝ) (S : Finset ℕ) (a : ℕ → ℂ) (N : ℕ),
      16 ≤ L → 0 < Y → 0 < h → h⁻¹ ≤ Y →
      (∀ n ∈ S, 1 ≤ n ∧ n ≤ N) →
      (N:ℝ)*(1+Real.log N) ≤ Y*L^A →
      (∑ n ∈ S, ‖a n‖^2) ≤ Y*L^B →
      (∫ t in {t : ℝ | L/h < |t|},
        (1+|h*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) ≤
          Y^2*L^(-D) := by
  obtain ⟨M, hM⟩ := exists_nat_ge (max 1 A+B+D+1)
  refine ⟨M+2, by omega, ?_⟩
  intro L Y h S a N hL hY hh hhi hS hN hE
  have hL1 : 1 ≤ L := by linarith
  have hLp : 0 < L := by linarith
  have hR : L/h ≤ Y*L^(max 1 A) := by
    calc
      L/h = L*h⁻¹ := div_eq_mul_inv _ _
      _ ≤ L*Y := mul_le_mul_of_nonneg_left hhi hLp.le
      _ = Y*L^(1:ℝ) := by rw [Real.rpow_one]; ring
      _ ≤ _ := mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hL1 (le_max_left _ _)) hY.le
  have hN' : (N:ℝ)*(1+Real.log N) ≤ Y*L^(max 1 A) :=
    hN.trans (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_le hL1 (le_max_right _ _)) hY.le)
  have hconst : 8*(L/h)+8*(N:ℝ)*(1+Real.log N) ≤ 16*Y*L^(max 1 A) := by nlinarith
  have hprod : (8*(L/h)+8*(N:ℝ)*(1+Real.log N))*(∑ n ∈ S, ‖a n‖^2) ≤
      (16*Y*L^(max 1 A))*(Y*L^B) := by
    exact mul_le_mul hconst hE (Finset.sum_nonneg (fun _ _ => sq_nonneg _)) (by positivity)
  calc
    _ ≤ (8*(L/h)+8*(N:ℝ)*(1+Real.log N))*(∑ n ∈ S, ‖a n‖^2)*L^(-(M:ℝ)) :=
      local_mellin_rapid_tail S a N hS hL1 hh M
    _ ≤ (16*Y*L^(max 1 A))*(Y*L^B)*L^(-(M:ℝ)) :=
      mul_le_mul_of_nonneg_right hprod (Real.rpow_nonneg hLp.le _)
    _ = 16*Y^2*L^(max 1 A+B-(M:ℝ)) := by
      rw [sub_eq_add_neg, Real.rpow_add hLp, Real.rpow_add hLp]
      ring
    _ ≤ L*Y^2*L^(max 1 A+B-(M:ℝ)) := by gcongr
    _ = Y^2*L^(max 1 A+B-(M:ℝ)+1) := by
      rw [Real.rpow_add hLp, Real.rpow_one]
      ring
    _ ≤ Y^2*L^(-D) := by
      apply mul_le_mul_of_nonneg_left _ (sq_nonneg Y)
      exact Real.rpow_le_rpow_of_exponent_le hL1 (by linarith)

end Bounty
end

section

/- Positive integer Fourier sums agree with the local additive polynomial,
including a fixed rational-center modulation of their coefficients. -/

open Finset
namespace Bounty

theorem fourier_real_add (n : ℤ) (c β : ℝ) :
    fourier n ((c+β : ℝ) : AddCircle (1 : ℝ)) =
      fourier n (c : AddCircle (1 : ℝ))*fourier n (β : AddCircle (1 : ℝ)) := by
  simp only [fourier_coe_apply, ← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem finite_fourier_eq_local_additive (S : Finset ℤ) (f : ℤ → ℂ)
    (hS : ∀ n ∈ S, 0 ≤ n) (c β : ℝ) :
    finiteFourierSum S f (c+β) =
      localAdditivePolynomial (S.image Int.natAbs)
        (fun n => f n * fourier (n : ℤ) (c : AddCircle (1 : ℝ))) β := by
  unfold finiteFourierSum localAdditivePolynomial
  rw [sum_image]
  · apply sum_congr rfl
    intro n hn
    dsimp only
    rw [Int.natAbs_of_nonneg (hS n hn), fourier_real_add]
    have he : fourier n (β : AddCircle (1 : ℝ)) =
        Complex.exp (((2*Real.pi*β*n.natAbs : ℝ) : ℂ)*Complex.I) := by
      rw [fourier_coe_apply]
      congr 1
      have hnR : (n.natAbs : ℝ) = (n : ℝ) := by
        simpa only [Int.cast_natCast] using
          congrArg (fun z : ℤ => (z : ℝ)) (Int.natAbs_of_nonneg (hS n hn))
      rw [hnR]
      push_cast
      ring
    rw [he]
    ring
  · intro a ha b hb hab
    have he := congrArg (fun m : ℕ => (m : ℤ)) hab
    simpa only [Int.natAbs_of_nonneg (hS a ha), Int.natAbs_of_nonneg (hS b hb)] using he

end Bounty
end

section

/- Relabeling full-event keys preserves terminal states and the original signed real weights. -/

open scoped Classical
namespace Bounty
section Keys
variable {I K J G : Type*} {P : G → Type*}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → G → ℤ) (f : I → K)

theorem full_permutation_key_path_terminal (steps : List (Option (J ⊕ I)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) steps x) :
    finiteEventPathTerminal _ (fullPermutationMixedEventTarget n S B A Δ D)
      (steps.map (Option.map (Sum.map id f))) x
      (fullPermutationKeyPathEquiv n S B A Δ D f steps x p) =
    finiteEventPathTerminal _ (fullPermutationMixedEventTarget n (fun i => S (f i)) B
      (fun i => A (f i)) (fun i => Δ (f i)) (fun i => D (f i))) steps x p := by
  let e := finiteEventPathEquiv _ _ _ _ id
    (fullPermutationKeyEventEquiv n S B A Δ D f)
    (fun tag x e => (full_permutation_key_target n S B A Δ D f tag x e).symm) steps x p
  exact (finite_event_path_map_terminal (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) (Option.map (Sum.map id f)) steps x e).symm.trans
    (finite_event_path_equiv_terminal _ _ _ _ id _ _ steps x p)

variable [Fintype G] [DecidableEq G]
  (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)

theorem full_permutation_key_weight
    (tag : Option (J ⊕ I))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) tag x) :
    fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V
      (tag.map (Sum.map id f)) x (fullPermutationKeyEventEquiv n S B A Δ D f tag x e) =
    fullPermutationMixedEventWeight n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) (fun i => ω (f i)) μ q ρ V tag x e := by
  cases tag with
  | none => rfl
  | some tag => cases tag <;> rfl

theorem full_permutation_key_path_weight (steps : List (Option (J ⊕ I)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) steps x) :
    finiteEventPathWeight _ (fullPermutationMixedEventTarget n S B A Δ D)
      (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V)
      (steps.map (Option.map (Sum.map id f))) x
      (fullPermutationKeyPathEquiv n S B A Δ D f steps x p) =
    finiteEventPathWeight _ (fullPermutationMixedEventTarget n (fun i => S (f i)) B
      (fun i => A (f i)) (fun i => Δ (f i)) (fun i => D (f i)))
      (fullPermutationMixedEventWeight n (fun i => S (f i)) B (fun i => A (f i))
        (fun i => Δ (f i)) (fun i => D (f i)) (fun i => ω (f i)) μ q ρ V) steps x p := by
  let e := finiteEventPathEquiv _ _ _ _ id
    (fullPermutationKeyEventEquiv n S B A Δ D f)
    (fun tag x e => (full_permutation_key_target n S B A Δ D f tag x e).symm) steps x p
  exact (finite_event_path_map_weight (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D) (Option.map (Sum.map id f))
    (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps x e).symm.trans
    (finite_event_path_equiv_weight _ _ _ _ id _ _ _ _
      (full_permutation_key_weight n S B A Δ D f ω μ q ρ V) steps x p)

end Keys
end Bounty
end

section

/- The original local coefficient phase commutes with exact full-event key transport. -/

namespace Bounty
section Keys
variable {I K J G : Type*} {P : G → Type*}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → G → ℤ) (f : I → K)

theorem full_permutation_key_local_phase
    (phase : ∀ tag x, FullPermutationMixedEvent n S B A Δ D tag x → ℂ)
    (steps : List (Option (J ⊕ I)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n (fun i => S (f i)) B (fun i => A (f i))
      (fun i => Δ (f i)) (fun i => D (f i)) steps x) :
    finiteEventLocalPhase (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) phase
      (steps.map (Option.map (Sum.map id f))) x
      (fullPermutationKeyPathEquiv n S B A Δ D f steps x p) =
    finiteEventLocalPhase
      (FullPermutationMixedEvent n (fun i => S (f i)) B (fun i => A (f i))
        (fun i => Δ (f i)) (fun i => D (f i)))
      (fullPermutationMixedEventTarget n (fun i => S (f i)) B (fun i => A (f i))
        (fun i => Δ (f i)) (fun i => D (f i)))
      (fun tag x e => phase (tag.map (Sum.map id f)) x
        (fullPermutationKeyEventEquiv n S B A Δ D f tag x e)) steps x p := by
  have h := full_permutation_key_ledger_phase n S B A Δ D f
    (fun _ (_ : Unit) _ _ => ()) (fun tag (_ : Unit) x e => phase tag x e) steps () x p
  simpa only [deterministic_ledger_local_phase] using h

