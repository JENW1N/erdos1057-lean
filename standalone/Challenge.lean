    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (inputCap outputCap : Nat) (F : GlobalBirthJointPhase R → ℂ) (w : GlobalBirthJointPhase R) :
    globalBirthJointCutPhaseRow step inputCap outputCap F w =
      ∑ z, globalBirthJointCutKernel step inputCap outputCap z w * F z := by
  classical
  unfold globalBirthJointCutPhaseRow globalBirthJointPhaseCutoff globalBirthJointCutKernel
  split_ifs with hw
  · exact global_birth_joint_phase_row_eq step outputCap F w
  · simp only [zero_mul, sum_const_zero]

