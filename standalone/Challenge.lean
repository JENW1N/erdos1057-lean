noncomputable def physicalFreePrimePairError {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b : ℝ) (w z : ℕ) : ℂ :=
  let marks := fun g => ell + (repeatedBigPrimePatternCut probes r t i g).card
  groupMarkedAverage P marks (w : ℤ) (fun u => groupMarkedAverage P marks (z : ℤ)
      (physicalUnsharedPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z u)) -
    groupMarkedAverage P marks (w : ℤ) (fun u => groupMarkedAverage P marks (z : ℤ)
      (physicalFreePrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z u))

