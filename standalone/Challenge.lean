section
open Finset Classical
/- Reindex an entire ordered assignment by a permutation. -/
def birthAssignmentPermutation {α : Type*} {n : ℕ} (σ : Equiv.Perm (Fin n)) :
    (Fin n → α) ≃ (Fin n → α) where
  toFun f := fun j => f (σ j)
  invFun f := fun j => f (σ.symm j)
  left_inv f := by funext j; simp
  right_inv f := by funext j; simp

noncomputable def birthPermutationAverage {α : Type*} {n : ℕ}
    (φ : (Fin n → α) → ℂ) (f : Fin n → α) : ℂ :=
  (Fintype.card (Equiv.Perm (Fin n)) : ℂ)⁻¹ *
    ∑ σ : Equiv.Perm (Fin n), φ (fun j => f (σ j))

/- Permuting inputs does not change their averaged local multiplier. -/
theorem birthPermutationAverage_invariant {α : Type*} {n : ℕ}
    (φ : (Fin n → α) → ℂ) (f : Fin n → α) (τ : Equiv.Perm (Fin n)) :
    birthPermutationAverage φ (fun j => f (τ j)) = birthPermutationAverage φ f := by
  unfold birthPermutationAverage
  congr 1
  exact Equiv.sum_comp (Equiv.mulLeft τ) (fun σ : Equiv.Perm (Fin n) => φ (fun j => f (σ j)))















end

section
open Finset
/- The canonical kernel first factors through `A`, then `G`, then `B`. -/
noncomputable def finiteCompressionKernel {C S R : Type*} [Fintype S] [Semiring R]
    (A : ℕ → C → S → R) (B : ℕ → S → C → R) (G : ℕ → S → S → R)
    (j : ℕ) (x y : C) : R :=
  ∑ z, ∑ w, A j x z * G j z w * B j w y

/- The compressed transition joins `G (j+1)`, `B (j+1)`, and `A j`. -/
noncomputable def finiteCompressionStep {C S R : Type*}
    [Fintype C] [Fintype S] [Semiring R]
    (A : ℕ → C → S → R) (B : ℕ → S → C → R) (G : ℕ → S → S → R)
    (j : ℕ) (z w : S) : R :=
  ∑ u, ∑ c, G (j + 1) z u * B (j + 1) u c * A j c w

/- The initial compressed vector is `G 0` followed by `B 0` and the
canonical initial vector. -/
noncomputable def finiteCompressionInitial {C S R : Type*}
    [Fintype C] [Fintype S] [Semiring R]
    (B : ℕ → S → C → R) (G : ℕ → S → S → R) (f : C → R) (z : S) : R :=
  ∑ w, ∑ c, G 0 z w * B 0 w c * f c

section

variable
  {C S R : Type*}
  [sharedInstance1 : Fintype C]
  [sharedInstance2 : Fintype S]
  [sharedInstance3 : Semiring R]
  (A : ℕ → C → S → R)
  (B : ℕ → S → C → R)
  (G : ℕ → S → S → R)

include C S R sharedInstance1 sharedInstance2 sharedInstance3 A B G

/- Reassociate one factored kernel action without changing scalar order. -/
theorem finite_compression_kernel_action 
    (v : C → R) (j : ℕ) (x : C) :
    (∑ y, finiteCompressionKernel A B G j x y * v y) =
      ∑ z, A j x z * (∑ w, ∑ y, G j z w * B j w y * v y) := by
  simp only [finiteCompressionKernel, sum_mul, mul_sum, mul_assoc]
  rw [sum_comm]
  apply sum_congr rfl
  intro z _
  exact sum_comm

/- Iterating the canonical `A j * G j * B j` kernels compresses to a
single final `A n`, the phase transitions `G (j+1) * B (j+1) * A j`,
and the initial vector `G 0 * B 0 * f`. -/
theorem finite_path_action_compress 
    (f : C → R) (n : ℕ) (x : C) :
    finitePathAction (finiteCompressionKernel A B G) f (n + 1) x =
      ∑ z, A n x z * finitePathAction (finiteCompressionStep A B G)
        (finiteCompressionInitial B G f) n z := by
  induction n generalizing x with
  | zero =>
    change (∑ y, finiteCompressionKernel A B G 0 x y * f y) =
      ∑ z, A 0 x z * finiteCompressionInitial B G f z
    exact finite_compression_kernel_action A B G f 0 x
  | succ n ih =>
    rw [finitePathAction, finite_compression_kernel_action]
    apply sum_congr rfl
    intro z _
    congr 1
    simp_rw [ih]
    simp only [finitePathAction, finiteCompressionStep, sum_mul, mul_sum, mul_assoc]
    symm
    rw [sum_comm]
    apply sum_congr rfl
    intro u _
    exact sum_comm

/- A weighted canonical boundary compresses into the final rectangular
factor. This is the finite boundary-pairing version of path compression. -/
theorem finite_path_action_compress_weighted 
    (f q : C → R) (n : ℕ) :
    (∑ x, q x * finitePathAction (finiteCompressionKernel A B G) f (n + 1) x) =
      ∑ z, (∑ x, q x * A n x z) *
        finitePathAction (finiteCompressionStep A B G)
          (finiteCompressionInitial B G f) n z := by
  simp only [finite_path_action_compress, mul_sum, sum_mul, mul_assoc]
  exact sum_comm

end

end

section
open Finset
/- Time-dependent diagonal conjugation telescopes through the full path. -/
theorem finite_path_action_diagonal_gauge {X 𝕜 : Type*} [Fintype X] [Field 𝕜]
    (K : ℕ → X → X → 𝕜) (d : ℕ → X → 𝕜)
    (hd : ∀ j x, d j x ≠ 0) (f : X → 𝕜) (n : ℕ) (x : X) :
    finitePathAction (fun j x y => (d (j + 1) x)⁻¹ * K j x y * d j y)
      (fun x => (d 0 x)⁻¹ * f x) n x =
      (d n x)⁻¹ * finitePathAction K f n x := by
  induction n generalizing x with
  | zero => rfl
  | succ n ih =>
      simp only [finitePathAction, ih, mul_sum]
      apply sum_congr rfl
      intro y hy
      field_simp [hd]




/- A normalized visit followed, on its right, by a normalized incoming edge
is exactly the diagonal gauge of their unnormalized composition. -/
theorem diagonal_visit_edge_composition
    {X 𝕜 : Type*} [Fintype X] [Field 𝕜]
    (G E : X → X → 𝕜) (dnext dprev : X → 𝕜)
    (hdnext : ∀ x, dnext x ≠ 0) (x y : X) :
    (∑ z, (G x z / (dnext x * dnext z)) *
      (dnext z * E z y * dprev y)) =
      (dnext x)⁻¹ * (∑ z, G x z * E z y) * dprev y := by
  rw [mul_sum, sum_mul]
  apply sum_congr rfl
  intro z hz
  field_simp [hdnext]

/- Normalizing the first visit leaves only its output diagonal when the
initial vector is supported on states with diagonal one. -/
theorem diagonal_initial_visit
    {X 𝕜 : Type*} [Fintype X] [Field 𝕜]
    (G : X → X → 𝕜) (d f : X → 𝕜) (hd : ∀ x, d x ≠ 0)
    (hf : ∀ x, f x ≠ 0 → d x = 1) (x : X) :
    (∑ y, (G x y / (d x * d y)) * f y) =
      (d x)⁻¹ * ∑ y, G x y * f y := by
  rw [mul_sum]
  apply sum_congr rfl
  intro y hy
  by_cases hfy : f y = 0
  · simp [hfy]
  · rw [hf y hfy]
    field_simp [hd]

section

variable
  {X 𝕜 : Type*}
  [sharedInstance1 : Fintype X]
  [sharedInstance2 : Field 𝕜]
  (G E : ℕ → X → X → 𝕜)
  (d : ℕ → X → 𝕜)
  (hd : ∀ j x, d j x ≠ 0)

include X 𝕜 sharedInstance1 sharedInstance2 G E d hd

/- The whole alternating evolution `G_n E_(n-1) ... E_0 G_0` has only
the final inverse diagonal after all normalized interior factors cancel. -/
theorem alternating_visit_edge_diagonal_gauge
     (f : X → 𝕜)
    (hf : ∀ x, f x ≠ 0 → d 0 x = 1) (n : ℕ) (x : X) :
    finitePathAction
      (fun j x y => ∑ z, (G (j + 1) x z / (d (j + 1) x * d (j + 1) z)) *
        (d (j + 1) z * E j z y * d j y))
      (fun x => ∑ y, (G 0 x y / (d 0 x * d 0 y)) * f y) n x =
      (d n x)⁻¹ * finitePathAction
        (fun j x y => ∑ z, G (j + 1) x z * E j z y)
        (fun x => ∑ y, G 0 x y * f y) n x := by
  simp_rw [diagonal_visit_edge_composition _ _ _ _ (hd _),
    diagonal_initial_visit _ _ _ (hd 0) hf]
  exact finite_path_action_diagonal_gauge _ d hd _ n x

/- With vacuum boundary tests, the paired alternating visit/edge product
is invariant under the auxiliary diagonal normalization. -/
theorem alternating_visit_edge_diagonal_pairing
     (f q : X → 𝕜) (n : ℕ)
    (hf : ∀ x, f x ≠ 0 → d 0 x = 1)
    (hq : ∀ x, q x ≠ 0 → d n x = 1) :
    (∑ x, q x * finitePathAction
      (fun j x y => ∑ z, (G (j + 1) x z / (d (j + 1) x * d (j + 1) z)) *
        (d (j + 1) z * E j z y * d j y))
      (fun x => ∑ y, (G 0 x y / (d 0 x * d 0 y)) * f y) n x) =
      ∑ x, q x * finitePathAction
        (fun j x y => ∑ z, G (j + 1) x z * E j z y)
        (fun x => ∑ y, G 0 x y * f y) n x := by
  simp_rw [alternating_visit_edge_diagonal_gauge G E d hd f hf]
  apply sum_congr rfl
  intro x hx
  by_cases hqx : q x = 0
  · simp [hqx]
  · simp [hq x hqx]

end

end

section
open Finset
abbrev GhostPhaseState (R : Type*) := Option (GhostFiniteState R)

/- Gather an unborn or matching pending lifespan into an active visit. -/
noncomputable def ghostActiveInput {R : Type*} [DecidableEq R]
    (h : R) (β : ℝ) : GhostFiniteState R → ℝ
  | none => β
  | some none => 0
  | some (some r) => if r = h then 1 else 0

/- Scatter an active visit to a completed or matching pending lifespan. -/
noncomputable def ghostActiveOutput {R : Type*} [DecidableEq R]
    (h : R) : GhostFiniteState R → ℝ
  | none => 0
  | some none => 1
  | some (some r) => if r = h then 1 else 0

noncomputable def ghostPhaseGather {R : Type*} [DecidableEq R]
    (a : Bool) (h : R) (β : ℝ) : GhostPhaseState R → GhostFiniteState R → ℝ :=
  if a then fun z y => match z with
    | none => ghostActiveInput h β y
    | some _ => 0
  else fun z y => match z with
    | none => 0
    | some c => if c = y then 1 else 0

noncomputable def ghostPhaseScatter {R : Type*} [DecidableEq R]
    (a : Bool) (h : R) : GhostFiniteState R → GhostPhaseState R → ℝ :=
  if a then fun x z => match z with
    | none => ghostActiveOutput h x
    | some _ => 0
  else fun x z => match z with
    | none => 0
    | some c => if x = c then 1 else 0

noncomputable def ghostPhaseVisit {R : Type*} [DecidableEq R]
    (a : Bool) (h : R) (η β : ℝ) : GhostPhaseState R → GhostPhaseState R → ℝ :=
  if a then fun z w => match z, w with
    | none, none => 1
    | _, _ => 0
  else fun z w => match z, w with
    | some x, some y => ghostFiniteKernel h η β x y
    | _, _ => 0

/- The edge joins a source scatter to the following target gather. -/
noncomputable def ghostPhaseEdge {R : Type*} [Fintype R] [DecidableEq R]
    (aTarget aSource : Bool) (hTarget hSource : R) (β : ℝ)
    (z w : GhostPhaseState R) : ℝ :=
  ∑ c : GhostFiniteState R,
    ghostPhaseGather aTarget hTarget β z c * ghostPhaseScatter aSource hSource c w

/- An active canonical transition has rank one. -/
theorem ghost_active_kernel_factor {R : Type*} [DecidableEq R]
    (h : R) (η β : ℝ) (x y : GhostFiniteState R) :
    activeGhostFiniteKernel true h η β x y =
      ghostActiveOutput h x * ghostActiveInput h β y := by
  rcases x with _ | (_ | r) <;> rcases y with _ | (_ | s) <;>
    simp [activeGhostFiniteKernel, ghostActiveOutput, ghostActiveInput]
  split <;> simp_all
  tauto

/- Exact factorization through active or inactive phase memory. -/
theorem ghost_phase_kernel_factorization {R : Type*} [Fintype R] [DecidableEq R]
    (a : Bool) (h : R) (η β : ℝ) (x y : GhostFiniteState R) :
    activeGhostFiniteKernel a h η β x y =
      ∑ z : GhostPhaseState R, ∑ w : GhostPhaseState R,
        ghostPhaseScatter a h x z * ghostPhaseVisit a h η β z w *
          ghostPhaseGather a h β w y := by
  cases a
  · simp [ghostPhaseScatter, ghostPhaseVisit, ghostPhaseGather,
      activeGhostFiniteKernel, ite_mul, mul_ite]
  · simp [ghostPhaseScatter, ghostPhaseVisit, ghostPhaseGather,
      ghost_active_kernel_factor]

/- Consecutive active visits require equal hit residues, with no new birth cost. -/
theorem ghost_phase_edge_active_active {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource : R) (β : ℝ) :
    ghostPhaseEdge true true hTarget hSource β none none =
      if hSource = hTarget then 1 else 0 := by
  simp [ghostPhaseEdge, ghostPhaseGather, ghostPhaseScatter,
    ghostActiveInput, ghostActiveOutput, mul_ite, eq_comm]

/- Leaving an active phase scatters to canonical inactive memory. -/
theorem ghost_phase_edge_inactive_active {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource : R) (β : ℝ) (x : GhostFiniteState R) :
    ghostPhaseEdge false true hTarget hSource β (some x) none =
      ghostActiveOutput hSource x := by
  simp [ghostPhaseEdge, ghostPhaseGather, ghostPhaseScatter, ite_mul]

/- Entering an active phase gathers canonical inactive memory. -/
theorem ghost_phase_edge_active_inactive {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource : R) (β : ℝ) (y : GhostFiniteState R) :
    ghostPhaseEdge true false hTarget hSource β none (some y) =
      ghostActiveInput hTarget β y := by
  simp [ghostPhaseEdge, ghostPhaseGather, ghostPhaseScatter, mul_ite]

/- Consecutive inactive phases carry canonical memory without changing it. -/
theorem ghost_phase_edge_inactive_inactive {R : Type*} [Fintype R] [DecidableEq R]
    (hTarget hSource : R) (β : ℝ) (x y : GhostFiniteState R) :
    ghostPhaseEdge false false hTarget hSource β (some x) (some y) =
      if x = y then 1 else 0 := by
  simp [ghostPhaseEdge, ghostPhaseGather, ghostPhaseScatter]






end

section
open Finset
def ghostPhaseMask {I : Type*} {R : I → Type*} (a : I → Bool)
    (x : (i : I) → Option (GhostFiniteState (R i))) : Prop :=
  ∀ i, (x i).isSome = !(a i)



























end

section

/- The local diagonal whose neighboring factors supply the endpoint rho
factors and the two rho factors at an internal pending hit. -/
noncomputable def ghostPhaseDiagonal {R : Type*} [DecidableEq R]
    (hit : R) (ρ : ℝ) : GhostPhaseState R → ℝ
  | some (some (some r)) => if r = hit then ρ else 1
  | _ => 1

theorem ghostPhaseDiagonal_ne_zero {R : Type*} [DecidableEq R]
    (hit : R) {ρ : ℝ} (hρ : ρ ≠ 0) (x : Option (GhostFiniteState R)) :
    ghostPhaseDiagonal hit ρ x ≠ 0 := by
  rcases x with _ | (_ | (_ | r))
  · exact one_ne_zero
  · exact one_ne_zero
  · exact one_ne_zero
  · simp only [ghostPhaseDiagonal]
    split
    · exact hρ
    · exact one_ne_zero
















/- The visit normalization matching the adjacent diagonal edge factors. -/
noncomputable def ghostPhaseDampedVisit {R : Type*} [DecidableEq R]
    (a : Bool) (hit : R) (η β ρ : ℝ) (z w : GhostPhaseState R) : ℝ :=
  ghostPhaseVisit a hit η β z w /
    (ghostPhaseDiagonal hit ρ z * ghostPhaseDiagonal hit ρ w)





















end

section

/- Multiply the phase edge by the target and source diagonals, in the
output-row/input-column convention. -/
noncomputable def ghostPhaseDampedEdge {R : Type*} [Fintype R] [DecidableEq R]
    (aTarget aSource : Bool) (hTarget hSource : R) (β ρTarget ρSource : ℝ)
    (z w : GhostPhaseState R) : ℝ :=
  ghostPhaseDiagonal hTarget ρTarget z *
    ghostPhaseEdge aTarget aSource hTarget hSource β z w *
      ghostPhaseDiagonal hSource ρSource w






























end

section
open Finset
def ghostFiniteTerminal {R : Type*} : GhostFiniteState R → ℝ
  | none => 1
  | some none => 1
  | some (some _) => 0

noncomputable def ghostPhaseInitial {R : Type*} (a : Bool) (β : ℝ) :
    GhostPhaseState R → ℝ :=
  if a then fun z => match z with
    | none => β
    | some _ => 0
  else fun z => match z with
    | none => 0
    | some c => ghostFiniteInitial c

def ghostPhaseTerminal {R : Type*} (a : Bool) : GhostPhaseState R → ℝ :=
  if a then fun z => match z with
    | none => 1
    | some _ => 0
  else fun z => match z with
    | none => 0
    | some c => ghostFiniteTerminal c

theorem ghost_phase_gather_initial {R : Type*} [Fintype R] [DecidableEq R]
    (a : Bool) (h : R) (β : ℝ) (z : GhostPhaseState R) :
    (∑ c, ghostPhaseGather a h β z c * ghostFiniteInitial c) =
      ghostPhaseInitial a β z := by
  cases a <;> cases z <;>
    simp [ghostPhaseGather, ghostPhaseInitial, ghostActiveInput, ghostFiniteInitial]

theorem ghost_phase_scatter_terminal {R : Type*} [Fintype R] [DecidableEq R]
    (a : Bool) (h : R) (z : GhostPhaseState R) :
    (∑ c, ghostFiniteTerminal c * ghostPhaseScatter a h c z) =
      ghostPhaseTerminal a z := by
  cases a <;> cases z <;>
    simp [ghostPhaseScatter, ghostPhaseTerminal, ghostActiveOutput,
      ghostFiniteTerminal, mul_ite]

noncomputable def ghostPhaseHistory {R : Type*} [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) : ℝ :=
  ∑ x, ghostPhaseTerminal (a n) x * finitePathAction
    (fun j x y => ∑ z, ghostPhaseVisit (a (j + 1)) (h (j + 1)) (η (j + 1)) β x z *
      ghostPhaseEdge (a (j + 1)) (a j) (h (j + 1)) (h j) β z y)
    (fun x => ∑ y, ghostPhaseVisit (a 0) (h 0) (η 0) β x y *
      ghostPhaseInitial (a 0) β y) n x

/- The phase history is exactly the canonical vacuum after all `n+1` visits. -/
theorem ghost_phase_history_eq_vacuum {R : Type*} [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) :
    ghostPhaseHistory a h η β n =
      (activeGhostRun a h η β (n + 1)).unborn +
      (activeGhostRun a h η β (n + 1)).completed := by
  let A := fun j => ghostPhaseScatter (a j) (h j)
  let B := fun j => ghostPhaseGather (a j) (h j) β
  let G := fun j => ghostPhaseVisit (a j) (h j) (η j) β
  have hK : finiteCompressionKernel A B G =
      (fun j => activeGhostFiniteKernel (a j) (h j) (η j) β) := by
    funext j x y
    exact (ghost_phase_kernel_factorization (a j) (h j) (η j) β x y).symm
  have hE : finiteCompressionStep A B G =
      (fun j x y => ∑ z, G (j + 1) x z *
        ghostPhaseEdge (a (j + 1)) (a j) (h (j + 1)) (h j) β z y) := by
    funext j x y
    simp only [finiteCompressionStep, ghostPhaseEdge, mul_sum, mul_assoc, A, B]
  have hI : finiteCompressionInitial B G ghostFiniteInitial =
      (fun x => ∑ y, G 0 x y * ghostPhaseInitial (a 0) β y) := by
    funext x
    simp only [finiteCompressionInitial, B]
    simp_rw [mul_assoc, ← mul_sum, ghost_phase_gather_initial]
  have hc := finite_path_action_compress_weighted A B G
    ghostFiniteInitial ghostFiniteTerminal n
  rw [hK, hE, hI] at hc
  simp_rw [A, ghost_phase_scatter_terminal] at hc
  have hv : (∑ x, ghostFiniteTerminal x *
      finitePathAction (fun j => activeGhostFiniteKernel (a j) (h j) (η j) β)
        ghostFiniteInitial (n + 1) x) =
      (activeGhostRun a h η β (n + 1)).unborn +
      (activeGhostRun a h η β (n + 1)).completed := by
    simp only [active_ghost_finite_action_eq_vector, ghostFiniteTerminal,
      Fintype.sum_option, activeGhostFiniteVector, one_mul, zero_mul,
      sum_const_zero, add_zero]
  rw [hv] at hc
  exact hc.symm

/- This is the exact normalized active-residue expectation, including
single global births and the full active/inactive pattern. -/
theorem ghost_phase_history_residue_identity {R : Type*}
    [Fintype R] [DecidableEq R] [Nonempty R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (n : ℕ) (b : ℝ)
    (hb : b = 1 - (∑ j ∈ range (n + 1), η j) / Fintype.card R)
    (hb0 : b ≠ 0) :
    b * ghostPhaseHistory a h η ((Fintype.card R : ℝ) * b)⁻¹ n =
      (∑ r : R, activeResidueWeight (range (n + 1))
        ((range (n + 1)).filter (fun j => a j = true)) h η r) / Fintype.card R := by
  rw [ghost_phase_history_eq_vacuum,
    activeGhost_vacuum_identity a h η (n + 1) b hb hb0]
  simp_rw [activeGhost_product_eq_weight]
  exact mul_div_cancel₀ _ hb0
end

