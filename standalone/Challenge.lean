section

/- Finite low-rank bounds retain the saving on the unaffected operations. -/

open Finset Classical

namespace Bounty

theorem birthForest_low_rank_power_bound {m : ℕ} (F : BirthForestCode m → ℂ)
    (r₀ : ℕ) {L H B D M : ℝ} (hL : 1 ≤ L) (hH : 0 ≤ H)
    (hDM : 0 ≤ D + M) (hm : (m : ℝ) ≤ L ^ M)
    (hF : ∀ code, birthForestRank code < r₀ →
      ‖F code‖ ≤ H * L ^ (B + 2 * birthForestRank code * D)) :
    ‖∑ code ∈ (univ : Finset (BirthForestCode m)).filter
        (fun code => birthForestRank code < r₀),
      (-1 : ℂ) ^ birthForestRank code * F code‖ ≤
      ((m : ℝ) + 1) * H * L ^ (B + 2 * r₀ * (D + M)) := by
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have heq : (univ : Finset (BirthForestCode m)).filter
      (fun code => birthForestRank code < r₀) =
      univ.filter (fun code => birthForestRank code < min r₀ (m + 1)) := by
    ext code
    have hr := birthForestRank_le_addresses code
    simp only [mem_filter, mem_univ, true_and, lt_min_iff]
    omega
  rw [heq]
  apply (birthForest_rank_head_norm_le F (min r₀ (m + 1))
    (fun r => H * L ^ (B + 2 * r * D))
    (fun r _ => mul_nonneg hH (Real.rpow_pos_of_pos hL0 _).le)
    (fun code hc => hF code (lt_of_lt_of_le hc (min_le_left _ _)))).trans
  have hone : 0 ≤ H * L ^ (B + 2 * r₀ * (D + M)) := by positivity
  calc
    _ ≤ ∑ _r ∈ range (min r₀ (m + 1)), H * L ^ (B + 2 * r₀ * (D + M)) := by
      apply sum_le_sum
      intro r hr
      have hrr : (r : ℝ) ≤ r₀ := by
        exact_mod_cast (Nat.le_of_lt (lt_of_lt_of_le (mem_range.mp hr) (min_le_left _ _)))
      have hp : (m : ℝ) ^ (2 * r) ≤ L ^ (2 * r * M) := by
        calc
          _ ≤ (L ^ M) ^ (2 * r) := pow_le_pow_left₀ (Nat.cast_nonneg _) hm _
          _ = L ^ (2 * r * M) := by
            rw [← Real.rpow_natCast, ← Real.rpow_mul hL0.le]
            congr 1
            push_cast
            ring
      calc
        (m : ℝ) ^ (2 * r) * (H * L ^ (B + 2 * r * D)) ≤
            L ^ (2 * r * M) * (H * L ^ (B + 2 * r * D)) :=
          mul_le_mul_of_nonneg_right hp (by positivity)
        _ = H * L ^ (B + 2 * r * (D + M)) := by
          rw [mul_left_comm, ← Real.rpow_add hL0]
          congr 1
          congr 1
          ring
        _ ≤ H * L ^ (B + 2 * r₀ * (D + M)) := by
          apply mul_le_mul_of_nonneg_left _ hH
          apply Real.rpow_le_rpow_of_exponent_le hL
          nlinarith
    _ = (min r₀ (m + 1) : ℕ) * (H * L ^ (B + 2 * r₀ * (D + M))) := by simp
    _ ≤ ((m : ℝ) + 1) * (H * L ^ (B + 2 * r₀ * (D + M))) := by
      apply mul_le_mul_of_nonneg_right _ hone
      exact_mod_cast min_le_right r₀ (m + 1)
    _ = _ := by ring

end Bounty
end

section

/- Memory-cap embeddings retain the genuine small residue and injective-list
coordinate. The mixed measure is preserved exactly on the embedded states. -/

open Finset
open scoped Classical

namespace Bounty

def physicalSmallBigCapEmbed {S G : Type*} {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell b B : ℕ} {M : G → ℕ} (h : b ≤ B)
    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M b)) :
    PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) :=
  (s.1, productStateCapEmbed h s.2)

theorem physicalSmallBigCapEmbed_injective {S G : Type*} {Ps : S → Finset ℕ}
    {P Z : G → Type*} {J ell b B : ℕ} {M : G → ℕ} (h : b ≤ B) :
    Function.Injective (physicalSmallBigCapEmbed (Ps := Ps) (P := P) (Z := Z)
      (J := J) (ell := ell) (M := M) h) := by
  intro s t he
  change (s.1, productStateCapEmbed h s.2) = (t.1, productStateCapEmbed h t.2) at he
  have hs : s.1 = t.1 := congrArg
    (fun u : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) => u.1) he
  have ht : s.2 = t.2 := productStateCapEmbed_injective h (congrArg
    (fun u : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) => u.2) he)
  exact Prod.ext hs ht




theorem physical_small_big_cap_pullback_energy_le
    {S G : Type*} [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} [∀ p : PhysicalPrime Ps, NeZero p.2.val]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {J ell b B : ℕ} {M : G → ℕ} (h : b ≤ B)
    (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s)
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (F : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ) :
    physicalSmallBigEnergy Vs (productMemoryWeight μ ν)
        (fun s => F (physicalSmallBigCapEmbed h s)) ≤
      physicalSmallBigEnergy Vs (productMemoryWeight μ ν) F := by
  rw [← physical_small_big_energy_eq, ← physical_small_big_energy_eq]
  unfold finiteWeightedEnergy
  let embed := physicalSmallBigCapEmbed (Ps := Ps) (P := P) (Z := Z)
    (J := J) (ell := ell) (M := M) h
  let weight := fun s => physicalSmallBigMeasure Vs (productMemoryWeight μ ν) s * ‖F s‖ ^ 2
  calc
    _ = ∑ s ∈ (univ : Finset (PhysicalSmallBigState Ps J ell
        (ProductBoundedOrderedState P Z M b))).image embed, weight s := by
      rw [sum_image (physicalSmallBigCapEmbed_injective h).injOn]
      rfl
    _ ≤ ∑ s, weight s := sum_le_sum_of_subset_of_nonneg (subset_univ _) (by
      intro s _ _
      exact mul_nonneg (physical_small_big_measure_nonneg Vs hVs _
        (productMemoryWeight_nonneg μ ν hμ hν) s) (sq_nonneg _))

end Bounty
end

section

/- Every intermediate residual on a positive allocation branch satisfies the inventory invariant. -/

open Finset Real

namespace Bounty

noncomputable def allocationPrefixResidual {n : ℕ} (v : Fin n → ℝ)
    (R : ℝ) (take : Fin n → Bool) (i : Fin n) : ℝ :=
  R-∑ j, if j < i then (if take j then v j else 0) else 0

noncomputable def allocationSuffixInventory {n : ℕ} (v : Fin n → ℝ)
    (active : Fin n → Bool) (i : Fin n) : ℝ :=
  ∑ j, if i ≤ j ∧ active j = true then v j else 0

theorem allocation_prefix_eq_ordered_residual {n : ℕ} (v : Fin n → ℝ)
    (R : ℝ) (take : Fin n → Bool) (i : Fin n) :
    allocationPrefixResidual v R take i =
      orderedSlotResidual R (fun j => if take j then 1 else 0) v i := by
  simp only [allocationPrefixResidual, orderedSlotResidual, sum_filter, ite_mul, one_mul, zero_mul]

section

variable
  {n : ℕ}
  (v : Fin (n+1) → ℝ)

include n v

theorem allocation_prefix_zero 
    (R : ℝ) (take : Fin (n+1) → Bool) : allocationPrefixResidual v R take 0 = R := by
  simp [allocationPrefixResidual]

theorem allocation_suffix_zero 
    (active : Fin (n+1) → Bool) :
    allocationSuffixInventory v active 0 = smoothAllocationInventory (n+1) v active := by
  simp [allocationSuffixInventory, smoothAllocationInventory]

theorem allocation_prefix_succ 
    (R : ℝ) (take : Fin (n+1) → Bool) (i : Fin n) :
    allocationPrefixResidual v R take i.succ =
      allocationPrefixResidual (Fin.tail v) (R-if take 0 then v 0 else 0) (Fin.tail take) i := by
  rw [Fin.tail_def, Fin.tail_def]
  unfold allocationPrefixResidual
  rw [Fin.sum_univ_succ, sub_sub]
  simp only [Fin.succ_pos, if_true, Fin.succ_lt_succ_iff]

theorem allocation_suffix_succ 
    (active : Fin (n+1) → Bool) (i : Fin n) :
    allocationSuffixInventory v active i.succ =
      allocationSuffixInventory (Fin.tail v) (Fin.tail active) i := by
  rw [Fin.tail_def, Fin.tail_def]
  unfold allocationSuffixInventory
  rw [Fin.sum_univ_succ]
  have hzero : ¬i.succ ≤ 0 := not_le_of_gt (Fin.succ_pos i)
  simp only [hzero, false_and, if_false, Fin.succ_le_succ_iff, zero_add]

end


theorem smooth_allocation_next_residual_bound {n : ℕ} (v s : Fin (n+1) → ℝ)
    (active : Fin (n+1) → Bool) (R A : ℝ) (take : Fin (n+1) → Bool)
    (hs : 0 < s 0) (hR : 0 ≤ R)
    (hcap : R ≤ smoothAllocationInventory (n+1) v active+A)
    (hroom : SmoothAllocationRoom (n+1) v s active A)
    (hhead : 0 < smoothSlotTransition (v 0) (s 0) R (active 0) (take 0)) :
    0 ≤ R-(if take 0 then v 0 else 0) ∧
      R-(if take 0 then v 0 else 0) ≤ smoothAllocationInventory n (Fin.tail v) (Fin.tail active)+A := by
  cases ha : active 0 <;> cases ht : take 0
  · have hh : R ≤ smoothAllocationInventory n (Fin.tail v) (Fin.tail active)+A := by
      rw [Fin.tail_def, Fin.tail_def]
      unfold smoothAllocationInventory at *
      simpa only [Fin.sum_univ_succ, ha, Bool.false_eq_true, if_false, zero_add] using hcap
    simpa only [Bool.false_eq_true, if_false, sub_zero] using And.intro hR hh
  · simp only [smoothSlotTransition, smoothSlotTakeProbability, ha, ht,
      Bool.false_eq_true, if_false, if_true] at hhead
    linarith
  · have hh := smooth_slot_skip_requires_room hs (by simpa only [ha,ht] using hhead)
    have hr := hroom.1 ha
    simp only [Bool.false_eq_true, if_false, sub_zero]
    exact ⟨hR,(le_of_lt hh).trans hr⟩
  · have hh := smooth_slot_take_requires_room hs (by simpa only [ht] using hhead)
    have hc : R ≤ v 0+smoothAllocationInventory n (Fin.tail v) (Fin.tail active)+A := by
      rw [Fin.tail_def, Fin.tail_def]
      unfold smoothAllocationInventory at *
      simpa only [Fin.sum_univ_succ, ha, if_true] using hcap
    simp only [if_true]
    constructor <;> linarith

theorem smooth_allocation_prefix_invariant (n : ℕ) (v s : Fin n → ℝ)
    (active : Fin n → Bool) (R A : ℝ) (take : Fin n → Bool)
    (hs : ∀ i, 0 < s i) (hR : 0 ≤ R)
    (hcap : R ≤ smoothAllocationInventory n v active+A)
    (hroom : SmoothAllocationRoom n v s active A)
    (hweight : 0 < smoothAllocationWeight n v s active R take) (i : Fin n) :
    0 ≤ allocationPrefixResidual v R take i ∧
      allocationPrefixResidual v R take i ≤ allocationSuffixInventory v active i+A := by
  induction n generalizing R with
  | zero => exact Fin.elim0 i
  | succ n ih =>
    obtain ⟨hhead,htail⟩ := smooth_allocation_positive_factors hweight
    have hn := smooth_allocation_next_residual_bound v s active R A take (hs 0) hR hcap hroom hhead
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa only [allocation_prefix_zero, allocation_suffix_zero] using And.intro hR hcap
    · rw [allocation_prefix_succ, allocation_suffix_succ]
      exact ih (Fin.tail v) (Fin.tail s) (Fin.tail active) _ (Fin.tail take)
        (fun j => hs j.succ) hn.1 hn.2 hroom.2 htail j

end Bounty
end

section

open scoped ContDiff

namespace Bounty

noncomputable def typeIITameExp (A x : ℝ) : ℝ :=
  typeIISmoothRho (2 * (A + 1)) x * Real.exp x

noncomputable def typeIIPulledJoint (A : ℝ)
    (y : (Fin 4 → ℝ) × EuclideanSpace ℝ (Fin 3)) : ℝ :=
  typeIIThreeLocalizer A y.2 *
    typeIIEMajorant (y.1 0) (y.1 1 * (typeIITameExp A (y.2 1) - typeIITameExp A (y.2 0))) *
    typeIINMajorant (y.1 2 * (typeIITameExp A (y.2 2 - y.2 0) -
      typeIITameExp A (y.2 2 - y.2 1)) + y.1 3 * typeIITameExp A (-y.2 0))

theorem typeII_tame_exp_hasTemperateGrowth (A : ℝ) :
    Function.HasTemperateGrowth (typeIITameExp A) :=
  (typeII_smooth_rho_hasCompactSupport (2 * (A + 1))).mul_right.hasTemperateGrowth
    ((typeII_smooth_rho_contDiff (2 * (A + 1))).mul Real.contDiff_exp)

theorem typeII_tame_exp_eq {A x : ℝ} (hx : |x| ≤ 2 * (A + 1)) :
    typeIITameExp A x = Real.exp x := by
  rw [typeIITameExp, typeII_smooth_rho_eq_one (abs_le.mp hx), one_mul]

theorem typeII_pulled_joint_hasTemperateGrowth (A : ℝ) :
    Function.HasTemperateGrowth (typeIIPulledJoint A) := by
  have hp (i : Fin 4) : Function.HasTemperateGrowth
      (fun y : (Fin 4 → ℝ) × EuclideanSpace ℝ (Fin 3) => y.1 i) :=
    (ContinuousLinearMap.proj i : (Fin 4 → ℝ) →L[ℝ] ℝ).hasTemperateGrowth.comp
      (ContinuousLinearMap.fst ℝ (Fin 4 → ℝ) (EuclideanSpace ℝ (Fin 3))).hasTemperateGrowth
  have ht (i : Fin 3) : Function.HasTemperateGrowth
      (fun y : (Fin 4 → ℝ) × EuclideanSpace ℝ (Fin 3) => y.2 i) :=
    (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin 3 => ℝ) i).hasTemperateGrowth.comp
      (ContinuousLinearMap.snd ℝ (Fin 4 → ℝ) (EuclideanSpace ℝ (Fin 3))).hasTemperateGrowth
  have hloc : Function.HasTemperateGrowth
      (fun y : (Fin 4 → ℝ) × EuclideanSpace ℝ (Fin 3) => typeIIThreeLocalizer A y.2) :=
    ((typeII_three_localizer_hasCompactSupport A).hasTemperateGrowth
      (typeII_three_localizer_contDiff A)).comp
      (ContinuousLinearMap.snd ℝ (Fin 4 → ℝ) (EuclideanSpace ℝ (Fin 3))).hasTemperateGrowth
  have hexp := typeII_tame_exp_hasTemperateGrowth A
  have hγ := smoothTransition_hasTemperateGrowth
  unfold typeIIPulledJoint typeIIEMajorant typeIINMajorant
  fun_prop

theorem typeII_pulled_joint_eq {A : ℝ} (hA : 0 ≤ A) (p : Fin 4 → ℝ)
    (t : EuclideanSpace ℝ (Fin 3)) :
    typeIIPulledJoint A (p, t) = typeIIPulledCutoff A (p 0) (p 1) (p 2) (p 3) t := by
  by_cases hl : typeIIThreeLocalizer A t = 0
  · simp only [typeIIPulledJoint, typeIIPulledCutoff, hl, zero_mul]
  have ht (i : Fin 3) : t i ∈ Set.Icc (-A - 1) (A + 1) := by
    by_contra hi
    apply hl
    exact Finset.prod_eq_zero (Finset.mem_univ i) (typeII_smooth_rho_eq_zero hi)
  have h0 := ht 0
  have h1 := ht 1
  have h2 := ht 2
  have hb0 : |t 0| ≤ 2 * (A + 1) := abs_le.mpr ⟨by linarith [h0.1], by linarith [h0.2]⟩
  have hb1 : |t 1| ≤ 2 * (A + 1) := abs_le.mpr ⟨by linarith [h1.1], by linarith [h1.2]⟩
  have hb20 : |t 2 - t 0| ≤ 2 * (A + 1) := abs_le.mpr ⟨by linarith [h2.1, h0.2], by linarith [h2.2, h0.1]⟩
  have hb21 : |t 2 - t 1| ≤ 2 * (A + 1) := abs_le.mpr ⟨by linarith [h2.1, h1.2], by linarith [h2.2, h1.1]⟩
  have hbn0 : |-t 0| ≤ 2 * (A + 1) := by simpa using hb0
  simp only [typeIIPulledJoint, typeIIPulledCutoff, typeIIPulledE, typeIIPulledN,
    typeII_tame_exp_eq hb0, typeII_tame_exp_eq hb1, typeII_tame_exp_eq hb20,
    typeII_tame_exp_eq hb21, typeII_tame_exp_eq hbn0]

end Bounty
end

section

open Finset MeasureTheory

namespace Bounty

noncomputable def typeIILogCoordinates (x s : Fin 3 → ℝ) : EuclideanSpace ℝ (Fin 3) :=
  WithLp.toLp 2 (fun i => Real.log (x i / s i))

theorem typeII_euclidean_fourier_phase_eq_prod (ξ t : EuclideanSpace ℝ (Fin 3)) :
    Complex.exp (((2 * Real.pi * inner ℝ ξ t : ℝ) : ℂ) * Complex.I) =
      ∏ i, Complex.exp (((2 * Real.pi * ξ i * t i : ℝ) : ℂ) * Complex.I) := by
  rw [← Complex.exp_sum, PiLp.inner_apply]
  congr 1
  simp only [RCLike.inner_apply, starRingEnd_apply, star_trivial, mul_sum,
    Complex.ofReal_sum, sum_mul]
  apply sum_congr rfl
  intro i hi
  push_cast
  ring

theorem typeII_log_ratio_fourier_phase (x s ξ : ℝ) (hx : 0 < x) (hs : 0 < s) :
    Complex.exp (((2 * Real.pi * ξ * Real.log (x / s) : ℝ) : ℂ) * Complex.I) =
      (s : ℂ) ^ (-((2 * Real.pi * ξ : ℝ) : ℂ) * Complex.I) *
        (x : ℂ) ^ (((2 * Real.pi * ξ : ℝ) : ℂ) * Complex.I) := by
  rw [Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr hs.ne'),
    Complex.cpow_def_of_ne_zero (Complex.ofReal_ne_zero.mpr hx.ne'),
    ← Complex.ofReal_log hs.le, ← Complex.ofReal_log hx.le, ← Complex.exp_add,
    Real.log_div hx.ne' hs.ne']
  congr 1
  push_cast
  ring

theorem typeII_pulled_logarithmic_phase_separation (x s : Fin 3 → ℝ)
    (hx : ∀ i, 0 < x i) (hs : ∀ i, 0 < s i) (ξ : EuclideanSpace ℝ (Fin 3)) :
    Complex.exp (((2 * Real.pi * inner ℝ ξ (typeIILogCoordinates x s) : ℝ) : ℂ) * Complex.I) =
      (∏ i, (s i : ℂ) ^ (-((2 * Real.pi * ξ i : ℝ) : ℂ) * Complex.I)) *
        ∏ i, (x i : ℂ) ^ (((2 * Real.pi * ξ i : ℝ) : ℂ) * Complex.I) := by
  rw [typeII_euclidean_fourier_phase_eq_prod, ← prod_mul_distrib]
  apply prod_congr rfl
  intro i hi
  exact typeII_log_ratio_fourier_phase (x i) (s i) (ξ i) (hx i) (hs i)




end Bounty
end

section

/- Group-free multiplication preserves the actual marked divisor weight. -/

open Finset

namespace Bounty




theorem reconstructed_factor_mem_Icc {v m B : ℕ} (hv : 0 < v)
    (hm : m ∣ v) (hB : v ≤ B) : v/m ∈ Icc 1 B := by
  have hmpos : 0 < m := Nat.pos_of_dvd_of_pos hm hv
  apply mem_Icc.mpr
  constructor
  · exact Nat.div_pos (Nat.le_of_dvd hv hm) hmpos
  · exact (Nat.div_le_self v m).trans hB


end Bounty
end

section

/- Rough convolution endpoints with the retained-factor support mask kept explicit. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

noncomputable def typeIIRoughConvolution (R C : Finset ℕ) (σ : ℝ)
    (c : ℕ → ℂ) (n : ℕ) : ℂ :=
  ∑ p ∈ R, ∑ r ∈ C, if p * r = n then typeIIPhase σ p * c r else 0

noncomputable def typeIIMaskedTripleEndpoint (P M H R C : Finset ℕ)
    (A c : ℕ → ℂ) (t σ : ℝ) (v : ℕ) : ℂ :=
  ∑ m ∈ M, ∑ p ∈ R, ∑ r ∈ C,
    if (m ∣ v ∧ v / m ∈ H) ∧ m * p * r = primePoolFreePart P v then
      A m * typeIIPhase t m * typeIIPhase (-σ) p * conj (c r) else 0

theorem typeII_direct_endpoint_eq_divisor_mask
    (M H : Finset ℕ) (A B : ℕ → ℂ) (t : ℝ) (v : ℕ)
    (hM : ∀ m ∈ M, 0 < m) :
    typeIIDirectEndpoint M H A B t v =
      ∑ m ∈ M, if m ∣ v ∧ v / m ∈ H then
        A m * typeIIPhase t m * conj (B (v / m)) else 0 := by
  classical
  unfold typeIIDirectEndpoint
  apply sum_congr rfl
  intro m hm
  by_cases hd : m ∣ v
  · have heq (h : ℕ) : m * h = v ↔ h = v / m := by
      constructor
      · intro hprod
        exact (Nat.div_eq_of_eq_mul_right (hM m hm) hprod.symm).symm
      · intro hquot
        rw [hquot, Nat.mul_div_cancel' hd]
    simp only [heq, hd, true_and]
    rw [sum_ite_eq']
  · have hne (h : ℕ) : ¬m * h = v := fun hprod => hd ⟨h, hprod.symm⟩
    simp only [hd, false_and, if_false, hne, sum_const_zero]

theorem typeII_direct_rough_endpoint_eq_masked_triple
    (P M H R C : Finset ℕ) (A c : ℕ → ℂ) (t σ : ℝ) {v : ℕ}
    (hv : 0 < v) (hM : ∀ m ∈ M, 0 < m)
    (hfree : ∀ m ∈ M, Disjoint m.primeFactors P) :
    typeIIDirectEndpoint M H A
        (fun h => typeIIRoughConvolution R C σ c (primePoolFreePart P h)) t v =
      typeIIMaskedTripleEndpoint P M H R C A c t σ v := by
  classical
  rw [typeII_direct_endpoint_eq_divisor_mask M H A _ t v hM]
  unfold typeIIMaskedTripleEndpoint
  apply sum_congr rfl
  intro m hm
  by_cases hmask : m ∣ v ∧ v / m ∈ H
  · have hmprod : m * (v / m) = v := Nat.mul_div_cancel' hmask.1
    have hquot : v / m ≠ 0 := by
      intro hz
      rw [hz, mul_zero] at hmprod
      exact hv.ne' hmprod.symm
    have hpart : primePoolFreePart P v = m * primePoolFreePart P (v / m) := by
      calc
        _ = primePoolFreePart P (m * (v / m)) := congrArg (primePoolFreePart P) hmprod.symm
        _ = _ := prime_pool_free_part_mul_free_left (hM m hm).ne' hquot (hfree m hm)
    have heq (p r : ℕ) : m * p * r = primePoolFreePart P v ↔
        p * r = primePoolFreePart P (v / m) := by
      rw [hpart, mul_assoc]
      constructor
      · exact Nat.eq_of_mul_eq_mul_left (hM m hm)
      · intro h
        rw [h]
    have hconj (b : Prop) [Decidable b] (x y : ℂ) :
        conj (if b then x else y) = if b then conj x else conj y := by
      split_ifs <;> rfl
    simp only [hmask, true_and, if_true, heq]
    simp only [typeIIRoughConvolution, map_sum, hconj, map_mul, map_zero,
      typeIIPhase_conj, mul_sum, mul_ite, mul_zero, mul_assoc]
  · simp only [hmask, false_and, if_false, sum_const_zero]

theorem typeII_masked_triple_eq_invariant
    (P M H R C : Finset ℕ) (A c : ℕ → ℂ) (t σ : ℝ) {v : ℕ} (hv : 0 < v) :
    typeIIMaskedTripleEndpoint P M H R C A c t σ v =
      invariantTripleEndpoint P
        (fun m => if m ∈ M ∧ m ∣ v ∧ v / m ∈ H then A m * typeIIPhase t m else 0)
        (fun p => if p ∈ R then typeIIPhase (-σ) p else 0)
        (fun r => if r ∈ C then conj (c r) else 0) v := by
  classical
  have hpos : 0 < primePoolFreePart P v :=
    Nat.pos_of_ne_zero (primePoolFreePart_ne_zero P hv.ne')
  calc
    _ = ∑ m ∈ M, ∑ p ∈ R, ∑ r ∈ C,
        if m * p * r = primePoolFreePart P v then
          (if m ∣ v ∧ v / m ∈ H then A m * typeIIPhase t m else 0) *
            typeIIPhase (-σ) p * conj (c r) else 0 := by
      unfold typeIIMaskedTripleEndpoint
      apply sum_congr rfl
      intro m _
      apply sum_congr rfl
      intro p _
      apply sum_congr rfl
      intro r _
      by_cases hm : m ∣ v ∧ v / m ∈ H <;>
        by_cases heq : m * p * r = primePoolFreePart P v <;> simp [hm, heq]
    _ = endpointTripleConvolution
        (fun m => if m ∈ M then
          (if m ∣ v ∧ v / m ∈ H then A m * typeIIPhase t m else 0) else 0)
        (fun p => if p ∈ R then typeIIPhase (-σ) p else 0)
        (fun r => if r ∈ C then conj (c r) else 0) (primePoolFreePart P v) :=
      finite_triple_sum_eq_endpointTripleConvolution M R C _ _ _ hpos
    _ = _ := by
      unfold invariantTripleEndpoint
      congr 1
      funext m
      by_cases hm : m ∈ M <;> by_cases hd : m ∣ v <;>
        by_cases hh : v / m ∈ H <;> simp [hm, hd, hh]

theorem typeII_masked_triple_eq_invariant_of_complete
    (P M H R C : Finset ℕ) (A c : ℕ → ℂ) (t σ : ℝ) {v : ℕ} (hv : 0 < v)
    (hHcomplete : ∀ m ∈ M, m ∣ v → v / m ∈ H) :
    typeIIMaskedTripleEndpoint P M H R C A c t σ v =
      invariantTripleEndpoint P
        (fun m => if m ∈ M then A m * typeIIPhase t m else 0)
        (fun p => if p ∈ R then typeIIPhase (-σ) p else 0)
        (fun r => if r ∈ C then conj (c r) else 0) v := by
  classical
  rw [typeII_masked_triple_eq_invariant P M H R C A c t σ hv]
  unfold invariantTripleEndpoint endpointTripleConvolution
  apply sum_congr rfl
  intro m hm
  have hfdvd : primePoolFreePart P v ∣ v := by
    refine ⟨primePoolPart P v, ?_⟩
    rw [mul_comm]
    exact (primePoolPart_mul_primePoolFreePart P v).symm
  have hmdvd : m ∣ v := (Nat.dvd_of_mem_divisors hm).trans hfdvd
  by_cases hmM : m ∈ M
  · simp only [hmM, hmdvd, hHcomplete m hmM hmdvd, and_self, if_true]
  · simp only [hmM, false_and, if_false, zero_mul, sum_const_zero]

theorem typeII_direct_rough_endpoint_eq_invariant_of_complete
    (P M H R C : Finset ℕ) (A c : ℕ → ℂ) (t σ : ℝ) {v : ℕ}
    (hv : 0 < v) (hM : ∀ m ∈ M, 0 < m)
    (hfree : ∀ m ∈ M, Disjoint m.primeFactors P)
    (hHcomplete : ∀ m ∈ M, m ∣ v → v / m ∈ H) :
    typeIIDirectEndpoint M H A
        (fun h => typeIIRoughConvolution R C σ c (primePoolFreePart P h)) t v =
      invariantTripleEndpoint P
        (fun m => if m ∈ M then A m * typeIIPhase t m else 0)
        (fun p => if p ∈ R then typeIIPhase (-σ) p else 0)
        (fun r => if r ∈ C then conj (c r) else 0) v :=
  (typeII_direct_rough_endpoint_eq_masked_triple P M H R C A c t σ hv hM hfree).trans
    (typeII_masked_triple_eq_invariant_of_complete P M H R C A c t σ hv hHcomplete)


end Bounty
end

section

/- Exact labelled-slot separation for tests of both factors separately. -/

open Finset

namespace Bounty

theorem ordered_slot_twisted_split_bivariate_test {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (take : I → Prop) [DecidablePred take]
    (twist : I → ℕ → ℂ) (F : ℕ → ℕ → ℂ) :
    (∑ x : ∀ i, choices i, (∏ i, twist i (x i).val) *
      F (orderedSlotProduct (fun i : {i // take i} => choices i.val) (fun i => x i.val))
        (orderedSlotProduct (fun i : {i // ¬take i} => choices i.val) (fun i => x i.val))) =
      ∑ e ∈ orderedSlotProductSupport (fun i : {i // take i} => choices i.val),
      ∑ h ∈ orderedSlotProductSupport (fun i : {i // ¬take i} => choices i.val),
        orderedSlotComplexWeight (fun i : {i // take i} => choices i.val)
          (fun i => twist i.val) e *
        orderedSlotComplexWeight (fun i : {i // ¬take i} => choices i.val)
          (fun i => twist i.val) h * F e h := by
  classical
  have htuple :
      (∑ x : ∀ i, choices i, (∏ i, twist i (x i).val) *
        F (orderedSlotProduct (fun i : {i // take i} => choices i.val) (fun i => x i.val))
          (orderedSlotProduct (fun i : {i // ¬take i} => choices i.val) (fun i => x i.val))) =
      ∑ x : ∀ i : {i // take i}, choices i.val,
      ∑ y : ∀ i : {i // ¬take i}, choices i.val,
        (∏ i, twist i.val (x i).val) * (∏ i, twist i.val (y i).val) *
          F (orderedSlotProduct _ x) (orderedSlotProduct _ y) := by
    let f : (∀ i : {i // take i}, choices i.val) ×
        (∀ i : {i // ¬take i}, choices i.val) → ℂ := fun z =>
      (∏ i, twist i.val (z.1 i).val) * (∏ i, twist i.val (z.2 i).val) *
        F (orderedSlotProduct _ z.1) (orderedSlotProduct _ z.2)
    calc
      _ = ∑ z, f z := by
        apply Fintype.sum_equiv (Equiv.piEquivPiSubtypeProd take (fun i => choices i))
        intro x
        simp only [f, Equiv.piEquivPiSubtypeProd_apply]
        rw [Fintype.prod_subtype_mul_prod_subtype take (fun i => twist i (x i).val)]
      _ = _ := Fintype.sum_prod_type f
  rw [htuple]
  symm
  calc
    _ = ∑ e ∈ orderedSlotProductSupport (fun i : {i // take i} => choices i.val),
        orderedSlotComplexWeight (fun i : {i // take i} => choices i.val) (fun i => twist i.val) e *
        ∑ y : ∀ i : {i // ¬take i}, choices i.val,
          (∏ i, twist i.val (y i).val) * F e (orderedSlotProduct _ y) := by
      apply sum_congr rfl
      intro e _
      simp_rw [mul_assoc]
      rw [← mul_sum, ordered_slot_complex_fiber_test]
    _ = _ := by
      rw [ordered_slot_complex_fiber_test]
      apply sum_congr rfl
      intro x _
      rw [mul_sum]
      apply sum_congr rfl
      intro y _
      ring

theorem candidate_slot_twisted_split_bivariate_test (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (F : ℕ → ℕ → ℂ) :
    (∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
      (∏ slot, twist slot (x slot).val) *
        F (candidateAllocatedFactor c L r jStar x take)
          (candidateRetainedFactor c L r jStar 1 x take)) /
        (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ) =
      ∑ e ∈ orderedSlotProductSupport
        (fun slot : CandidateTakenSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
      ∑ h ∈ orderedSlotProductSupport
        (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
        candidateTakenComplexCoefficient c L r jStar take twist e *
          candidateRemainingComplexCoefficient c L r jStar take twist h * F e h := by
  simp only [candidate_allocated_factor_eq_taken_product,
    candidate_retained_factor_eq_remaining_product, one_mul]
  rw [ordered_slot_twisted_split_bivariate_test _
    (fun slot => take ((candidateAllocationOrder c L r).symm slot) = true)]
  simp only [sum_div, candidateTakenComplexCoefficient, candidateRemainingComplexCoefficient]
  apply sum_congr rfl
  intro e _
  apply sum_congr rfl
  intro h _
  ring

end Bounty
end

section

/- Every retained partial Q-product is nonzero and free of the original group primes. -/

open Finset Filter

namespace Bounty

theorem ordered_slot_product_support_free {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (P : Finset ℕ)
    (hnonzero : ∀ i n, n ∈ choices i → n ≠ 0)
    (hfree : ∀ i n, n ∈ choices i → Disjoint n.primeFactors P)
    {n : ℕ} (hn : n ∈ orderedSlotProductSupport choices) :
    n ≠ 0 ∧ Disjoint n.primeFactors P := by
  classical
  obtain ⟨x, hx, rfl⟩ := mem_image.mp hn
  constructor
  · exact prod_ne_zero_iff.mpr (fun i _ => hnonzero i (x i).val (x i).property)
  · apply disjoint_left.mpr
    intro p hp hP
    obtain ⟨hpp, hpdvd, _⟩ := Nat.mem_primeFactors.mp hp
    obtain ⟨i, hi, hpi⟩ :=
      ((Nat.prime_iff.mp hpp).dvd_finsetProd_iff (fun i => (x i).val)).mp hpdvd
    have hmem : p ∈ (x i).val.primeFactors :=
      Nat.mem_primeFactors.mpr ⟨hpp, hpi, hnonzero i _ (x i).property⟩
    exact disjoint_left.mp (hfree i _ (x i).property) hmem hP

theorem eventually_candidate_remaining_support_free {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (r jStar : ℕ)
      (take : Fin ((candidateQIndices c L).card * r) → Bool) (n : ℕ),
      n ∈ orderedSlotProductSupport
        (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val) →
      n ≠ 0 ∧ Disjoint n.primeFactors
        ((candidatePIndices c L).biUnion (candidatePBand (c * L))) := by
  filter_upwards [eventually_candidate_P_pool_below_rough_cutoff hc,
    eventually_ge_atTop (0 : ℝ)] with L hpool hL
  intro r jStar take n hn
  apply ordered_slot_product_support_free _ _ _ _ hn
  · intro slot m hm
    exact candidate_Q_slot_nonzero c L r jStar slot.val hm
  · intro slot m hm
    exact candidate_Q_slot_primeFactors_disjoint (mul_nonneg hc.le hL) hpool slot.val hm

end Bounty

end

section

/- Exact full-event transport when displacements agree and dilation has the same prime divisors. -/

open Finset
open scoped Classical
namespace Bounty
section Full
variable {G : Type*} {P : G → Type*}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : SharedActiveLabels P S → Type*)
  (Δ Δ' D D' : ∀ c, A c → G → ℤ)
  (hΔ : Δ = Δ')
  (hD : ∀ c a g p, ((n g p : ℤ) ∣ D c a g ↔ (n g p : ℤ) ∣ D' c a g))

noncomputable def fullActiveParameterEventEquiv
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullActiveEdgeEvent n S B A Δ D x ≃ FullActiveEdgeEvent n S B A Δ' D' x := by
  subst Δ'
  exact fullActiveDilationEventEquiv n S B A Δ D D' hD x

theorem full_active_parameter_auxiliary
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullActiveEdgeEvent n S B A Δ D x) :
    (fullActiveParameterEventEquiv n S B A Δ Δ' D D' hΔ hD x e).1 = e.1 := by
  subst Δ'
  rfl

theorem full_active_parameter_target
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullActiveEdgeEvent n S B A Δ D x) :
    fullActiveEdgeEventTarget n S B A Δ' D' x
        (fullActiveParameterEventEquiv n S B A Δ Δ' D D' hΔ hD x e) =
      fullActiveEdgeEventTarget n S B A Δ D x e := by
  subst Δ'
  exact full_active_dilation_target n S B A Δ D D' hD x e

theorem full_active_parameter_weight [Fintype G]
    (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullActiveEdgeEvent n S B A Δ D x) :
    fullActiveEdgeEventWeight n S B A Δ' D' ω μ ρ V x
        (fullActiveParameterEventEquiv n S B A Δ Δ' D D' hΔ hD x e) =
      fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e := by
  subst Δ'
  exact full_active_dilation_weight n S B A Δ D D' hD ω μ ρ V x e

end Full
end Bounty
