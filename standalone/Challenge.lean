/- Actual separated candidate coefficients satisfy factorial bounds independently of the allocation target. -/

open Finset

namespace Bounty

section

variable
  (c L : ℝ)
  (r jStar : ℕ)
  (hr : 0 < r)
  (hj : jStar ∈ candidateQIndices c L)
  (take : Fin ((candidateQIndices c L).card*r) → Bool)
  (hkeep : take ((candidateAllocationOrder c L r).symm (candidateRoughSlot c L r jStar hr hj)) = false)

include c L r jStar hr hj take hkeep

theorem candidate_taken_slot_is_pure 
    (slot : CandidateTakenSlot c L r take) :
    slot.val ≠ candidateRoughSlot c L r jStar hr hj := by
  intro heq
  have hs := slot.property
  rw [heq, hkeep] at hs
  exact Bool.false_ne_true hs

theorem candidate_residual_slot_is_pure 
    (slot : {slot : CandidateRemainingSlot c L r take //
      slot ≠ candidateRemainingRoughSlot c L r jStar hr hj take hkeep}) :
    slot.val.val ≠ candidateRoughSlot c L r jStar hr hj := by
  intro heq
  exact slot.property (Subtype.ext heq)

end





section

variable
  {c L : ℝ}
  {r jStar : ℕ}
  (hcL : 0 ≤ c*L)
  (hr : 0 < r)
  (hj : jStar ∈ candidateQIndices c L)
  (take : Fin ((candidateQIndices c L).card*r) → Bool)
  (hkeep : take ((candidateAllocationOrder c L r).symm (candidateRoughSlot c L r jStar hr hj)) = false)
  (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ)
  (htwist : ∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot → ‖twist slot p‖ ≤ 1)

include c L r jStar hcL hr hj take hkeep twist htwist

theorem norm_candidate_taken_coefficient_le_factorial_pow 
    (e : ℕ) :
    ‖candidateTakenComplexCoefficient c L r jStar take twist e‖ ≤
      (r.factorial : ℝ)^(candidateQIndices c L).card := by
  exact norm_candidate_Q_pure_subset_fiber_le_factorial_pow hcL hr hj Subtype.val
    Subtype.val_injective (candidate_taken_slot_is_pure c L r jStar hr hj take hkeep)
    (fun slot => twist slot.val) (fun slot p hp => htwist slot.val p hp) e

theorem norm_candidate_residual_prime_coefficient_le_one 
    (q : ℕ) :
    ‖candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist q‖ ≤ 1 := by
  let I := {slot : CandidateRemainingSlot c L r take //
    slot ≠ candidateRemainingRoughSlot c L r jStar hr hj take hkeep}
  let emb : I → (candidateQIndices c L) × Fin r := fun slot => slot.val.val
  have hemb : Function.Injective emb := by
    intro a b hab
    exact Subtype.ext (Subtype.ext hab)
  unfold candidateResidualPrimeCoefficient orderedSlotComplexWeight
  exact norm_candidate_Q_pure_subset_fiber_normalized_le_one (I := I) hcL hr hj emb hemb
    (candidate_residual_slot_is_pure c L r jStar hr hj take hkeep)
    (fun slot => twist slot.val.val) (fun slot p hp => htwist slot.val.val p hp) q

end


theorem norm_sum_product_eq_le_indicator (S : Finset ℕ) (w : ℕ → ℂ) (z : ℂ)
    (hw : ∀ q ∈ S, ‖w q‖ ≤ 1) (hz : ‖z‖ ≤ 1) {p : ℕ} (hp : 0 < p) (n : ℕ) :
    ‖∑ q ∈ S, if p*q=n then z*w q else 0‖ ≤ if p ∣ n then (1 : ℝ) else 0 := by
  classical
  by_cases hpn : p ∣ n
  · rw [if_pos hpn]
    have heq (q : ℕ) : p*q=n ↔ q=n/p := by
      constructor
      · intro h
        exact (Nat.div_eq_of_eq_mul_right hp h.symm).symm
      · intro h
        rw [h, Nat.mul_div_cancel' hpn]
    simp only [heq]
    rw [sum_ite_eq']
    by_cases hq : n/p ∈ S
    · rw [if_pos hq, norm_mul]
      exact (mul_le_mul hz (hw _ hq) (norm_nonneg _) (by norm_num)).trans_eq (mul_one 1)
    · rw [if_neg hq, norm_zero]
      norm_num
  · rw [if_neg hpn]
    have hzero : ∀ q ∈ S, ¬p*q=n := by
      intro q _ h
      exact hpn ⟨q, h.symm⟩
    simp only [sum_eq_zero (fun q hq => if_neg (hzero q hq)), norm_zero, le_refl]

theorem norm_candidate_remaining_coefficient_le_rough_divisors {c L : ℝ} {r jStar : ℕ}
    (hcL : 0 ≤ c*L) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ)
    (htwist : ∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot → ‖twist slot p‖ ≤ 1)
    (h : ℕ) :
    ‖candidateRemainingComplexCoefficient c L r jStar take twist h‖ ≤
      (((candidateRoughBand c L jStar).filter (fun p => p ∣ h)).card : ℝ) := by
  classical
  rw [candidate_remaining_rough_convolution c L r jStar hr hj take hkeep]
  apply (norm_sum_le _ _).trans
  calc
    _ ≤ ∑ p : candidateRoughBand c L jStar, if p.val ∣ h then (1 : ℝ) else 0 := by
      apply sum_le_sum
      intro p _
      apply norm_sum_product_eq_le_indicator
      · intro q _
        exact norm_candidate_residual_prime_coefficient_le_one hcL hr hj take hkeep twist htwist q
      · apply htwist
        simpa only [candidateQSlotChoices, candidateRoughSlot, and_self, if_true] using p.property
      · exact roughBand_pos p.property
    _ = _ := by
      rw [sum_coe_sort (candidateRoughBand c L jStar) (fun p => if p ∣ h then (1 : ℝ) else 0)]
      simp only [sum_boole]


end Bounty
