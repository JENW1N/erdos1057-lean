open Finset
def physicalGroupPhaseActivity {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (L : PhysicalMarkLists P J ell) (g : G) (p : ↥(P g)) : Bool :=
  decide (p.val ∈ physicalGroupMarks L g)

def physicalGroupPhaseDelta {G : Type*} {P : G → Finset ℕ}
    (n m : ℤ) (g : G) (p : ↥(P g)) : ZMod p.val :=
  ((n - m : ℤ) : ZMod p.val)

theorem physical_group_phase_activity_iff {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (L : PhysicalMarkLists P J ell) (g : G) (p : ↥(P g)) :
    physicalGroupPhaseActivity L g p = true ↔ p.val ∈ physicalGroupMarks L g := by
  simp [physicalGroupPhaseActivity]

theorem physical_group_phase_activity_support_mem {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (L : PhysicalMarkLists P J ell) (g : G) (p : ↥(P g)) :
    p ∈ ghostPhaseActivitySupport (physicalGroupPhaseActivity L g) ↔
      p.val ∈ physicalGroupMarks L g := by
  simp [ghostPhaseActivitySupport, physicalGroupPhaseActivity]

theorem physical_group_phase_activity_support_eq_image {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ} (L : PhysicalMarkLists P J ell) (g : G) :
    ghostPhaseActivitySupport (physicalGroupPhaseActivity L g) = univ.image (L g) := by
  ext p
  rw [physical_group_phase_activity_support_mem, mem_physical_group_marks]
  simp only [mem_image, mem_univ, true_and]
  constructor
  · rintro ⟨s, hs⟩
    exact ⟨s, Subtype.ext hs⟩
  · rintro ⟨s, hs⟩
    exact ⟨s, congrArg Subtype.val hs⟩







section

variable
  {G : Type*}
  {P : G → Finset ℕ}

include G P

theorem physical_group_phase_delta_eq_neg_step 
    (n m : ℤ) (g : G) (p : ↥(P g)) :
    physicalGroupPhaseDelta n m g p = -((m - n : ℤ) : ZMod p.val) := by
  simp [physicalGroupPhaseDelta]

theorem physical_group_phase_delta_eq_hit_difference  (n m : ℤ) (g : G) (p : ↥(P g)) :
    physicalGroupPhaseDelta n m g p = -(m : ZMod p.val) - (-(n : ZMod p.val)) := by
  simp [physicalGroupPhaseDelta, sub_eq_add_neg, add_comm]

theorem physical_group_phase_delta_zero_of_dvd 
    (n m : ℤ) (g : G) (p : ↥(P g)) (hd : (p.val : ℤ) ∣ m - n) :
    physicalGroupPhaseDelta n m g p = 0 := by
  rw [physical_group_phase_delta_eq_neg_step,
    (ZMod.intCast_zmod_eq_zero_iff_dvd (m - n) p.val).mpr hd, neg_zero]

/- Bare lists need only divisibility of the displacement by every common mark. -/
theorem physical_group_phase_shared_delta_zero_of_common_marks  {J ell : ℕ} (L R : PhysicalMarkLists P J ell)
    (n m : ℤ) (g : G)
    (hcommon : ∀ s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ m - n)
    (p : ↥(P g))
    (hp : physicalGroupPhaseActivity R g p = true ∧
      physicalGroupPhaseActivity L g p = true) :
    physicalGroupPhaseDelta n m g p = 0 := by
  obtain ⟨s, hs⟩ := (mem_physical_group_marks L g p.val).mp
    ((physical_group_phase_activity_iff L g p).mp hp.2)
  obtain ⟨t, ht⟩ := (mem_physical_group_marks R g p.val).mp
    ((physical_group_phase_activity_iff R g p).mp hp.1)
  apply physical_group_phase_delta_zero_of_dvd
  simpa only [hs] using hcommon s t (hs.trans ht.symm)







end




