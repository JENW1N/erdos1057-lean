def diagonalPrimitiveMap (u:(_root_.OAI.ActualEisensteinCubic.O)ˣ) (v:PrimitiveRow) : PrimitiveRow :=
  ⟨![(u:(_root_.OAI.ActualEisensteinCubic.O))^2*v.val 0,v.val 1],by
    refine ⟨?_,?_,v.2.2.2⟩
    · exact (isCoprime_mul_unit_left_left (u.isUnit.pow 2) _ _).mpr v.2.1
    · exact v.2.2.1.mul_left _⟩

def diagonalPrimitiveEquiv (u:(_root_.OAI.ActualEisensteinCubic.O)ˣ) : PrimitiveRow≃PrimitiveRow where
  toFun:=diagonalPrimitiveMap u
  invFun:=diagonalPrimitiveMap u⁻¹
  left_inv v:=by
    apply Subtype.ext
    funext i
    fin_cases i
    · change (↑u⁻¹:(_root_.OAI.ActualEisensteinCubic.O))^2*((u:(_root_.OAI.ActualEisensteinCubic.O))^2*v.val 0)=v.val 0
      rw [←mul_assoc,←mul_pow]
      simp
    · rfl
  right_inv v:=by
    apply Subtype.ext
    funext i
    fin_cases i
    · change (u:(_root_.OAI.ActualEisensteinCubic.O))^2*((↑u⁻¹:(_root_.OAI.ActualEisensteinCubic.O))^2*v.val 0)=v.val 0
      rw [←mul_assoc,←mul_pow]
      simp
    · rfl

lemma rowOperator_unitCuspDiagonal (u:(_root_.OAI.ActualEisensteinCubic.O)ˣ) (v:PrimitiveRow) :
    rowOperator (integralComplexMatrix (unitCuspDiagonal u))
      (embeddedRow (primitiveRowEquiv.symm v))=
      eisEmbedding (↑u⁻¹:(_root_.OAI.ActualEisensteinCubic.O)) •
        embeddedRow (primitiveRowEquiv.symm (diagonalPrimitiveEquiv u v)) := by
  simp only [embeddedRow, Function.comp_def, primitiveRowEquiv_symm_row]
  rw [rowOperator_apply]
  funext i
  simp only [Matrix.vecMul, dotProduct, Fin.sum_univ_two,
    integralComplexMatrix_apply, Pi.smul_apply, smul_eq_mul]
  fin_cases i
  · change eisEmbedding (v.val 0) * eisEmbedding (u : (_root_.OAI.ActualEisensteinCubic.O)) +
      eisEmbedding (v.val 1) * eisEmbedding (0 : (_root_.OAI.ActualEisensteinCubic.O)) =
      eisEmbedding (↑u⁻¹ : (_root_.OAI.ActualEisensteinCubic.O)) * eisEmbedding ((u : (_root_.OAI.ActualEisensteinCubic.O)) ^ 2 * v.val 0)
    simp only [map_zero, mul_zero, add_zero, map_mul, pow_two]
    have hu : eisEmbedding (↑u⁻¹ : (_root_.OAI.ActualEisensteinCubic.O)) * eisEmbedding (u : (_root_.OAI.ActualEisensteinCubic.O)) = 1 := by
      rw [← map_mul]
      simp
    calc
      _ = (eisEmbedding (↑u⁻¹ : (_root_.OAI.ActualEisensteinCubic.O)) * eisEmbedding (u : (_root_.OAI.ActualEisensteinCubic.O))) *
          (eisEmbedding (v.val 0) * eisEmbedding (u : (_root_.OAI.ActualEisensteinCubic.O))) := by rw [hu, one_mul]
      _ = _ := by ring
  · change eisEmbedding (v.val 0) * eisEmbedding (0 : (_root_.OAI.ActualEisensteinCubic.O)) +
      eisEmbedding (v.val 1) * eisEmbedding (↑u⁻¹ : (_root_.OAI.ActualEisensteinCubic.O)) =
      eisEmbedding (↑u⁻¹ : (_root_.OAI.ActualEisensteinCubic.O)) * eisEmbedding (v.val 1)
    simp [mul_comm]

lemma rowEnergy_unit_smul (u:(_root_.OAI.ActualEisensteinCubic.O)ˣ) (v:Fin 2→ℂ) :
    rowEnergy (eisEmbedding (u:(_root_.OAI.ActualEisensteinCubic.O)) • v)=rowEnergy v := by
  simp only [rowEnergy,Pi.smul_apply,smul_eq_mul,norm_mul,
    GaussGeneratorTransport.norm_eisEmbedding_unit,one_mul]

lemma diagonal_ray_summand (u:(_root_.OAI.ActualEisensteinCubic.O)ˣ) (g:SL(2,ℂ)) (s:ℂ) (v:PrimitiveRow) :
    summand (integralComplexMatrix (unitCuspDiagonal u)*g) s (primitiveRowEquiv.symm v)=
      eisEmbedding (symbol ((↑u⁻¹:(_root_.OAI.ActualEisensteinCubic.O))^2) (v.val 1))*
        summand g s (primitiveRowEquiv.symm (diagonalPrimitiveEquiv u v)) := by
  have hphase : (cosetCharacter (primitiveRowEquiv.symm v))⁻¹=
      eisEmbedding (symbol ((↑u⁻¹:(_root_.OAI.ActualEisensteinCubic.O))^2) (v.val 1))*
        (cosetCharacter (primitiveRowEquiv.symm (diagonalPrimitiveEquiv u v)))⁻¹ := by
    simp only [inverse_cosetCharacter_eq_row_symbol,primitiveRowEquiv_symm_row]
    change eisEmbedding (symbol (v.val 0) (v.val 1))=
      eisEmbedding (symbol ((↑u⁻¹:(_root_.OAI.ActualEisensteinCubic.O))^2) (v.val 1))*
        eisEmbedding (symbol ((u:(_root_.OAI.ActualEisensteinCubic.O))^2*v.val 0) (v.val 1))
    rw [←map_mul,←symbol_mul_numerator _ _ _ (lambda_sq_dvd_three.trans v.2.2.2)]
    congr 2
    rw [←mul_assoc,←mul_pow]
    simp
  rw [summand,←rowOperator_mul,rowOperator_unitCuspDiagonal,map_smul,rowEnergy_unit_smul,hphase,
    summand]
  ring







end

