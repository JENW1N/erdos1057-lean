/- The pointwise prime and character data sufficient for the counting argument.
This proposition is an input contract, not an assumed theorem. -/
def PowerPrimeReservoirAt (β δ σ y : ℝ) : Prop :=
  ∃ (L : ℕ) (S P : Finset ℕ) (g : ℕ → (ZMod L)ˣ),
    0 < L ∧ P ⊆ S ∧
    (∀ p ∈ S, p.Prime) ∧ (∀ p ∈ S, (p : ℝ) ≤ 5 * y) ∧
    (∀ p ∈ P, p - 1 ∣ L) ∧
    (∀ p ∈ P, (g p : ZMod L) = (p : ZMod L)) ∧
    y ^ (1 - σ) ≤ (P.card : ℝ) ∧
    Real.log (Nat.card ((ZMod L)ˣ) : ℝ) ≤ y ^ (δ + σ) ∧
    (Nat.log 2 (Nat.card ((ZMod L)ˣ)) : ℝ) ≤ y ^ (δ + σ) ∧
    ∀ ξ : (ZMod L)ˣ →* ℂ, ξ ≠ 1 →
      ‖∑ p ∈ S, ξ (g p)‖ ≤ y ^ (β + 2 * δ + σ)













theorem asymptotic_density_parameters_at {β ε : ℝ} (hβ : β < 1) (hε : 0 < ε) :
    ∃ δ η ν σ : ℝ,
      0 < δ ∧ δ < 1 / 16 ∧ 0 < σ ∧ 0 < ν ∧ ν < 1 ∧
      2 * δ + 4 * σ < η ∧ η < 1 - σ ∧
      β + 2 * δ + 2 * σ < 1 ∧
      1 - ε < ((1 - ν) / (1 + ν)) * (1 - η - 2 * σ) := by
  let e : ℝ := min (min (ε / 16) ((1 - β) / 16)) (1 / 32)
  have he0 : 0 < e := lt_min (lt_min (by linarith) (by linarith)) (by norm_num)
  have heε : e ≤ ε / 16 := (min_le_left _ _).trans (min_le_left _ _)
  have heβ : e ≤ (1 - β) / 16 := (min_le_left _ _).trans (min_le_right _ _)
  have he1 : e ≤ 1 / 32 := min_le_right _ _
  refine ⟨e / 8, e, e, e / 16, by linarith, by linarith,
    by linarith, he0, by linarith, by linarith, by linarith, by linarith, ?_⟩
  rw [div_mul_eq_mul_div]
  apply (lt_div_iff₀ (by linarith : 0 < 1 + e)).mpr
  nlinarith











/- At fixed separated exponents, the finite construction supplies the entropy lower bound. -/
theorem eventually_entropy_bound_of_power_reservoir_at {β δ η ν σ : ℝ}
    (hδ : 0 < δ) (hσ : 0 < σ) (hν0 : 0 < ν) (hν1 : ν < 1)
    (hgap : 2 * δ + 4 * σ < η) (hησ : η < 1 - σ)
    (herror : β + 2 * δ + 2 * σ < 1)
    (hsupply : ∀ᶠ y in atTop, PowerPrimeReservoirAt β δ σ y) :
    ∀ᶠ y in atTop, ∃ n : ℕ,
      y ^ (1 - 2 * σ) ≤ (n : ℝ) ∧
      Real.exp (-y ^ (δ + σ)) / 2 * ((n : ℝ) / y ^ η) ^ ⌊(1 - ν) * y ^ η⌋₊ ≤
        Erdos1057.carmichaelCounting (carmichaelSizeParameter η ν y) := by
  have hη : 0 < η := by linarith
  have hpower : 0 < 1 - σ := by linarith
  have hsmall := eventually_mul_rpow_add_le_mul_rpow
    (a := β + 2 * δ + σ) (b := 1 - σ) hpower
    (by linarith) (by norm_num : (0 : ℝ) < 1) 64 0
  have hfeasible := eventually_finite_sampling_feasible
    (d := δ + σ) (r := σ) (η := η) (σ := σ) (ν := ν) (K := 325)
    (by linarith) hσ.le (by linarith) hησ hν0 hν1
  have htwopower := eventually_const_le_mul_rpow (η := σ) hσ
    (by norm_num : (0 : ℝ) < 1) 2
  filter_upwards [hsupply, hsmall, hfeasible, htwopower,
    eventually_ge_atTop (1 : ℝ)] with y hs hyA hyF hyσ hy1
  have hy0 : 0 < y := lt_of_lt_of_le zero_lt_one hy1
  obtain ⟨L, S, P, g, hLpos, hPS, hprime, hbound, hL, hcompat,
    hN, hlogU, hlogD, hamb⟩ := hs
  let : NeZero L := ⟨hLpos.ne'⟩
  have hNpos : 0 < (P.card : ℝ) :=
    lt_of_lt_of_le (Real.rpow_pos_of_pos hy0 _) hN
  have hNQ : (P.card : ℝ) ≤ S.card := by exact_mod_cast Finset.card_le_card hPS
  have hQbound : (S.card : ℝ) ≤ 5 * y := prime_interval_card_le hy0.le hprime hbound
  have hA : 0 ≤ y ^ (β + 2 * δ + σ) := Real.rpow_nonneg hy0.le _
  have hAN : 64 * y ^ (β + 2 * δ + σ) ≤ P.card := by
    have hAy : 64 * y ^ (β + 2 * δ + σ) ≤ y ^ (1 - σ) := by
      simpa only [add_zero, one_mul] using hyA
    exact hAy.trans hN
  obtain ⟨R, hR, hRlarge, hRsmall, hRbound⟩ := fejer_length_parameters hNpos hNQ hA hAN
  have hRpow : (R : ℝ) ≤ 325 * y ^ σ := by
    calc
      (R : ℝ) ≤ 65 * (S.card : ℝ) / P.card := hRbound
      _ ≤ 65 * (5 * y) / P.card := by gcongr
      _ ≤ 65 * (5 * y) / y ^ (1 - σ) :=
        div_le_div_of_nonneg_left (by positivity) (Real.rpow_pos_of_pos hy0 _) hN
      _ = 325 * (y / y ^ (1 - σ)) := by ring
      _ = 325 * y ^ σ := by
        congr 1
        calc
          y / y ^ (1 - σ) = y ^ (1 : ℝ) / y ^ (1 - σ) := by rw [Real.rpow_one]
          _ = y ^ ((1 : ℝ) - (1 - σ)) := (Real.rpow_sub hy0 1 (1 - σ)).symm
          _ = y ^ σ := by congr 1; ring
  have hD : 1 ≤ y ^ (δ + σ) := Real.one_le_rpow hy1 (by linarith)
  obtain ⟨n, hnlow, hnhigh, hncount⟩ := finite_carmichael_counting_bound
    S P hPS g (fun p hp => hprime p (hPS hp)) hL hcompat
    (by linarith : 1 ≤ 5 * y) (fun p hp => hbound p (hPS hp)) hD hlogD hlogU
    hR hRlarge hRsmall hamb
  have hnnew : y ^ (1 - 2 * σ) ≤ (n : ℝ) := by
    have htwo : 2 ≤ y ^ σ := by simpa only [one_mul] using hyσ
    have hmul := mul_le_mul_of_nonneg_left htwo
      (Real.rpow_nonneg hy0.le (1 - 2 * σ))
    have heq : y ^ (1 - 2 * σ) * y ^ σ = y ^ (1 - σ) := by
      rw [← Real.rpow_add hy0]
      congr 1
      ring
    rw [heq] at hmul
    linarith
  refine ⟨n, hnnew, ?_⟩
  obtain ⟨hfourier, htail, hsampling, hsize⟩ := hyF
  have ht : 0 < y ^ η := Real.rpow_pos_of_pos hy0 _
  have htn : 2 * y ^ η ≤ (n : ℝ) := by linarith
  have hk : (⌊(1 - ν) * y ^ η⌋₊ : ℝ) ≤ (1 - ν) * y ^ η :=
    Nat.floor_le (by positivity)
  exact hncount (y ^ η) ν ⌊(1 - ν) * y ^ η⌋₊ ht htn hν0.le hν1.le hsize hk
    (hfourier R (by exact_mod_cast hR) hRpow) htail

/- The analytic reservoir contract for every fixed pair of small exponents is
sufficient for the exact Erdős 1057 target. This theorem does not assert that contract. -/
theorem target_of_power_prime_reservoirs_at {β : ℝ} (hβ : β < 1)
    (hsupply : ∀ δ : ℝ, 0 < δ → δ < 1 / 16 → ∀ σ : ℝ, 0 < σ →
      ∀ᶠ y in atTop, PowerPrimeReservoirAt β δ σ y) :
    fcTypeOfName% "Erdos1057.erdos_1057" := by
  classical
  apply target_of_lower_bound
  intro ε hε
  obtain ⟨δ, η, ν, σ, hδ, hδ16, hσ, hν0, hν1, hgap, hησ, herror, hmargin⟩ :=
    asymptotic_density_parameters_at hβ hε
  have hη : 0 < η := by linarith
  have hfinite := eventually_entropy_bound_of_power_reservoir_at hδ hσ hν0 hν1
    hgap hησ herror (hsupply δ hδ hδ16 σ hσ)
  let W : ℝ → ℕ → Prop := fun y n =>
    y ^ (1 - 2 * σ) ≤ (n : ℝ) ∧
      Real.exp (-y ^ (δ + σ)) / 2 * ((n : ℝ) / y ^ η) ^ ⌊(1 - ν) * y ^ η⌋₊ ≤
        Erdos1057.carmichaelCounting (carmichaelSizeParameter η ν y)
  have hW : ∀ᶠ y in atTop, ∃ n : ℕ, W y n := hfinite
  let n : ℝ → ℕ := fun y => Classical.epsilon (W y)
  have hn : ∀ᶠ y in atTop, W y (n y) :=
    hW.mono (fun y hy => Classical.epsilon_spec hy)
  apply eventual_carmichael_power_lower_of_exp_entropy (σ := 2 * σ)
    hη hν0.le hν1.le hmargin (fun y => (n y : ℝ)) (fun y => y ^ (δ + σ))
  · exact hn.mono (fun y hy => hy.1)
  · exact tendsto_rpow_div_rpow_log (by linarith)
  · exact hn.mono (fun y hy => hy.2)




end

section

open Complex Finset ArithmeticFunction
open scoped BigOperators

noncomputable def mangoldtTwist {q : ℕ} (χ : DirichletCharacter ℂ q) (n : ℕ) : ℂ :=
  χ (n : ZMod q) * (ArithmeticFunction.vonMangoldt n : ℂ)

noncomputable def smoothedTwistedPsi {q : ℕ} (χ : DirichletCharacter ℂ q) (x : ℝ) : ℂ :=
  ∑ n ∈ Icc 1 ⌊x⌋₊, mangoldtTwist χ n * ((1 - (n : ℝ) / x : ℝ) : ℂ)


open Complex Finset ArithmeticFunction
open scoped BigOperators

lemma riesz_smoothed_scale {q : ℕ} (χ : DirichletCharacter ℂ q) {x : ℝ} (hx : x ≠ 0) :
    (x : ℂ) * smoothedTwistedPsi χ x =
      ∑ n ∈ Icc 1 ⌊x⌋₊, mangoldtTwist χ n * ((x - (n : ℝ) : ℝ) : ℂ) := by
  rw [smoothedTwistedPsi, mul_sum]
  apply sum_congr rfl
  intro n hn
  have hxc : (x : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hx
  push_cast
  field_simp

lemma riesz_smoothed_difference {q : ℕ} (χ : DirichletCharacter ℂ q) {x : ℝ}
    (hx : 0 < x) (m : ℕ) :
    (((x + m : ℝ) : ℂ) * smoothedTwistedPsi χ (x + m) -
      (x : ℂ) * smoothedTwistedPsi χ x) =
      (m : ℂ) * (∑ n ∈ Icc 1 ⌊x⌋₊, mangoldtTwist χ n) +
        ∑ n ∈ Icc (⌊x⌋₊ + 1) (⌊x⌋₊ + m),
          mangoldtTwist χ n * ((x + m - (n : ℝ) : ℝ) : ℂ) := by
  rw [riesz_smoothed_scale χ (by positivity), riesz_smoothed_scale χ hx.ne',
    Nat.floor_add_natCast hx.le]
  have hsplit (f : ℕ → ℂ) :
      (∑ n ∈ Icc 1 (⌊x⌋₊ + m), f n) =
      (∑ n ∈ Icc 1 ⌊x⌋₊, f n) + (∑ n ∈ Icc (⌊x⌋₊ + 1) (⌊x⌋₊ + m), f n) := by
    simpa only [Ico_add_one_right_eq_Icc] using
      (sum_Ico_consecutive f (by omega : 1 ≤ ⌊x⌋₊ + 1)
        (by omega : ⌊x⌋₊ + 1 ≤ (⌊x⌋₊ + m) + 1)).symm
  rw [hsplit]
  have hmain :
      (∑ n ∈ Icc 1 ⌊x⌋₊,
        mangoldtTwist χ n * ((x + m - (n : ℝ) : ℝ) : ℂ)) -
      (∑ n ∈ Icc 1 ⌊x⌋₊,
        mangoldtTwist χ n * ((x - (n : ℝ) : ℝ) : ℂ)) =
      (m : ℂ) * (∑ n ∈ Icc 1 ⌊x⌋₊, mangoldtTwist χ n) := by
    rw [← sum_sub_distrib, mul_sum]
    apply sum_congr rfl
    intro n hn
    push_cast
    ring
  linear_combination hmain

lemma riesz_mangoldt_norm_le_log {q : ℕ} (χ : DirichletCharacter ℂ q) (n : ℕ) : ‖mangoldtTwist χ n‖ ≤ Real.log (n : ℝ) := by
  unfold mangoldtTwist
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg vonMangoldt_nonneg]
  exact (mul_le_mul_of_nonneg_right (χ.norm_le_one _) vonMangoldt_nonneg).trans
    (by simpa using (vonMangoldt_le_log (n := n)))

lemma riesz_smoothed_remainder {q : ℕ} (χ : DirichletCharacter ℂ q) {x : ℝ}
    (hx : 0 < x) (m : ℕ) :
    ‖∑ n ∈ Icc (⌊x⌋₊ + 1) (⌊x⌋₊ + m),
      mangoldtTwist χ n * ((x + m - (n : ℝ) : ℝ) : ℂ)‖ ≤
        (m : ℝ) ^ 2 * Real.log (x + m) := by
  have hy : 0 < x + (m : ℝ) := by positivity
  have hpoint (n : ℕ) (hn : n ∈ Icc (⌊x⌋₊ + 1) (⌊x⌋₊ + m)) :
      ‖mangoldtTwist χ n * ((x + m - (n : ℝ) : ℝ) : ℂ)‖ ≤
        Real.log (x + m) * m := by
    obtain ⟨hnlo, hnhi⟩ := mem_Icc.mp hn
    have hn1 : 1 ≤ n := by omega
    have hnx : x < (n : ℝ) := (Nat.lt_floor_add_one x).trans_le (by exact_mod_cast hnlo)
    have hny : (n : ℝ) ≤ x + m := by
      have hb := Nat.floor_le hx.le
      have hc : (n : ℝ) ≤ (⌊x⌋₊ : ℝ) + m := by exact_mod_cast hnhi
      linarith
    have hwt : 0 ≤ x + m - (n : ℝ) := by linarith
    have hwtm : x + m - (n : ℝ) ≤ (m : ℝ) := by linarith
    have hlog : ‖mangoldtTwist χ n‖ ≤ Real.log (x + m) :=
      (riesz_mangoldt_norm_le_log χ n).trans
        (Real.log_le_log (by exact_mod_cast (show 0 < n by omega)) hny)
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hwt]
    exact mul_le_mul hlog hwtm hwt (le_trans (norm_nonneg _) hlog)
  have hc : (Icc (⌊x⌋₊ + 1) (⌊x⌋₊ + m)).card = m := by
    rw [Nat.card_Icc]
    omega
  calc
    _ ≤ ∑ n ∈ Icc (⌊x⌋₊ + 1) (⌊x⌋₊ + m),
        ‖mangoldtTwist χ n * ((x + m - (n : ℝ) : ℝ) : ℂ)‖ := norm_sum_le _ _
    _ ≤ ∑ _n ∈ Icc (⌊x⌋₊ + 1) (⌊x⌋₊ + m), Real.log (x + m) * m :=
      sum_le_sum hpoint
    _ = _ := by rw [sum_const, hc, nsmul_eq_mul]; ring

lemma riesz_twistedPsi_sum {q : ℕ} (χ : DirichletCharacter ℂ q) (x : ℝ) :
    twistedPsi χ x = ∑ n ∈ Icc 1 ⌊x⌋₊, mangoldtTwist χ n := by
  have he : Ioc 0 ⌊x⌋₊ = Icc 1 ⌊x⌋₊ := by
    ext n
    simp only [mem_Ioc, mem_Icc]
    omega
  simp [twistedPsi, mangoldtTwist, he, mul_comm]

/- A completely finite unsmoothing inequality, with the short-interval
cost bounded only by the elementary Mangoldt estimate Λ(n)≤log n. -/
theorem riesz_unsmoothing_bound {q : ℕ} (χ : DirichletCharacter ℂ q) {x : ℝ}
    (hx : 0 < x) {m : ℕ} (hm : 0 < m) :
    ‖twistedPsi χ x‖ ≤
      ((x + m) * ‖smoothedTwistedPsi χ (x + m)‖ +
        x * ‖smoothedTwistedPsi χ x‖ + (m : ℝ) ^ 2 * Real.log (x + m)) / m := by
  have hmp : 0 < (m : ℝ) := by exact_mod_cast hm
  have he := riesz_smoothed_difference χ hx m
  have halg : (m : ℂ) * (∑ n ∈ Icc 1 ⌊x⌋₊, mangoldtTwist χ n) =
      (((x + m : ℝ) : ℂ) * smoothedTwistedPsi χ (x + m) -
        (x : ℂ) * smoothedTwistedPsi χ x) -
      ∑ n ∈ Icc (⌊x⌋₊ + 1) (⌊x⌋₊ + m),
        mangoldtTwist χ n * ((x + m - (n : ℝ) : ℝ) : ℂ) := by
    linear_combination -he
  rw [riesz_twistedPsi_sum]
  apply (le_div_iff₀ hmp).mpr
  calc
    _ = ‖(m : ℂ) * (∑ n ∈ Icc 1 ⌊x⌋₊, mangoldtTwist χ n)‖ := by
      rw [norm_mul, Complex.norm_natCast]
      ring
    _ ≤ ‖((x + m : ℝ) : ℂ) * smoothedTwistedPsi χ (x + m) -
        (x : ℂ) * smoothedTwistedPsi χ x‖ +
      ‖∑ n ∈ Icc (⌊x⌋₊ + 1) (⌊x⌋₊ + m),
        mangoldtTwist χ n * ((x + m - (n : ℝ) : ℝ) : ℂ)‖ := by
      rw [halg]
      exact norm_sub_le _ _
    _ ≤ (‖((x + m : ℝ) : ℂ) * smoothedTwistedPsi χ (x + m)‖ +
        ‖(x : ℂ) * smoothedTwistedPsi χ x‖) + (m : ℝ) ^ 2 * Real.log (x + m) :=
      add_le_add (norm_sub_le _ _) (riesz_smoothed_remainder χ hx m)
    _ = _ := by
      rw [norm_mul, norm_mul, Complex.norm_real, Complex.norm_real,
        Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos hx,
        abs_of_pos (by positivity : 0 < x + (m : ℝ))]
end

