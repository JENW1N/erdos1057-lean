theorem poolMaximal (I Q Q0:Ideal (_root_.OAI.ActualEisensteinCubic.O)) (P:pool I Q Q0) : P.val.IsMaximal :=
  pool_maximal I Q Q0 P
noncomputable abbrev poolField (I Q Q0:Ideal (_root_.OAI.ActualEisensteinCubic.O)) (P:pool I Q Q0) : Field ((_root_.OAI.ActualEisensteinCubic.O)⧸P.val) :=
