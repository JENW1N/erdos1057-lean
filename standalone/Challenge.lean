section

/- Centered finite Riesz unsmoothing, including the principal character. -/

open Complex Finset MeasureTheory OAI.Ostmann
open scoped Topology

namespace Bounty

theorem riesz_centered_unsmoothing_bound {q : ℕ} (χ : DirichletCharacter ℂ q) {x : ℝ}
    (hx : 0 < x) {m : ℕ} (hm : 0 < m) :
    ‖twistedPsi χ x - (x : ℂ)‖ ≤
      ((x + m) * ‖smoothedTwistedPsi χ (x + m) - ((x + m : ℝ) : ℂ) / 2‖ +
        x * ‖smoothedTwistedPsi χ x - (x : ℂ) / 2‖ +
        (m : ℝ) ^ 2 * (Real.log (x + m) + 1 / 2)) / m := by
  have hmp : 0 < (m : ℝ) := by exact_mod_cast hm
  let R : ℂ := ∑ n ∈ Icc (⌊x⌋₊ + 1) (⌊x⌋₊ + m),
    mangoldtTwist χ n * ((x + m - (n : ℝ) : ℝ) : ℂ)
  have he := riesz_smoothed_difference χ hx m
  rw [← riesz_twistedPsi_sum] at he
  have halg : (m : ℂ) * (twistedPsi χ x - (x : ℂ)) =
      (((x + m : ℝ) : ℂ) * (smoothedTwistedPsi χ (x + m) - ((x + m : ℝ) : ℂ) / 2) -
        (x : ℂ) * (smoothedTwistedPsi χ x - (x : ℂ) / 2) - R) + (m : ℂ) ^ 2 / 2 := by
    dsimp only [R]
    push_cast at *
    linear_combination -he
  have hR : ‖R‖ ≤ (m : ℝ)^2 * Real.log (x + m) := riesz_smoothed_remainder χ hx m
  apply (le_div_iff₀ hmp).mpr
  calc
    _ = ‖(m : ℂ) * (twistedPsi χ x - (x : ℂ))‖ := by rw [norm_mul, Complex.norm_natCast]; ring
    _ ≤ ‖((x + m : ℝ) : ℂ) * (smoothedTwistedPsi χ (x + m) - ((x + m : ℝ) : ℂ) / 2) -
        (x : ℂ) * (smoothedTwistedPsi χ x - (x : ℂ) / 2) - R‖ + ‖(m : ℂ)^2 / 2‖ := by
      rw [halg]
      exact norm_add_le _ _
    _ ≤ (‖((x + m : ℝ) : ℂ) * (smoothedTwistedPsi χ (x + m) - ((x + m : ℝ) : ℂ) / 2)‖ +
        ‖(x : ℂ) * (smoothedTwistedPsi χ x - (x : ℂ) / 2)‖ + ‖R‖) + ‖(m : ℂ)^2 / 2‖ := by
      refine add_le_add ?_ le_rfl
      exact (norm_sub_le _ R).trans (add_le_add (norm_sub_le _ _) le_rfl)
    _ ≤ ((x + m) * ‖smoothedTwistedPsi χ (x + m) - ((x + m : ℝ) : ℂ) / 2‖ +
        x * ‖smoothedTwistedPsi χ x - (x : ℂ) / 2‖ + (m : ℝ)^2 * Real.log (x + m)) + (m : ℝ)^2 / 2 := by
      simp only [norm_mul, norm_real, Real.norm_eq_abs, abs_of_pos hx,
        abs_of_pos (by positivity : 0 < x + (m : ℝ)), norm_div, norm_pow, Complex.norm_natCast]
      norm_num
      exact hR
    _ = _ := by ring

theorem principal_twistedPsi (x : ℝ) :
    twistedPsi (1 : DirichletCharacter ℂ 1) x = (Chebyshev.psi x : ℂ) := by
  have hc (n : ℕ) : (1 : DirichletCharacter ℂ 1) (n : ZMod 1) = 1 := by
    rw [Subsingleton.elim (n : ZMod 1) 1, map_one]
  simp [twistedPsi, Chebyshev.psi, hc]

theorem principal_smoothedTwistedPsi {x : ℝ} (hx : 0 < x) :
    smoothedTwistedPsi (1 : DirichletCharacter ℂ 1) x = ordinaryRieszMean x := by
  classical
  have hc (n : ℕ) : (1 : DirichletCharacter ℂ 1) (n : ZMod 1) = 1 := by
    rw [Subsingleton.elim (n : ZMod 1) 1, map_one]
  have hs (n : ℕ) (hn : n ∉ Icc 1 ⌊x⌋₊) :
      (ArithmeticFunction.vonMangoldt n : ℂ) * rieszPrimeTest (n / x) = 0 := by
    by_cases hn0 : n = 0
    · subst n
      simp
    · have hlarge : ⌊x⌋₊ < n := by simp only [mem_Icc] at hn; omega
      have hnlarge : x < n := Nat.lt_of_floor_lt hlarge
      have hdiv : 1 < (n : ℝ) / x := (one_lt_div hx).mpr hnlarge
      simp [rieszPrimeTest, max_eq_right (by linarith : 1 - (n : ℝ) / x ≤ 0)]
  rw [ordinaryRieszMean, tsum_eq_sum hs]
  unfold smoothedTwistedPsi
  apply sum_congr rfl
  intro n hn
  have hnle : (n : ℝ) ≤ x := (Nat.le_floor_iff hx.le).mp (mem_Icc.mp hn).2
  have hdiv : (n : ℝ) / x ≤ 1 := (div_le_one hx).mpr hnle
  simp [mangoldtTwist, hc, rieszPrimeTest, max_eq_left (by linarith : 0 ≤ 1 - (n : ℝ) / x)]

theorem centered_twistedPsi_bound_of_smoothed_exponent {θ : ℝ} (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1)
    {q : ℕ} (χ : DirichletCharacter ℂ q)
    (hq : 0 < q) {C : ℝ} (hC : 0 < C)
    (hbound : ∀ y : ℝ, 2 ≤ y → ‖smoothedTwistedPsi χ y - (y : ℂ) / 2‖ ≤
      C * y ^ θ * Real.log ((q : ℝ) * y))
    {x : ℝ} (hx : 2 ≤ x) :
    ‖twistedPsi χ x - (x : ℂ)‖ ≤ (28 * C + 8) * x ^ ((1 + θ) / 2) * Real.log ((q : ℝ) * x) := by
  let p : ℝ := x ^ ((1 + θ) / 2)
  let m : ℕ := ⌈p⌉₊
  let L : ℝ := Real.log ((q : ℝ) * x)
  have hx0 : 0 < x := by linarith
  have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast hq
  have hq0 : (0 : ℝ) < q := by exact_mod_cast hq
  have hL : 0 ≤ L := Real.log_nonneg (by nlinarith)
  have hp1 : 1 ≤ p := Real.one_le_rpow (by linarith) (by linarith)
  have hp0 : 0 < p := by linarith
  have hpx : p ≤ x := by
    calc
      _ ≤ x ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le (by linarith) (by linarith)
      _ = x := Real.rpow_one _
  have hmp : p ≤ (m : ℝ) := Nat.le_ceil p
  have hm2p : (m : ℝ) ≤ 2 * p := by
    have hh := Nat.ceil_lt_add_one hp0.le
    dsimp [m]
    linarith
  have hm : 0 < m := Nat.ceil_pos.mpr hp0
  have hm0 : 0 < (m : ℝ) := by exact_mod_cast hm
  have hym : x + (m : ℝ) ≤ 3 * x := by linarith
  have hy2 : 2 ≤ x + (m : ℝ) := by linarith
  have hpow := power_three_scale_le_of_exponent hθ0 hθ1 hx0 (by positivity : 0 ≤ x + (m : ℝ)) hym
  have hlog := log_three_scale_le hq1 hx (by positivity : 0 < x + (m : ℝ)) hym
  have hlog0 : 0 ≤ Real.log ((q : ℝ) * (x + (m : ℝ))) :=
    Real.log_nonneg (by nlinarith)
  have hsmy : ‖smoothedTwistedPsi χ (x + m) - ((x + m : ℝ) : ℂ) / 2‖ ≤
      9 * C * x ^ θ * L := by
    calc
      _ ≤ C * (x + m) ^ θ * Real.log ((q : ℝ) * (x + m)) := hbound _ hy2
      _ ≤ C * (3 * x ^ θ) * (3 * L) := by gcongr
      _ = _ := by ring
  have hsmx : ‖smoothedTwistedPsi χ x - (x : ℂ) / 2‖ ≤ C * x ^ θ * L := hbound x hx
  have hp2 : x * x ^ θ = p ^ 2 := by
    dsimp [p]
    calc
      _ = x ^ (1 : ℝ) * x ^ θ := by rw [Real.rpow_one]
      _ = x ^ ((1 : ℝ) + θ) := (Real.rpow_add hx0 _ _).symm
      _ = x ^ (((1 + θ) / 2) * 2) := by congr 1; ring
      _ = _ := by rw [Real.rpow_mul hx0.le, Real.rpow_two]
  have hpair : (x + m) * ‖smoothedTwistedPsi χ (x + m) - ((x + m : ℝ) : ℂ) / 2‖ + x * ‖smoothedTwistedPsi χ x - (x : ℂ) / 2‖ ≤
      28 * C * p ^ 2 * L := by
    calc
      _ ≤ (3 * x) * (9 * C * x ^ θ * L) +
          x * (C * x ^ θ * L) := by gcongr
      _ = 28 * C * (x * x ^ θ) * L := by ring
      _ = _ := by rw [hp2]
  have hlogy0 : Real.log (x + (m : ℝ)) ≤ 3 * L := by
    apply le_trans _ hlog
    apply Real.log_le_log (by positivity)
    nlinarith
  have hhalf : (1 / 2 : ℝ) ≤ L := by
    have h2 : (1 / 2 : ℝ) ≤ Real.log 2 := by
      have hh := Real.one_sub_inv_le_log_of_pos (by norm_num : (0 : ℝ) < 2)
      norm_num at hh
      exact hh
    apply h2.trans
    apply Real.log_le_log (by norm_num)
    nlinarith
  have hlogy : Real.log (x + (m : ℝ)) + 1 / 2 ≤ 4 * L := by linarith
  have hpp : p ^ 2 ≤ p * m := by nlinarith
  have hmp2 : (m : ℝ) ^ 2 ≤ 2 * p * m := by nlinarith
  calc
    _ ≤ ((x + m) * ‖smoothedTwistedPsi χ (x + m) - ((x + m : ℝ) : ℂ) / 2‖ + x * ‖smoothedTwistedPsi χ x - (x : ℂ) / 2‖ +
        (m : ℝ) ^ 2 * (Real.log (x + m) + 1 / 2)) / m := riesz_centered_unsmoothing_bound χ hx0 hm
    _ ≤ (28 * C + 8) * p * L := by
      apply (div_le_iff₀ hm0).mpr
      calc
        _ ≤ 28 * C * p ^ 2 * L + (m : ℝ) ^ 2 * (4 * L) := by gcongr
        _ = 28 * C * p ^ 2 * L + 4 * (m : ℝ) ^ 2 * L := by ring
        _ ≤ 28 * C * (p * m) * L + 4 * (2 * p * m) * L := by gcongr
        _ = _ := by ring


theorem ordinary_psi_bound_of_riesz {θ : ℝ} (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1)
    {C : ℝ} (hC : 0 < C)
    (hbound : ∀ y : ℝ, 2 ≤ y → ‖ordinaryRieszMean y - (y : ℂ) / 2‖ ≤
      C * y ^ θ * Real.log y)
    {x : ℝ} (hx : 2 ≤ x) :
    ‖Chebyshev.psi x - x‖ ≤ (28 * C + 8) * x ^ ((1 + θ) / 2) * Real.log x := by
  have h := centered_twistedPsi_bound_of_smoothed_exponent hθ0 hθ1
    (1 : DirichletCharacter ℂ 1) (by norm_num) hC (fun y hy => by
      simpa [principal_smoothedTwistedPsi (by linarith : 0 < y)] using hbound y hy) hx
  rw [principal_twistedPsi, ← Complex.ofReal_sub, Complex.norm_real] at h
  simpa using h


theorem power_log_isLittleO_log_error {p : ℝ} (hp : p < 1) (B : ℝ) :
    (fun x : ℝ => x ^ p * Real.log x) =o[Filter.atTop]
      (fun x : ℝ => x * Real.log x ^ (-B)) := by
  have h := (Asymptotics.isBigO_refl
    (fun x : ℝ => x ^ p * Real.log x ^ (-B)) Filter.atTop).mul_isLittleO
      (isLittleO_log_rpow_rpow_atTop (B + 1) (show 0 < 1 - p by linarith))
  apply h.congr'
  · filter_upwards [Filter.eventually_gt_atTop (1 : ℝ)] with x hx
    rw [mul_assoc, ← Real.rpow_add (Real.log_pos hx)]
    simp only [neg_add_cancel_left, Real.rpow_one]
  · filter_upwards [Filter.eventually_gt_atTop (1 : ℝ)] with x hx
    rw [show x ^ p * Real.log x ^ (-B) * x ^ (1 - p) =
      (x ^ p * x ^ (1 - p)) * Real.log x ^ (-B) by ring,
      ← Real.rpow_add (by linarith : 0 < x)]
    simp only [add_sub_cancel, Real.rpow_one]

theorem ordinary_psi_error_of_riesz_bound {θ : ℝ} (hθ0 : 0 ≤ θ) (hθ1 : θ < 1)
    {C : ℝ} (hC : 0 < C)
    (hbound : ∀ y : ℝ, 2 ≤ y → ‖ordinaryRieszMean y - (y : ℂ) / 2‖ ≤
      C * y ^ θ * Real.log y) (B : ℝ) :
    (Chebyshev.psi - id) =o[Filter.atTop]
      (fun x : ℝ => x * Real.log x ^ (-B)) := by
  have hbig : (Chebyshev.psi - id) =O[Filter.atTop]
      (fun x : ℝ => x ^ ((1 + θ) / 2) * Real.log x) := by
    apply Asymptotics.IsBigO.of_bound (28 * C + 8)
    filter_upwards [Filter.eventually_ge_atTop (2 : ℝ)] with x hx
    have hb := ordinary_psi_bound_of_riesz hθ0 hθ1.le hC hbound hx
    change ‖Chebyshev.psi x - x‖ ≤ (28 * C + 8) * ‖x ^ ((1 + θ) / 2) * Real.log x‖
    rw [Real.norm_of_nonneg (mul_nonneg (Real.rpow_nonneg (by linarith) _)
      (Real.log_nonneg (by linarith)))]
    simpa only [mul_assoc] using hb
  exact hbig.trans_isLittleO (power_log_isLittleO_log_error (by linarith) B)

end Bounty

end

namespace Bounty

theorem ordinary_psi_error_isLittleO (B : ℝ) :
    (Chebyshev.psi - id) =o[atTop]
      (fun x : ℝ => x * (Real.log x)^(-B)) := by
  obtain ⟨C, hC, hbound⟩ := ThirdZetaContour.ordinaryRieszMean_logarithmic_bound
    OrdinaryZetaBounds.logDeriv_bound
  exact ordinary_psi_error_of_riesz_bound (by norm_num) (by norm_num) hC hbound B







end Bounty
