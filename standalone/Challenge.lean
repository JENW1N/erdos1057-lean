/- The finite retained-cell coefficient sum with its exact mass normalization. -/

open Finset
open scoped Classical
namespace Bounty

theorem finite_retained_log_cells_card {X : Type*} [Fintype X]
    (μ z : X → ℝ) {h ξ L : ℝ} (hh : 0 < h) (hL : 0 ≤ L)
    (hz : ∀ x, 0 ≤ z x ∧ z x ≤ L) :
    ((finiteRetainedCells μ (fun x => upperLogCell h (z x)) ξ).card : ℝ) ≤ L/h+2 := by
  have hcard : (finiteRetainedCells μ (fun x => upperLogCell h (z x)) ξ).card ≤
      (finiteOccupiedCells (fun x => upperLogCell h (z x))).card := card_filter_le _ _
  have hr := upper_log_occupied_cells_card_real_le z hh hL hz
  exact (Nat.cast_le.mpr hcard).trans (by simpa only [sub_zero] using hr)

theorem prime_retained_cell_expansion_cost {I : Type*} [Fintype I] [dI : DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (Q : ℕ) {h ξ L : ℝ}
    (hh : 0 < h) (hξ : 0 < ξ) (hL : 0 ≤ L)
    (hrange : ∀ x : (∀ i, P i),
      0 ≤ Real.log (∏ i, (x i).val : ℕ) ∧ Real.log (∏ i, (x i).val : ℕ) ≤ L) :
    (∑ d ∈ primeProductRetainedCells P V h ξ, ∑ _χ : BoundedPrimitiveCharacter Q,
      ‖((1 / finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
        (fun z => upperLogCell h (Real.log (∏ i, (z i).val : ℕ))) d : ℝ) : ℂ)‖) ≤
      (L / h + 2) * (Q * Q : ℕ) / ξ := by
  cases Subsingleton.elim dI (Classical.typeDecidableEq I)
  have hc : ((primeProductRetainedCells P V h ξ).card : ℝ) ≤ L / h + 2 :=
    finite_retained_log_cells_card
      (finiteProductWeight (physicalLabelLaw (P := P) V))
      (fun z : (∀ i, P i) => Real.log (∏ i, (z i).val : ℕ)) hh hL hrange
  exact (prime_cell_expansion_cost P V Q h _ hξ
    (fun _ hd => prime_product_retained_cell_mass P V h ξ hd)).trans
      (div_le_div_of_nonneg_right
        (mul_le_mul_of_nonneg_right hc (Nat.cast_nonneg _)) hξ.le)

end Bounty
end

section

/- Harmonic summation of the extracted prime-character bound for the actual Q weight. -/

open Finset

namespace Bounty

theorem candidate_Q_character_bound_of_prime_bound (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : 0 < jStar) (S : Finset ℕ) {d : ℕ}
    (χ : DirichletCharacter ℂ d) (h : ℕ) (X H : ℝ) (hX : 0 ≤ X) (hH : 0 ≤ H)
    (hprime : ∀ y : ∀ slot, candidateQRestChoices c L r jStar hr slot,
      ‖∑ p ∈ ((candidateQBand (c*L) 0).filter (fun p =>
        p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y ∈ S)).filter
          (fun p => p.Coprime h), χ (p : ZMod d)‖ ≤
        (X / (orderedSlotProduct (candidateQRestChoices c L r jStar hr) y : ℝ)) * H) :
    ‖∑ n ∈ S.filter (fun n => n.Coprime h),
      (candidateQWeight c L r jStar n : ℂ) * χ (n : ZMod d)‖ ≤
        X * H * candidateQRestHarmonicMass c L r jStar hr := by
  classical
  let N : ℝ := (r.factorial : ℝ)^(candidateQIndices c L).card
  have hN : 0 < N := by dsimp only [N]; positivity
  have hn : ‖(1 / (N : ℂ))‖ = 1/N := by
    rw [norm_div, norm_one, Complex.norm_real, Real.norm_of_nonneg hN.le]
  have heq := candidate_Q_zero_character_window_split c L r jStar hr hj S χ h (fun _ => 1)
  simp only [mul_one] at heq
  rw [heq, ← Complex.ofReal_pow]
  change ‖(1 / (N : ℂ)) * _‖ ≤ _
  rw [norm_mul, hn]
  calc
    _ ≤ (1/N) * ∑ y : ∀ slot, candidateQRestChoices c L r jStar hr slot,
        ‖if (orderedSlotProduct (candidateQRestChoices c L r jStar hr) y).Coprime h then
          χ (orderedSlotProduct (candidateQRestChoices c L r jStar hr) y : ZMod d) *
            ∑ p ∈ ((candidateQBand (c*L) 0).filter (fun p =>
              p * orderedSlotProduct (candidateQRestChoices c L r jStar hr) y ∈ S)).filter
                (fun p => p.Coprime h), χ (p : ZMod d)
        else 0‖ := mul_le_mul_of_nonneg_left (norm_sum_le _ _) (by positivity)
    _ ≤ (1/N) * ∑ y : ∀ slot, candidateQRestChoices c L r jStar hr slot,
        (X / (orderedSlotProduct (candidateQRestChoices c L r jStar hr) y : ℝ)) * H := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      apply sum_le_sum
      intro y _
      split_ifs with hy
      · rw [norm_mul]
        exact (mul_le_of_le_one_left (norm_nonneg _) (χ.norm_le_one _)).trans (hprime y)
      · simp only [norm_zero]
        positivity
    _ = _ := by
      rw [candidate_Q_rest_harmonic_eq_tuple_sum, mul_sum, mul_sum]
      apply sum_congr rfl
      intro y _
      dsimp only [N]
      ring

end Bounty

