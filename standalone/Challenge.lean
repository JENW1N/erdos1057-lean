/- The actual discrepant ambient coefficients are positive-indexed and free of the candidate group pool. -/

open Finset Filter

namespace Bounty

theorem eventually_ambient_rough_endpoint_group_free {c γ : ℝ}
    (hc : 0 < c) (hγ : 0 < γ) :
    ∀ᶠ L : ℝ in atTop, ∀ S a v : ℝ, ∀ m : ℕ,
      ambientRoughIntervalTypeIIAlpha γ L S a v m ≠ 0 →
      0 < m ∧ Disjoint m.primeFactors
        ((candidatePIndices c L).biUnion (candidatePBand (c*L))) := by
  filter_upwards [eventually_candidate_P_pool_below_rough_cutoff hc,
    eventually_ambient_rough_interval_typeII_properties hγ] with L hpool hrough
  intro S a v m hm
  obtain ⟨hmem, hprimes⟩ := (hrough S a v m).2 hm
  refine ⟨?_, prime_factors_disjoint_of_rough hpool hprimes⟩
  exact (mem_Icc.mp (mem_filter.mp hmem).1).1

theorem eventually_ambient_prime_endpoint_group_free {c : ℝ}
    (hc : 0 < c) (S : ℝ) (hS : 0 ≤ S) :
    ∀ᶠ L : ℝ in atTop, ∀ κ : ℝ, 0 ≤ κ → κ ≤ 1/50 → ∀ m : ℕ,
      ambientPrimeTypeIIAlpha κ L S m ≠ 0 →
      0 < m ∧ Disjoint m.primeFactors
        ((candidatePIndices c L).biUnion (candidatePBand (c*L))) := by
  filter_upwards [eventually_candidate_P_pool_below_rough_cutoff hc,
    eventually_balanced_typeII_coefficient_properties S hS] with L hpool hprime
  intro κ hκ hκmax m hm
  obtain ⟨hmem, hprimes⟩ := (hprime κ hκ hκmax m).2.2.2 hm
  refine ⟨?_, prime_factors_disjoint_of_rough hpool hprimes⟩
  exact (mem_Icc.mp (mem_filter.mp hmem).1).1


end Bounty
