  unfold physicalObservedMarkRow
  dsimp only
  conv_lhs =>
    arg 4
    equals (fun _ => 0) =>
      funext u
      unfold physicalMarkRawExtension
      split_ifs <;> simp_all
  conv_lhs =>
    arg 4
    equals (fun _ => (0 : ℂ) * 0) =>
      funext u
