theorem exists_actual_prime_block_harmonic_reduction {c : ℝ} (hc : 0<c) {r : ℕ} (hr : 6≤r) :
    ∃ J : ℕ, ∀ jStar : ℕ, J<jStar → ∀ D : ℝ,
      ∃ T : ℝ, 0<T ∧ ∃ Kmin : ℝ, 0<Kmin ∧
      ∀ K : ℝ, Kmin≤K → ∃ Q F : ℝ, 0<Q ∧ 0<F ∧
      ∀ S : ℝ, 0≤S → ∀ᶠ L : ℝ in atTop, ∀ κ : ℝ, 0≤κ → κ≤1/50 → ∀ proxy : Bool, ∀ i j : ℕ,
      let H := ⌊33*exp L⌋₊
      let M := dyadicNatBucket (Icc 1 H) i
      let N := dyadicNatBucket (Icc 1 H) j
      let α := typeIIRestrict M (ambientPrimeTypeIIAlpha κ L S)
      let β := typeIIRestrict N (if proxy then ambientProxyTypeIIBeta κ L S else ambientPrimeTypeIIBeta κ L)
      let U := originalDyadicBase i
      let V := originalDyadicBase j
      shiftedTypeIIBilinear (arithmeticProductWindow 1 (exp L))
        (candidateCoefficient c L (1/2) r jStar) α β ≠ 0 →
      (∀ ν : ℝ, ‖ν‖ ≤ L^T →
        ∀ take : Fin ((candidateQIndices c L).card*r) → Bool,
        (∀ i, candidateAllocationActive c L r jStar i = false → take i = false) →
        ∀ ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ,
        (∀ i, ‖ξ i‖ ≤ L) →
        ∀ k ∈ Icc (-(typeIIAdmissibleDeterminantBound L K:ℤ)) (typeIIAdmissibleDeterminantBound L K),
        k ≠ 0 → ∀ j ∈ range (typeIISmoothDyadicCount L),
        ∀ χ : DirichletCharacter ℂ (2*k.natAbs), ∀ ζ : EuclideanSpace ℝ (Fin 3), ‖ζ‖ ≤ L^F →
        ‖candidateB0HarmonicCorrelation c L (1/2) r jStar
          (candidateSmallPSet c L (exp (4*L))) take
          (candidateAllocationFourierTwist c L r jStar take ξ) ν
          (typeIISmoothDyadicScale U V (U*L^(-K)) j) k M (fun m => (α m : ℂ)) χ ζ‖ ≤ L^(-Q)) →
      |shiftedTypeIIBilinear (arithmeticProductWindow 1 (exp L))
        (candidateCoefficient c L (1/2) r jStar) α β| ≤ exp L*L^(-D) := by
  let b : ℝ := 1/5
  have hb : 0<b := by norm_num [b]
  obtain ⟨J, hJ⟩ := exists_original_real_bilinear_bound_of_saturated_harmonic hc hb hr
  refine ⟨J, ?_⟩
  intro jStar hj D
  obtain ⟨Bwin, T, hBwin, hT, Kmin, hKmin, hbound⟩ := hJ jStar hj D
  refine ⟨T, hT, Kmin, hKmin, ?_⟩
  intro K hK
  obtain ⟨Q, F, hQ, hF, hbound⟩ := hbound K hK
  refine ⟨Q, F, hQ, hF, ?_⟩
  intro S hS
  filter_upwards [hbound,eventually_ambient_prime_active_dyadic_bounds,
    eventually_ambient_prime_dyadic_coefficient_properties S hS,eventually_ge_atTop (0 : ℝ)]
    with L hbound hsizes hprops hL
  intro κ hκ hκmax proxy i j
  dsimp only
  intro hne hcorr
  let H := ⌊33*exp L⌋₊
  have hsize := hsizes κ S hκ hκmax proxy
    (arithmeticProductWindow 1 (exp L)) (candidateCoefficient c L (1/2) r jStar) H i j hne
  have hp := (original_active_dyadic_product_bounds hL
    (candidateCoefficient c L (1/2) r jStar) (ambientPrimeTypeIIAlpha κ L S) (if proxy then ambientProxyTypeIIBeta κ L S else ambientPrimeTypeIIBeta κ L) H i j hne).2
  have hcoarse : 2*originalDyadicBase i*originalDyadicBase j ≤ 66*exp L := by nlinarith
  exact hbound _ _ _ _ _ _ hsize.1 hsize.2.1 hsize.2.2.1 hsize.2.2.2 hcoarse
    (fun m hm => original_dyadic_member_bounds H i m hm)
    (fun n hn => original_dyadic_member_bounds H j n hn)
    (fun m hm => if_neg hm) (fun n hn => if_neg hn)
    (fun n => (hprops κ hκ hκmax proxy H i j n).1) (fun n => (hprops κ hκ hκmax proxy H i j n).2.1)
    (fun n => (hprops κ hκ hκmax proxy H i j n).2.2) hcorr

end Bounty
