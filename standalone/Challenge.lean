  (a0 : P → Bool) (β0 : P → ℝ) (an : P → Bool) {n : ℕ}
  (x : Fin (n + 1) → (p : P) → GhostPhaseState (R p))
  (hx : ghostPhaseFiniteTensorTraceWeight isVisit atgt asrc htgt hsrc η β a0 β0 an x ≠ 0)

include hx
















