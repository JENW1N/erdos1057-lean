variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  [dG : DecidableEq G]
  {J ell : ℕ}
  (P : G → Finset ℕ)
  (V : G → ℝ)
  (probes : G → Finset (Fin J))
