/- The actual exceptional prime-polynomial intervals are a subpower of Y,
uniformly in the prime set and its bounded coefficients. -/

open Filter
open scoped Topology

namespace Bounty

theorem eventually_prime_exceptional_intervals_subpower {a beta c A d ε : ℝ}
    (ha : 0 < a) (ha1 : a ≤ 1) (hbeta : beta < 1) (hc : 0 ≤ c) (hA : 0 ≤ A)
    (hd : 0 < d) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ (s : Finset ℕ), (∀ p ∈ s, Nat.Prime p) →
      ∀ (coeff : s → ℂ) (Y P R : ℝ),
      1 ≤ Y → d * L ≤ Real.log Y → Real.log Y ≤ c * L →
      Real.exp (L ^ a) / 2 ≤ P → P ≤ Real.exp (L ^ beta) →
      0 ≤ R → R ≤ Y →
      (∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P) →
      (∀ p : s, ‖coeff p‖ ≤ 1) →
      ((primeExceptionalIntervals s coeff (L ^ (-A)) R).card : ℝ) ≤ Y ^ ε := by
  filter_upwards [eventually_prime_moment_exp_le_rpow ha hbeta
      (zero_le_one.trans (prime_moment_actual_exponent_one_le hc hA)) hd hε,
    eventually_ge_atTop (Real.exp 1)] with L hsub hL
  intro s hs coeff Y P R hY hloglo hloghi hPlo hPhi hR hRY hband hcoeff
  exact (prime_exceptional_intervals_subexponential_bound s hs coeff ha.le ha1 hc hA
    hL hY hloghi hPlo hPhi hR hRY hband hcoeff).trans
      (hsub Y (zero_lt_one.trans_le hY) hloglo)

