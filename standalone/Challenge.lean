variable
  {I : Type*}
  [sharedInstance1 : Fintype I]
  {X : I → Type*}
  (E : ∀ i, X i → Type*)
  [sharedInstance4 : ∀ i x, Fintype (E i x)]
  (weight : ∀ i x, E i x → ℝ)
  (target : ∀ i x, E i x → X i)
  (phase : ∀ x : (∀ i, X i), (∀ i, E i (x i)) → ℂ)
  (hphase : ∀ x e, ‖phase x e‖ ≤ 1)
  (f : (∀ i, X i) → ℂ)
  (x : ∀ i, X i)

include I sharedInstance1 X E sharedInstance4 weight target phase hphase f x

theorem finite_product_event_norm_le_abs_positive  :
    ‖finiteProductEventAction E weight target phase f x‖ ≤
      finiteProductEventPositive E (fun i x e => |weight i x e|) target (fun y => ‖f y‖) x := by
  unfold finiteProductEventAction finiteProductEventPositive
  refine (norm_sum_le _ _).trans (sum_le_sum fun e _ => ?_)
  rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, Finset.abs_prod]
  calc
    _ ≤ ((∏ i, |weight i (x i) (e i)|) * 1) * ‖f (fun i => target i (x i) (e i))‖ :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hphase x e)
        (prod_nonneg fun _ _ => abs_nonneg _)) (norm_nonneg _)
    _ = _ := by rw [mul_one]

theorem finite_product_event_norm_le_abs_positive_re  :
    ‖finiteProductEventAction E weight target phase f x‖ ≤
      (finiteProductEventAction E (fun i x e => |weight i x e|) target (fun _ _ => 1)
        (complexNormEnvelope f) x).re := by
  rw [show complexNormEnvelope f = fun y => (‖f y‖ : ℂ) from rfl,
    ← finite_product_event_positive_cast, Complex.ofReal_re]
  exact finite_product_event_norm_le_abs_positive E weight target phase hphase f x

