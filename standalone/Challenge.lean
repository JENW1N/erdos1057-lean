theorem physical_partial_memory_walk_normalization {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ a : PhysicalPrime P, NeZero a.2.val] {J ell : ℕ}
    (groups : Finset G) (V : G → ℝ) (patterns : Finset I) (C : I → G → Finset (Fin J))
    (ζ : ℕ → I → ℝ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (n : ℕ)
    (h : (p : PhysicalPrime P) → ℕ → ZMod p.2.val) (η : ℕ → ℝ) (b : PhysicalPrime P → ℝ)
    (hnew : ∀ j < n, ∀ g ∈ groups,
      (physicalGroupMarks (L (j + 1)) g \ physicalGroupMarks (L j) g).card =
        ell + (C (a j).2.2.1.val g).card)
    (hb : ∀ p : PhysicalPrime P, p.1 ∈ groups →
      b p = 1 - (∑ j ∈ range (n + 1), η j) / p.2.val)
    (hb0 : ∀ p : PhysicalPrime P, p.1 ∈ groups → b p ≠ 0) :
    (physicalStateMass V J ell : ℂ) * physicalBareWalkScalar V patterns C ζ K a L n *
      (poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) univ (range (n + 1))
        (fun p => (range (n + 1)).filter (fun j => p ∈ physicalMarkedPrimes (L j))) h η : ℝ) =
    (physicalGroupPathMass V groupsᶜ (fun j => C (a j).2.2.1.val) ell n : ℂ) *
      physicalMemoryWalkScalar V patterns C ζ K a L n *
      (poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val)
        (physicalPrimeGroups P groupsᶜ) (range (n + 1))
        (fun p => (range (n + 1)).filter (fun j => p ∈ physicalMarkedPrimes (L j))) h η : ℝ) *
      (∏ p ∈ physicalPrimeGroups P groups, b p : ℝ) *
      (∏ p ∈ physicalPrimeGroups P groups,
        ghostPhaseRunHistory (fun j => decide (p ∈ physicalMarkedPrimes (L j)))
          (h p) η ((p.2.val : ℝ) * b p)⁻¹ (V p.1) n : ℝ) := by
  classical
  have hp := physical_prime_groups_split groups (fun p : PhysicalPrime P =>
    (∑ r, activeResidueWeight (range (n + 1))
      ((range (n + 1)).filter (fun j => p ∈ physicalMarkedPrimes (L j))) (h p) η r) /
      (p.2.val : ℝ))
  have hm := physical_group_path_mass_split V groups (fun j => C (a j).2.2.1.val) ell n
  have hr := physical_group_residue_run_normalization groups V L
    (fun j => C (a j).2.2.1.val) n h η b hnew hb hb0
  rw [physical_memory_walk_scalar_factor]
  change _ * _ * (poolPathResidueExpectation _ _ _ _ _ _ : ℂ) = _
  have hp' : poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) univ
      (range (n + 1)) (fun p => (range (n + 1)).filter (fun j => p ∈ physicalMarkedPrimes (L j))) h η =
    poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) (physicalPrimeGroups P groups)
      (range (n + 1)) (fun p => (range (n + 1)).filter (fun j => p ∈ physicalMarkedPrimes (L j))) h η *
    poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) (physicalPrimeGroups P groupsᶜ)
      (range (n + 1)) (fun p => (range (n + 1)).filter (fun j => p ∈ physicalMarkedPrimes (L j))) h η := hp
  rw [hp']
  have hm' := congrArg (fun x : ℝ => (x : ℂ)) hm
  have hr' := congrArg (fun x : ℝ => (x : ℂ)) hr
  push_cast at hm' hr' ⊢
  linear_combination physicalMemoryWalkScalar V patterns C ζ K a L n *
      (poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) (physicalPrimeGroups P groups)
        (range (n + 1)) (fun p => (range (n + 1)).filter (fun j => p ∈ physicalMarkedPrimes (L j))) h η : ℝ) *
      (poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) (physicalPrimeGroups P groupsᶜ)
        (range (n + 1)) (fun p => (range (n + 1)).filter (fun j => p ∈ physicalMarkedPrimes (L j))) h η : ℝ) * hm' +
    (physicalGroupPathMass V groupsᶜ (fun j => C (a j).2.2.1.val) ell n : ℝ) *
      physicalMemoryWalkScalar V patterns C ζ K a L n *
      (poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) (physicalPrimeGroups P groupsᶜ)
        (range (n + 1)) (fun p => (range (n + 1)).filter (fun j => p ∈ physicalMarkedPrimes (L j))) h η : ℝ) * hr'

