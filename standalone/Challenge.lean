section

/- Recover a projected weighted norm from pairings against symmetric tests.
The operator is arbitrary; no linearity or prior operator norm is assumed. -/

open Finset
open scoped Classical

namespace Bounty




theorem clean_weighted_self_pairing_norm {X : Type*} [Fintype X]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (u : X → ℂ) :
    ‖∑ x, (w x : ℂ) * (starRingEnd ℂ) (u x) * u x‖ =
      cleanActiveNorm w u ^ 2 := by
  have he : (∑ x, (w x : ℂ) * (starRingEnd ℂ) (u x) * u x) =
      ((∑ x, w x * ‖u x‖ ^ 2 : ℝ) : ℂ) := by
    rw [Complex.ofReal_sum]
    apply sum_congr rfl
    intro x hx
    rw [mul_assoc, Complex.conj_mul', Complex.ofReal_mul, Complex.ofReal_pow]
  rw [he, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (sum_nonneg (fun x _ => mul_nonneg (hw x) (sq_nonneg _))),
    clean_active_norm_sq w hw]

theorem clean_active_norm_le_of_self_pairing {X : Type*} [Fintype X]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (u : X → ℂ) {C : ℝ}
    (hC : 0 ≤ C)
    (hpair : ‖∑ x, (w x : ℂ) * (starRingEnd ℂ) (u x) * u x‖ ≤
      C * cleanActiveNorm w u) :
    cleanActiveNorm w u ≤ C := by
  rw [clean_weighted_self_pairing_norm w hw u, pow_two] at hpair
  by_cases hzero : cleanActiveNorm w u = 0
  · simpa only [hzero] using hC
  · have hn : 0 ≤ cleanActiveNorm w u := Real.sqrt_nonneg _
    have hp : 0 < cleanActiveNorm w u := lt_of_le_of_ne hn (Ne.symm hzero)
    exact (mul_le_mul_iff_left₀ hp).mp hpair

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P : G → Finset ℕ}
  {J ell : ℕ}

include G sharedInstance1 sharedInstance2 P J ell

theorem repeated_big_symmetric_pairing_symmetrize 
    (w : RepeatedBigLists P J ell → ℝ)
    (hw : ∀ (σ : PhysicalPermutations G J ell) L,
      w (repeatedBigPermutationEquiv σ L) = w L)
    (f u : RepeatedBigLists P J ell → ℂ)
    (hf : f ∈ repeatedBigSymmetricSubspace) :
    (∑ L, (w L : ℂ) * (starRingEnd ℂ) (f L) * repeatedBigSymmetrizeLinear u L) =
      ∑ L, (w L : ℂ) * (starRingEnd ℂ) (f L) * u L := by
  have hσ (σ : PhysicalPermutations G J ell) :
      (∑ L, (w L : ℂ) * (starRingEnd ℂ) (f L) *
        u (repeatedBigPermutationEquiv σ L)) =
      ∑ L, (w L : ℂ) * (starRingEnd ℂ) (f L) * u L := by
    have he := (repeatedBigPermutationEquiv (P := P) σ).sum_comp
      (fun L => (w L : ℂ) * (starRingEnd ℂ) (f L) * u L)
    simpa only [hw, show ∀ σ L, f (repeatedBigPermutationEquiv σ L) = f L from hf]
      using he
  change (∑ L, (w L : ℂ) * (starRingEnd ℂ) (f L) *
    ((Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
      ∑ σ : PhysicalPermutations G J ell, u (repeatedBigPermutationEquiv σ L))) = _
  calc
    _ = (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
        ∑ σ : PhysicalPermutations G J ell,
          ∑ L, (w L : ℂ) * (starRingEnd ℂ) (f L) * u (repeatedBigPermutationEquiv σ L) := by
      rw [sum_comm]
      simp_rw [mul_sum]
      apply sum_congr rfl
      intro L hL
      apply sum_congr rfl
      intro σ hσ
      ring
    _ = _ := by
      simp_rw [hσ]
      rw [sum_const, card_univ, nsmul_eq_mul, ← mul_assoc, inv_mul_cancel₀, one_mul]
      exact_mod_cast Fintype.card_ne_zero

theorem repeated_big_projected_norm_le_of_pairing 
    (w : RepeatedBigLists P J ell → ℝ) (hw0 : ∀ L, 0 ≤ w L)
    (hw : ∀ (σ : PhysicalPermutations G J ell) L,
      w (repeatedBigPermutationEquiv σ L) = w L)
    (u : RepeatedBigLists P J ell → ℂ) {C : ℝ} (hC : 0 ≤ C)
    (hpair : ∀ f : RepeatedBigLists P J ell → ℂ,
      f ∈ repeatedBigSymmetricSubspace →
      ‖∑ L, (w L : ℂ) * (starRingEnd ℂ) (f L) * u L‖ ≤ C * cleanActiveNorm w f) :
    cleanActiveNorm w (repeatedBigSymmetrizeLinear u) ≤ C := by
  apply clean_active_norm_le_of_self_pairing w hw0 _ hC
  rw [repeated_big_symmetric_pairing_symmetrize w hw _ u (repeated_big_symmetrize_mem u)]
  exact hpair _ (repeated_big_symmetrize_mem u)

theorem repeated_big_operator_norm_le_of_symmetric_pairing 
    (w : RepeatedBigLists P J ell → ℝ) (hw0 : ∀ L, 0 ≤ w L)
    (hw : ∀ (σ : PhysicalPermutations G J ell) L,
      w (repeatedBigPermutationEquiv σ L) = w L)
    (A : (RepeatedBigLists P J ell → ℂ) → RepeatedBigLists P J ell → ℂ)
    {M : ℝ} (hM : 0 ≤ M)
    (hpair : ∀ f v : RepeatedBigLists P J ell → ℂ,
      f ∈ repeatedBigSymmetricSubspace → v ∈ repeatedBigSymmetricSubspace →
      ‖∑ L, (w L : ℂ) * (starRingEnd ℂ) (f L) * A v L‖ ≤
        M * cleanActiveNorm w f * cleanActiveNorm w v)
    (v : RepeatedBigLists P J ell → ℂ) (hv : v ∈ repeatedBigSymmetricSubspace) :
    cleanActiveNorm w (repeatedBigSymmetrizeLinear (A v)) ≤ M * cleanActiveNorm w v := by
  apply repeated_big_projected_norm_le_of_pairing w hw0 hw (A v)
    (C := M * cleanActiveNorm w v) (mul_nonneg hM (Real.sqrt_nonneg _))
  intro f hf
  simpa only [mul_right_comm] using hpair f v hf hv

theorem repeated_big_untilted_operator_norm_le_of_symmetric_pairing 
    (V : G → ℝ) (hV : ∀ g, 0 ≤ V g)
    (A : (RepeatedBigLists P J ell → ℂ) → RepeatedBigLists P J ell → ℂ)
    {M : ℝ} (hM : 0 ≤ M)
    (hpair : ∀ f v : RepeatedBigLists P J ell → ℂ,
      f ∈ repeatedBigSymmetricSubspace → v ∈ repeatedBigSymmetricSubspace →
      ‖∑ L, (repeatedBigActiveMass V (fun _ _ => 1) L : ℂ) *
        (starRingEnd ℂ) (f L) * A v L‖ ≤
        M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f *
          cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) v)
    (v : RepeatedBigLists P J ell → ℂ) (hv : v ∈ repeatedBigSymmetricSubspace) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigSymmetrizeLinear (A v)) ≤
      M * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) v :=
  repeated_big_operator_norm_le_of_symmetric_pairing _
    (repeated_big_untilted_active_mass_nonneg V hV)
    (repeated_big_active_mass_permutation V (fun _ _ => 1)) A hM hpair v hv

end








end Bounty
end

section

/- The finite images of optional prefix draws and optional fresh slots. -/

open scoped Classical

namespace Bounty

theorem optional_prefix_birth_image {P : Type*} [DecidableEq P] (B b : ℕ) (hb : b ≤ B)
    (f : Fin b → P) :
    (Finset.univ.biUnion (fun i : Fin B =>
      (if h : i.val < b then some (f ⟨i.val, h⟩) else none).toFinset)) =
      Finset.univ.image f := by
  classical
  ext p
  simp only [Finset.mem_biUnion, Finset.mem_univ, true_and, Finset.mem_image]
  constructor
  · rintro ⟨i, hi⟩
    by_cases h : i.val < b
    · simp only [dif_pos h, Option.toFinset_some, Finset.mem_singleton] at hi
      exact ⟨⟨i.val, h⟩, hi.symm⟩
    · simp [h] at hi
  · rintro ⟨i, hi⟩
    refine ⟨⟨i.val, i.isLt.trans_le hb⟩, ?_⟩
    simp only [dif_pos i.isLt, Option.toFinset_some, Finset.mem_singleton]
    exact hi.symm

theorem optional_fresh_birth_image {I P : Type*} [Fintype I] [DecidableEq I] [DecidableEq P]
    (promotions : Finset I) (f : {i : I // i ∉ promotions} → P) :
    (Finset.univ.biUnion (fun i : I =>
      (if h : i ∈ promotions then none else some (f ⟨i, h⟩)).toFinset)) =
      Finset.univ.image f := by
  classical
  ext p
  simp only [Finset.mem_biUnion, Finset.mem_univ, true_and, Finset.mem_image]
  constructor
  · rintro ⟨i, hi⟩
    by_cases h : i ∈ promotions
    · simp [h] at hi
    · simp only [dif_neg h, Option.toFinset_some, Finset.mem_singleton] at hi
      exact ⟨⟨i, h⟩, hi.symm⟩
  · rintro ⟨i, hi⟩
    refine ⟨i.val, ?_⟩
    simp only [dif_neg i.property, Option.toFinset_some, Finset.mem_singleton]
    exact hi.symm

end Bounty
end

