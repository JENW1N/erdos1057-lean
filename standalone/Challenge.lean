section

/- Exact physical vacuum pairing and its unrestricted initial-mass bound. -/

open Finset
open scoped Classical
namespace Bounty

section Physical
variable {G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Finset ℕ} {Z : G → Type*} [∀ g, Fintype (Z g)] {J ell B : ℕ}

noncomputable def physicalMarkMass (μ : (g : G) → ↥(P g) → ℝ) : ℝ :=
  ∑ L : PhysicalMarkLists P J ell, ∏ g, ∏ i : PhysicalSlots J ell, μ g (L g i)

theorem physical_mark_mass_nonneg (μ : (g : G) → ↥(P g) → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) : 0 ≤ physicalMarkMass (J := J) (ell := ell) μ := by
  exact sum_nonneg fun L _ => prod_nonneg fun g _ => prod_nonneg fun i _ => hμ g (L g i)

theorem physical_mark_mass_le (μ : (g : G) → ↥(P g) → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) :
    physicalMarkMass (J := J) (ell := ell) μ ≤ ∏ g, (∑ p, μ g p) ^ (J + ell) := by
  let embed : PhysicalMarkLists P J ell → ((g : G) → PhysicalSlots J ell → ↥(P g)) :=
    fun L g => L g
  have he : Function.Injective embed := by
    intro L R h
    funext g
    apply Function.Embedding.coe_injective
    exact congrFun h g
  let weight := fun L : ((g : G) → PhysicalSlots J ell → ↥(P g)) =>
    ∏ g, ∏ i, μ g (L g i)
  have hw (L) : 0 ≤ weight L :=
    prod_nonneg fun g _ => prod_nonneg fun i _ => hμ g (L g i)
  calc
    physicalMarkMass μ = ∑ L ∈ univ.image embed, weight L := by
      rw [sum_image (fun _ _ _ _ h => he h)]
      rfl
    _ ≤ ∑ L, weight L := sum_le_sum_of_subset_of_nonneg (subset_univ _) (fun L _ _ => hw L)
    _ = ∏ g, (∑ p, μ g p) ^ (J + ell) := by
      dsimp [weight]
      rw [← Fintype.prod_sum (fun g (f : PhysicalSlots J ell → ↥(P g)) => ∏ i, μ g (f i))]
      apply prod_congr rfl
      intro g _
      rw [← Fintype.prod_sum (fun (_ : PhysicalSlots J ell) (p : ↥(P g)) => μ g p)]
      simp [PhysicalSlots]

theorem physical_mark_vacuum_energy_le
    (μ : (g : G) → ↥(P g) → ℝ) (ν : (g : G) → Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (qempty : (g : G) → BoundedOrderedTuple (Z g) B)
    (hq : ∀ g, (qempty g).1.val = 0)
    (F : PhysicalMarkLists P J ell → ((g : G) → BoundedOrderedTuple (Z g) B) → ℂ) :
    (∑ L, (∏ g, ∏ i : PhysicalSlots J ell, μ g (L g i)) * ‖F L qempty‖ ^ 2) ≤
      physicalMarkMemoryEnergy μ ν F := by
  have hweight (g : G) : boundedOrderedMemoryWeight (ν g) (qempty g) = 1 := by
    have hp : (∏ j, ν g ((qempty g).2 j)) = 1 := by
      apply prod_eq_one
      intro i _
      have hi := i.isLt
      have hz := hq g
      omega
    simp [boundedOrderedMemoryWeight, hp, hq]
  apply sum_le_sum
  intro L _
  have h := single_le_sum (f := fun q : (g : G) → BoundedOrderedTuple (Z g) B =>
    (∏ g, (∏ i : PhysicalSlots J ell, μ g (L g i)) *
      boundedOrderedMemoryWeight (ν g) (q g)) * ‖F L q‖ ^ 2)
    (fun q _ => mul_nonneg (prod_nonneg fun g _ =>
      mul_nonneg (prod_nonneg fun i _ => hμ g (L g i))
        (boundedOrderedMemoryWeight_nonneg (ν g) (hν g) (q g))) (sq_nonneg _))
    (mem_univ qempty)
  simpa only [hweight, mul_one] using h

theorem physical_mark_vacuum_pairing_energy_le
    (μ : (g : G) → ↥(P g) → ℝ) (ν : (g : G) → Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (qempty : (g : G) → BoundedOrderedTuple (Z g) B)
    (hq : ∀ g, (qempty g).1.val = 0)
    (F : PhysicalMarkLists P J ell → ((g : G) → BoundedOrderedTuple (Z g) B) → ℂ) :
    ‖∑ L, ((∏ g, ∏ i : PhysicalSlots J ell, μ g (L g i) : ℝ) : ℂ) * F L qempty‖ ^ 2 ≤
      physicalMarkMass (J := J) (ell := ell) μ * physicalMarkMemoryEnergy μ ν F := by
  exact (finite_weighted_sum_cauchy univ
    (fun L : PhysicalMarkLists P J ell => ∏ g, ∏ i, μ g (L g i))
    (fun L _ => prod_nonneg fun g _ => prod_nonneg fun i _ => hμ g (L g i))
    (fun L => F L qempty)).trans (mul_le_mul_of_nonneg_left
      (physical_mark_vacuum_energy_le μ ν hμ hν qempty hq F)
      (physical_mark_mass_nonneg μ hμ))










end Physical
end Bounty
end

