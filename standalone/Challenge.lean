namespace Bounty

theorem eventually_candidate_pattern_harmonic_decay {c b K q x : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hK : 0 ≤ K) (hq : 0 ≤ q) (hx : 0 ≤ x)
    (J ell : ℕ) (Cenv D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (groups : Finset ℕ), groups ⊆ candidatePIndices c L →
      ∀ (probes : groups → Finset (Fin J)) (r t : Finset groups) (hrt : Disjoint r t)
        (Q : ℕ) (h ξ : ℝ), (Q : ℝ) ≤ L^q → L^(-x) ≤ ξ →
      ∀ (a a' : ℝ) (pool : Finset ℕ), (∀ g : groups, candidatePBand (c*L) g.val ⊆ pool) →
      ∀ (α β γ α' β' γ' : ℕ → ℂ),
      (∀ n, ‖α n‖ ≤ L^Cenv) → (∀ n, ‖β n‖ ≤ L^Cenv) → (∀ n, ‖γ n‖ ≤ L^Cenv) →
      (∀ n, ‖α' n‖ ≤ L^Cenv) → (∀ n, ‖β' n‖ ≤ L^Cenv) → (∀ n, ‖γ' n‖ ≤ L^Cenv) →
      ∀ U V : ℝ, exp (b*L) ≤ U → U ≤ exp L → exp (b*L) ≤ V → V ≤ exp L →
      ∀ k ∈ Icc (-(typeIIAdmissibleDeterminantBound L K : ℤ)) (typeIIAdmissibleDeterminantBound L K : ℤ),
      ∀ j ∈ range (typeIISmoothDyadicCount L),
      ‖∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
        ∑ aux : PhysicalAuxLabels (fun g : groups => candidatePBand (c*L) g.val)
            (repeatedBigPrimePatternCut probes r t i),
          (physicalAuxMass (fun g : groups => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ))
            (repeatedBigPrimePatternCut probes r t i) aux : ℂ)*
          physicalPositiveHarmonicDifference (fun g : groups => candidatePBand (c*L) g.val)
            (fun g => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ)) probes r t hrt Q h ξ i aux
            a a' (typeIISmoothDyadicScale U V (U*L^(-K)) j) k pool α β γ α' β' γ'‖ ≤ L^(-D) := by
  obtain ⟨v, A, hv, hA, hinputs⟩ := exists_candidate_shared_error_inputs hc J
  let Acard := A*log 2+1
  filter_upwards [hinputs, eventually_ge_atTop (2 : ℝ),
    eventually_candidate_harmonic_replacement_decay hc hb hK J ell Cenv (4*q+2*x) (D+Acard)]
    with L hinput hL hbase
  intro groups hgroups probes r t hrt Q h ξ hQ hξ a a' pool hpool
    α β γ α' β' γ' hα hβ hγ hα' hβ' hγ' U V hUlo hUhi hVlo hVhi k hk j hj
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hξ0 : 0 < ξ := (rpow_pos_of_pos hL0 (-x)).trans_le hξ
  have hmass : ∀ g : groups, 0 < ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ) :=
    fun g => hv.trans_le ((hinput groups hgroups).2 g).1
  have hslots : ((J*Fintype.card groups : ℕ) : ℝ) ≤ A*log L := by
    simpa only [Fintype.card_coe] using (hinput groups hgroups).1
  have hcard : (Fintype.card (RepeatedBigPrimePatternIndex (ell := ell) probes r t) : ℝ) ≤ L^Acard :=
    harmonic_pattern_card_power probes r t hrt hL hA hslots
  apply physical_pattern_error_power
    (fun g : groups => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ))
    hmass (fun _ => rfl) probes r t hL0 hcard
  intro i aux
  exact hbase groups hgroups probes r t hrt Q h ξ hξ0 i aux
    (harmonic_pattern_bound_power probes r t hL1 hq hx Q hQ hξ i)
    a a' pool hpool α β γ α' β' γ' hα hβ hγ hα' hβ' hγ'
    U V hUlo hUhi hVlo hVhi k hk j hj

end Bounty
