section
open Finset
def physicalGroupMarkEmbedding {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) (g : G) : PhysicalSlots J ell ↪ ℕ :=
  (labels g).trans ⟨Subtype.val, Subtype.val_injective⟩

def physicalGroupMarks {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) (g : G) : Finset ℕ :=
  univ.map (physicalGroupMarkEmbedding labels g)

theorem mem_physical_group_marks {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) (g : G) (p : ℕ) :
    p ∈ physicalGroupMarks labels g ↔ ∃ s, (labels g s).val = p := by
  simp only [physicalGroupMarks, mem_map, mem_univ, true_and]
  rfl

theorem physical_group_marks_card {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) (g : G) :
    (physicalGroupMarks labels g).card = J + ell := by
  simp only [physicalGroupMarks, card_map, card_univ, Fintype.card_sum, Fintype.card_fin]

theorem physical_group_marks_subset {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) (g : G) : physicalGroupMarks labels g ⊆ P g := by
  intro p hp
  obtain ⟨s, rfl⟩ := (mem_physical_group_marks labels g p).mp hp
  exact (labels g s).property

theorem physical_group_marks_divisor_subset {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (n : ℤ) (labels : PhysicalMarksAt P J ell n) (g : G) :
    physicalGroupMarks labels.val g ⊆ physicalDivisorPool P g n := by
  intro p hp
  obtain ⟨s, rfl⟩ := (mem_physical_group_marks labels.val g p).mp hp
  exact mem_filter.mpr ⟨(labels.val g s).property, labels.property g s⟩

/- The excess divisor count equals the number of unmarked dividing
primes; natural subtraction causes no loss on a physical state. -/
theorem physical_unmarked_divisor_count {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (n : ℤ) (labels : PhysicalMarksAt P J ell n) (g : G) :
    ((P g \ physicalGroupMarks labels.val g).filter (fun p : ℕ => (p : ℤ) ∣ n)).card =
      physicalOmega P g n - (J + ell) := by
  have he : (P g \ physicalGroupMarks labels.val g).filter (fun p : ℕ => (p : ℤ) ∣ n) =
      physicalDivisorPool P g n \ physicalGroupMarks labels.val g := by
    ext p
    simp only [mem_filter, mem_sdiff, physicalDivisorPool]
    tauto
  rw [he, card_sdiff_of_subset (physical_group_marks_divisor_subset n labels g), physical_group_marks_card]
  rfl

/- A half-power of the excess count is one square-root damping factor
for each unmarked dividing prime. -/
theorem physical_group_damping_as_unmarked {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (n : ℤ) (labels : PhysicalMarksAt P J ell n) (g : G) {q : ℝ} (hq : 0 ≤ q) :
    q^(((physicalOmega P g n - (J + ell) : ℕ) : ℝ) / 2) =
      (Real.sqrt q)^((P g \ physicalGroupMarks labels.val g).filter (fun p : ℕ => (p : ℤ) ∣ n)).card := by
  rw [physical_unmarked_divisor_count n labels g, Real.sqrt_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul hq]
  congr 1
  ring

theorem physical_damping_as_unmarked {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (n : ℤ) (labels : PhysicalMarksAt P J ell n)
    {q : ℝ} (hq : 0 ≤ q) :
    physicalDamping P J ell q n = ∏ g,
      (Real.sqrt q)^((P g \ physicalGroupMarks labels.val g).filter (fun p : ℕ => (p : ℤ) ∣ n)).card := by
  unfold physicalDamping
  apply prod_congr rfl
  intro g _
  exact physical_group_damping_as_unmarked n labels g hq
end

section
open Finset
/- Summing a nonnegative product law over embeddings loses mass relative
to summing over all functions, for any finite slot type. -/
theorem embedding_weight_bound {S P : Type*} [Fintype S] [Fintype P]
    (w : P → ℝ) (hw : ∀ p, 0 ≤ w p) :
    (∑ f : S ↪ P, ∏ s, w (f s)) ≤ (∑ p, w p)^(Fintype.card S) := by
  classical
  let e : (S ↪ P) ↪ (S → P) := ⟨fun f => f, fun _ _ h => Function.Embedding.ext (fun s => congrFun h s)⟩
  calc
    _ = ∑ f ∈ univ.map e, ∏ s, w (f s) := by rw [sum_map]; rfl
    _ ≤ ∑ f : S → P, ∏ s, w (f s) :=
      sum_le_univ_sum_of_nonneg (fun f => prod_nonneg (fun s _ => hw (f s)))
    _ = ∏ _s : S, ∑ p, w p := (Fintype.prod_sum (fun (_s : S) p => w p)).symm
    _ = _ := by simp

theorem normalized_embedding_weight_bound {S P : Type*} [Fintype S] [Fintype P]
    (w : P → ℝ) (hw : ∀ p, 0 ≤ w p) {V : ℝ} (hV : 0 < V) (hsum : ∑ p, w p = V) :
    (∑ f : S ↪ P, (∏ s, w (f s)) / V^(Fintype.card S)) ≤ 1 := by
  rw [← sum_div, div_le_one (pow_pos hV _)]
  simpa only [hsum] using embedding_weight_bound (S := S) w hw

/- Independent-prime weight of a tuple of distinct ordered mark lists. -/
noncomputable def physicalMarkPriorMass {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (labels : PhysicalMarkLists P J ell) : ℝ :=
  ∏ g, (∏ s, 1 / ((labels g s).val : ℝ)) / (V g)^(J + ell)




/- Summing over all physical mark lists gives mass at most one. No
normalization of the actual integer-position starting measure is assumed. -/
theorem physical_mark_prior_total_mass {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) :
    (∑ labels : PhysicalMarkLists P J ell, physicalMarkPriorMass V labels) ≤ 1 := by
  classical
  have he : (∑ labels : PhysicalMarkLists P J ell, physicalMarkPriorMass V labels) =
      ∏ g, ∑ f : PhysicalSlots J ell ↪ ↥(P g), (∏ s, 1 / ((f s).val : ℝ)) / (V g)^(J + ell) :=
    (Fintype.prod_sum (fun g (f : PhysicalSlots J ell ↪ ↥(P g)) =>
      (∏ s, 1 / ((f s).val : ℝ)) / (V g)^(J + ell))).symm
  rw [he]
  apply prod_le_one₀
  · intro g _
    exact sum_nonneg (fun f _ => div_nonneg (prod_nonneg (fun s _ => by positivity)) (pow_nonneg (hV g).le _))
  · intro g _
    have hs : (∑ p : P g, 1 / (p.val : ℝ)) = V g := by
      rw [sum_coe_sort (P g) (fun p : ℕ => 1 / (p : ℝ))]
      exact hMass g
    have hh := normalized_embedding_weight_bound (S := PhysicalSlots J ell)
      (fun p : P g => 1 / (p.val : ℝ)) (fun _ => by positivity) (hV g) hs
    simpa only [Fintype.card_sum, Fintype.card_fin] using hh

/- The prior weight is the original state normalization times the
product of the marked-prime divisibility probabilities. -/
theorem physical_mark_prior_factor {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (labels : PhysicalMarkLists P J ell) :
    physicalMarkPriorMass V labels = physicalStateMass V J ell *
      ∏ g, ∏ s, 1 / ((labels g s).val : ℝ) := by
  unfold physicalMarkPriorMass physicalStateMass
  rw [← prod_mul_distrib]
  apply prod_congr rfl
  intro g _
  ring
end

section
open Finset
abbrev PhysicalPrime {G : Type*} (P : G → Finset ℕ) := Σ g, ↥(P g)


theorem _root_.Bounty.NeZeroReindexAux.seed {N M : ℕ} {P : Fin N → Finset ℕ}
    [∀ z : Bounty.PhysicalPrime P, NeZero z.2.val]
    (groups : Finset (Fin N)) (e : {g // g ∉ groupsᶜ} ≃ Fin M) :
    let _ : ∀ g (z : P (e.symm g).val), NeZero z.val :=
      fun g z => inferInstanceAs (NeZero (⟨(e.symm g).val, z⟩ : Bounty.PhysicalPrime P).2.val)
    True := True.intro


def physicalMarkInjection {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) : (Σ _g : G, PhysicalSlots J ell) ↪ PhysicalPrime P :=
  Function.Embedding.sigmaMap (Function.Embedding.refl G) labels

def physicalMarkedPrimes {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell) : Finset (PhysicalPrime P) :=
  univ.map (physicalMarkInjection labels)

theorem mem_physical_marked_primes {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell) (p : PhysicalPrime P) :
    p ∈ physicalMarkedPrimes labels ↔ p.2.val ∈ physicalGroupMarks labels p.1 := by
  rcases p with ⟨g, p⟩
  rw [mem_physical_group_marks]
  constructor
  · intro hp
    obtain ⟨⟨h, s⟩, _, he⟩ := mem_map.mp hp
    change (⟨h, labels h s⟩ : PhysicalPrime P) = ⟨g, p⟩ at he
    have hg : h = g := congrArg Sigma.fst he
    cases hg
    exact ⟨s, congrArg Subtype.val (eq_of_heq (Sigma.mk.inj_iff.mp he).2)⟩
  · rintro ⟨s, hs⟩
    apply mem_map.mpr
    refine ⟨⟨g, s⟩, mem_univ _, ?_⟩
    change (⟨g, labels g s⟩ : PhysicalPrime P) = ⟨g, p⟩
    exact congrArg (Sigma.mk g) (Subtype.ext hs)

theorem physical_marked_primes_card {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell) :
    (physicalMarkedPrimes labels).card = (J + ell) * Fintype.card G := by
  simp only [physicalMarkedPrimes, card_map, card_univ, Fintype.card_sigma,
    Fintype.card_sum, Fintype.card_fin, sum_const, card_univ, nsmul_eq_mul]
  change Fintype.card G * (J + ell) = (J + ell) * Fintype.card G
  exact Nat.mul_comm _ _

/- Divisibility of the tagged marked subset is exactly physical
admissibility of the ordered mark lists at the given position. -/
theorem physical_marked_divisibility_iff {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell) (n : ℤ) :
    (∀ p ∈ physicalMarkedPrimes labels, (p.2.val : ℤ) ∣ n) ↔
      ∀ g s, ((labels g s).val : ℤ) ∣ n := by
  constructor
  · intro h g s
    apply h ⟨g, labels g s⟩
    rw [mem_physical_marked_primes, mem_physical_group_marks]
    exact ⟨s, rfl⟩
  · intro h p hp
    obtain ⟨s, hs⟩ := (mem_physical_group_marks labels p.1 p.2.val).mp
      ((mem_physical_marked_primes labels p).mp hp)
    rw [← hs]
    exact h p.1 s

/- If the prime groups are disjoint, forgetting a prime's group tag
is injective, as required by the grouped residue theorem. -/
theorem physical_prime_value_injective {G : Type*} {P : G → Finset ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h))) :
    Function.Injective (fun p : PhysicalPrime P => p.2.val) := by
  rintro ⟨g, p⟩ ⟨h, q⟩ hpq
  change p.val = q.val at hpq
  have hg : g = h := by
    by_contra hne
    apply (Finset.disjoint_left.mp (hP hne)) p.property
    rw [hpq]
    exact q.property
  cases hg
  exact congrArg (Sigma.mk g) (Subtype.ext hpq)
end

section
open Finset Classical
theorem unmarked_damping_product {T : Type*} [DecidableEq T]
    (pool marked : Finset T) (hit : T → Prop) [DecidablePred hit] (q : ℝ) :
    (∏ p ∈ pool, if p ∈ marked then (1 : ℝ) else if hit p then q else 1) =
      q^((pool \ marked).filter hit).card := by
  have he : ∀ p, (if p ∈ marked then (1 : ℝ) else if hit p then q else 1) =
      if p ∉ marked ∧ hit p then q else 1 := by
    intro p
    by_cases hm : p ∈ marked <;> by_cases hh : hit p <;> simp only [hm, hh, if_true, if_false, not_true_eq_false, not_false_eq_true, false_and, true_and]
  have hf : pool.filter (fun p => p ∉ marked ∧ hit p) = (pool \ marked).filter hit := by
    ext p
    simp only [mem_filter, mem_sdiff]
    tauto
  simp only [he, prod_ite, prod_const, one_pow, mul_one, hf]

/- The full-excess damping product is a power of the number of unmarked
hits in the tagged prime pool. -/
theorem physical_count_damping_as_pool {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (n : ℤ) (labels : PhysicalMarksAt P J ell n) (q : ℝ) :
    (∏ g, q^(physicalOmega P g n - (J + ell))) =
      q^((univ \ physicalMarkedPrimes labels.val).filter
        (fun p : PhysicalPrime P => (p.2.val : ℤ) ∣ n)).card := by
  classical
  rw [← unmarked_damping_product]
  rw [Fintype.prod_sigma]
  apply prod_congr rfl
  intro g _
  simp only [mem_physical_marked_primes]
  rw [prod_coe_sort (P g) (fun p : ℕ => if p ∈ physicalGroupMarks labels.val g then (1 : ℝ)
    else if (p : ℤ) ∣ n then q else 1), unmarked_damping_product,
    physical_unmarked_divisor_count n labels g]

/- The indicator of simultaneous divisibility is the product of its
individual zero-one indicators. -/
theorem finite_divisibility_indicator_product {T : Type*} (S : Finset T)
    (hit : T → Prop) [DecidablePred hit] :
    (∏ p ∈ S, if hit p then (1 : ℝ) else 0) = if ∀ p ∈ S, hit p then 1 else 0 := by
  classical
  by_cases h : ∀ p ∈ S, hit p
  · rw [if_pos h]
    exact prod_eq_one (fun p hp => if_pos (h p hp))
  · rw [if_neg h]
    push Not at h
    obtain ⟨p, hp, hn⟩ := h
    exact prod_eq_zero hp (if_neg hn)

/- A weight defined for all mark lists, including those not dividing
n. Its parameter is the per-unmarked-prime damping, not its square. -/
noncomputable def physicalVertexWeight {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell) (q : ℝ) (n : ℤ) : ℝ :=
  if ∀ g s, ((labels g s).val : ℤ) ∣ n then
    ∏ g, q^(physicalOmega P g n - (J + ell)) else 0

/- This is exactly the vertex factor in grouped residue replacement. -/
theorem physical_vertex_weight_factor {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell) (q : ℝ) (n : ℤ) :
    physicalVertexWeight labels q n =
      (∏ p ∈ physicalMarkedPrimes labels, if (p.2.val : ℤ) ∣ n then (1 : ℝ) else 0) *
        q^((univ \ physicalMarkedPrimes labels).filter
          (fun p : PhysicalPrime P => (p.2.val : ℤ) ∣ n)).card := by
  classical
  rw [finite_divisibility_indicator_product]
  simp only [physical_marked_divisibility_iff]
  unfold physicalVertexWeight
  by_cases h : ∀ g s, ((labels g s).val : ℤ) ∣ n
  · simp only [if_pos h, one_mul]
    exact physical_count_damping_as_pool n ⟨labels, h⟩ q
  · simp only [if_neg h, zero_mul]

/- On an actual physical state, square-root vertex damping is exactly
the original physical endpoint damping. -/
theorem physical_vertex_weight_endpoint {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (n : ℤ) (labels : PhysicalMarksAt P J ell n)
    {q : ℝ} (hq : 0 ≤ q) :
    physicalVertexWeight labels.val (Real.sqrt q) n = physicalDamping P J ell q n := by
  rw [physicalVertexWeight, if_pos labels.property, physical_damping_as_unmarked n labels hq]
  apply prod_congr rfl
  intro g _
  rw [physical_unmarked_divisor_count n labels g]

/- Repeated vertex factors multiply their per-prime damping parameters;
the divisibility indicator remains a single zero-one indicator. -/
theorem physical_vertex_weight_mul {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell) (q r : ℝ) (n : ℤ) :
    physicalVertexWeight labels q n * physicalVertexWeight labels r n =
      physicalVertexWeight labels (q * r) n := by
  unfold physicalVertexWeight
  by_cases h : ∀ g s, ((labels g s).val : ℤ) ∣ n
  · simp only [if_pos h]
    rw [← prod_mul_distrib]
    apply prod_congr rfl
    intro g _
    exact (mul_pow q r _).symm
  · simp only [if_neg h, mul_zero]
end

section
open Finset
theorem physical_prime_pool_coprime {G : Type*} {P : G → Finset ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime) :
    Pairwise (fun p q : PhysicalPrime P => Nat.Coprime p.2.val q.2.val) := by
  intro p q hpq
  exact (Nat.coprime_primes (hprime p.1 p.2.val p.2.property)
    (hprime q.1 q.2.val q.2.property)).mpr ((physical_prime_value_injective hP).ne hpq)

theorem physical_prime_harmonic_sum {G : Type*} [Fintype G]
    (P : G → Finset ℕ) :
    (∑ p : PhysicalPrime P, 1 / (p.2.val : ℝ)) = ∑ g, ∑ p ∈ P g, 1 / (p : ℝ) := by
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro g _
  exact sum_coe_sort (P g) (fun p : ℕ => 1 / (p : ℝ))

theorem physical_prime_harmonic_bound {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {V : ℝ} (hV : ∀ g, (∑ p ∈ P g, 1 / (p : ℝ)) ≤ V) :
    (∑ p : PhysicalPrime P, 1 / (p.2.val : ℝ)) ≤ Fintype.card G * V := by
  rw [physical_prime_harmonic_sum]
  calc
    _ ≤ ∑ _g : G, V := sum_le_sum (fun g _ => hV g)
    _ = _ := by simp

/- All marked labels are distinct in the tagged pool, so their
individual divisibility probabilities form the original ordered product. -/
theorem physical_marked_probability_product {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell) :
    (∏ p ∈ physicalMarkedPrimes labels, 1 / (p.2.val : ℝ)) =
      ∏ g, ∏ s, 1 / ((labels g s).val : ℝ) := by
  rw [physicalMarkedPrimes, prod_map, Fintype.prod_sigma]
  rfl

theorem physical_mark_prior_tagged_factor {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (labels : PhysicalMarkLists P J ell) :
    physicalMarkPriorMass V labels = physicalStateMass V J ell *
      ∏ p ∈ physicalMarkedPrimes labels, 1 / (p.2.val : ℝ) := by
  rw [physical_mark_prior_factor, physical_marked_probability_product]

/- The state-free physical vertex product is exactly the local residue
product, with arbitrary offsets and damping values. -/
theorem physical_vertex_path_factorization {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : ℕ → PhysicalMarkLists P J ell)
    (visits : Finset ℕ) (offset : ℕ → ℤ) (q : ℕ → ℝ) (n : ℤ) :
    (∏ j ∈ visits, physicalVertexWeight (labels j) (q j) (n + offset j)) =
      ∏ p : PhysicalPrime P, activeResidueWeight visits
        (visits.filter (fun j => p ∈ physicalMarkedPrimes (labels j)))
        (fun j => -(offset j : ZMod p.2.val)) (fun j => 1 - q j) (n : ZMod p.2.val) := by
  classical
  simp only [physical_vertex_weight_factor]
  exact physical_path_divisibility_factorization (fun p : PhysicalPrime P => p.2.val)
    univ visits (fun j => physicalMarkedPrimes (labels j)) offset q n (fun _ _ => subset_univ _)
end

section
open Filter Finset
open scoped Topology
theorem eventually_physical_vertex_replacement {a c d C V E γ : ℝ}
    (ha : 0 ≤ a) (hc : 0 < c) (hd : 0 < d) (had : a + d < 1)
    (hC : 0 < C) (hV : 0 < V) (hE : 0 ≤ E) (hγ : 0 < γ) (J ell : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type) [Fintype G] [DecidableEq G]
      (P : G → Finset ℕ) [∀ p : PhysicalPrime P, NeZero p.2.val]
      (labels : ℕ → PhysicalMarkLists P J ell) (offset : ℕ → ℤ) (q : ℕ → ℝ) (N : ℕ) (z : ℤ),
      let n := 2 * Nat.ceil (L^a)
      let visits := range (n + 1)
      Pairwise (fun g h => Disjoint (P g) (P h)) →
      (∀ g p, p ∈ P g → p.Prime) →
      (Fintype.card G : ℝ) ≤ C * Real.log L →
      (∀ g, (∑ p ∈ P g, 1 / (p : ℝ)) ≤ V) →
      (∀ g p, p ∈ P g → Real.exp (L^c) ≤ (p : ℝ)) →
      (∀ g p, p ∈ P g → (p : ℝ) ≤ Real.exp (L^d)) →
      (∀ j ∈ visits, 0 ≤ q j ∧ q j ≤ 1) → 0 < N → γ * L ≤ Real.log (N : ℝ) →
      |((∑ k ∈ Ico z (z + N), ∏ j ∈ visits,
          physicalVertexWeight (labels j) (q j) (k + offset j)) / (N : ℝ)) -
        poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) univ visits
          (fun p => visits.filter (fun j => p ∈ physicalMarkedPrimes (labels j)))
          (fun p j => -(offset j : ZMod p.2.val)) (fun j => 1 - q j)| ≤
        Real.exp (-E * n * Real.log L) *
          poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) univ visits
            (fun p => visits.filter (fun j => p ∈ physicalMarkedPrimes (labels j)))
            (fun p j => -(offset j : ZMod p.2.val)) (fun j => 1 - q j) := by
  filter_upwards [eventually_grouped_path_replacement ha hc hd had hC hV hE hγ (J + ell)] with L hL
  intro G _ _ P _ labels offset q N z
  dsimp only
  intro hdis hprime hs hH hmin hmax hq hN hNb
  have hcop : ((univ : Finset (PhysicalPrime P)) : Set (PhysicalPrime P)).Pairwise
      (fun p r => Nat.Coprime p.2.val r.2.val) := by
    intro p _ r _ hne
    exact physical_prime_pool_coprime hdis hprime hne
  have he := hL (PhysicalPrime P) (fun p => p.2.val) univ (Fintype.card G)
    (fun j => physicalMarkedPrimes (labels j)) offset q N z hcop
    (physical_prime_value_injective hdis).injOn hs (physical_prime_harmonic_bound P hH)
    (fun p _ => hmin p.1 p.2.val p.2.property) (fun p _ => hmax p.1 p.2.val p.2.property)
    (fun _ _ => subset_univ _) (fun j _ => by rw [physical_marked_primes_card]) hq hN hNb
  simpa only [← physical_vertex_weight_factor] using he
end

section
open Finset
/- A path of N+1 edges visits N interior vertices twice. -/
theorem adjacent_endpoint_product (d : ℕ → ℝ) (N : ℕ) :
    (∏ j ∈ range (N + 1), d j * d (j + 1)) =
      d 0 * d (N + 1) * ∏ j ∈ range N, (d (j + 1))^2 := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [prod_range_succ, ih, prod_range_succ]
    ring

/- The zero-one state condition is preserved when two endpoint damping
factors meet at an interior vertex. -/
theorem physical_vertex_endpoint_square {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell)
    {q : ℝ} (hq : 0 ≤ q) (n : ℤ) :
    (physicalVertexWeight labels (Real.sqrt q) n)^2 = physicalVertexWeight labels q n := by
  rw [pow_two, physical_vertex_weight_mul, Real.mul_self_sqrt hq]

/- Edge endpoint factors equal the vertex damping factors used in the
residue expression, including when a divisibility condition fails. -/
theorem physical_edge_endpoint_product {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : ℕ → PhysicalMarkLists P J ell)
    (position : ℕ → ℤ) {q : ℝ} (hq : 0 ≤ q) (N : ℕ) :
    (∏ j ∈ range (N + 1),
      physicalVertexWeight (labels j) (Real.sqrt q) (position j) *
        physicalVertexWeight (labels (j + 1)) (Real.sqrt q) (position (j + 1))) =
      physicalVertexWeight (labels 0) (Real.sqrt q) (position 0) *
        physicalVertexWeight (labels (N + 1)) (Real.sqrt q) (position (N + 1)) *
        ∏ j ∈ range N, physicalVertexWeight (labels (j + 1)) q (position (j + 1)) := by
  rw [adjacent_endpoint_product]
  simp only [physical_vertex_endpoint_square _ hq]
end

section
open Finset
/- A product of uniform residue laws assigns simultaneous zero residues
at marked coordinates probability equal to the product of their reciprocals. -/
theorem uniform_marked_residue_probability {ι : Type*} [Fintype ι] [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)] (marked : Finset ι) :
    (∑ r : ∀ i, ZMod (m i), ∏ i,
      (if i ∈ marked then (if r i = 0 then (1 : ℝ) else 0) else 1) / (m i : ℝ)) =
      ∏ i ∈ marked, 1 / (m i : ℝ) := by
  classical
  have he : (∑ r : ∀ i, ZMod (m i), ∏ i,
      (if i ∈ marked then (if r i = 0 then (1 : ℝ) else 0) else 1) / (m i : ℝ)) =
      ∏ i, ∑ a : ZMod (m i), (if i ∈ marked then (if a = 0 then (1 : ℝ) else 0) else 1) / (m i : ℝ) :=
    (Fintype.prod_sum (fun i (a : ZMod (m i)) =>
      (if i ∈ marked then (if a = 0 then (1 : ℝ) else 0) else 1) / (m i : ℝ))).symm
  rw [he]
  have hlocal : ∀ i, (∑ a : ZMod (m i),
      (if i ∈ marked then (if a = 0 then (1 : ℝ) else 0) else 1) / (m i : ℝ)) =
      if i ∈ marked then 1 / (m i : ℝ) else 1 := by
    intro i
    have hm : (m i : ℝ) ≠ 0 := by exact_mod_cast NeZero.ne (m i)
    by_cases hi : i ∈ marked
    · simp only [if_pos hi]
      rw [← sum_div]
      simp
    · simp [hi, ZMod.card, hm]
  simp only [hlocal, prod_ite_mem, univ_inter]

/- The independent-residue mass of an initial marked state is exactly
the prior whose total mass was bounded using injective tuples. -/
theorem physical_initial_residue_mass {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : G → ℝ) (labels : PhysicalMarkLists P J ell) :
    physicalStateMass V J ell *
      (∑ r : ∀ p : PhysicalPrime P, ZMod p.2.val, ∏ p : PhysicalPrime P,
        (if p ∈ physicalMarkedPrimes labels then (if r p = 0 then (1 : ℝ) else 0) else 1) / (p.2.val : ℝ)) =
      physicalMarkPriorMass V labels := by
  rw [uniform_marked_residue_probability, ← physical_mark_prior_tagged_factor]

/- After averaging the residue coordinates, the total initial physical
mark mass is at most one. This is an explicit averaging identity, not an
assumed normalization of the integer-position state count. -/
theorem physical_initial_residue_total_mass {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) :
    (∑ labels : PhysicalMarkLists P J ell, physicalStateMass V J ell *
      (∑ r : ∀ p : PhysicalPrime P, ZMod p.2.val, ∏ p : PhysicalPrime P,
        (if p ∈ physicalMarkedPrimes labels then (if r p = 0 then (1 : ℝ) else 0) else 1) / (p.2.val : ℝ))) ≤ 1 := by
  simp only [physical_initial_residue_mass]
  exact physical_mark_prior_total_mass V hV hMass
end

section
open Finset
noncomputable def physicalEndpointSchedule (q : ℝ) (edges j : ℕ) : ℝ :=
  if j = 0 ∨ j = edges then Real.sqrt q else q

theorem physical_endpoint_schedule_unit {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (edges j : ℕ) :
    0 ≤ physicalEndpointSchedule q edges j ∧ physicalEndpointSchedule q edges j ≤ 1 := by
  have hs : Real.sqrt q ≤ 1 := by simpa only [Real.sqrt_one] using Real.sqrt_le_sqrt hq1
  unfold physicalEndpointSchedule
  split_ifs
  · exact ⟨Real.sqrt_nonneg q, hs⟩
  · exact ⟨hq0, hq1⟩

theorem range_product_endpoints (f : ℕ → ℝ) (N : ℕ) :
    (∏ j ∈ range (N + 2), f j) = f 0 * f (N + 1) * ∏ j ∈ range N, f (j + 1) := by
  rw [prod_range_succ, prod_range_succ']
  ring

/- The entire edge damping is precisely the vertex product to which
the physical residue-replacement estimate applies. -/
theorem physical_endpoint_schedule_product {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (labels : ℕ → PhysicalMarkLists P J ell)
    (position : ℕ → ℤ) {q : ℝ} (hq : 0 ≤ q) (N : ℕ) :
    (∏ j ∈ range (N + 1),
      physicalVertexWeight (labels j) (Real.sqrt q) (position j) *
        physicalVertexWeight (labels (j + 1)) (Real.sqrt q) (position (j + 1))) =
      ∏ j ∈ range (N + 2), physicalVertexWeight (labels j)
        (physicalEndpointSchedule q (N + 1) j) (position j) := by
  rw [physical_edge_endpoint_product labels position hq N, range_product_endpoints]
  have h0 : physicalEndpointSchedule q (N + 1) 0 = Real.sqrt q := by simp [physicalEndpointSchedule]
  have hlast : physicalEndpointSchedule q (N + 1) (N + 1) = Real.sqrt q := by simp [physicalEndpointSchedule]
  rw [h0, hlast]
  congr 1
  apply prod_congr rfl
  intro j hj
  have hjN : j < N := mem_range.mp hj
  have hne0 : j + 1 ≠ 0 := by omega
  have hnelast : j + 1 ≠ N + 1 := by omega
  simp only [physicalEndpointSchedule, hne0, hnelast, or_self, if_false]
end

section
open Finset
/- Structural constraints of an edge, with no integer position. -/
def physicalListAdmissible {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (L R : PhysicalMarkLists P J ell) : Prop :=
  physicalSharedCompatible C L R ∧ physicalAuxAvoids C aux L ∧ physicalAuxAvoids C aux R

theorem physical_admissible_split {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (x y : PhysicalState P J ell) :
    physicalAdmissible C aux k x y ↔
      physicalListAdmissible C aux x.2.val y.2.val ∧ y.1 = x.1 + k * (physicalD C x.2.val aux : ℕ) := by
  unfold physicalAdmissible physicalListAdmissible
  tauto

/- The bare scalar contains all list constraints, normalized label
weights, the list coefficient, and the phase. It has no position or damping. -/
noncomputable def physicalBarePatternScalar {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (L R : PhysicalMarkLists P J ell) : ℂ := by
  classical
  exact if physicalListAdmissible C aux L R then
    ((physicalAuxMass V C aux * physicalCompletionMass V C ell : ℝ) : ℂ) * K L R aux *
      physicalPhase ζ (physicalD C L aux) else 0

/- An actual edge is a bare scalar times its two endpoint damping
factors, and its only remaining support condition is translation. -/
theorem physical_edge_scalar_factor {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J)) (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) :
    physicalEdgeCoeff V C q ζ k K aux x y =
      if y.1 = x.1 + k * (physicalD C x.2.val aux : ℕ) then
        physicalBarePatternScalar V C ζ K aux x.2.val y.2.val *
          ((physicalDamping P J ell q x.1 * physicalDamping P J ell q y.1 : ℝ) : ℂ) else 0 := by
  classical
  by_cases hs : physicalListAdmissible C aux x.2.val y.2.val
  · by_cases ht : y.1 = x.1 + k * (physicalD C x.2.val aux : ℕ)
    · have ha := (physical_admissible_split C aux k x y).mpr ⟨hs, ht⟩
      simp only [physicalEdgeCoeff, physicalBarePatternScalar, if_pos hs, if_pos ht, if_pos ha]
      push_cast
      ring
    · have ha : ¬ physicalAdmissible C aux k x y := fun h => ht ((physical_admissible_split C aux k x y).mp h).2
      simp only [physicalEdgeCoeff, if_neg ha, if_neg ht]
  · have ha : ¬ physicalAdmissible C aux k x y := fun h => hs ((physical_admissible_split C aux k x y).mp h).1
    simp only [physicalEdgeCoeff, physicalBarePatternScalar, if_neg ha, if_neg hs, zero_mul, ite_self]



end

section
open Finset
def physicalPermuteLabels {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (σ : PhysicalPermutations G J ell) (L : PhysicalMarkLists P J ell) : PhysicalMarkLists P J ell :=
  fun g => (σ g).toEmbedding.trans (L g)




/- Translation of a labeled edge is determined by its source marks. -/
noncomputable def physicalBareStep {G I : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} {patterns : Finset I} (C : I → G → Finset (Fin J)) (k : I → ℤ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L : PhysicalMarkLists P J ell) : ℤ :=
  k a.2.2.1.val * (physicalD (C a.2.2.1.val) (physicalPermuteLabels a.1 L) a.2.2.2 : ℕ)

/- All scalar factors of a labeled edge except its vertex damping and
translation condition. The expression is independent of the starting integer. -/
noncomputable def physicalBareLabeledScalar {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : I → ℝ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L R : PhysicalMarkLists P J ell) : ℂ :=
  (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
    (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
      physicalBarePatternScalar V (C a.2.2.1.val) (ζ a.2.2.1.val) (K a.2.2.1.val) a.2.2.2
        (physicalPermuteLabels a.1 L) (physicalPermuteLabels a.2.1 R)

section

variable
  {G I : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (V : G → ℝ)
  (patterns : Finset I)
  (C : I → G → Finset (Fin J))

include G I sharedInstance1 sharedInstance2 P J ell V patterns C

/- Exact factorization of the individual labeled physical coefficient. -/
theorem physical_labeled_vertex_factor  {q : ℝ} (hq : 0 ≤ q) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (x y : PhysicalState P J ell) :
    physicalLabeledCoeff V patterns C q ζ k K a x y =
      if y.1 = x.1 + physicalBareStep C k a x.2.val then
        physicalBareLabeledScalar V patterns C ζ K a x.2.val y.2.val *
          ((physicalVertexWeight x.2.val (Real.sqrt q) x.1 *
            physicalVertexWeight y.2.val (Real.sqrt q) y.1 : ℝ) : ℂ) else 0 := by
  unfold physicalLabeledCoeff
  rw [physical_edge_scalar_factor, mul_ite, mul_zero]
  change (if y.1 = x.1 + physicalBareStep C k a x.2.val then
    (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
      (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
      (physicalBarePatternScalar V (C a.2.2.1.val) (ζ a.2.2.1.val) (K a.2.2.1.val)
        a.2.2.2 (physicalPermuteLabels a.1 x.2.val) (physicalPermuteLabels a.2.1 y.2.val) *
          ((physicalDamping P J ell q x.1 * physicalDamping P J ell q y.1 : ℝ) : ℂ))
    else 0) = _
  rw [physical_vertex_weight_endpoint x.1 x.2 hq, physical_vertex_weight_endpoint y.1 y.2 hq]
  unfold physicalBareLabeledScalar
  split_ifs <;> ring

/- The bare scalar vanishes whenever its structural list conditions fail. -/
theorem physical_bare_scalar_zero_of_incompatible  (ζ : I → ℝ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L R : PhysicalMarkLists P J ell)
    (h : ¬ physicalListAdmissible (C a.2.2.1.val) a.2.2.2
      (physicalPermuteLabels a.1 L) (physicalPermuteLabels a.2.1 R)) :
    physicalBareLabeledScalar V patterns C ζ K a L R = 0 := by
  simp only [physicalBareLabeledScalar, physicalBarePatternScalar, if_neg h, mul_zero]

end

end

section
open Finset
noncomputable def physicalBareOffset {G I : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} {patterns : Finset I}
    (C : I → G → Finset (Fin J)) (k : ℕ → I → ℤ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) : ℕ → ℤ
  | 0 => 0
  | j + 1 => physicalBareOffset C k a L edges j + physicalBareStep C (k (edges - 1 - j)) (a j) (L j)

/- Every bare step obeys the same finite displacement bound as a
physical edge, without requiring divisibility at any integer position. -/
theorem physical_bare_step_bound {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} {patterns : Finset I}
    (C : I → G → Finset (Fin J)) (k : I → ℤ)
    (a : PhysicalEdgeLabels P J ell patterns C) (L : PhysicalMarkLists P J ell) :
    (physicalBareStep C k a L).natAbs ≤ physicalOperatorStepBound P J ell patterns C k := by
  unfold physicalBareStep
  rw [Int.natAbs_mul, Int.natAbs_natCast]
  exact (Nat.mul_le_mul_left _ (physical_D_le_max P J ell (C a.2.2.1.val)
    (physicalPermuteLabels a.1 L) a.2.2.2)).trans
    (le_sup (f := fun i => physicalStepBound P J ell (C i) (k i)) a.2.2.1.property)









end

section
open Finset



/- The coefficient of a path before imposing its vertex divisibilities. -/
noncomputable def physicalBareWalkScalar {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : ℕ → I → ℝ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) : ℂ :=
  ∏ j ∈ range edges, physicalBareLabeledScalar V patterns C (ζ (edges - 1 - j))
    (K (edges - 1 - j)) (a j) (L j) (L (j + 1))









end

section
open Finset Classical
section

variable
  {G R : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  [sharedInstance3 : AddCommMonoid R]
  (P : G → Finset ℕ)
  (J ell : ℕ)

include G R sharedInstance1 sharedInstance2 sharedInstance3 P J ell

theorem physical_cutoff_sum  (positions : Finset ℤ)
    (f : PhysicalState P J ell → R) :
    (∑ x ∈ physicalCutoff P J ell positions, f x) =
      ∑ n ∈ positions, ∑ L : PhysicalMarksAt P J ell n, f ⟨n, L⟩ := by
  classical
  let _ := physicalCutoffFintype P J ell positions
  unfold physicalCutoff
  rw [sum_map]
  change (∑ x : {x : PhysicalState P J ell // x.1 ∈ positions}, f x.val) = _
  rw [← Equiv.sum_comp (physicalCutoffEquiv P J ell positions).symm (fun x => f x.val),
    Fintype.sum_sigma]
  exact sum_coe_sort positions (fun n => ∑ L : PhysicalMarksAt P J ell n, f ⟨n, L⟩)

/- Restricting a complete cutoff to one position leaves precisely that
position's mark fiber. -/
theorem physical_cutoff_sum_at  (positions : Finset ℤ) (m : ℤ)
    (f : PhysicalMarkLists P J ell → R) :
    (∑ x ∈ physicalCutoff P J ell positions, if x.1 = m then f x.2.val else 0) =
      if m ∈ positions then ∑ L : PhysicalMarksAt P J ell m, f L.val else 0 := by
  classical
  rw [physical_cutoff_sum]
  have he : ∀ n : ℤ, (∑ L : PhysicalMarksAt P J ell n, if n = m then f L.val else 0) =
      if n = m then ∑ L : PhysicalMarksAt P J ell m, f L.val else 0 := by
    intro n
    by_cases h : n = m
    · subst n
      simp
    · simp [h]
  simp only [he]
  simp

/- A function vanishing on inadmissible mark lists can be summed over
all lists instead of the divisibility fiber. -/
theorem physical_marks_sum_all  (n : ℤ)
    (f : PhysicalMarkLists P J ell → R)
    (hzero : ∀ L, ¬ (∀ g s, ((L g s).val : ℤ) ∣ n) → f L = 0) :
    (∑ L : PhysicalMarksAt P J ell n, f L.val) = ∑ L : PhysicalMarkLists P J ell, f L := by
  exact (sum_congr_set {L : PhysicalMarkLists P J ell | ∀ g s, ((L g s).val : ℤ) ∣ n}
    f (fun L => f L.val) (fun _ _ => rfl) hzero).symm

end




end

section
open Finset Classical
theorem physical_labeled_row_as_marks {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (x : PhysicalState P J ell)
    (positions : Finset ℤ) (f : ℤ → PhysicalMarkLists P J ell → ℂ) :
    (∑ y ∈ physicalCutoff P J ell positions,
      physicalLabeledCoeff V patterns C q ζ k K a x y * f y.1 y.2.val) =
      if x.1 + physicalBareStep C k a x.2.val ∈ positions then
        ∑ R : PhysicalMarkLists P J ell,
          physicalBareLabeledScalar V patterns C ζ K a x.2.val R *
            ((physicalVertexWeight x.2.val (Real.sqrt q) x.1 *
              physicalVertexWeight R (Real.sqrt q) (x.1 + physicalBareStep C k a x.2.val) : ℝ) : ℂ) *
            f (x.1 + physicalBareStep C k a x.2.val) R
      else 0 := by
  let m := x.1 + physicalBareStep C k a x.2.val
  let F : PhysicalMarkLists P J ell → ℂ := fun R =>
    physicalBareLabeledScalar V patterns C ζ K a x.2.val R *
      ((physicalVertexWeight x.2.val (Real.sqrt q) x.1 *
        physicalVertexWeight R (Real.sqrt q) m : ℝ) : ℂ) * f m R
  have he : ∀ y : PhysicalState P J ell,
      physicalLabeledCoeff V patterns C q ζ k K a x y * f y.1 y.2.val =
        if y.1 = m then F y.2.val else 0 := by
    intro y
    rw [physical_labeled_vertex_factor V patterns C hq]
    change (if y.1 = m then _ else _) * _ = _
    rcases y with ⟨n, L⟩
    change (if n = m then _ else _) * _ = if n = m then _ else _
    by_cases h : n = m
    · subst n
      simp only [if_true]
      rfl
    · simp only [if_neg h, zero_mul]
  simp only [he]
  rw [physical_cutoff_sum_at]
  change (if m ∈ positions then ∑ L : PhysicalMarksAt P J ell m, F L.val else 0) =
    if m ∈ positions then ∑ L : PhysicalMarkLists P J ell, F L else 0
  congr 1
  apply physical_marks_sum_all P J ell m F
  intro L h
  simp only [F, physicalVertexWeight, if_neg h, mul_zero, Complex.ofReal_zero, zero_mul]
end

section
open Finset
noncomputable def finiteCutoffAction {X R : Type*} [Semiring R]
    (rows : Finset X) (K : ℕ → X → X → R) (terminal : X → R) : ℕ → X → R
  | 0, x => terminal x
  | r + 1, x => ∑ y ∈ rows, K r x y * finiteCutoffAction rows K terminal r y

theorem finite_cutoff_action_eq_finite {X R : Type*} [Semiring R]
    (rows : Finset X) (K : ℕ → X → X → R) (terminal : X → R) (r : ℕ) (x : rows) :
    finiteCutoffAction rows K terminal r x.val =
      finitePathAction (fun j (a b : rows) => K j a.val b.val)
        (fun a : rows => terminal a.val) r x := by
  induction r generalizing x with
  | zero => rfl
  | succ r ih =>
    rw [finiteCutoffAction, finitePathAction, ← sum_coe_sort]
    apply sum_congr rfl
    intro y _
    rw [ih y]
end

section
open Finset Classical
noncomputable def physicalBareAction {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (terminal : ℤ → PhysicalMarkLists P J ell → ℂ) :
    ℕ → ℤ → PhysicalMarkLists P J ell → ℂ
  | 0, n, L => terminal n L
  | r + 1, n, L => ∑ a : PhysicalEdgeLabels P J ell patterns C,
      if n + physicalBareStep C (k r) a L ∈ positions then
        ∑ R : PhysicalMarkLists P J ell,
          physicalBareLabeledScalar V patterns C (ζ r) (K r) a L R *
            ((physicalVertexWeight L (Real.sqrt q) n *
              physicalVertexWeight R (Real.sqrt q) (n + physicalBareStep C (k r) a L) : ℝ) : ℂ) *
            physicalBareAction V patterns C q ζ k K positions terminal r
              (n + physicalBareStep C (k r) a L) R
      else 0

/- Every finite physical iterate equals the corresponding bare
iterate. Divisibility failures are included with zero weight. -/
theorem physical_cutoff_action_eq_bare {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (terminal : ℤ → PhysicalMarkLists P J ell → ℂ)
    (r : ℕ) (x : PhysicalState P J ell) :
    finiteCutoffAction (physicalCutoff P J ell positions)
      (fun j a b => ∑ label : PhysicalEdgeLabels P J ell patterns C,
        physicalLabeledCoeff V patterns C q (ζ j) (k j) (K j) label a b)
      (fun a => terminal a.1 a.2.val) r x =
        physicalBareAction V patterns C q ζ k K positions terminal r x.1 x.2.val := by
  induction r generalizing x with
  | zero => rfl
  | succ r ih =>
    rw [finiteCutoffAction, physicalBareAction]
    simp only [sum_mul, ih]
    rw [sum_comm]
    apply sum_congr rfl
    intro a _
    exact physical_labeled_row_as_marks V patterns C hq (ζ r) (k r) (K r) a x positions
      (physicalBareAction V patterns C q ζ k K positions terminal r)



end

section
open Finset
noncomputable def translatedPathAction {A M R : Type*} [Fintype A] [Fintype M] [Semiring R]
    (step : ℕ → A → M → ℤ) (E : ℕ → A → ℤ → M → M → R)
    (terminal : ℤ → M → R) : ℕ → ℤ → M → R
  | 0, n, L => terminal n L
  | r + 1, n, L => ∑ a, ∑ R, E r a n L R *
      translatedPathAction step E terminal r (n + step r a L) R

def translatedPathTerm {A M R : Type*} [Mul R]
    (step : ℕ → A → M → ℤ) (E : ℕ → A → ℤ → M → M → R)
    (terminal : ℤ → M → R) : (r : ℕ) → ℤ → M → (Fin r → A × M) → R
  | 0, n, L, _ => terminal n L
  | r + 1, n, L, p => E r (p 0).1 n L (p 0).2 *
      translatedPathTerm step E terminal r (n + step r (p 0).1 L) (p 0).2 (Fin.tail p)

theorem translated_path_expansion {A M R : Type*} [Fintype A] [Fintype M] [Semiring R]
    (step : ℕ → A → M → ℤ) (E : ℕ → A → ℤ → M → M → R)
    (terminal : ℤ → M → R) (r : ℕ) (n : ℤ) (L : M) :
    (∑ p : Fin r → A × M, translatedPathTerm step E terminal r n L p) =
      translatedPathAction step E terminal r n L := by
  classical
  induction r generalizing n L with
  | zero => simp [translatedPathTerm, translatedPathAction]
  | succ r ih =>
    calc
      _ = ∑ z : A × M, ∑ p : Fin r → A × M,
          E r z.1 n L z.2 * translatedPathTerm step E terminal r (n + step r z.1 L) z.2 p := by
        rw [← Equiv.sum_comp (Fin.consEquiv (fun _ : Fin (r + 1) => A × M))
          (fun p => translatedPathTerm step E terminal (r + 1) n L p), Fintype.sum_prod_type]
        rfl
      _ = ∑ z : A × M, E r z.1 n L z.2 *
          translatedPathAction step E terminal r (n + step r z.1 L) z.2 := by
        apply sum_congr rfl
        intro z _
        rw [← mul_sum, ih]
      _ = _ := by rw [Fintype.sum_prod_type]; rfl



end

section
open Finset Classical
noncomputable def physicalBareKernel {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (n : ℤ) (L R : PhysicalMarkLists P J ell) : ℂ :=
  physicalBareLabeledScalar V patterns C ζ K a L R *
    ((physicalVertexWeight L (Real.sqrt q) n *
      physicalVertexWeight R (Real.sqrt q) (n + physicalBareStep C k a L) : ℝ) : ℂ)

noncomputable def physicalBareFreeAction {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (terminal : ℤ → PhysicalMarkLists P J ell → ℂ) : ℕ → ℤ → PhysicalMarkLists P J ell → ℂ :=
  translatedPathAction (fun r => physicalBareStep C (k r))
    (fun r => physicalBareKernel V patterns C q (ζ r) (k r) (K r)) terminal

section

variable
  {G I : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (V : G → ℝ)
  (patterns : Finset I)
  (C : I → G → Finset (Fin J))
  (q : ℝ)
  (ζ : ℕ → I → ℝ)
  (k : ℕ → I → ℤ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)

include G I sharedInstance1 sharedInstance2 P J ell V patterns C q ζ k K

/- A radius containing every possible remaining walk makes the cutoff
irrelevant, including for terms whose marks fail divisibility. -/
theorem physical_bare_action_remove_cutoff 
    (positions : Finset ℤ) (terminal : ℤ → PhysicalMarkLists P J ell → ℂ) (r b : ℕ)
    (hbound : ∀ j < r, physicalOperatorStepBound P J ell patterns C (k j) ≤ b)
    (n : ℤ) (L : PhysicalMarkLists P J ell)
    (hsafe : ∀ m : ℤ, (m - n).natAbs ≤ r * b → m ∈ positions) :
    physicalBareAction V patterns C q ζ k K positions terminal r n L =
      physicalBareFreeAction V patterns C q ζ k K terminal r n L := by
  induction r generalizing n L with
  | zero => rfl
  | succ r ih =>
    change _ = translatedPathAction _ _ _ (r + 1) n L
    rw [physicalBareAction, translatedPathAction]
    apply sum_congr rfl
    intro a _
    have hs : (physicalBareStep C (k r) a L).natAbs ≤ b :=
      (physical_bare_step_bound C (k r) a L).trans (hbound r (by omega))
    have hm : n + physicalBareStep C (k r) a L ∈ positions := by
      apply hsafe
      simpa only [add_sub_cancel_left] using hs.trans (Nat.le_mul_of_pos_left b (by omega))
    rw [if_pos hm]
    apply sum_congr rfl
    intro R _
    change _ * physicalBareAction V patterns C q ζ k K positions terminal r _ R =
      _ * physicalBareFreeAction V patterns C q ζ k K terminal r _ R
    congr 1
    apply ih (fun j hj => hbound j (by omega))
    intro m hmn
    apply hsafe
    calc
      (m - n).natAbs = ((m - (n + physicalBareStep C (k r) a L)) +
          physicalBareStep C (k r) a L).natAbs := by congr 1; ring
      _ ≤ (m - (n + physicalBareStep C (k r) a L)).natAbs +
          (physicalBareStep C (k r) a L).natAbs := Int.natAbs_add_le _ _
      _ ≤ r * b + b := Nat.add_le_add hmn hs
      _ = (r + 1) * b := by ring

/- The previously constructed reachable-position cutoff is large
enough for the unrestricted bare action. -/
theorem physical_bare_action_reachable 
    (starts : Finset ℤ) (terminal : ℤ → PhysicalMarkLists P J ell → ℂ) (r b : ℕ)
    (hbound : ∀ j < r, physicalOperatorStepBound P J ell patterns C (k j) ≤ b)
    (n : ℤ) (L : PhysicalMarkLists P J ell) (hn : n ∈ starts) :
    physicalBareAction V patterns C q ζ k K (reachablePositions starts (r * b)) terminal r n L =
      physicalBareFreeAction V patterns C q ζ k K terminal r n L := by
  apply physical_bare_action_remove_cutoff V patterns C q ζ k K _ terminal r b hbound n L
  intro m hm
  exact mem_reachable_positions hn hm

end

end

section
open Finset
theorem physical_bare_position_step {G I : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} {patterns : Finset I}
    (C : I → G → Finset (Fin J)) (k : ℕ → I → ℤ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges j : ℕ) (n : ℤ) :
    n + physicalBareOffset C k a L edges j +
      physicalBareStep C (k (edges - 1 - j)) (a j) (L j) =
        n + physicalBareOffset C k a L edges (j + 1) := by
  rw [physicalBareOffset]
  ring

/- The complete bare path factors for all n. Consequently a fixed
path's dependence on n is exactly the previously verified vertex product. -/
theorem physical_bare_path_factor {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (N : ℕ) (n : ℤ) :
    (∏ j ∈ range (N + 1), physicalBareKernel V patterns C q (ζ (N - j)) (k (N - j))
      (K (N - j)) (a j) (n + physicalBareOffset C k a L (N + 1) j) (L j) (L (j + 1))) =
      physicalBareWalkScalar V patterns C ζ K a L (N + 1) *
        ((∏ j ∈ range (N + 2), physicalVertexWeight (L j)
          (physicalEndpointSchedule q (N + 1) j)
          (n + physicalBareOffset C k a L (N + 1) j) : ℝ) : ℂ) := by
  have he : ∀ j, n + physicalBareOffset C k a L (N + 1) j +
      physicalBareStep C (k (N - j)) (a j) (L j) =
        n + physicalBareOffset C k a L (N + 1) (j + 1) := by
    intro j
    exact physical_bare_position_step C k a L (N + 1) j n
  simp only [physicalBareKernel, he]
  rw [prod_mul_distrib, ← Complex.ofReal_prod, physical_endpoint_schedule_product L
    (fun j => n + physicalBareOffset C k a L (N + 1) j) hq]
  rfl

/- The return-to-root condition is independent of the root integer. -/
theorem physical_bare_return_iff {G I : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} {patterns : Finset I}
    (C : I → G → Finset (Fin J)) (k : ℕ → I → ℤ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) (n : ℤ) :
    n + physicalBareOffset C k a L edges edges = n ↔ physicalBareOffset C k a L edges edges = 0 := by
  omega
end

section
open Finset
theorem translated_path_term_product {A M R : Type*} [CommMonoid R]
    (step : ℕ → A → M → ℤ) (E : ℕ → A → ℤ → M → M → R)
    (terminal : ℤ → M → R) (edges : ℕ) (a : ℕ → A) (L : ℕ → M) (position : ℕ → ℤ)
    (hstep : ∀ j < edges, position (j + 1) = position j + step (edges - 1 - j) (a j) (L j)) :
    translatedPathTerm step E terminal edges (position 0) (L 0)
      (fun j : Fin edges => (a j.val, L (j.val + 1))) =
        (∏ j ∈ range edges, E (edges - 1 - j) (a j) (position j) (L j) (L (j + 1))) *
          terminal (position edges) (L edges) := by
  induction edges generalizing a L position with
  | zero => simp [translatedPathTerm]
  | succ edges ih =>
    have htime : ∀ j, edges + 1 - 1 - (j + 1) = edges - 1 - j := by omega
    have ht : ∀ j < edges, position (j + 1 + 1) = position (j + 1) +
        step (edges - 1 - j) (a (j + 1)) (L (j + 1)) := by
      intro j hj
      simpa only [htime] using hstep (j + 1) (by omega)
    have hi := ih (fun j => a (j + 1)) (fun j => L (j + 1)) (fun j => position (j + 1)) ht
    have hfirst : position 1 = position 0 + step edges (a 0) (L 0) := by
      simpa only [Nat.add_sub_cancel, Nat.sub_zero] using hstep 0 (by omega)
    rw [translatedPathTerm]
    change E edges (a 0) (position 0) (L 0) (L 1) *
      translatedPathTerm step E terminal edges (position 0 + step edges (a 0) (L 0)) (L 1)
        (fun j : Fin edges => (a (j.val + 1), L (j.val + 1 + 1))) = _
    rw [← hfirst, hi, prod_range_succ']
    simp only [Nat.add_sub_cancel, Nat.sub_zero, Nat.sub_sub, Nat.add_comm]
    ac_rfl
end

section

def finitePathLabels {A M : Type*} {r : ℕ} (p : Fin (r + 1) → A × M) (j : ℕ) : A :=
  if h : j < r + 1 then (p ⟨j, h⟩).1 else (p 0).1

def finitePathMarks {A M : Type*} {r : ℕ} (L : M) (p : Fin r → A × M) : ℕ → M
  | 0 => L
  | j + 1 => if h : j < r then (p ⟨j, h⟩).2 else L

theorem finite_path_sequences {A M : Type*} {r : ℕ} (L : M) (p : Fin (r + 1) → A × M) :
    (fun j : Fin (r + 1) => (finitePathLabels p j.val, finitePathMarks L p (j.val + 1))) = p := by
  funext j
  simp only [finitePathLabels, finitePathMarks, dif_pos j.isLt]
end

section
open Finset Classical
theorem physical_free_path_expansion {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (terminal : ℤ → PhysicalMarkLists P J ell → ℂ) (r : ℕ) (n : ℤ) (L : PhysicalMarkLists P J ell) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    (∑ p : Fin r → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
      translatedPathTerm (fun j => physicalBareStep C (k j))
        (fun j => physicalBareKernel V patterns C q (ζ j) (k j) (K j)) terminal r n L p) =
      physicalBareFreeAction V patterns C q ζ k K terminal r n L := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  exact translated_path_expansion _ _ _ r n L

section

variable
  {G I : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (V : G → ℝ)
  (patterns : Finset I)
  (C : I → G → Finset (Fin J))
  {q : ℝ}
  (hq : 0 ≤ q)
  (ζ : ℕ → I → ℝ)
  (k : ℕ → I → ℤ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)

include G I sharedInstance1 sharedInstance2 P J ell V patterns C q hq ζ k K

/- The original finite operator, on the complete reachable cutoff,
equals the unrestricted bare action at every original starting state. -/
theorem physical_reachable_action_eq_free 
    (starts : Finset ℤ) (terminal : ℤ → PhysicalMarkLists P J ell → ℂ) (r b : ℕ)
    (hbound : ∀ j < r, physicalOperatorStepBound P J ell patterns C (k j) ≤ b)
    (x : PhysicalState P J ell) (hx : x.1 ∈ starts) :
    finiteCutoffAction (physicalCutoff P J ell (reachablePositions starts (r * b)))
      (fun j a b => physicalSymmetricKernel (fun s t => ∑ i ∈ patterns,
        physicalPatternKernel V (C i) q (ζ j i) (k j i) (K j i) s t) a b)
      (fun a => terminal a.1 a.2.val) r x =
        physicalBareFreeAction V patterns C q ζ k K terminal r x.1 x.2.val := by
  have h := physical_cutoff_action_eq_bare V patterns C hq ζ k K
    (reachablePositions starts (r * b)) terminal r x
  simp only [physical_labeled_coefficient_sum] at h
  rw [h]
  exact physical_bare_action_reachable V patterns C q ζ k K starts terminal r b hbound x.1 x.2.val hx

/- A bare path term, including an arbitrary terminal function, has
no hidden dependence on the starting integer. -/
theorem physical_free_path_term_factor 
    (terminal : ℤ → PhysicalMarkLists P J ell → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (N : ℕ) (n : ℤ) :
    translatedPathTerm (fun j => physicalBareStep C (k j))
      (fun j => physicalBareKernel V patterns C q (ζ j) (k j) (K j)) terminal (N + 1) n (L 0)
      (fun j : Fin (N + 1) => (a j.val, L (j.val + 1))) =
        physicalBareWalkScalar V patterns C ζ K a L (N + 1) *
          ((∏ j ∈ range (N + 2), physicalVertexWeight (L j)
            (physicalEndpointSchedule q (N + 1) j)
            (n + physicalBareOffset C k a L (N + 1) j) : ℝ) : ℂ) *
          terminal (n + physicalBareOffset C k a L (N + 1) (N + 1)) (L (N + 1)) := by
  have hpos : ∀ j < N + 1, n + physicalBareOffset C k a L (N + 1) (j + 1) =
      (n + physicalBareOffset C k a L (N + 1) j) +
        physicalBareStep C (k (N + 1 - 1 - j)) (a j) (L j) := by
    intro j _
    exact (physical_bare_position_step C k a L (N + 1) j n).symm
  have ht := translated_path_term_product (fun j => physicalBareStep C (k j))
    (fun j => physicalBareKernel V patterns C q (ζ j) (k j) (K j)) terminal (N + 1) a L
    (fun j => n + physicalBareOffset C k a L (N + 1) j) hpos
  have hzero : n + physicalBareOffset C k a L (N + 1) 0 = n := by simp only [physicalBareOffset, add_zero]
  rw [hzero] at ht
  simp only [Nat.add_sub_cancel] at ht
  rw [ht, physical_bare_path_factor V patterns C hq ζ k K a L N n]

end

end

section
open Finset Classical
noncomputable def physicalBareReturnScalar {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) : ℂ :=
  if physicalBareOffset C k a L edges edges = 0 then
    physicalBareWalkScalar V patterns C ζ K a L edges else 0

section

variable
  {G I : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (V : G → ℝ)
  (patterns : Finset I)
  (C : I → G → Finset (Fin J))
  {q : ℝ}
  (hq : 0 ≤ q)
  (ζ : ℕ → I → ℝ)
  (k : ℕ → I → ℤ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)

include G I sharedInstance1 sharedInstance2 P J ell V patterns C q hq ζ k K

/- Every return-path term is a root-independent scalar times the
nonnegative divisibility-and-damping vertex factor. -/
theorem physical_return_path_factor 
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (N : ℕ) (n : ℤ) :
    translatedPathTerm (fun j => physicalBareStep C (k j))
      (fun j => physicalBareKernel V patterns C q (ζ j) (k j) (K j))
      (fun m _ => if m = n then 1 else 0) (N + 1) n (L 0)
      (fun j : Fin (N + 1) => (a j.val, L (j.val + 1))) =
        physicalBareReturnScalar V patterns C ζ k K a L (N + 1) *
          ((∏ j ∈ range (N + 2), physicalVertexWeight (L j)
            (physicalEndpointSchedule q (N + 1) j)
            (n + physicalBareOffset C k a L (N + 1) j) : ℝ) : ℂ) := by
  rw [physical_free_path_term_factor V patterns C hq ζ k K]
  simp only [physical_bare_return_iff, physicalBareReturnScalar]
  split_ifs <;> simp only [mul_one, mul_zero, zero_mul]

/- The same factorization applies to every term of the finite bare
path sum, using canonical extensions independent of the initial integer. -/
theorem physical_return_finite_path_factor 
    (N : ℕ) (L₀ : PhysicalMarkLists P J ell)
    (p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) (n : ℤ) :
    let a := finitePathLabels p
    let L := finitePathMarks L₀ p
    translatedPathTerm (fun j => physicalBareStep C (k j))
      (fun j => physicalBareKernel V patterns C q (ζ j) (k j) (K j))
      (fun m _ => if m = n then 1 else 0) (N + 1) n L₀ p =
        physicalBareReturnScalar V patterns C ζ k K a L (N + 1) *
          ((∏ j ∈ range (N + 2), physicalVertexWeight (L j)
            (physicalEndpointSchedule q (N + 1) j)
            (n + physicalBareOffset C k a L (N + 1) j) : ℝ) : ℂ) := by
  have h := physical_return_path_factor V patterns C hq ζ k K
    (finitePathLabels p) (finitePathMarks L₀ p) N n
  rw [finite_path_sequences] at h
  exact h

end

end

