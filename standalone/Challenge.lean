/- Literal clean event actions and their exact identification with the
full-memory kernel action, including both adjacent active-slot averages. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def cleanFullMemoryEventAction {S G : Type*}
    [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (C : G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (D : SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) C) →
      PhysicalAuxLabels P C → G → ℤ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (x : CleanFullMemoryState P J ell B) (rs : PhysicalResidues Ps) : ℂ :=
  let source := (cleanFullMemoryEquiv P J ell B x).2.2.1
  let c := (productActiveMemorySplit (cleanFullSharedSlots C) B x).1
  let s := (productActiveMemorySplit (cleanFullSharedSlots C) B x).2
  let δ := fun c aux (_ : G) => -cleanFullSharedStep k C c aux d
  let Ψ := fun c aux (fresh : ∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g) =>
    if repeatedBigAuxAvoids C aux source ∧
        repeatedBigAuxAvoids C aux (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) then
      K source (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) aux *
        physicalPhase ζ (cleanFullSharedD C c aux) *
        physicalReturnPhase θ (cleanFullSharedStep k C c aux d) *
        physicalPhase ζ (physicalSharedProduct d) else 0
  ∑ e : FullActiveEdgeEvent (fun g (q : P g) => q.val) (cleanFullSharedSlots C) B
      (fun _ => PhysicalAuxLabels P C) δ D x,
    (fullActiveEdgeEventWeight (fun g (q : P g) => q.val) (cleanFullSharedSlots C) B
      (fun _ => PhysicalAuxLabels P C) δ D (fun _ aux => physicalAuxMass V C aux)
      (fun g => tiltedPhysicalBirthLaw V g (b g)) ρ V x e : ℂ) *
    (if ∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅ then
      Ψ c e.1 (fun g => (unrestrictedJointEventTarget (fun g (q : P g) => q.val)
        (δ c e.1) (D c e.1) (fun g => (cleanFullSharedSlots C g)ᶜ.card) B s e.2 g).1)
      else 0) *
    f (fullActiveEdgeEventTarget (fun g (q : P g) => q.val) (cleanFullSharedSlots C) B
      (fun _ => PhysicalAuxLabels P C) δ D x e)
      (physicalTranslateResidues rs (cleanFullSharedStep k C c e.1 d))

theorem clean_full_memory_event_action_apply {S G : Type*}
    [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (C : G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (D : SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) C) →
      PhysicalAuxLabels P C → G → ℤ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r))
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (rm : FixedOrderedResidues p) (rs : PhysicalResidues Ps) :
    cleanFullMemoryEventAction V b C ζ θ ρ k D K d f (cleanFullMemoryState N p source rm) rs =
      if (∑ g, (N g).val) ≤ B then
        ∑ aux : PhysicalAuxLabels P C, ∑ target : RepeatedBigLists P J ell,
          (cleanHybridBetweenKernel V b C ζ θ ρ k (fun _ => B) p rm K d aux source target *
            physicalPhase ζ (physicalSharedProduct d)) *
          f (cleanFullMemoryState N p target
            (fixedOrderedResidueTranslate p rm (cleanHybridStep k C source aux d)))
            (physicalTranslateResidues rs (cleanHybridStep k C source aux d))
      else 0 := by
  have hc : cleanFullMemoryEquiv P J ell B (cleanFullMemoryState N p source rm) =
      ⟨N, p, source, rm⟩ :=
    (cleanFullMemoryEquiv P J ell B).apply_symm_apply ⟨N, p, source, rm⟩
  unfold cleanFullMemoryEventAction
  rw [hc]
  exact (by
    cases Subsingleton.elim dG (Classical.typeDecidableEq G)
    let x := cleanFullMemoryState N p source rm
    let c := (productActiveMemorySplit (cleanFullSharedSlots C) B x).1
    let s := (productActiveMemorySplit (cleanFullSharedSlots C) B x).2
    let δ := fun c aux (_ : G) => -cleanFullSharedStep (P := P) (ell := ell) k C c aux d
    let Ψ := fun c aux (fresh : ∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g) =>
      if repeatedBigAuxAvoids C aux source ∧
          repeatedBigAuxAvoids C aux (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) then
        K source (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) aux *
          physicalPhase ζ (cleanFullSharedD (P := P) (ell := ell) C c aux) *
          physicalReturnPhase θ (cleanFullSharedStep (P := P) (ell := ell) k C c aux d) *
          physicalPhase ζ (physicalSharedProduct d) else 0
    have h := full_active_clean_event_sum (fun g (q : P g) => q.val)
      (cleanFullSharedSlots C) B (fun _ => PhysicalAuxLabels P C) δ D
      (fun _ aux => physicalAuxMass V C aux) (fun g => tiltedPhysicalBirthLaw V g (b g)) ρ V Ψ
      (fun c aux x => f x (physicalTranslateResidues rs (cleanFullSharedStep k C c aux d)))
      (fun c aux => hf _) x
    dsimp only at h
    refine h.trans ?_
    rw [show productTotalMemory x = ∑ g, (N g).val from
      cleanFullMemoryState_total_memory N p source rm]
    split_ifs
    · apply sum_congr rfl
      intro aux _
      dsimp only [δ, Ψ, c, s, x]
      simp only [cleanFullSharedD_split, cleanFullSharedStep_split]
      exact clean_full_memory_fresh_kernel_row V b C ζ θ ρ k N p rm d K aux source
        (fun x => f x (physicalTranslateResidues rs (cleanHybridStep k C source aux d)))
    · rfl
  )

noncomputable def cleanFullMemoryPatternEventAction {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ)
    (D : ∀ i, SharedActiveLabels (fun g => ↥(P g)) (cleanFullSharedSlots (ell := ell) (C i)) →
      PhysicalAuxLabels P (C i) → G → ℤ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (x : CleanFullMemoryState P J ell B) (rs : PhysicalResidues Ps) : ℂ :=
