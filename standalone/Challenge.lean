section

/- Actual normalized majorants on the logarithmic Type-II scale box. -/

open MeasureTheory

namespace Bounty




theorem typeII_e_majorant_normalized_support {L e E : ℝ} (hL : 0 < L)
    (hnz : typeIIEMajorant (L ^ 88) (e / E) ≠ 0) :
    e / E ∈ Set.Ioo ((L ^ 88)⁻¹ / 2) 2 := by
  have hlo : 1 < 2 * L ^ 88 * (e / E) :=
    lt_of_not_ge (fun h => hnz (typeII_e_majorant_eq_zero (Or.inl h)))
  have hhi : e / E < 2 :=
    lt_of_not_ge (fun h => hnz (typeII_e_majorant_eq_zero (Or.inr h)))
  refine ⟨?_, hhi⟩
  have hp : 0 < L ^ 88 := pow_pos hL _
  have hinv : (L ^ 88) * (L ^ 88)⁻¹ = 1 := mul_inv_cancel₀ hp.ne'
  nlinarith

theorem typeII_n_majorant_normalized_support {n V : ℝ}
    (hnz : typeIINMajorant (n / V) ≠ 0) : n / V ∈ Set.Ioo (1 / 2) 3 := by
  have hlo : 1 < 2 * (n / V) :=
    lt_of_not_ge (fun h => hnz (typeII_n_majorant_eq_zero (Or.inl h)))
  have hhi : n / V < 3 :=
    lt_of_not_ge (fun h => hnz (typeII_n_majorant_eq_zero (Or.inr h)))
  exact ⟨by linarith, hhi⟩

theorem typeII_scaled_exp_log {m U : ℝ} (hm : 0 < m) (hU : 0 < U) :
    U * Real.exp (Real.log (m / U)) = m := by
  rw [Real.exp_log (div_pos hm hU)]
  field_simp

theorem typeII_scale_log_pulled_coordinates {m m' z U V E Z k : ℝ}
    (hm : 0 < m) (hm' : 0 < m') (hz : 0 < z)
    (hU : 0 < U) (hV : 0 < V) (hZ : 0 < Z) (hk : k ≠ 0) :
    typeIIPulledE (U / (2 * k * E))
      (typeIILogCoordinates ![m, m', z] ![U, U, Z]) = ((m' - m) / (2 * k)) / E ∧
    typeIIPulledN (Z / (k * U * V)) (1 / (U * V))
      (typeIILogCoordinates ![m, m', z] ![U, U, Z]) =
        ((m' - m) * z / (k * m * m') + 1 / m) / V := by
  have he := typeII_normalized_e_log_coordinates U E k (Real.log (m / U)) (Real.log (m' / U))
  have hn := typeII_normalized_n_log_coordinates U V Z k (Real.log (m / U))
    (Real.log (m' / U)) (Real.log (z / Z)) hU.ne' hV.ne' hk
  rw [typeII_scaled_exp_log hm hU, typeII_scaled_exp_log hm' hU] at he
  rw [typeII_scaled_exp_log hm hU, typeII_scaled_exp_log hm' hU,
    typeII_scaled_exp_log hz hZ] at hn
  exact ⟨he.symm, hn.symm⟩

theorem typeII_scale_log_cutoff_eq_majorants {A L m m' z U V E Z k : ℝ}
    (hm : 0 < m) (hm' : 0 < m') (hz : 0 < z)
    (hU : 0 < U) (hV : 0 < V) (hZ : 0 < Z) (hk : k ≠ 0)
    (hbox : ∀ i, (typeIILogCoordinates ![m, m', z] ![U, U, Z]) i ∈ Set.Icc (-A) A) :
    typeIIPulledCutoff A (L ^ 88) (U / (2 * k * E)) (Z / (k * U * V)) (1 / (U * V))
      (typeIILogCoordinates ![m, m', z] ![U, U, Z]) =
        typeIIEMajorant (L ^ 88) (((m' - m) / (2 * k)) / E) *
          typeIINMajorant (((m' - m) * z / (k * m * m') + 1 / m) / V) := by
  obtain ⟨he, hn⟩ := typeII_scale_log_pulled_coordinates (E := E) hm hm' hz hU hV hZ hk
  rw [typeIIPulledCutoff, typeII_three_localizer_eq_one hbox, one_mul, he, hn]







end Bounty
