    (hψcs.continuous_convolution_right
      («L» := ContinuousLinearMap.lsmul ℝ ℝ)
      (μ := (volume : Measure E)) hf_loc hψc)

lemma hasCompactSupport_smoothFun (hK : IsCompact K) (hψcs : HasCompactSupport ψ)
    (u : let : MeasurableSpace E := instMeasurableSpaceSmoothing1 (E := E); let : BorelSpace E := instBorelSpaceSmoothing1 (E := E); let : OpensMeasurableSpace E := instOpensMeasurableSpaceSmoothing1 (E := E); let : MeasurableAdd E := instMeasurableAddSmoothing1 (E := E); MeasureTheory.Lp ℝ (2 : ℝ≥0∞) (volume.restrict K)) :
    let : MeasurableSpace E := instMeasurableSpaceSmoothing1 (E := E)
    let : BorelSpace E := instBorelSpaceSmoothing1 (E := E)
    let : OpensMeasurableSpace E := instOpensMeasurableSpaceSmoothing1 (E := E)
    let : MeasurableAdd E := instMeasurableAddSmoothing1 (E := E)
