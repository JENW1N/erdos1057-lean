def thetaTwistedSource (Ψ : _root_.OAI.ActualEisensteinCubic.O→*ℂ) (c : _root_.OAI.ActualEisensteinCubic.O) (hc : c≠0)
    [Fintype (_root_.OAI.ActualEisensteinCubic.O⧸Ideal.span {c})] (v : ℝ) (hv : 0<v) (z : ℂ) : ℂ :=
