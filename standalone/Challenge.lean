variable
  {G I : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P : G → Finset ℕ}
  [sharedInstance4 : ∀ p : PhysicalPrime P, NeZero p.2.val]
  {J ell : ℕ}
  (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hprime : ∀ g p, p ∈ P g → p.Prime)
  (V : G → ℝ)
  (hV : ∀ g, 0 < V g)
  (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
  (patterns : Finset I)
  (C : I → G → Finset (Fin J))
  {q : ℝ}
  (hq : 0 ≤ q)
  (ζ : ℕ → I → ℝ)
  (k : ℕ → I → ℤ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
  (starts : Finset ℤ)
  (r b : ℕ)
  (hbound : ∀ j < r + 1, physicalOperatorStepBound P J ell patterns C (k j) ≤ b)

include G I sharedInstance1 sharedInstance2 P sharedInstance4 J ell hP hprime V hV hMass patterns C q hq ζ k K starts r b hbound

theorem physical_root_error_of_residue_rows 
    (H ε : ℝ) (hH : 0 ≤ H) (hε : 0 ≤ ε) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    (∀ j (x : PhysicalBareResidueState P J ell),
      (∑ y : PhysicalBareResidueState P J ell, ∑ label : PhysicalEdgeLabels P J ell patterns C,
        ‖physicalResidueLabeledCoeff V patterns C q (ζ j) (k j) (K j) label x y‖) ≤ H) →
    (∀ (L : PhysicalMarkLists P J ell)
      (p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell),
      |(∑ n ∈ starts, physicalFiniteVertexProduct C q k r L p n) / (starts.card : ℝ) -
        physicalFiniteVertexExpectation C q k r L p| ≤ ε * physicalFiniteVertexExpectation C q k r L p) →
    ‖physicalRootMoment V patterns C q ζ k K starts r b -
      physicalRootResidueModel V patterns C q ζ k K r‖ ≤ ε * H^(r + 1) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro hrow herror
  have hm := physical_expected_return_mass_bound hP hprime V hV hMass patterns C hq ζ k K H hH hrow r
  have he := physical_root_replacement_error V hV patterns C hq ζ k K starts r b hbound ε herror
  apply he.trans
  exact mul_le_mul_of_nonneg_left hm hε

/- A polynomial residue-row bound is absorbed by choosing the
per-path relative error exponent larger by the row exponent. -/
theorem physical_root_exponential_error 
    {T : ℝ} (hT : 0 < T) (D E : ℝ) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    (∀ j (x : PhysicalBareResidueState P J ell),
      (∑ y : PhysicalBareResidueState P J ell, ∑ label : PhysicalEdgeLabels P J ell patterns C,
        ‖physicalResidueLabeledCoeff V patterns C q (ζ j) (k j) (K j) label x y‖) ≤ T^D) →
    (∀ (L : PhysicalMarkLists P J ell)
      (p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell),
      |(∑ n ∈ starts, physicalFiniteVertexProduct C q k r L p n) / (starts.card : ℝ) -
        physicalFiniteVertexExpectation C q k r L p| ≤
          Real.exp (-(E + D) * (r + 1) * Real.log T) * physicalFiniteVertexExpectation C q k r L p) →
    ‖physicalRootMoment V patterns C q ζ k K starts r b -
      physicalRootResidueModel V patterns C q ζ k K r‖ ≤ Real.exp (-E * (r + 1) * Real.log T) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro hrow herror
  have he := physical_root_error_of_residue_rows hP hprime V hV hMass patterns C hq ζ k K
    starts r b hbound (T^D) (Real.exp (-(E + D) * (r + 1) * Real.log T))
    (Real.rpow_nonneg hT.le D) (Real.exp_pos _).le hrow herror
  apply he.trans_eq
  rw [Real.rpow_def_of_pos hT, ← Real.exp_nat_mul, ← Real.exp_add]
  congr 1
  push_cast
  ring

end

