section

/- Size bounds for the extracted Q-zero prime and its full remaining factor. -/

open Finset Filter

namespace Bounty

theorem candidate_center_scale_bounds {c : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) :
    (11/5 : ℝ) * c ≤ 1 ∧ c ≤ 5/11 ∧ 0 < c/2 ∧ c/2 < 1 := by
  have hr1 : (1 : ℝ) ≤ r := by exact_mod_cast hr
  have hprod := mul_le_mul_of_nonneg_right hr1 hc.le
  constructor
  · nlinarith
  constructor
  · nlinarith
  constructor
  · positivity
  · nlinarith

theorem candidate_prime_remainder_real_geometry {c L p n : ℝ}
    (hc : 0 < c) (hscale : (11/5 : ℝ) * c ≤ 1) (hL : 0 ≤ L)
    (hn : 0 ≤ n) (hpLo : Real.exp (c*L) < p)
    (hpHi : p ≤ Real.exp ((6/5 : ℝ)*(c*L)))
    (hprodLo : Real.exp L < p*n) (hprodHi : p*n ≤ 16*Real.exp L) :
    Real.exp (c*L) < n ∧ n ≤ 16*Real.exp ((1-c)*L) ∧
      p ≤ Real.exp ((1-c)*L) ∧ p ≤ 16*Real.exp L ∧ n ≤ 16*Real.exp L := by
  have hp0 : 0 ≤ p := (Real.exp_pos _).le.trans hpLo.le
  have hbalance : Real.exp ((6/5 : ℝ)*(c*L)) * Real.exp (c*L) ≤ Real.exp L := by
    rw [← Real.exp_add]
    apply Real.exp_le_exp.mpr
    have h := mul_le_mul_of_nonneg_right hscale hL
    nlinarith
  have hnLo : Real.exp (c*L) < n := by
    by_contra! hbad
    have h := mul_le_mul hpHi hbad hn (Real.exp_pos _).le
    exact (not_le_of_gt hprodLo) (h.trans hbalance)
  have hexp : Real.exp (c*L) * Real.exp ((1-c)*L) = Real.exp L := by
    rw [← Real.exp_add]
    congr 1
    ring
  have hnHi : n ≤ 16*Real.exp ((1-c)*L) := by
    apply (mul_le_mul_iff_right₀ (Real.exp_pos (c*L))).mp
    calc
      Real.exp (c*L)*n ≤ p*n := mul_le_mul_of_nonneg_right hpLo.le hn
      _ ≤ 16*Real.exp L := hprodHi
      _ = Real.exp (c*L)*(16*Real.exp ((1-c)*L)) := by rw [mul_left_comm, hexp]
  have hpHi' : p ≤ Real.exp ((1-c)*L) := by
    apply hpHi.trans
    apply Real.exp_le_exp.mpr
    have h := mul_le_mul_of_nonneg_right hscale hL
    nlinarith
  have heL : Real.exp ((1-c)*L) ≤ Real.exp L := by
    apply Real.exp_le_exp.mpr
    nlinarith [mul_nonneg hc.le hL]
  refine ⟨hnLo, hnHi, hpHi', ?_, ?_⟩
  · exact (hpHi'.trans heL).trans (by nlinarith [Real.exp_pos L])
  · exact hnHi.trans (mul_le_mul_of_nonneg_left heL (by norm_num))

theorem candidate_Q_zero_prime_remainder_geometry {c L : ℝ} {r p n : ℕ}
    (hc : 0 < c) (hr : 0 < r)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) (hL : 0 ≤ L)
    (hp : p ∈ candidateQBand (c*L) 0)
    (hprod : p*n ∈ arithmeticProductWindow 1 (Real.exp L)) :
    Real.exp (c*L) < (p : ℝ) ∧ Real.exp (c*L) < (n : ℝ) ∧
      (n : ℝ) ≤ 16*Real.exp ((1-c)*L) ∧
      (p : ℝ) ≤ Real.exp ((1-c)*L) ∧
      (p : ℝ) ≤ 16*Real.exp L ∧ (n : ℝ) ≤ 16*Real.exp L ∧
      (p : ℝ)*(n : ℝ) ≤ 16*Real.exp L := by
  have hpBand : p ∈ primeBand (Real.exp (c*L)) (Real.exp ((6/5 : ℝ)*(c*L))) := by
    simpa only [candidateQBand, dyadicPrimeBand, pow_zero, div_one, one_mul] using hp
  obtain ⟨_, hpLo, hpHi⟩ := (mem_primeBand_iff (Real.exp_pos _).le (Real.exp_pos _).le p).mp hpBand
  have hw := (mem_arithmeticProductWindow_iff (by norm_num : (1 : ℕ) ≠ 0) (Real.exp L)).mp hprod
  simp only [one_mul, Nat.cast_mul] at hw
  have hg := candidate_prime_remainder_real_geometry hc
    (candidate_center_scale_bounds hc hr hcenter).1 hL (Nat.cast_nonneg n) hpLo hpHi hw.1 hw.2
  exact ⟨hpLo, hg.1, hg.2.1, hg.2.2.1, hg.2.2.2.1, hg.2.2.2.2, hw.2⟩

end Bounty

end

