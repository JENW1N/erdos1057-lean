def kernelGroundStateTest (φ : KernelQuotient → ℝ) :
  letI rootPolicy_complexSLTopology := @OAI.CubicEisenstein.complexSLTopology
  ∀ (hφ : let _ : ChartedSpace SpatialCoordinates KernelQuotient := kernelSpatialChartedSpace; ContMDiff 𝓘(ℝ,SpatialCoordinates) 𝓘(ℝ,ℝ) ∞ φ)
    (hpos : ∀ q, 0 < φ q) (f : kernelSmoothTests),
    kernelSmoothTests :=
  letI rootPolicy_complexSLTopology := @OAI.CubicEisenstein.complexSLTopology
  fun (hφ : let _ : ChartedSpace SpatialCoordinates KernelQuotient := kernelSpatialChartedSpace; ContMDiff 𝓘(ℝ,SpatialCoordinates) 𝓘(ℝ,ℝ) ∞ φ)
    (hpos : ∀ q, 0 < φ q) (f : kernelSmoothTests) =>
    by
     let : ChartedSpace SpatialCoordinates KernelQuotient := kernelSpatialChartedSpace
     let : T2Space KernelQuotient := integralOrbitQuotientT2 globalKubotaKernel
     have hn : ContMDiff 𝓘(ℝ,SpatialCoordinates) 𝓘(ℝ,ℝ) ∞ (fun q => ‖f.1 q‖^2) :=
       (contDiff_norm_sq ℂ).contMDiff.comp f.2.1
     have hg := hn.div₀ hφ (fun q => (hpos q).ne')
     refine ⟨fun q => ((‖f.1 q‖^2/φ q : ℝ) : ℂ), Complex.ofRealCLM.contDiff.contMDiff.comp hg, ?_⟩
     apply HasCompactSupport.of_support_subset_isCompact f.2.2
     intro q hq
     by_contra hh
     have hz : f.1 q = 0 := image_eq_zero_of_notMem_tsupport hh
     exact hq (by simp [hz])

