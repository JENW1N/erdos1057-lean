variable
  {X Y R : Type*}
  [sharedInstance1 : Fintype X]
  [sharedInstance2 : Fintype Y]
  [sharedInstance3 : Semiring R]
  (e : ℕ → X ≃ Y)
  (K : ℕ → X → X → R)
  (f : X → R)
  (n : ℕ)

include X Y R sharedInstance1 sharedInstance2 sharedInstance3 e K f n

/- Transporting the state coordinates separately at each time preserves
the finite path action. The row at step `j` uses the coordinates at time
`j + 1`, and the column uses those at time `j`. -/
theorem finite_path_action_conjugate  (x : X) :
    finitePathAction
        (fun j y z => K j ((e (j + 1)).symm y) ((e j).symm z))
        (fun y => f ((e 0).symm y)) n (e n x) =
      finitePathAction K f n x := by
  classical
  induction n generalizing x with
  | zero => simp [finitePathAction]
  | succ n ih =>
    simp only [finitePathAction, Equiv.symm_apply_apply]
    rw [← (e n).sum_comp]
    simp only [Equiv.symm_apply_apply, ih]

/- The same change-of-coordinates identity at an arbitrary target state. -/
theorem finite_path_action_conjugate_apply  (y : Y) :
    finitePathAction
        (fun j y z => K j ((e (j + 1)).symm y) ((e j).symm z))
        (fun y => f ((e 0).symm y)) n y =
      finitePathAction K f n ((e n).symm y) := by
  simpa using finite_path_action_conjugate e K f n ((e n).symm y)

end







