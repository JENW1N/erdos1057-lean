open Finset Filter
open scoped Topology
private theorem support_eventually_pow_twenty_le_exp_rpow {a : ℝ} (ha : 0 < a) :
    ∀ᶠ L : ℝ in atTop, L^20 ≤ Real.exp (L^a) := by
  filter_upwards [eventually_mul_rpow_log_add_le_rpow (a := 0) ha ha
    (show (0 : ℝ) < 1 by norm_num) 20 0,
    eventually_gt_atTop (0 : ℝ)] with L hbound hL
  have hpow : L^20 = Real.exp (20 * Real.log L) := by
    rw [mul_comm, Real.exp_mul, Real.exp_log hL]
    norm_num
  rw [hpow]
  apply Real.exp_le_exp.mpr
  simpa only [Real.rpow_zero, mul_one, add_zero, one_mul] using hbound

theorem ordered_slot_product_primeFactors_inherit {I : Type*} [Fintype I]
    (choices : I → Finset ℕ) (hzero : ∀ i, ∀ n ∈ choices i, n ≠ 0)
    (property : ℕ → Prop)
    (hproperty : ∀ i, ∀ n ∈ choices i, ∀ p ∈ n.primeFactors, property p)
    (x : ∀ i, choices i) :
    ∀ p ∈ (orderedSlotProduct choices x).primeFactors, property p := by
  classical
  intro p hp
  obtain ⟨hpp, hpdvd, _⟩ := Nat.mem_primeFactors.mp hp
  obtain ⟨i, _, hpi⟩ :=
    ((Nat.prime_iff.mp hpp).dvd_finsetProd_iff (fun i => (x i).val)).mp hpdvd
  exact hproperty i (x i).val (x i).property p
    (Nat.mem_primeFactors.mpr ⟨hpp, hpi, hzero i (x i).val (x i).property⟩)

theorem candidate_Q_slot_primeFactors_range {c L A B : ℝ} {r jStar : ℕ}
    (hcL : 0 ≤ c * L)
    (hrough : A ≤ Real.exp (Real.sqrt L))
    (hupper : (6/5 : ℝ) * c * L ≤ B)
    (hregular : ∀ j ∈ candidateQIndices c L, A ≤ Real.exp (c * L / 2^j))
    (slot : (candidateQIndices c L) × Fin r) {n : ℕ}
    (hn : n ∈ candidateQSlotChoices c L r jStar slot) :
    ∀ p ∈ n.primeFactors, A < (p : ℝ) ∧ (p : ℝ) ≤ Real.exp B := by
  classical
  have hscale (j : ℕ) : (6/5 : ℝ) * c * L / 2^j ≤ B := by
    apply le_trans _ hupper
    apply (div_le_iff₀ (by positivity : (0 : ℝ) < 2^j)).mpr
    have hnonneg : 0 ≤ (6/5 : ℝ) * c * L := by nlinarith
    simpa only [mul_one] using
      mul_le_mul_of_nonneg_left (one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 2) : (1 : ℝ) ≤ 2^j) hnonneg
  intro p hp
  simp only [candidateQSlotChoices] at hn
  split_ifs at hn with hs
  · refine ⟨hrough.trans_lt ((mem_filter.mp hn).2 p hp), ?_⟩
    have hpn : p ≤ n := Nat.le_of_dvd (roughBand_pos hn) (Nat.dvd_of_mem_primeFactors hp)
    have hnUpper : (n : ℝ) ≤ Real.exp ((6/5 : ℝ) * c * L / 2^jStar) := by
      have hh := (mem_Ioc.mp (mem_filter.mp hn).1).2
      exact (Nat.cast_le.mpr hh).trans (Nat.floor_le (Real.exp_pos _).le)
    exact (Nat.cast_le.mpr hpn).trans (hnUpper.trans (Real.exp_le_exp.mpr (hscale jStar)))
  · obtain ⟨hnp, hnlo, hnhi⟩ := (mem_dyadicPrimeBand_iff (c * L) 1 (6/5) slot.1.val n).mp hn
    obtain ⟨hpp, hpdvd, _⟩ := Nat.mem_primeFactors.mp hp
    have hpn : p = n := ((Nat.dvd_prime hnp).mp hpdvd).resolve_left hpp.ne_one
    subst p
    refine ⟨(hregular slot.1.val slot.1.property).trans_lt ?_, ?_⟩
    · simpa only [one_mul] using hnlo
    · apply hnhi.trans (Real.exp_le_exp.mpr ?_)
      simpa only [mul_assoc] using hscale slot.1.val

theorem candidate_Q_weight_primeFactors_range {c L A B : ℝ} {r jStar n : ℕ}
    (hcL : 0 ≤ c * L)
    (hrough : A ≤ Real.exp (Real.sqrt L))
    (hupper : (6/5 : ℝ) * c * L ≤ B)
    (hregular : ∀ j ∈ candidateQIndices c L, A ≤ Real.exp (c * L / 2^j))
    (hn : candidateQWeight c L r jStar n ≠ 0) :
    ∀ p ∈ n.primeFactors, A < (p : ℝ) ∧ (p : ℝ) ≤ Real.exp B := by
  obtain ⟨x, hx⟩ := ordered_slot_weight_ne_zero_support _ _ hn
  rw [← hx]
  apply ordered_slot_product_primeFactors_inherit _
    (fun i n hn => candidate_Q_slot_nonzero c L r jStar i hn)
  exact fun i n hn => candidate_Q_slot_primeFactors_range hcL hrough hupper hregular i hn

theorem eventually_candidate_Q_weight_primeFactors_range {c δ : ℝ}
    (hc : 0 < c) (hsmall : (6/5 : ℝ) * c ≤ δ) :
    ∀ᶠ L : ℝ in atTop, ∀ r jStar n : ℕ, candidateQWeight c L r jStar n ≠ 0 →
      ∀ p ∈ n.primeFactors, L^20 < (p : ℝ) ∧ (p : ℝ) ≤ Real.exp (δ * L) := by
  filter_upwards [eventually_candidateQIndices_geometry hc,
    support_eventually_pow_twenty_le_exp_rpow (show (0 : ℝ) < 1/2 by norm_num),
    eventually_gt_atTop (0 : ℝ)] with L hQ hrough hL
  intro r jStar n hn
  apply candidate_Q_weight_primeFactors_range (mul_nonneg hc.le hL.le) _
    (mul_le_mul_of_nonneg_right hsmall hL.le) _ hn
  · simpa only [Real.sqrt_eq_rpow] using hrough
  · intro j hj
    have hpow : L^20 = Real.exp (20 * Real.log L) := by
      rw [mul_comm, Real.exp_mul, Real.exp_log hL]
      norm_num
    rw [hpow]
    exact Real.exp_le_exp.mpr (hQ.2 j hj).1

theorem eventually_candidate_P_pool_prime_range {c δ : ℝ}
    (hc : 0 < c) (hδ : 0 < δ) :
    ∀ᶠ L : ℝ in atTop, ∀ p ∈ (candidatePIndices c L).biUnion (candidatePBand (c * L)),
      L^20 < (p : ℝ) ∧ (p : ℝ) ≤ Real.exp (δ * L) := by
  obtain ⟨v, V, _, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  filter_upwards [hpool,
    support_eventually_pow_twenty_le_exp_rpow (show (0 : ℝ) < 1/10 by norm_num),
    eventually_mul_rpow_log_add_le_rpow (a := (2/5 : ℝ)) (b := 1)
      (by norm_num) (by norm_num) hδ 1 0,
    Real.tendsto_log_atTop.eventually (eventually_ge_atTop (1 : ℝ))]
    with L hpool hlower hupper hlog
  intro p hp
  obtain ⟨j, hj, hpj⟩ := mem_biUnion.mp hp
  obtain ⟨_, hlo, hhi⟩ := (hpool.2.2.2.2.2 j hj).2.2 p hpj
  refine ⟨?_, hhi.trans (Real.exp_le_exp.mpr ?_)⟩
  · exact hlower.trans_lt hlo
  · calc
      L^(2/5 : ℝ) ≤ L^(2/5 : ℝ) * Real.log L := by
        simpa only [mul_one] using mul_le_mul_of_nonneg_left hlog
          (Real.rpow_nonneg (by linarith [hpool.1]) (2/5 : ℝ))
      _ ≤ δ * L := by simpa only [one_mul, add_zero, Real.rpow_one] using hupper

theorem eventually_candidate_coefficient_primeFactors_range {c δ : ℝ}
    (hc : 0 < c) (hsmall : (6/5 : ℝ) * c ≤ δ) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar u : ℕ),
      candidateCoefficient c L q r jStar u ≠ 0 →
      ∀ p ∈ u.primeFactors, L^20 < (p : ℝ) ∧ (p : ℝ) ≤ Real.exp (δ * L) := by
  have hδ : 0 < δ := lt_of_lt_of_le (by positivity) hsmall
  filter_upwards [eventually_candidate_Q_weight_primeFactors_range hc hsmall,
    eventually_candidate_P_pool_prime_range hc hδ] with L hQ hP
  intro q r jStar u hu p hp
  obtain ⟨hpp, hpdiv, hu0⟩ := Nat.mem_primeFactors.mp hp
  let P := (candidatePIndices c L).biUnion (candidatePBand (c * L))
  have hprod : p ∣ primePoolPart P u * primePoolFreePart P u := by
    rwa [primePoolPart_mul_primePoolFreePart]
  rcases hpp.dvd_mul.mp hprod with hpart | hfree
  · exact hP p ((Nat.mem_factoredNumbers'.mp (primePoolPart_mem_factoredNumbers P u)) p hpp hpart)
  · apply hQ r jStar (primePoolFreePart P u)
      (left_ne_zero_of_mul hu) p
    exact Nat.mem_primeFactors.mpr ⟨hpp, hfree, primePoolFreePart_ne_zero P hu0⟩
end

