theorem eventually_typeII_determinant_le_half_exp {b K : ℝ}
    (hb : 0 < b) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop,
      (typeIIAdmissibleDeterminantBound L K : ℝ) ≤ exp (b*L)/2 := by
  have hgrowth := eventually_mul_rpow_log_add_le_rpow
    (a := (0 : ℝ)) (b := (1 : ℝ)) (c := b)
    (by norm_num) (by norm_num) hb (K+88) (log 6)
  filter_upwards [hgrowth,eventually_ge_atTop (1 : ℝ)] with L hg hL
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  simp only [rpow_zero,rpow_one,mul_one] at hg
  have hlog : log (6*L^(K+88)) ≤ b*L := by
    rw [log_mul (by norm_num) (by positivity),log_rpow hL0]
    linarith
  have hexp : 6*L^(K+88) ≤ exp (b*L) := by
    calc
      _ = exp (log (6*L^(K+88))) := (exp_log (by positivity)).symm
      _ ≤ _ := exp_le_exp.mpr hlog
  have hdet := determinant_bound_le_three_rpow_public hL hK
  linarith

theorem eventually_typeII_original_harmonic_shift_small {b K : ℝ}
    (hb : 0 < b) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop, ∀ U V : ℝ,
      exp (b*L) ≤ U → U ≤ exp L → exp (b*L) ≤ V → V ≤ exp L →
      ∀ k ∈ Icc (-(typeIIAdmissibleDeterminantBound L K : ℤ))
        (typeIIAdmissibleDeterminantBound L K : ℤ),
      ∀ j ∈ range (typeIISmoothDyadicCount L),
      |(k : ℝ)| ≤ typeIISmoothDyadicScale U V (U*L^(-K)) j/4 := by
  filter_upwards [eventually_typeII_determinant_le_half_exp hb hK,
    eventually_typeII_harmonic_scale_lower hb hK] with L hdet hscale
  intro U V hUlo _hUhi hVlo _hVhi k hk j _hj
  have hk' : |(k : ℝ)| ≤ (typeIIAdmissibleDeterminantBound L K : ℝ) := by
    apply abs_le.mpr
    obtain ⟨hklo,hkhi⟩ := mem_Icc.mp hk
    constructor
    · exact_mod_cast hklo
    · exact_mod_cast hkhi
  have hZ := hscale U V hUlo hVlo j
  linarith

