section

/- The explicit high-rank cutoff also preserves the low-rank power saving. -/

open Finset Classical Filter

namespace Bounty

theorem eventually_birthForest_low_rank_power_saving
    {a c C E G Cv Ca M Ch : ℝ}
    (ha : 0 < a) (hc : 0 < c) (hC : 0 ≤ C) (hE : 0 ≤ E)
    (hM : 0 ≤ M) (hD : 0 ≤ G + Ca + M) (hgain : E + Cv + 1 ≤ G) :
    ∀ᶠ L : ℝ in atTop, ∀ N m : ℕ, L ^ a ≤ (N : ℝ) →
      ∀ b H : ℝ, L ^ c ≤ b → (m : ℝ) ≤ L ^ M → 0 ≤ H → H ≤ L ^ Ch →
        ∀ F : BirthForestCode m → ℂ,
          let r := Nat.ceil (((2 * C + E + 1) * N * Real.log L) / b)
          (∀ code, birthForestRank code < r →
            ‖F code‖ ≤ H * L ^ ((-G + Cv) * N + Cv +
              2 * birthForestRank code * (G + Ca))) →
          ‖∑ code ∈ (univ : Finset (BirthForestCode m)).filter
              (fun code => birthForestRank code < r),
            (-1 : ℂ) ^ birthForestRank code * F code‖ ≤ L ^ (-(E * N)) := by
  let D := G + Ca + M
  let ε := 1 / (4 * (D + 1))
  have hD0 : 0 ≤ D := hD
  have hε : 0 < ε := by dsimp [ε]; positivity
  have hK : 0 ≤ 2 * C + E + 1 := by positivity
  have hratio : 2 * ε * D ≤ 1 / 2 := by
    have heq : 4 * (D + 1) * ε = 1 := by
      dsimp [ε]
      field_simp
    nlinarith
  filter_upwards [eventually_ge_atTop (2 : ℝ),
    (tendsto_rpow_atTop ha).eventually_ge_atTop (2 * (Cv + Ch + M + 1)),
    eventually_forest_rank_cutoff_small ha hc hε hK] with L hL hfixed hsmall
  intro N m hN b H hb hm hH hHb F
  dsimp only
  intro hF
  have hL0 : 0 < L := by linarith
  have hNr : (0 : ℝ) < N := (Real.rpow_pos_of_pos hL0 a).trans_le hN
  have hrr := (div_le_iff₀ hNr).mp (hsmall N hN b hb)
  apply birthForest_low_rank_power_saving F _ N
    (G := G) (Cv := Cv) (Ca := Ca) (M := M) (Ch := Ch) (E := E)
    hL hH hM hD hm hHb
  · linarith
  · have hrD := mul_le_mul_of_nonneg_right hrr hD0
    have hNratio := mul_le_mul_of_nonneg_right hratio hNr.le
    dsimp only [D] at hrD hNratio
    nlinarith
  · exact hgain
  · exact hF

end Bounty
end

