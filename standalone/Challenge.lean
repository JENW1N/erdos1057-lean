    have hnext : 2 * j.val + 1 + 1 = 2 * j.succ.val := by simp only [Fin.val_succ]; omega
    rw [hij] at hFG ⊢
    rw [physical_selected_coarse_row_odd, physical_selected_coarse_row_odd]
    apply physical_selected_edge_marks_congr C k ω β retention ρ V hV j (aux j)
      (σ j) (τ j) (L j.succ) F G
    simpa only [hnext, physical_mark_at_cut_even] using hFG

