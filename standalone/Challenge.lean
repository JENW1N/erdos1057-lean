section

/- Exact signed ghost-event transport between two memory caps.
Only supported events are used for target compatibility; invalid raw outputs
carry zero weight even when their fallback target has small memory. -/

open Finset Classical

namespace Bounty

section

variable {P Z : Type*} {t b B : ℕ} (h : b ≤ B)

def boundedGhostEventCapEmbed (s : BoundedOrderedState P Z t b)
    (e : BoundedGhostEvent t b s) :
    BoundedGhostEvent t B (boundedStateCapEmbed h s) :=
  ⟨⟨e.1.val, lt_of_lt_of_le e.1.isLt (Nat.add_le_add_right h 1)⟩, e.2⟩

theorem boundedGhostEventCapEmbed_injective (s : BoundedOrderedState P Z t b) :
    Function.Injective (boundedGhostEventCapEmbed h s) := by
  intro e f hef
  rcases e with ⟨⟨k, hk⟩, e⟩
  rcases f with ⟨⟨l, hl⟩, f⟩
  have hkl : k = l := congrArg (fun x => x.1.val) hef
  subst l
  have hef' : e = f := by
    exact eq_of_heq (Sigma.mk.inj_iff.mp hef).2
  subst f
  rfl

theorem boundedGhostEventCapEmbed_target (s : BoundedOrderedState P Z t b)
    (e : BoundedGhostEvent t b s) (he : e.2.1.card + e.1.val ≤ b) :
    boundedGhostEventTarget t B (boundedStateCapEmbed h s) (boundedGhostEventCapEmbed h s e) =
      boundedStateCapEmbed h (boundedGhostEventTarget t b s e) := by
  have heB := he.trans h
  unfold boundedGhostEventTarget
  rw [dif_pos (show (retainedBirthTuple (boundedStateCapEmbed h s).2.2
      (boundedGhostEventCapEmbed h s e).2.1 (boundedGhostEventCapEmbed h s e).2.2).1 ≤ B from heB)]
  rw [dif_pos (show (retainedBirthTuple s.2.2 e.2.1 e.2.2).1 ≤ b from he)]
  rfl

theorem boundedGhostEventWeight_valid (A D C ν : Z → ℝ)
    (s : BoundedOrderedState P Z t b) (e : BoundedGhostEvent t b s)
    (he : boundedGhostEventWeight A D C ν t b s e ≠ 0) :
    e.2.1.card + e.1.val ≤ b := by
  by_contra hbad
  exact he (by simp [boundedGhostEventWeight, hbad])

theorem boundedGhostEventCapEmbed_target_of_ne_zero (A D C ν : Z → ℝ)
    (s : BoundedOrderedState P Z t b) (e : BoundedGhostEvent t b s)
    (he : boundedGhostEventWeight A D C ν t b s e ≠ 0) :
    boundedGhostEventTarget t B (boundedStateCapEmbed h s) (boundedGhostEventCapEmbed h s e) =
      boundedStateCapEmbed h (boundedGhostEventTarget t b s e) := by
  exact boundedGhostEventCapEmbed_target h s e (boundedGhostEventWeight_valid A D C ν s e he)

theorem boundedGhostEventCapEmbed_weight (A D C ν : Z → ℝ)
    (s : BoundedOrderedState P Z t b) (e : BoundedGhostEvent t b s) :
    boundedGhostEventWeight A D C ν t b s e =
      if (boundedGhostEventTarget t B (boundedStateCapEmbed h s)
          (boundedGhostEventCapEmbed h s e)).2.1.val ≤ b then
        boundedGhostEventWeight A D C ν t B (boundedStateCapEmbed h s)
          (boundedGhostEventCapEmbed h s e)
      else 0 := by
  by_cases he : e.2.1.card + e.1.val ≤ b
  · have heB := he.trans h
    simp [boundedGhostEventWeight, boundedGhostEventTarget, retainedBirthTuple,
      boundedGhostEventCapEmbed, boundedStateCapEmbed, boundedMemoryCapEmbed, he, heB]
    rfl
  · by_cases heB : e.2.1.card + e.1.val ≤ B
    · simp [boundedGhostEventWeight, boundedGhostEventTarget, retainedBirthTuple,
        boundedGhostEventCapEmbed, boundedStateCapEmbed, boundedMemoryCapEmbed, he, heB]
    · simp only [boundedGhostEventWeight, boundedGhostEventCapEmbed,
        boundedStateCapEmbed, boundedMemoryCapEmbed, he, heB, ite_false, ite_self]

theorem boundedGhostEventCapEmbed_surjective_of_ne_zero (A D C ν : Z → ℝ)
    (s : BoundedOrderedState P Z t b)
    (e : BoundedGhostEvent t B (boundedStateCapEmbed h s))
    (hw : boundedGhostEventWeight A D C ν t B (boundedStateCapEmbed h s) e ≠ 0)
    (ht : (boundedGhostEventTarget t B (boundedStateCapEmbed h s) e).2.1.val ≤ b) :
    ∃ d : BoundedGhostEvent t b s, boundedGhostEventCapEmbed h s d = e := by
  have hv := boundedGhostEventWeight_valid A D C ν (boundedStateCapEmbed h s) e hw
  have ht' : e.2.1.card + e.1.val ≤ b := by
    unfold boundedGhostEventTarget at ht
    rw [dif_pos (show (retainedBirthTuple (boundedStateCapEmbed h s).2.2 e.2.1 e.2.2).1 ≤ B from hv)] at ht
    exact ht
  have hb : e.1.val < b + 1 := by omega
  exact ⟨⟨⟨e.1.val, hb⟩, e.2⟩, rfl⟩

theorem boundedGhostEventCapEmbed_support (A D C ν : Z → ℝ)
    (s : BoundedOrderedState P Z t b) (e : BoundedGhostEvent t b s) :
    boundedGhostEventWeight A D C ν t b s e ≠ 0 ↔
      boundedGhostEventWeight A D C ν t B (boundedStateCapEmbed h s)
        (boundedGhostEventCapEmbed h s e) ≠ 0 ∧
      (boundedGhostEventTarget t B (boundedStateCapEmbed h s)
        (boundedGhostEventCapEmbed h s e)).2.1.val ≤ b := by
  rw [boundedGhostEventCapEmbed_weight h A D C ν s e]
  split_ifs <;> simp_all

theorem boundedGhostEventCapEmbed_weight_of_ne_zero (A D C ν : Z → ℝ)
    (s : BoundedOrderedState P Z t b) (e : BoundedGhostEvent t b s)
    (he : boundedGhostEventWeight A D C ν t b s e ≠ 0) :
    boundedGhostEventWeight A D C ν t B (boundedStateCapEmbed h s)
      (boundedGhostEventCapEmbed h s e) = boundedGhostEventWeight A D C ν t b s e := by
  have ht := ((boundedGhostEventCapEmbed_support h A D C ν s e).mp he).2
  exact ((boundedGhostEventCapEmbed_weight h A D C ν s e).trans (if_pos ht)).symm







end

end Bounty
end

section

/- Exact transport of bounded edge events between memory capacities.
The choices do not depend on the cap. Targets commute on supported small
events; invalid large targets are handled through their zero coefficient. -/

open Finset Classical

namespace Bounty

def unrestrictedBoundedEventCapEquiv {P : Type*} (n : P → ℕ) (Δ D : ℤ) (t : ℕ)
    {b B : ℕ} (h : b ≤ B) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t b) :
    UnrestrictedBoundedEvent n Δ D t b s ≃
      UnrestrictedBoundedEvent n Δ D t B (boundedStateCapEmbed h s) := Equiv.refl _

section

variable
  {P : Type*}
  (n : P → ℕ)
  (Δ D : ℤ)
  (t : ℕ)
  {b B : ℕ}
  (h : b ≤ B)
  (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t b)
  (e : UnrestrictedBoundedEvent n Δ D t b s)

include P n Δ D t b B h s e

theorem unrestrictedBoundedEventCapEquiv_apply  :
    unrestrictedBoundedEventCapEquiv n Δ D t h s e = e := rfl

theorem unrestrictedBoundedEventTarget_cap_of_output_le 
    (hout : (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
      (unrestrictedResidueTransport n Δ) e.1 e.2.1 e.2.2.1).1 ≤ b) :
    boundedStateCapEmbed h (unrestrictedBoundedEventTarget n Δ D t b s e) =
      unrestrictedBoundedEventTarget n Δ D t B (boundedStateCapEmbed h s)
        (unrestrictedBoundedEventCapEquiv n Δ D t h s e) := by
  rw [unrestrictedBoundedEventCapEquiv_apply]
  dsimp only [unrestrictedBoundedEventTarget, boundedStateCapEmbed, boundedMemoryCapEmbed]
  rw [dif_pos hout, dif_pos (hout.trans h)]

end


section

variable
  {P : Type*}
  (n : P → ℕ)
  (Δ D : ℤ)
  (μ : P → ℝ)
  (ρ V : ℝ)
  (t : ℕ)
  {b B : ℕ}
  (h : b ≤ B)
  (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t b)
  (e : UnrestrictedBoundedEvent n Δ D t b s)

include P n Δ D μ ρ V t b B h s e

theorem unrestrictedBoundedEventTarget_cap_of_weight_ne_zero 
    (hw : unrestrictedBoundedEventWeight n Δ D μ ρ V t b s e ≠ 0) :
    boundedStateCapEmbed h (unrestrictedBoundedEventTarget n Δ D t b s e) =
      unrestrictedBoundedEventTarget n Δ D t B (boundedStateCapEmbed h s)
        (unrestrictedBoundedEventCapEquiv n Δ D t h s e) := by
  apply unrestrictedBoundedEventTarget_cap_of_output_le n Δ D t h s e
  by_contra hout
  exact hw (by simp only [unrestrictedBoundedEventWeight, hout, and_false, if_false])

theorem unrestrictedBoundedEventWeight_cap  :
    unrestrictedBoundedEventWeight n Δ D μ ρ V t b s e =
      if (unrestrictedBoundedEventTarget n Δ D t B (boundedStateCapEmbed h s)
          (unrestrictedBoundedEventCapEquiv n Δ D t h s e)).2.1.val ≤ b
      then unrestrictedBoundedEventWeight n Δ D μ ρ V t B (boundedStateCapEmbed h s)
        (unrestrictedBoundedEventCapEquiv n Δ D t h s e)
      else 0 := by
  simp only [unrestrictedBoundedEventCapEquiv_apply]
  dsimp only [unrestrictedBoundedEventWeight, unrestrictedBoundedEventTarget,
    boundedStateCapEmbed, boundedMemoryCapEmbed]
  by_cases hb : (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
      (unrestrictedResidueTransport n Δ) e.1 e.2.1 e.2.2.1).1 ≤ b
  · have hB := hb.trans h
    simp only [hb, hB, and_true, dif_pos, if_pos]
  · by_cases hB : (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) e.1 e.2.1 e.2.2.1).1 ≤ B
    · simp only [hb, hB, and_false, and_true, dif_pos, if_false]
    · simp only [hb, hB, and_false, if_false, ite_self]

end








end Bounty
end

section

/- Zero-weight events can be removed before transporting paths. This keeps
arbitrary event-dependent phases while avoiding constraints on fallback targets. -/

open Finset Classical

namespace Bounty

universe uK uX uE

abbrev FiniteNonzeroEvent {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (w : ∀ k x, E k x → ℝ) (k : K) (x : X) :=
  {a : E k x // w k x a ≠ 0}

def finiteNonzeroTarget {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X)
    (w : ∀ k x, E k x → ℝ) (k : K) (x : X) (a : FiniteNonzeroEvent E w k x) : X :=
  t k x a.val

def finiteNonzeroPathForget {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ) :
    ∀ ks x, FiniteEventPath (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) ks x →
      FiniteEventPath E t ks x
  | [], _, _ => PUnit.unit
  | _ :: ks, _, ⟨a, p⟩ => ⟨a.val, finiteNonzeroPathForget E t w ks _ p⟩

def finiteNonzeroPathLift {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ) :
    ∀ ks x (p : FiniteEventPath E t ks x), finiteEventPathWeight E t w ks x p ≠ 0 →
      FiniteEventPath (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) ks x
  | [], _, _, _ => PUnit.unit
  | k :: ks, x, ⟨a, p⟩, h =>
      ⟨⟨a, (mul_ne_zero_iff.mp h).1⟩,
        finiteNonzeroPathLift E t w ks (t k x a) p (mul_ne_zero_iff.mp h).2⟩

section

variable
  {K : Type uK}
  {X : Type uX}
  (E : K → X → Type uE)
  (t : ∀ k x, E k x → X)
  (w : ∀ k x, E k x → ℝ)
  (ks : List K)
  (x : X)

include K X E t w ks x

theorem finite_nonzero_path_forget_lift  (p : FiniteEventPath E t ks x)
    (h : finiteEventPathWeight E t w ks x p ≠ 0) :
    finiteNonzeroPathForget E t w ks x (finiteNonzeroPathLift E t w ks x p h) = p := by
  induction ks generalizing x with
  | nil => cases p; rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    change (⟨a, finiteNonzeroPathForget E t w ks _ (finiteNonzeroPathLift E t w ks _ p _)⟩ :
      FiniteEventPath E t (k :: ks) x) = ⟨a, p⟩
    rw [ih]

theorem finite_nonzero_path_weight 
    (p : FiniteEventPath (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) ks x) :
    finiteEventPathWeight E t w ks x (finiteNonzeroPathForget E t w ks x p) =
      finiteEventPathWeight (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w)
        (fun k x a => w k x a.val) ks x p := by
  induction ks generalizing x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    exact congrArg (w k x a.val * ·) (ih _ p)

theorem finite_nonzero_path_weight_ne_zero 
    (p : FiniteEventPath (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) ks x) :
    finiteEventPathWeight E t w ks x (finiteNonzeroPathForget E t w ks x p) ≠ 0 := by
  induction ks generalizing x with
  | nil => exact one_ne_zero
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    exact mul_ne_zero a.property (ih _ p)

theorem finite_nonzero_path_terminal 
    (p : FiniteEventPath (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) ks x) :
    finiteEventPathTerminal E t ks x (finiteNonzeroPathForget E t w ks x p) =
      finiteEventPathTerminal (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) ks x p := by
  induction ks generalizing x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    exact ih _ p

theorem finite_nonzero_path_lift_forget 
    (p : FiniteEventPath (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) ks x) :
    finiteNonzeroPathLift E t w ks x (finiteNonzeroPathForget E t w ks x p)
      (finite_nonzero_path_weight_ne_zero E t w ks x p) = p := by
  induction ks generalizing x with
  | nil => cases p; rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    change (⟨a, finiteNonzeroPathLift E t w ks _ (finiteNonzeroPathForget E t w ks _ p) _⟩ :
      FiniteEventPath (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) (k :: ks) x) = ⟨a, p⟩
    rw [ih]

end


def finiteNonzeroPathEquiv {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (ks : List K) (x : X) :
    FiniteEventPath (FiniteNonzeroEvent E w) (finiteNonzeroTarget E t w) ks x ≃
      {p : FiniteEventPath E t ks x // finiteEventPathWeight E t w ks x p ≠ 0} where
  toFun p := ⟨finiteNonzeroPathForget E t w ks x p, finite_nonzero_path_weight_ne_zero E t w ks x p⟩
  invFun p := finiteNonzeroPathLift E t w ks x p.val p.property
  left_inv := finite_nonzero_path_lift_forget E t w ks x
  right_inv p := Subtype.ext (finite_nonzero_path_forget_lift E t w ks x p.val p.property)

end Bounty
end

section

/- Path transport needs event equivalences only on an invariant set of states. -/

open Finset Classical

namespace Bounty

universe uK uX uY uE uF

def finiteInvariantPathEquiv {K : Type uK} {X : Type uX} {Y : Type uY}
    (E : K → X → Type uE) (F : K → Y → Type uF)
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (e : X → Y) (P : X → Prop)
    (closed : ∀ k x, P x → ∀ a, P (t k x a))
    (δ : ∀ k x, P x → E k x ≃ F k (e x))
    (ht : ∀ k x (hx : P x) a, e (t k x a) = u k (e x) (δ k x hx a)) :
    ∀ ks x, P x → FiniteEventPath E t ks x ≃ FiniteEventPath F u ks (e x)
  | [], _, _ => Equiv.punitEquivPUnit
  | k :: ks, x, hx => Equiv.sigmaCongr (δ k x hx) (fun a =>
      (finiteInvariantPathEquiv E F t u e P closed δ ht ks (t k x a) (closed k x hx a)).trans
        (Equiv.cast (congrArg (FiniteEventPath F u ks) (ht k x hx a))))

section

variable
  {K : Type uK}
  {X : Type uX}
  {Y : Type uY}
  (E : K → X → Type uE)
  (F : K → Y → Type uF)
  (t : ∀ k x, E k x → X)
  (u : ∀ k y, F k y → Y)
  (e : X → Y)
  (P : X → Prop)
  (closed : ∀ k x, P x → ∀ a, P (t k x a))
  (δ : ∀ k x, P x → E k x ≃ F k (e x))
  (ht : ∀ k x (hx : P x) a, e (t k x a) = u k (e x) (δ k x hx a))

include K X Y E F t u e P closed δ ht

theorem finite_invariant_path_equiv_terminal 
    (ks : List K) (x : X) (hx : P x) (p : FiniteEventPath E t ks x) :
    finiteEventPathTerminal F u ks (e x) (finiteInvariantPathEquiv E F t u e P closed δ ht ks x hx p) =
      e (finiteEventPathTerminal E t ks x p) := by
  induction ks generalizing x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    change finiteEventPathTerminal F u ks _
      (cast (congrArg (FiniteEventPath F u ks) (ht k x hx a))
        (finiteInvariantPathEquiv E F t u e P closed δ ht ks (t k x a) (closed k x hx a) p)) = _
    rw [finite_event_path_terminal_cast F u ks (ht k x hx a)]
    exact ih _ (closed k x hx a) p

theorem finite_invariant_path_equiv_weight 
    (w : ∀ k x, E k x → ℝ) (v : ∀ k y, F k y → ℝ)
    (hw : ∀ k x (hx : P x) a, v k (e x) (δ k x hx a) = w k x a)
    (ks : List K) (x : X) (hx : P x) (p : FiniteEventPath E t ks x) :
    finiteEventPathWeight F u v ks (e x) (finiteInvariantPathEquiv E F t u e P closed δ ht ks x hx p) =
      finiteEventPathWeight E t w ks x p := by
  induction ks generalizing x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    change v k (e x) (δ k x hx a) * finiteEventPathWeight F u v ks _
      (cast (congrArg (FiniteEventPath F u ks) (ht k x hx a))
        (finiteInvariantPathEquiv E F t u e P closed δ ht ks (t k x a) (closed k x hx a) p)) = _
    rw [hw, finite_event_path_weight_cast F u v ks (ht k x hx a), ih]
    rfl

end


theorem finite_invariant_path_action_equiv {K : Type uK} {X : Type uX} {Y : Type uY}
    (E : K → X → Type uE) (F : K → Y → Type uF)
    [∀ k x, Fintype (E k x)] [∀ k y, Fintype (F k y)]
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (e : X → Y) (P : X → Prop)
    (closed : ∀ k x, P x → ∀ a, P (t k x a))
    (δ : ∀ k x, P x → E k x ≃ F k (e x))
    (ht : ∀ k x (hx : P x) a, e (t k x a) = u k (e x) (δ k x hx a))
    (w : ∀ k x, E k x → ℝ) (v : ∀ k y, F k y → ℝ)
    (hw : ∀ k x (hx : P x) a, v k (e x) (δ k x hx a) = w k x a)
    (ks : List K) (phase : ∀ y, FiniteEventPath F u ks y → ℂ)
    (f : Y → ℂ) (x : X) (hx : P x) :
    finiteEventPathAction E t w ks
        (fun x p => if hx : P x then phase (e x) (finiteInvariantPathEquiv E F t u e P closed δ ht ks x hx p) else 0) (fun x => f (e x)) x =
      finiteEventPathAction F u v ks phase f (e x) := by
  let _ := finiteEventPathFintype E t ks x
  let _ := finiteEventPathFintype F u ks (e x)
  have h := Equiv.sum_comp (finiteInvariantPathEquiv E F t u e P closed δ ht ks x hx)
    (fun p => (finiteEventPathWeight F u v ks (e x) p : ℂ) * phase (e x) p *
      f (finiteEventPathTerminal F u ks (e x) p))
  simpa only [finiteEventPathAction, dif_pos hx, finite_invariant_path_equiv_weight E F t u e P closed δ ht w v hw,
    finite_invariant_path_equiv_terminal E F t u e P closed δ ht] using h

end Bounty
end

section

/- Exact selection of event paths by an arbitrary predicate on each event. -/

open Finset Classical

namespace Bounty

universe uK uX uE

abbrev FiniteSelectedEvent {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (Q : ∀ k x, E k x → Prop) (k : K) (x : X) :=
  {a : E k x // Q k x a}

def finiteSelectedTarget {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X)
    (Q : ∀ k x, E k x → Prop) (k : K) (x : X) (a : FiniteSelectedEvent E Q k x) : X :=
  t k x a.val

def FiniteEventPathSelected {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (Q : ∀ k x, E k x → Prop) :
    ∀ ks x, FiniteEventPath E t ks x → Prop
  | [], _, _ => True
  | k :: ks, x, ⟨a, p⟩ => Q k x a ∧ FiniteEventPathSelected E t Q ks (t k x a) p

def finiteSelectedPathForget {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (Q : ∀ k x, E k x → Prop) :
    ∀ ks x, FiniteEventPath (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) ks x →
      FiniteEventPath E t ks x
  | [], _, _ => PUnit.unit
  | _ :: ks, _, ⟨a, p⟩ => ⟨a.val, finiteSelectedPathForget E t Q ks _ p⟩

def finiteSelectedPathLift {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (Q : ∀ k x, E k x → Prop) :
    ∀ ks x (p : FiniteEventPath E t ks x), FiniteEventPathSelected E t Q ks x p →
      FiniteEventPath (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) ks x
  | [], _, _, _ => PUnit.unit
  | k :: ks, x, ⟨a, p⟩, h =>
      ⟨⟨a, h.1⟩,
        finiteSelectedPathLift E t Q ks (t k x a) p h.2⟩

section

variable
  {K : Type uK}
  {X : Type uX}
  (E : K → X → Type uE)
  (t : ∀ k x, E k x → X)
  (Q : ∀ k x, E k x → Prop)

include K X E t Q

theorem finite_selected_path_forget_lift 
    (ks : List K) (x : X) (p : FiniteEventPath E t ks x)
    (h : FiniteEventPathSelected E t Q ks x p) :
    finiteSelectedPathForget E t Q ks x (finiteSelectedPathLift E t Q ks x p h) = p := by
  induction ks generalizing x with
  | nil => cases p; rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    change (⟨a, finiteSelectedPathForget E t Q ks _ (finiteSelectedPathLift E t Q ks _ p _)⟩ :
      FiniteEventPath E t (k :: ks) x) = ⟨a, p⟩
    rw [ih]

theorem finite_selected_path_weight 
    (w : ∀ k x, E k x → ℝ) (ks : List K) (x : X)
    (p : FiniteEventPath (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) ks x) :
    finiteEventPathWeight E t w ks x (finiteSelectedPathForget E t Q ks x p) =
      finiteEventPathWeight (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q)
        (fun k x a => w k x a.val) ks x p := by
  induction ks generalizing x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    exact congrArg (w k x a.val * ·) (ih _ p)

theorem finite_selected_path_selected 
    (ks : List K) (x : X)
    (p : FiniteEventPath (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) ks x) :
    FiniteEventPathSelected E t Q ks x (finiteSelectedPathForget E t Q ks x p) := by
  induction ks generalizing x with
  | nil => trivial
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    exact ⟨a.property, ih _ p⟩

theorem finite_selected_path_terminal 
    (ks : List K) (x : X)
    (p : FiniteEventPath (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) ks x) :
    finiteEventPathTerminal E t ks x (finiteSelectedPathForget E t Q ks x p) =
      finiteEventPathTerminal (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) ks x p := by
  induction ks generalizing x with
  | nil => rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    exact ih _ p

theorem finite_selected_path_lift_forget 
    (ks : List K) (x : X)
    (p : FiniteEventPath (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) ks x) :
    finiteSelectedPathLift E t Q ks x (finiteSelectedPathForget E t Q ks x p)
      (finite_selected_path_selected E t Q ks x p) = p := by
  induction ks generalizing x with
  | nil => cases p; rfl
  | cons k ks ih =>
    rcases p with ⟨a, p⟩
    change (⟨a, finiteSelectedPathLift E t Q ks _ (finiteSelectedPathForget E t Q ks _ p) _⟩ :
      FiniteEventPath (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) (k :: ks) x) = ⟨a, p⟩
    rw [ih]

end


def finiteSelectedPathEquiv {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) (t : ∀ k x, E k x → X) (Q : ∀ k x, E k x → Prop)
    (ks : List K) (x : X) :
    FiniteEventPath (FiniteSelectedEvent E Q) (finiteSelectedTarget E t Q) ks x ≃
      {p : FiniteEventPath E t ks x // FiniteEventPathSelected E t Q ks x p} where
  toFun p := ⟨finiteSelectedPathForget E t Q ks x p, finite_selected_path_selected E t Q ks x p⟩
  invFun p := finiteSelectedPathLift E t Q ks x p.val p.property
  left_inv := finite_selected_path_lift_forget E t Q ks x
  right_inv p := Subtype.ext (finite_selected_path_forget_lift E t Q ks x p.val p.property)

end Bounty
end

