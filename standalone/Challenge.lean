  refine ⟨hdecay, max_le ?_ ?_, ?_, ?_⟩
  · exact hdecay.trans (Real.rpow_le_rpow_of_exponent_le hL
      ((neg_nonpos.mpr hG).trans (le_max_left _ _)))
  · exact hbad.trans (Real.rpow_le_rpow_of_exponent_le hL (le_max_right _ _))
