section Expectation
variable {G : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ}
  [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}







theorem physical_residue_vertex_expectation_zero_of_incompatible
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (labels : ℕ → PhysicalMarkLists P J ell) (visits : Finset ℕ)
    (offset : ℕ → ℤ) (q : ℕ → ℝ)
    (h : ¬ ∃ r : PhysicalResidues P, physicalResiduePathCompatible labels visits offset r) :
    poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) univ visits
      (fun p => visits.filter (fun j => p ∈ physicalMarkedPrimes (labels j)))
      (fun p j => -(offset j : ZMod p.2.val)) (fun j => 1 - q j) = 0 := by
  rw [← physical_residue_vertex_expectation hP hprime]
  apply sum_eq_zero
  intro r _
