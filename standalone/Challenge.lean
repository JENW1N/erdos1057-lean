section

/- The fixed initial ledger costs only a rare fresh-target perturbation.
Auxiliary draws are untouched. Endpoint permutation averages contract the
same full product norm, with no shared-fiber dimension factor. -/

open Finset
open scoped Classical

namespace Bounty

theorem clean_initial_birth_kernel_norm_le {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ} (F : ∀ g, Finset (P g)) (C : G → Finset (Fin J))
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    (x y : RepeatedBigLists P J ell) (a : PhysicalAuxLabels P C) :
    ‖cleanInitialBirthKernel F C K x y a‖ ≤ B := by
  unfold cleanInitialBirthKernel
  split_ifs
  · exact hK x y a
  · simpa only [norm_zero] using hB

theorem repeated_big_initial_birth_unbanned_error {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (F : ∀ g, Finset (P g))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigUnbannedRowAction V C ζ K f -
        repeatedBigUnbannedRowAction V C ζ (cleanInitialBirthKernel F C K) f) ≤
      (B * Real.sqrt (repeatedBigInitialForbiddenProbability (ell := ell) V C F Pmin)) *
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  have h := repeated_big_unbanned_target_mask_norm V C hV hMass ζ K B hB hK
    (repeatedBigFreshHits F C) (repeatedBigInitialForbiddenProbability (ell := ell) V C F Pmin)
    (repeatedBigInitialForbiddenProbability_nonneg (ell := ell) V C F (fun g => (hV g).le) hPmin.le)
    (fun x => by
      apply le_of_eq_of_le _ (repeated_big_initial_forbidden_target_mass_le V C F hV hMass hPmin hp x)
      apply sum_congr
      · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
      · intro y _
        by_cases hc : repeatedBigSharedCompatible C x y <;> simp only [hc, ↓reduceIte, zero_mul]) f
  have he : repeatedBigUnbannedRowAction V C ζ K f -
      repeatedBigUnbannedRowAction V C ζ (cleanInitialBirthKernel F C K) f =
      repeatedBigUnbannedRowAction V C ζ
        (fun x y a => if repeatedBigFreshHits F C y then K x y a else 0) f := by
    funext x
    simp only [Pi.sub_apply, repeatedBigUnbannedRowAction]
    rw [← sum_sub_distrib]
    apply sum_congr rfl
    intro y _
    rw [← sub_mul, ← sum_sub_distrib]
    congr 1
    apply sum_congr rfl
    intro a _
    by_cases ha : cleanInitialBirthAllowed F C y <;>
      simp [repeatedBigUnbannedKernel, cleanInitialBirthKernel,
        repeated_big_fresh_hits_iff_not_allowed, ha]
  rw [he]
  exact h




