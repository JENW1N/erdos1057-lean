section

/- The actual ghost and edge sample sums split by fixed skeleton support without altering the continuation. -/

open Finset Classical

namespace Bounty

section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)] {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))

section Ghost
variable [∀ g p, NeZero (n g p)] (j : J) (htag : steps.get u = some (.inl j)) (sk : CoupledGhostSkeleton M B s)

theorem full_mixed_common_ghost_skeleton_stage_sum (F : CoupledGhostSamples M B s sk → ℝ) :
    let embed := fun i => (fullMixedCommonGhostSampleEmbedding S B j steps u htag s sk) ((fullMixedCommonGhostSampleOrder S B j steps u htag s sk) i)
    let owner := fullMixedCommonIndexStage M B steps
    let values := fun births => fullMixedCommonHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)) history
    let localValues := fun births i => (⟨(fullMixedCommonGhostSampleOrder S B j steps u htag s sk i).1, (births (fullMixedCommonGhostSampleOrder S B j steps u htag s sk i)).1⟩ : Sigma P)
    (∑ births : CoupledGhostSamples M B s sk,
      if birthForestStageCondition owner u.succ (values births) code then F births else 0) =
      if birthForestStageSupport owner u.succ (ownerSampleSupport embed owner u.succ history) code then
        ∑ births : CoupledGhostSamples M B s sk,
          if birthForestEqualValues (restrictedBirthCode embed code) (localValues births) ∧
            birthLabelsAnchored (fun i => (restrictedBirthAnchors embed code history i).join) (localValues births)
          then F births else 0
      else 0 := by
  dsimp only
  have h := owner_sample_stage_sum (fun i => (fullMixedCommonGhostSampleEmbedding S B j steps u htag s sk) ((fullMixedCommonGhostSampleOrder S B j steps u htag s sk) i))
    (full_mixed_common_ghost_sample_strictMono S B j steps u htag s sk)
    (fullMixedCommonIndexStage M B steps)
    (full_mixed_common_index_stage_monotone M B steps) u.succ
    (fun i => full_mixed_common_ghost_sample_owner S B j steps u htag s sk (fullMixedCommonGhostSampleOrder S B j steps u htag s sk i))
    code (fun births => fullMixedCommonHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, births⟩)) history)
    history (fun births i => (⟨(fullMixedCommonGhostSampleOrder S B j steps u htag s sk i).1, (births (fullMixedCommonGhostSampleOrder S B j steps u htag s sk i)).1⟩ : Sigma P))
    (by
      intro births i
      constructor
      · intro hi
        obtain ⟨c, hc⟩ := (full_mixed_common_ghost_history_sample_coverage n S B A Δ D steps u s history
          j htag sk births i).mp hi
        refine ⟨(fullMixedCommonGhostSampleOrder S B j steps u htag s sk).symm c, ?_⟩
        dsimp only
        rw [Equiv.apply_symm_apply]
        exact hc
      · rintro ⟨i, rfl⟩
        exact (full_mixed_common_ghost_history_sample_coverage n S B A Δ D steps u s history
          j htag sk births _).mpr ⟨(fullMixedCommonGhostSampleOrder S B j steps u htag s sk) i, rfl⟩)
    (fun births i hi => full_mixed_common_history_write_other n S B A Δ D steps u s _ history i (full_mixed_common_history_owner_ne M B steps u i hi))
    (fun births i => full_mixed_common_ghost_history_sample_label n S B A Δ D steps u s history
      j htag sk births (fullMixedCommonGhostSampleOrder S B j steps u htag s sk i)) F
  convert h using 1
  split_ifs
  · apply sum_congr rfl
    intro z _
    split_ifs <;> rfl
  · rfl


end Ghost

section Edge
variable (k : K) (htag : steps.get u = some (.inr k)) (sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s)

theorem full_mixed_common_edge_skeleton_stage_sum (F : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk → ℝ) :
    let embed := fun i => (fullMixedCommonEdgeSampleEmbedding n S B k steps u htag (A k) (Δ k) (D k) s sk) ((fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk) i)
    let owner := fullMixedCommonIndexStage M B steps
    let values := fun fresh => fullMixedCommonHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩)) history
    let localValues := fun fresh i => (⟨(fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk i).1, fresh (fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk i)⟩ : Sigma P)
    (∑ fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk,
      if birthForestStageCondition owner u.succ (values fresh) code then F fresh else 0) =
      if birthForestStageSupport owner u.succ (ownerSampleSupport embed owner u.succ history) code then
        ∑ fresh : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk,
          if birthForestEqualValues (restrictedBirthCode embed code) (localValues fresh) ∧
            birthLabelsAnchored (fun i => (restrictedBirthAnchors embed code history i).join) (localValues fresh)
          then F fresh else 0
      else 0 := by
  dsimp only
  have h := owner_sample_stage_sum (fun i => (fullMixedCommonEdgeSampleEmbedding n S B k steps u htag (A k) (Δ k) (D k) s sk) ((fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk) i))
    (full_mixed_common_edge_sample_strictMono n S B k steps u htag (A k) (Δ k) (D k) s sk)
    (fullMixedCommonIndexStage M B steps)
    (full_mixed_common_index_stage_monotone M B steps) u.succ
    (fun i => full_mixed_common_edge_sample_owner n S B k steps u htag (A k) (Δ k) (D k) s sk (fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk i))
    code (fun fresh => fullMixedCommonHistoryWrite n S B A Δ D steps u s
      (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, fresh⟩)) history)
    history (fun fresh i => (⟨(fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk i).1, fresh (fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk i)⟩ : Sigma P))
    (by
      intro fresh i
      constructor
      · intro hi
        obtain ⟨c, hc⟩ := (full_mixed_common_edge_history_sample_coverage n S B A Δ D steps u s history
          k htag sk fresh i).mp hi
        refine ⟨(fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk).symm c, ?_⟩
        dsimp only
        rw [Equiv.apply_symm_apply]
        exact hc
      · rintro ⟨i, rfl⟩
        exact (full_mixed_common_edge_history_sample_coverage n S B A Δ D steps u s history
          k htag sk fresh _).mpr ⟨(fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk) i, rfl⟩)
    (fun fresh i hi => full_mixed_common_history_write_other n S B A Δ D steps u s _ history i (full_mixed_common_history_owner_ne M B steps u i hi))
    (fun fresh i => full_mixed_common_edge_history_sample_label n S B A Δ D steps u s history
      k htag sk fresh (fullMixedCommonEdgeSampleOrder n S B k steps u htag (A k) (Δ k) (D k) s sk i)) F
  convert h using 1
  split_ifs
  · apply sum_congr rfl
    intro z _
    split_ifs <;> rfl
  · rfl


end Edge

end Full
end Bounty
