variable
  {G : Type*}
  [sharedInstance1 : DecidableEq G]
  {I X : G → Type*}
  [sharedInstance3 : ∀ g, DecidableEq (I g)]
  [sharedInstance4 : ∀ g, Fintype (X g)]
  (μ : ∀ g, X g → ℝ)
  (g : G)

include G sharedInstance1 I X sharedInstance3 sharedInstance4 μ g

theorem finite_group_flatten_average  (i : I g) (f : (∀ g, I g → X g) → ℂ) :
    finiteCoordinateAverage (fun a : Sigma I => μ a.1) ⟨g, i⟩ (finiteGroupFlattenFunction f) =
      finiteGroupFlattenFunction (finiteCoordinateLift g
        (finiteCoordinateAverage (fun _ : I g => μ g) i) f) := by
  funext x
  rw [finite_coordinate_average_update]
  change (∑ y, (μ g y : ℂ) * f (finiteGroupFlattenEquiv.symm (Function.update x ⟨g, i⟩ y))) = _
  simp only [finite_group_unflatten_update]
  change _ = finiteCoordinateLift g (finiteCoordinateAverage (fun _ : I g => μ g) i) f
    (finiteGroupFlattenEquiv.symm x)
  rw [finite_coordinate_lift_eq_update, finite_coordinate_average_update]

theorem finite_group_flatten_choice  (i : I g) (S : Finset (Sigma I)) (A : Finset (I g))
    (hi : (⟨g, i⟩ : Sigma I) ∈ S ↔ i ∈ A) (f : (∀ g, I g → X g) → ℂ) :
    finiteCoordinateChoice (fun a : Sigma I => μ a.1) ⟨g, i⟩ S (finiteGroupFlattenFunction f) =
      finiteGroupFlattenFunction (finiteCoordinateLift g
        (finiteCoordinateChoice (fun _ : I g => μ g) i A) f) := by
  have hav := finite_group_flatten_average μ g i f
  by_cases hA : i ∈ A
  · have hS := hi.mpr hA
    unfold finiteCoordinateChoice
    simp only [if_pos hS, if_pos hA]
    rw [hav]
    funext x
    simp only [Pi.sub_apply, finiteGroupFlattenFunction, finite_coordinate_lift_eq_update,
      Function.update_eq_self]
  · have hS : (⟨g, i⟩ : Sigma I) ∉ S := fun h => hA (hi.mp h)
    unfold finiteCoordinateChoice
    simp only [if_neg hS, if_neg hA]
    exact hav

theorem finite_group_flatten_component  (S : Finset (Sigma I)) (A : Finset (I g))
    (is : List (I g)) (hS : ∀ i ∈ is, (⟨g, i⟩ : Sigma I) ∈ S ↔ i ∈ A)
    (f : (∀ g, I g → X g) → ℂ) :
    finiteCoordinateComponent (fun a : Sigma I => μ a.1) S (is.map (Sigma.mk g))
        (finiteGroupFlattenFunction f) =
      finiteGroupFlattenFunction (finiteCoordinateLift g
        (finiteCoordinateComponent (fun _ : I g => μ g) A is) f) := by
  induction is with
  | nil =>
    simp only [List.map_nil, finiteCoordinateComponent, finite_coordinate_lift_identity]
  | cons i is ih =>
    simp only [List.map_cons, finiteCoordinateComponent]
    rw [ih (fun j hj => hS j (List.mem_cons_of_mem _ hj)),
      finite_group_flatten_choice μ g i S A (hS i (List.mem_cons_self)),
      finite_coordinate_lift_composition]

