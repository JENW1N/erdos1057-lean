section

/- Actual simultaneous pair-sieve moments, with a direct lattice-error bound. -/

open Finset

namespace Bounty

def pairSieveBadEvent (rough banned : ℕ → Bool) (v : ℕ × ℕ) (p : ℕ) : Prop :=
  (rough p = true ∧ (v.1*v.2) % p = 0) ∨ (banned p = true ∧ (v.1*v.2) % p = 1 % p)

noncomputable def pairSieveBaseBox (A B C D m : ℕ) : Finset (ℕ × ℕ) :=
  (Finset.product (Ioc A B) (Ioc C D)).filter (fun v => (v.1*v.2) % m = 1 % m)

noncomputable def pairSieveIntersection (A B C D m : ℕ) (P : Finset ℕ)
    (rough banned : ℕ → Bool) : Finset (ℕ × ℕ) := by
  classical
  exact (pairSieveBaseBox A B C D m).filter
    (fun v => ∀ p ∈ P, pairSieveBadEvent rough banned v p)

theorem actual_pair_sieve_intersection_error (A B C D m : ℕ) [NeZero m]
    (hAB : A ≤ B) (hCD : C ≤ D) (P : Finset ℕ) (rough banned : ℕ → Bool)
    (hP : ∀ p ∈ P, p.Prime) (hPm : ∀ p ∈ P, ¬p ∣ m) :
    |((pairSieveIntersection A B C D m P rough banned).card : ℝ) -
      (((B : ℝ)-A)*((D : ℝ)-C)*(m.totient : ℝ)/(m : ℝ)^2) *
        ∏ p ∈ P, pairSieveDensity p (rough p) (banned p)| ≤
      (m : ℝ)*((∏ p ∈ P, p : ℕ) : ℝ)^2 +
        (((B : ℝ)-A)+((D : ℝ)-C))*((∏ p ∈ P, p : ℕ) : ℝ) := by
  classical
  let d := ∏ p ∈ P, p
  let N := m*d
  let R := natPairSieveResidues m (natPairBaseResidues m) P
    (fun p => natPairBadResidues p (rough p) (banned p))
  have hm : 0 < m := Nat.pos_of_ne_zero (NeZero.ne m)
  have hd : 0 < d := prod_pos (fun p hp => (hP p hp).pos)
  have hN : 0 < N := mul_pos hm hd
  have hset : (pairSieveBaseBox A B C D m).filter
        (fun v => ∀ p ∈ P, pairSieveBadEvent rough banned v p) =
      (Finset.product (Ioc A B) (Ioc C D)).filter (fun v : ℕ × ℕ => (v.1 % N, v.2 % N) ∈ R) := by
    rw [pairSieveBaseBox, filter_filter]
    apply filter_congr
    intro v _
    rw [nat_pair_sieve_residues_mod m (natPairBaseResidues m) P
      (fun p => natPairBadResidues p (rough p) (banned p)) hN v,
      nat_pair_base_mod_iff m hm]
    apply and_congr_right
    intro _
    apply forall_congr'
    intro p
    apply imp_congr_right
    intro hp
    exact (nat_pair_bad_mod_iff p (hP p hp).pos (rough p) (banned p) v.1 v.2).symm
  have hcount := interval_allowed_nat_residue_pairs_error A B C D N hN R
    (fun _ hv => nat_pair_sieve_residues_bounds m (natPairBaseResidues m) P _ hv) hAB hCD
  have hNcast : (N : ℝ) = (m : ℝ) * ∏ p ∈ P, (p : ℝ) := by simp only [N, d, Nat.cast_mul, Nat.cast_prod]
  have hdensity := actual_pair_sieve_residue_density m P rough banned hP hPm
  change (R.card : ℝ) / ((m : ℝ) * ∏ p ∈ P, (p : ℝ))^2 = _ at hdensity
  have hmean : (R.card : ℝ) * ((((B : ℝ)-A)/N) * (((D : ℝ)-C)/N)) =
      (((B : ℝ)-A)*((D : ℝ)-C)*(m.totient : ℝ)/(m : ℝ)^2) *
        ∏ p ∈ P, pairSieveDensity p (rough p) (banned p) := by
    calc
      _ = ((B : ℝ)-A)*((D : ℝ)-C)*((R.card : ℝ)/(N : ℝ)^2) := by ring
      _ = _ := by rw [hNcast, hdensity]; ring
  rw [hmean] at hcount
  rw [pairSieveIntersection, hset]
  apply hcount.trans
  have hR : (R.card : ℝ) ≤ (m : ℝ)*(d : ℝ)^2 := by
    exact_mod_cast actual_pair_sieve_residue_card_le m P rough banned hP hPm
  have hx : 0 ≤ (B : ℝ)-A := sub_nonneg.mpr (Nat.cast_le.mpr hAB)
  have hy : 0 ≤ (D : ℝ)-C := sub_nonneg.mpr (Nat.cast_le.mpr hCD)
  simpa only [N, Nat.cast_mul] using
    pair_lattice_crude_error (Nat.cast_pos.mpr hm) (Nat.cast_pos.mpr hd) hx hy hR

end Bounty
end

