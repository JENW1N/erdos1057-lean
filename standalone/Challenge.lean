theorem eventually_ambient_rough_error_of_active_blocks (D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (μ : ℕ → ℝ) (γ S a v : ℝ),
      (∀ i ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        ∀ j ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        let B := shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) i)
            (ambientRoughIntervalTypeIIAlpha γ L S a v))
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) j)
            (ambientRoughTypeIIBeta (Real.exp (a*L)) (Real.exp (v*L))))
        B ≠ 0 → |B| ≤ Real.exp L * L^(-(D+4))) →
      |ambientRoughProxyError (arithmeticProductWindow 1 (Real.exp L)) μ γ L S
        (Real.exp (a*L)) (Real.exp (v*L))| ≤ Real.exp L * L^(-D) := by
  filter_upwards [eventually_original_bilinear_block_assembly D,eventually_ge_atTop (0 : ℝ)]
    with L hall hL
  intro μ γ S a v hblocks
  rw [ambient_rough_proxy_error_eq_interval_typeII hL]
  exact hall μ _ _ hblocks

theorem eventually_ambient_prime_error_of_active_blocks (D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (μ : ℕ → ℝ) (κ S : ℝ),
      (∀ proxy : Bool, ∀ i ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        ∀ j ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        let B := shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) i) (ambientPrimeTypeIIAlpha κ L S))
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) j)
            (if proxy then ambientProxyTypeIIBeta κ L S else ambientPrimeTypeIIBeta κ L))
        B ≠ 0 → |B| ≤ Real.exp L * L^(-(D+5))) →
      |ambientPrimeProxyError (arithmeticProductWindow 1 (Real.exp L)) μ κ L S| ≤
        Real.exp L * L^(-D) := by
  filter_upwards [eventually_original_bilinear_block_assembly (D+1),eventually_ge_atTop (2 : ℝ)]
    with L hall hL
  intro μ κ S hblocks
  have hL0 : 0 < L := by linarith
  have hf := hall μ (ambientPrimeTypeIIAlpha κ L S) (ambientPrimeTypeIIBeta κ L)
    (by simpa only [Bool.false_eq_true,if_false,show D+1+4=D+5 by ring] using hblocks false)
  have ht := hall μ (ambientPrimeTypeIIAlpha κ L S) (ambientProxyTypeIIBeta κ L S)
    (by simpa only [if_true,show D+1+4=D+5 by ring] using hblocks true)
  have hid : L * L^(-(D+1)) = L^(-D) := by
    conv_lhs => lhs; rw [← Real.rpow_one L]
    rw [← Real.rpow_add hL0]
    congr 1
    ring
  rw [ambient_prime_proxy_error_eq_typeII hL0.le]
  calc
    _ ≤ _ := abs_add_le _ _
    _ ≤ 2*(Real.exp L * L^(-(D+1))) := by linarith [hf,ht]
    _ ≤ L*(Real.exp L * L^(-(D+1))) := mul_le_mul_of_nonneg_right hL (by positivity)
    _ = Real.exp L * (L*L^(-(D+1))) := by ring
    _ = _ := by rw [hid]

end Bounty
