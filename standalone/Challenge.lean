/- The actual repeated-list kernel with just the two auxiliary collision bans removed. -/
noncomputable def repeatedBigUnbannedKernel {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (source target : RepeatedBigLists P J ell) : ℂ :=
  if repeatedBigSharedCompatible C source target then
    ((physicalAuxMass V C aux * repeatedBigTargetMass V b C target : ℝ) : ℂ) *
      K source target aux * physicalPhase ζ (repeatedBigD C source aux) else 0

