theorem full_mixed_common_forest_history_gain_tagged (u : Fin steps.length)
    (tag : Option (J ⊕ K)) (htag : steps.get u = tag)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P)) :
    fullMixedCommonForestHistoryGain n S B A Δ D steps code u.val tag s e history =
      if birthForestStageCondition (fullMixedCommonIndexStage M B steps) u.succ
        (fullMixedCommonHistoryWrite n S B A Δ D steps u s
          (fullMixedTaggedOwnerEvent n S B A Δ D steps u tag htag s e) history) code then 1 else 0 := by
