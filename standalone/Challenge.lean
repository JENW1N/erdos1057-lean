  rw [← candidate_B0_retained_eq_separated] at he
  have herr := typeII_actual_dyadic_error_saving (aE := aE) (A := A) (D := D)
    (T := D+K+2*aE+2*A+177) hL hK0 hU hV (E := U*L^(-K)) rfl (le_refl _)
  have hfactor : 0 ≤ 2*(U*L^(-K))*V*(L^aE)^2*(L^A)^2 := by positivity
  have ho := (mul_le_mul_of_nonneg_left he hfactor).trans herr
  have hs := candidate_retained_box_smooth_cauchy c L r jStar P M N take ξ
