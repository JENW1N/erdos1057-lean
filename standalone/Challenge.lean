open scoped BigOperators

/- A complex character on a finite group takes values on the unit circle. -/
theorem finite_character_norm {G : Type*} [Group G] [Finite G]
    (ξ : G →* ℂ) (g : G) : ‖ξ g‖ = 1 :=
  (ξ.isOfFinOrder (isOfFinOrder_of_finite g)).norm_eq_one

/- Low-order extensions use the pruned outlier count. Extensions without low-order
relations use the ambient Fejér estimate. Together they give one bound valid for
every nontrivial character of the retained subgroup. -/
theorem character_energy_lower_of_pruned_ambient
    {G ι : Type*} [CommGroup G] [Finite G]
    (H : Subgroup G) (S T : Finset ι) (hTS : T ⊆ S)
    (g : ι → G) (h : ι → H)
    (hlabel : ∀ i ∈ T, (h i : G) = g i)
    {N M A : ℝ} {R : ℕ} (hR : 0 < R)
    (hT : N / 2 ≤ (T.card : ℝ))
    (hRlarge : 64 * (S.card : ℝ) ≤ N * R)
    (hsmall : (R - 1 : ℝ) * A ≤ S.card)
    (hpruned : ∀ χ : H →* ℂ, χ ≠ 1 →
      M ≤ ((T.filter fun i => χ (h i) ≠ 1).card : ℝ))
    (hamb : ∀ ξ : G →* ℂ, ξ ≠ 1 → ‖∑ i ∈ S, ξ (g i)‖ ≤ A)
    (χ : H →* ℂ) (hχ : χ ≠ 1) :
    min (2 * M / (R : ℝ) ^ 2)
        (3 * N / (4 * Real.pi ^ 2 * (R : ℝ) ^ 2)) ≤
      ∑ i ∈ T, (1 - (χ (h i)).re) := by
  classical
  obtain ⟨ξ, hext⟩ := extend_complex_character H χ
  have hagree : ∀ i ∈ T, ξ (g i) = χ (h i) := by
    intro i hi
    rw [← hlabel i hi]
    exact hext (h i)
  by_cases hlow : ∃ m : ℕ, 0 < m ∧ m < R ∧ ξ ^ m = 1
  · obtain ⟨m, hm, hmR, hpow⟩ := hlow
    have hp : ∀ i ∈ T, (χ (h i)) ^ m = 1 := by
      intro i hi
      rw [← hagree i hi]
      have hv := DFunLike.congr_fun hpow (g i)
      simpa only [MonoidHom.pow_apply, MonoidHom.one_apply] using hv
    exact (min_le_left _ _).trans
      (root_unity_phase_sum_lower T (fun i => χ (h i)) hm hmR.le hp (hpruned χ hχ))
  · have hmom : ∀ j : ℕ, 1 ≤ j → j < R →
        ‖∑ i ∈ S, (ξ (g i)) ^ j‖ ≤ A := by
      intro j hj hjR
      have hne : ξ ^ j ≠ 1 := by
        intro heq
        exact hlow ⟨j, by omega, hjR, heq⟩
      simpa only [MonoidHom.pow_apply] using hamb (ξ ^ j) hne
    have henergy := energy_lower_of_moments S T hTS (fun i => ξ (g i))
      (fun i _ => finite_character_norm ξ (g i)) A hR hT hRlarge hsmall hmom
    have hequal : (∑ i ∈ T, (1 - (ξ (g i)).re)) =
        ∑ i ∈ T, (1 - (χ (h i)).re) := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [hagree i hi]
    rw [hequal] at henergy
    exact (min_le_right _ _).trans henergy
end

section

open scoped BigOperators

/- Extend the subgroup-valued reservoir labels by the identity off the subgroup. -/
noncomputable def subgroupLabel {G ι : Type*} [Group G]
    (H : Subgroup G) (g : ι → G) (i : ι) : H := by
  classical
  exact if hi : g i ∈ H then ⟨g i, hi⟩ else 1

theorem subgroupLabel_coe_of_mem {G ι : Type*} [Group G]
    (H : Subgroup G) (g : ι → G) {i : ι} (hi : g i ∈ H) :
    (subgroupLabel H g i : G) = g i := by
  classical
  simp only [subgroupLabel, hi, dite_true]

theorem subgroupReservoir_subset {G ι : Type*} [Group G]
    (P : Finset ι) (g : ι → G) (H : Subgroup G) : subgroupReservoir P g H ⊆ P := by
  classical
  exact Finset.filter_subset _ P

/- The ambient reservoir of the mapped kernel is precisely the retained
reservoir on which the subgroup character is trivial. -/
theorem subgroupReservoir_kernel_eq {G ι : Type*} [Group G]
    (P : Finset ι) (g : ι → G) (H : Subgroup G) (χ : H →* ℂ) :
    subgroupReservoir P g (χ.ker.map H.subtype) =
      (subgroupReservoir P g H).filter (fun i => χ (subgroupLabel H g i) = 1) := by
  classical
  ext i
  simp only [subgroupReservoir, Finset.mem_filter]
  constructor
  · rintro ⟨hiP, hiK⟩
    have hiH : g i ∈ H := (Subgroup.map_subtype_le χ.ker) hiK
    obtain ⟨x, hx, hxg⟩ := Subgroup.mem_map.mp hiK
    have hlabel : subgroupLabel H g i = x := by
      apply Subtype.ext
      rw [subgroupLabel_coe_of_mem H g hiH]
      exact hxg.symm
    refine ⟨⟨hiP, hiH⟩, ?_⟩
    rw [hlabel]
    exact hx
  · rintro ⟨⟨hiP, hiH⟩, hχ⟩
    refine ⟨hiP, Subgroup.mem_map.mpr ?_⟩
    exact ⟨subgroupLabel H g i, hχ, subgroupLabel_coe_of_mem H g hiH⟩

/- Pruning a reservoir inside an ambient set with character cancellation
produces a retained half-reservoir with a uniform positive spectral bound. -/
theorem exists_pruned_energy_reservoir
    {G ι : Type*} [CommGroup G] [Finite G]
    (S P : Finset ι) (hPS : P ⊆ S) (g : ι → G)
    {M A : ℝ} (hM : 0 ≤ M)
    (hbudget : M * Nat.log 2 (Nat.card G) ≤ (P.card : ℝ) / 2)
    {R : ℕ} (hR : 0 < R)
    (hRlarge : 64 * (S.card : ℝ) ≤ (P.card : ℝ) * R)
    (hsmall : (R - 1 : ℝ) * A ≤ S.card)
    (hamb : ∀ ξ : G →* ℂ, ξ ≠ 1 → ‖∑ i ∈ S, ξ (g i)‖ ≤ A) :
    ∃ (H : Subgroup G) (T : Finset ι) (h : ι → H),
      T = subgroupReservoir P g H ∧ T ⊆ P ∧
      (P.card : ℝ) / 2 ≤ (T.card : ℝ) ∧
      (∀ i ∈ T, (h i : G) = g i) ∧
      ∀ χ : H →* ℂ, χ ≠ 1 →
        min (2 * M / (R : ℝ) ^ 2)
          (3 * (P.card : ℝ) / (4 * Real.pi ^ 2 * (R : ℝ) ^ 2)) ≤
          ∑ i ∈ T, (1 - (χ (h i)).re) := by
  classical
  obtain ⟨H, hhalf, hstable⟩ := exists_character_pruned_subgroup P g hM hbudget
  let T := subgroupReservoir P g H
  let h := subgroupLabel H g
  have hTP : T ⊆ P := subgroupReservoir_subset P g H
  have hagree : ∀ i ∈ T, (h i : G) = g i := by
    intro i hi
    exact subgroupLabel_coe_of_mem H g (Finset.mem_filter.mp hi).2
  have hpruned : ∀ χ : H →* ℂ, χ ≠ 1 →
      M ≤ ((T.filter fun i => χ (h i) ≠ 1).card : ℝ) := by
    intro χ hχ
    have hstab := hstable χ hχ
    have hpart : ((T.filter fun i => χ (h i) = 1).card : ℝ) +
        ((T.filter fun i => χ (h i) ≠ 1).card : ℝ) = T.card := by
      exact_mod_cast Finset.card_filter_add_card_filter_not (s := T) (fun i => χ (h i) = 1)
    rw [subgroupReservoir_kernel_eq P g H χ] at hstab
    change M ≤ (T.card : ℝ) - ((T.filter fun i => χ (h i) = 1).card : ℝ) at hstab
    linarith
  refine ⟨H, T, h, rfl, hTP, hhalf, hagree, ?_⟩
  intro χ hχ
  exact character_energy_lower_of_pruned_ambient H S T (hTP.trans hPS) g h hagree
    hR hhalf hRlarge hsmall hpruned hamb χ hχ
end

section

/- A family carrying mass at least `m`, with every point of mass at most `p`,
has cardinality at least `m / p`. No sign condition on the individual weights is needed. -/
theorem card_ge_mass_div_bound {α : Type*} (A : Finset α) (w : α → ℝ)
    {m p : ℝ} (hp : 0 < p) (hmass : m ≤ ∑ a ∈ A, w a)
    (hpoint : ∀ a ∈ A, w a ≤ p) : m / p ≤ (A.card : ℝ) := by
  apply (div_le_iff₀ hp).2
  have hsum : (∑ a ∈ A, w a) ≤ (A.card : ℝ) * p := by
    calc
      (∑ a ∈ A, w a) ≤ ∑ _a ∈ A, p := Finset.sum_le_sum hpoint
      _ = (A.card : ℝ) * p := by simp
  exact hmass.trans hsum

/- The mass assigned to `s` when each element of `S` is selected with probability `ρ`. -/
def bernoulliSubsetWeight {α : Type*} (ρ : ℝ) (S s : Finset α) : ℝ :=
  ρ ^ s.card * (1 - ρ) ^ (S.card - s.card)

theorem bernoulliSubsetWeight_nonneg {α : Type*} {ρ : ℝ}
    (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1) (S s : Finset α) :
    0 ≤ bernoulliSubsetWeight ρ S s := by
  unfold bernoulliSubsetWeight
  positivity

/- A subset with at least `k` elements has mass at most `ρ ^ k`. -/
theorem bernoulliSubsetWeight_le_pow {α : Type*} {ρ : ℝ}
    (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1) (S s : Finset α) {k : ℕ}
    (hk : k ≤ s.card) : bernoulliSubsetWeight ρ S s ≤ ρ ^ k := by
  unfold bernoulliSubsetWeight
  calc
    ρ ^ s.card * (1 - ρ) ^ (S.card - s.card) ≤ ρ ^ s.card * 1 :=
      mul_le_mul_of_nonneg_left (pow_le_one₀ (by linarith) (by linarith))
        (pow_nonneg hρ₀ _)
    _ = ρ ^ s.card := mul_one _
    _ ≤ ρ ^ k := pow_le_pow_of_le_one hρ₀ hρ₁ hk

/- The Bernoulli masses of all subsets sum to one. -/
theorem sum_bernoulliSubsetWeight {α : Type*} (ρ : ℝ) (S : Finset α) :
    ∑ s ∈ S.powerset, bernoulliSubsetWeight ρ S s = 1 := by
  unfold bernoulliSubsetWeight
  rw [Finset.sum_pow_mul_eq_add_pow]
  simp

/- The counting step used after obtaining a positive mass of sufficiently large subsets. -/
theorem card_ge_bernoulli_mass_div_pow {α : Type*} {ρ : ℝ}
    (hρ₀ : 0 < ρ) (hρ₁ : ρ ≤ 1) (S : Finset α) (A : Finset (Finset α))
    {m : ℝ} {k : ℕ} (hmass : m ≤ ∑ s ∈ A, bernoulliSubsetWeight ρ S s)
    (hsize : ∀ s ∈ A, k ≤ s.card) :
    m / ρ ^ k ≤ (A.card : ℝ) := by
  exact card_ge_mass_div_bound A (bernoulliSubsetWeight ρ S) (pow_pos hρ₀ k) hmass
    (fun s hs => bernoulliSubsetWeight_le_pow hρ₀.le hρ₁ S s (hsize s hs))

/- Finite expansion of the product generating function. It applies, in particular,
to complex character values by taking `r = ρ` and `t = 1 - ρ`. -/
theorem subset_weighted_product_expansion {α R : Type*} [CommSemiring R]
    (S : Finset α) (r t : R) (z : α → R) :
    (∑ s ∈ S.powerset,
      (r ^ s.card * t ^ (S.card - s.card)) * ∏ i ∈ s, z i) =
      ∏ i ∈ S, (t + r * z i) := by
  classical
  symm
  simp_rw [add_comm t]
  rw [Finset.prod_add]
  apply Finset.sum_congr rfl
  intro s hs
  rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.prod_const,
    Finset.card_sdiff_of_subset (Finset.mem_powerset.1 hs)]
  ring


/- The complex generating function for the Bernoulli subset distribution. -/
theorem bernoulli_complex_product_expansion {α : Type*}
    (S : Finset α) (ρ : ℝ) (z : α → ℂ) :
    (∑ s ∈ S.powerset,
      (bernoulliSubsetWeight ρ S s : ℂ) * ∏ i ∈ s, z i) =
      ∏ i ∈ S, (1 - (ρ : ℂ) + (ρ : ℂ) * z i) := by
  simpa [bernoulliSubsetWeight] using
    subset_weighted_product_expansion S (ρ : ℂ) (1 - (ρ : ℂ)) z



end

section

/- Exact squared modulus of one Bernoulli character factor. -/
theorem bernoulliFactor_norm_sq (ρ : ℝ) {z : ℂ} (hz : ‖z‖ = 1) :
    ‖((1 - ρ : ℝ) : ℂ) + (ρ : ℂ) * z‖ ^ 2 =
      1 - 2 * ρ * (1 - ρ) * (1 - z.re) := by
  have hzsq : z.re * z.re + z.im * z.im = 1 := by
    rw [← Complex.normSq_apply, Complex.normSq_eq_norm_sq, hz, one_pow]
  simp only [Complex.sq_norm, Complex.normSq_apply, Complex.add_re, Complex.add_im,
    Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
    zero_mul, zero_add, add_zero, sub_zero]
  linear_combination ρ ^ 2 * hzsq

/- Exponential contraction for one character value on the unit circle.
The estimate in fact holds for every real parameter, and hence for all Bernoulli parameters. -/
theorem bernoulliFactor_norm_le_exp (ρ : ℝ) {z : ℂ} (hz : ‖z‖ = 1) :
    ‖((1 - ρ : ℝ) : ℂ) + (ρ : ℂ) * z‖ ≤
      Real.exp (-ρ * (1 - ρ) * (1 - z.re)) := by
  have hsq := bernoulliFactor_norm_sq ρ hz
  have hexp := Real.add_one_le_exp (-2 * ρ * (1 - ρ) * (1 - z.re))
  have hexpsq : Real.exp (-ρ * (1 - ρ) * (1 - z.re)) ^ 2 =
      Real.exp (-2 * ρ * (1 - ρ) * (1 - z.re)) := by
    rw [pow_two, ← Real.exp_add]
    congr 1
    ring
  have hpos := Real.exp_pos (-ρ * (1 - ρ) * (1 - z.re))
  nlinarith [norm_nonneg (((1 - ρ : ℝ) : ℂ) + (ρ : ℂ) * z)]

/- Independent Bernoulli character factors have an exponential bound in their total energy. -/
theorem bernoulliProduct_norm_le_exp {ι : Type*} (s : Finset ι) (ρ : ℝ)
    (z : ι → ℂ) (hz : ∀ i ∈ s, ‖z i‖ = 1) :
    ‖∏ i ∈ s, (((1 - ρ : ℝ) : ℂ) + (ρ : ℂ) * z i)‖ ≤
      Real.exp (-ρ * (1 - ρ) * ∑ i ∈ s, (1 - (z i).re)) := by
  rw [norm_prod]
  calc
    ∏ i ∈ s, ‖((1 - ρ : ℝ) : ℂ) + (ρ : ℂ) * z i‖ ≤
        ∏ i ∈ s, Real.exp (-ρ * (1 - ρ) * (1 - (z i).re)) := by
      apply Finset.prod_le_prod₀
      · intro i hi
        exact norm_nonneg _
      · intro i hi
        exact bernoulliFactor_norm_le_exp ρ (hz i hi)
    _ = Real.exp (-ρ * (1 - ρ) * ∑ i ∈ s, (1 - (z i).re)) := by
      rw [← Real.exp_sum, Finset.mul_sum]

/- The Bernoulli-weighted subset-product transform satisfies the energy bound. -/
theorem bernoulliSubsetSum_norm_le_exp {ι : Type*} (s : Finset ι) (ρ : ℝ)
    (z : ι → ℂ) (hz : ∀ i ∈ s, ‖z i‖ = 1) :
    ‖∑ t ∈ s.powerset,
        (bernoulliSubsetWeight ρ s t : ℂ) * ∏ i ∈ t, z i‖ ≤
      Real.exp (-ρ * (1 - ρ) * ∑ i ∈ s, (1 - (z i).re)) := by
  rw [bernoulli_complex_product_expansion]
  simpa only [Complex.ofReal_sub, Complex.ofReal_one] using
    bernoulliProduct_norm_le_exp s ρ z hz

/- Applying a multiplicative character to each subset product gives the same contraction. -/
theorem bernoulliCharacterSum_norm_le_exp {ι G : Type*} [CommMonoid G]
    (s : Finset ι) (ρ : ℝ) (g : ι → G) (χ : G →* ℂ)
    (hχ : ∀ i ∈ s, ‖χ (g i)‖ = 1) :
    ‖∑ t ∈ s.powerset,
        (bernoulliSubsetWeight ρ s t : ℂ) * χ (∏ i ∈ t, g i)‖ ≤
      Real.exp (-ρ * (1 - ρ) * ∑ i ∈ s, (1 - (χ (g i)).re)) := by
  simpa only [map_prod] using bernoulliSubsetSum_norm_le_exp s ρ (fun i => χ (g i)) hχ

/- Finite additive characters have unit modulus, so their Bernoulli coefficients contract. -/
theorem bernoulliAddCharSum_norm_le_exp {ι G : Type*}
    [AddCommGroup G] [Finite G] (s : Finset ι) (ρ : ℝ) (g : ι → G)
    (χ : AddChar G ℂ) :
    ‖∑ t ∈ s.powerset,
        (bernoulliSubsetWeight ρ s t : ℂ) * χ (∑ i ∈ t, g i)‖ ≤
      Real.exp (-ρ * (1 - ρ) * ∑ i ∈ s, (1 - (χ (g i)).re)) := by
  have h := bernoulliCharacterSum_norm_le_exp s ρ (fun i => Multiplicative.ofAdd (g i))
    χ.toMonoidHom (fun i _ => χ.norm_apply (g i))
  simpa only [← ofAdd_sum, AddChar.toMonoidHom_apply, toAdd_ofAdd] using h
end

section
open scoped BigOperators
theorem character_sum_real {G : Type*} [AddCommGroup G] [Fintype G] [DecidableEq G]
    (g : G) :
    (∑ χ : AddChar G ℂ, (χ g).re) =
      if g = 0 then (Fintype.card G : ℝ) else 0 := by
  classical
  have h := congrArg Complex.re (AddChar.sum_apply_eq_ite g)
  by_cases hg : g = 0
  · simp [hg]
  · simpa [hg] using h

theorem weighted_character_sum_real {G ι : Type*}
    [AddCommGroup G] [Fintype G] [DecidableEq G] (s : Finset ι) (w : ι → ℝ) (f : ι → G) :
    (∑ χ : AddChar G ℂ, (∑ a ∈ s, (w a : ℂ) * χ (f a)).re) =
      (Fintype.card G : ℝ) * ∑ a ∈ s, if f a = 0 then w a else 0 := by
  classical
  simp only [Complex.re_sum, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
    zero_mul, sub_zero]
  rw [Finset.sum_comm]
  simp_rw [← Finset.mul_sum, character_sum_real]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro a ha
  split_ifs <;> ring

/- Small nonprincipal Fourier coefficients force mass near the uniform mass
at the identity. The weights need not be nonnegative for this implication. -/
theorem identity_mass_lower_bound {G ι : Type*}
    [AddCommGroup G] [Fintype G] [DecidableEq G] (s : Finset ι) (w : ι → ℝ) (f : ι → G)
    (hsum : ∑ a ∈ s, w a = 1) {b : ℝ} (hb : 0 ≤ b)
    (hfourier : ∀ χ : AddChar G ℂ, χ ≠ 0 →
      ‖∑ a ∈ s, (w a : ℂ) * χ (f a)‖ ≤ b) :
    1 / (Fintype.card G : ℝ) - b ≤
      ∑ a ∈ s, if f a = 0 then w a else 0 := by
  classical
  let F : AddChar G ℂ → ℂ := fun χ => ∑ a ∈ s, (w a : ℂ) * χ (f a)
  have hF0 : (F 0).re = 1 := by simp [F, hsum]
  have hterm (χ : AddChar G ℂ) (hχ : χ ∈ (Finset.univ.erase 0)) :
      -b ≤ (F χ).re := by
    have hχ0 : χ ≠ 0 := (Finset.mem_erase.mp hχ).1
    have hr := (abs_le.mp (Complex.abs_re_le_norm (F χ))).1
    have hn := hfourier χ hχ0
    dsimp [F] at hr ⊢
    linarith
  have hsumlower := Finset.sum_le_sum hterm
  have hcard : (Finset.univ.erase (0 : AddChar G ℂ)).card = Fintype.card G - 1 := by
    simp [AddChar.card_eq]
  have hsplit : (∑ χ : AddChar G ℂ, (F χ).re) =
      1 + ∑ χ ∈ (Finset.univ.erase 0), (F χ).re := by
    rw [← Finset.sum_erase_add _ _ (Finset.mem_univ (0 : AddChar G ℂ)), hF0]
    ring
  have htotal := weighted_character_sum_real s w f
  change (∑ χ : AddChar G ℂ, (F χ).re) = _ at htotal
  have hc : 0 < (Fintype.card G : ℝ) := by exact_mod_cast Fintype.card_pos
  have hcast : ((Fintype.card G - 1 : ℕ) : ℝ) = Fintype.card G - 1 := by
    rw [Nat.cast_sub (by have := Fintype.card_pos (α := G); omega)]
    norm_num
  simp only [Finset.sum_const, nsmul_eq_mul, hcard, hcast] at hsumlower
  have hmain : 1 - (Fintype.card G : ℝ) * b ≤
      (Fintype.card G : ℝ) * (∑ a ∈ s, if f a = 0 then w a else 0) := by
    linarith
  apply (le_of_mul_le_mul_left (a := (Fintype.card G : ℝ)) ?_ hc)
  calc
    (Fintype.card G : ℝ) * (1 / (Fintype.card G : ℝ) - b) =
        1 - (Fintype.card G : ℝ) * b := by field_simp
    _ ≤ _ := hmain
end

section

/- Uniform character energy forces the Bernoulli subset sum close to uniform
at the identity of a finite abelian group. -/
theorem bernoulli_identity_mass_lower_bound {ι G : Type*}
    [AddCommGroup G] [Fintype G] [DecidableEq G]
    (s : Finset ι) (g : ι → G) {ρ E : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (henergy : ∀ χ : AddChar G ℂ, χ ≠ 0 →
      E ≤ ∑ i ∈ s, (1 - (χ (g i)).re)) :
    1 / (Fintype.card G : ℝ) - Real.exp (-ρ * (1 - ρ) * E) ≤
      ∑ t ∈ s.powerset,
        if (∑ i ∈ t, g i) = 0 then bernoulliSubsetWeight ρ s t else 0 := by
  apply identity_mass_lower_bound s.powerset (bernoulliSubsetWeight ρ s)
    (fun t => ∑ i ∈ t, g i) (sum_bernoulliSubsetWeight ρ s) (Real.exp_pos _).le
  intro χ hχ
  apply (bernoulliAddCharSum_norm_le_exp s ρ g χ).trans
  apply Real.exp_le_exp.mpr
  exact mul_le_mul_of_nonpos_left (henergy χ hχ)
    (mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr hρ0) (sub_nonneg.mpr hρ1))



end

section

/- Exponential Markov inequality for a finite weighted space. -/
theorem finite_exponential_markov {α : Type*}
    (Ω A : Finset α) (hA : A ⊆ Ω) (w f : α → ℝ)
    (hw : ∀ a ∈ Ω, 0 ≤ w a) {b : ℝ} (hf : ∀ a ∈ A, b ≤ f a) :
    (∑ a ∈ A, w a) ≤ Real.exp (-b) * ∑ a ∈ Ω, w a * Real.exp (f a) := by
  calc
    (∑ a ∈ A, w a) ≤ ∑ a ∈ A, Real.exp (-b) * (w a * Real.exp (f a)) := by
      apply Finset.sum_le_sum
      intro a ha
      calc
        w a = w a * Real.exp 0 := by simp
        _ ≤ w a * Real.exp (f a - b) :=
          mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (by linarith [hf a ha]))
            (hw a (hA ha))
        _ = Real.exp (-b) * (w a * Real.exp (f a)) := by
          rw [sub_eq_add_neg, Real.exp_add]
          ring
    _ = Real.exp (-b) * ∑ a ∈ A, w a * Real.exp (f a) := by
      rw [Finset.mul_sum]
    _ ≤ Real.exp (-b) * ∑ a ∈ Ω, w a * Real.exp (f a) := by
      apply mul_le_mul_of_nonneg_left _ (Real.exp_pos _).le
      apply Finset.sum_le_sum_of_subset_of_nonneg hA
      intro a ha _
      exact mul_nonneg (hw a ha) (Real.exp_pos _).le

section

variable
  {α : Type*}
  (S : Finset α)

include α S

/- Exact exponential moment of the subset size. -/
theorem bernoulli_size_mgf  (ρ θ : ℝ) :
    (∑ s ∈ S.powerset, bernoulliSubsetWeight ρ S s * Real.exp (θ * (s.card : ℝ))) =
      (1 - ρ + ρ * Real.exp θ) ^ S.card := by
  have h := subset_weighted_product_expansion S ρ (1 - ρ) (fun _ => Real.exp θ)
  simpa only [bernoulliSubsetWeight, Finset.prod_const, mul_comm θ, Real.exp_nat_mul] using h

/- Poisson exponential-moment bound for a Bernoulli subset size. -/
theorem bernoulli_size_mgf_le  {ρ : ℝ}
    (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1) (θ : ℝ) :
    (∑ s ∈ S.powerset, bernoulliSubsetWeight ρ S s * Real.exp (θ * (s.card : ℝ))) ≤
      Real.exp (ρ * S.card * (Real.exp θ - 1)) := by
  rw [bernoulli_size_mgf]
  have hbase : 0 ≤ 1 - ρ + ρ * Real.exp θ := by positivity
  have hstep : 1 - ρ + ρ * Real.exp θ ≤ Real.exp (ρ * (Real.exp θ - 1)) := by
    have := Real.add_one_le_exp (ρ * (Real.exp θ - 1))
    nlinarith
  calc
    (1 - ρ + ρ * Real.exp θ) ^ S.card ≤
        Real.exp (ρ * (Real.exp θ - 1)) ^ S.card := pow_le_pow_left₀ hbase hstep _
    _ = Real.exp (ρ * S.card * (Real.exp θ - 1)) := by
      rw [← Real.exp_nat_mul]
      congr 1
      ring

/- The centered exponential moment is bounded uniformly in either sign of `θ`. -/
theorem bernoulli_centered_mgf_le  {ρ : ℝ}
    (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1) (θ : ℝ) :
    (∑ s ∈ S.powerset, bernoulliSubsetWeight ρ S s *
      Real.exp (θ * ((s.card : ℝ) - ρ * S.card))) ≤
      Real.exp (ρ * S.card * (Real.exp θ - 1 - θ)) := by
  calc
    (∑ s ∈ S.powerset, bernoulliSubsetWeight ρ S s *
        Real.exp (θ * ((s.card : ℝ) - ρ * S.card))) =
        Real.exp (-θ * (ρ * S.card)) *
          ∑ s ∈ S.powerset, bernoulliSubsetWeight ρ S s * Real.exp (θ * (s.card : ℝ)) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro s _
      rw [show θ * ((s.card : ℝ) - ρ * S.card) =
        -θ * (ρ * S.card) + θ * (s.card : ℝ) by ring, Real.exp_add]
      ring
    _ ≤ Real.exp (-θ * (ρ * S.card)) *
        Real.exp (ρ * S.card * (Real.exp θ - 1)) :=
      mul_le_mul_of_nonneg_left (bernoulli_size_mgf_le S hρ₀ hρ₁ θ) (Real.exp_pos _).le
    _ = Real.exp (ρ * S.card * (Real.exp θ - 1 - θ)) := by
      rw [← Real.exp_add]
      congr 1
      ring

/- A quadratic bound for the centered exponential moment when `|θ| ≤ 1`. -/
theorem bernoulli_centered_mgf_le_quadratic  {ρ θ : ℝ}
    (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1) (hθ : |θ| ≤ 1) :
    (∑ s ∈ S.powerset, bernoulliSubsetWeight ρ S s *
      Real.exp (θ * ((s.card : ℝ) - ρ * S.card))) ≤
      Real.exp (ρ * S.card * θ ^ 2) := by
  apply (bernoulli_centered_mgf_le S hρ₀ hρ₁ θ).trans
  apply Real.exp_le_exp.mpr
  exact mul_le_mul_of_nonneg_left
    ((le_abs_self _).trans (Real.abs_exp_sub_one_sub_id_le hθ)) (by positivity)


/- Any family above a centered exponential threshold has exponentially small mass. -/
theorem bernoulli_centered_markov  (A : Finset (Finset α))
    (hA : A ⊆ S.powerset) {ρ θ b : ℝ} (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1)
    (hθ : |θ| ≤ 1) (hthreshold : ∀ s ∈ A, b ≤ θ * ((s.card : ℝ) - ρ * S.card)) :
    (∑ s ∈ A, bernoulliSubsetWeight ρ S s) ≤ Real.exp (ρ * S.card * θ ^ 2 - b) := by
  calc
    (∑ s ∈ A, bernoulliSubsetWeight ρ S s) ≤ Real.exp (-b) *
        ∑ s ∈ S.powerset, bernoulliSubsetWeight ρ S s *
          Real.exp (θ * ((s.card : ℝ) - ρ * S.card)) :=
      finite_exponential_markov S.powerset A hA _ _
        (fun s _ => bernoulliSubsetWeight_nonneg hρ₀ hρ₁ S s) hthreshold
    _ ≤ Real.exp (-b) * Real.exp (ρ * S.card * θ ^ 2) :=
      mul_le_mul_of_nonneg_left (bernoulli_centered_mgf_le_quadratic S hρ₀ hρ₁ hθ)
        (Real.exp_pos _).le
    _ = Real.exp (ρ * S.card * θ ^ 2 - b) := by
      rw [← Real.exp_add]
      congr 1
      ring

/- Upper relative deviation of a Bernoulli subset size. -/
theorem bernoulli_upper_tail_mass_le  (A : Finset (Finset α))
    (hA : A ⊆ S.powerset) {ρ ν : ℝ} (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1)
    (hν₀ : 0 ≤ ν) (hν₁ : ν ≤ 1)
    (hsize : ∀ s ∈ A, (1 + ν) * (ρ * S.card) ≤ (s.card : ℝ)) :
    (∑ s ∈ A, bernoulliSubsetWeight ρ S s) ≤
      Real.exp (-ν ^ 2 * (ρ * S.card) / 4) := by
  have hθ : |ν / 2| ≤ 1 := by rw [abs_of_nonneg (by positivity)]; linarith
  have hb : ∀ s ∈ A, ν ^ 2 * (ρ * S.card) / 2 ≤
      (ν / 2) * ((s.card : ℝ) - ρ * S.card) := by
    intro s hs
    have hm := mul_le_mul_of_nonneg_left (hsize s hs) hν₀
    nlinarith
  have h := bernoulli_centered_markov S A hA hρ₀ hρ₁ hθ hb
  convert h using 1
  congr 1
  ring

/- Lower relative deviation of a Bernoulli subset size. -/
theorem bernoulli_lower_tail_mass_le  (A : Finset (Finset α))
    (hA : A ⊆ S.powerset) {ρ ν : ℝ} (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1)
    (hν₀ : 0 ≤ ν) (hν₁ : ν ≤ 1)
    (hsize : ∀ s ∈ A, (s.card : ℝ) ≤ (1 - ν) * (ρ * S.card)) :
    (∑ s ∈ A, bernoulliSubsetWeight ρ S s) ≤
      Real.exp (-ν ^ 2 * (ρ * S.card) / 4) := by
  have hθ : |-(ν / 2)| ≤ 1 := by rw [abs_neg, abs_of_nonneg (by positivity)]; linarith
  have hb : ∀ s ∈ A, ν ^ 2 * (ρ * S.card) / 2 ≤
      -(ν / 2) * ((s.card : ℝ) - ρ * S.card) := by
    intro s hs
    have hm := mul_le_mul_of_nonneg_left (hsize s hs) hν₀
    nlinarith
  have h := bernoulli_centered_markov S A hA hρ₀ hρ₁ hθ hb
  convert h using 1
  congr 1
  ring


/- Two-sided relative tail bound; the constant `1/4` is sufficient for the transfer. -/
theorem bernoulli_relative_tail_mass_le 
    {ρ ν : ℝ} (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1) (hν₀ : 0 ≤ ν) (hν₁ : ν ≤ 1) :
    (∑ s ∈ S.powerset with ν * (ρ * S.card) < |(s.card : ℝ) - ρ * S.card|,
      bernoulliSubsetWeight ρ S s) ≤ 2 * Real.exp (-ν ^ 2 * (ρ * S.card) / 4) := by
  classical
  let U := S.powerset.filter fun s => (1 + ν) * (ρ * S.card) ≤ (s.card : ℝ)
  let L := S.powerset.filter fun s => (s.card : ℝ) ≤ (1 - ν) * (ρ * S.card)
  have hu := bernoulli_upper_tail_mass_le S U (Finset.filter_subset _ _)
    hρ₀ hρ₁ hν₀ hν₁ (fun s hs => (Finset.mem_filter.mp hs).2)
  have hl := bernoulli_lower_tail_mass_le S L (Finset.filter_subset _ _)
    hρ₀ hρ₁ hν₀ hν₁ (fun s hs => (Finset.mem_filter.mp hs).2)
  have hsum : (∑ s ∈ S.powerset with ν * (ρ * S.card) < |(s.card : ℝ) - ρ * S.card|,
      bernoulliSubsetWeight ρ S s) ≤
      (∑ s ∈ U, bernoulliSubsetWeight ρ S s) + ∑ s ∈ L, bernoulliSubsetWeight ρ S s := by
    dsimp [U, L]
    simp only [Finset.sum_filter]
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_le_sum
    intro s hs
    have hw := bernoulliSubsetWeight_nonneg hρ₀ hρ₁ S s
    have hcover : ν * (ρ * S.card) < |(s.card : ℝ) - ρ * S.card| →
        (1 + ν) * (ρ * S.card) ≤ (s.card : ℝ) ∨
        (s.card : ℝ) ≤ (1 - ν) * (ρ * S.card) := by
      intro hb
      by_contra h
      push Not at h
      have habs : |(s.card : ℝ) - ρ * S.card| ≤ ν * (ρ * S.card) :=
        abs_le.mpr ⟨by linarith [h.2], by linarith [h.1]⟩
      exact (not_lt_of_ge habs) hb
    split_ifs <;> simp_all
  linarith

end



/- Deleting a bad event from a family loses no more than its total ambient mass. -/
theorem finite_mass_filter_lower_bound {α : Type*}
    (Ω A : Finset α) (hA : A ⊆ Ω) (w : α → ℝ) (hw : ∀ a ∈ Ω, 0 ≤ w a)
    (good : α → Prop) [DecidablePred good] {m e : ℝ}
    (hmass : m ≤ ∑ a ∈ A, w a) (hbad : (∑ a ∈ Ω with ¬good a, w a) ≤ e) :
    m - e ≤ ∑ a ∈ A with good a, w a := by
  have hsplit := Finset.sum_filter_add_sum_filter_not A good w
  have hsub : A.filter (fun a => ¬good a) ⊆ Ω.filter (fun a => ¬good a) := by
    intro a ha
    exact Finset.mem_filter.mpr ⟨hA (Finset.mem_filter.mp ha).1, (Finset.mem_filter.mp ha).2⟩
  have hle : (∑ a ∈ A with ¬good a, w a) ≤ ∑ a ∈ Ω with ¬good a, w a := by
    apply Finset.sum_le_sum_of_subset_of_nonneg hsub
    intro a ha _
    exact hw a (Finset.mem_filter.mp ha).1
  linarith

/- Retaining only subsets near their mean preserves the initial family mass,
up to the proved exponentially small tail loss. -/
theorem bernoulli_good_size_mass_lower_bound {α : Type*}
    (S : Finset α) (A : Finset (Finset α)) (hA : A ⊆ S.powerset)
    {ρ ν m : ℝ} (hρ₀ : 0 ≤ ρ) (hρ₁ : ρ ≤ 1) (hν₀ : 0 ≤ ν) (hν₁ : ν ≤ 1)
    (hmass : m ≤ ∑ s ∈ A, bernoulliSubsetWeight ρ S s) :
    m - 2 * Real.exp (-ν ^ 2 * (ρ * S.card) / 4) ≤
      ∑ s ∈ A with |(s.card : ℝ) - ρ * S.card| ≤ ν * (ρ * S.card),
        bernoulliSubsetWeight ρ S s := by
  apply finite_mass_filter_lower_bound S.powerset A hA _
    (fun s _ => bernoulliSubsetWeight_nonneg hρ₀ hρ₁ S s) _ hmass
  simpa only [not_le] using bernoulli_relative_tail_mass_le S hρ₀ hρ₁ hν₀ hν₁
end

section

noncomputable def balancedZeroSumSubsets {ι G : Type*} [AddCommGroup G]
    (S : Finset ι) (g : ι → G) (ρ ν : ℝ) : Finset (Finset ι) := by
  classical
  exact (S.powerset.filter fun t => (∑ i ∈ t, g i) = 0).filter
    fun t => |(t.card : ℝ) - ρ * S.card| ≤ ν * (ρ * S.card)

/- A quantitative count of zero-sum subsets concentrated near the desired
size. Both the Fourier error and the size-tail error have been proved. -/
theorem balanced_zero_sum_card_lower_bound {ι G : Type*}
    [AddCommGroup G] [Fintype G] (S : Finset ι) (g : ι → G)
    {ρ ν E : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ ≤ 1) (hν0 : 0 ≤ ν) (hν1 : ν ≤ 1)
    (henergy : ∀ χ : AddChar G ℂ, χ ≠ 0 →
      E ≤ ∑ i ∈ S, (1 - (χ (g i)).re))
    {k : ℕ} (hk : (k : ℝ) ≤ (1 - ν) * (ρ * S.card)) :
    (1 / (Fintype.card G : ℝ) - Real.exp (-ρ * (1 - ρ) * E) -
        2 * Real.exp (-ν ^ 2 * (ρ * S.card) / 4)) / ρ ^ k ≤
      ((balancedZeroSumSubsets S g ρ ν).card : ℝ) := by
  classical
  let A := S.powerset.filter fun t => (∑ i ∈ t, g i) = 0
  have hA : A ⊆ S.powerset := Finset.filter_subset _ _
  have hmass : 1 / (Fintype.card G : ℝ) - Real.exp (-ρ * (1 - ρ) * E) ≤
      ∑ t ∈ A, bernoulliSubsetWeight ρ S t := by
    simpa only [A, Finset.sum_filter] using
      bernoulli_identity_mass_lower_bound S g hρ0.le hρ1 henergy
  have hgood := bernoulli_good_size_mass_lower_bound S A hA hρ0.le hρ1 hν0 hν1 hmass
  apply card_ge_bernoulli_mass_div_pow hρ0 hρ1 S (balancedZeroSumSubsets S g ρ ν)
  · exact hgood
  · intro t ht
    have hsize := (Finset.mem_filter.mp ht).2
    change |(t.card : ℝ) - ρ * S.card| ≤ ν * (ρ * S.card) at hsize
    have hlow := (abs_le.mp hsize).1
    have hcast : (k : ℝ) ≤ t.card := by nlinarith
    exact_mod_cast hcast
end

section

/- A zero-sum of the additive form of residue units gives a Korselt product. -/
theorem isCarmichael_prod_of_unit_zero_sum {L : ℕ} {P s : Finset ℕ}
    (hsub : s ⊆ P) (hprime : ∀ p ∈ P, p.Prime) (hcard : 2 ≤ s.card)
    (hL : ∀ p ∈ P, p - 1 ∣ L) (g : ℕ → (ZMod L)ˣ)
    (hcompat : ∀ p ∈ P, (g p : ZMod L) = (p : ZMod L))
    (hsum : (∑ p ∈ s, Additive.ofMul (g p)) = 0) :
    IsCarmichael (∏ p ∈ s, p) := by
  have hunit : (∏ p ∈ s, g p) = 1 := by
    have h := congrArg Additive.toMul hsum
    simpa only [toMul_sum, toMul_ofMul, toMul_zero] using h
  have hcast : (∏ p ∈ s, (g p : ZMod L)) = 1 := by
    simpa only [map_prod, map_one, Units.coeHom_apply] using congrArg (Units.coeHom (ZMod L)) hunit
  have hnat : ((∏ p ∈ s, p : ℕ) : ZMod L) = 1 := by
    rw [Nat.cast_prod]
    calc
      (∏ p ∈ s, (p : ZMod L)) = ∏ p ∈ s, (g p : ZMod L) := by
        apply Finset.prod_congr rfl
        intro p hp
        exact (hcompat p (hsub hp)).symm
      _ = 1 := hcast
  apply isCarmichael_prod_of_modEq (fun p hp => hprime p (hsub hp)) hcard
    (fun p hp => hL p (hsub hp))
  exact (ZMod.natCast_eq_natCast_iff _ 1 L).mp (by simpa only [Nat.cast_one] using hnat)

/- A product of at most `u` factors bounded by `B ≥ 1` is at most `B^u`. -/
theorem nat_product_le_rpow {s : Finset ℕ} {B u : ℝ}
    (hB : 1 ≤ B) (hbound : ∀ p ∈ s, (p : ℝ) ≤ B) (hcard : (s.card : ℝ) ≤ u) :
    ((∏ p ∈ s, p : ℕ) : ℝ) ≤ B ^ u := by
  calc
    ((∏ p ∈ s, p : ℕ) : ℝ) = ∏ p ∈ s, (p : ℝ) := by rw [Nat.cast_prod]
    _ ≤ ∏ _p ∈ s, B := Finset.prod_le_prod₀ (fun p _ => Nat.cast_nonneg p) hbound
    _ = B ^ s.card := Finset.prod_const B
    _ = B ^ (s.card : ℝ) := (Real.rpow_natCast B s.card).symm
    _ ≤ B ^ u := Real.rpow_le_rpow_of_exponent_le hB hcard

/- Every balanced zero-sum subset yields a distinct Carmichael number below the size bound. -/
theorem balanced_unit_subsets_card_le_carmichaelCounting {L : ℕ} (P : Finset ℕ)
    (g : ℕ → (ZMod L)ˣ) (hprime : ∀ p ∈ P, p.Prime)
    (hL : ∀ p ∈ P, p - 1 ∣ L)
    (hcompat : ∀ p ∈ P, (g p : ZMod L) = (p : ZMod L))
    {B ρ ν : ℝ} (hB : 1 ≤ B) (hbound : ∀ p ∈ P, (p : ℝ) ≤ B)
    (hsize : 2 ≤ (1 - ν) * (ρ * P.card)) :
    ((balancedZeroSumSubsets P (fun p => Additive.ofMul (g p)) ρ ν).card : ℝ) ≤
      Erdos1057.carmichaelCounting (B ^ ((1 + ν) * (ρ * P.card))) := by
  classical
  have hmem (s : Finset ℕ)
      (hs : s ∈ balancedZeroSumSubsets P (fun p => Additive.ofMul (g p)) ρ ν) :
      (s ⊆ P ∧ (∑ p ∈ s, Additive.ofMul (g p)) = 0) ∧
        |(s.card : ℝ) - ρ * P.card| ≤ ν * (ρ * P.card) := by
    simpa only [balancedZeroSumSubsets, Finset.mem_filter, Finset.mem_powerset] using hs
  apply subset_family_card_le_carmichaelCounting hprime
  · intro s hs
    exact (hmem s hs).1.1
  · intro s hs
    obtain ⟨⟨hsub, hszero⟩, hsbalanced⟩ := hmem s hs
    have hlow := (abs_le.mp hsbalanced).1
    have hcard : (2 : ℝ) ≤ s.card := by nlinarith
    exact isCarmichael_prod_of_unit_zero_sum hsub hprime (by exact_mod_cast hcard)
      hL g hcompat hszero
  · intro s hs
    obtain ⟨⟨hsub, _⟩, hsbalanced⟩ := hmem s hs
    apply nat_product_le_rpow hB (fun p hp => hbound p (hsub hp))
    have hhigh := (abs_le.mp hsbalanced).2
    nlinarith




/- The zero-sum construction is valid in any group mapping to the residue units. -/
theorem isCarmichael_prod_of_mapped_unit_zero_sum {H : Type*} [CommGroup H]
    {L : ℕ} {P s : Finset ℕ} (hsub : s ⊆ P)
    (hprime : ∀ p ∈ P, p.Prime) (hcard : 2 ≤ s.card)
    (hL : ∀ p ∈ P, p - 1 ∣ L) (g : ℕ → H) (φ : H →* (ZMod L)ˣ)
    (hcompat : ∀ p ∈ P, (φ (g p) : ZMod L) = (p : ZMod L))
    (hsum : (∑ p ∈ s, Additive.ofMul (g p)) = 0) :
    IsCarmichael (∏ p ∈ s, p) := by
  have hunit : (∏ p ∈ s, g p) = 1 := by
    have h := congrArg Additive.toMul hsum
    simpa only [toMul_sum, toMul_ofMul, toMul_zero] using h
  have hmapped : (∏ p ∈ s, φ (g p)) = 1 := by
    rw [← map_prod, hunit, map_one]
  apply isCarmichael_prod_of_unit_zero_sum hsub hprime hcard hL (fun p => φ (g p)) hcompat
  rw [← ofMul_prod, hmapped, ofMul_one]

/- Balanced subsets in a subgroup still yield distinct Carmichael products. -/
theorem balanced_mapped_unit_subsets_card_le_carmichaelCounting {H : Type*} [CommGroup H]
    {L : ℕ} (P : Finset ℕ) (g : ℕ → H) (φ : H →* (ZMod L)ˣ)
    (hprime : ∀ p ∈ P, p.Prime) (hL : ∀ p ∈ P, p - 1 ∣ L)
    (hcompat : ∀ p ∈ P, (φ (g p) : ZMod L) = (p : ZMod L))
    {B ρ ν : ℝ} (hB : 1 ≤ B) (hbound : ∀ p ∈ P, (p : ℝ) ≤ B)
    (hsize : 2 ≤ (1 - ν) * (ρ * P.card)) :
    ((balancedZeroSumSubsets P (fun p => Additive.ofMul (g p)) ρ ν).card : ℝ) ≤
      Erdos1057.carmichaelCounting (B ^ ((1 + ν) * (ρ * P.card))) := by
  classical
  have hmem (s : Finset ℕ)
      (hs : s ∈ balancedZeroSumSubsets P (fun p => Additive.ofMul (g p)) ρ ν) :
      (s ⊆ P ∧ (∑ p ∈ s, Additive.ofMul (g p)) = 0) ∧
        |(s.card : ℝ) - ρ * P.card| ≤ ν * (ρ * P.card) := by
    simpa only [balancedZeroSumSubsets, Finset.mem_filter, Finset.mem_powerset] using hs
  apply subset_family_card_le_carmichaelCounting hprime
  · intro s hs
    exact (hmem s hs).1.1
  · intro s hs
    obtain ⟨⟨hsub, hszero⟩, hsbalanced⟩ := hmem s hs
    have hlow := (abs_le.mp hsbalanced).1
    have hcard : (2 : ℝ) ≤ s.card := by nlinarith
    exact isCarmichael_prod_of_mapped_unit_zero_sum hsub hprime (by exact_mod_cast hcard)
      hL g φ hcompat hszero
  · intro s hs
    obtain ⟨⟨hsub, _⟩, hsbalanced⟩ := hmem s hs
    apply nat_product_le_rpow hB (fun p hp => hbound p (hsub hp))
    have hhigh := (abs_le.mp hsbalanced).2
    nlinarith

/- The counting estimate only needs spectral mixing inside the retained group.
The homomorphism into residue units need not be injective. -/
theorem carmichaelCounting_lower_bound_of_mapped_unit_energy {H : Type*}
    [CommGroup H] [Fintype H] {L : ℕ}
    (P : Finset ℕ) (g : ℕ → H) (φ : H →* (ZMod L)ˣ)
    (hprime : ∀ p ∈ P, p.Prime) (hL : ∀ p ∈ P, p - 1 ∣ L)
    (hcompat : ∀ p ∈ P, (φ (g p) : ZMod L) = (p : ZMod L))
    {B ρ ν E : ℝ} (hB : 1 ≤ B) (hbound : ∀ p ∈ P, (p : ℝ) ≤ B)
    (hρ0 : 0 < ρ) (hρ1 : ρ ≤ 1) (hν0 : 0 ≤ ν) (hν1 : ν ≤ 1)
    (hsize : 2 ≤ (1 - ν) * (ρ * P.card))
    (henergy : ∀ χ : AddChar (Additive H) ℂ, χ ≠ 0 →
      E ≤ ∑ p ∈ P, (1 - (χ (Additive.ofMul (g p))).re))
    {k : ℕ} (hk : (k : ℝ) ≤ (1 - ν) * (ρ * P.card)) :
    (1 / (Fintype.card (Additive H) : ℝ) - Real.exp (-ρ * (1 - ρ) * E) -
        2 * Real.exp (-ν ^ 2 * (ρ * P.card) / 4)) / ρ ^ k ≤
      Erdos1057.carmichaelCounting (B ^ ((1 + ν) * (ρ * P.card))) := by
  exact (balanced_zero_sum_card_lower_bound P (fun p => Additive.ofMul (g p))
    hρ0 hρ1 hν0 hν1 henergy hk).trans
    (balanced_mapped_unit_subsets_card_le_carmichaelCounting P g φ hprime hL hcompat hB hbound hsize)
end

section

/- An additive character on the additive type tag is a multiplicative character. -/
def addCharOfMulToMonoidHom {H : Type*} [Monoid H] (χ : AddChar (Additive H) ℂ) :
    H →* ℂ where
  toFun x := χ (Additive.ofMul x)
  map_one' := by simpa only [ofMul_one] using χ.map_zero_eq_one
  map_mul' x y := by
    simpa only [ofMul_mul] using χ.map_add_eq_mul (Additive.ofMul x) (Additive.ofMul y)

theorem addCharOfMulToMonoidHom_ne_one {H : Type*} [Monoid H]
    {χ : AddChar (Additive H) ℂ} (hχ : χ ≠ 0) : addCharOfMulToMonoidHom χ ≠ 1 := by
  intro heq
  apply hχ
  ext x
  change χ x = 1
  have h := DFunLike.congr_fun heq x.toMul
  simpa only [addCharOfMulToMonoidHom, MonoidHom.coe_mk, OneHom.coe_mk,
    ofMul_toMul, MonoidHom.one_apply] using h

/- End-to-end finite transfer: a large reservoir with small predecessor modulus and
ambient character cancellation contains a half-reservoir generating many Carmichael numbers. -/
theorem finite_carmichael_transfer {L : ℕ} [NeZero L]
    (S P : Finset ℕ) (hPS : P ⊆ S) (g : ℕ → (ZMod L)ˣ)
    (hprime : ∀ p ∈ P, p.Prime) (hL : ∀ p ∈ P, p - 1 ∣ L)
    (hcompat : ∀ p ∈ P, (g p : ZMod L) = (p : ZMod L))
    {B M A : ℝ} (hB : 1 ≤ B) (hbound : ∀ p ∈ P, (p : ℝ) ≤ B)
    (hM : 0 ≤ M)
    (hbudget : M * Nat.log 2 (Nat.card ((ZMod L)ˣ)) ≤ (P.card : ℝ) / 2)
    {R : ℕ} (hR : 0 < R)
    (hRlarge : 64 * (S.card : ℝ) ≤ (P.card : ℝ) * R)
    (hsmall : (R - 1 : ℝ) * A ≤ S.card)
    (hamb : ∀ ξ : (ZMod L)ˣ →* ℂ, ξ ≠ 1 → ‖∑ p ∈ S, ξ (g p)‖ ≤ A) :
    ∃ (H : Subgroup ((ZMod L)ˣ)) (T : Finset ℕ) (h : ℕ → H),
      T = subgroupReservoir P g H ∧ T ⊆ P ∧
      (P.card : ℝ) / 2 ≤ (T.card : ℝ) ∧
      (∀ p ∈ T, (h p : (ZMod L)ˣ) = g p) ∧
      ∀ (ρ ν : ℝ) (k : ℕ),
        0 < ρ → ρ ≤ 1 → 0 ≤ ν → ν ≤ 1 →
        2 ≤ (1 - ν) * (ρ * T.card) →
        (k : ℝ) ≤ (1 - ν) * (ρ * T.card) →
        (1 / (Nat.card H : ℝ) -
            Real.exp (-ρ * (1 - ρ) *
              min (2 * M / (R : ℝ) ^ 2)
                (3 * (P.card : ℝ) / (4 * Real.pi ^ 2 * (R : ℝ) ^ 2))) -
            2 * Real.exp (-ν ^ 2 * (ρ * T.card) / 4)) / ρ ^ k ≤
          Erdos1057.carmichaelCounting (B ^ ((1 + ν) * (ρ * T.card))) := by
  classical
  obtain ⟨H, T, h, hTeq, hTP, hhalf, hagree, henergy⟩ :=
    exists_pruned_energy_reservoir S P hPS g hM hbudget hR hRlarge hsmall hamb
  refine ⟨H, T, h, hTeq, hTP, hhalf, hagree, ?_⟩
  intro ρ ν k hρ0 hρ1 hν0 hν1 hsize hk
  let : Fintype H := Fintype.ofFinite H
  have henergy' : ∀ χ : AddChar (Additive H) ℂ, χ ≠ 0 →
      min (2 * M / (R : ℝ) ^ 2)
        (3 * (P.card : ℝ) / (4 * Real.pi ^ 2 * (R : ℝ) ^ 2)) ≤
        ∑ p ∈ T, (1 - (χ (Additive.ofMul (h p))).re) := by
    intro χ hχ
    exact henergy (addCharOfMulToMonoidHom χ) (addCharOfMulToMonoidHom_ne_one hχ)
  have hcompat' : ∀ p ∈ T, (H.subtype (h p) : ZMod L) = (p : ZMod L) := by
    intro p hp
    change ((h p : (ZMod L)ˣ) : ZMod L) = (p : ZMod L)
    rw [hagree p hp]
    exact hcompat p (hTP hp)
  have hcount := carmichaelCounting_lower_bound_of_mapped_unit_energy T h H.subtype
    (fun p hp => hprime p (hTP hp)) (fun p hp => hL p (hTP hp)) hcompat'
    hB (fun p hp => hbound p (hTP hp)) hρ0 hρ1 hν0 hν1 hsize henergy' hk
  have hcard : Fintype.card (Additive H) = Nat.card H := by
    rw [Nat.card_eq_fintype_card]
    exact Fintype.card_congr Additive.ofMul.symm
  simpa only [hcard] using hcount
end

