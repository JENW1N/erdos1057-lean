open Finset
/- Translate pending residues by `r ↦ r - t`; leave both vacuum states fixed. -/
def ghostMemoryShift {R : Type*} [AddGroup R] (t : R) :
    GhostFiniteState R ≃ GhostFiniteState R where
  toFun
    | none => none
    | some none => some none
    | some (some r) => some (some (r - t))
  invFun
    | none => none
    | some none => some none
    | some (some r) => some (some (r + t))
  left_inv := by intro x; rcases x with _ | (_ | r) <;> simp
  right_inv := by intro x; rcases x with _ | (_ | r) <;> simp













/- Composition works in an arbitrary additive group, with the displayed order. -/
theorem ghostMemoryShift_add {R : Type*} [AddGroup R] (t u : R)
    (x : GhostFiniteState R) :
    ghostMemoryShift (t + u) x = ghostMemoryShift t (ghostMemoryShift u x) := by
  rcases x with _ | (_ | r) <;> simp [ghostMemoryShift, sub_add_eq_sub_sub_swap]

theorem ghostMemoryShift_symm {R : Type*} [AddGroup R] (t : R)
    (x : GhostFiniteState R) :
    (ghostMemoryShift t).symm x = ghostMemoryShift (-t) x := by
  rcases x with _ | (_ | r) <;> simp [ghostMemoryShift]















end

section
open Finset
/- Every tuple for finite pairwise-coprime nonzero moduli has an integer lift. -/
theorem independent_residues_integer_lift {ι : Type*} [Fintype ι] [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (r : ∀ i, ZMod (m i)) :
    ∃ n : ℤ, ∀ i, (n : ZMod (m i)) = r i := by
  obtain ⟨k, hk⟩ := (lifespan_crt_bijective m hc).surjective r
  refine ⟨(k.val : ℤ), ?_⟩
  intro i
  simpa only [Int.cast_natCast] using congrFun hk i










/- Disjoint physical prime groups admit simultaneous integer lifts. Nonzero
modulus instances are derived from the explicit primality hypotheses. -/
theorem physical_residues_integer_lift {G : Type*} [Fintype G]
    {P : G → Finset ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (r : ∀ p : PhysicalPrime P, ZMod p.2.val) :
    ∃ n : ℤ, ∀ p : PhysicalPrime P, (n : ZMod p.2.val) = r p := by
  classical
  let : ∀ p : PhysicalPrime P, NeZero p.2.val :=
    fun p => ⟨(hprime p.1 p.2.val p.2.property).ne_zero⟩
  exact independent_residues_integer_lift (fun p : PhysicalPrime P => p.2.val)
    (physical_prime_pool_coprime hP hprime) r



end

section
open Finset
abbrev PhysicalResidues {G : Type*} (P : G → Finset ℕ) :=
  ∀ p : PhysicalPrime P, ZMod p.2.val

def physicalResiduesOfInt {G : Type*} (P : G → Finset ℕ) (n : ℤ) : PhysicalResidues P :=
  fun _ => n

def physicalTranslateResidues {G : Type*} {P : G → Finset ℕ}
    (r : PhysicalResidues P) (d : ℤ) : PhysicalResidues P := fun p => r p + d

theorem physical_translate_residues_int {G : Type*} (P : G → Finset ℕ) (n d : ℤ) :
    physicalTranslateResidues (physicalResiduesOfInt P n) d = physicalResiduesOfInt P (n + d) := by
  funext p
  exact (Int.cast_add n d).symm

theorem physical_translate_residues_zero {G : Type*} {P : G → Finset ℕ}
    (r : PhysicalResidues P) : physicalTranslateResidues r 0 = r := by
  funext p
  simp [physicalTranslateResidues]

theorem physical_translate_residues_add {G : Type*} {P : G → Finset ℕ}
    (r : PhysicalResidues P) (a b : ℤ) :
    physicalTranslateResidues (physicalTranslateResidues r a) b = physicalTranslateResidues r (a + b) := by
  funext p
  simp [physicalTranslateResidues, add_assoc]

def physicalResidueMarksValid {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (r : PhysicalResidues P) (L : PhysicalMarkLists P J ell) : Prop :=
  ∀ g s, r ⟨g, L g s⟩ = 0

abbrev PhysicalResidueMarksAt {G : Type*} (P : G → Finset ℕ) (J ell : ℕ)
    (r : PhysicalResidues P) := {L : PhysicalMarkLists P J ell // physicalResidueMarksValid r L}




theorem physical_residue_marks_int_iff {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (n : ℤ) (L : PhysicalMarkLists P J ell) :
    physicalResidueMarksValid (physicalResiduesOfInt P n) L ↔
      ∀ g s, ((L g s).val : ℤ) ∣ n := by
  simp only [physicalResidueMarksValid, physicalResiduesOfInt, ZMod.intCast_zmod_eq_zero_iff_dvd]




noncomputable def physicalResidueDivisorPool {G : Type*} (P : G → Finset ℕ)
    (g : G) (r : PhysicalResidues P) : Finset ℕ := by
  classical
  exact (P g).attach.filter (fun p => r ⟨g, p⟩ = 0) |>.image Subtype.val

theorem physical_residue_divisor_pool_int {G : Type*} (P : G → Finset ℕ)
    (g : G) (n : ℤ) :
    physicalResidueDivisorPool P g (physicalResiduesOfInt P n) = physicalDivisorPool P g n := by
  classical
  ext p
  simp only [physicalResidueDivisorPool, mem_image, mem_filter, mem_attach,
    true_and, physicalResiduesOfInt, ZMod.intCast_zmod_eq_zero_iff_dvd, physicalDivisorPool]
  constructor
  · rintro ⟨a, ha, rfl⟩
    exact ⟨a.property, ha⟩
  · rintro ⟨hp, hd⟩
    exact ⟨⟨p, hp⟩, hd, rfl⟩

noncomputable def physicalResidueOmega {G : Type*} (P : G → Finset ℕ)
    (g : G) (r : PhysicalResidues P) : ℕ := (physicalResidueDivisorPool P g r).card







noncomputable def physicalResidueVertexWeight {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (L : PhysicalMarkLists P J ell)
    (q : ℝ) (r : PhysicalResidues P) : ℝ := by
  classical
  exact if physicalResidueMarksValid r L then
    ∏ g, q^(physicalResidueOmega P g r - (J + ell)) else 0

theorem physical_residue_vertex_weight_int {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (L : PhysicalMarkLists P J ell)
    (q : ℝ) (n : ℤ) :
    physicalResidueVertexWeight L q (physicalResiduesOfInt P n) = physicalVertexWeight L q n := by
  simp only [physicalResidueVertexWeight, physical_residue_marks_int_iff, physicalResidueOmega,
    physical_residue_divisor_pool_int, physicalVertexWeight, physicalOmega]
end

section
open Finset Classical
noncomputable def physicalBareStepCoeff {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (n : ℤ) (L R : PhysicalMarkLists P J ell) : ℂ :=
  physicalBareLabeledScalar V patterns C ζ K a L R *
    ((physicalVertexWeight L (Real.sqrt q) n *
      physicalVertexWeight R (Real.sqrt q) (n + physicalBareStep C k a L) : ℝ) : ℂ)

theorem physical_labeled_norm_row_as_marks {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (x : PhysicalState P J ell)
    (positions : Finset ℤ) (hm : x.1 + physicalBareStep C k a x.2.val ∈ positions) :
    (∑ y ∈ physicalCutoff P J ell positions, ‖physicalLabeledCoeff V patterns C q ζ k K a x y‖) =
      ∑ R : PhysicalMarkLists P J ell, ‖physicalBareStepCoeff V patterns C q ζ k K a x.1 x.2.val R‖ := by
  let m := x.1 + physicalBareStep C k a x.2.val
  let F : PhysicalMarkLists P J ell → ℝ := fun R =>
    ‖physicalBareStepCoeff V patterns C q ζ k K a x.1 x.2.val R‖
  have he : ∀ y : PhysicalState P J ell,
      ‖physicalLabeledCoeff V patterns C q ζ k K a x y‖ =
        if y.1 = m then F y.2.val else 0 := by
    intro y
    rw [physical_labeled_vertex_factor V patterns C hq]
    change ‖(if y.1 = m then _ else _)‖ = _
    by_cases h : y.1 = m
    · simp only [h]
      rfl
    · simp only [if_neg h, norm_zero]
  simp only [he]
  rw [physical_cutoff_sum_at, if_pos hm]
  apply physical_marks_sum_all P J ell m F
  intro L h
  dsimp only [m] at h
  simp only [F, physicalBareStepCoeff, physicalVertexWeight, if_neg h,
    mul_zero, Complex.ofReal_zero, norm_zero]

noncomputable def physicalResidueStepCoeff {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (r : PhysicalResidues P)
    (L R : PhysicalMarkLists P J ell) : ℂ :=
  physicalBareLabeledScalar V patterns C ζ K a L R *
    ((physicalResidueVertexWeight L (Real.sqrt q) r *
      physicalResidueVertexWeight R (Real.sqrt q)
        (physicalTranslateResidues r (physicalBareStep C k a L)) : ℝ) : ℂ)

section

variable
  {G I : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (V : G → ℝ)
  (patterns : Finset I)
  (C : I → G → Finset (Fin J))
  (q : ℝ)
  (ζ : I → ℝ)
  (k : I → ℤ)
  (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
  (a : PhysicalEdgeLabels P J ell patterns C)
  (n : ℤ)
  (L R : PhysicalMarkLists P J ell)

include G I sharedInstance1 sharedInstance2 P J ell V patterns C q ζ k K a n L R

theorem physical_residue_step_coeff_int  :
    physicalResidueStepCoeff V patterns C q ζ k K a (physicalResiduesOfInt P n) L R =
      physicalBareStepCoeff V patterns C q ζ k K a n L R := by
  simp only [physicalResidueStepCoeff, physical_translate_residues_int,
    physical_residue_vertex_weight_int, physicalBareStepCoeff]

theorem physical_bare_step_coeff_zero 
    (h : ¬ ∀ g s, ((L g s).val : ℤ) ∣ n) :
    physicalBareStepCoeff V patterns C q ζ k K a n L R = 0 := by
  simp only [physicalBareStepCoeff, physicalVertexWeight, if_neg h,
    zero_mul, Complex.ofReal_zero, mul_zero]

end


/- Every bare row has the existing physical bound. The finite cutoff
contains all one-step targets, so this reindexing loses no mass. -/
theorem exists_physical_bare_step_row_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell m : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] [DecidableEq G] (P : G → Finset ℕ)
      (J : ℕ) (V : G → ℝ), (∀ g, v ≤ V g) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      ∀ (I : Type) (patterns : Finset I) (C : I → G → Finset (Fin J)) (B : I → ℝ),
      (∀ i ∈ patterns, ∀ g, (C i g).card ≤ m) → (∀ i ∈ patterns, 0 ≤ B i) →
      ∀ (ζ : I → ℝ) (k : I → ℤ)
        (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ),
        (∀ i ∈ patterns, ∀ L R aux, ‖K i L R aux‖ ≤ B i) →
        letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
        ∀ (n : ℤ) (L : PhysicalMarkLists P J ell),
        (∑ a : PhysicalEdgeLabels P J ell patterns C, ∑ R : PhysicalMarkLists P J ell,
          ‖physicalBareStepCoeff V patterns C q ζ k K a n L R‖) ≤
          (∑ i ∈ patterns, B i) * A^(Fintype.card G) := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_absolute_operator_bounds hq0 hq1 hv ell m
  refine ⟨A, hA, ?_⟩
  intro G _ _ P J V hV hMass I patterns C B hC hB ζ k K hK
  classical
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro n L
  by_cases hL : ∀ g s, ((L g s).val : ℤ) ∣ n
  · let x : PhysicalState P J ell := ⟨n, L, hL⟩
    let positions := univ.image (fun a : PhysicalEdgeLabels P J ell patterns C =>
      n + physicalBareStep C k a L)
    have hm : ∀ a : PhysicalEdgeLabels P J ell patterns C,
        x.1 + physicalBareStep C k a x.2.val ∈ positions := by
      intro a
      exact mem_image.mpr ⟨a, mem_univ a, rfl⟩
    have he : (∑ a : PhysicalEdgeLabels P J ell patterns C, ∑ R : PhysicalMarkLists P J ell,
        ‖physicalBareStepCoeff V patterns C q ζ k K a n L R‖) =
        ∑ y ∈ physicalCutoff P J ell positions, physicalAbsoluteOperator V patterns C q ζ k K x y := by
      calc
        _ = ∑ a : PhysicalEdgeLabels P J ell patterns C,
            ∑ y ∈ physicalCutoff P J ell positions,
              ‖physicalLabeledCoeff V patterns C q ζ k K a x y‖ := by
          apply sum_congr rfl
          intro a _
          exact (physical_labeled_norm_row_as_marks V patterns C hq0 ζ k K a x positions (hm a)).symm
        _ = _ := by rw [sum_comm]; simp only [physical_labeled_coefficient_abs_sum]
    rw [he]
    exact (hbound G P J V hV hMass I patterns C ζ k K B hC hB hK x
      (physicalCutoff P J ell positions)).1
  · simp only [physical_bare_step_coeff_zero V patterns C q ζ k K _ n L _ hL,
      norm_zero, sum_const_zero]
    exact mul_nonneg (sum_nonneg hB) (pow_nonneg (zero_le_one.trans hA) _)
end

section
open Finset
abbrev PhysicalBareResidueState {G : Type*} (P : G → Finset ℕ) (J ell : ℕ) :=
  PhysicalResidues P × PhysicalMarkLists P J ell

noncomputable def physicalResidueInitialMass {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (x : PhysicalBareResidueState P J ell) : ℝ := by
  classical
  exact physicalStateMass V J ell * ∏ p : PhysicalPrime P,
    (if p ∈ physicalMarkedPrimes x.2 then (if x.1 p = 0 then (1 : ℝ) else 0) else 1) / (p.2.val : ℝ)

theorem physical_residue_initial_mass_nonneg {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (x : PhysicalBareResidueState P J ell) : 0 ≤ physicalResidueInitialMass V x := by
  classical
  unfold physicalResidueInitialMass
  apply mul_nonneg (physical_state_mass_pos V hV J ell).le
  apply prod_nonneg
  intro p _
  apply div_nonneg
  · split_ifs <;> positivity
  · exact Nat.cast_nonneg _

theorem physical_residue_initial_mass_total {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) :
    (∑ x : PhysicalBareResidueState P J ell, physicalResidueInitialMass V x) ≤ 1 := by
  classical
  rw [Fintype.sum_prod_type, sum_comm]
  simp only [physicalResidueInitialMass, ← mul_sum]
  simpa only [← mul_sum] using (physical_initial_residue_total_mass (J := J) (ell := ell) V hV hMass)

theorem physical_residue_initial_mass_zero {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ)
    (x : PhysicalBareResidueState P J ell) (h : ¬ physicalResidueMarksValid x.1 x.2) :
    physicalResidueInitialMass V x = 0 := by
  classical
  unfold physicalResidueMarksValid at h
  push Not at h
  obtain ⟨g, s, hs⟩ := h
  have hm : (⟨g, x.2 g s⟩ : PhysicalPrime P) ∈ physicalMarkedPrimes x.2 := by
    rw [mem_physical_marked_primes, mem_physical_group_marks]
    exact ⟨s, rfl⟩
  unfold physicalResidueInitialMass
  have hz : (∏ p : PhysicalPrime P,
      (if p ∈ physicalMarkedPrimes x.2 then (if x.1 p = 0 then (1 : ℝ) else 0) else 1) / (p.2.val : ℝ)) = 0 := by
    apply prod_eq_zero (mem_univ (⟨g, x.2 g s⟩ : PhysicalPrime P))
    simp only [if_pos hm, if_neg hs, zero_div]
  rw [hz, mul_zero]
end

section
open Finset
noncomputable def deterministicTargetKernel {R M A : Type*}
    (step : A → R → M → R) (weight : A → R → M → M → ℂ)
    (a : A) (x y : R × M) : ℂ := by
  classical
  exact if y.1 = step a x.1 x.2 then weight a x.1 x.2 y.2 else 0

theorem deterministic_target_norm_row {R M A : Type*}
    [Fintype R] [Fintype M] [Fintype A]
    (step : A → R → M → R) (weight : A → R → M → M → ℂ)
    (x : R × M) :
    (∑ y : R × M, ∑ a : A, ‖deterministicTargetKernel step weight a x y‖) =
      ∑ a : A, ∑ m : M, ‖weight a x.1 x.2 m‖ := by
  classical
  rw [sum_comm]
  apply sum_congr rfl
  intro a _
  rw [Fintype.sum_prod_type]
  simp [deterministicTargetKernel, apply_ite]



end

section
open Finset Classical
theorem physical_residues_of_int_surjective {G : Type*} [Fintype G]
    {P : G → Finset ℕ} (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime) : Function.Surjective (physicalResiduesOfInt P) := by
  intro r
  obtain ⟨n, hn⟩ := physical_residues_integer_lift hP hprime r
  exact ⟨n, funext hn⟩

noncomputable def physicalResidueLabeledCoeff {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (x y : PhysicalBareResidueState P J ell) : ℂ :=
  deterministicTargetKernel (fun a r L => physicalTranslateResidues r (physicalBareStep C k a L))
    (physicalResidueStepCoeff V patterns C q ζ k K) a x y

section

variable
  {G I : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P : G → Finset ℕ}
  [sharedInstance4 : ∀ p : PhysicalPrime P, NeZero p.2.val]
  {J ell : ℕ}
  (V : G → ℝ)
  (patterns : Finset I)
  (C : I → G → Finset (Fin J))
  (q : ℝ)
  (ζ : I → ℝ)
  (k : I → ℤ)
  (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)

include G I sharedInstance1 sharedInstance2 P sharedInstance4 J ell V patterns C q ζ k K

theorem physical_residue_labeled_norm_row  :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    ∀ x : PhysicalBareResidueState P J ell,
    (∑ y : PhysicalBareResidueState P J ell, ∑ a : PhysicalEdgeLabels P J ell patterns C,
      ‖physicalResidueLabeledCoeff V patterns C q ζ k K a x y‖) =
      ∑ a : PhysicalEdgeLabels P J ell patterns C, ∑ R : PhysicalMarkLists P J ell,
        ‖physicalResidueStepCoeff V patterns C q ζ k K a x.1 x.2 R‖ := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro x
  exact deterministic_target_norm_row _ _ x

theorem physical_residue_row_bound_of_lift 
    (hlift : ∀ r : PhysicalResidues P, ∃ n : ℤ, physicalResiduesOfInt P n = r) (H : ℝ) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    (∀ (n : ℤ) (L : PhysicalMarkLists P J ell),
      (∑ a : PhysicalEdgeLabels P J ell patterns C, ∑ R : PhysicalMarkLists P J ell,
        ‖physicalBareStepCoeff V patterns C q ζ k K a n L R‖) ≤ H) →
    ∀ x : PhysicalBareResidueState P J ell,
      (∑ y : PhysicalBareResidueState P J ell, ∑ a : PhysicalEdgeLabels P J ell patterns C,
        ‖physicalResidueLabeledCoeff V patterns C q ζ k K a x y‖) ≤ H := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro hrow x
  rw [physical_residue_labeled_norm_row]
  obtain ⟨n, hn⟩ := hlift x.1
  rw [← hn]
  simp only [physical_residue_step_coeff_int]
  exact hrow n x.2

end


/- The full independent-residue operator has the same absolute row
bound as the physical operator. Norms are taken before summing labels. -/
theorem exists_physical_residue_operator_row_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell m : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] [DecidableEq G] (P : G → Finset ℕ)
      [∀ p : PhysicalPrime P, NeZero p.2.val],
      Pairwise (fun g h => Disjoint (P g) (P h)) →
      (∀ g p, p ∈ P g → p.Prime) →
      ∀ (J : ℕ) (V : G → ℝ), (∀ g, v ≤ V g) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      ∀ (I : Type) (patterns : Finset I) (C : I → G → Finset (Fin J)) (B : I → ℝ),
      (∀ i ∈ patterns, ∀ g, (C i g).card ≤ m) → (∀ i ∈ patterns, 0 ≤ B i) →
      ∀ (ζ : I → ℝ) (k : I → ℤ)
        (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ),
        (∀ i ∈ patterns, ∀ L R aux, ‖K i L R aux‖ ≤ B i) →
        letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
        ∀ x : PhysicalBareResidueState P J ell,
        (∑ y : PhysicalBareResidueState P J ell, ∑ a : PhysicalEdgeLabels P J ell patterns C,
          ‖physicalResidueLabeledCoeff V patterns C q ζ k K a x y‖) ≤
          (∑ i ∈ patterns, B i) * A^(Fintype.card G) := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_bare_step_row_bound hq0 hq1 hv ell m
  refine ⟨A, hA, ?_⟩
  intro G _ _ P _ hP hprime J V hV hMass I patterns C B hC hB ζ k K hK
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  exact physical_residue_row_bound_of_lift V patterns C q ζ k K
    (physical_residues_of_int_surjective hP hprime) _
    (hbound G P J V hV hMass I patterns C B hC hB ζ k K hK)

/- The normalized independent-residue law converts a uniform absolute
row bound into a bound for all labeled paths, with no cancellation assumed. -/
theorem physical_residue_averaged_path_bound {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (patterns : Finset I) (C : I → G → Finset (Fin J))
    (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (H : ℝ) (hH : 0 ≤ H) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    (∀ j (x : PhysicalBareResidueState P J ell),
      (∑ y : PhysicalBareResidueState P J ell, ∑ a : PhysicalEdgeLabels P J ell patterns C,
        ‖physicalResidueLabeledCoeff V patterns C q (ζ j) (k j) (K j) a x y‖) ≤ H) →
    ∀ terminal : PhysicalBareResidueState P J ell → PhysicalBareResidueState P J ell → ℂ,
    (∀ x y, ‖terminal x y‖ ≤ 1) → ∀ n : ℕ,
    (∑ x : PhysicalBareResidueState P J ell, physicalResidueInitialMass V x *
      ∑ p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalBareResidueState P J ell,
        ‖labeledPathTerm (fun j a u v => physicalResidueLabeledCoeff V patterns C q (ζ j) (k j) (K j) a u v)
          (terminal x) n x p‖) ≤ H^n := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro hrow terminal ht n
  exact averaged_absolute_labeled_path_bound _ terminal (physicalResidueInitialMass V) hH hrow ht
    (physical_residue_initial_mass_nonneg V hV) (physical_residue_initial_mass_total V hV hMass) n
end

section
open Finset
theorem physical_residue_vertex_path_factorization {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (labels : ℕ → PhysicalMarkLists P J ell) (visits : Finset ℕ)
    (offset : ℕ → ℤ) (q : ℕ → ℝ) (r : PhysicalResidues P) :
    (∏ j ∈ visits, physicalResidueVertexWeight (labels j) (q j)
      (physicalTranslateResidues r (offset j))) =
      ∏ p : PhysicalPrime P, activeResidueWeight visits
        (visits.filter (fun j => p ∈ physicalMarkedPrimes (labels j)))
        (fun j => -(offset j : ZMod p.2.val)) (fun j => 1 - q j) (r p) := by
  obtain ⟨n, rfl⟩ := physical_residues_of_int_surjective hP hprime r
  simpa only [physical_translate_residues_int, physical_residue_vertex_weight_int,
    physicalResiduesOfInt] using physical_vertex_path_factorization labels visits offset q n

/- The whole finite residue-vector expectation equals the product of
local expectations used by the existing uniform replacement theorem. -/
theorem physical_residue_vertex_expectation {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (labels : ℕ → PhysicalMarkLists P J ell) (visits : Finset ℕ)
    (offset : ℕ → ℤ) (q : ℕ → ℝ) :
    (∑ r : PhysicalResidues P, (∏ p : PhysicalPrime P, 1 / (p.2.val : ℝ)) *
      ∏ j ∈ visits, physicalResidueVertexWeight (labels j) (q j)
        (physicalTranslateResidues r (offset j))) =
      poolPathResidueExpectation (fun p : PhysicalPrime P => p.2.val) univ visits
        (fun p => visits.filter (fun j => p ∈ physicalMarkedPrimes (labels j)))
        (fun p j => -(offset j : ZMod p.2.val)) (fun j => 1 - q j) := by
  classical
  simp only [physical_residue_vertex_path_factorization hP hprime]
  let f := fun (p : PhysicalPrime P) (a : ZMod p.2.val) =>
    activeResidueWeight visits (visits.filter (fun j => p ∈ physicalMarkedPrimes (labels j)))
      (fun j => -(offset j : ZMod p.2.val)) (fun j => 1 - q j) a
  change (∑ r : PhysicalResidues P, (∏ p : PhysicalPrime P, 1 / (p.2.val : ℝ)) *
    ∏ p : PhysicalPrime P, f p (r p)) = ∏ p : PhysicalPrime P, (∑ a, f p a) / (p.2.val : ℝ)
  have he : ∀ r : PhysicalResidues P,
      (∏ p : PhysicalPrime P, 1 / (p.2.val : ℝ)) * (∏ p : PhysicalPrime P, f p (r p)) =
        ∏ p : PhysicalPrime P, f p (r p) / (p.2.val : ℝ) := by
    intro r
    rw [← prod_mul_distrib]
    apply prod_congr rfl
    intro p _
    ring
  simp only [he]
  simpa only [← sum_div] using
    (Fintype.prod_sum (fun (p : PhysicalPrime P) (a : ZMod p.2.val) =>
      f p a / (p.2.val : ℝ))).symm
end

section
open Finset
theorem physical_residue_marks_valid_iff_marked {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (r : PhysicalResidues P) (L : PhysicalMarkLists P J ell) :
    physicalResidueMarksValid r L ↔ ∀ p ∈ physicalMarkedPrimes L, r p = 0 := by
  constructor
  · intro h p hp
    rcases p with ⟨g, p⟩
    obtain ⟨s, hs⟩ := (mem_physical_group_marks L g p.val).mp
      ((mem_physical_marked_primes L ⟨g, p⟩).mp hp)
    have he : L g s = p := Subtype.ext hs
    rw [← he]
    exact h g s
  · intro h g s
    apply h ⟨g, L g s⟩
    rw [mem_physical_marked_primes, mem_physical_group_marks]
    exact ⟨s, rfl⟩

theorem physical_residue_initial_mass_of_valid {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ)
    (r : PhysicalResidues P) (L : PhysicalMarkLists P J ell)
    (h : physicalResidueMarksValid r L) :
    physicalResidueInitialMass V (r, L) =
      physicalStateMass V J ell * ∏ p : PhysicalPrime P, 1 / (p.2.val : ℝ) := by
  classical
  unfold physicalResidueInitialMass
  congr 1
  apply prod_congr rfl
  intro p _
  by_cases hp : p ∈ physicalMarkedPrimes L
  · have hr := (physical_residue_marks_valid_iff_marked r L).mp h p hp
    simp only [hp, hr, if_true]
  · simp only [hp, if_false]

/- A function supported on valid marked states can be averaged against the
uniform residue law, with the constant state mass outside both finite sums. -/
theorem physical_residue_initial_mass_sum_of_supported
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : G → ℝ) (F : PhysicalResidues P → PhysicalMarkLists P J ell → ℝ)
    (hF : ∀ r L, ¬ physicalResidueMarksValid r L → F r L = 0) :
    (∑ x : PhysicalBareResidueState P J ell, physicalResidueInitialMass V x * F x.1 x.2) =
      physicalStateMass V J ell * ∑ L : PhysicalMarkLists P J ell,
        ∑ r : PhysicalResidues P, (∏ p : PhysicalPrime P, 1 / (p.2.val : ℝ)) * F r L := by
  classical
  have hpoint (r : PhysicalResidues P) (L : PhysicalMarkLists P J ell) :
      physicalResidueInitialMass V (r, L) * F r L =
        physicalStateMass V J ell * ((∏ p : PhysicalPrime P, 1 / (p.2.val : ℝ)) * F r L) := by
    by_cases h : physicalResidueMarksValid r L
    · rw [physical_residue_initial_mass_of_valid V r L h, mul_assoc]
    · rw [hF r L h, mul_zero, mul_zero, mul_zero]
  rw [Fintype.sum_prod_type, sum_comm]
  simp only [hpoint, ← mul_sum]

