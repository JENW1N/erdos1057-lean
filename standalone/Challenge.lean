  have hunit (u:ActualEisensteinCubic.Oˣ):IsCoprime (u.val*a) (u.val*c) := by
    obtain ⟨r,s,hrs⟩:=hcop
    refine ⟨r*(↑u⁻¹:ActualEisensteinCubic.O),s*(↑u⁻¹:ActualEisensteinCubic.O),?_⟩
    calc
      _=((↑u⁻¹:ActualEisensteinCubic.O)*u.val)*(r*a+s*c):=by ring
      _=1:=by rw [Units.inv_mul,hrs,mul_one]
