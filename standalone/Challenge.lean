section

/- Exact physical history normalization under adjacent common-mark compatibility.
No global residue assignment is supplied; all original local rows and cutoffs remain. -/

open Finset
open scoped Classical
namespace Bounty

section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hcompat : ∀ j : Fin n, ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

variable
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

include hstep in
theorem physical_selected_coarse_adjacent_raw_history
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalMarkRawExtension
      (finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
        (physicalSelectedCoarseRow (B := B) C aux k L σ τ β V ρ hV ω retention) (2 * n + 1) F)
      (L 0) =
      fun s => (∏ i ∈ range (2 * n + 1), physicalSelectedCoarseScalar C aux L σ ω i) *
        globalBirthJointRawHistory (fun i g => physicalGroupBareAtomicActivity L g i)
          (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β
            (fun _ j => 1 - retention j) V (fun _ => ρ) hV B)
          (fun _ => B) (2 * n + 1) (physicalMarkRawExtension F (L (Fin.last n))) s := by
  rw [physical_selected_coarse_adjacent_composition C aux k L a σ τ hstep hcompat hlist hP hdis hk
    β V ρ hV B ω retention F]
  exact global_birth_joint_raw_history_weighted
    (fun i g => physicalGroupBareAtomicActivity L g i)
    (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β
      (fun _ j => 1 - retention j) V (fun _ => ρ) hV B)
    (fun _ => B) (physicalSelectedCoarseScalar C aux L σ ω) (2 * n + 1) _

include hstep in
theorem physical_selected_fixed_path_eq_adjacent :
    finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedCoarseRow (B := B) C aux k L σ τ β V ρ hV ω retention)
      (2 * n + 1) physicalEmptyMemoryTerminal (physicalInitialMarkState B (L 0)) =
      (∏ i ∈ range (2 * n + 1), physicalSelectedCoarseScalar C aux L σ ω i) *
        physicalJointAdjacentRawHistory C aux k L a σ τ hcompat hlist hP hdis hk β
          (fun _ j => 1 - retention j) V (fun _ => ρ) hV B := by
  have h := congrFun (physical_selected_coarse_adjacent_raw_history C aux k L a σ τ hstep hcompat
    hlist hP hdis hk β V ρ hV B ω retention (physicalEmptyMemoryTerminal (B := B)))
    (physicalMarkRawReadout (physicalInitialMarkState B (L 0)))
  have hext := physical_mark_extension_roundtrip
    (finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
      (physicalSelectedCoarseRow (B := B) C aux k L σ τ β V ρ hV ω retention)
      (2 * n + 1) physicalEmptyMemoryTerminal) (physicalInitialMarkState B (L 0))
  change physicalMarkRawExtension _ (L 0) _ = _ at hext
  rw [hext, physical_empty_memory_terminal_extension, physical_initial_mark_state_readout] at h
  exact h

end ResiduePath
