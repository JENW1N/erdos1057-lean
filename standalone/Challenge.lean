    ((List.range (4 * (n + 1) + 1)).map (physicalSelectedFineTag (n + 1))) pl.1 pl.2 x path

theorem physical_root_effective_path_action
    (f : PhysicalFullBoundedState (fun g => P (e.symm g).val) J ell B → ℂ)
