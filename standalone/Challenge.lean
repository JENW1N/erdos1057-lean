section

/- Uniform low-frequency discrepancy across a whole polynomial shift window. -/

open Finset Filter

namespace Bounty

theorem abs_add_le_rpow_max_add_one {L u σ a b : ℝ} (hL : 2 ≤ L)
    (hu : |u| ≤ L ^ a) (hσ : |σ| ≤ L ^ b) :
    |u + σ| ≤ L ^ (max a b + 1) := by
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have ha := Real.rpow_le_rpow_of_exponent_le hL1 (le_max_left a b)
  have hb := Real.rpow_le_rpow_of_exponent_le hL1 (le_max_right a b)
  calc
    _ ≤ |u| + |σ| := abs_add_le u σ
    _ ≤ 2 * L ^ max a b := by linarith
    _ ≤ L * L ^ max a b := mul_le_mul_of_nonneg_right hL (Real.rpow_nonneg hL0.le _)
    _ = L ^ (max a b + 1) := by rw [Real.rpow_add hL0, Real.rpow_one]; ring

theorem eventually_ambient_rough_uniform_shift_discrepancy
    (hZ : PrimitiveZeroFreeHalfPlane) {γ vMax S B0 Cmod Sfreq B : ℝ}
    (hγ : 0 < γ) (hv : vMax < 1) (hS : 0 ≤ S) (hB0 : 0 ≤ B0)
    (hprecision : max (max B0 Sfreq) Cmod + B + 5 ≤ S) :
    ∀ᶠ L : ℝ in atTop, ∀ a v : ℝ, v ≤ vMax →
      ∀ (r : ℕ) [NeZero r] (χ : DirichletCharacter ℂ r), (r : ℝ) ≤ L ^ Cmod →
      ∀ u σ : ℝ, |u| ≤ L ^ B0 → |σ| ≤ L ^ Sfreq → ∀ m n : ℕ,
        ‖∑ i ∈ Ioc m n, (ambientRoughIntervalTypeIIAlpha γ L S a v i : ℂ) *
          harmonicMellinWeight (u + σ) i * χ (i : ZMod r)‖ ≤ L ^ (-B) := by
  have hx : 0 ≤ max (max B0 Sfreq) Cmod :=
    hB0.trans ((le_max_left _ _).trans (le_max_left _ _))
  have hT : 0 ≤ max (max B0 Sfreq) Cmod + 1 := by linarith
  filter_upwards [eventually_ambient_rough_interval_typeII_discrepancy_uniform
    hZ hγ hv hS hT (by linarith : (max (max B0 Sfreq) Cmod + 1) + B + 4 ≤ S),
    eventually_ge_atTop (2 : ℝ)] with L hdis hL
  intro a v hv' r hr χ hrange u σ hu hσ m n
  have hL1 : 1 ≤ L := by linarith
  apply hdis a v hv' r χ _ (u + σ) _ m n
  · exact hrange.trans (Real.rpow_le_rpow_of_exponent_le hL1
      (by linarith [le_max_right (max B0 Sfreq) Cmod]))
  · exact (abs_add_le_rpow_max_add_one hL hu hσ).trans
      (Real.rpow_le_rpow_of_exponent_le hL1
        (by linarith [le_max_left (max B0 Sfreq) Cmod]))

theorem eventually_ambient_prime_uniform_shift_discrepancy
    (hZ : PrimitiveZeroFreeHalfPlane) {S B0 Cmod Sfreq B : ℝ}
    (hS : 0 ≤ S) (hB0 : 0 ≤ B0)
    (hprecision : max (max B0 Sfreq) Cmod + B + 5 ≤ S) :
    ∀ᶠ L : ℝ in atTop, ∀ κ : ℝ, 0 ≤ κ → κ ≤ 1 / 50 →
      ∀ (r : ℕ) [NeZero r] (χ : DirichletCharacter ℂ r), (r : ℝ) ≤ L ^ Cmod →
      ∀ u σ : ℝ, |u| ≤ L ^ B0 → |σ| ≤ L ^ Sfreq → ∀ m n : ℕ,
        ‖∑ i ∈ Ioc m n, (ambientPrimeTypeIIAlpha κ L S i : ℂ) *
          harmonicMellinWeight (u + σ) i * χ (i : ZMod r)‖ ≤ L ^ (-B) := by
  have hx : 0 ≤ max (max B0 Sfreq) Cmod :=
    hB0.trans ((le_max_left _ _).trans (le_max_left _ _))
  have hT : 0 ≤ max (max B0 Sfreq) Cmod + 1 := by linarith
  filter_upwards [eventually_ambient_prime_typeII_discrepancy hZ hS hT
    (by linarith : (max (max B0 Sfreq) Cmod + 1) + B + 4 ≤ S),
    eventually_ge_atTop (2 : ℝ)] with L hdis hL
  intro κ hκ hκ' r hr χ hrange u σ hu hσ m n
  have hL1 : 1 ≤ L := by linarith
  apply hdis κ hκ hκ' r χ _ (u + σ) _ m n
  · exact hrange.trans (Real.rpow_le_rpow_of_exponent_le hL1
      (by linarith [le_max_right (max B0 Sfreq) Cmod]))
  · exact (abs_add_le_rpow_max_add_one hL hu hσ).trans
      (Real.rpow_le_rpow_of_exponent_le hL1
        (by linarith [le_max_left (max B0 Sfreq) Cmod]))

end Bounty
end

section

/- Exponential coefficient support gives the actual dyadic base bounds. -/

open Finset Filter

namespace Bounty

theorem eventually_exponential_dyadic_base_bounds {a b C : ℝ}
    (ha : 0 < a) (hb : b < 1) (hC : 0 < C) :
    ∀ᶠ L : ℝ in atTop, ∀ U x : ℝ,
      Real.exp (a*L) ≤ x → x ≤ C*Real.exp (b*L) → U ≤ x → x ≤ 2*U →
      Real.exp ((a/2)*L) ≤ U ∧ U ≤ Real.exp L := by
  have hgap : 0 < 1-b := sub_pos.mpr hb
  filter_upwards [eventually_exp_half_le_half_exp ha,
    eventually_ge_atTop (Real.log C/(1-b))] with L hhalf hL
  intro U x hlo hhi hUx hxU
  have hlog : Real.log C ≤ (1-b)*L := by
    have h := (div_le_iff₀ hgap).mp hL
    nlinarith only [h]
  have hupper : C*Real.exp (b*L) ≤ Real.exp L := by
    calc
      _ = Real.exp (Real.log C+b*L) := by rw [Real.exp_add,Real.exp_log hC]
      _ ≤ _ := Real.exp_le_exp.mpr (by nlinarith only [hlog])
  exact ⟨hhalf.trans (by linarith), hUx.trans (hhi.trans hupper)⟩

theorem original_dyadic_member_bounds (H i n : ℕ)
    (hn : n ∈ dyadicNatBucket (Icc 1 H) i) :
    originalDyadicBase i ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*originalDyadicBase i := by
  rw [dyadicNatBucket_eq_real_interval (Icc 1 H) (fun m hm => (mem_Icc.mp hm).1)] at hn
  exact ⟨(mem_filter.mp hn).2.1.le,(mem_filter.mp hn).2.2⟩

end Bounty
end

section

/- The exact original finite dyadic partition has only polynomial cost. -/

open Finset Filter
namespace Bounty

theorem eventually_original_dyadic_count :
    ∀ᶠ L : ℝ in atTop,
      ((dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊)).card : ℝ) ≤ L^2 := by
  filter_upwards [eventually_ge_atTop (Real.log 33), eventually_ge_atTop (1 : ℝ),
    eventually_ge_atTop (2/Real.log 2+2)] with L h33 hL hlarge
  have hL0 : 0 ≤ L := by linarith
  have h33exp : (33 : ℝ) ≤ Real.exp L := by
    calc
      _ = Real.exp (Real.log 33) := (Real.exp_log (by norm_num)).symm
      _ ≤ _ := Real.exp_le_exp.mpr h33
  have hupper : 33*Real.exp L ≤ Real.exp (2*L) := by
    calc
      _ ≤ Real.exp L*Real.exp L := mul_le_mul_of_nonneg_right h33exp (Real.exp_pos L).le
      _ = _ := by rw [← Real.exp_add]; congr 1; ring
  have hc := dyadic_indices_card_window (Icc 1 ⌊33*Real.exp L⌋₊)
    (a := 0) (b := 2*L) (by linarith) (by
      intro n hn
      have hn' := mem_Icc.mp hn
      refine ⟨hn'.1, ?_, ?_⟩
      · simpa only [Real.exp_zero,Nat.cast_one] using (Nat.cast_le (α := ℝ).mpr hn'.1)
      · exact (Nat.cast_le.mpr hn'.2).trans ((Nat.floor_le (by positivity)).trans hupper))
  simp only [sub_zero] at hc
  have hmul := mul_le_mul_of_nonneg_right hlarge hL0
  calc
    _ ≤ 2*L/Real.log 2+2 := hc
    _ = (2/Real.log 2)*L+2 := by ring
    _ ≤ (2/Real.log 2+2)*L := by nlinarith
    _ ≤ L^2 := by nlinarith [hmul]

theorem abs_double_sum_le_card_sq {ι : Type*} (I : Finset ι) (f : ι → ι → ℝ)
    {R : ℝ} (hR : 0 ≤ R)
    (hf : ∀ i ∈ I, ∀ j ∈ I, f i j ≠ 0 → |f i j| ≤ R) :
    |∑ i ∈ I, ∑ j ∈ I, f i j| ≤ (I.card : ℝ)^2 * R := by
  calc
    _ ≤ ∑ i ∈ I, |∑ j ∈ I, f i j| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ i ∈ I, ∑ j ∈ I, |f i j| := sum_le_sum (fun _ _ => abs_sum_le_sum_abs _ _)
    _ ≤ ∑ _i ∈ I, ∑ _j ∈ I, R := by
      apply sum_le_sum
      intro i hi
      apply sum_le_sum
      intro j hj
      by_cases hz : f i j = 0
      · simpa only [hz,abs_zero] using hR
      · exact hf i hi j hj hz
    _ = _ := by simp only [sum_const,nsmul_eq_mul]; ring

end Bounty
end

section

/- All harmonic support and scale parameters are verified on the original dyadic indices. -/

open Filter Finset Real
open scoped Classical
namespace Bounty

theorem eventually_actual_candidate_harmonic_parameters {c b K A ε : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hK : 0 ≤ K) (hA : 0 ≤ A) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type*) [Fintype G]
      (ι : G → candidatePIndices c L) (J : ℕ) (C : G → Finset (Fin J))
      (aux : PhysicalAuxLabels (fun g => candidatePBand (c*L) (ι g).val) C),
      (J*Fintype.card G : ℕ) ≤ A*log L →
      ∀ U V : ℝ, exp (b*L) ≤ U → U ≤ exp L → exp (b*L) ≤ V → V ≤ exp L →
      ∀ k ∈ Icc (-(typeIIAdmissibleDeterminantBound L K : ℤ)) (typeIIAdmissibleDeterminantBound L K : ℤ),
      ∀ j ∈ range (typeIISmoothDyadicCount L),
      let Z := typeIISmoothDyadicScale U V (U*L^(-K)) j
      let d := physicalFreeFactor C aux
      let Y := Z*(d : ℝ)/2
      let N := ⌈3*Z*(d : ℝ)⌉₊
      0 < Z ∧ |(k : ℝ)| ≤ Z ∧ 1 ≤ Z*(d : ℝ) ∧ 3*Z < exp (4*L) ∧
      0 < Y ∧ exp (b*L) ≤ Y ∧ b*L ≤ log Y ∧ log Y ≤ (4+ε)*L ∧
      (d : ℝ) ≤ exp (ε*L) ∧ 2*((N : ℝ)/Y)*(1+log (N : ℝ))^15 ≤ L^(31 : ℝ) ∧
      log (N : ℝ) ≤ (4+ε)*L ∧
      ∀ w ∈ harmonicPositiveSupport Z k d,
        (0 ≤ w ∧ w ≤ (N : ℤ)) ∧ (0 < w+k*(d : ℤ) ∧ w+k*(d : ℤ) ≤ (N : ℤ)) ∧
        Y ≤ (w : ℝ) ∧ ‖(typeIIHarmonicDyadic ((w : ℝ)/(Z*(d : ℝ))) : ℂ)‖ ≤ 2 := by
  obtain ⟨v, vmax, _, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  filter_upwards [hpool, eventually_actual_harmonic_scale_inputs hb hK,
    eventually_typeII_harmonic_scale_lower hb hK,
    eventually_candidate_harmonic_energy_polynomial hc hA,
    eventually_candidate_free_factor_subexponential hc hA hε,
    eventually_candidate_harmonic_log_linear hc hA hε, eventually_ge_atTop (0 : ℝ)]
    with L hp hgeo hlo henergy hfree hlog hL
  intro G _ ι J C aux hslots U V hUlo hUhi hVlo hVhi k hk j hj
  dsimp only
  let Z := typeIISmoothDyadicScale U V (U*L^(-K)) j
  let d := physicalFreeFactor C aux
  have hprime : ∀ g p, p ∈ candidatePBand (c*L) (ι g).val → p.Prime := by
    intro g p hpg
    exact ((hp.2.2.2.2.2 (ι g).val (ι g).property).2.2 p hpg).1
  have hd : 0 < d := prod_pos (fun g _ => prod_pos (fun u _ => (hprime g _ (aux g u).property).pos))
  have hd1 : (1 : ℝ) ≤ d := by exact_mod_cast hd
  obtain ⟨hZ, _, hkZ, hcut⟩ := hgeo U V hUlo hUhi hVlo hVhi k hk j hj
  have hYlo : exp (b*L) ≤ Z*(d : ℝ)/2 := by
    have hz := hlo U V hUlo hVlo j
    have hm := mul_le_mul_of_nonneg_left hd1 hZ.le
    dsimp only [Z] at *
    nlinarith
  have hY : 0 < Z*(d : ℝ)/2 := (exp_pos _).trans_le hYlo
  have hprod : 1 ≤ Z*(d : ℝ) := by
    have hh : 1 ≤ exp (b*L) := one_le_exp (mul_nonneg hb.le hL)
    linarith
  have he := henergy G ι J C aux hslots Z hZ hprod hcut
  have hdsmall := hfree G ι J C aux hslots
  have hNlog := hlog G ι J C aux hslots Z hZ hprod hcut
  have hYN : Z*(d : ℝ)/2 ≤ (⌈3*Z*(d : ℝ)⌉₊ : ℝ) := by
    have hh := Nat.le_ceil (3*Z*(d : ℝ))
    nlinarith
  have hYlog : log (Z*(d : ℝ)/2) ≤ (4+ε)*L :=
    (log_le_log hY hYN).trans hNlog
  have hloLog : b*L ≤ log (Z*(d : ℝ)/2) := (le_log_iff_exp_le hY).mpr hYlo
  exact ⟨hZ, hkZ, hprod, hcut, hY, hYlo, hloLog, hYlog, hdsmall, he, hNlog,
    (harmonic_positive_error_parameters hZ k hd hkZ).2⟩

end Bounty
end

section

/- Scalar polynomial envelopes for selected endpoint peeling on the original support. -/

open Real
namespace Bounty

theorem selected_peel_log_factor_power {L v z : ℝ}
    (hv : 0 < v) (hL : 1 ≤ L) (hcoef : 1+10/v ≤ L) (hz0 : 0 ≤ z) (hz : z ≤ 5*L) :
    (1+2*z/v)^2 ≤ L^(4 : ℝ) := by
  have hb : 1+2*z/v ≤ L*L := by
    calc
      _ ≤ 1+2*(5*L)/v := by gcongr
      _ = 1+(10/v)*L := by ring
      _ ≤ L+(10/v)*L := add_le_add hL le_rfl
      _ = (1+10/v)*L := by ring
      _ ≤ L*L := mul_le_mul_of_nonneg_right hcoef (zero_le_one.trans hL)
  calc
    _ ≤ (L*L)^2 := pow_le_pow_left₀ (by positivity) hb 2
    _ = _ := by norm_num [pow_two]; ring

theorem selected_peel_harmonic_power {L M energy m Cb Ce : ℝ}
    (hL : 3 ≤ L) (hM0 : 0 ≤ M) (hM : M ≤ L^m)
    (he0 : 0 ≤ energy) (he : energy ≤ L^(31 : ℝ)) :
    3*(M*L^Cb)^2*(L^Ce*L^Ce*L^Ce)^2*energy ≤ L^(2*m+2*Cb+6*Ce+32) := by
  have hL0 : 0 < L := by linarith
  calc
    _ ≤ L*(L^m*L^Cb)^2*(L^Ce*L^Ce*L^Ce)^2*L^(31 : ℝ) := by gcongr
    _ = _ := by
      nth_rw 1 [← rpow_one L]
      simp only [← rpow_mul_natCast hL0.le, ← rpow_add hL0]
      congr 1
      ring

theorem selected_peel_decay_absorb {L cost T : ℝ} (hL : 1 ≤ L)
    (hc : cost ≤ L^T) (D : ℝ) :
    cost*L^(-max 0 (D+T)) ≤ L^(-D) := by
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL
  calc
    _ ≤ L^T*L^(-max 0 (D+T)) := mul_le_mul_of_nonneg_right hc (rpow_nonneg hL0.le _)
    _ = L^(T-max 0 (D+T)) := by rw [← rpow_add hL0]; congr 1
    _ ≤ _ := rpow_le_rpow_of_exponent_le hL (by linarith only [le_max_right (0 : ℝ) (D+T)])

end Bounty
end

section

/- Recorded edge displacements are the actual local displacements on the
unchanged chronological path. On supported states they equal the full edge divisor. -/

open scoped Classical
namespace Bounty
section Local
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (cut : ℕ → Fin N → Finset (Fin J))

noncomputable def physicalLocalDisplacement :
    (tag : Option (Fin (n + 1) ⊕ Fin n)) →
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B) →
    PhysicalFullLedgerEvent C k tag s → ℤ
  | none, _, _ => 0
  | some (.inl _), _, _ => 0
  | some (.inr j), s, e => physicalActiveDisplacement C k cut j (fun g => (s.2 g).1) e.1

theorem physical_local_displacement_edge_observation
    (j : Fin n) (before after : Fin N → Finset (Fin J))
    (tag : Option (Fin (n + 1) ⊕ Fin n)) (htag : tag = some (.inr j))
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k tag s) :
    physicalLocalDisplacement C k cut tag s e =
      physicalObservedDisplacement C k cut j
        (physicalFullEventObservation C k before after tag s e) (fun g => (s.2 g).1) := by
  subst tag
  exact (physical_observed_displacement_aux C k cut j e.1 _).symm

theorem physical_local_displacement_nonedge (i : ℕ) (hi : i % 4 ≠ 2)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k (physicalSelectedFineTag n i) s) :
    physicalLocalDisplacement C k cut (physicalSelectedFineTag n i) s e = 0 := by
  have hgood (j : Fin n) : physicalSelectedFineTag n i ≠ some (.inr j) := by
    intro h
    unfold physicalSelectedFineTag at h
    split_ifs at h; simp_all
  generalize ht : physicalSelectedFineTag n i = tag at e ⊢
  cases tag with
  | none => rfl
  | some tag =>
    cases tag with
    | inl j => rfl
    | inr j => exact (hgood j ht).elim

theorem physical_record_displacement_local
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (p : FiniteEventPath (fun i => PhysicalFullLedgerEvent C k (physicalSelectedFineTag n i))
      (fun i => physicalFullLedgerEventTarget C k (physicalSelectedFineTag n i))
      (List.range (4 * n + 1)) s) (j : Fin n) :
    let E := fun i => PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n i)
    let target := fun i => physicalFullLedgerEventTarget (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n i)
    let occ := finiteScheduleOccurrence E target (4 * n + 1) s p
    physicalRecordDisplacement C k cut
      (finiteEventPathObservations E target
        (physicalFullTraceObservation C k (physicalSelectedFineTag n) cut) (List.range (4 * n + 1)) s p) j =
      physicalLocalDisplacement C k cut (physicalSelectedFineTag n (4 * j.val + 2))
        (occ ⟨4 * j.val + 2, by have := j.isLt; omega⟩).1
        (occ ⟨4 * j.val + 2, by have := j.isLt; omega⟩).2 := by
  dsimp only
  let E := fun i => PhysicalFullLedgerEvent (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n i)
  let target := fun i => physicalFullLedgerEventTarget (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n i)
  let observe := physicalFullTraceObservation (P := P) (ell := ell) (B := B) C k (physicalSelectedFineTag n) cut
  let r := finiteEventPathObservations E target observe (List.range (4 * n + 1)) s p
  let occ := finiteScheduleOccurrence E target (4 * n + 1) s p
  have hlen : r.length = 4 * n + 1 := by
    simp only [r, finite_event_path_observations_length, List.length_range]
  have h1 : 4 * j.val + 1 < r.length := by omega
  have h2 : 4 * j.val + 2 < r.length := by omega
  change (match r[4 * j.val + 1]?, r[4 * j.val + 2]? with
    | some a, some b => physicalObservedDisplacement C k cut j b.2.1
        (fun g => (a.2.2.2 g).1)
    | _, _ => 0) = _
  rw [List.getElem?_eq_getElem h1, List.getElem?_eq_getElem h2]
  change physicalObservedDisplacement C k cut j (r.get ⟨_, h2⟩).2.1
    (fun g => ((r.get ⟨_, h1⟩).2.2.2 g).1) = _
  rw [finite_schedule_observations_get E target observe _ s p ⟨_, by omega⟩,
    finite_schedule_observations_get E target observe _ s p ⟨_, by omega⟩]
  change physicalObservedDisplacement C k cut j
    (physicalFullEventObservation C k (cut (4 * j.val + 2)) (cut (4 * j.val + 2 + 1))
      (physicalSelectedFineTag n (4 * j.val + 2)) (occ ⟨4 * j.val + 2, by omega⟩).1
      (occ ⟨4 * j.val + 2, by omega⟩).2)
    (fun g => ((target (4 * j.val + 1) (occ ⟨4 * j.val + 1, by omega⟩).1
      (occ ⟨4 * j.val + 1, by omega⟩).2).2 g).1) = _
  have hs := finite_schedule_source_after E target (4 * n + 1) s p
    (4 * j.val + 1) (by omega)
  change (occ ⟨4 * j.val + 2, by omega⟩).1 =
    target (4 * j.val + 1) (occ ⟨4 * j.val + 1, by omega⟩).1
      (occ ⟨4 * j.val + 1, by omega⟩).2 at hs
  rw [← hs]
  exact (physical_local_displacement_edge_observation C k cut j _ _ _
    (physical_fine_tag_edge j) _ _).symm

theorem physical_active_displacement_full_divisor (j : Fin n)
    (hcut : cut (4 * j.val + 2) = C j)
    (x : PhysicalFullBoundedState P J ell B) (hx : FullActiveInjective x)
    (a : PhysicalAuxLabels P (C j)) :
    physicalActiveDisplacement C k cut j (fun g => (x g).1) a =
      k j * (physicalFullSharedD (C j)
        (productActiveMemorySplit (fun g => physicalFullSharedIndices (C j g)) B x).1 a : ℤ) := by
  have hx' : ∀ g, Function.Injective (x g).1 := hx
  simp only [physicalActiveDisplacement, dif_pos hx', hcut]
  change k j * (physicalD (C j) (physicalFullStateLabels (C j) x hx) a : ℤ) = _
  have h := physical_full_shared_D_eq (C j) (physicalFullStateLabels (C j) x hx)
    (fun g => (x g).2) a
  rw [physical_full_state_encode_labels] at h
  rw [h]

end Local
end Bounty
end

section

/- The actual Mellin-shifted ideal frequency has a fixed polynomial envelope. -/

open Filter Real
namespace Bounty

theorem eventually_harmonic_mellin_frequency_bound (A R : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ a b v : ℝ,
      |a| ≤ L^A → |b| ≤ L^A → |v| ≤ L^R →
      |-(a+b+2*Real.pi*v)| ≤ L^(max A R+1) := by
  filter_upwards [eventually_ge_atTop (max 1 (2+2*Real.pi))] with L hL
  have hL1 : 1 ≤ L := (le_max_left _ _).trans hL
  have hL0 : 0 < L := zero_lt_one.trans_le hL1
  have hLC : 2+2*Real.pi ≤ L := (le_max_right _ _).trans hL
  have hA : L^A ≤ L^(max A R) := rpow_le_rpow_of_exponent_le hL1 (le_max_left _ _)
  have hR : L^R ≤ L^(max A R) := rpow_le_rpow_of_exponent_le hL1 (le_max_right _ _)
  intro a b v ha hb hv
  calc
    _ = |a+b+2*Real.pi*v| := abs_neg _
    _ ≤ |a|+|b|+|2*Real.pi*v| := (abs_add_le _ _).trans (add_le_add (abs_add_le _ _) le_rfl)
    _ = |a|+|b|+(2*Real.pi)*|v| := by rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 2*Real.pi)]
    _ ≤ L^(max A R)+L^(max A R)+(2*Real.pi)*L^(max A R) := by
      gcongr
      · exact ha.trans hA
      · exact hb.trans hA
      · exact hv.trans hR
    _ = (2+2*Real.pi)*L^(max A R) := by ring
    _ ≤ L*L^(max A R) := mul_le_mul_of_nonneg_right hLC (rpow_nonneg hL0.le _)
    _ = L^(max A R+1) := by
      nth_rw 1 [← rpow_one L]
      rw [← rpow_add hL0]
      congr 1
      ring

end Bounty
end

section

/- The common-window harmonic cell coefficient has mass bounded by endpoint energies. -/

open Finset Real
namespace Bounty

noncomputable def harmonicCellCoefficient (Y a b : ℝ) (d : ℕ) (δ : ℤ)
    (F G : ℤ → ℂ) (n : ℤ) : ℂ :=
  physicalPhase (-(a+b)) d *
    ((n : ℂ)⁻¹ * physicalPhase a n.natAbs * physicalPhase b (n+δ).natAbs *
      star ((harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)*F n) *
      ((harmonicCommonCutoff (((n+δ : ℤ) : ℝ)/Y) : ℂ)*G (n+δ)))

theorem harmonic_cell_coefficient_mass_le_energy {Y : ℝ} (hY : 0 < Y)
    (a b : ℝ) (d : ℕ) (δ : ℤ) (F G : ℤ → ℂ) :
    (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellCoefficient Y a b d δ F G n‖) ≤
      (8/Y)*sqrt (∑ n ∈ harmonicCommonSupport Y,
        ‖(harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)*F n‖^2)*
      sqrt (∑ n ∈ harmonicCommonSupport Y,
        ‖(harmonicCommonCutoff (((n+δ : ℤ) : ℝ)/Y) : ℂ)*G (n+δ)‖^2) := by
  let θ : ℤ → ℂ := fun n =>
    physicalPhase (-(a+b)) d * physicalPhase a n.natAbs * physicalPhase b (n+δ).natAbs
  let f : ℤ → ℂ := fun n => (harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)*F n
  let g : ℤ → ℂ := fun n => (harmonicCommonCutoff (((n+δ : ℤ) : ℝ)/Y) : ℂ)*G (n+δ)
  have hm := harmonic_coefficient_mass_le (harmonicCommonSupport Y) θ f g
    (div_pos hY (by norm_num : (0 : ℝ) < 8))
    (fun n hn => (mem_harmonic_common_support.mp hn).1)
    (by intro n _; simp only [θ, norm_mul, physical_phase_norm, one_mul, le_refl])
  have hscale : (1 : ℝ)/(Y/8) = 8/Y := by field_simp
  calc
    _ = ∑ n ∈ harmonicCommonSupport Y, ‖(θ n/(n : ℂ))*star (f n)*g n‖ := by
      apply sum_congr rfl
      intro n _
      congr 1
      dsimp only [harmonicCellCoefficient, θ, f, g]
      rw [div_eq_mul_inv]
      ring
    _ ≤ (1/(Y/8))*sqrt (∑ n ∈ harmonicCommonSupport Y, ‖f n‖^2)*
        sqrt (∑ n ∈ harmonicCommonSupport Y, ‖g n‖^2) := hm
    _ = _ := by rw [hscale]

end Bounty
end

