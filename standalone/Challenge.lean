noncomputable def cleanRawPairing {X : Type*} [Fintype X]
    (w : X → ℝ) (k f g : X → ℂ) : ℂ :=
  ∑ x, (w x : ℂ) * (starRingEnd ℂ) (f x) * g x * k x

noncomputable def cleanKernelPairing {X Y : Type*} [Fintype X] [Fintype Y]
    (w : X → ℝ) (K : X → Y → ℂ) (f : X → ℂ) (g : Y → ℂ) : ℂ :=
  ∑ x, ∑ y, (w x : ℂ) * (starRingEnd ℂ) (f x) * K x y * g y

theorem clean_raw_pairing_sum_left {A X : Type*} [Fintype X]
    (s : Finset A) (w : X → ℝ) (k : X → ℂ) (F : A → X → ℂ) (g : X → ℂ) :
    cleanRawPairing w k (∑ a ∈ s, F a) g = ∑ a ∈ s, cleanRawPairing w k (F a) g := by
  simp only [cleanRawPairing, Finset.sum_apply, map_sum, mul_sum, sum_mul]
  rw [sum_comm]

theorem clean_raw_pairing_sum_right {A X : Type*} [Fintype X]
    (s : Finset A) (w : X → ℝ) (k f : X → ℂ) (H : A → X → ℂ) :
    cleanRawPairing w k f (∑ a ∈ s, H a) = ∑ a ∈ s, cleanRawPairing w k f (H a) := by
  simp only [cleanRawPairing, Finset.sum_apply, mul_sum, sum_mul]
  rw [sum_comm]










