      (fun g j => aux (f g) ⟨j.val, by
        rw [← repeated_big_prime_pattern_equiv_symm_cut]
        exact j.property⟩) := by
  obtain ⟨i, rfl⟩ := repeated_big_prime_pattern_map_surjective f probes r t i
