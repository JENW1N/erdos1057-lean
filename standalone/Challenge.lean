    (hAB : ∀ g, Disjoint (A g) (B g)) (s : Finset G)
    (f : (∀ g, I g → X g) → ℂ) :
    finiteGroupFlattenFunction
      (finiteCoordinateFinsetAction (fun g (v : (I g → X g) → ℂ) => finiteCoordinateComponent (fun _ : I g => μ g)
        ∅ (B g).toList v) sᶜ
        (finiteCoordinateFinsetAction (fun g (v : (I g → X g) → ℂ) => finiteCoordinateComponent (fun _ : I g => μ g)
          (A g) (A g ∪ B g).toList v) s f)) =
      finiteCoordinateComponent (fun a : Sigma I => μ a.1) (s.sigma A) (s.sigma A).toList
        (finiteCoordinateComponent (fun a : Sigma I => μ a.1) ∅ (univ.sigma B).toList
          (finiteGroupFlattenFunction f)) := by
  have hin := finite_group_flatten_finset_action μ (s.sigma A) A (fun g => A g ∪ B g) s
    (fun g hg i _ => by simp only [mem_sigma, hg, true_and]) f
  have hout := finite_group_flatten_finset_action μ ∅ (fun g => (∅ : Finset (I g))) B sᶜ
