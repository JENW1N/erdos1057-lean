section

/- On the actual divisor fibers, shared endpoint and auxiliary avoidance
implies the original compatible-completion restrictions. -/

open Finset
open scoped Classical
namespace Bounty

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (C : G → Finset (Fin J))
  (hprime : ∀ g p, p ∈ P g → p.Prime)
  (u v : GroupMarkedLists P (fun g => ell + (C g).card))
  (aux : PhysicalAuxLabels P C)
  {w z : ℕ}
  (hw : 0 < w)
  (hz : 0 < z)
  (hu : ∀ g i, (u g i).val ∣ w)
  (hv : ∀ g i, (v g i).val ∣ z)

include G sharedInstance1 P J ell C hprime u v aux w z hw hz hu hv

theorem physical_shared_good_implies_cut_good 
    (s : PhysicalAuxLabels P (fun g => univ \ C g))
    (hs : physicalSharedDrawGood C (fun g => physicalSharedForbidden C aux g w z) s) :
    physicalRawCutGood C u v s := by
  refine ⟨fun g => (hs g).2, fun g => ⟨?_, ?_⟩⟩
  · apply Set.disjoint_left.mpr
    rintro p ⟨j, rfl⟩ ⟨i, hi⟩
    apply (hs g).1 j
    apply (physical_mem_shared_forbidden_iff C aux g (hprime g) hw hz (s g j)).mpr
    left
    rw [← hi]
    exact hu g i
  · apply Set.disjoint_left.mpr
    rintro p ⟨j, rfl⟩ ⟨i, hi⟩
    apply (hs g).1 j
    apply (physical_mem_shared_forbidden_iff C aux g (hprime g) hw hz (s g j)).mpr
    right
    left
    rw [← hi]
    exact hv g i

theorem physical_shared_good_iff_cut_avoiding 
    (s : PhysicalAuxLabels P (fun g => univ \ C g)) :
    physicalSharedDrawGood C (fun g => physicalSharedForbidden C aux g w z) s ↔
      physicalRawCutGood C u v s ∧
        ∀ g j, s g j ∉ physicalSharedForbidden C aux g w z := by
  constructor
  · intro hs
    exact ⟨physical_shared_good_implies_cut_good C hprime u v aux hw hz hu hv s hs,
      fun g => (hs g).1⟩
  · rintro ⟨hcut, havoid⟩ g
    exact ⟨havoid g, hcut.1 g⟩

theorem physical_cut_avoiding_mean_eq_shared_good_mean 
    (F : PhysicalAuxLabels P (fun g => univ \ C g) → ℂ) :
    (∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
      if physicalRawCutGood C u v s then
        if ∀ g j, s g j ∉ physicalSharedForbidden C aux g w z then F s else 0
      else 0) =
      ∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
        if physicalSharedDrawGood C (fun g => physicalSharedForbidden C aux g w z) s
          then F s else 0 := by
  apply sum_congr rfl
  intro s _
  rw [physical_shared_good_iff_cut_avoiding C hprime u v aux hw hz hu hv s]
  by_cases hc : physicalRawCutGood C u v s
  · simp only [hc, true_and, if_true]
  · simp only [hc, false_and, if_false]

end


end Bounty
end

section

/- Bounded shared-dependent coefficients on the actual bad-draw event. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_bad_shared_mean_norm_le {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (aux : PhysicalAuxLabels P C) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (A : PhysicalAuxLabels P (fun g => univ \ C g) → Prop) [DecidablePred A]
    (hbad : ∀ s, A s → ¬physicalSharedDrawGood C (fun g => physicalSharedForbidden C aux g w z) s)
    (F : PhysicalAuxLabels P (fun g => univ \ C g) → ℂ)
    {B : ℝ} (hB : 0 ≤ B) (hF : ∀ s, A s → ‖F s‖ ≤ B) :
    ‖∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
      if A s then (physicalAuxMass V (fun g => univ \ C g) s : ℂ) * F s else 0‖ ≤
      (∑ g, (J - (C g).card : ℕ) *
        (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)) * B := by
  calc
    _ ≤ ∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
        ‖if A s then (physicalAuxMass V (fun g => univ \ C g) s : ℂ) * F s else 0‖ :=
      norm_sum_le _ _
    _ ≤ (∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
        physicalAuxMass V (fun g => univ \ C g) s *
          (if ¬physicalSharedDrawGood C (fun g => physicalSharedForbidden C aux g w z) s
            then 1 else 0)) * B := by
      rw [sum_mul]
      apply sum_le_sum
      intro s _
      have hm := physical_aux_mass_nonneg V (fun g => univ \ C g) (fun g => (hV g).le) s
      by_cases hs : A s
      · rw [if_pos hs, if_pos (hbad s hs), mul_one, norm_mul,
          Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hm]
        exact mul_le_mul_of_nonneg_left (hF s hs) hm
      · rw [if_neg hs, norm_zero]
        exact mul_nonneg (mul_nonneg hm (by split_ifs <;> norm_num)) hB
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (physical_shared_draw_endpoint_bad_mass V C hV hMass aux hw hz hPmin hp) hB

theorem physical_bad_cut_mean_norm_le {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (u v : GroupMarkedLists P (fun g => ell + (C g).card))
    (aux : PhysicalAuxLabels P C) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (F : PhysicalAuxLabels P (fun g => univ \ C g) → ℂ)
    {B : ℝ} (hB : 0 ≤ B)
    (hF : ∀ s, physicalRawCutGood C u v s → ‖F s‖ ≤ B) :
    ‖∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
      if physicalRawCutGood C u v s ∧
        ¬(∀ g j, s g j ∉ physicalSharedForbidden C aux g w z)
      then (physicalAuxMass V (fun g => univ \ C g) s : ℂ) * F s else 0‖ ≤
      (∑ g, (J - (C g).card : ℕ) *
        (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)) * B := by
  apply physical_bad_shared_mean_norm_le V C hV hMass aux hw hz hPmin hp
    (fun s => physicalRawCutGood C u v s ∧
      ¬(∀ g j, s g j ∉ physicalSharedForbidden C aux g w z)) _ F hB
  · intro s hs
    exact hF s hs.1
  · intro s hs hg
    exact hs.2 (fun g => (hg g).1)

end Bounty
end

section

/- Replacing both literal selected endpoints on the original harmonic support. -/

open Finset
open scoped Classical
namespace Bounty

theorem selected_harmonic_peel_replacement
    {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v)
    (V : G → ℝ) (t : G → ℕ) (T : ℕ)
    (hV : ∀ g, v ≤ V g) (ht : ∀ g, t g ≤ T)
    (hprime : ∀ g, ∀ p ∈ P g, p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (k : ℕ) (htg : t g = k + 1) (big : Finset G) (hsmall : g ∉ big)
    (b₀ b₁ : GroupMarkedLists (fun h : big => P h.val) (fun h : big => t h.val) → ℂ)
    {H : ℝ} (hH : 0 ≤ H) (hb₀ : ∀ l, ‖b₀ l‖ ≤ H) (hb₁ : ∀ l, ‖b₁ l‖ ≤ H)
    (Q : Finset ℕ) (hQ : ∀ g, P g ⊆ Q) (α₀ β₀ γ₀ α₁ β₁ γ₁ : ℕ → ℂ)
    (hα₀free : ∀ d, ¬ Disjoint d.primeFactors Q → α₀ d = 0)
    (hβ₀free : ∀ d, ¬ Disjoint d.primeFactors Q → β₀ d = 0)
    (hα₁free : ∀ d, ¬ Disjoint d.primeFactors Q → α₁ d = 0)
    (hβ₁free : ∀ d, ¬ Disjoint d.primeFactors Q → β₁ d = 0)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα₀ : ∀ m, ‖α₀ m‖ ≤ A) (hβ₀ : ∀ p, ‖β₀ p‖ ≤ B) (hγ₀ : ∀ r, ‖γ₀ r‖ ≤ C)
    (hα₁ : ∀ m, ‖α₁ m‖ ≤ A) (hβ₁ : ∀ p, ‖β₁ p‖ ≤ B) (hγ₁ : ∀ r, ‖γ₁ r‖ ≤ C)
    (S : Finset ℤ) (δ : ℤ) (N : ℕ) (θ : ℤ → ℂ)
    {Y K : ℝ} (hY : 0 < Y) (hK : 0 ≤ K)
    (hS : ∀ n ∈ S, 0 < n ∧ n ≤ (N : ℤ))
    (hshift : ∀ n ∈ S, 0 < n+δ ∧ n+δ ≤ (N : ℤ))
    (hYlow : ∀ n ∈ S, Y ≤ (n : ℝ)) (hθ : ∀ n ∈ S, ‖θ n‖ ≤ K) :
    let E := ((markedDivisorBound q v T) ^ Fintype.card G * H) ^ 2 *
      ((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15)
    let D := H ^ 2 *
      (((markedDivisorBound q v T) ^ Fintype.card G * (1 + 2 * Real.log N / v)) ^ 2 *
        (((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) *
          ∑ p ∈ P g, 1 / (p : ℝ) ^ 2))
    ‖(∑ n ∈ S, (θ n / (n : ℂ)) *
        (starRingEnd ℂ) (selectedMarkedEndpoint P q V t big b₀ Q α₀ β₀ γ₀ n.natAbs) *
        selectedMarkedEndpoint P q V t big b₁ Q α₁ β₁ γ₁ (n+δ).natAbs) -
      (∑ n ∈ S, (θ n / (n : ℂ)) *
        (starRingEnd ℂ) (selectedPeeledEndpoint P q V t g k big b₀ Q α₀ β₀ γ₀ n.natAbs) *
        selectedPeeledEndpoint P q V t g k big b₁ Q α₁ β₁ γ₁ (n+δ).natAbs)‖ ≤
      (K/Y) * (Real.sqrt D * Real.sqrt E + Real.sqrt (2*(E+D)) * Real.sqrt D) := by
  dsimp only
  apply finite_harmonic_replacement_energy_bound S θ _ _ _ _ hY hK hYlow hθ
  · simpa only [add_zero] using selected_shifted_endpoint_energy P hq0 hq1 hv V t T hV ht
      big b₀ hH hb₀ Q α₀ β₀ γ₀ hA hB hC hα₀ hβ₀ hγ₀ S 0 N
        (by simpa only [add_zero] using hS)
  · exact selected_shifted_endpoint_energy P hq0 hq1 hv V t T hV ht
      big b₁ hH hb₁ Q α₁ β₁ γ₁ hA hB hC hα₁ hβ₁ hγ₁ S δ N hshift
  · simpa only [add_zero] using selected_shifted_peel_error_energy P hq0 hq1 hv V t T hV ht
      hprime hdis g k htg big hsmall b₀ hH hb₀ Q hQ α₀ β₀ γ₀ hα₀free hβ₀free
      hA hB hC hα₀ hβ₀ hγ₀ S 0 N (by simpa only [add_zero] using hS)
  · exact selected_shifted_peel_error_energy P hq0 hq1 hv V t T hV ht
      hprime hdis g k htg big hsmall b₁ hH hb₁ Q hQ α₁ β₁ γ₁ hα₁free hβ₁free
      hA hB hC hα₁ hβ₁ hγ₁ S δ N hshift

end Bounty
end

section

/- The whole common window has a local Fourier-to-Mellin estimate with unchanged coefficients. -/

open Finset MeasureTheory

namespace Bounty

theorem exists_wide_local_fourier_mellin_energy_constants {j : ℕ} (hj : 2 ≤ j) :
    ∃ Cj Cerr : ℝ, 0 < Cj ∧ 0 < Cerr ∧
      ∀ (S : Finset ℕ) (a : ℕ → ℂ) (Y H : ℝ),
      0 < Y → 1 ≤ H → H ≤ Y/64 →
      (∀ n ∈ S, Y/8 ≤ (n:ℝ) ∧ (n:ℝ) ≤ 64*Y) →
      (∫ β in {β : ℝ | |β| ≤ 1/H}, ‖localAdditivePolynomial S a β‖^2) ≤
        (Cj/Y) * (∫ t : ℝ, (1+|(H/Y)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) +
          Cerr * (H/Y)^2 * (∑ n ∈ S, ‖a n‖^2) := by
  obtain ⟨Cj,Cerr,hCj,hCerr,hinterval⟩ := exists_local_additive_mellin_interval_constants hj
  refine ⟨72*Cj*(32:ℝ)^j,576*Cerr,by positivity,by positivity,?_⟩
  intro S a Y H hY hH hsmall hS
  have hHp : 0 < H := lt_of_lt_of_le zero_lt_one hH
  have hSpos : ∀ n ∈ S, 0 < n := by
    intro n hn
    have hp : 0 < (n:ℝ) := (by positivity : 0 < Y/8).trans_le (hS n hn).1
    exact_mod_cast hp
  let I : ℝ := ∫ t : ℝ, (1+|(H/Y)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2
  let E : ℝ := ∑ n ∈ S, ‖a n‖^2
  have hI : 0 ≤ I := integral_nonneg (fun t => by positivity)
  have hE : 0 ≤ E := sum_nonneg (fun n _ => sq_nonneg _)
  have hlocal (i : ℕ) (hi : i ∈ range 9) :
      (4/H^2) * (∫ v in Set.Icc (((Y/8)*(2:ℝ)^i)/2) (3*((Y/8)*(2:ℝ)^i)),
        ‖localAdditiveConvolution S a H v‖^2) ≤
        (8*Cj*(32:ℝ)^j/Y)*I + 64*Cerr*(H/Y)^2*E := by
    let Z : ℝ := (Y/8)*(2:ℝ)^i
    have hZ : 0 < Z := by dsimp [Z]; positivity
    obtain ⟨hZlo,hZhi⟩ := wide_mellin_scale_bounds hY hi
    have hHZ : H ≤ Z/8 := by dsimp [Z]; linarith
    have hbound := hinterval S a hSpos Z H hZ hH hHZ
    have hscale := local_mellin_energy_scale_le hj S a hY hZ hHp hZhi
    have hIz : 0 ≤ ∫ t : ℝ, (1+|(H/Z)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2 :=
      integral_nonneg (fun t => by positivity)
    have hdiv : Cj/Z ≤ 8*Cj/Y := by
      apply (div_le_div_iff₀ hZ hY).mpr
      dsimp [Z]
      nlinarith [mul_le_mul_of_nonneg_left hZlo hCj.le]
    have hm : (Cj/Z) * (∫ t : ℝ, (1+|(H/Z)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) ≤
        (8*Cj*(32:ℝ)^j/Y)*I := by
      calc
        _ ≤ (8*Cj/Y)*((32:ℝ)^j*I) :=
          mul_le_mul hdiv hscale hIz (by positivity)
        _ = _ := by ring
    have hratio : H/Z ≤ 8*(H/Y) := by
      calc
        _ ≤ H/(Y/8) := div_le_div_of_nonneg_left hHp.le (by positivity) hZlo
        _ = _ := by ring
    have he : Cerr*(H/Z)^2*E ≤ 64*Cerr*(H/Y)^2*E := by
      have hs := pow_le_pow_left₀ (by positivity : 0 ≤ H/Z) hratio 2
      have he' := mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hs hCerr.le) hE
      calc
        _ ≤ Cerr*(8*(H/Y))^2*E := he'
        _ = _ := by ring
    exact hbound.trans (add_le_add hm he)
  have hcont := (local_additive_convolution_contDiff S a H).continuous
  have hcover := finite_cover_integral_le volume (range 9) (Set.Icc (Y/16) (65*Y))
    (fun i => Set.Icc (((Y/8)*(2:ℝ)^i)/2) (3*((Y/8)*(2:ℝ)^i)))
    (fun v => ‖localAdditiveConvolution S a H v‖^2) measurableSet_Icc
    (fun _ _ => measurableSet_Icc) (fun _ => sq_nonneg _)
    (hcont.norm.pow 2).integrableOn_Icc
    (fun _ _ => (hcont.norm.pow 2).integrableOn_Icc)
    (fun v hv => wide_mellin_interval_cover hY hv)
  have heq : (∫ v : ℝ, ‖localAdditiveConvolution S a H v‖^2) =
      ∫ v in Set.Icc (Y/16) (65*Y), ‖localAdditiveConvolution S a H v‖^2 := by
    symm
    apply setIntegral_eq_integral_of_forall_compl_eq_zero
    intro v hv
    rw [local_additive_convolution_wide_support S a hY hHp hsmall hS hv,
      norm_zero, zero_pow (by decide)]
  apply (local_fourier_energy_le_convolution S a hHp).trans
  rw [heq]
  calc
    _ ≤ (4/H^2) * (∑ i ∈ range 9,
        ∫ v in Set.Icc (((Y/8)*(2:ℝ)^i)/2) (3*((Y/8)*(2:ℝ)^i)),
          ‖localAdditiveConvolution S a H v‖^2) :=
      mul_le_mul_of_nonneg_left hcover (by positivity)
    _ = ∑ i ∈ range 9, (4/H^2) *
        (∫ v in Set.Icc (((Y/8)*(2:ℝ)^i)/2) (3*((Y/8)*(2:ℝ)^i)),
          ‖localAdditiveConvolution S a H v‖^2) := mul_sum _ _ _
    _ ≤ ∑ _i ∈ range 9, ((8*Cj*(32:ℝ)^j/Y)*I + 64*Cerr*(H/Y)^2*E) :=
      sum_le_sum hlocal
    _ = _ := by
      simp only [sum_const,card_range,nsmul_eq_mul]
      dsimp only [I,E]
      ring




end Bounty
end

