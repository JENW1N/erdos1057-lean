section

/- Integrated window-cutoff errors, controlled by shifted full-box square energy. -/

open Finset MeasureTheory

namespace Bounty

theorem harmonic_window_tail_square (a b Y R : ℝ) {P : ℝ → ℂ} {M B : ℝ}
    (hP : Continuous P) (hM : 0 ≤ M) (hPM : ∀ s, ‖P s‖ ≤ M)
    (hB : ∀ u, (∫ s in Set.Icc a b, ‖P (s+2*Real.pi*u)‖^2) ≤ B) :
    IntegrableOn (fun s => ‖∫ u in {u : ℝ | R < ‖u‖},
      harmonicWindowLogFourier u * physicalMellinPhase (-2*Real.pi*u) Y *
        P (s+2*Real.pi*u)‖^2) (Set.Icc a b) ∧
    (∫ s in Set.Icc a b, ‖∫ u in {u : ℝ | R < ‖u‖},
      harmonicWindowLogFourier u * physicalMellinPhase (-2*Real.pi*u) Y *
        P (s+2*Real.pi*u)‖^2) ≤
      (∫ u in {u : ℝ | R < ‖u‖}, ‖harmonicWindowLogFourier u‖)^2 * B := by
  have hκc : Continuous (fun u => harmonicWindowLogFourier u *
      physicalMellinPhase (-2*Real.pi*u) Y) := by
    apply harmonicWindowLogFourier.continuous.mul
    unfold physicalMellinPhase
    fun_prop
  have hκi := physical_mellin_phase_integrable harmonicWindowLogFourier
    (fun u => -2*Real.pi*u) harmonic_window_log_fourier_integrable (by fun_prop) Y
  have ht := integrated_translate_average_square (volume.restrict (Set.Icc a b))
    (volume.restrict {u : ℝ | R < ‖u‖}) (2*Real.pi) hκc hκi.integrableOn hP hM hPM hB
  simpa only [IntegrableOn,norm_mul,physical_mellin_phase_norm,mul_one] using ht

theorem harmonic_normalized_four_box_error_eq_tail {Y : ℝ} (hY : 0 < Y) (s R : ℝ)
    (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c) :
    harmonicNormalizedFourBoxError Y s R D A B C δ α β γ =
      ∫ u in {u : ℝ | R < ‖u‖},
        harmonicWindowLogFourier u * physicalMellinPhase (-2*Real.pi*u) Y *
          ((∑ d ∈ D, δ d * harmonicMellinWeight (s+2*Real.pi*u) d) *
            (∑ a ∈ A, α a * harmonicMellinWeight (s+2*Real.pi*u) a) *
            (∑ b ∈ B, β b * harmonicMellinWeight (s+2*Real.pi*u) b) *
            (∑ c ∈ C, γ c * harmonicMellinWeight (s+2*Real.pi*u) c)) := by
  have hs : MeasurableSet {u : ℝ | ‖u‖ ≤ R} :=
    (isClosed_le continuous_norm continuous_const).measurableSet
  have heq : {u : ℝ | ‖u‖ ≤ R}ᶜ = {u : ℝ | R < ‖u‖} := by ext u; simp
  unfold harmonicNormalizedFourBoxError
  rw [harmonic_normalized_four_box_mellin hY s D A B C δ α β γ hD hA hB hC,
    ← setIntegral_compl hs
      (harmonic_normalized_four_box_integrable Y s D A B C δ α β γ hD hA hB hC), heq]




end Bounty
