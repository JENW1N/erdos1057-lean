section

/- Positive shifted integer supports transport injectively to natural indices. -/

open Finset
namespace Bounty

theorem sum_shift_natAbs (S : Finset ℤ) (δ : ℤ) (F : ℕ → ℝ)
    (hpos : ∀ n ∈ S, 0 ≤ n + δ) :
    (∑ n ∈ S, F (n + δ).natAbs) =
      ∑ m ∈ S.image (fun n => (n + δ).natAbs), F m := by
  rw [sum_image]
  intro a ha b hb hab
  have he := congrArg (fun m : ℕ => (m : ℤ)) hab
  rw [Int.natAbs_of_nonneg (hpos a ha), Int.natAbs_of_nonneg (hpos b hb)] at he
  exact add_right_cancel he

theorem shifted_natAbs_image_bounds (S : Finset ℤ) (δ : ℤ) (N : ℕ)
    (hpos : ∀ n ∈ S, 0 < n + δ ∧ n + δ ≤ (N : ℤ)) :
    ∀ m ∈ S.image (fun n => (n + δ).natAbs), 0 < m ∧ m ≤ N := by
  intro m hm
  obtain ⟨n, hn, rfl⟩ := mem_image.mp hm
  have he : ((n + δ).natAbs : ℤ) = n + δ := Int.natAbs_of_nonneg (hpos n hn).1.le
  constructor
  · exact_mod_cast (show (0 : ℤ) < ((n + δ).natAbs : ℤ) by rw [he]; exact (hpos n hn).1)
  · exact_mod_cast (show ((n + δ).natAbs : ℤ) ≤ N by rw [he]; exact (hpos n hn).2)

