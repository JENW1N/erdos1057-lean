theorem coupled_ghost_cutoff_one_symmetric {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)] [∀ g, DecidableEq (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (t : G → ℕ) (B : ℕ)
    (f : ProductBoundedOrderedState P Z t B → ℂ) (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (coupledGhostCutoffOperator A D C ν t B (fun _ _ => 1) f) := by
  rw [coupled_ghost_cutoff_one_eq_coordinate_action]
  apply product_memory_cutoff_sandwich_symmetric
  · intro g h hh
    exact bounded_ordered_ghost_symmetric (A g) (D g) (C g) (ν g) (t g) B h hh
  · exact hf



