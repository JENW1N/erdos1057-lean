/- A performed parent outside the current owner fiber lies strictly in the past. -/

namespace Bounty

theorem restricted_birth_external_parent_owner_lt {N m L : ℕ}
    (embed : Fin m → Fin N) (hstrict : StrictMono embed)
    (owner : Fin N → Fin L) (hmono : Monotone owner) (u : Fin L)
    (howner : ∀ j, owner (embed j) = u) (performed : Fin N → Prop)
    (hcover : ∀ i, performed i → owner i = u → i ∈ Set.range embed)
    (j : Fin m) (p : Fin (embed j).val)
    (hp : performed (birthForestParentEmbedding (embed j) p))
    (he : ¬ ∃ k : Fin j.val,
      embed (birthForestParentEmbedding j k) = birthForestParentEmbedding (embed j) p) :
    owner (birthForestParentEmbedding (embed j) p) < u := by
  have hle : owner (birthForestParentEmbedding (embed j) p) ≤ u := by
    rw [← howner j]
    exact hmono (show birthForestParentEmbedding (embed j) p ≤ embed j from Nat.le_of_lt p.isLt)
  apply lt_of_le_of_ne hle
  intro hu
  exact restricted_birth_parent_not_in_range embed hstrict j p he (hcover _ hp hu)

theorem restricted_birth_anchors_past_local {N m L : ℕ} {α : Type*}
    (embed : Fin m → Fin N) (hstrict : StrictMono embed)
    (owner : Fin N → Fin L) (hmono : Monotone owner) (u : Fin L)
    (howner : ∀ j, owner (embed j) = u) (performed : Fin N → Prop)
    (hcover : ∀ i, performed i → owner i = u → i ∈ Set.range embed)
    (code : BirthForestCode N)
    (hparents : ∀ j p, code (embed j) = some p → performed (birthForestParentEmbedding (embed j) p))
    (values other : Fin N → α) (hpast : ∀ i, owner i < u → values i = other i) :
    restrictedBirthAnchors embed code values = restrictedBirthAnchors embed code other := by
  funext j
  cases hc : code (embed j) with
  | none => simp only [restrictedBirthAnchors, hc]
  | some p =>
    by_cases he : ∃ k : Fin j.val,
        embed (birthForestParentEmbedding j k) = birthForestParentEmbedding (embed j) p
    · simp only [restrictedBirthAnchors, hc, if_pos he]
    · simp only [restrictedBirthAnchors, hc, if_neg he]
      congr 1
      exact hpast _ (restricted_birth_external_parent_owner_lt embed hstrict owner hmono u howner
        performed hcover j p (hparents j p hc) he)










end Bounty
