open Finset Classical
section

variable
  {G I : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (V : G → ℝ)
  (patterns : Finset I)
  (C : I → G → Finset (Fin J))

include G I sharedInstance1 sharedInstance2 P J ell V patterns C

theorem physical_free_action_zero_of_invalid  (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (terminal : ℤ → PhysicalMarkLists P J ell → ℂ) (r : ℕ) (n : ℤ)
    (L : PhysicalMarkLists P J ell) (h : ¬ ∀ g s, ((L g s).val : ℤ) ∣ n) :
    physicalBareFreeAction V patterns C q ζ k K terminal (r + 1) n L = 0 := by
  unfold physicalBareFreeAction
  rw [translatedPathAction]
  apply sum_eq_zero
  intro a _
  apply sum_eq_zero
  intro R _
  simp only [physicalBareKernel, physicalVertexWeight, if_neg h,
    zero_mul, Complex.ofReal_zero, mul_zero]

/- The unnormalized root moment sums all admissible initial lists.
After reindexing, all bare initial lists may be used with zero weights for
the inadmissible ones. -/
theorem physical_initial_return_sum_eq_free  {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (starts : Finset ℤ) (r b : ℕ)
    (hbound : ∀ j < r + 1, physicalOperatorStepBound P J ell patterns C (k j) ≤ b)
    (n : ℤ) (hn : n ∈ starts) :
    (∑ L : PhysicalMarksAt P J ell n,
      finiteCutoffAction (physicalCutoff P J ell (reachablePositions starts ((r + 1) * b)))
        (fun j a b => physicalSymmetricKernel (fun s t => ∑ i ∈ patterns,
          physicalPatternKernel V (C i) q (ζ j i) (k j i) (K j i) s t) a b)
        (fun a => if a.1 = n then 1 else 0) (r + 1) ⟨n, L⟩) =
      ∑ L : PhysicalMarkLists P J ell, physicalBareFreeAction V patterns C q ζ k K
        (fun m _ => if m = n then 1 else 0) (r + 1) n L := by
  calc
    _ = ∑ L : PhysicalMarksAt P J ell n, physicalBareFreeAction V patterns C q ζ k K
        (fun m _ => if m = n then 1 else 0) (r + 1) n L.val := by
      apply sum_congr rfl
      intro L _
      exact physical_reachable_action_eq_free V patterns C hq ζ k K starts
        (fun m _ => if m = n then 1 else 0) (r + 1) b hbound ⟨n, L⟩ hn
    _ = _ := by
      apply physical_marks_sum_all P J ell n
      intro L h
      exact physical_free_action_zero_of_invalid V patterns C q ζ k K _ r n L h

end

end

section
open Finset Classical
noncomputable def physicalFiniteReturnScalar {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (r : ℕ) (L : PhysicalMarkLists P J ell)
    (p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) : ℂ :=
  physicalBareReturnScalar V patterns C ζ k K (finitePathLabels p) (finitePathMarks L p) (r + 1)

noncomputable def physicalFiniteVertexProduct {G I : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} {patterns : Finset I}
    (C : I → G → Finset (Fin J)) (q : ℝ) (k : ℕ → I → ℤ)
    (r : ℕ) (L : PhysicalMarkLists P J ell)
    (p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) (n : ℤ) : ℝ :=
  ∏ j ∈ range (r + 2), physicalVertexWeight (finitePathMarks L p j)
    (physicalEndpointSchedule q (r + 1) j)
    (n + physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p) (r + 1) j)

theorem physical_free_return_factor_sum {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (r : ℕ) (n : ℤ) (L : PhysicalMarkLists P J ell) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    physicalBareFreeAction V patterns C q ζ k K
      (fun m _ => if m = n then 1 else 0) (r + 1) n L =
      ∑ p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
        physicalFiniteReturnScalar V patterns C ζ k K r L p *
          (physicalFiniteVertexProduct C q k r L p n : ℂ) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  rw [← physical_free_path_expansion]
  apply sum_congr rfl
  intro p _
  exact physical_return_finite_path_factor V patterns C hq ζ k K r L p n
end

section
open Finset Classical
theorem complex_average_finite_sum {A X : Type*} (roots : Finset X) (terms : Finset A)
    (c : A → ℂ) (w : A → X → ℝ) (denominator : ℝ) :
    ((∑ n ∈ roots, ∑ a ∈ terms, c a * (w a n : ℂ)) / (denominator : ℂ)) =
      ∑ a ∈ terms, c a * (((∑ n ∈ roots, w a n) / denominator : ℝ) : ℂ) := by
  rw [sum_comm, sum_div]
  apply sum_congr rfl
  intro a _
  simp only [Complex.ofReal_div, Complex.ofReal_sum]
  rw [← mul_sum, mul_div_assoc]

noncomputable def physicalRootMoment {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (starts : Finset ℤ) (r b : ℕ) : ℂ :=
  (physicalStateMass V J ell : ℂ) *
    (∑ n ∈ starts, ∑ L : PhysicalMarksAt P J ell n,
      finiteCutoffAction (physicalCutoff P J ell (reachablePositions starts ((r + 1) * b)))
        (fun j a b => physicalSymmetricKernel (fun s t => ∑ i ∈ patterns,
          physicalPatternKernel V (C i) q (ζ j i) (k j i) (K j i) s t) a b)
        (fun a => if a.1 = n then 1 else 0) (r + 1) ⟨n, L⟩) / (starts.card : ℂ)

/- This is an identity for the actual physical root moment, not an
assumption about a proposed path expansion. -/
theorem physical_root_moment_as_vertex_averages {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (starts : Finset ℤ) (r b : ℕ)
    (hbound : ∀ j < r + 1, physicalOperatorStepBound P J ell patterns C (k j) ≤ b) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    physicalRootMoment V patterns C q ζ k K starts r b =
      (physicalStateMass V J ell : ℂ) *
        ∑ L : PhysicalMarkLists P J ell,
          ∑ p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
            physicalFiniteReturnScalar V patterns C ζ k K r L p *
              (((∑ n ∈ starts, physicalFiniteVertexProduct C q k r L p n) /
                (starts.card : ℝ) : ℝ) : ℂ) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  unfold physicalRootMoment
  rw [mul_div_assoc]
  congr 1
  have he : (∑ n ∈ starts, ∑ L : PhysicalMarksAt P J ell n,
      finiteCutoffAction (physicalCutoff P J ell (reachablePositions starts ((r + 1) * b)))
        (fun j a b => physicalSymmetricKernel (fun s t => ∑ i ∈ patterns,
          physicalPatternKernel V (C i) q (ζ j i) (k j i) (K j i) s t) a b)
        (fun a => if a.1 = n then 1 else 0) (r + 1) ⟨n, L⟩) =
      ∑ n ∈ starts, ∑ L : PhysicalMarkLists P J ell,
        ∑ p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
          physicalFiniteReturnScalar V patterns C ζ k K r L p *
            (physicalFiniteVertexProduct C q k r L p n : ℂ) := by
    apply sum_congr rfl
    intro n hn
    rw [physical_initial_return_sum_eq_free V patterns C hq ζ k K starts r b hbound n hn]
    apply sum_congr rfl
    intro L _
    exact physical_free_return_factor_sum V patterns C hq ζ k K r n L
  rw [he, sum_comm, sum_div]
  apply sum_congr rfl
  intro L _
  exact complex_average_finite_sum starts univ (physicalFiniteReturnScalar V patterns C ζ k K r L)
    (physicalFiniteVertexProduct C q k r L) (starts.card : ℝ)
end

section
open Finset Classical
noncomputable def physicalFiniteVertexExpectation {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ} {patterns : Finset I}
    (C : I → G → Finset (Fin J)) (q : ℝ) (k : ℕ → I → ℤ)
    (r : ℕ) (L : PhysicalMarkLists P J ell)
    (p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) : ℝ :=
  poolPathResidueExpectation (fun v : PhysicalPrime P => v.2.val) univ (range (r + 2))
    (fun v => (range (r + 2)).filter (fun j => v ∈ physicalMarkedPrimes (finitePathMarks L p j)))
    (fun v j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p)
      (r + 1) j : ZMod v.2.val))
    (fun j => 1 - physicalEndpointSchedule q (r + 1) j)

noncomputable def physicalRootResidueModel {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : G → ℝ) (patterns : Finset I) (C : I → G → Finset (Fin J))
    (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (r : ℕ) : ℂ := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  exact (physicalStateMass V J ell : ℂ) *
    ∑ L : PhysicalMarkLists P J ell,
      ∑ p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
        physicalFiniteReturnScalar V patterns C ζ k K r L p *
          (physicalFiniteVertexExpectation C q k r L p : ℂ)

theorem complex_double_path_error_bound {A B : Type*} [Fintype A] [Fintype B]
    (c : A → B → ℂ) (actual expected : A → B → ℝ) (ε : ℝ)
    (h : ∀ a b, |actual a b - expected a b| ≤ ε * expected a b) :
    ‖(∑ a, ∑ b, c a b * (actual a b : ℂ)) - ∑ a, ∑ b, c a b * (expected a b : ℂ)‖ ≤
      ε * ∑ a, ∑ b, ‖c a b‖ * expected a b := by
  simpa only [Fintype.sum_prod_type] using complex_path_error_bound (univ : Finset (A × B))
    (fun p => c p.1 p.2) (fun p => actual p.1 p.2) (fun p => expected p.1 p.2) ε
    (fun p _ => h p.1 p.2)

/- The per-path relative replacement controls the actual root moment,
with the exact expected absolute path mass as its only multiplicative loss. -/
theorem physical_root_replacement_error {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : G → ℝ) (hV : ∀ g, 0 < V g) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (starts : Finset ℤ) (r b : ℕ)
    (hbound : ∀ j < r + 1, physicalOperatorStepBound P J ell patterns C (k j) ≤ b) (ε : ℝ)
    (herror : ∀ (L : PhysicalMarkLists P J ell)
      (p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell),
      |(∑ n ∈ starts, physicalFiniteVertexProduct C q k r L p n) / (starts.card : ℝ) -
        physicalFiniteVertexExpectation C q k r L p| ≤ ε * physicalFiniteVertexExpectation C q k r L p) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    ‖physicalRootMoment V patterns C q ζ k K starts r b -
      physicalRootResidueModel V patterns C q ζ k K r‖ ≤
      ε * (physicalStateMass V J ell *
        ∑ L : PhysicalMarkLists P J ell,
          ∑ p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
            ‖physicalFiniteReturnScalar V patterns C ζ k K r L p‖ *
              physicalFiniteVertexExpectation C q k r L p) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  rw [physical_root_moment_as_vertex_averages V patterns C hq ζ k K starts r b hbound]
  unfold physicalRootResidueModel
  rw [← mul_sub, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (physical_state_mass_pos V hV J ell).le]
  have h := complex_double_path_error_bound (physicalFiniteReturnScalar V patterns C ζ k K r)
    (fun L p => (∑ n ∈ starts, physicalFiniteVertexProduct C q k r L p n) / (starts.card : ℝ))
    (physicalFiniteVertexExpectation C q k r) ε herror
  exact (mul_le_mul_of_nonneg_left h (physical_state_mass_pos V hV J ell).le).trans_eq (by ring)
end

section
open Filter Finset
theorem eventually_physical_finite_vertex_replacement {a c d C V E γ : ℝ}
    (ha : 0 ≤ a) (hc : 0 < c) (hd : 0 < d) (had : a + d < 1)
    (hC : 0 < C) (hV : 0 < V) (hE : 0 ≤ E) (hγ : 0 < γ) (J ell : ℕ) :
    ∀ᶠ T : ℝ in atTop, ∀ (G : Type) [Fintype G] [DecidableEq G]
      (P : G → Finset ℕ) [∀ p : PhysicalPrime P, NeZero p.2.val]
      (I : Type) (patterns : Finset I) (pattern : I → G → Finset (Fin J))
      (k : ℕ → I → ℤ) (r : ℕ), r + 1 = 2 * Nat.ceil (T^a) →
      ∀ (L : PhysicalMarkLists P J ell)
        (p : Fin (r + 1) → PhysicalEdgeLabels P J ell patterns pattern × PhysicalMarkLists P J ell)
        (q : ℝ) (N : ℕ) (z : ℤ),
      Pairwise (fun g h => Disjoint (P g) (P h)) →
      (∀ g p, p ∈ P g → p.Prime) →
      (Fintype.card G : ℝ) ≤ C * Real.log T →
      (∀ g, (∑ p ∈ P g, 1 / (p : ℝ)) ≤ V) →
      (∀ g p, p ∈ P g → Real.exp (T^c) ≤ (p : ℝ)) →
      (∀ g p, p ∈ P g → (p : ℝ) ≤ Real.exp (T^d)) →
      0 ≤ q → q ≤ 1 → 0 < N → γ * T ≤ Real.log (N : ℝ) →
      |(∑ n ∈ Ico z (z + N), physicalFiniteVertexProduct pattern q k r L p n) / (N : ℝ) -
        physicalFiniteVertexExpectation pattern q k r L p| ≤
        Real.exp (-E * (r + 1) * Real.log T) * physicalFiniteVertexExpectation pattern q k r L p := by
  filter_upwards [eventually_physical_vertex_replacement ha hc hd had hC hV hE hγ J ell] with T hT
  intro G _ _ P _ I patterns pattern k r hlen L p q N z hdis hprime hs hH hmin hmax hq0 hq1 hN hNb
  have hh := hT G P (finitePathMarks L p)
    (physicalBareOffset pattern k (finitePathLabels p) (finitePathMarks L p) (r + 1))
    (physicalEndpointSchedule q (r + 1)) N z
  dsimp only at hh
  rw [← hlen] at hh
  simpa only [physicalFiniteVertexProduct, physicalFiniteVertexExpectation, Nat.cast_add, Nat.cast_one] using
    hh hdis hprime hs hH hmin hmax
      (fun j _ => physical_endpoint_schedule_unit hq0 hq1 (r + 1) j) hN hNb
end

section

/- A nonzero integer whose absolute value is smaller than `p` is not
divisible by `p`. No primality assumption is needed. -/
theorem nat_not_dvd_int_of_natAbs_lt {p : ℕ} {k : ℤ}
    (hkpos : 0 < k.natAbs) (hklt : k.natAbs < p) : ¬ (p : ℤ) ∣ k := by
  intro h
  exact (not_le_of_gt hklt) (Nat.le_of_dvd hkpos (Int.natCast_dvd.mp h))

/- If a prime divides both endpoints of a dilation step and does not divide
the step coefficient, it divides the natural-number dilation factor. -/
theorem nat_prime_dvd_dilation_of_dvd_endpoints {p D : ℕ} {n k : ℤ}
    (hp : Nat.Prime p) (hk : ¬ (p : ℤ) ∣ k)
    (hn : (p : ℤ) ∣ n) (htarget : (p : ℤ) ∣ n + k * (D : ℤ)) : p ∣ D := by
  have hproduct : (p : ℤ) ∣ k * (D : ℤ) := by
    simpa only [add_sub_cancel_left] using dvd_sub htarget hn
  exact Int.natCast_dvd_natCast.mp
    (((Nat.prime_iff_prime_int.mp hp).dvd_or_dvd hproduct).resolve_left hk)




section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (C : G → Finset (Fin J))
  (aux : PhysicalAuxLabels P C)
  (k : ℤ)
  {x y : PhysicalState P J ell}
  (hadm : physicalAdmissible C aux k x y)

include G sharedInstance1 P J ell C aux k x y hadm

/- A prime marked at both endpoints divides the dilation, provided it does
not divide the step coefficient. The two marks may have different groups
and slots. -/
theorem physical_common_mark_dvd_D_of_prime 
    (g h : G) (s t : PhysicalSlots J ell)
    (heq : (x.2.val g s).val = (y.2.val h t).val)
    (hp : Nat.Prime (x.2.val g s).val)
    (hk : ¬ ((x.2.val g s).val : ℤ) ∣ k) :
    (x.2.val g s).val ∣ physicalD C x.2.val aux := by
  apply nat_prime_dvd_dilation_of_dvd_endpoints hp hk (x.2.property g s)
  rw [← hadm.2.2.2, heq]
  exact y.2.property h t

/- The common-mark criterion for prime pools. -/
theorem physical_common_mark_dvd_D 
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (g h : G) (s t : PhysicalSlots J ell)
    (heq : (x.2.val g s).val = (y.2.val h t).val)
    (hk : ¬ ((x.2.val g s).val : ℤ) ∣ k) :
    (x.2.val g s).val ∣ physicalD C x.2.val aux :=
  physical_common_mark_dvd_D_of_prime C aux k hadm g h s t heq
    (hP g _ (x.2.val g s).property) hk

end




end

section
open Finset
theorem physical_mem_shared_slots_iff {J ell : ℕ} (C : Finset (Fin J))
    (s : PhysicalSlots J ell) :
    s ∈ physicalSharedSlots C ↔ ∃ j : Fin J, j ∉ C ∧ s = Sum.inl j := by
  simp only [physicalSharedSlots, mem_map, mem_sdiff, mem_univ, true_and]
  constructor
  · rintro ⟨j, hj, he⟩
    exact ⟨j, hj, he.symm⟩
  · rintro ⟨j, hj, he⟩
    exact ⟨j, hj, he.symm⟩

/- Every prime divisor of the dilation is a shared label or a sampled
auxiliary label. The auxiliary labels need not be distinct. -/
theorem physical_prime_dvd_D_iff {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p) {p : ℕ} (hp : Nat.Prime p) :
    p ∣ physicalD C labels aux ↔
      (∃ g j, j ∉ C g ∧ p = (labels g (Sum.inl j)).val) ∨
      (∃ (g : G) (j : C g), p = (aux g j).val) := by
  classical
  constructor
  · intro hd
    obtain ⟨g, _, hg⟩ := (hp.prime.dvd_finsetProd_iff _).mp hd
    rcases hp.dvd_mul.mp hg with hs | ha
    · obtain ⟨j, hj, hjp⟩ := (hp.prime.dvd_finsetProd_iff _).mp hs
      exact Or.inl ⟨g, j, (mem_sdiff.mp hj).2,
        ((Nat.dvd_prime (hP g _ (labels g (Sum.inl j)).property)).mp hjp).resolve_left
          hp.ne_one⟩
    · obtain ⟨j, _, hjp⟩ := (hp.prime.dvd_finsetProd_iff _).mp ha
      exact Or.inr ⟨g, j,
        ((Nat.dvd_prime (hP g _ (aux g j).property)).mp hjp).resolve_left hp.ne_one⟩
  · rintro (⟨g, j, hj, rfl⟩ | ⟨g, j, rfl⟩)
    · exact physical_shared_label_dvd_D C labels aux g j hj
    · apply dvd_trans _ (dvd_prod_of_mem (fun g => physicalGroupD C labels aux g) (mem_univ g))
      exact dvd_mul_of_dvd_right
        (dvd_prod_of_mem (fun j : C g => (aux g j).val) (mem_univ j)) _

/- Equality of values of endpoint labels in disjoint groups determines
the group, even when the two mark lists differ. -/
theorem physical_mark_value_eq_group {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (src tgt : PhysicalMarkLists P J ell)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    {g h : G} {s t : PhysicalSlots J ell}
    (he : (src g s).val = (tgt h t).val) : g = h := by
  by_contra hne
  apply disjoint_left.mp (hdis hne) (src g s).property
  rw [he]
  exact (tgt h t).property

/- For an endpoint satisfying the auxiliary ban, the marked primes
dividing the dilation are precisely its prescribed shared slots. -/
theorem physical_mark_dvd_D_iff_shared {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (havoid : physicalAuxAvoids C aux labels) (g : G) (s : PhysicalSlots J ell) :
    (labels g s).val ∣ physicalD C labels aux ↔ s ∈ physicalSharedSlots (C g) := by
  classical
  rw [physical_mem_shared_slots_iff]
  constructor
  · intro hd
    rcases (physical_prime_dvd_D_iff C labels aux hP
      (hP g _ (labels g s).property)).mp hd with ⟨h, j, hj, he⟩ | ⟨h, j, he⟩
    · have hgh : g = h := physical_mark_value_eq_group labels labels hdis he
      subst h
      exact ⟨j, hj, (labels g).injective (Subtype.ext he)⟩
    · exact False.elim (((physical_aux_avoids_global_iff C aux labels hdis).mp havoid)
        h j g s he.symm)
  · rintro ⟨j, hj, rfl⟩
    exact physical_shared_label_dvd_D C labels aux g j hj




/- A prime marked at both endpoints must occupy the same prescribed
shared slot, provided the prime does not divide the step coefficient. -/
theorem physical_common_mark_shared {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g h : G) (s t : PhysicalSlots J ell)
    (he : (x.2.val g s).val = (y.2.val h t).val)
    (hk : ¬ ((x.2.val g s).val : ℤ) ∣ k) :
    g = h ∧ s = t ∧ s ∈ physicalSharedSlots (C g) := by
  have hd := physical_common_mark_dvd_D C aux k hadm hP g h s t he hk
  have hs := (physical_mark_dvd_D_iff_shared C x.2.val aux hP hdis hadm.2.1 g s).mp hd
  have hgh : g = h := physical_mark_value_eq_group x.2.val y.2.val hdis he
  subst h
  obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff (C g) s).mp hs
  have hcopy := hadm.1 g j hj
  have hst : Sum.inl j = t := (y.2.val g).injective (by rw [← hcopy]; exact Subtype.ext he)
  exact ⟨rfl, hst, hs⟩

/- An unshared source mark cannot divide the dilation. -/
theorem physical_unshared_mark_not_dvd_D {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (havoid : physicalAuxAvoids C aux labels) (g : G) (s : PhysicalSlots J ell)
    (hs : s ∈ physicalUnsharedSlots (C g)) :
    ¬ (labels g s).val ∣ physicalD C labels aux := by
  intro hd
  exact (mem_compl.mp hs)
    ((physical_mark_dvd_D_iff_shared C labels aux hP hdis havoid g s).mp hd)









end

section
open Finset
open scoped Classical
/- The tagged primes occupying the prescribed shared slots. -/
def physicalSharedPrimes {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) : Finset (PhysicalPrime P) :=
  (univ.filter (fun a : Σ _g : G, PhysicalSlots J ell =>
    a.2 ∈ physicalSharedSlots (C a.1))).map (physicalMarkInjection labels)

/- Membership in the tagged shared set is witnessed by a shared slot in
the tag's own group. -/
theorem mem_physical_shared_primes {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (p : PhysicalPrime P) :
    p ∈ physicalSharedPrimes C labels ↔
      ∃ s, s ∈ physicalSharedSlots (C p.1) ∧ (labels p.1 s).val = p.2.val := by
  rcases p with ⟨g, p⟩
  constructor
  · intro hp
    obtain ⟨⟨h, s⟩, hs, he⟩ := mem_map.mp hp
    change (⟨h, labels h s⟩ : PhysicalPrime P) = ⟨g, p⟩ at he
    have hg : h = g := congrArg Sigma.fst he
    cases hg
    exact ⟨s, (mem_filter.mp hs).2,
      congrArg Subtype.val (eq_of_heq (Sigma.mk.inj_iff.mp he).2)⟩
  · rintro ⟨s, hs, he⟩
    apply mem_map.mpr
    refine ⟨⟨g, s⟩, mem_filter.mpr ⟨mem_univ _, hs⟩, ?_⟩
    change (⟨g, labels g s⟩ : PhysicalPrime P) = ⟨g, p⟩
    exact congrArg (Sigma.mk g) (Subtype.ext he)

/- Every tagged shared prime is marked. -/
theorem physical_shared_primes_subset_marked {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) :
    physicalSharedPrimes C labels ⊆ physicalMarkedPrimes labels := by
  intro p hp
  obtain ⟨s, _, he⟩ := (mem_physical_shared_primes C labels p).mp hp
  rw [mem_physical_marked_primes, mem_physical_group_marks]
  exact ⟨s, he⟩

/- Compatible endpoint lists have the same tagged shared primes. -/
theorem physical_shared_primes_eq_of_compatible {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    {src tgt : PhysicalMarkLists P J ell}
    (hshared : physicalSharedCompatible C src tgt) :
    physicalSharedPrimes C src = physicalSharedPrimes C tgt := by
  have forward : ∀ (a b : PhysicalMarkLists P J ell),
      physicalSharedCompatible C a b →
      physicalSharedPrimes C a ⊆ physicalSharedPrimes C b := by
    intro a b hab p hp
    obtain ⟨s, hs, he⟩ := (mem_physical_shared_primes C a p).mp hp
    obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff (C p.1) s).mp hs
    apply (mem_physical_shared_primes C b p).mpr
    exact ⟨Sum.inl j, hs, (congrArg Subtype.val (hab p.1 j hj)).symm.trans he⟩
  exact Subset.antisymm (forward src tgt hshared)
    (forward tgt src (physical_shared_compatible_symm C hshared))









end

section
open Finset
/- The natural prime values in the shared slots of one group. -/
def physicalGroupSharedPrimes {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (g : G) : Finset ℕ :=
  (physicalSharedSlots (C g)).map (physicalGroupMarkEmbedding labels g)

theorem mem_physical_group_shared_primes {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (g : G) (p : ℕ) :
    p ∈ physicalGroupSharedPrimes C labels g ↔
      ∃ s, s ∈ physicalSharedSlots (C g) ∧ (labels g s).val = p := by
  simp only [physicalGroupSharedPrimes, mem_map]
  rfl

/- Injectivity of each group's mark list preserves the shared-slot count. -/
theorem physical_group_shared_primes_card {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (g : G) :
    (physicalGroupSharedPrimes C labels g).card = J - (C g).card := by
  simp only [physicalGroupSharedPrimes, card_map, physical_shared_slots_card]

/- The groupwise primes common to both endpoints are exactly the shared
source primes. Nondivisibility is needed only for this source group. -/
theorem physical_group_marks_inter_eq_shared {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
    (hk : ∀ s, ¬ ((x.2.val g s).val : ℤ) ∣ k) :
    physicalGroupMarks x.2.val g ∩ physicalGroupMarks y.2.val g =
      physicalGroupSharedPrimes C x.2.val g := by
  ext p
  rw [mem_inter, mem_physical_group_marks, mem_physical_group_marks,
    mem_physical_group_shared_primes]
  constructor
  · rintro ⟨⟨s, hs⟩, ⟨t, ht⟩⟩
    have hcommon := physical_common_mark_shared C aux k hadm hP hdis
      g g s t (hs.trans ht.symm) (hk s)
    exact ⟨s, hcommon.2.2, hs⟩
  · rintro ⟨s, hs, he⟩
    obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff (C g) s).mp hs
    exact ⟨⟨Sum.inl j, he⟩,
      ⟨Sum.inl j, (congrArg Subtype.val (hadm.1 g j hj)).symm.trans he⟩⟩

/- Exactly the unshared-slot count of new primes appears at the target. -/
theorem physical_group_new_marks_card {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (hadm : physicalAdmissible C aux k x y)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (g : G)
    (hk : ∀ s, ¬ ((x.2.val g s).val : ℤ) ∣ k) :
    (physicalGroupMarks y.2.val g \ physicalGroupMarks x.2.val g).card =
      ell + (C g).card := by
  rw [card_sdiff, physical_group_marks_inter_eq_shared C aux k hadm hP hdis g hk,
    physical_group_marks_card, physical_group_shared_primes_card]
  have hc : (C g).card ≤ J := by
    simpa only [Fintype.card_fin] using card_le_univ (C g)
  omega







/- Permuting slots leaves the set of marked prime values unchanged. -/
theorem physical_group_marks_permute {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ}
    (σ : PhysicalPermutations G J ell) (labels : PhysicalMarkLists P J ell) (g : G) :
    physicalGroupMarks (physicalPermuteLabels σ labels) g = physicalGroupMarks labels g := by
  ext p
  rw [mem_physical_group_marks, mem_physical_group_marks]
  constructor
  · rintro ⟨s, hs⟩
    exact ⟨σ g s, hs⟩
  · rintro ⟨s, hs⟩
    refine ⟨(σ g).symm s, ?_⟩
    simpa only [physicalPermuteLabels, Function.Embedding.trans_apply,
      Equiv.toEmbedding_apply, Equiv.apply_symm_apply] using hs
end

section
open Finset
section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (C : G → Finset (Fin J))
  (aux : PhysicalAuxLabels P C)
  (k : ℤ)
  (L R : PhysicalMarkLists P J ell)
  (hlist : physicalListAdmissible C aux L R)
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))

include G sharedInstance1 P J ell C aux k L R hlist hP hdis

/- A common prime of two structurally compatible lists occupies the same
shared slot when it divides the step but does not divide its coefficient. -/
theorem physical_bare_common_mark_shared 
    (g : G) (s t : PhysicalSlots J ell)
    (he : (L g s).val = (R g t).val)
    (hstep : ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ))
    (hk : ¬ ((L g s).val : ℤ) ∣ k) :
    s = t ∧ s ∈ physicalSharedSlots (C g) := by
  have hp := hP g _ (L g s).property
  have hd : (L g s).val ∣ physicalD C L aux :=
    Int.natCast_dvd_natCast.mp
      (((Nat.prime_iff_prime_int.mp hp).dvd_or_dvd hstep).resolve_left hk)
  have hs := (physical_mark_dvd_D_iff_shared C L aux hP hdis hlist.2.1 g s).mp hd
  obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff (C g) s).mp hs
  have hcopy := hlist.1 g j hj
  have hst : Sum.inl j = t := (R g).injective (by
    rw [← hcopy]
    exact Subtype.ext he)
  exact ⟨hst, hs⟩

/- The common prime values of a bare edge are exactly its shared source
values, assuming divisibility compatibility for each common mark. -/
theorem physical_bare_group_marks_inter_eq_shared 
    (hcompat : ∀ g s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ))
    (g : G) (hk : ∀ s, ¬ ((L g s).val : ℤ) ∣ k) :
    physicalGroupMarks L g ∩ physicalGroupMarks R g = physicalGroupSharedPrimes C L g := by
  ext p
  rw [mem_inter, mem_physical_group_marks, mem_physical_group_marks,
    mem_physical_group_shared_primes]
  constructor
  · rintro ⟨⟨s, hs⟩, ⟨t, ht⟩⟩
    have he := hs.trans ht.symm
    exact ⟨s, (physical_bare_common_mark_shared C aux k L R hlist hP hdis
      g s t he (hcompat g s t he) (hk s)).2, hs⟩
  · rintro ⟨s, hs, he⟩
    obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff (C g) s).mp hs
    exact ⟨⟨Sum.inl j, he⟩,
      ⟨Sum.inl j, (congrArg Subtype.val (hlist.1 g j hj)).symm.trans he⟩⟩

/- The new-prime count of a compatible bare edge. -/
theorem physical_bare_group_new_marks_card 
    (hcompat : ∀ g s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ))
    (g : G) (hk : ∀ s, ¬ ((L g s).val : ℤ) ∣ k) :
    (physicalGroupMarks R g \ physicalGroupMarks L g).card = ell + (C g).card := by
  rw [card_sdiff,
    physical_bare_group_marks_inter_eq_shared C aux k L R hlist hP hdis hcompat g hk,
    physical_group_marks_card, physical_group_shared_primes_card]
  have hc : (C g).card ≤ J := by
    simpa only [Fintype.card_fin] using card_le_univ (C g)
  omega

end





/- If the same tagged residue satisfies the marked constraints at two
offsets, the common prime divides the difference of the offsets. -/
theorem physical_common_mark_step_dvd_of_residues {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (L R : PhysicalMarkLists P J ell)
    (ρ : ∀ p : PhysicalPrime P, ZMod p.2.val) (a step : ℤ)
    (hL : ∀ p ∈ physicalMarkedPrimes L, ρ p = -(a : ZMod p.2.val))
    (hR : ∀ p ∈ physicalMarkedPrimes R, ρ p = -((a + step : ℤ) : ZMod p.2.val))
    (g : G) (s t : PhysicalSlots J ell) (he : (L g s).val = (R g t).val) :
    ((L g s).val : ℤ) ∣ step := by
  let p : PhysicalPrime P := ⟨g, L g s⟩
  have hpL : p ∈ physicalMarkedPrimes L := by
    rw [mem_physical_marked_primes, mem_physical_group_marks]
    exact ⟨s, rfl⟩
  have hpR : p ∈ physicalMarkedPrimes R := by
    rw [mem_physical_marked_primes, mem_physical_group_marks]
    exact ⟨t, he.symm⟩
  have hcast : (a : ZMod p.2.val) = ((a + step : ℤ) : ZMod p.2.val) :=
    neg_injective ((hL p hpL).symm.trans (hR p hpR))
  have hd := (ZMod.intCast_eq_intCast_iff_dvd_sub a (a + step) p.2.val).mp hcast
  simpa only [add_sub_cancel_left] using hd

/- Mark constraints in an independent residue tuple supply exactly the
bare-edge compatibility hypothesis used in the new-prime count. -/
theorem physical_bare_step_compatibility_of_residues {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (L R : PhysicalMarkLists P J ell)
    (ρ : ∀ p : PhysicalPrime P, ZMod p.2.val) (a : ℤ)
    (hL : ∀ p ∈ physicalMarkedPrimes L, ρ p = -(a : ZMod p.2.val))
    (hR : ∀ p ∈ physicalMarkedPrimes R,
      ρ p = -((a + k * (physicalD C L aux : ℤ) : ℤ) : ZMod p.2.val)) :
    ∀ g s t, (L g s).val = (R g t).val →
      ((L g s).val : ℤ) ∣ k * (physicalD C L aux : ℤ) :=
  physical_common_mark_step_dvd_of_residues L R ρ a
    (k * (physicalD C L aux : ℤ)) hL hR
end

section
open Finset
/- Number of active runs of a label during `edges + 1` visits. -/
def activeRunCount {α : Type*} [DecidableEq α]
    (A : ℕ → Finset α) (edges : ℕ) (p : α) : ℕ :=
  (if p ∈ A 0 then 1 else 0) +
    ∑ j ∈ range edges, if p ∈ A (j + 1) \ A j then 1 else 0

/- Summing the membership indicator over an ambient pool gives the subset's
cardinality. -/
theorem sum_mem_indicator_of_subset {α : Type*} [DecidableEq α]
    (pool s : Finset α) (hs : s ⊆ pool) :
    (∑ p ∈ pool, if p ∈ s then (1 : ℕ) else 0) = s.card := by
  rw [← sum_filter]
  have he : pool.filter (fun p => p ∈ s) = s := by
    ext p
    simp only [mem_filter]
    exact ⟨fun h => h.2, fun h => ⟨hs h, h⟩⟩
  simp only [he, sum_const, smul_eq_mul, mul_one]

/- Total run count equals initial cardinality plus all subsequent entries. -/
theorem sum_activeRunCount {α : Type*} [DecidableEq α]
    (pool : Finset α) (A : ℕ → Finset α) (edges : ℕ)
    (hA : ∀ j ≤ edges, A j ⊆ pool) :
    (∑ p ∈ pool, activeRunCount A edges p) =
      (A 0).card + ∑ j ∈ range edges, (A (j + 1) \ A j).card := by
  simp only [activeRunCount, sum_add_distrib]
  rw [sum_mem_indicator_of_subset pool (A 0) (hA 0 (Nat.zero_le edges)), sum_comm]
  congr 1
  apply sum_congr rfl
  intro j hj
  apply sum_mem_indicator_of_subset
  exact subset_trans sdiff_subset (hA (j + 1) (by simpa using mem_range.mp hj))



end

section
open Finset
/- The state and completion measures collect into one inverse harmonic
mass per initial mark and per newly introduced mark. -/
theorem physical_path_mass_grouped {G : Type*} [Fintype G] {J : ℕ}
    (V : G → ℝ) (C : ℕ → G → Finset (Fin J)) (ell edges : ℕ) :
    physicalStateMass V J ell *
      (∏ j ∈ range edges, physicalCompletionMass V (C j) ell) =
    ∏ g, (1 / V g) ^ ((J + ell) + ∑ j ∈ range edges, (ell + (C j g).card)) := by
  unfold physicalStateMass physicalCompletionMass
  simp only [one_div, ← inv_pow]
  rw [prod_comm (s := range edges) (t := univ), ← prod_mul_distrib]
  apply prod_congr rfl
  intro g hg
  rw [prod_pow_eq_pow_sum, ← pow_add]




/- Sum of the run counts in a group, using the exact number of new marks
on every edge. -/
theorem physical_group_run_count {G : Type*}
    {P : G → Finset ℕ} {J ell : ℕ}
    (L : ℕ → PhysicalMarkLists P J ell) (C : ℕ → G → Finset (Fin J))
    (edges : ℕ) (g : G)
    (hnew : ∀ j < edges,
      (physicalGroupMarks (L (j + 1)) g \ physicalGroupMarks (L j) g).card =
        ell + (C j g).card) :
    (∑ p ∈ P g, activeRunCount (fun j => physicalGroupMarks (L j) g) edges p) =
      (J + ell) + ∑ j ∈ range edges, (ell + (C j g).card) := by
  rw [sum_activeRunCount (P g) _ edges
    (fun j _ => physical_group_marks_subset (L j) g), physical_group_marks_card]
  congr 1
  apply sum_congr rfl
  intro j hj
  exact hnew j (mem_range.mp hj)









end

section
open scoped BigOperators
open MeasureTheory
/- Fourier phase attached to an integer displacement. -/
noncomputable def physicalReturnPhase (θ : ℝ) (h : ℤ) : ℂ :=
  Complex.exp (2 * (Real.pi : ℂ) * Complex.I * (θ : ℂ) * (h : ℂ))

theorem physicalReturnPhase_zero (θ : ℝ) :
    physicalReturnPhase θ 0 = 1 := by
  simp [physicalReturnPhase]

theorem physicalReturnPhase_add (θ : ℝ) (h k : ℤ) :
    physicalReturnPhase θ (h + k) = physicalReturnPhase θ h * physicalReturnPhase θ k := by
  simp only [physicalReturnPhase, Int.cast_add, mul_add, Complex.exp_add]

theorem physicalReturnPhase_continuous (h : ℤ) :
    Continuous (fun θ : ℝ => physicalReturnPhase θ h) := by
  unfold physicalReturnPhase
  fun_prop

theorem physicalReturnPhase_intervalIntegrable (h : ℤ) (a b : ℝ) :
    IntervalIntegrable (fun θ : ℝ => physicalReturnPhase θ h) volume a b :=
  (physicalReturnPhase_continuous h).intervalIntegrable a b

/- Exact orthogonality on one period: integration retains precisely zero displacement. -/
theorem physicalReturnPhase_integral (h : ℤ) :
    (∫ θ : ℝ in (0 : ℝ)..1, physicalReturnPhase θ h) = if h = 0 then 1 else 0 := by
  by_cases hh : h = 0
  · subst h
    simp [physicalReturnPhase_zero]
  · have hc : (h : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) ≠ 0 := by
      exact mul_ne_zero (by exact_mod_cast hh) Complex.two_pi_I_ne_zero
    have he : (fun θ : ℝ => physicalReturnPhase θ h) =
        (fun θ : ℝ => Complex.exp (((h : ℂ) * (2 * (Real.pi : ℂ) * Complex.I)) * θ)) := by
      funext θ
      unfold physicalReturnPhase
      congr 1
      ring
    rw [he, integral_exp_mul_complex hc]
    simp [hh, Complex.exp_int_mul_two_pi_mul_I]

/- Product of edge phases equals the phase of total displacement. -/
theorem physicalReturnPhase_finset_sum {E : Type*} (edges : Finset E)
    (offset : E → ℤ) (θ : ℝ) :
    physicalReturnPhase θ (∑ e ∈ edges, offset e) =
      ∏ e ∈ edges, physicalReturnPhase θ (offset e) := by
  classical
  induction edges using Finset.induction_on with
  | empty => simp [physicalReturnPhase_zero]
  | @insert e edges he ih => simp [Finset.sum_insert he, Finset.prod_insert he,
      physicalReturnPhase_add, ih]









end

