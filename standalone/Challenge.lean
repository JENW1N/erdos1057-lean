section

/- Arbitrary power saving for the actual candidate large-conductor Type I mass. -/

open Finset Filter

namespace Bounty

theorem candidate_Q_zero_le_wide_bound {c L : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) (hL : 0 ≤ L)
    {p : ℕ} (hp : p ∈ candidateQBand (c * L) 0) :
    (p : ℝ) ≤ 16 * Real.exp L := by
  have hscale := (candidate_center_scale_bounds hc hr hcenter).1
  have hupper : (p : ℝ) ≤ Real.exp ((6/5 : ℝ) * (c * L)) := by
    simpa only [pow_zero, div_one] using
      ((mem_dyadicPrimeBand_iff (c * L) 1 (6/5) 0 p).mp hp).2.2
  have hexp : Real.exp ((6/5 : ℝ) * (c * L)) ≤ Real.exp L := by
    apply Real.exp_le_exp.mpr
    have h := mul_le_mul_of_nonneg_right hscale hL
    nlinarith [mul_nonneg hc.le hL]
  exact (hupper.trans hexp).trans (by nlinarith [Real.exp_pos L])

theorem eventually_candidate_large_primitive_power_saving {c q theta : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1)
    (hq0 : 0 ≤ q) (hq1 : q < 1) (htheta : theta < 1/2) (B : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, 0 < jStar → ∀ N : ℕ,
      (N : ℝ) ≤ Real.exp (theta * L) →
      candidateLargePrimitiveTypeIMass c L q r jStar N ⌊Real.exp ((c/512)*L)⌋₊ ≤
        Real.exp L * L ^ (-B) := by
  have htheta' : (theta + 1/2) / 2 < (1/2 : ℝ) := by linarith
  filter_upwards [eventually_candidate_dyadic_block_decay hc hr hq0 hq1 hcenter htheta' (B + 5),
    eventually_dyadicConductorRange_scale_bounds c htheta,
    eventually_dyadicConductorRange_card_le_linear c htheta,
    eventually_dyadicNatIndices_card_le_linear,
    eventually_three_dyadic_counts_totient_factor_le_pow_five] with L hblock hscale hqcount hcount hcost
  intro jStar hj N hN
  have hL : 0 < L := hcost.1
  have hNexp : (N : ℝ) ≤ Real.exp L := by
    apply hN.trans
    apply Real.exp_le_exp.mpr
    nlinarith
  have hcut : (c/512)*L = c*L/512 := by ring
  rw [hcut]
  let H : ℝ := (2 / Real.log 2 + 1) * L
  let CS : ℝ := (dyadicNatIndices (candidateQBand (c * L) 0)).card
  let CT : ℝ := (dyadicNatIndices (Icc 1 ⌊16 * Real.exp L⌋₊)).card
  have hlog : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hH : 0 ≤ H := by dsimp [H]; positivity
  have hCS : CS ≤ H := by
    apply hcount ⌊16 * Real.exp L⌋₊ (candidateQBand (c * L) 0)
      (Nat.floor_le (by positivity))
    intro p hp
    exact Nat.le_floor (candidate_Q_zero_le_wide_bound hc hr hcenter hL.le hp)
  have hCT : CT ≤ H := by
    apply hcount ⌊16 * Real.exp L⌋₊ (Icc 1 ⌊16 * Real.exp L⌋₊)
      (Nat.floor_le (by positivity))
    intro n hn
    exact (mem_Icc.mp hn).2
  have hB : 0 ≤ Real.exp L * L ^ (-(B + 5)) := by positivity
  have hmain := candidate_large_mass_le_dyadic_blocks (mul_nonneg hc.le hL.le)
    q r jStar hr hj N ⌊Real.exp (c*L/512)⌋₊
    (Real.one_le_exp_iff.mpr hL.le) hNexp hH hB
    (fun h _ => hqcount N h hN) (by
      intro h hh k hk i hi j hj'
      obtain ⟨hRlo, hRhi, hRone⟩ := hscale N h k hN hk
      have hbase : ∀ f ∈ Icc (max 2 (⌊Real.exp (c*L/512)⌋₊ + 1)) (N / h), 0 < f := by
        intro f hf
        have hf2 : 2 ≤ f := (le_max_left _ _).trans (mem_Icc.mp hf).1
        omega
      have hQD : ∀ f ∈ dyadicNatBucket
          (Icc (max 2 (⌊Real.exp (c*L/512)⌋₊ + 1)) (N / h)) k,
          (2 : ℝ) ^ (k + 1) / 2 ≤ (f : ℝ) := by
        intro f hf
        have hlo := (dyadicNatBucket_bounds _ hbase hf).1
        have hloR : (2 : ℝ) ^ k ≤ f := by exact_mod_cast hlo
        have heq : (2 : ℝ) ^ (k + 1) / 2 = (2 : ℝ) ^ k := by rw [pow_succ]; ring
        rwa [heq]
      have hQR : ∀ f ∈ dyadicNatBucket
          (Icc (max 2 (⌊Real.exp (c*L/512)⌋₊ + 1)) (N / h)) k,
          (f : ℝ) ≤ (2 : ℝ) ^ (k + 1) := by
        intro f hf
        exact_mod_cast (dyadicNatBucket_bounds _ hbase hf).2.le
      have hb := hblock jStar hj h ((2 : ℝ) ^ (k + 1))
        (by simpa only [hcut] using hRlo) hRhi _ hQD hQR i j
      unfold candidateRemainderCharacterVector
      exact hb)
  have hfactor :
      (2 * primeEulerProductUpperConstant * Real.log (2 * Real.exp L)) * H * CS * CT ≤ L ^ 5 :=
    hcost.2 H CS CT hH (by dsimp [CS]; positivity) (by dsimp [CT]; positivity) le_rfl hCS hCT
  calc
    _ ≤ (2 * primeEulerProductUpperConstant * Real.log (2 * Real.exp L)) * H * CS * CT *
        (Real.exp L * L ^ (-(B + 5))) := hmain
    _ ≤ L ^ 5 * (Real.exp L * L ^ (-(B + 5))) := mul_le_mul_of_nonneg_right hfactor hB
    _ = Real.exp L * L ^ (-B) := by
      have hpow : L ^ (5 : ℝ) = L ^ (5 : ℕ) := Real.rpow_natCast L 5
      rw [← hpow]
      calc
        _ = Real.exp L * (L ^ (5 : ℝ) * L ^ (-(B + 5))) := by ring
        _ = _ := by rw [← Real.rpow_add hL, show (5 : ℝ) + (-(B + 5)) = -B by ring]


end Bounty
