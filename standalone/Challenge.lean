theorem exists_supported_numerator_factorization (x:(_root_.OAI.ActualEisensteinCubic.O)) (hx:x≠0) :
    ∃u:(_root_.OAI.ActualEisensteinCubic.O)ˣ,∃a b:ℕ,∃r:(_root_.OAI.ActualEisensteinCubic.O),Supported (Ideal.span {r}) ∧ lambda^2∣r-1 ∧
      x=u.val*lambda^a*(2:(_root_.OAI.ActualEisensteinCubic.O))^b*r := by
  obtain ⟨n,u,a,hn,hxform⟩:=CubicEisenstein.exists_primary_unit_lambda_factor x hx
  have hn0:n≠0:=by
    intro hz
    exact hx (by rw [hxform,hz,zero_mul])
  obtain ⟨r,hr,hrnot⟩:=(FiniteMultiplicity.of_prime_left negative_two_prime hn0).exists_eq_pow_mul_and_not_dvd
  let b:ℕ:=multiplicity (-2:(_root_.OAI.ActualEisensteinCubic.O)) n
  change n=(-2:(_root_.OAI.ActualEisensteinCubic.O))^b*r at hr
  have hp:lambda^2∣(-2:(_root_.OAI.ActualEisensteinCubic.O))^b-1:=neg_two_primary.trans (sub_one_dvd_pow_sub_one (-2:(_root_.OAI.ActualEisensteinCubic.O)) b)
  have hprimary:lambda^2∣r-1:=by
    have hh:=dvd_sub hn (dvd_mul_of_dvd_left hp r)
    have he:n-1-(((-2:(_root_.OAI.ActualEisensteinCubic.O))^b-1)*r)=r-1:=by rw [hr];ring
    rwa [he] at hh
  have hnot2:¬(2:(_root_.OAI.ActualEisensteinCubic.O))∣r:=by
    intro h2
    exact hrnot (by simpa only [neg_dvd] using h2)
  have hnotlambda:¬lambda∣r:=by
    intro hLam
    have hsub:lambda∣r-1:=(dvd_pow_self lambda (by decide : (2:ℕ)≠0)).trans hprimary
    have hone:lambda∣(1:(_root_.OAI.ActualEisensteinCubic.O)):=by
      convert dvd_sub hLam hsub using 1 ; ring
    exact PrimaryIdealUnitReindex.lambda_prime_actual.not_isUnit (isUnit_of_dvd_one hone)
  let v:(_root_.OAI.ActualEisensteinCubic.O)ˣ:=u*(-1:(_root_.OAI.ActualEisensteinCubic.O)ˣ)^b
  refine ⟨v,a,b,r,(supported_span_iff r).mpr ⟨hnotlambda,hnot2⟩,hprimary,?_⟩
  have hp2:(-2:(_root_.OAI.ActualEisensteinCubic.O))^b=(-1:(_root_.OAI.ActualEisensteinCubic.O))^b*(2:(_root_.OAI.ActualEisensteinCubic.O))^b:=by
    rw [show (-2:(_root_.OAI.ActualEisensteinCubic.O))=(-1)*2 by ring,mul_pow]
  rw [hxform,hr,hp2]
  dsimp only [v]
  simp only [Units.val_mul,Units.val_pow_eq_pow_val,Units.coe_neg_one]
  ring

