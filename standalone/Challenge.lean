open scoped BigOperators ComplexConjugate
open MeasureTheory

namespace Bounty

theorem logarithmic_gram_row (s : Finset ℕ) (N n : ℕ) (a b : ℝ)
    (hab : a ≤ b) (hn : n ∈ s) (hs : ∀ m ∈ s, 1 ≤ m ∧ m ≤ N) :
    (∑ m ∈ s, ‖∫ t in a..b,
      Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I) *
      conj (Complex.exp ((Real.log (m : ℝ) * t : ℝ) * Complex.I))‖) ≤
      (b - a) + 4 * (N : ℝ) * (1 + Real.log N) := by
  have hn0 : 0 < n := (hs n hn).1
  have hnN : n ≤ N := (hs n hn).2
  have hp (m : ℕ) (hm : m ∈ s) :
      ‖∫ t in a..b, Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I) *
        conj (Complex.exp ((Real.log (m : ℝ) * t : ℝ) * Complex.I))‖ ≤
      (if m = n then b - a else 0) +
        2 * (N : ℝ) * (if m = n then 0 else |(n : ℝ) - m|⁻¹) := by
    rcases lt_trichotomy m n with h | rfl | h
    · have hc : (m : ℝ) ≤ n := by exact_mod_cast h.le
      rw [if_neg h.ne, if_neg h.ne, zero_add, interval_gram_norm_symm]
      simpa only [Nat.cast_sub h.le, abs_of_nonneg (sub_nonneg.mpr hc)] using
        logarithmic_gram_off_diagonal (hs m hm).1 h hnN a b
    · simp only [exponential_phase_gram, sub_self, zero_mul, Complex.ofReal_zero,
        Complex.exp_zero, if_true, mul_zero, add_zero, intervalIntegral.integral_const,
        norm_smul, norm_one, mul_one, Real.norm_eq_abs, abs_of_nonneg (sub_nonneg.mpr hab), le_refl]
    · have hc : (n : ℝ) ≤ m := by exact_mod_cast h.le
      rw [if_neg h.ne', if_neg h.ne', zero_add]
      simpa only [Nat.cast_sub h.le, abs_of_nonpos (sub_nonpos.mpr hc), neg_sub] using
        logarithmic_gram_off_diagonal hn0 h (hs m hm).2 a b
  calc
    _ ≤ ∑ m ∈ s, ((if m = n then b - a else 0) +
        2 * (N : ℝ) * (if m = n then 0 else |(n : ℝ) - m|⁻¹)) :=
      Finset.sum_le_sum hp
    _ = (b - a) + 2 * (N : ℝ) * ∑ m ∈ s, (if m = n then 0 else |(n : ℝ) - m|⁻¹) := by
      rw [Finset.sum_add_distrib, ← Finset.mul_sum]
      simp [hn]
    _ ≤ (b - a) + 2 * (N : ℝ) * (2 * (1 + Real.log N)) := by
      gcongr
      exact sum_inverse_abs_distances_le s n N hnN (fun m hm => (hs m hm).2)
    _ = _ := by ring

theorem dirichlet_polynomial_mean_square (s : Finset ℕ) (c : ℕ → ℂ)
    (N : ℕ) (a b : ℝ) (hab : a ≤ b) (hs : ∀ n ∈ s, 1 ≤ n ∧ n ≤ N) :
    (∫ t in a..b, ‖∑ n ∈ s, c n *
      Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)‖ ^ 2) ≤
      ((b - a) + 4 * (N : ℝ) * (1 + Real.log N)) * ∑ n ∈ s, ‖c n‖ ^ 2 := by
  apply interval_finite_gram_row_bound
  · intro n _
    fun_prop
  · intro n hn
    exact logarithmic_gram_row s N n a b hab hn hs

end Bounty
