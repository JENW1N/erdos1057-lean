section

/- Compact transitions preserve bounded positive branches and have total mass at most one. -/

open Finset Real

namespace Bounty

theorem smooth_allocation_weight_eq_product (n : ℕ) (v s : Fin n → ℝ)
    (active : Fin n → Bool) (R : ℝ) (take : Fin n → Bool) :
    smoothAllocationWeight n v s active R take =
      ∏ i, smoothSlotTransition (v i) (s i) (allocationPrefixResidual v R take i)
        (active i) (take i) := by
  induction n generalizing R with
  | zero => simp [smoothAllocationWeight]
  | succ n ih =>
    rw [smoothAllocationWeight, Fin.prod_univ_succ, allocation_prefix_zero, ih]
    congr 1
    apply prod_congr rfl
    intro i hi
    rw [allocation_prefix_succ]
    rfl

noncomputable def compactSlotTransition (A v s R : ℝ) (active take : Bool) : ℝ :=
  if active then typeIISmoothCutoff A take ((R-v)/s) else if take then 0 else 1

noncomputable def compactAllocationWeight (A : ℝ) (n : ℕ) (v s : Fin n → ℝ)
    (active : Fin n → Bool) (R : ℝ) (take : Fin n → Bool) : ℝ :=
  ∏ i, compactSlotTransition A (v i) (s i) (allocationPrefixResidual v R take i) (active i) (take i)

theorem compact_slot_transition_bounds (A v s R : ℝ) (active take : Bool) :
    0 ≤ compactSlotTransition A v s R active take ∧
      compactSlotTransition A v s R active take ≤ smoothSlotTransition v s R active take := by
  cases active
  · cases take <;> simp [compactSlotTransition, smoothSlotTransition, smoothSlotTakeProbability]
  · have hr := typeII_smooth_rho_bounds A ((R-v)/s)
    have ht := smooth_slot_transition_nonneg v s R true take
    have he : compactSlotTransition A v s R true take =
        typeIISmoothRho A ((R-v)/s)*smoothSlotTransition v s R true take := by
      cases take <;> simp [compactSlotTransition, typeIISmoothCutoff,
        smoothSlotTransition, smoothSlotTakeProbability]
    rw [he]
    refine ⟨mul_nonneg hr.1 ht, ?_⟩
    simpa only [one_mul] using mul_le_mul_of_nonneg_right hr.2 ht

theorem compact_slot_transition_eq {A v s R : ℝ} (active take : Bool)
    (harg : active = true → (R-v)/s ∈ Set.Icc (-A) A) :
    compactSlotTransition A v s R active take = smoothSlotTransition v s R active take := by
  cases active
  · cases take <;> simp [compactSlotTransition, smoothSlotTransition, smoothSlotTakeProbability]
  · have h := typeII_smooth_cutoff_eq_transition take (harg rfl)
    cases take <;> simpa only [compactSlotTransition, smoothSlotTransition, smoothSlotTakeProbability,
      Bool.false_eq_true, if_false, if_true] using h

section

variable
  (A : ℝ)
  (n : ℕ)
  (v s : Fin n → ℝ)
  (active : Fin n → Bool)
  (R : ℝ)

include A n v s active R

theorem compact_allocation_weight_bounds  (take : Fin n → Bool) :
    0 ≤ compactAllocationWeight A n v s active R take ∧
      compactAllocationWeight A n v s active R take ≤ smoothAllocationWeight n v s active R take := by
  constructor
  · exact prod_nonneg (fun i _ => (compact_slot_transition_bounds _ _ _ _ _ _).1)
  · rw [smooth_allocation_weight_eq_product]
    exact prod_le_prod₀ (fun i _ => (compact_slot_transition_bounds _ _ _ _ _ _).1)
      (fun i _ => (compact_slot_transition_bounds _ _ _ _ _ _).2)

theorem compact_allocation_total_mass_le_one  :
    (∑ take, compactAllocationWeight A n v s active R take) ≤ 1 := by
  rw [← smooth_allocation_total_mass n v s active R]
  exact sum_le_sum (fun take _ => (compact_allocation_weight_bounds A n v s active R take).2)

theorem compact_allocation_eq_of_args  (take : Fin n → Bool)
    (harg : ∀ i, active i = true →
      (allocationPrefixResidual v R take i-v i)/s i ∈ Set.Icc (-A) A) :
    compactAllocationWeight A n v s active R take = smoothAllocationWeight n v s active R take := by
  rw [smooth_allocation_weight_eq_product]
  exact prod_congr rfl (fun i _ => compact_slot_transition_eq (active i) (take i) (harg i))

end


end Bounty
end

section

open scoped ContDiff

namespace Bounty

theorem typeII_pulled_schwartz_tsupport_subset (A : ℝ) (p : Fin 4 → ℝ) :
    tsupport (typeIIPulledSchwartz A (p 0) (p 1) (p 2) (p 3)) ⊆
      tsupport (typeIIThreeLocalizer A) := by
  apply (tsupport_comp_subset (g := fun x : ℝ => (x : ℂ)) (by simp)
    (typeIIPulledCutoff A (p 0) (p 1) (p 2) (p 3))).trans
  exact tsupport_mul_subset_left.trans tsupport_mul_subset_left

theorem typeII_pulled_support_radius (A : ℝ) :
    ∃ R : ℝ, 0 ≤ R ∧ ∀ p : Fin 4 → ℝ,
      tsupport (typeIIPulledSchwartz A (p 0) (p 1) (p 2) (p 3)) ⊆
        Metric.closedBall 0 R := by
  obtain ⟨R, hR⟩ := (typeII_three_localizer_hasCompactSupport A).isCompact.isBounded.subset_closedBall 0
  refine ⟨max R 0, le_max_right _ _, ?_⟩
  intro p
  exact (typeII_pulled_schwartz_tsupport_subset A p).trans
    (hR.trans (Metric.closedBall_subset_closedBall (le_max_left _ _)))

theorem typeII_pulled_derivative_polynomial_bound {A : ℝ} (hA : 0 ≤ A) (n : ℕ) :
    ∃ (d : ℕ) (C : ℝ), 0 ≤ C ∧ ∀ (p : Fin 4 → ℝ) (x : EuclideanSpace ℝ (Fin 3)),
      ‖iteratedFDeriv ℝ n (typeIIPulledSchwartz A (p 0) (p 1) (p 2) (p 3)) x‖ ≤
        C * (1 + ‖p‖) ^ d := by
  have hG : Function.HasTemperateGrowth
      (fun y : (Fin 4 → ℝ) × EuclideanSpace ℝ (Fin 3) => (typeIIPulledJoint A y : ℂ)) :=
    Complex.ofRealCLM.hasTemperateGrowth.comp (typeII_pulled_joint_hasTemperateGrowth A)
  obtain ⟨d, C, hC, hb⟩ := hG.norm_iteratedFDeriv_le_uniform n
  obtain ⟨R, hR0, hR⟩ := typeII_pulled_support_radius A
  refine ⟨d, C * (1 + R) ^ d, mul_nonneg hC (pow_nonneg (by linarith) _), ?_⟩
  intro p x
  by_cases hx : x ∈ Metric.closedBall 0 R
  · have hfun : (fun x : EuclideanSpace ℝ (Fin 3) => (typeIIPulledJoint A (p, x) : ℂ)) =
        (typeIIPulledSchwartz A (p 0) (p 1) (p 2) (p 3) : EuclideanSpace ℝ (Fin 3) → ℂ) := by
      funext y
      change (typeIIPulledJoint A (p, y) : ℂ) = (typeIIPulledCutoff A (p 0) (p 1) (p 2) (p 3) y : ℂ)
      rw [typeII_pulled_joint_eq hA]
    have hslice := norm_iteratedFDeriv_slice_le hG.1 p x n
    rw [hfun] at hslice
    have hxR : ‖x‖ ≤ R := mem_closedBall_zero_iff.mp hx
    have hbase : 1 + ‖(p, x)‖ ≤ (1 + R) * (1 + ‖p‖) := by
      rw [Prod.norm_def]
      have hm : max ‖p‖ ‖x‖ ≤ ‖p‖ + R := max_le (by linarith) (by linarith [norm_nonneg p])
      nlinarith [norm_nonneg p]
    calc
      _ ≤ C * (1 + ‖(p, x)‖) ^ d := hslice.trans (hb n le_rfl (p, x))
      _ ≤ C * ((1 + R) * (1 + ‖p‖)) ^ d :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) hbase d) hC
      _ = _ := by rw [mul_pow]; ring
  · have hz : iteratedFDeriv ℝ n (typeIIPulledSchwartz A (p 0) (p 1) (p 2) (p 3)) x = 0 := by
      apply Function.notMem_support.mp
      intro hs
      exact hx (hR p (support_iteratedFDeriv_subset n hs))
    rw [hz, norm_zero]
    positivity

end Bounty
end

section

/- The actual first and second invariant endpoints, with exact finite support masks. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

noncomputable def typeIIInvariantEndpoint (P M R C : Finset ℕ)
    (A c : ℕ → ℂ) (t σ : ℝ) (v : ℕ) : ℂ :=
  invariantTripleEndpoint P
    (fun m => if m ∈ M then A m * typeIIPhase t m else 0)
    (fun p => if p ∈ R then typeIIPhase (-σ) p else 0)
    (fun r => if r ∈ C then conj (c r) else 0) v













theorem typeII_invariant_endpoint_unmask_coefficients
    (P M R C : Finset ℕ) (A c : ℕ → ℂ) (t σ : ℝ)
    (hA : ∀ m, m ∉ M → A m=0) (hc : ∀ r, r ∉ C → c r=0) (v : ℕ) :
    typeIIInvariantEndpoint P M R C A c t σ v =
      invariantTripleEndpoint P (fun m => A m * typeIIPhase t m)
        (fun p => if p ∈ R then typeIIPhase (-σ) p else 0) (fun r => conj (c r)) v := by
  have hfirst : (fun m => if m ∈ M then A m * typeIIPhase t m else 0) =
      (fun m => A m * typeIIPhase t m) := by
    funext m
    by_cases hm : m ∈ M
    · simp only [hm, if_true]
    · simp only [hm, if_false, hA m hm, zero_mul]
  have hlast : (fun r => if r ∈ C then conj (c r) else 0) = (fun r => conj (c r)) := by
    funext r
    by_cases hr : r ∈ C
    · simp only [hr, if_true]
    · simp only [hr, if_false, hc r hr, map_zero]
  unfold typeIIInvariantEndpoint
  rw [hfirst, hlast]





end Bounty
end

section

/- The actual remaining candidate coefficient has the required rough convolution. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

noncomputable def candidateResidualPrimeSupport (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card * r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false) : Finset ℕ :=
  orderedSlotProductSupport
    (fun slot : {slot : CandidateRemainingSlot c L r take //
      slot ≠ candidateRemainingRoughSlot c L r jStar hr hj take hkeep} =>
      candidateQSlotChoices c L r jStar slot.val.val)

theorem candidate_remaining_eq_typeIIRoughConvolution (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card * r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (σ : ℝ)
    (hphase : ∀ p ∈ candidateRoughBand c L jStar,
      twist (candidateRoughSlot c L r jStar hr hj) p = typeIIPhase σ p) (n : ℕ) :
    candidateRemainingComplexCoefficient c L r jStar take twist n =
      typeIIRoughConvolution (candidateRoughBand c L jStar)
        (candidateResidualPrimeSupport c L r jStar hr hj take hkeep) σ
        (candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist) n := by
  classical
  rw [candidate_remaining_rough_convolution c L r jStar hr hj take hkeep twist n]
  unfold typeIIRoughConvolution candidateResidualPrimeSupport
  conv_rhs => rw [← sum_attach]
  apply sum_congr
  · ext p
    simp only [mem_univ, mem_attach]
  · intro p _
    rw [hphase p.val p.property]

theorem candidate_residual_prime_coefficient_eq_zero_of_not_mem
    (c L : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card * r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) {n : ℕ}
    (hn : n ∉ candidateResidualPrimeSupport c L r jStar hr hj take hkeep) :
    candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist n = 0 := by
  unfold candidateResidualPrimeCoefficient
  rw [ordered_slot_complex_weight_support _ _ hn, zero_div]








end Bounty
