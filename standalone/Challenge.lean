section

/- Character separation with real smooth cutoffs and no recovered quotient guards. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

theorem typeII_smooth_determinant_character_sum (E N M H Z : Finset ℕ)
    (k : ℤ) [NeZero (2 * k.natAbs)] (η : ℝ → ℝ → ℝ) (α aH : ℕ → ℂ)
    {W : ℝ} (hW : 2 ≤ W) (hM : ∀ m ∈ M, 0 < m)
    (hrough : ∀ m ∈ M, ∀ p ∈ m.primeFactors, W < (p : ℝ))
    (hsmall : (k.natAbs : ℝ) ≤ W)
    (hpos : ∀ e n, η e n ≠ 0 → 0 < e)
    (hmem : ∀ e n : ℕ, η e n ≠ 0 → e ∈ E ∧ n ∈ N) :
    (∑ y ∈ typeIIDeterminantDomain E N M H {k} Z,
        typeIIShiftComplexWeight (fun e n => η e n) α aH y) =
      (1 / ((2 * k.natAbs).totient : ℂ)) *
        ∑ χ : DirichletCharacter ℂ (2 * k.natAbs),
          ∑ y ∈ typeIICrossSlice M H Z k,
            typeIIRealShiftWeight η α aH y * χ (y.2.1.1 : ZMod (2 * k.natAbs)) *
              conj (χ (y.2.2.1 : ZMod (2 * k.natAbs))) := by
  classical
  have hk : k ≠ 0 := by
    intro hk
    have hne := NeZero.ne (2 * k.natAbs)
    simp [hk] at hne
  have habs : (k.natAbs : ℝ) = |(k : ℝ)| := by
    simpa only [Int.cast_abs, Int.cast_natCast] using
      congrArg (fun z : ℤ => (z : ℝ)) (Int.natCast_natAbs k)
  have hs : (∑ y ∈ typeIIDeterminantDomain E N M H {k} Z,
      typeIIShiftComplexWeight (fun e n => η e n) α aH y) =
      ∑ y ∈ (typeIICrossSlice M H Z k).filter
        (fun y => Nat.ModEq (2 * k.natAbs) y.2.1.1 y.2.2.1),
          typeIIRealShiftWeight η α aH y := by
    unfold typeIIDeterminantDomain typeIICrossSlice
    rw [filter_filter]
    simp only [sum_filter]
    apply sum_congr rfl
    intro y hy
    obtain ⟨hkz, hvw⟩ := mem_product.mp hy
    have hyk : y.1.1 = k := mem_singleton.mp (mem_product.mp hkz).1
    obtain ⟨hv, hw⟩ := mem_product.mp hvw
    have hp := typeII_smooth_shift_pointwise E N η α aH
      (hM _ (mem_product.mp hw).1) (hrough _ (mem_product.mp hv).1)
      (show |(y.1.1 : ℝ)| ≤ W by simpa only [hyk, ← habs] using hsmall) hpos hmem
    simpa only [hyk] using hp
  rw [hs]
  apply typeII_congruence_character_sum
  intro y hy
  have hrange := (mem_filter.mp hy).1
  have hm := (mem_product.mp (mem_product.mp (mem_product.mp hrange).2).2).1
  exact typeII_rough_coprime_twice_natAbs (hM _ hm) hk hW (hrough _ hm) hsmall

section

variable
  {L E V e n : ℝ}
  (hL : 0 < L)
  (hE : 0 < E)
  (hV : 0 < V)
  (hne : typeIIEMajorant (L ^ 88) (e / E) * typeIINMajorant (n / V) ≠ 0)

include L E V e n hL hE hV hne

theorem typeII_majorant_real_support  :
    0 < e ∧ e < 2 * E ∧ n < 3 * V := by
  have he := typeII_e_majorant_normalized_support hL (left_ne_zero_of_mul hne)
  have hn := typeII_n_majorant_normalized_support (right_ne_zero_of_mul hne)
  have hlo : 0 < e / E := lt_trans (by positivity) he.1
  exact ⟨(div_pos_iff_of_pos_right hE).mp hlo,
    (div_lt_iff₀ hE).mp he.2, (div_lt_iff₀ hV).mp hn.2⟩

theorem typeII_majorant_real_box  :
    E / (2 * L ^ 88) < e ∧ e < 2 * E ∧ V / 2 < n ∧ n < 3 * V := by
  have he := typeII_e_majorant_normalized_support hL (left_ne_zero_of_mul hne)
  have hn := typeII_n_majorant_normalized_support (right_ne_zero_of_mul hne)
  refine ⟨?_, (div_lt_iff₀ hE).mp he.2, ?_, (div_lt_iff₀ hV).mp hn.2⟩
  · have hh := (lt_div_iff₀ hE).mp he.1
    calc
      E / (2 * L ^ 88) = ((L ^ 88)⁻¹ / 2) * E := by ring
      _ < e := hh
  · have hh := (lt_div_iff₀ hV).mp hn.1
    calc
      V / 2 = (1 / 2 : ℝ) * V := by ring
      _ < n := hh

end


theorem typeII_majorant_integer_support {L E V : ℝ}
    (hL : 0 < L) (hE : 0 < E) (hV : 0 < V) (e n : ℕ)
    (hne : typeIIEMajorant (L ^ 88) ((e : ℝ) / E) *
      typeIINMajorant ((n : ℝ) / V) ≠ 0) :
    e ∈ Icc ⌈E / (2 * L ^ 88)⌉₊ ⌊2 * E⌋₊ ∧ n ∈ Icc ⌈V / 2⌉₊ ⌊3 * V⌋₊ := by
  have hs := typeII_majorant_real_box hL hE hV hne
  exact ⟨mem_Icc.mpr ⟨Nat.ceil_le.mpr hs.1.le, Nat.le_floor hs.2.1.le⟩,
    mem_Icc.mpr ⟨Nat.ceil_le.mpr hs.2.2.1.le, Nat.le_floor hs.2.2.2.le⟩⟩




end Bounty
