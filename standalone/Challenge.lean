/- The arbitrary-width integer interval version of the separated bilinear bound.
All coefficients may be complex; there are no prime or positivity assumptions on them. -/
theorem rational_phase_integer_interval_bilinear_norm_sq_le {Y : Type*} [Fintype Y]
    (t : Y → ℤ) (hinj : Function.Injective t) (A : ℤ) (V : ℕ)
