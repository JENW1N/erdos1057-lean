/- Actual permutation and ghost events give the decoded mark relations. -/

namespace Bounty
section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)

theorem physical_encoded_permutation_marks
    (before after : Fin N → Finset (Fin J))
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k (none : Option (I ⊕ K)) s)
    (L R : PhysicalBoundedMarkState P J ell B)
    (hs : physicalBoundedMarkEncode before L = s)
    (ht : physicalBoundedMarkEncode after R = physicalFullLedgerEventTarget C k none s e) :
    R.1 = physicalPermuteLabels ((physicalTransitionPermutationEquiv before after).symm e.down) L.1 := by
  subst s
  have hfull := congrArg Prod.snd ht
  have hperm := physical_full_memory_transition_permute before after L.1 L.2.2
    ((physicalTransitionPermutationEquiv before after).symm e.down)
  rw [Equiv.apply_symm_apply] at hperm
  exact physical_full_state_labels_of_eq after _ _ _ _ (hfull.trans hperm.symm)

theorem physical_encoded_ghost_marks
    (cut : Fin N → Finset (Fin J)) (j : I)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k (some (.inl j)) s)
    (L R : PhysicalBoundedMarkState P J ell B)
    (hs : physicalBoundedMarkEncode cut L = s)
    (ht : physicalBoundedMarkEncode cut R = physicalFullLedgerEventTarget C k (some (.inl j)) s e) :
    R.1 = L.1 := by
  subst s
  funext g
  apply Function.Embedding.ext
  intro a
  have h := congrArg (fun t => (t.2 g).1 ((physicalFullSlotIndex (cut g)).symm a)) ht
  change R.1 g (physicalFullSlotIndex (cut g) ((physicalFullSlotIndex (cut g)).symm a)) =
    ((fullPermutationMixedEventTarget _ _ _ _ _ _ (some (.inl j))
      (physicalFullMemoryState cut L.1 L.2.2) e) g).1 ((physicalFullSlotIndex (cut g)).symm a) at h
  have hg := fullPermutationMixedEventTarget_ghost_active
    (fun g (p : ↥(P g)) => p.val) (fun j g => physicalFullSharedIndices (C j g)) B
    (fun j _ => PhysicalAuxLabels P (C j)) (fun j => physicalFullEdgeDelta (C j) (k j))
    (fun j => physicalFullEdgeD (C j)) j (physicalFullMemoryState cut L.1 L.2.2) e g
  simpa only [physicalFullMemoryState, Equiv.apply_symm_apply] using
    h.trans (congrFun hg ((physicalFullSlotIndex (cut g)).symm a))

end Physical
