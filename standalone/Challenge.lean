/- From actual weighted prime candidates to a smooth shifted-prime supply. -/

open Finset Filter

namespace Bounty

theorem eventually_candidate_shifted_prime_supply {c q δ : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hsmall : (6 / 5 : ℝ) * c ≤ δ) (C : ℝ) {σ : ℝ} (hσ : 0 < σ) :
    ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ) (S : Finset ℕ),
      S ⊆ arithmeticProductWindow 1 (Real.exp L) →
      (∀ u ∈ S, (2 * u + 1).Prime) →
      Real.exp L * L ^ (-C) ≤ (∑ u ∈ S, candidateCoefficient c L q r jStar u) →
      ∃ P : Finset ℕ,
        P ⊆ primeBand (2 * Real.exp L) (33 * Real.exp L) ∧
        Real.exp ((1 - σ) * L) ≤ (P.card : ℝ) ∧
        ∀ p ∈ P, ∀ t : ℕ, t.Prime → t ∣ p - 1 → (t : ℝ) ≤ Real.exp (δ * L) := by
  have hδ : 0 < δ := lt_of_lt_of_le (by positivity) hsmall
  have hlarge : ∀ᶠ L : ℝ in atTop, (2 : ℝ) ≤ Real.exp (δ * L) :=
    (Real.tendsto_exp_atTop.comp (tendsto_id.const_mul_atTop hδ)).eventually_ge_atTop 2
  filter_upwards [eventually_candidate_subset_card_lower hc hr hq0 hq1 C hσ,
    eventually_candidate_coefficient_primeFactors_range hc hsmall,
    hlarge, eventually_ge_atTop (0 : ℝ)] with L hcard hsmooth htwo hL
  intro jStar S hS hprime hmass
  let T := S.filter (fun u => candidateCoefficient c L q r jStar u ≠ 0)
  have hTS : T ⊆ S := filter_subset _ _
  have hTmass : (∑ u ∈ T, candidateCoefficient c L q r jStar u) =
      ∑ u ∈ S, candidateCoefficient c L q r jStar u := sum_filter_ne_zero _
  have hTcard := hcard jStar T (hTS.trans hS) (by rwa [hTmass])
  let P := T.image (fun u => 2 * u + 1)
  have hPcard : P.card = T.card := by
    apply card_image_of_injective
    intro u v huv
    change 2 * u + 1 = 2 * v + 1 at huv
    omega
  refine ⟨P, ?_, ?_, ?_⟩
  · intro p hp
    obtain ⟨u, hu, rfl⟩ := mem_image.mp hp
    obtain ⟨hlo, hhi⟩ := (mem_arithmeticProductWindow_iff one_ne_zero (Real.exp L)).mp (hS (hTS hu))
    simp only [one_mul] at hlo hhi
    have he : (1 : ℝ) ≤ Real.exp L := Real.one_le_exp hL
    apply (mem_primeBand_iff (by positivity) (by positivity) _).mpr
    refine ⟨hprime u (hTS hu), ?_, ?_⟩ <;> push_cast <;> nlinarith
  · simpa only [hPcard] using hTcard
  · intro p hp t ht hdiv
    obtain ⟨u, hu, rfl⟩ := mem_image.mp hp
    have hdiv' : t ∣ 2 * u := by simpa only [Nat.add_sub_cancel] using hdiv
    rcases ht.dvd_mul.mp hdiv' with ht2 | htu
    · have ht_eq : t = 2 := (Nat.dvd_prime Nat.prime_two).mp ht2 |>.resolve_left ht.ne_one
      simpa only [ht_eq, Nat.cast_ofNat] using htwo
    · have hu0 : u ≠ 0 := by
        have hw := (mem_arithmeticProductWindow_iff one_ne_zero (Real.exp L)).mp (hS (hTS hu))
        intro hz
        simp only [hz, Nat.cast_zero, mul_zero] at hw
        linarith [Real.exp_pos L]
      exact (hsmooth q r jStar u (mem_filter.mp hu).2 t
        (Nat.mem_primeFactors.mpr ⟨ht, htu, hu0⟩)).2

/- The remaining weighted prime-extraction statement at the actual candidate
weights and interval. This definition does not assert the statement. -/
def CandidateShiftedPrimeMassSupply : Prop :=
  ∀ δ : ℝ, 0 < δ → δ < 1 / 4 →
    ∃ (c q C : ℝ) (r jStar : ℕ),
      0 < c ∧ 0 < r ∧ 0 ≤ q ∧ q < 1 ∧ (6 / 5 : ℝ) * c ≤ δ ∧
      ∀ᶠ L : ℝ in atTop, ∃ S : Finset ℕ,
        S ⊆ arithmeticProductWindow 1 (Real.exp L) ∧
        (∀ u ∈ S, (2 * u + 1).Prime) ∧
        Real.exp L * L ^ (-C) ≤ (∑ u ∈ S, candidateCoefficient c L q r jStar u)

theorem wide_smooth_supply_of_candidate_prime_mass (hM : CandidateShiftedPrimeMassSupply) :
    WideSmoothShiftedPrimeSupply := by
  apply wide_smooth_supply_of_exponential_scale
  intro δ hδ hδsmall σ hσ
  obtain ⟨c, q, C, r, jStar, hc, hr, hq0, hq1, hsmall, hmass⟩ := hM δ hδ hδsmall
  filter_upwards [hmass,
    eventually_candidate_shifted_prime_supply hc hr hq0 hq1 hsmall C hσ]
    with L hS hshift
  obtain ⟨S, hS, hprime, hmass⟩ := hS
  exact hshift jStar S hS hprime hmass

theorem target_of_candidate_prime_mass_and_zero_free
    (hM : CandidateShiftedPrimeMassSupply) (hZ : PrimitiveZeroFreeHalfPlane) :
    fcTypeOfName% "Erdos1057.erdos_1057" :=
  target_of_wide_smooth_primes_and_zero_free (wide_smooth_supply_of_candidate_prime_mass hM) hZ

end Bounty
end

section

/- Uniform rough-integer character cancellation for polynomial-size moduli. -/

open Finset Filter

namespace Bounty

theorem eventually_rpow_le_exp_sqrt (T : ℝ) :
    ∀ᶠ L : ℝ in atTop, L^T ≤ Real.exp (Real.sqrt L) := by
  filter_upwards [eventually_exp_neg_rpow_mul_rpow_le
    (by norm_num : (0 : ℝ) < 1/2) (by norm_num : (0 : ℝ) < 1) T 0]
    with L hL
  simp only [neg_one_mul, neg_zero, Real.rpow_zero, ← Real.sqrt_eq_rpow] at hL
  have h := mul_le_mul_of_nonneg_left hL (Real.exp_nonneg (Real.sqrt L))
  have he : Real.exp (Real.sqrt L) * Real.exp (-Real.sqrt L) = 1 := by
    rw [← Real.exp_add, add_neg_cancel, Real.exp_zero]
  simpa only [← mul_assoc, he, one_mul, mul_one] using h

theorem eventually_rough_interval_character_power_bound {a : ℝ} (ha : 0 < a)
    (T Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ∀ (r : ℕ) [NeZero r] (χ : DirichletCharacter ℂ r), χ ≠ 1 → (r : ℝ) ≤ L^T →
      ∀ A B : ℕ, A ≤ B → (B : ℝ) ≤ 2*Y →
        ‖∑ n ∈ (Ioc A B).filter (fun n : ℕ =>
          ∀ p ∈ n.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ)),
            χ (n : ZMod r)‖ ≤ Y * L^(-Bsave) := by
  obtain ⟨K, hK, hcount⟩ := exists_rough_interval_character_bound
  have hK' : 0 ≤ 2*K+1 := by linarith
  filter_upwards [eventually_rough_cell_sieve_parameters ha,
    eventually_rough_cell_error_profile_le ha hK' (-1) (Bsave + T),
    eventually_rpow_le_exp_sqrt T, eventually_ge_atTop (1 : ℝ)]
    with L hpar hprofile hmod hL
  intro Y hY r hr χ hχ hrT A B hAB hBY
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have hrpos : 0 < r := Nat.pos_of_ne_zero (NeZero.ne r)
  have hpf : ∀ p ∈ r.primeFactors, (p : ℝ) ≤ Real.exp (Real.sqrt L) := by
    intro p hp
    exact (Nat.cast_le.mpr (Nat.le_of_dvd hrpos (Nat.dvd_of_mem_primeFactors hp))).trans
      (hrT.trans hmod)
  have hraw := hcount A B r χ hχ hpar.2.2.1 hAB hpf hpar.1 hpar.2.1
  let V := ∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1 - 1/(p : ℝ))
  let M := (((B : ℝ)-A)/r.totient) * V
  let E := Real.exp (-L^(1/8 : ℝ))
  let F := Real.exp (-(a/2)*L)
  have hV0 : 0 ≤ V := (finite_prime_avoidance_product_pos _
    (fun _ hp => small_prime_pool_prime hp)).le
  have hV1 : V ≤ 1 := finite_prime_avoidance_product_le_one _
    (fun _ hp => small_prime_pool_prime hp)
  have hlen : 0 ≤ (B : ℝ)-A := sub_nonneg.mpr (Nat.cast_le.mpr hAB)
  have hphi : (1 : ℝ) ≤ r.totient := by exact_mod_cast Nat.totient_pos.mpr hrpos
  have hM0 : 0 ≤ M := by dsimp [M]; positivity
  have hM : M ≤ 2*Y := by
    calc
      _ ≤ ((B : ℝ)-A)/r.totient := mul_le_of_le_one_right (by positivity) hV1
      _ ≤ (B : ℝ)-A := div_le_self hlen hphi
      _ ≤ B := sub_le_self _ (Nat.cast_nonneg A)
      _ ≤ 2*Y := hBY
  have hEF : 0 ≤ E ∧ 0 ≤ F := ⟨Real.exp_nonneg _, Real.exp_nonneg _⟩
  have hlevel :
      (Real.exp (Real.sqrt L))^(4*(roughCellSieveOrder L : ℝ)+2) ≤ Y*F := by
    apply hpar.2.2.2.1.trans
    have h := mul_le_mul_of_nonneg_right hY hEF.2
    have he : Real.exp (a*L) * F = Real.exp ((a/2)*L) := by
      dsimp [F]
      rw [← Real.exp_add]
      congr 1
      ring
    rwa [he] at h
  have hpoly : (2*K+1)*(E+F) ≤ L^(-(Bsave+T)) := by
    simpa only [neg_add_cancel, Real.rpow_zero, one_mul, E, F] using hprofile
  have hinside : 2*K*E+F ≤ (2*K+1)*(E+F) := by
    nlinarith
  have hfirst : M*K*Real.exp (-(roughCellSieveOrder L : ℝ)) ≤ 2*Y*K*E :=
    mul_le_mul (mul_le_mul_of_nonneg_right hM hK.le) hpar.2.2.2.2
      (Real.exp_nonneg _) (by positivity)
  calc
    _ ≤ (r : ℝ) * (M*K*Real.exp (-(roughCellSieveOrder L : ℝ)) +
        (Real.exp (Real.sqrt L))^(4*(roughCellSieveOrder L : ℝ)+2)) := hraw
    _ ≤ L^T * (2*Y*K*E+Y*F) :=
      mul_le_mul hrT (add_le_add hfirst hlevel) (by positivity) (by positivity)
    _ = Y*L^T*(2*K*E+F) := by ring
    _ ≤ Y*L^T*((2*K+1)*(E+F)) := mul_le_mul_of_nonneg_left hinside (by positivity)
    _ ≤ Y*L^T*L^(-(Bsave+T)) := mul_le_mul_of_nonneg_left hpoly (by positivity)
    _ = Y*L^(-Bsave) := by
      rw [mul_assoc, ← Real.rpow_add hL0]
      congr 2
      ring

end Bounty
end

section

/- Natural representatives of the actual base and bad residue-pair conditions. -/

open Finset

namespace Bounty

theorem nat_residue_pair_preimage_card (r : ℕ) [NeZero r]
    (S : Finset (ZMod r × ZMod r)) :
    (((Finset.product (range r) (range r)).filter
      (fun v : ℕ × ℕ => ((v.1 : ZMod r), (v.2 : ZMod r)) ∈ S)).card) = S.card := by
  classical
  apply card_bij (fun v _ => ((v.1 : ZMod r), (v.2 : ZMod r)))
  · intro v hv
    exact (mem_filter.mp hv).2
  · intro v hv w hw heq
    have hv' := (mem_filter.mp hv).1
    have hw' := (mem_filter.mp hw).1
    simp only [Finset.product_eq_sprod, mem_product, mem_range] at hv' hw'
    have h1 := congrArg (fun a : ZMod r × ZMod r => a.1.val) heq
    have h2 := congrArg (fun a : ZMod r × ZMod r => a.2.val) heq
    simp only [ZMod.val_natCast, Nat.mod_eq_of_lt hv'.1, Nat.mod_eq_of_lt hw'.1] at h1
    simp only [ZMod.val_natCast, Nat.mod_eq_of_lt hv'.2, Nat.mod_eq_of_lt hw'.2] at h2
    exact Prod.ext h1 h2
  · intro v hv
    refine ⟨(v.1.val, v.2.val), mem_filter.mpr ⟨?_, ?_⟩, ?_⟩
    · rw [Finset.product_eq_sprod, mem_product]
      exact ⟨mem_range.mpr v.1.val_lt, mem_range.mpr v.2.val_lt⟩
    · simpa only [ZMod.natCast_zmod_val, Prod.mk.eta] using hv
    · simp only [ZMod.natCast_zmod_val, Prod.mk.eta]

noncomputable def natPairBaseResidues (m : ℕ) : Finset (ℕ × ℕ) :=
  (Finset.product (range m) (range m)).filter (fun v => (v.1*v.2) % m = 1 % m)

noncomputable def natPairBadResidues (p : ℕ) (rough banned : Bool) : Finset (ℕ × ℕ) :=
  (Finset.product (range p) (range p)).filter (fun v =>
    (rough = true ∧ (v.1*v.2) % p = 0) ∨ (banned = true ∧ (v.1*v.2) % p = 1 % p))

theorem nat_pair_base_residue_card (m : ℕ) [NeZero m] :
    (natPairBaseResidues m).card = m.totient := by
  classical
  have hset : natPairBaseResidues m =
      (Finset.product (range m) (range m)).filter (fun v : ℕ × ℕ =>
        ((v.1 : ZMod m), (v.2 : ZMod m)) ∈
          (univ : Finset (ZMod m × ZMod m)).filter (fun w => w.1*w.2 = 1)) := by
    apply filter_congr
    intro v _
    simp only [mem_filter, mem_univ, true_and]
    have he : ((v.1*v.2 : ℕ) : ZMod m) = 1 ↔ (v.1*v.2) % m = 1 % m := by
      simpa only [Nat.cast_one] using ZMod.natCast_eq_natCast_iff' (v.1*v.2) 1 m
    simpa only [Nat.cast_mul] using he.symm
  rw [hset, nat_residue_pair_preimage_card, finite_mul_one_pair_card, ZMod.card_units_eq_totient]

theorem nat_pair_bad_residue_density (p : ℕ) [Fact p.Prime] (rough banned : Bool) :
    ((natPairBadResidues p rough banned).card : ℝ) / (p : ℝ)^2 =
      pairSieveDensity p rough banned := by
  classical
  have hset : natPairBadResidues p rough banned =
      (Finset.product (range p) (range p)).filter (fun v : ℕ × ℕ =>
        ((v.1 : ZMod p), (v.2 : ZMod p)) ∈ pairSieveBadResidues p rough banned) := by
    apply filter_congr
    intro v _
    simp only [pairSieveBadResidues, mem_filter, mem_univ, true_and]
    have h0 : ((v.1*v.2 : ℕ) : ZMod p) = 0 ↔ (v.1*v.2) % p = 0 := by
      simpa only [Nat.cast_zero, Nat.zero_mod] using ZMod.natCast_eq_natCast_iff' (v.1*v.2) 0 p
    have h1 : ((v.1*v.2 : ℕ) : ZMod p) = 1 ↔ (v.1*v.2) % p = 1 % p := by
      simpa only [Nat.cast_one] using ZMod.natCast_eq_natCast_iff' (v.1*v.2) 1 p
    simp only [← Nat.cast_mul, h0, h1]
  rw [hset, nat_residue_pair_preimage_card, pair_sieve_density_eq_card]

theorem nat_pair_base_residue_bounds (m : ℕ) {v : ℕ × ℕ}
    (hv : v ∈ natPairBaseResidues m) : v.1 < m ∧ v.2 < m := by
  have h := (mem_filter.mp hv).1
  simpa only [Finset.product_eq_sprod, mem_product, mem_range] using h

theorem nat_pair_bad_residue_bounds (p : ℕ) (rough banned : Bool) {v : ℕ × ℕ}
    (hv : v ∈ natPairBadResidues p rough banned) : v.1 < p ∧ v.2 < p := by
  have h := (mem_filter.mp hv).1
  simpa only [Finset.product_eq_sprod, mem_product, mem_range] using h

theorem actual_pair_sieve_residue_card (m : ℕ) [NeZero m]
    (P : Finset ℕ) (rough banned : ℕ → Bool)
    (hP : ∀ p ∈ P, p.Prime) (hPm : ∀ p ∈ P, ¬p ∣ m) :
    (natPairSieveResidues m (natPairBaseResidues m) P
      (fun p => natPairBadResidues p (rough p) (banned p))).card =
      m.totient * ∏ p ∈ P, (natPairBadResidues p (rough p) (banned p)).card := by
  rw [nat_pair_sieve_residues_card m (Nat.pos_of_ne_zero (NeZero.ne m)) _
    (fun _ hv => nat_pair_base_residue_bounds m hv) P _ hP hPm
    (fun p _ _ hv => nat_pair_bad_residue_bounds p (rough p) (banned p) hv),
    nat_pair_base_residue_card]

end Bounty
end

section

/- Exact Bernoulli mask identities used in the weighted pair sieve. -/

open Finset

namespace Bounty

theorem bernoulli_mask_inverse_avoidance (P : Finset ℕ) (q : ℝ)
    (hP : ∀ p ∈ P, 2 ≤ p) :
    (∑ S ∈ P.powerset, bernoulliSubsetWeight q P S *
      ∏ p ∈ S, (1 - 1/(p : ℝ))⁻¹) =
      ∏ p ∈ P, (1 + q/((p : ℝ)-1)) := by
  rw [show (∑ S ∈ P.powerset, bernoulliSubsetWeight q P S *
      ∏ p ∈ S, (1 - 1/(p : ℝ))⁻¹) =
      ∏ p ∈ P, ((1-q)+q*(1-1/(p : ℝ))⁻¹) from
    subset_weighted_product_expansion P q (1-q) (fun p => (1-1/(p : ℝ))⁻¹)]
  apply prod_congr rfl
  intro p hp
  have hpR : (2 : ℝ) ≤ p := Nat.cast_le.mpr (hP p hp)
  have hp0 : (p : ℝ) ≠ 0 := by linarith
  have hp1 : (p : ℝ)-1 ≠ 0 := by linarith
  field_simp
  ring

theorem bernoulli_mask_contains {α : Type*} [DecidableEq α]
    (P F : Finset α) (hF : F ⊆ P) (q : ℝ) :
    (∑ S ∈ P.powerset, if F ⊆ S then bernoulliSubsetWeight q P S else 0) = q^F.card := by
  classical
  let b : α → ℝ := fun p => if p ∈ F then 0 else 1-q
  have hcomp (S : Finset α) (hS : S ⊆ P) :
      (∏ p ∈ P \ S, b p) = if F ⊆ S then (1-q)^(P.card-S.card) else 0 := by
    by_cases hFS : F ⊆ S
    · rw [if_pos hFS]
      calc
        _ = ∏ _p ∈ P \ S, (1-q) := by
          apply prod_congr rfl
          intro p hp
          exact if_neg (fun hpF => (mem_sdiff.mp hp).2 (hFS hpF))
        _ = _ := by rw [prod_const, card_sdiff_of_subset hS]
    · rw [if_neg hFS]
      obtain ⟨p, hpF, hpS⟩ := Set.not_subset.mp hFS
      exact prod_eq_zero (mem_sdiff.mpr ⟨hF hpF, hpS⟩) (if_pos hpF)
  have hid : (∏ p ∈ P, (q + b p)) = q^F.card := by
    have hp : (∏ p ∈ P, (q + b p)) = ∏ p ∈ P, if p ∈ F then q else 1 := by
      apply prod_congr rfl
      intro p _
      by_cases hp : p ∈ F <;> simp [b, hp]
    rw [hp, ← prod_filter]
    have hfilter : P.filter (fun p => p ∈ F) = F := filter_mem_eq_inter.trans (inter_eq_right.mpr hF)
    rw [hfilter, prod_const]
  rw [← hid, prod_add]
  apply sum_congr rfl
  intro S hS
  rw [hcomp S (mem_powerset.mp hS), prod_const]
  by_cases hFS : F ⊆ S <;> simp [hFS, bernoulliSubsetWeight]




end Bounty
end

section

/- The actual prime sets in the masked pair sieve and their omitted-prime corrections. -/

open Finset

namespace Bounty

noncomputable def maskedPairPrimes (m : ℕ) (z : ℝ) : Finset ℕ :=
  (primeBand 0 z).filter (fun p => p ≠ 2 ∧ ¬p ∣ m)

noncomputable def maskedPairRoughPrimes (m : ℕ) (W z : ℝ) : Finset ℕ := by
  classical
  exact (maskedPairPrimes m z).filter (fun p : ℕ => (p : ℝ) ≤ W)

noncomputable def maskedPairBannedPrimes (m : ℕ) (z : ℝ) (A : Finset ℕ) : Finset ℕ :=
  maskedPairPrimes m z \ A

theorem mem_masked_pair_primes {m p : ℕ} {z : ℝ} (hz : 0 ≤ z) :
    p ∈ maskedPairPrimes m z ↔ p.Prime ∧ (p : ℝ) ≤ z ∧ p ≠ 2 ∧ ¬p ∣ m := by
  simp only [maskedPairPrimes, mem_filter, mem_primeBand_iff le_rfl hz]
  constructor
  · rintro ⟨⟨hp, _, hpz⟩, hp2, hpm⟩
    exact ⟨hp, hpz, hp2, hpm⟩
  · rintro ⟨hp, hpz, hp2, hpm⟩
    exact ⟨⟨hp, Nat.cast_pos.mpr hp.pos, hpz⟩, hp2, hpm⟩

theorem masked_pair_rough_omission (m : ℕ) (hm : m ≠ 0) (W z : ℝ)
    (hW : 0 ≤ W) (hWz : W ≤ z) :
    (∏ p ∈ maskedPairRoughPrimes m W z, (1 - 1/(p : ℝ))) ≤
      2 * (∏ p ∈ primeBand 0 W, (1 - 1/(p : ℝ))) *
        (∏ p ∈ m.primeFactors, (1 - 1/(p : ℝ))⁻¹) := by
  classical
  have hz := hW.trans hWz
  have hQ : ∀ p ∈ primeBand 0 W, 2 ≤ p := fun p hp =>
    ((mem_primeBand_iff le_rfl hW p).mp hp).1.two_le
  have hP : ∀ p ∈ maskedPairRoughPrimes m W z, 2 ≤ p := fun p hp =>
    ((mem_masked_pair_primes hz).mp (mem_filter.mp hp).1).1.two_le
  have hmP : ∀ p ∈ m.primeFactors, 2 ≤ p := fun p hp => (Nat.mem_primeFactors.mp hp).1.two_le
  have hE : ∀ p ∈ insert 2 m.primeFactors, 2 ≤ p := by
    intro p hp
    rcases mem_insert.mp hp with rfl | hp
    · exact le_rfl
    · exact hmP p hp
  have hcover : primeBand 0 W \ insert 2 m.primeFactors ⊆ maskedPairRoughPrimes m W z := by
    intro p hp
    obtain ⟨hpW, hpE⟩ := mem_sdiff.mp hp
    obtain ⟨hprime, _, hpW⟩ := (mem_primeBand_iff le_rfl hW p).mp hpW
    have hp2 : p ≠ 2 := fun he => hpE (mem_insert.mpr (Or.inl he))
    have hpm : ¬p ∣ m := fun hd => hpE (mem_insert_of_mem (Nat.mem_primeFactors.mpr ⟨hprime, hd, hm⟩))
    exact mem_filter.mpr ⟨(mem_masked_pair_primes hz).mpr ⟨hprime, hpW.trans hWz, hp2, hpm⟩, hpW⟩
  have hb := finite_avoidance_omission_bound _ _ _ hP hQ hE hcover
  have hc := mul_le_mul_of_nonneg_left (inverse_avoidance_insert_two_le m.primeFactors hmP)
    (prod_nonneg (fun p hp => (avoidance_factor_bounds (hQ p hp)).1.le))
  exact hb.trans (hc.trans_eq (by ring))

theorem masked_pair_banned_omission (m : ℕ) (hm : m ≠ 0) (z : ℝ) (hz : 0 ≤ z)
    (A : Finset ℕ) (hA : ∀ p ∈ A, 2 ≤ p) :
    (∏ p ∈ maskedPairBannedPrimes m z A, (1 - 1/(p : ℝ))) ≤
      2 * (∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ))) *
        (∏ p ∈ m.primeFactors, (1 - 1/(p : ℝ))⁻¹) *
        (∏ p ∈ A, (1 - 1/(p : ℝ))⁻¹) := by
  have hQ : ∀ p ∈ primeBand 0 z, 2 ≤ p := fun p hp =>
    ((mem_primeBand_iff le_rfl hz p).mp hp).1.two_le
  have hP : ∀ p ∈ maskedPairBannedPrimes m z A, 2 ≤ p := fun p hp =>
    ((mem_masked_pair_primes hz).mp (mem_sdiff.mp hp).1).1.two_le
  have hmP : ∀ p ∈ m.primeFactors, 2 ≤ p := fun p hp => (Nat.mem_primeFactors.mp hp).1.two_le
  have hU : ∀ p ∈ m.primeFactors ∪ A, 2 ≤ p := fun p hp => (mem_union.mp hp).elim (hmP p) (hA p)
  have hE : ∀ p ∈ insert 2 (m.primeFactors ∪ A), 2 ≤ p := by
    intro p hp
    rcases mem_insert.mp hp with rfl | hp
    · exact le_rfl
    · exact hU p hp
  have hcover : primeBand 0 z \ insert 2 (m.primeFactors ∪ A) ⊆ maskedPairBannedPrimes m z A := by
    intro p hp
    obtain ⟨hpz, hpE⟩ := mem_sdiff.mp hp
    obtain ⟨hprime, _, hpz⟩ := (mem_primeBand_iff le_rfl hz p).mp hpz
    have hp2 : p ≠ 2 := fun he => hpE (mem_insert.mpr (Or.inl he))
    have hpm : ¬p ∣ m := fun hd => hpE (mem_insert_of_mem (mem_union_left _
      (Nat.mem_primeFactors.mpr ⟨hprime, hd, hm⟩)))
    have hpA : p ∉ A := fun hh => hpE (mem_insert_of_mem (mem_union_right _ hh))
    exact mem_sdiff.mpr ⟨(mem_masked_pair_primes hz).mpr ⟨hprime, hpz, hp2, hpm⟩, hpA⟩
  have hb := finite_avoidance_omission_bound _ _ _ hP hQ hE hcover
  have hI := (inverse_avoidance_insert_two_le (m.primeFactors ∪ A) hU).trans
    (mul_le_mul_of_nonneg_left (inverse_avoidance_union_le m.primeFactors A hmP hA) (by norm_num))
  have hc := mul_le_mul_of_nonneg_left hI
    (prod_nonneg (fun p hp => (avoidance_factor_bounds (hQ p hp)).1.le))
  exact hb.trans (hc.trans_eq (by ring))

end Bounty
end

section

/- A uniform bound for the Euler correction of a modulus with large prime factors. -/

open Finset

namespace Bounty

section

variable
  {L : ℝ}
  (hL : 1 ≤ L)
  (m : ℕ)
  (hm : m ≠ 0)
  (hmL : (m : ℝ) ≤ Real.exp L)
  (hmin : ∀ p ∈ m.primeFactors, L^2 ≤ (p : ℝ))

include L hL m hm hmL hmin

theorem large_prime_modulus_inverse_bound  :
    (∏ p ∈ m.primeFactors, (1 - 1/(p : ℝ))⁻¹) ≤ Real.exp 4 := by
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hm0 : (0 : ℝ) < m := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hm)
  have hlog : Real.log (m : ℝ) ≤ L := by
    simpa only [Real.log_exp] using Real.log_le_log hm0 hmL
  have hcard : (m.primeFactors.card : ℝ) ≤ 2*L :=
    (primeFactors_card_le_two_log (Nat.pos_of_ne_zero hm)).trans (by linarith)
  have hsum : (∑ p ∈ m.primeFactors, 1/(p : ℝ)) ≤ 2 := by
    calc
      _ ≤ ∑ _p ∈ m.primeFactors, 1/L^2 := sum_le_sum (fun p hp =>
        one_div_le_one_div_of_le (sq_pos_of_pos hL0) (hmin p hp))
      _ = (m.primeFactors.card : ℝ) * (1/L^2) := by simp
      _ ≤ (2*L) * (1/L^2) := mul_le_mul_of_nonneg_right hcard (by positivity)
      _ ≤ 2 := by
        rw [mul_one_div]
        apply (div_le_iff₀ (sq_pos_of_pos hL0)).mpr
        nlinarith
  have hb := finite_inverse_avoidance_le_exp m.primeFactors
    (fun p hp => (Nat.mem_primeFactors.mp hp).1.two_le)
  exact hb.trans (Real.exp_le_exp.mpr (by linarith))

theorem large_prime_modulus_inverse_cube_bound  :
    (∏ p ∈ m.primeFactors, (1 - 1/(p : ℝ))⁻¹)^3 ≤ Real.exp 12 := by
  have hI0 : 0 ≤ ∏ p ∈ m.primeFactors, (1 - 1/(p : ℝ))⁻¹ :=
    prod_nonneg (fun p hp => inv_nonneg.mpr
      (avoidance_factor_bounds (Nat.mem_primeFactors.mp hp).1.two_le).1.le)
  have h := pow_le_pow_left₀ hI0 (large_prime_modulus_inverse_bound hL m hm hmL hmin) 3
  calc
    _ ≤ (Real.exp 4)^3 := h
    _ = Real.exp 12 := by rw [← Real.exp_nat_mul]; norm_num

end


end Bounty
end

section

/- Exact identification of the physical unbanned row with the asymmetric
prime comparison. Shared coordinates, auxiliary samples, and both phases are
retained; this is an identity, not an operator-norm hypothesis. -/

open Finset
open scoped Classical

namespace Bounty

theorem repeated_big_prime_D_split
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (source : RepeatedBigLists P J ell)
    (a : ∀ i : A, P i.val.1) (b : ∀ i : B, P i.val.1) :
    repeatedBigD (repeatedBigAuxCut A B) source
        ((repeatedBigAuxSplitEquiv P A B hU hAB).symm (a, b)) =
      (∏ i : ↥(repeatedBigFlatActive J ell \ (A ∪ B)),
        (repeatedBigFlatEquiv P J ell source i.val).val) *
      (∏ i : A, (a i).val) * (∏ i : B, (b i).val) := by
  unfold repeatedBigD
  rw [prod_mul_distrib, repeated_big_shared_label_product_flat,
    repeatedBigAuxCut_shared, repeatedBigAuxSplitEquiv_symm_label_prod]
  exact (mul_assoc _ _ _).symm

theorem repeated_big_prime_unbanned_kernel_eq
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (Q : ℕ) (h : ℝ)
    (keptA keptB : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ)
    (ζ Θ : ℝ) (source target : RepeatedBigLists P J ell) :
    (∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
      repeatedBigUnbannedKernel V (fun _ _ => 1) (repeatedBigAuxCut A B) ζ
        (repeatedBigPrimeCoefficient P V A B hU hAB Q h (keptA A) (keptB B))
        aux source target * physicalReturnPhase Θ (repeatedBigD (repeatedBigAuxCut A B) source aux)) =
      primeAsymmetricComparisonKernel (fun i : RepeatedBigFlatIndex G J ell => P i.1)
        (fun i => V i.1) (repeatedBigFlatActive J ell) Q h keptA keptB ζ Θ A B
        (repeatedBigFlatEquiv P J ell source) (repeatedBigFlatEquiv P J ell target) := by
  rw [prime_asymmetric_comparison_kernel_eq_aux_sum]
  have hc := repeated_big_shared_compatible_flat (repeatedBigAuxCut A B) source target
  rw [repeatedBigAuxCut_shared] at hc
  by_cases hxy : repeatedBigSharedCompatible (repeatedBigAuxCut A B) source target
  · rw [if_pos (hc.mp hxy)]
    calc
      _ = ∑ ab : (∀ i : A, P i.val.1) × (∀ i : B, P i.val.1),
          repeatedBigUnbannedKernel V (fun _ _ => 1) (repeatedBigAuxCut A B) ζ
            (repeatedBigPrimeCoefficient P V A B hU hAB Q h (keptA A) (keptB B))
            ((repeatedBigAuxSplitEquiv P A B hU hAB).symm ab) source target *
          physicalReturnPhase Θ (repeatedBigD (repeatedBigAuxCut A B) source
            ((repeatedBigAuxSplitEquiv P A B hU hAB).symm ab)) :=
        ((repeatedBigAuxSplitEquiv P A B hU hAB).symm.sum_comp _).symm
      _ = _ := by
        rw [Fintype.sum_prod_type]
        apply sum_congr rfl
        intro a _
        apply sum_congr rfl
        intro b _
        unfold repeatedBigUnbannedKernel
        rw [if_pos hxy, repeatedBigAuxSplitEquiv_symm_mass,
          repeated_big_target_mass_flat, repeatedBigAuxCut_shared,
          repeated_big_prime_coefficient_split, repeated_big_prime_D_split]
        rfl
  · rw [if_neg (fun h => hxy (hc.mpr h))]
    apply sum_eq_zero
    intro aux _
    simp only [repeatedBigUnbannedKernel, if_neg hxy, zero_mul]

end Bounty
end

section

/- An elementary upper bound for the full prime avoidance product from harmonic sums. -/

open Finset

namespace Bounty

theorem harmonic_floor_le_inverse_prime_product (z : ℝ) (hz : 0 ≤ z) :
    (harmonic ⌊z⌋₊ : ℝ) ≤ ∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ))⁻¹ := by
  classical
  have hP : ∀ p ∈ primeBand 0 z, p.Prime := fun p hp =>
    ((mem_primeBand_iff le_rfl hz p).mp hp).1
  have hS : ∀ n ∈ Icc 1 ⌊z⌋₊, n ∈ Nat.factoredNumbers (primeBand 0 z) := by
    intro n hn
    obtain ⟨hn1, hnz⟩ := mem_Icc.mp hn
    apply Nat.mem_factoredNumbers_iff_forall_le.mpr
    refine ⟨by omega, ?_⟩
    intro p hpn hp _
    exact (mem_primeBand_iff le_rfl hz p).mpr
      ⟨hp, Nat.cast_pos.mpr hp.pos, (Nat.cast_le.mpr (hpn.trans hnz)).trans (Nat.floor_le hz)⟩
  have hfinite : (∑ n ∈ Icc 1 ⌊z⌋₊, (n : ℝ)^(-(1 : ℝ))) ≤
      ∑' n : Nat.factoredNumbers (primeBand 0 z), (n.val : ℝ)^(-(1 : ℝ)) := by
    rw [← sum_subtype_of_mem (fun n : ℕ => (n : ℝ)^(-(1 : ℝ))) hS]
    apply (smooth_rpow_summable_and_sum _ hP (by norm_num : (0 : ℝ) < 1)).1.sum_le_tsum
    intro n _
    exact Real.rpow_nonneg (Nat.cast_nonneg _) _
  rw [(smooth_rpow_summable_and_sum _ hP (by norm_num : (0 : ℝ) < 1)).2] at hfinite
  simpa only [harmonic_eq_sum_Icc, Rat.cast_sum, Rat.cast_inv, Rat.cast_natCast,
    Real.rpow_neg_one, one_div] using hfinite

theorem full_prime_avoidance_upper {z : ℝ} (hz : 1 < z) :
    (∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ))) ≤ 1/Real.log z := by
  have hz0 := (zero_lt_one.trans hz).le
  have hP : ∀ p ∈ primeBand 0 z, 2 ≤ p := fun p hp =>
    ((mem_primeBand_iff le_rfl hz0 p).mp hp).1.two_le
  have hV0 : 0 ≤ ∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ)) :=
    prod_nonneg (fun p hp => (avoidance_factor_bounds (hP p hp)).1.le)
  have hid : (∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ))) *
      (∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ))⁻¹) = 1 := by
    rw [← prod_mul_distrib]
    exact prod_eq_one (fun p hp => mul_inv_cancel₀ (avoidance_factor_bounds (hP p hp)).1.ne')
  have hlog := (log_le_harmonic_floor z hz0).trans (harmonic_floor_le_inverse_prime_product z hz0)
  have hm := mul_le_mul_of_nonneg_left hlog hV0
  rw [hid] at hm
  exact (le_div_iff₀ (Real.log_pos hz)).mpr hm

theorem full_prime_avoidance_exp_upper {t : ℝ} (ht : 0 < t) :
    (∏ p ∈ primeBand 0 (Real.exp t), (1 - 1/(p : ℝ))) ≤ 1/t := by
  simpa only [Real.log_exp] using full_prime_avoidance_upper (Real.one_lt_exp_iff.mpr ht)

end Bounty
end

