noncomputable def candidateBoxFiniteTest (L E : ℝ) (S : Finset ℕ) (G : ℕ → ℂ) (e h : ℕ) : ℂ :=
  if (E/L^88 ≤ (e : ℝ) ∧ (e : ℝ) ≤ E) ∧ e*h ∈ S
  then G (e*h) else 0

theorem candidate_box_single_P_finite_patterns (c L : ℝ) (r jStar p : ℕ) (E R : ℝ) (S : Finset ℕ) (G : ℕ → ℂ) :
    (∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
      candidateBoxRangeAllocationMass c L r jStar x E R *
        (if p*orderedSlotProduct (candidateQSlotChoices c L r jStar) x ∈ S
          then G (p*orderedSlotProduct (candidateQSlotChoices c L r jStar) x) else 0) /
          (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ)) =
    ∑ take ∈ (univ : Finset (Fin ((candidateQIndices c L).card*r) → Bool)).filter
      (fun take => ∀ i, candidateAllocationActive c L r jStar i = false → take i = false),
      (∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
        (∫ ξ, activeAllocationFourierIntegrand (candidateAllocationRadius r) (Real.log E)
          (fun i => Real.log (candidateAllocationValue c L r jStar x i))
          (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
          (candidateAllocationActive c L r jStar) take ξ
            ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) R) *
        candidateBoxFiniteTest L E S G (candidateAllocatedFactor c L r jStar x take)
          (candidateRetainedFactor c L r jStar p x take)) /
          (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ) := by
  classical
  unfold candidateBoxRangeAllocationMass
  rw [sum_filter]
  simp only [sum_mul, sum_div]
  rw [sum_comm]
  apply sum_congr rfl
  intro take ht
  by_cases hk : ∀ i, candidateAllocationActive c L r jStar i = false → take i = false
  · have hkeq : (∀ i, candidateAllocationActive c L r jStar i = false → take i = false) = True :=
      propext (iff_true_intro hk)
    simp only [hkeq, true_and, if_true]
    apply sum_congr rfl
    intro x hx
    simp only [candidateBoxFiniteTest, candidate_allocation_factorization]
    by_cases he : E/L^88 ≤ (candidateAllocatedFactor c L r jStar x take : ℝ) ∧
      (candidateAllocatedFactor c L r jStar x take : ℝ) ≤ E
    · by_cases hw : p*orderedSlotProduct (candidateQSlotChoices c L r jStar) x ∈
        S
      · simp only [he, hw, and_self, if_true]
      · simp only [he, hw, true_and, if_false, mul_zero, zero_div]
    · simp only [he, false_and, if_false, zero_mul, mul_zero, zero_div]
  · simp only [hk, false_and, if_false, zero_mul, zero_div, sum_const_zero]

theorem eventually_candidate_box_finite_retained_integrals {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (E R X : ℝ) (S : Finset ℕ) (G : ℕ → ℂ),
      (∀ u ∈ S, 0 < u ∧ (u : ℝ) ≤ X) →
      (∑ u ∈ S,
        candidateBoxRangeCoefficient c L q r jStar E R u*G u) =
      ∑ take ∈ (univ : Finset (Fin ((candidateQIndices c L).card*r) → Bool)).filter
        (fun take => ∀ i, candidateAllocationActive c L r jStar i = false → take i = false),
        ∫ ξ, candidateRetainedAllocationIntegrand c L q r jStar (Real.log E)
          (candidateSmallPSet c L (X+1)) take (candidateBoxFiniteTest L E S G) ξ
          ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) R := by
  classical
  filter_upwards [eventually_candidate_box_finite_convolution hc,
    eventually_candidate_retained_box_integral hc] with L hconv hint
  intro q r jStar E R X S G hS
  rw [hconv q r jStar E R X S G hS]
  simp_rw [candidate_box_Q_test, candidate_box_single_P_finite_patterns, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro take ht
  exact (hint q r jStar (Real.log E) R _ take (fun p hp =>
    ((mem_candidateSmallPSet_iff c L _ p).mp hp).2) (candidateBoxFiniteTest L E S G)).2

end Bounty
end

section

/- The actual signed family of clean mixed rows factors through the two
canonical big projections. No norm estimate or assumed pairing is used.
The initial forbidden sets stay fixed, and both endpoint gates stay inside
small conditioning in their original order. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {I S G : Type*} [Fintype I] [Fintype S] [Fintype G]
    [DecidableEq S] [DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ p : PhysicalPrime Ps, NeZero p.2.val] [∀ g (p : P g), NeZero p.val]

noncomputable def physicalMixedGatedCleanPatternAction
    (initial : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : I → G → Finset (Fin J)) (ζ θ ρ : ℝ) (k : ℤ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (Vs : S → ℝ) (q : ℝ)
    (sourceGate targetGate f : PhysicalSmallBigState Ps J ell
      (CleanFullMemoryState P J ell B) → ℂ)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)) : ℂ :=
  ∑ i, physicalMixedGatedCleanAction initial V b (C i) ζ θ ρ k (K i)
    Vs q sourceGate targetGate f s

theorem physical_mixed_gated_clean_pattern_pairing
    (initial : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : I → G → Finset (Fin J)) (ζ θ ρ : ℝ) (k : ℤ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s) (q : ℝ)
    (W : CleanFullMemoryState P J ell B → ℝ)
    (smallAux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
    (sourceGate targetGate u f : PhysicalSmallBigState Ps J ell
      (CleanFullMemoryState P J ell B) → ℂ) :
    (∑ s, (physicalSmallBigMeasure Vs W s : ℂ) * (starRingEnd ℂ) (u s) *
      physicalMixedGatedCleanPatternAction initial V b C ζ θ ρ k K Vs q
        sourceGate targetGate f s) =
      ∑ d, ∑ r, ∑ x, (W x : ℂ) *
        (starRingEnd ℂ) (physicalSmallBigCondition Vs q (fun s => sourceGate s * u s) d x r) *
        (∑ i, physicalMixedCleanInitialAction initial V b (C i) ζ θ ρ k (K i) d
          (physicalSmallBigCondition Vs q (fun s => targetGate s * f s) d) x r) := by
  simp only [physicalMixedGatedCleanPatternAction, mul_sum]
  rw [sum_comm]
  simp_rw [physical_mixed_gated_clean_pairing initial V b _ ζ θ ρ k _
    Vs hVs q W smallAux sourceGate targetGate u f]
  rw [sum_comm]
  apply sum_congr rfl
  intro d _
  rw [sum_comm]
  apply sum_congr rfl
  intro r _
  exact sum_comm

omit [DecidableEq S] [∀ p : PhysicalPrime Ps, NeZero p.2.val] in
theorem physical_mixed_clean_pattern_projected_reencode
    (initial : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : I → G → Finset (Fin J)) (ζ θ ρ : ℝ) (k : ℤ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r))
    (hPs : ∀ s p, p ∈ Ps s → 0 < p) (hP : ∀ g p, p ∈ P g → 0 < p) :
    cleanFullMemoryActiveMap (fun x r =>
      ∑ i, physicalMixedCleanInitialAction initial V b (C i) ζ θ ρ k (K i) d
        (cleanFullMemoryActiveMap f) x r) =
    cleanFullMemoryActiveMap (cleanFullMemoryInitialPatternEventAction initial V b C ζ θ ρ k
      (fun i => canonicalMixedEdgeD (C i) d) K d (cleanFullMemoryActiveMap f)) := by
  funext x r
  have hs (F : I → CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ) :
      cleanFullMemoryActiveMap (fun y rs => ∑ i, F i y rs) x r =
        ∑ i, cleanFullMemoryActiveMap (F i) x r := by
    simp only [cleanFullMemoryActiveMap, fullActiveAverage, mul_sum]
    exact sum_comm
  rw [hs]
  change _ = cleanFullMemoryActiveMap (fun y rs =>
    ∑ i, cleanFullMemoryInitialEventAction initial V b (C i) ζ θ ρ k
      (canonicalMixedEdgeD (C i) d) (K i) d (cleanFullMemoryActiveMap f) y rs) x r
  rw [hs]
  apply sum_congr rfl
  intro i _
  exact congrFun (congrFun (physical_mixed_clean_initial_projected_reencode initial V b
    (C i) ζ θ ρ k (K i) d f hf hPs hP) x) r

end

end Bounty
end

