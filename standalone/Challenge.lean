section

/- Exact full-P expansion of the actual box coefficient. -/

open Finset Filter

namespace Bounty

theorem eventually_candidate_box_finite_convolution {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (E R X : ℝ) (U₀ : Finset ℕ) (F : ℕ → ℂ),
      (∀ u ∈ U₀, 0 < u ∧ (u : ℝ) ≤ X) →
      (∑ u ∈ U₀,
        candidateBoxRangeCoefficient c L q r jStar E R u*F u) =
      ∑ p ∈ candidateSmallPSet c L (X+1), (candidatePWeight c L q p : ℂ)*
        ∑ n ∈ orderedSlotProductSupport (candidateQSlotChoices c L r jStar),
          candidateBoxRangeQWeight c L r jStar E R n*
            (if p*n ∈ U₀ then F (p*n) else 0) := by
  classical
  filter_upwards [eventually_candidate_P_pool_below_rough_cutoff hc,
    eventually_ge_atTop (0 : ℝ)] with L hpool hL
  intro q r jStar E R X U₀ F hU₀
  let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
  let S := candidateSmallPSet c L (X+1)
  let B := orderedSlotProductSupport (candidateQSlotChoices c L r jStar)
  let U := U₀
  let T := (S ×ˢ B).image (fun z => z.1*z.2)
  have hS : ∀ p ∈ S, p ∈ Nat.factoredNumbers P := fun p hp =>
    ((mem_candidateSmallPSet_iff c L _ p).mp hp).2
  have hB : ∀ n ∈ B, n ≠ 0 ∧ Disjoint n.primeFactors P := by
    intro n hn
    obtain ⟨x,hx,rfl⟩ := mem_image.mp hn
    exact ⟨prod_ne_zero_iff.mpr (fun slot _ =>
      candidate_Q_slot_nonzero c L r jStar slot (x slot).property),
      candidate_Q_tuple_primeFactors_disjoint (mul_nonneg hc.le hL) hpool x⟩
  have hreindex := supported_free_complex_product_reindex P S B hS hB
    (fun p => (candidatePWeight c L q p : ℂ)) (candidateBoxRangeQWeight c L r jStar E R)
    (fun u => if u ∈ U then F u else 0)
  symm
  calc
    _ = ∑ u ∈ T, (candidatePWeight c L q (primePoolPart P u) : ℂ)*
        candidateBoxRangeQWeight c L r jStar E R (primePoolFreePart P u)*
        (if u ∈ U then F u else 0) := by
      simp_rw [mul_sum, ← mul_assoc]
      exact hreindex
    _ = ∑ u ∈ T, candidateBoxRangeCoefficient c L q r jStar E R u*
        (if u ∈ U then F u else 0) := by
      apply sum_congr rfl
      intro u hu
      obtain ⟨pn,hpn,rfl⟩ := mem_image.mp hu
      obtain ⟨hp,hn⟩ := mem_product.mp hpn
      obtain ⟨hn0,hnfree⟩ := hB pn.2 hn
      have hp0 := Nat.ne_zero_of_mem_factoredNumbers (hS pn.1 hp)
      rw [primePoolPart_mul_of_free (hS _ hp) hn0 hnfree,
        primePoolFreePart_mul_of_free (hS _ hp) hn0 hnfree]
      unfold candidateBoxRangeCoefficient
      rw [candidate_marked_weight_mul_of_free c L q hn0 hnfree pn.1,
        primePoolFreePart_mul_of_free (hS _ hp) hn0 hnfree,
        candidate_P_weight_eq_marked c L q hp0]
      ring
    _ = ∑ u ∈ T.filter (fun u => u ∈ U), candidateBoxRangeCoefficient c L q r jStar E R u*F u := by
      rw [sum_filter]
      simp only [mul_ite, mul_zero]
    _ = ∑ u ∈ U.filter (fun u => u ∈ T), candidateBoxRangeCoefficient c L q r jStar E R u*F u := by
      congr 1
      ext u
      simp only [mem_filter, and_comm]
    _ = _ := by
      rw [sum_filter]
      apply sum_congr rfl
      intro u hu
      by_cases ht : u ∈ T
      · simp only [ht, if_true]
      · simp only [ht, if_false]
        have hnot : primePoolFreePart P u ∉ B := by
          intro hn
          have hurange := hU₀ u hu
          have hu0 : u ≠ 0 := (hurange.1).ne'
          have hpu : (primePoolPart P u : ℝ) ≤ (u : ℝ) := by
            exact_mod_cast Nat.le_of_dvd (Nat.pos_of_ne_zero hu0) (primePoolPart_dvd P u)
          have hp : primePoolPart P u ∈ S := by
            apply (mem_candidateSmallPSet_iff c L _ _).mpr
            exact ⟨by linarith [hurange.2],primePoolPart_mem_factoredNumbers P u⟩
          exact ht (mem_image.mpr ⟨(primePoolPart P u,primePoolFreePart P u),
            mem_product.mpr ⟨hp,hn⟩,primePoolPart_mul_primePoolFreePart P u⟩)
        have hz := candidate_box_Q_support c L r jStar E R (primePoolFreePart P u) hnot
        change 0 = candidateBoxRangeQWeight c L r jStar E R (primePoolFreePart P u) * _ * _
        rw [hz, zero_mul, zero_mul]

end Bounty
end

