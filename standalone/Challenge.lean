theorem candidate_half_components_of_active_blocks
    (hB : CandidateHalfActiveBlockBounds) : CandidateHalfFixedSlotComponentBounds := by
  intro c r hc hr hcenter κ b N hκ hκmax hb hbq hN
  obtain ⟨D, hD, Jmass, hmass⟩ := exists_candidate_ambient_error_from_blocks hc
