/- Actual count-matched prime proxies are bounded by a uniform reciprocal density. -/

open Finset Filter

namespace Bounty

noncomputable def primeCellProxyCoefficient (L S Y : ℝ) : ℝ :=
  ((primeBand Y (Real.exp (L^(-S))*Y)).card : ℝ) /
    (roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L))).card

theorem exists_prime_cell_proxy_bound {a : ℝ} (ha : 0 < a) :
    ∃ C : ℝ, 0 < C ∧ ∀ S : ℝ, ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ,
      Real.exp (a*L) ≤ Y →
      0 ≤ primeCellProxyCoefficient L S Y ∧ primeCellProxyCoefficient L S Y ≤ 1 ∧
      primeCellProxyCoefficient L S Y ≤
        C/(L*(∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1-1/(p : ℝ)))) := by
  obtain ⟨C, hC, hprime⟩ := exists_prime_logarithmic_cell_upper ha
  refine ⟨2*C, by positivity, ?_⟩
  intro S
  filter_upwards [hprime S, eventually_rough_logarithmic_cell_count_pos ha S,
    eventually_sqrt_le_dyadic_scale ha 0, eventually_gt_atTop (0 : ℝ)] with L hprimeL hrough hsqrt hL
  intro Y hY
  let V := ∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1-1/(p : ℝ))
  let len := Real.exp (L^(-S))*Y-Y
  let P := primeBand Y (Real.exp (L^(-S))*Y)
  let R := roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L))
  have hV : 0 < V := finite_prime_avoidance_product_pos _ (fun _ hp => (mem_filter.mp hp).2)
  have hR : (0 : ℝ) < R.card := Nat.cast_pos.mpr (hrough Y hY).1
  have hRlower : len*V/2 ≤ (R.card : ℝ) := (hrough Y hY).2.1
  have hW : Real.exp (Real.sqrt L) ≤ Y := by
    apply le_trans _ hY
    apply Real.exp_le_exp.mpr
    simpa only [pow_zero, div_one] using hsqrt
  have hsub : P ⊆ R := prime_band_subset_rough_band hW
  have hunit := finite_cell_count_proxy R P hsub (hrough Y hY).1
  refine ⟨hunit.1, hunit.2.1, ?_⟩
  change (P.card : ℝ)/(R.card : ℝ) ≤ (2*C)/(L*V)
  apply (div_le_iff₀ hR).mpr
  calc
    _ ≤ C*len/L := hprimeL Y hY
    _ = ((2*C)/(L*V))*(len*V/2) := by field_simp
    _ ≤ _ := mul_le_mul_of_nonneg_left hRlower (by positivity)

end Bounty
