    {c:(_root_.OAI.ActualEisensteinCubic.O)} {h:(_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {c}} (G:FixedFourierGeometry c h)
    (I F Q Q0:Ideal (_root_.OAI.ActualEisensteinCubic.O)) (hI:I≠0) (hQ:Q≠0)
    (K levelBound:ℝ) (hbound:G.levelScale≤levelBound)
