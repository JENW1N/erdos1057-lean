section

/- Exact spectator factorization for the mixed model with injective small
mark lists and unrestricted big-group pending memory. These identities do
not identify that model with the unrestricted all-group memory model.
At each fixed small prefix and auxiliary draw, event coefficients and
big-state targets are independent of the small completion being summed.
The small target residue may be chosen separately for each auxiliary draw. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_condition_weighted_sum
    {G E : Type*} [Fintype G] [DecidableEq G] [Fintype E]
    {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (q : ℝ) (r : PhysicalResidues P) (d : PhysicalSharedLists P J)
    (a : E → ℂ) (f : E → PhysicalMarkLists P J ell → ℂ) :
    physicalSmallCondition V q r d (fun L => ∑ e, a e * f e L) =
      ∑ e, a e * physicalSmallCondition V q r d (f e) := by
  simp only [physical_small_condition_eq_vertex_sum, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro L _
  by_cases h : physicalSharedPrefix L = d
  · simp only [if_pos h, mul_sum]
    apply sum_congr rfl
    intro e _
    ring
  · simp only [if_neg h, mul_zero, sum_const_zero]




/- The existing physical small-group bilinear factorization with a finite
big-event continuation kept explicit. The index type may depend on the
retained small prefix; its weights may also depend on the translated small
residue. This is applied separately for each fixed auxiliary draw. -/
theorem physical_small_bilinear_events_with_prefix
    {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (q ζ : ℝ) (k : ℤ) (r : PhysicalResidues P)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (E : PhysicalSharedLists P J → Type*) [∀ d, Fintype (E d)]
    (a : ∀ d, PhysicalResidues P → E d → ℂ)
    (f : PhysicalMarkLists P J ell → ℂ)
    (g : ∀ d, E d → PhysicalResidues P → PhysicalMarkLists P J ell → ℂ) :
    let tr := fun d : PhysicalSharedLists P J =>
      physicalTranslateResidues r (k * (physicalSharedProduct d : ℕ))
    (∑ L, ∑ R, (physicalStateMass V J ell : ℂ) * (starRingEnd ℂ) (f L) *
      physicalBarePatternScalar V (fun _ => (∅ : Finset (Fin J))) ζ
        (fun L _ _ => κ (physicalSharedPrefix L)) aux L R *
      ((physicalResidueVertexWeight L (Real.sqrt q) r *
        physicalResidueVertexWeight R (Real.sqrt q) (tr (physicalSharedPrefix L)) : ℝ) : ℂ) *
      (∑ e : E (physicalSharedPrefix L),
        a (physicalSharedPrefix L) (tr (physicalSharedPrefix L)) e *
          g (physicalSharedPrefix L) e (tr (physicalSharedPrefix L)) R)) =
    ∑ d, (starRingEnd ℂ) (physicalSmallCondition V q r d f) *
      (κ d * physicalPhase ζ (physicalSharedProduct d)) *
      (∑ e : E d, a d (tr d) e * physicalSmallCondition V q (tr d) d (g d e (tr d))) := by
  intro tr
  rw [physical_small_bilinear_factorization_with_prefix V hV q ζ k r aux κ f
    (fun d s R => ∑ e : E d, a d s e * g d e s R)]
  apply sum_congr rfl
  intro d _
  rw [physical_small_condition_weighted_sum]

/- The full big-active-slot projection also commutes with the small
conditioning map. This retains the adjacent active averages in the mixed
operator factorization. -/
theorem physical_small_condition_full_active_average
    {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {J ell : ℕ}
    (Vs : S → ℝ) (q : ℝ) (r : PhysicalResidues Ps) (d : PhysicalSharedLists Ps J)
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z M B → PhysicalMarkLists Ps J ell → ℂ)
    (x : ProductBoundedOrderedState P Z M B) :
    physicalSmallCondition Vs q r d (fun L => fullActiveAverage (fun y => f y L) x) =
      fullActiveAverage (fun y => physicalSmallCondition Vs q r d (f y)) x := by
  unfold fullActiveAverage
  exact physical_small_condition_weighted_sum Vs q r d
    (fun τ => (fullActivePermutationWeight M τ : ℂ))
    (fun τ => f (fullActivePermutation τ x))

end Bounty
end

section

/- Uniform small-source permutation rarity with an arbitrary fixed big
factor. Only the small source lists are injective; the big factor may come
from repeated active labels, and pending particle indices may repeat values. -/

open Finset
open scoped Classical

namespace Bounty

def smallSourcePrimeOmissions {S : Type*} {P : S → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell)
    (A : GroupedOmissionSubsets S (PhysicalSlots J ell) ell) :
    PrimeOmissionChoices (physicalGroupMarks labels) ell :=
  fun g => ⟨(A g).val.map (physicalGroupMarkEmbedding labels g),
    mem_powersetCard.mpr ⟨map_subset_map.mpr (mem_powersetCard.mp (A g).property).1,
      by simpa only [card_map] using (mem_powersetCard.mp (A g).property).2⟩⟩

theorem small_source_prime_omissions_injective {S : Type*}
    {P : S → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell) :
    Function.Injective (smallSourcePrimeOmissions labels) := by
  intro A B h
  funext g
  apply Subtype.ext
  apply map_injective (physicalGroupMarkEmbedding labels g)
  exact congrArg Subtype.val (congrFun h g)

noncomputable def smallSourcePermutationDilation {S : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell)
    (D_B : ℕ) (σ : S → Equiv.Perm (PhysicalSlots J ell)) : ℕ :=
  D_B * ∏ g, ∏ j : Fin J, (labels g (σ g (Sum.inl j))).val

theorem small_source_permutation_dilation_eq {S : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ} (labels : PhysicalMarkLists P J ell)
    (D_B : ℕ) (σ : S → Equiv.Perm (PhysicalSlots J ell)) :
    smallSourcePermutationDilation labels D_B σ =
      primeOmissionDilation (physicalGroupMarks labels) ell D_B
        (smallSourcePrimeOmissions labels
          (groupedPermutedOmissions (physicalOmissionSlots J ell)
            (physical_omission_slots_card J ell) σ)) := by
  unfold smallSourcePermutationDilation primeOmissionDilation primeRetainedProduct
  congr 1
  apply prod_congr rfl
  intro g _
  have he : (smallSourcePrimeOmissions labels
      (groupedPermutedOmissions (physicalOmissionSlots J ell)
        (physical_omission_slots_card J ell) σ) g).val =
      physicalLastMarks (physicalPermuteLabels σ labels) g := by
    simp only [smallSourcePrimeOmissions, groupedPermutedOmissions, permutedOmissionSubset,
      physicalOmissionSlots, physicalLastMarks, map_map]
    congr 1
  rw [he, ← physical_group_marks_permute σ labels g, physical_group_marks_sdiff_last]
  simp only [physicalFirstMarks, prod_map, Function.Embedding.trans_apply,
    Function.Embedding.inl_apply, physicalGroupMarkEmbedding, physicalPermuteLabels]
  rfl

theorem small_source_permutation_eligible_fraction_le {S Particle : Type*}
    [Fintype S] {P : S → Finset ℕ} {J ell : ℕ}
    (labels : PhysicalMarkLists P J ell)
    (hP : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (D_B : ℕ) (pending : Finset Particle) (p : Particle → ℕ)
    (hp : ∀ z, (p z).Prime) (r : ∀ z, ZMod (p z)) (k : ℤ)
    (hk : ∀ z ∈ pending, ¬ (p z : ℤ) ∣ k)
    (hlt : ∀ z ∈ pending, ∀ A : PrimeOmissionChoices (physicalGroupMarks labels) ell,
      primeOmissionProduct (physicalGroupMarks labels) ell A < p z) :
    letI : DecidableEq S := Classical.decEq _
    letI : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
    ((univ.filter (fun σ : S → Equiv.Perm (PhysicalSlots J ell) =>
        ∃ z ∈ pending, ¬ p z ∣ smallSourcePermutationDilation labels D_B σ ∧
          r z + (k : ZMod (p z)) * (smallSourcePermutationDilation labels D_B σ : ZMod (p z)) = 0)).card : ℝ) /
        (Fintype.card (S → Equiv.Perm (PhysicalSlots J ell)) : ℝ) ≤
      (pending.card : ℝ) / (((J + ell).choose ell) ^ Fintype.card S : ℕ) := by
  let _ : DecidableEq S := Classical.decEq _
  let _ : DecidableEq (PhysicalSlots J ell) := Classical.decEq _
  let U := fun A : GroupedOmissionSubsets S (PhysicalSlots J ell) ell =>
    primeOmissionProduct (physicalGroupMarks labels) ell (smallSourcePrimeOmissions labels A)
  let D := fun A : GroupedOmissionSubsets S (PhysicalSlots J ell) ell =>
    primeOmissionDilation (physicalGroupMarks labels) ell D_B (smallSourcePrimeOmissions labels A)
  let bad := rareOmissionChoices univ pending
    (fun z A => ¬ p z ∣ D A ∧ r z + (k : ZMod (p z)) * (D A : ZMod (p z)) = 0)
  have hU : Function.Injective U :=
    (prime_omission_product_injective (physicalGroupMarks labels) ell
      (fun g q hq => hP g q (physical_group_marks_subset labels g hq))
      (fun g h hne => (hdis hne).mono (physical_group_marks_subset labels g)
        (physical_group_marks_subset labels h))).comp (small_source_prime_omissions_injective labels)
  have hbad : bad.card ≤ pending.card :=
    modular_eligible_omission_card_le univ pending U hU p hp (fun _ => D)
      (fun _ => D_B * primeFullProduct (physicalGroupMarks labels))
      (fun _ A => prime_omission_mul_dilation_eq (physicalGroupMarks labels) ell D_B
        (smallSourcePrimeOmissions labels A)) r k hk
      (fun z hz A => hlt z hz (smallSourcePrimeOmissions labels A))
  have hevent (σ : S → Equiv.Perm (PhysicalSlots J ell)) :
      groupedPermutedOmissions (physicalOmissionSlots J ell) (physical_omission_slots_card J ell) σ ∈ bad ↔
      ∃ z ∈ pending, ¬ p z ∣ smallSourcePermutationDilation labels D_B σ ∧
        r z + (k : ZMod (p z)) * (smallSourcePermutationDilation labels D_B σ : ZMod (p z)) = 0 := by
    simp only [bad, rareOmissionChoices, mem_filter, mem_univ, true_and, D,
      ← small_source_permutation_dilation_eq]
  have h := grouped_uniform_bad_omission_fraction_le (physicalOmissionSlots J ell)
    (physical_omission_slots_card J ell) bad pending.card hbad
  have hslots : Fintype.card (PhysicalSlots J ell) = J + ell := by
    simp only [PhysicalSlots, Fintype.card_sum, Fintype.card_fin]
  rw [hslots] at h
  simpa only [hevent] using h

end Bounty
end

section

/- Exact bilinear transposition under the product factorial memory law.
Coordinate transposes reverse composition order, while independent local
event sums do not depend on the order of distinct coordinates. -/

open Finset Classical

namespace Bounty

theorem finite_coordinate_compose_append {I : Type*} [DecidableEq I]
    {X : I → Type*} (A : ∀ i, (X i → ℂ) → X i → ℂ) (is js : List I)
    (f : (∀ i, X i) → ℂ) :
    finiteCoordinateCompose A (is ++ js) f =
      finiteCoordinateCompose A is (finiteCoordinateCompose A js f) := by
  induction is with
  | nil => rfl
  | cons i is ih => simp only [List.cons_append, finiteCoordinateCompose, ih]

theorem finite_product_bilinear_split {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ) (i : I)
    (f g : (∀ i, X i) → ℂ) :
    (∑ x, (finiteProductWeight μ x : ℂ) * f x * g x) =
      ∑ z : (∀ j : {j : I // j ≠ i}, X j.val),
        ((∏ j, μ j.val (z j) : ℝ) : ℂ) *
          ∑ y : X i, (μ i y : ℂ) * f ((Equiv.piSplitAt i X).symm (y, z)) *
            g ((Equiv.piSplitAt i X).symm (y, z)) := by
  let E := Equiv.piSplitAt i X
  rw [← E.symm.sum_comp, Fintype.sum_prod_type, sum_comm]
  apply sum_congr rfl
  intro z hz
  rw [mul_sum]
  apply sum_congr rfl
  intro y hy
  rw [finite_product_weight_split μ i]
  have hE := E.apply_symm_apply (y, z)
  have hfirst : E.symm (y, z) i = y := congrArg Prod.fst hE
  have hrest : (fun j : {j : I // j ≠ i} => E.symm (y, z) j.val) = z :=
    congrArg Prod.snd hE
  have hprod : (∏ j : {j : I // j ≠ i}, μ j.val (E.symm (y, z) j.val)) =
      ∏ j, μ j.val (z j) := congrArg (fun q => ∏ j, μ j.val (q j)) hrest
  rw [hfirst, hprod, Complex.ofReal_mul]
  ring

theorem product_memory_pi_slice_symmetric {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ} (i : G)
    (f : ProductBoundedOrderedState P Z t B → ℂ) (hf : ProductMemorySymmetric f)
    (z : ∀ j : {j : G // j ≠ i}, BoundedOrderedState (P j.val) (Z j.val) (t j.val) B) :
    BoundedOrderedSymmetric (fun y => f ((Equiv.piSplitAt i
      (fun j => BoundedOrderedState (P j) (Z j) (t j) B)).symm (y, z))) := by
  intro active N q τ
  let E := Equiv.piSplitAt i (fun j => BoundedOrderedState (P j) (Z j) (t j) B)
  let x := E.symm ((active, ⟨N, q⟩), z)
  have hx : x i = (active, ⟨N, q⟩) := congrArg Prod.fst (E.apply_symm_apply _)
  have hp : BoundedMemoryPermutationRelation (x i) (active, ⟨N, q ∘ τ⟩) := by
    rw [hx]
    exact ⟨τ, rfl⟩
  have h := (product_memory_symmetric_iff_coordinate f).mp hf i x _ hp
  have he : Function.update x i (active, ⟨N, q ∘ τ⟩) =
      E.symm ((active, ⟨N, q ∘ τ⟩), z) := by
    rw [← finite_split_replace_eq_update]
    simp only [x, E, Equiv.apply_symm_apply]
  rw [he] at h
  exact h

theorem product_memory_coordinate_pairing {G : Type*} [Fintype G] [dG : DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {t : G → ℕ} {B : ℕ} (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ) (i : G)
    (A R : (BoundedOrderedState (P i) (Z i) (t i) B → ℂ) →
      BoundedOrderedState (P i) (Z i) (t i) B → ℂ)
    (hpair : ∀ f g, BoundedOrderedSymmetric f → BoundedOrderedSymmetric g →
      (∑ x, (boundedOrderedStateWeight (μ i) (ν i) x : ℂ) * f x * A g x) =
        ∑ x, (boundedOrderedStateWeight (μ i) (ν i) x : ℂ) * R f x * g x)
    (f g : ProductBoundedOrderedState P Z t B → ℂ)
    (hf : ProductMemorySymmetric f) (hg : ProductMemorySymmetric g) :
    (∑ x, (productMemoryWeight μ ν x : ℂ) * f x * finiteCoordinateLift i A g x) =
      ∑ x, (productMemoryWeight μ ν x : ℂ) * finiteCoordinateLift i R f x * g x := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  change (∑ x, (finiteProductWeight (fun j => boundedOrderedStateWeight (μ j) (ν j)) x : ℂ) *
    f x * finiteCoordinateLift i A g x) =
      ∑ x, (finiteProductWeight (fun j => boundedOrderedStateWeight (μ j) (ν j)) x : ℂ) *
        finiteCoordinateLift i R f x * g x
  rw [finite_product_bilinear_split (fun j => boundedOrderedStateWeight (μ j) (ν j)) i,
    finite_product_bilinear_split (fun j => boundedOrderedStateWeight (μ j) (ν j)) i]
  apply sum_congr rfl
  intro z hz
  congr 1
  simp only [finite_coordinate_lift_split]
  have hp := hpair _ _ (product_memory_pi_slice_symmetric i f hf z)
    (product_memory_pi_slice_symmetric i g hg z)
  refine Eq.trans ?_ (Eq.trans hp ?_)
  all_goals
    apply sum_congr
    · exact congrArg (fun inst : Fintype _ => @Finset.univ _ inst) (Subsingleton.elim _ _)
    · intro x hx; rfl

theorem product_memory_compose_pairing_reverse {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {t : G → ℕ} {B : ℕ} (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (A R : ∀ i, (BoundedOrderedState (P i) (Z i) (t i) B → ℂ) →
      BoundedOrderedState (P i) (Z i) (t i) B → ℂ)
    (hA : ∀ i f, BoundedOrderedSymmetric f → BoundedOrderedSymmetric (A i f))
    (hR : ∀ i f, BoundedOrderedSymmetric f → BoundedOrderedSymmetric (R i f))
    (hpair : ∀ i f g, BoundedOrderedSymmetric f → BoundedOrderedSymmetric g →
      (∑ x, (boundedOrderedStateWeight (μ i) (ν i) x : ℂ) * f x * A i g x) =
        ∑ x, (boundedOrderedStateWeight (μ i) (ν i) x : ℂ) * R i f x * g x)
    (is : List G) (f g : ProductBoundedOrderedState P Z t B → ℂ)
    (hf : ProductMemorySymmetric f) (hg : ProductMemorySymmetric g) :
    (∑ x, (productMemoryWeight μ ν x : ℂ) * f x * finiteCoordinateCompose A is g x) =
      ∑ x, (productMemoryWeight μ ν x : ℂ) * finiteCoordinateCompose R is.reverse f x * g x := by
  induction is generalizing f with
  | nil => rfl
  | cons i is ih =>
    change (∑ x, (productMemoryWeight μ ν x : ℂ) * f x *
      finiteCoordinateLift i (A i) (finiteCoordinateCompose A is g) x) = _
    rw [product_memory_coordinate_pairing μ ν i (A i) (R i) (hpair i) f
      (finiteCoordinateCompose A is g) hf (product_memory_compose_symmetric A hA is g hg)]
    have hf' : ProductMemorySymmetric (finiteCoordinateLift i (R i) f) :=
      product_memory_compose_symmetric R hR [i] f hf
    rw [ih _ hf']
    simp only [List.reverse_cons, finite_coordinate_compose_append, finiteCoordinateCompose]

/- Reversing a list of distinct independent local event actions does not
alter its operator, including for signed event weights. -/
theorem finite_local_event_compose_reverse {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)]
    (E : ∀ i, X i → Type*) [∀ i x, Fintype (E i x)]
    (weight : ∀ i x, E i x → ℝ) (target : ∀ i x, E i x → X i)
    (is : List I) (his : is.Nodup) (f : (∀ i, X i) → ℂ) :
    finiteCoordinateCompose (finiteLocalEventAction E weight target) is.reverse f =
      finiteCoordinateCompose (finiteLocalEventAction E weight target) is f := by
  have hf : f = fun z => ∑ y : (∀ i, X i),
      f y * ∏ i, (if z i = y i then (1 : ℂ) else 0) :=
    funext (finite_product_delta_expansion f)
  rw [hf]
  funext x
  simp only [finite_local_event_compose_sum, finite_local_event_compose_const_mul]
  apply sum_congr rfl
  intro y hy
  rw [finite_local_event_compose_prod E weight target is.reverse (List.nodup_reverse.mpr his)
      (fun i a => if a = y i then (1 : ℂ) else 0) x,
    finite_local_event_compose_prod E weight target is his
      (fun i a => if a = y i then (1 : ℂ) else 0) x]
  simp only [List.mem_reverse]

end Bounty
end

section

/- A fixed shared-coordinate and auxiliary fiber has the same coefficient
on both sides of a bilinear transpose. Reassembly introduces no factor for
the number of fibers or auxiliary choices. -/

open Finset Classical

namespace Bounty




