/- The actual alternating selected visit/edge schedule for a fixed original path. -/

open scoped Classical

namespace Bounty

noncomputable def physicalMarkAtCut {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    (L : Fin (n + 1) → PhysicalMarkLists P J ell) (i : ℕ) : PhysicalMarkLists P J ell :=
  L ⟨min (i / 2) n, Nat.lt_succ_of_le (min_le_right _ _)⟩

section

variable
  {N J ell n : ℕ}
  {P : Fin N → Finset ℕ}
  (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (j : Fin (n + 1))

include N J ell n P L j

theorem physical_mark_at_cut_even  :
    physicalMarkAtCut L (2 * j.val) = L j := by
  unfold physicalMarkAtCut
  congr 1
  apply Fin.ext
  have := j.isLt
  dsimp
  omega

theorem physical_mark_at_cut_odd  :
    physicalMarkAtCut L (2 * j.val + 1) = L j := by
  unfold physicalMarkAtCut
  congr 1
  apply Fin.ext
  have := j.isLt
  dsimp
  omega

end


section Schedule
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (β : (g : Fin N) → ↥(P g) → ℝ) (V : Fin N → ℝ) (ρ : ℝ)
  (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

noncomputable def physicalSelectedCoarseRow (i : ℕ)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    PhysicalBoundedMarkState P J ell B → ℂ :=
  if hi : i < 2 * n + 1 then
    if he : i % 2 = 0 then
      let j : Fin (n + 1) := ⟨i / 2, by omega⟩
      physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
        (fun o t => if o = .inr none ∧ t.1 = L j then F t else 0)
    else
      let j : Fin n := ⟨i / 2, by omega⟩
      physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j (aux j) (σ j) (τ j)
        (L j.succ) F
  else fun _ => 0

noncomputable def physicalSelectedCoarseScalar (i : ℕ) : ℂ :=
  if hi : i < 2 * n + 1 then
    if he : i % 2 = 0 then 1
    else
      let j : Fin n := ⟨i / 2, by omega⟩
      (((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) ^ 2) *
        (ω j (physicalSharedMarkLabels (C j) (physicalPermuteLabels (σ j) (L j.castSucc)))
          (aux j) : ℂ)
  else 1

theorem physical_selected_coarse_row_even (j : Fin (n + 1))
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalSelectedCoarseRow C aux k L σ τ β V ρ hV ω retention (2 * j.val) F =
      physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
        (fun o t => if o = .inr none ∧ t.1 = L j then F t else 0) := by
  have hj := j.isLt
  have hi : 2 * j.val < 2 * n + 1 := by omega
  have he : (2 * j.val) % 2 = 0 := by omega
  have hd : (2 * j.val) / 2 = j.val := by omega
  have hjEq (h : (2 * j.val) / 2 < n + 1) : (⟨(2 * j.val) / 2, h⟩ : Fin (n + 1)) = j := Fin.ext hd
  unfold physicalSelectedCoarseRow
  rw [dif_pos hi, dif_pos he]
  simp only [hjEq]
  congr 1
  funext o t
  split_ifs <;> rfl

theorem physical_selected_coarse_row_odd (j : Fin n)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalSelectedCoarseRow C aux k L σ τ β V ρ hV ω retention (2 * j.val + 1) F =
      physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j (aux j) (σ j) (τ j)
        (L j.succ) F := by
  have hj := j.isLt
  have hi : 2 * j.val + 1 < 2 * n + 1 := by omega
  have he : ¬ (2 * j.val + 1) % 2 = 0 := by omega
  have hd : (2 * j.val + 1) / 2 = j.val := by omega
  have hjEq (h : (2 * j.val + 1) / 2 < n) : (⟨(2 * j.val + 1) / 2, h⟩ : Fin n) = j := Fin.ext hd
  unfold physicalSelectedCoarseRow
  rw [dif_pos hi, dif_neg he]
  exact congrArg (fun t : Fin n =>
    physicalSelectedStateEdgeBlock C k ω β retention ρ V hV t (aux t) (σ t) (τ t)
      (L t.succ) F) (hjEq _)

theorem physical_selected_coarse_scalar_even (j : Fin (n + 1)) :
    physicalSelectedCoarseScalar C aux L σ ω (2 * j.val) = 1 := by
  have hj := j.isLt
  have hi : 2 * j.val < 2 * n + 1 := by omega
  have he : (2 * j.val) % 2 = 0 := by omega
  simp only [physicalSelectedCoarseScalar, dif_pos hi, dif_pos he]

theorem physical_selected_coarse_scalar_odd (j : Fin n) :
    physicalSelectedCoarseScalar C aux L σ ω (2 * j.val + 1) =
      (((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) ^ 2) *
        (ω j (physicalSharedMarkLabels (C j) (physicalPermuteLabels (σ j) (L j.castSucc)))
          (aux j) : ℂ) := by
  have hj := j.isLt
  have hi : 2 * j.val + 1 < 2 * n + 1 := by omega
  have he : ¬ (2 * j.val + 1) % 2 = 0 := by omega
  have hd : (2 * j.val + 1) / 2 = j.val := by omega
  have hjEq (h : (2 * j.val + 1) / 2 < n) : (⟨(2 * j.val + 1) / 2, h⟩ : Fin n) = j := Fin.ext hd
  unfold physicalSelectedCoarseScalar
  rw [dif_pos hi, dif_neg he]
  exact congrArg (fun t : Fin n =>
    (((Fintype.card (PhysicalPermutations (Fin N) J ell) : ℝ)⁻¹ : ℂ) ^ 2) *
      (ω t (physicalSharedMarkLabels (C t) (physicalPermuteLabels (σ t) (L t.castSucc)))
        (aux t) : ℂ)) (hjEq _)

end Schedule
end Bounty
end

