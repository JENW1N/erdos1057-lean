    rw [physicalSelectedCumulativeOffset, Fin.partialSum_zero]
    exact physical_path_selected_offset_zero C k _ _
  | succ j ih =>
    rw [physical_root_numbered_plan_offset_step, ih,
      physicalSelectedCumulativeOffset, Fin.partialSum_succ]

