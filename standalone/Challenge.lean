section

/- Fourier inversion over precisely the active allocation slots. -/

open Finset MeasureTheory

namespace Bounty

abbrev ActiveAllocationIndex {N : ℕ} (active : Fin N → Bool) :=
  {i : Fin N // active i = true}

noncomputable def activeAllocationFourierWeight {N : ℕ} (A : ℝ)
    (active take : Fin N → Bool) (ξ : ActiveAllocationIndex active → ℝ) : ℂ :=
  ∏ i, typeIICutoffFourier A (take i.val) (ξ i)

noncomputable def activeAllocationFourierIntegrand {N : ℕ} (A R : ℝ)
    (v s : Fin N → ℝ) (active take : Fin N → Bool)
    (ξ : ActiveAllocationIndex active → ℝ) : ℂ :=
  ∏ i, typeIICutoffFourierIntegrand A (take i.val)
    ((allocationPrefixResidual v R take i.val - v i.val) / s i.val) (ξ i)

theorem compact_allocation_active_product {N : ℕ} (A R : ℝ)
    (v s : Fin N → ℝ) (active take : Fin N → Bool)
    (hkeep : ∀ i, active i = false → take i = false) :
    compactAllocationWeight A N v s active R take =
      ∏ i : ActiveAllocationIndex active,
        typeIISmoothCutoff A (take i.val)
          ((allocationPrefixResidual v R take i.val - v i.val) / s i.val) := by
  classical
  unfold compactAllocationWeight
  calc
    _ = ∏ i, if active i = true then typeIISmoothCutoff A (take i)
        ((allocationPrefixResidual v R take i - v i) / s i) else 1 := by
      apply prod_congr rfl
      intro i hi
      cases ha : active i
      · simp [compactSlotTransition, hkeep i ha]
      · simp [compactSlotTransition]
    _ = ∏ i ∈ univ.filter (fun i => active i = true), typeIISmoothCutoff A (take i)
        ((allocationPrefixResidual v R take i - v i) / s i) := (prod_filter _ _).symm
    _ = _ := prod_subtype _ (by simp) _













theorem active_allocation_fourier_l1_le {N : ℕ} (A C : ℝ)
    (hC1 : 1 ≤ C)
    (hC : ∀ take : Bool, (∫ ξ : ℝ, ‖typeIICutoffFourier A take ξ‖) ≤ C)
    (active take : Fin N → Bool) :
    (∫ ξ : ActiveAllocationIndex active → ℝ,
      ‖activeAllocationFourierWeight A active take ξ‖) ≤ C ^ N := by
  simp only [activeAllocationFourierWeight, norm_prod]
  rw [integral_fintype_prod_volume_eq_prod
    (fun (i : ActiveAllocationIndex active) (ξ : ℝ) =>
      ‖typeIICutoffFourier A (take i.val) ξ‖)]
  calc
    _ ≤ ∏ _i : ActiveAllocationIndex active, C :=
      prod_le_prod₀ (fun _ _ => integral_nonneg (fun _ => norm_nonneg _))
        (fun i _ => hC (take i.val))
    _ = C ^ Fintype.card (ActiveAllocationIndex active) := by simp
    _ ≤ C ^ N := by
      apply pow_le_pow_right₀ hC1
      simpa only [Fintype.card_fin] using Fintype.card_subtype_le (fun i => active i = true)

end Bounty

