section

/- Exact full cutoff-box energy from central shifted energy and a controlled tail. -/

open Finset MeasureTheory

namespace Bounty

theorem harmonic_normalized_full_box_energy {Y : ℝ} (hY : 0 < Y)
    (a b R Eall Ecentral w : ℝ) (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ z ∈ B, 0 < z) (hC : ∀ z ∈ C, 0 < z)
    (hall : ∀ u, (∫ s in Set.Icc a b,
      ‖(∑ d ∈ D, δ d * harmonicMellinWeight (s+w+2*Real.pi*u) d) *
        (∑ z ∈ A, α z * harmonicMellinWeight (s+w+2*Real.pi*u) z) *
        (∑ z ∈ B, β z * harmonicMellinWeight (s+w+2*Real.pi*u) z) *
        (∑ z ∈ C, γ z * harmonicMellinWeight (s+w+2*Real.pi*u) z)‖^2) ≤ Eall)
    (hcentral : ∀ u, ‖u‖ ≤ R → (∫ s in Set.Icc a b,
      ‖(∑ d ∈ D, δ d * harmonicMellinWeight (s+w+2*Real.pi*u) d) *
        (∑ z ∈ A, α z * harmonicMellinWeight (s+w+2*Real.pi*u) z) *
        (∑ z ∈ B, β z * harmonicMellinWeight (s+w+2*Real.pi*u) z) *
        (∑ z ∈ C, γ z * harmonicMellinWeight (s+w+2*Real.pi*u) z)‖^2) ≤ Ecentral) :
    (∫ s in Set.Icc a b,
      ‖∑ d ∈ D, ∑ x ∈ A, ∑ y ∈ B, ∑ z ∈ C,
        (δ d * α x * β y * γ z) *
          ((harmonicCommonCutoff (((d*x*y*z : ℕ) : ℝ) / Y) /
            ((d*x*y*z : ℕ) : ℝ) : ℝ) : ℂ) *
          physicalMellinPhase (s+w) ((d*x*y*z : ℕ) : ℝ)‖^2) ≤
      2*(∫ u in {u : ℝ | R < ‖u‖}, ‖harmonicWindowLogFourier u‖)^2*Eall +
      2*(∫ u in {u : ℝ | ‖u‖ ≤ R}, ‖harmonicWindowLogFourier u‖)^2*Ecentral := by
  let P : ℝ → ℂ := fun s =>
    ∑ d ∈ D, ∑ x ∈ A, ∑ y ∈ B, ∑ z ∈ C,
      (δ d * α x * β y * γ z) *
        ((harmonicCommonCutoff (((d*x*y*z : ℕ) : ℝ) / Y) /
          ((d*x*y*z : ℕ) : ℝ) : ℝ) : ℂ) *
        physicalMellinPhase (s+w) ((d*x*y*z : ℕ) : ℝ)
  let Q : ℝ → ℂ := fun s =>
    ∫ u in {u : ℝ | ‖u‖ ≤ R},
      harmonicWindowLogFourier u * physicalMellinPhase (-2*Real.pi*u) Y *
        ((∑ d ∈ D, δ d * harmonicMellinWeight (s+w+2*Real.pi*u) d) *
          (∑ z ∈ A, α z * harmonicMellinWeight (s+w+2*Real.pi*u) z) *
          (∑ z ∈ B, β z * harmonicMellinWeight (s+w+2*Real.pi*u) z) *
          (∑ z ∈ C, γ z * harmonicMellinWeight (s+w+2*Real.pi*u) z))
  have ht := harmonic_normalized_four_box_integrated_tail_shifted hY a b R Eall w
    D A B C δ α β γ hD hA hB hC hall
  have hc := harmonic_normalized_four_box_truncated_energy a b Y R Ecentral w
    D A B C δ α β γ hD hA hB hC hcentral
  have hPc : Continuous P := by dsimp [P,physicalMellinPhase]; fun_prop
  have herr (s : ℝ) : P s - Q s =
      harmonicNormalizedFourBoxError Y (s+w) R D A B C δ α β γ := rfl
  have he : Integrable (fun s => ‖P s - Q s‖^2) (volume.restrict (Set.Icc a b)) := by
    simpa only [IntegrableOn,herr] using ht.1
  have hq : Integrable (fun s => ‖Q s‖^2) (volume.restrict (Set.Icc a b)) := hc.1
  have htb : (∫ s in Set.Icc a b, ‖P s - Q s‖^2) ≤
      (∫ u in {u : ℝ | R < ‖u‖}, ‖harmonicWindowLogFourier u‖)^2*Eall := by
    simpa only [herr] using ht.2
  have hcb : (∫ s in Set.Icc a b, ‖Q s‖^2) ≤
      (∫ u in {u : ℝ | ‖u‖ ≤ R}, ‖harmonicWindowLogFourier u‖)^2*Ecentral := hc.2
  have hsplit := integral_square_le_twice_error_add_approximation
    (volume.restrict (Set.Icc a b)) P Q (hPc.norm.pow 2).integrableOn_Icc he hq
  change (∫ s in Set.Icc a b, ‖P s‖^2) ≤ _
  apply hsplit.trans
  simpa only [mul_assoc] using add_le_add
    (mul_le_mul_of_nonneg_left htb (by norm_num : (0 : ℝ) ≤ 2))
    (mul_le_mul_of_nonneg_left hcb (by norm_num : (0 : ℝ) ≤ 2))

end Bounty
end

