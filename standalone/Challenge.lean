section

/- Direct original-candidate to full box-allocation reduction, with rough support. -/

open Finset Filter Real

namespace Bounty

theorem exists_candidate_original_box_reduction {c b q : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hq0 : 0 ≤ q) (hq1 : q < 1) {r : ℕ} (hr : 6 ≤ r) :
    ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ A D : ℝ,
      ∀ᶠ L : ℝ in atTop, ∀ (E : ℝ) (F : ℕ → ℕ → ℂ),
        1 ≤ E → log E ≤ (1-b)*L →
        (∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
        (∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors,
          ¬(∀ p ∈ m.primeFactors, exp (sqrt L) ≤ (p : ℝ)) → F u m = 0) →
        ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
            (candidateCoefficient c L q r jStar u : ℂ)*∑ m ∈ (2*u+1).divisors, F u m) -
          ∑ u ∈ arithmeticProductWindow 1 (exp L),
            candidateBoxRangeCoefficient c L q r jStar E L u*∑ m ∈ (2*u+1).divisors, F u m‖ ≤
          exp L*L^(-D) := by
  obtain ⟨J,hJ⟩ := exists_candidate_compact_divisor_test_reduction hc hb hq0 hq1 hr
  refine ⟨J,fun jStar hj A D => ?_⟩
  filter_upwards [hJ jStar hj A (D+1),
    eventually_candidate_allocation_box_error hc (show 0 < r by omega) hq0 hq1 A (D+1),
    eventually_ge_atTop (2 : ℝ)] with L hcompact hbox hL
  intro E F hE hlogE hF hsupp
  have hL0 : 0 < L := by linarith
  let middle : ℂ := ∑ u ∈ arithmeticProductWindow 1 (exp L),
    (candidateCompactRangeCoefficient c L q r jStar E u : ℂ)*∑ m ∈ (2*u+1).divisors, F u m
  calc
    _ ≤ ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
          (candidateCoefficient c L q r jStar u : ℂ)*∑ m ∈ (2*u+1).divisors, F u m)-middle‖ +
        ‖middle-(∑ u ∈ arithmeticProductWindow 1 (exp L),
          candidateBoxRangeCoefficient c L q r jStar E L u*∑ m ∈ (2*u+1).divisors, F u m)‖ :=
      norm_sub_le_norm_sub_add_norm_sub _ middle _
    _ ≤ exp L*L^(-(D+1))+exp L*L^(-(D+1)) :=
      add_le_add (hcompact E F hE hlogE hF hsupp) (hbox jStar E F hF)
    _ = (2/L)*(exp L*L^(-D)) := by
      rw [show -(D+1) = -D+(-1) by ring, rpow_add hL0, rpow_neg_one]
      ring
    _ ≤ exp L*L^(-D) :=
      mul_le_of_le_one_left (by positivity) ((div_le_one hL0).mpr hL)

end Bounty
