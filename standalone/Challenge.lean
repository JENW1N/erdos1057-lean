section

/- A uniform logarithmic-conductor bound inside the zero-free half-plane. -/

namespace Bounty

open Complex Metric Set OAI.Ostmann

/- The zero-free half-plane controls the logarithmic derivative with a fixed
interior margin. The conductor enters only through a logarithm. -/
def PrimitiveZeroFreeRightOf (b : ℝ) : Prop :=
  ∀ χ : PrimitiveComplexCharacter, ∀ s : ℂ, b < s.re → χ.L s ≠ 0

theorem character_logDeriv_bound_right_of (b : ℝ) (hb : 7 / 8 ≤ b) (hb1 : b ≤ 1)
    (hZ : PrimitiveZeroFreeRightOf b)
    (χ : PrimitiveComplexCharacter) {ε : ℝ} (hε : 0 < ε) (hε1 : ε ≤ 1)
    (s : ℂ) (hs : b + ε ≤ s.re) (hs2 : s.re ≤ 2) :
    ‖logDeriv χ.L s‖ ≤ (36 / ε ^ 2) *
      Real.log (24 * (χ.modulus : ℝ) * (|s.im| + 2)) := by
  let c : ℂ := 2 + (s.im : ℂ) * I
  let R : ℝ := 2 - b - ε / 2
  let g : ℂ → ℂ := fun z => χ.L (z + c)
  let A : ℝ := Real.log (24 * (χ.modulus : ℝ) * (|s.im| + 2))
  have hc : c.re = 2 := by simp [c]
  have hq : (1 : ℝ) ≤ χ.modulus := by exact_mod_cast χ.positive
  have hq0 : (0 : ℝ) < χ.modulus := by linarith
  have hR : 0 < R := by dsimp [R]; linarith
  have hR2 : R < 2 := by dsimp [R]; linarith
  have hA : 0 < A := by
    apply Real.log_pos
    nlinarith [abs_nonneg s.im]
  have hg : AnalyticOnNhd ℂ g (ball 0 R) := by
    intro z hz
    exact (χ.L_analytic (z + c)).comp (f := fun w : ℂ => w + c) (x := z) (by fun_prop)
  have hre (z : ℂ) (hz : z ∈ ball 0 R) : b < (z + c).re := by
    have hn : ‖z‖ < R := by simpa only [mem_ball, dist_zero_right] using hz
    have hr := (abs_le.mp (abs_re_le_norm z)).1
    simp only [add_re, hc]
    dsimp [R] at hn
    linarith
  have hne : ∀ z ∈ ball 0 R, g z ≠ 0 := fun z hz => hZ χ (z + c) (hre z hz)
  have hcnorm : ‖c‖ ≤ 2 + |s.im| := by
    calc
      ‖c‖ ≤ ‖(2 : ℂ)‖ + ‖(s.im : ℂ) * I‖ := norm_add_le _ _
      _ = _ := by simp
  have hnorm (z : ℂ) (hz : z ∈ ball 0 R) :
      ‖g z‖ ≤ 8 * (χ.modulus : ℝ) * (|s.im| + 2) := by
    have hn : ‖z‖ < R := by simpa only [mem_ball, dist_zero_right] using hz
    have hzn : ‖z + c‖ ≤ 2 * (|s.im| + 2) := by
      have hh := norm_add_le z c
      linarith [abs_nonneg s.im]
    have hzr : 1 / 2 ≤ (z + c).re := by linarith [hre z hz]
    calc
      ‖g z‖ ≤ ‖z + c‖ * ((χ.modulus : ℝ) + 1) / (z + c).re :=
        χ.L_norm_bound_positive (z + c) (by linarith)
      _ ≤ (2 * (|s.im| + 2)) * (2 * (χ.modulus : ℝ)) / (1 / 2) := by
        apply div_le_div₀ (by positivity) _ (by norm_num) hzr
        exact mul_le_mul hzn (by linarith) (by positivity) (by positivity)
      _ = _ := by ring
  have hlog : ∀ z ∈ ball 0 R, Real.log ‖g z‖ - Real.log ‖g 0‖ ≤ A := by
    intro z hz
    have h0 : 1 / 3 ≤ ‖g 0‖ := by simpa [g] using χ.L_lower_re_two c hc
    have h0pos : 0 < ‖g 0‖ := by linarith
    have hzpos : 0 < ‖g z‖ := norm_pos_iff.mpr (hne z hz)
    rw [← Real.log_div (ne_of_gt hzpos) (ne_of_gt h0pos)]
    apply Real.log_le_log (div_pos hzpos h0pos)
    apply (div_le_iff₀ h0pos).mpr
    have hh := mul_le_mul_of_nonneg_left h0
      (show 0 ≤ 24 * (χ.modulus : ℝ) * (|s.im| + 2) by positivity)
    nlinarith [hnorm z hz]
  have hw : ‖s - c‖ ≤ R - ε / 2 := by
    have heq : s - c = ((s.re - 2 : ℝ) : ℂ) := by
      apply Complex.ext <;> simp [c]
    rw [heq, norm_real, Real.norm_eq_abs, abs_of_nonpos (by linarith)]
    dsimp [R]
    linarith
  have hb := logDeriv_norm_le_margin_disk g R A (ε / 2) hR hA
    (by positivity) hg hne hlog (s - c) hw
  have hcomp : logDeriv g (s - c) = logDeriv χ.L s := by
    have hh := logDeriv_comp (f := χ.L) (g := fun z : ℂ => z + c) (x := s - c)
      (χ.L_analytic ((s - c) + c)).differentiableAt
      (show DifferentiableAt ℂ (fun z : ℂ => z + c) (s - c) by fun_prop)
    simpa [g, Function.comp_def] using hh
  rw [hcomp] at hb
  calc
    _ ≤ 8 * A * R / (ε / 2) ^ 2 := hb
    _ ≤ 8 * A * (9 / 8) / (ε / 2) ^ 2 := by
      apply div_le_div_of_nonneg_right _ (sq_nonneg _)
      gcongr
      dsimp [R]
      linarith
    _ = _ := by dsimp [A]; field_simp; ring


end Bounty
end

section

/- A uniform parametric finite-unsmoothing estimate. -/

namespace Bounty

open OAI.Ostmann

theorem power_three_scale_le_of_exponent {θ : ℝ} (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1) {x y : ℝ} (hx : 0 < x) (hy : 0 ≤ y) (hyx : y ≤ 3 * x) :
    y ^ θ ≤ 3 * x ^ θ := by
  have hthree : (3 : ℝ) ^ θ ≤ 3 := by
    calc
      _ ≤ (3 : ℝ) ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) hθ1
      _ = _ := Real.rpow_one _
  calc
    _ ≤ (3 * x) ^ θ := Real.rpow_le_rpow hy hyx hθ0
    _ = (3 : ℝ) ^ θ * x ^ θ := Real.mul_rpow (by norm_num) hx.le
    _ ≤ _ := mul_le_mul_of_nonneg_right hthree (Real.rpow_nonneg hx.le _)

/- A triangular bound at exponent θ gives a sharp bound at (1+θ)/2. -/
theorem twistedPsi_bound_of_smoothed_exponent {θ : ℝ} (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1)
    {q : ℕ} (χ : DirichletCharacter ℂ q)
    (hq : 0 < q) {C : ℝ} (hC : 0 < C)
    (hbound : ∀ y : ℝ, 2 ≤ y → ‖smoothedTwistedPsi χ y‖ ≤
      C * y ^ θ * Real.log ((q : ℝ) * y))
    {x : ℝ} (hx : 2 ≤ x) :
    ‖twistedPsi χ x‖ ≤ (28 * C + 6) * x ^ ((1 + θ) / 2) * Real.log ((q : ℝ) * x) := by
  let p : ℝ := x ^ ((1 + θ) / 2)
  let m : ℕ := ⌈p⌉₊
  let L : ℝ := Real.log ((q : ℝ) * x)
  have hx0 : 0 < x := by linarith
  have hq1 : (1 : ℝ) ≤ q := by exact_mod_cast hq
  have hq0 : (0 : ℝ) < q := by exact_mod_cast hq
  have hL : 0 ≤ L := Real.log_nonneg (by nlinarith)
  have hp1 : 1 ≤ p := Real.one_le_rpow (by linarith) (by linarith)
  have hp0 : 0 < p := by linarith
  have hpx : p ≤ x := by
    calc
      _ ≤ x ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le (by linarith) (by linarith)
      _ = x := Real.rpow_one _
  have hmp : p ≤ (m : ℝ) := Nat.le_ceil p
  have hm2p : (m : ℝ) ≤ 2 * p := by
    have hh := Nat.ceil_lt_add_one hp0.le
    dsimp [m]
    linarith
  have hm : 0 < m := Nat.ceil_pos.mpr hp0
  have hm0 : 0 < (m : ℝ) := by exact_mod_cast hm
  have hym : x + (m : ℝ) ≤ 3 * x := by linarith
  have hy2 : 2 ≤ x + (m : ℝ) := by linarith
  have hpow := power_three_scale_le_of_exponent hθ0 hθ1 hx0 (by positivity : 0 ≤ x + (m : ℝ)) hym
  have hlog := log_three_scale_le hq1 hx (by positivity : 0 < x + (m : ℝ)) hym
  have hlog0 : 0 ≤ Real.log ((q : ℝ) * (x + (m : ℝ))) :=
    Real.log_nonneg (by nlinarith)
  have hsmy : ‖smoothedTwistedPsi χ (x + m)‖ ≤
      9 * C * x ^ θ * L := by
    calc
      _ ≤ C * (x + m) ^ θ * Real.log ((q : ℝ) * (x + m)) := hbound _ hy2
      _ ≤ C * (3 * x ^ θ) * (3 * L) := by gcongr
      _ = _ := by ring
  have hsmx : ‖smoothedTwistedPsi χ x‖ ≤ C * x ^ θ * L := hbound x hx
  have hp2 : x * x ^ θ = p ^ 2 := by
    dsimp [p]
    calc
      _ = x ^ (1 : ℝ) * x ^ θ := by rw [Real.rpow_one]
      _ = x ^ ((1 : ℝ) + θ) := (Real.rpow_add hx0 _ _).symm
      _ = x ^ (((1 + θ) / 2) * 2) := by congr 1; ring
      _ = _ := by rw [Real.rpow_mul hx0.le, Real.rpow_two]
  have hpair : (x + m) * ‖smoothedTwistedPsi χ (x + m)‖ + x * ‖smoothedTwistedPsi χ x‖ ≤
      28 * C * p ^ 2 * L := by
    calc
      _ ≤ (3 * x) * (9 * C * x ^ θ * L) +
          x * (C * x ^ θ * L) := by gcongr
      _ = 28 * C * (x * x ^ θ) * L := by ring
      _ = _ := by rw [hp2]
  have hlogy : Real.log (x + (m : ℝ)) ≤ 3 * L := by
    apply le_trans _ hlog
    apply Real.log_le_log (by positivity)
    nlinarith
  have hpp : p ^ 2 ≤ p * m := by nlinarith
  have hmp2 : (m : ℝ) ^ 2 ≤ 2 * p * m := by nlinarith
  calc
    _ ≤ ((x + m) * ‖smoothedTwistedPsi χ (x + m)‖ + x * ‖smoothedTwistedPsi χ x‖ +
        (m : ℝ) ^ 2 * Real.log (x + m)) / m := riesz_unsmoothing_bound χ hx0 hm
    _ ≤ (28 * C + 6) * p * L := by
      apply (div_le_iff₀ hm0).mpr
      calc
        _ ≤ 28 * C * p ^ 2 * L + (m : ℝ) ^ 2 * (3 * L) := by gcongr
        _ = 28 * C * p ^ 2 * L + 3 * (m : ℝ) ^ 2 * L := by ring
        _ ≤ 28 * C * (p * m) * L + 3 * (2 * p * m) * L := by gcongr
        _ = _ := by ring


end Bounty
end

section

/- Actual Hoeffding components omit their missing probes and all averaged tails. -/

namespace Bounty

open Finset
open scoped Classical

section

variable
  {I : Type*}
  [sharedInstance1 : DecidableEq I]
  {X : I → Type*}
  [sharedInstance3 : ∀ i, Fintype (X i)]
  (μ : ∀ i, X i → ℝ)

include I sharedInstance1 X sharedInstance3 μ

theorem finite_coordinate_average_component_commute 
    (i : I) (S : Finset I) (is : List I) (f : (∀ j, X j) → ℂ) :
    finiteCoordinateAverage μ i (finiteCoordinateComponent μ S is f) =
      finiteCoordinateComponent μ S is (finiteCoordinateAverage μ i f) := by
  induction is with
  | nil => rfl
  | cons j js ih =>
    simp only [finiteCoordinateComponent, finite_coordinate_average_choice, ih]

theorem finite_average_fixed_invariant 
    (i : I) (f : (∀ j, X j) → ℂ) (hf : finiteCoordinateAverage μ i f = f)
    (x : ∀ j, X j) (v : X i) : f (Function.update x i v) = f x := by
  rw [← hf]
  exact finite_coordinate_average_invariant μ i f x v

theorem finite_component_missing_invariant 
    (hmass : ∀ i, ∑ v, μ i v = 1) (U S : Finset I) (i : I) (hi : i ∈ U \ S)
    (f : (∀ j, X j) → ℂ) (x : ∀ j, X j) (v : X i) :
    finiteCoordinateComponent μ S U.toList f (Function.update x i v) =
      finiteCoordinateComponent μ S U.toList f x := by
  apply finite_average_fixed_invariant μ i
  rw [finite_coordinate_component_average μ hmass S U.toList i
    (mem_toList.mpr (mem_sdiff.mp hi).1), if_neg (mem_sdiff.mp hi).2]

theorem finite_component_tail_invariant 
    (hmass : ∀ i, ∑ v, μ i v = 1) (U S tail : Finset I) (i : I) (hi : i ∈ tail)
    (f : (∀ j, X j) → ℂ) (x : ∀ j, X j) (v : X i) :
    finiteCoordinateComponent μ S U.toList (finiteCoordinateComponent μ ∅ tail.toList f)
        (Function.update x i v) =
      finiteCoordinateComponent μ S U.toList (finiteCoordinateComponent μ ∅ tail.toList f) x := by
  apply finite_average_fixed_invariant μ i
  rw [finite_coordinate_average_component_commute,
    finite_coordinate_component_average μ hmass ∅ tail.toList i (mem_toList.mpr hi)]
  simp

end


theorem finite_function_eq_of_coordinate_invariance {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} {Y : Type*} (kept : Finset I) (f : (∀ i, X i) → Y)
    (hf : ∀ i ∉ kept, ∀ x v, f (Function.update x i v) = f x)
    (x y : ∀ i, X i) (hxy : ∀ i ∈ kept, x i = y i) : f x = f y := by
  have hmain (s : Finset I) : ∀ x y : ∀ i, X i,
      (∀ i ∈ kept, x i = y i) → (∀ i ∉ s, x i = y i) → f x = f y := by
    induction s using Finset.induction with
    | empty =>
      intro x y _ hout
      have he : x = y := funext (fun i => hout i (by simp))
      rw [he]
    | @insert i s hi ih =>
      intro x y hkeep hout
      have hfi : f (Function.update x i (y i)) = f x := by
        by_cases hik : i ∈ kept
        · rw [← hkeep i hik, Function.update_eq_self]
        · exact hf i hik x (y i)
      rw [← hfi]
      apply ih
      · intro j hj
        by_cases hji : j = i
        · subst j
          exact Function.update_self _ _ _
        · rw [Function.update_of_ne hji]
          exact hkeep j hj
      · intro j hjs
        by_cases hji : j = i
        · subst j
          exact Function.update_self _ _ _
        · rw [Function.update_of_ne hji]
          exact hout j (by simp [hji, hjs])
  exact hmain univ x y hxy (by simp)

end Bounty
end

section

/- Normalized independent tails leave energies and pairings unchanged. -/

open Finset
open scoped Classical

namespace Bounty

def finiteFourPackEquiv {C A B T : Type*} :
    (C × A × B × T) ≃ ((C × A × B) × T) where
  toFun p := ((p.1, p.2.1, p.2.2.1), p.2.2.2)
  invFun p := (p.1.1, p.1.2.1, p.1.2.2, p.2)
  left_inv := by rintro ⟨c, a, b, t⟩; rfl
  right_inv := by rintro ⟨⟨c, a, b⟩, t⟩; rfl







theorem finite_independent_tail_energy {X T : Type*} [Fintype X] [Fintype T]
    (w : X → ℝ) (ν : T → ℝ) (hν : ∑ t, ν t = 1) (f : X → ℂ) :
    finiteWeightedEnergy (fun p : X × T => w p.1 * ν p.2) (fun p => f p.1) =
      finiteWeightedEnergy w f := by
  simp only [finiteWeightedEnergy, Fintype.sum_prod_type]
  apply sum_congr rfl
  intro x _
  calc
    _ = (w x * ‖f x‖ ^ 2) * ∑ t, ν t := by
      rw [mul_sum]
      apply sum_congr rfl
      intro t _
      ring
    _ = _ := by rw [hν, mul_one]

theorem finite_independent_tail_raw_pairing {X T : Type*} [Fintype X] [Fintype T]
    (w : X → ℝ) (ν : T → ℝ) (hν : ∑ t, ν t = 1) (k f g : X → ℂ) :
    cleanRawPairing (fun p : X × T => w p.1 * ν p.2)
      (fun p => k p.1) (fun p => f p.1) (fun p => g p.1) = cleanRawPairing w k f g := by
  have hνc : (∑ t, (ν t : ℂ)) = 1 := by exact_mod_cast hν
  simp only [cleanRawPairing, Fintype.sum_prod_type]
  apply sum_congr rfl
  intro x _
  calc
    _ = ((w x : ℂ) * (starRingEnd ℂ) (f x) * g x * k x) * ∑ t, (ν t : ℂ) := by
      rw [mul_sum]
      apply sum_congr rfl
      intro t _
      push_cast
      ring
    _ = _ := by rw [hνc, mul_one]

theorem finite_independent_tail_kernel_pairing {X T : Type*} [Fintype X] [Fintype T]
    (w : X → ℝ) (ν : T → ℝ) (hν : ∑ t, ν t = 1) (K : X → X → ℂ) (f g : X → ℂ) :
    cleanKernelPairing (fun p : X × T => w p.1 * ν p.2)
      (fun (p q : X × T) => (ν q.2 : ℂ) * K p.1 q.1) (fun p => f p.1) (fun p => g p.1) =
        cleanKernelPairing w K f g := by
  have hνc : (∑ t, (ν t : ℂ)) = 1 := by exact_mod_cast hν
  have hin (x y : X) (t : T) :
      (∑ u, ((w x * ν t : ℝ) : ℂ) * (starRingEnd ℂ) (f x) *
        ((ν u : ℂ) * K x y) * g y) =
      (ν t : ℂ) * ((w x : ℂ) * (starRingEnd ℂ) (f x) * K x y * g y) := by
    calc
      _ = ((ν t : ℂ) * ((w x : ℂ) * (starRingEnd ℂ) (f x) * K x y * g y)) *
          ∑ u, (ν u : ℂ) := by
        rw [mul_sum]
        apply sum_congr rfl
        intro u _
        push_cast
        ring
      _ = _ := by rw [hνc, mul_one]
  simp only [cleanKernelPairing, Fintype.sum_prod_type]
  simp_rw [hin, ← mul_sum, ← sum_mul, hνc, one_mul]

end Bounty
end

section

/- Averaging actual shared-label slice errors with their conditional energies. -/

namespace Bounty

open Finset
open scoped Classical

section

variable
  {C : Type*}
  [sharedInstance1 : Fintype C]
  (ρ A B : C → ℝ)
  (hρ : ∀ c, 0 ≤ ρ c)
  (hA : ∀ c, 0 ≤ A c)
  (hB : ∀ c, 0 ≤ B c)

include C sharedInstance1 ρ A B hρ hA hB

theorem finite_weighted_slice_sqrt_cauchy  :
    (∑ c, ρ c * Real.sqrt (A c) * Real.sqrt (B c)) ≤
      Real.sqrt (∑ c, ρ c * A c) * Real.sqrt (∑ c, ρ c * B c) := by
  have h := Real.sum_sqrt_mul_sqrt_le (univ : Finset C)
    (fun c => mul_nonneg (hρ c) (hA c)) (fun c => mul_nonneg (hρ c) (hB c))
  have he (c : C) : Real.sqrt (ρ c * A c) * Real.sqrt (ρ c * B c) =
      ρ c * Real.sqrt (A c) * Real.sqrt (B c) := by
    rw [Real.sqrt_mul (hρ c), Real.sqrt_mul (hρ c)]
    calc
      _ = (Real.sqrt (ρ c) * Real.sqrt (ρ c)) * Real.sqrt (A c) * Real.sqrt (B c) := by ring
      _ = _ := by rw [Real.mul_self_sqrt (hρ c)]
  simpa only [he] using h

theorem finite_weighted_slice_error_bound 
    (err : C → ℂ) (ε : ℝ) (hε : 0 ≤ ε)
    (herr : ∀ c, ‖err c‖ ≤ ε * Real.sqrt (A c) * Real.sqrt (B c)) :
    ‖∑ c, (ρ c : ℂ) * err c‖ ≤
      ε * Real.sqrt (∑ c, ρ c * A c) * Real.sqrt (∑ c, ρ c * B c) := by
  calc
    _ ≤ ∑ c, ‖(ρ c : ℂ) * err c‖ := norm_sum_le _ _
    _ = ∑ c, ρ c * ‖err c‖ := by
      apply sum_congr rfl
      intro c _
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hρ c)]
    _ ≤ ∑ c, ρ c * (ε * Real.sqrt (A c) * Real.sqrt (B c)) :=
      sum_le_sum (fun c _ => mul_le_mul_of_nonneg_left (herr c) (hρ c))
    _ = ε * (∑ c, ρ c * Real.sqrt (A c) * Real.sqrt (B c)) := by
      rw [mul_sum]
      apply sum_congr rfl
      intro c _
      ring
    _ ≤ _ := by
      simpa only [mul_assoc] using
        mul_le_mul_of_nonneg_left (finite_weighted_slice_sqrt_cauchy ρ A B hρ hA hB) hε

end


noncomputable def finiteTwoKernelPairingError {A B : Type*} [Fintype A] [Fintype B]
    (μ : A → ℝ) (ν : B → ℝ) (KA : A → A → ℂ) (KB : B → B → ℂ)
    (phase : A → B → ℂ) (f : A → ℂ) (g : B → ℂ) : ℂ :=
  ∑ a, ∑ b, ((μ a * ν b : ℝ) : ℂ) *
    ((phase a b - finiteTwoKernelAverage μ ν KA KB a b phase) * f a * g b)

theorem finite_shared_two_kernel_error_bound {C A B : Type*}
    [Fintype C] [Fintype A] [Fintype B]
    (ρ : C → ℝ) (μ : A → ℝ) (ν : B → ℝ)
    (hρ : ∀ c, 0 ≤ ρ c) (hμ : ∀ a, 0 ≤ μ a) (hν : ∀ b, 0 ≤ ν b)
    (KA : A → A → ℂ) (KB : B → B → ℂ) (phase : C → A → B → ℂ)
    (f : C → A → ℂ) (g : C → B → ℂ) (ε : ℝ) (hε : 0 ≤ ε)
    (herr : ∀ c, ‖finiteTwoKernelPairingError μ ν KA KB (phase c) (f c) (g c)‖ ≤
      ε * Real.sqrt (finiteWeightedEnergy μ (f c)) * Real.sqrt (finiteWeightedEnergy ν (g c))) :
    ‖∑ c, (ρ c : ℂ) * finiteTwoKernelPairingError μ ν KA KB (phase c) (f c) (g c)‖ ≤
      ε * Real.sqrt (∑ c, ρ c * finiteWeightedEnergy μ (f c)) *
        Real.sqrt (∑ c, ρ c * finiteWeightedEnergy ν (g c)) := by
  exact finite_weighted_slice_error_bound ρ
    (fun c => finiteWeightedEnergy μ (f c)) (fun c => finiteWeightedEnergy ν (g c)) hρ
    (fun c => sum_nonneg (fun a _ => mul_nonneg (hμ a) (sq_nonneg _)))
    (fun c => sum_nonneg (fun b _ => mul_nonneg (hν b) (sq_nonneg _)))
    _ ε hε herr

end Bounty
end

section

/- Exact finite pairing and energy transport along a state equivalence. -/

namespace Bounty

open Finset

section

variable
  {X Y : Type*}
  [sharedInstance1 : Fintype X]
  [sharedInstance2 : Fintype Y]
  (E : X ≃ Y)
  (w : X → ℝ)

include X Y sharedInstance1 sharedInstance2 E w

theorem clean_raw_pairing_equiv  (k f g : X → ℂ) :
    cleanRawPairing w k f g = cleanRawPairing (fun y => w (E.symm y))
      (fun y => k (E.symm y)) (fun y => f (E.symm y)) (fun y => g (E.symm y)) := by
  exact (E.symm.sum_comp (fun x => (w x : ℂ) * (starRingEnd ℂ) (f x) * g x * k x)).symm

theorem clean_kernel_pairing_equiv  (K : X → X → ℂ) (f g : X → ℂ) :
    cleanKernelPairing w K f g = cleanKernelPairing (fun y => w (E.symm y))
      (fun y z => K (E.symm y) (E.symm z)) (fun y => f (E.symm y)) (fun y => g (E.symm y)) := by
  unfold cleanKernelPairing
  rw [← E.symm.sum_comp]
  apply sum_congr rfl
  intro y _
  exact (E.symm.sum_comp (fun x => (w (E.symm y) : ℂ) *
    (starRingEnd ℂ) (f (E.symm y)) * K (E.symm y) x * g x)).symm

theorem finite_weighted_energy_equiv  (f : X → ℂ) :
    finiteWeightedEnergy w f =
      finiteWeightedEnergy (fun y => w (E.symm y)) (fun y => f (E.symm y)) := by
  exact (E.symm.sum_comp (fun x => w x * ‖f x‖ ^ 2)).symm

end


end Bounty
end

section

/- Uniform ordinary prime-character cancellation on the wider interval
(y/4,5y], under the same explicit primitive zero-free hypothesis. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem eventually_wide_ambient_prime_cancellation
    (hZ : PrimitiveZeroFreeHalfPlane) {δ σ : ℝ} (hδ : 0 < δ) (hσ : 0 < σ) :
    ∀ᶠ y : ℝ in atTop, ∀ L : ℕ, 0 < L →
      Real.log (L : ℝ) ≤ y ^ δ * Real.log (5 * y) →
      ∀ χ : DirichletCharacter ℂ L, χ ≠ 1 →
      ‖∑ p ∈ primeBand (y / 4) (5 * y), χ (p : ZMod L)‖ ≤
        y ^ ((31 : ℝ) / 32 + 2 * δ + σ) := by
  obtain ⟨C, hC, hbound⟩ := ordinary_prime_band_product_interval_bound hZ
  let A : ℝ := 20 * C / (4 : ℝ) ^ (-(1 : ℝ) / 32)
  filter_upwards [eventually_log_natLog_le_rpow δ hδ,
    eventually_const_le_mul_rpow hσ (show (0 : ℝ) < 1 by norm_num) A,
    eventually_ge_atTop (4 * Real.exp 1), eventually_ge_atTop (8 : ℝ)]
    with y hlog hA hyexp hy8
  have hy0 : 0 < y := by linarith
  have hy1 : 1 ≤ y := by linarith
  have ha2 : 2 ≤ y / 4 := by linarith
  have ha0 : 0 < y / 4 := by positivity
  have hb0 : 0 ≤ 5 * y := by positivity
  have hden : 1 ≤ Real.log (y / 4) := by
    calc
      1 = Real.log (Real.exp 1) := (Real.log_exp 1).symm
      _ ≤ Real.log (y / 4) := Real.log_le_log (Real.exp_pos _) (by linarith)
  have hden0 : 0 < Real.log (y / 4) := by linarith
  have hpow : 1 ≤ y ^ (2 * δ) := Real.one_le_rpow hy1 (by linarith)
  intro L hL hLlog χ hχ
  have hL0 : 0 ≤ Real.log (L : ℝ) := Real.log_nonneg (by exact_mod_cast hL)
  have hLpow : Real.log (L : ℝ) ≤ y ^ (2 * δ) := by
    simpa only [two_mul] using (hlog L hLlog).1
  have hfrac : Real.log (L : ℝ) / Real.log (y / 4) ≤ y ^ (2 * δ) := by
    apply le_trans _ hLpow
    apply (div_le_iff₀ hden0).mpr
    exact le_mul_of_one_le_right hL0 hden
  have hfactor : 1 + Real.log (L : ℝ) / Real.log (y / 4) ≤ 2 * y ^ (2 * δ) := by linarith
  have hfilter : (primeBand (y / 4) (5 * y)).filter
      (fun p : ℕ => (0 : ℝ) < 1 * (p : ℝ) ∧ 1 * (p : ℝ) ≤ 5 * y) =
      primeBand (y / 4) (5 * y) := by
    apply filter_eq_self.mpr
    intro p hp
    have hp' := (mem_primeBand_iff ha0.le hb0 p).mp hp
    simpa only [one_mul] using And.intro (show (0 : ℝ) < p by exact_mod_cast hp'.1.pos) hp'.2.2
  have hbasic := hbound L hL χ hχ (y / 4) (5 * y) 1 0 (5 * y)
    ha2 hb0 (by norm_num) (by norm_num) hb0
  rw [hfilter] at hbasic
  calc
    _ ≤ 2 * (5 * y) * C * (y / 4) ^ (-(1 : ℝ) / 32) *
        (1 + Real.log (L : ℝ) / Real.log (y / 4)) := hbasic
    _ ≤ 2 * (5 * y) * C * (y / 4) ^ (-(1 : ℝ) / 32) * (2 * y ^ (2 * δ)) :=
      mul_le_mul_of_nonneg_left hfactor (by positivity)
    _ = A * y ^ ((31 : ℝ) / 32 + 2 * δ) := by
      rw [Real.div_rpow hy0.le (by norm_num)]
      have h31 : y ^ ((31 : ℝ) / 32) = y * y ^ (-(1 : ℝ) / 32) := by
        rw [show (31 : ℝ) / 32 = 1 + (-(1 : ℝ) / 32) by norm_num, Real.rpow_add hy0, Real.rpow_one]
      rw [Real.rpow_add hy0, h31]
      dsimp only [A]
      ring
    _ ≤ y ^ σ * y ^ ((31 : ℝ) / 32 + 2 * δ) :=
      mul_le_mul_of_nonneg_right (by simpa only [one_mul] using hA) (by positivity)
    _ = y ^ ((31 : ℝ) / 32 + 2 * δ + σ) := by
      rw [← Real.rpow_add hy0]
      congr 1
      ring

end Bounty
end

section

/- An explicit even sieve order with sublinear logarithmic level. -/

open Filter

namespace Bounty

noncomputable def roughCellSieveOrder (L : ℝ) : ℕ := 2 * ⌈L^(1/8 : ℝ)⌉₊

theorem rough_cell_sieve_order_even (L : ℝ) : Even (roughCellSieveOrder L) := by
  exact ⟨⌈L^(1/8 : ℝ)⌉₊, by simp only [roughCellSieveOrder, two_mul]⟩

theorem rough_cell_sieve_order_bounds {L : ℝ} (hL : 1 ≤ L) :
    1 ≤ roughCellSieveOrder L ∧ L^(1/8 : ℝ) ≤ (roughCellSieveOrder L : ℝ) ∧
      (roughCellSieveOrder L : ℝ) ≤ 4*L^(1/8 : ℝ) := by
  have hp : 1 ≤ L^(1/8 : ℝ) := Real.one_le_rpow hL (by norm_num)
  have hceil : 1 ≤ ⌈L^(1/8 : ℝ)⌉₊ := Nat.one_le_ceil_iff.mpr (zero_lt_one.trans_le hp)
  have hlower := Nat.le_ceil (L^(1/8 : ℝ))
  have hupper := Nat.ceil_lt_add_one (zero_le_one.trans hp)
  constructor
  · unfold roughCellSieveOrder
    omega
  · simp only [roughCellSieveOrder, Nat.cast_mul, Nat.cast_ofNat]
    constructor <;> linarith

theorem rough_cell_sieve_order_exponential_le {L : ℝ} (hL : 1 ≤ L) :
    Real.exp (-(roughCellSieveOrder L : ℝ)) ≤ Real.exp (-L^(1/8 : ℝ)) := by
  exact Real.exp_le_exp.mpr (neg_le_neg (rough_cell_sieve_order_bounds hL).2.1)

theorem eventually_rough_cell_sieve_level_le {a : ℝ} (ha : 0 < a) :
    ∀ᶠ L : ℝ in atTop,
      (Real.exp (Real.sqrt L))^(4*(roughCellSieveOrder L : ℝ) + 2) ≤
        Real.exp ((a/2)*L) := by
  have hlevel := eventually_mul_rpow_log_add_le_rpow
    (by norm_num : (0 : ℝ) < 1) (by norm_num : (5/8 : ℝ) < 1)
    (half_pos ha) 18 0
  filter_upwards [hlevel, eventually_ge_atTop (1 : ℝ),
    Real.tendsto_log_atTop.eventually (eventually_ge_atTop (1 : ℝ))]
    with L hlevelL hL hlog
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hp : 1 ≤ L^(1/8 : ℝ) := Real.one_le_rpow hL (by norm_num)
  have horder := (rough_cell_sieve_order_bounds hL).2.2
  have horder' : 4*(roughCellSieveOrder L : ℝ) + 2 ≤ 18*L^(1/8 : ℝ) := by linarith
  have hpow : Real.sqrt L * L^(1/8 : ℝ) = L^(5/8 : ℝ) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_add hL0]
    norm_num
  have hsmall : 18*L^(5/8 : ℝ) ≤ (a/2)*L := by
    have hm := le_mul_of_one_le_right
      (show 0 ≤ 18*L^(5/8 : ℝ) by positivity) hlog
    simp only [add_zero, Real.rpow_one] at hlevelL
    exact hm.trans hlevelL
  rw [← Real.exp_mul]
  apply Real.exp_le_exp.mpr
  calc
    Real.sqrt L * (4*(roughCellSieveOrder L : ℝ) + 2) ≤
        Real.sqrt L * (18*L^(1/8 : ℝ)) :=
      mul_le_mul_of_nonneg_left horder' (Real.sqrt_nonneg L)
    _ = 18*L^(5/8 : ℝ) := by rw [mul_left_comm, hpow]
    _ ≤ (a/2)*L := hsmall

theorem eventually_rough_cell_sieve_parameters {a : ℝ} (ha : 0 < a) :
    ∀ᶠ L : ℝ in atTop,
      1 ≤ roughCellSieveOrder L ∧ Even (roughCellSieveOrder L) ∧
      1 < Real.exp (Real.sqrt L) ∧
      (Real.exp (Real.sqrt L))^(4*(roughCellSieveOrder L : ℝ) + 2) ≤
        Real.exp ((a/2)*L) ∧
      Real.exp (-(roughCellSieveOrder L : ℝ)) ≤ Real.exp (-L^(1/8 : ℝ)) := by
  filter_upwards [eventually_rough_cell_sieve_level_le ha, eventually_ge_atTop (1 : ℝ)]
    with L hlevel hL
  exact ⟨(rough_cell_sieve_order_bounds hL).1, rough_cell_sieve_order_even L,
    Real.one_lt_exp_iff.mpr (Real.sqrt_pos.mpr (zero_lt_one.trans_le hL)),
    hlevel, rough_cell_sieve_order_exponential_le hL⟩

end Bounty

end

section

/- A two-sided rough-integer count with real endpoints and a uniform error. -/

open Finset

namespace Bounty

theorem floor_interval_length_error_le_one {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) :
    |((⌊b⌋₊ : ℝ) - ⌊a⌋₊) - (b - a)| ≤ 1 := by
  have hfa := Nat.floor_le ha
  have hfb := Nat.floor_le hb
  have hla := Nat.lt_floor_add_one a
  have hlb := Nat.lt_floor_add_one b
  apply abs_le.mpr
  constructor <;> linarith

theorem finite_prime_avoidance_product_le_one (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) :
    (∏ p ∈ P, (1 - 1 / (p : ℝ))) ≤ 1 := by
  apply prod_le_one₀
  · intro p hp
    have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast (hP p hp).one_le
    exact sub_nonneg.mpr ((div_le_one (by linarith)).mpr hp1)
  · intro p hp
    have hp0 : (0 : ℝ) ≤ p := Nat.cast_nonneg p
    have := div_nonneg (by norm_num : (0 : ℝ) ≤ 1) hp0
    linarith

theorem exists_real_rough_integer_interval_count :
    ∃ K : ℝ, 0 < K ∧ ∀ {a b z : ℝ} {h : ℕ},
      0 ≤ a → a ≤ b → 1 < z → 1 ≤ h → Even h →
      |((roughBand a b z).card : ℝ) -
          (b - a) * (∏ p ∈ primeBand 0 z, (1 - 1 / (p : ℝ)))| ≤
        K * ((b - a) * (∏ p ∈ primeBand 0 z, (1 - 1 / (p : ℝ))) *
          Real.exp (-(h : ℝ)) + z^(4 * (h : ℝ) + 2)) := by
  obtain ⟨K, hK, hcount⟩ := exists_rough_integer_interval_count
  refine ⟨K + 2, by linarith, ?_⟩
  intro a b z h ha hab hz hh heven
  have hbase := hcount ⌊a⌋₊ ⌊b⌋₊ hz (Nat.floor_mono hab) hh heven
  let V := ∏ p ∈ primeBand 0 z, (1 - 1 / (p : ℝ))
  let D := z^(4 * (h : ℝ) + 2)
  have hV0 : 0 ≤ V := (finite_prime_avoidance_product_pos _
    (fun _ hp => small_prime_pool_prime hp)).le
  have hV1 : V ≤ 1 := finite_prime_avoidance_product_le_one _
    (fun _ hp => small_prime_pool_prime hp)
  have hD : 1 ≤ D := Real.one_le_rpow hz.le (by positivity)
  have he0 : 0 ≤ Real.exp (-(h : ℝ)) := Real.exp_nonneg _
  have he1 : Real.exp (-(h : ℝ)) ≤ 1 :=
    Real.exp_le_one_iff.mpr (neg_nonpos.mpr (Nat.cast_nonneg h))
  have hlen := floor_interval_length_le (a := a) (ha.trans hab)
  have herr := floor_interval_length_error_le_one ha (ha.trans hab)
  have hchange :
      |(((⌊b⌋₊ : ℝ) - ⌊a⌋₊) - (b - a)) * V| ≤ 1 := by
    rw [abs_mul, abs_of_nonneg hV0]
    exact (mul_le_mul_of_nonneg_right herr hV0).trans (by simpa using hV1)
  change |((roughBand a b z).card : ℝ) -
    ((⌊b⌋₊ : ℝ) - ⌊a⌋₊) * V| ≤
      ((⌊b⌋₊ : ℝ) - ⌊a⌋₊) * V * K * Real.exp (-(h : ℝ)) + D at hbase
  have htriangle := abs_add_le
    (((roughBand a b z).card : ℝ) - ((⌊b⌋₊ : ℝ) - ⌊a⌋₊) * V)
    ((((⌊b⌋₊ : ℝ) - ⌊a⌋₊) - (b - a)) * V)
  have hid : (((roughBand a b z).card : ℝ) - ((⌊b⌋₊ : ℝ) - ⌊a⌋₊) * V) +
      ((((⌊b⌋₊ : ℝ) - ⌊a⌋₊) - (b - a)) * V) =
      ((roughBand a b z).card : ℝ) - (b - a) * V := by ring
  rw [hid] at htriangle
  have hmain0 : 0 ≤ (b - a) * V * Real.exp (-(h : ℝ)) := by positivity
  have hVe : V * Real.exp (-(h : ℝ)) ≤ 1 :=
    (mul_le_mul hV1 he1 he0 (by norm_num)).trans (by norm_num)
  have hlength := mul_le_mul_of_nonneg_right hlen
    (show 0 ≤ V * K * Real.exp (-(h : ℝ)) by positivity)
  have hsmall := mul_le_mul_of_nonneg_left hVe hK.le
  have hKD := mul_le_mul_of_nonneg_left hD hK.le
  change |((roughBand a b z).card : ℝ) - (b - a) * V| ≤
    (K + 2) * ((b - a) * V * Real.exp (-(h : ℝ)) + D)
  nlinarith

end Bounty
end

section

/- Exponential sieve levels fit below an integer cutoff with a fixed exponent gap. -/

open Filter

namespace Bounty

theorem eventually_exp_le_floor_exp {a theta : ℝ} (ha : 0 ≤ a) (hat : a < theta) :
    ∀ᶠ L : ℝ in atTop,
      Real.exp (a * L) ≤ (⌊Real.exp (theta * L)⌋₊ : ℝ) := by
  have hgap : 0 < theta - a := sub_pos.mpr hat
  filter_upwards [eventually_ge_atTop (0 : ℝ),
    eventually_ge_atTop (Real.log 2 / (theta - a))] with L hL hLgap
  have hA : 1 ≤ Real.exp (a * L) := Real.one_le_exp (mul_nonneg ha hL)
  have hB : 2 ≤ Real.exp ((theta - a) * L) := by
    calc
      _ = Real.exp (Real.log 2) := (Real.exp_log (by norm_num)).symm
      _ ≤ _ := Real.exp_le_exp.mpr (by
        have h := (div_le_iff₀ hgap).mp hLgap
        nlinarith only [h])
  have hexp : Real.exp (theta * L) =
      Real.exp (a * L) * Real.exp ((theta - a) * L) := by
    rw [← Real.exp_add]
    congr 1
    ring
  have hsize : Real.exp (a * L) + 1 ≤ Real.exp (theta * L) := by
    rw [hexp]
    have h := mul_le_mul_of_nonneg_left hB (Real.exp_pos (a * L)).le
    nlinarith only [h, hA]
  have hfloor := Nat.sub_one_lt_floor (Real.exp (theta * L))
  linarith only [hsize, hfloor]

theorem floor_exp_mul_le_exp {theta L : ℝ} (htheta : theta ≤ 1) (hL : 0 ≤ L) :
    (⌊Real.exp (theta * L)⌋₊ : ℝ) ≤ Real.exp L := by
  apply (Nat.floor_le (Real.exp_pos _).le).trans
  apply Real.exp_le_exp.mpr
  nlinarith only [htheta, hL]

theorem eventually_candidate_sieve_scale {b theta : ℝ} (hb : 0 < b) (h : ℕ)
    (hlevel : b * (4 * (h : ℝ) + 2) < theta) (htheta : theta ≤ 1) :
    ∀ᶠ L : ℝ in atTop,
      1 < Real.exp (b * L) ∧
      (Real.exp (b * L)) ^ (4 * (h : ℝ) + 2) ≤ (⌊Real.exp (theta * L)⌋₊ : ℝ) ∧
      (⌊Real.exp (theta * L)⌋₊ : ℝ) ≤ Real.exp L := by
  have ha : 0 ≤ b * (4 * (h : ℝ) + 2) := by positivity
  filter_upwards [eventually_exp_le_floor_exp ha hlevel,
    eventually_gt_atTop (0 : ℝ)] with L hcut hL
  refine ⟨Real.one_lt_exp_iff.mpr (mul_pos hb hL), ?_, floor_exp_mul_le_exp htheta hL.le⟩
  calc
    _ = Real.exp ((b * (4 * (h : ℝ) + 2)) * L) := by
      rw [← Real.exp_mul]
      congr 1
      ring
    _ ≤ _ := hcut

theorem eventually_candidate_midpoint_sieve_scale {b : ℝ} (hb : 0 < b) (h : ℕ)
    (hlevel : b * (4 * (h : ℝ) + 2) < 1/2) :
    ∀ᶠ L : ℝ in atTop,
      1 < Real.exp (b * L) ∧
      (Real.exp (b * L)) ^ (4 * (h : ℝ) + 2) ≤
        (⌊Real.exp (((b * (4 * (h : ℝ) + 2) + 1/2) / 2) * L)⌋₊ : ℝ) ∧
      (⌊Real.exp (((b * (4 * (h : ℝ) + 2) + 1/2) / 2) * L)⌋₊ : ℝ) ≤
        Real.exp L := by
  apply eventually_candidate_sieve_scale hb h
  · linarith only [hlevel]
  · linarith only [hlevel]

end Bounty

end

section

/- The exact predecessor avoidance product and absorption of the principal distribution error. -/

open Finset Filter

namespace Bounty

noncomputable def shiftedPrimeAvoidanceProduct (z : ℝ) : ℝ :=
  ∏ p ∈ (primeBand 0 z).erase 2, (1 - 1 / ((p : ℝ) - 1))

theorem shifted_prime_avoidance_product_pos (z : ℝ) :
    0 < shiftedPrimeAvoidanceProduct z := by
  apply finite_odd_prime_predecessor_avoidance_product_pos
  · intro p hp
    exact small_prime_pool_prime (mem_of_mem_erase hp)
  · intro p hp
    exact (mem_erase.mp hp).1

theorem shifted_prime_avoidance_product_lower {z : ℝ} (hz : 1 ≤ z) :
    1 / ((4 * primeEulerProductUpperConstant) * Real.log (2 * z)) ≤
      shiftedPrimeAvoidanceProduct z := by
  apply finite_odd_prime_predecessor_avoidance_product_lower
  · intro p hp
    exact small_prime_pool_prime (mem_of_mem_erase hp)
  · intro p hp
    exact (mem_erase.mp hp).1
  · exact hz
  · intro p hp
    exact small_prime_pool_le (zero_le_one.trans hz) (mem_of_mem_erase hp)

theorem eventually_shifted_avoidance_absorbs_power {b : ℝ} (hb : 0 < b)
    (A : ℝ) (hA : 0 ≤ A) :
    ∀ᶠ L : ℝ in atTop, A * L^(-18 : ℝ) ≤
      shiftedPrimeAvoidanceProduct (Real.exp (b * L)) * L^(-16 : ℝ) := by
  let T : ℝ := (4 * primeEulerProductUpperConstant) * (1 + b)
  have hT : 0 < T := by dsimp [T]; positivity [primeEulerProductUpperConstant_pos]
  filter_upwards [eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (Real.log 2),
    eventually_ge_atTop (T * A)] with L hL1 hLlog hLA
  have hL : 0 < L := zero_lt_one.trans_le hL1
  have hz : 1 ≤ Real.exp (b * L) := Real.one_le_exp (by positivity)
  have hprod := shifted_prime_avoidance_product_lower hz
  have hprod0 := (shifted_prime_avoidance_product_pos (Real.exp (b * L))).le
  have hden : 0 < (4 * primeEulerProductUpperConstant) *
      Real.log (2 * Real.exp (b * L)) := by
    apply mul_pos (by positivity [primeEulerProductUpperConstant_pos])
    exact Real.log_pos (by nlinarith)
  have hlog : Real.log (2 * Real.exp (b * L)) ≤ (1 + b) * L := by
    rw [Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) (Real.exp_ne_zero _), Real.log_exp]
    nlinarith only [hLlog]
  have hdenle : (4 * primeEulerProductUpperConstant) *
      Real.log (2 * Real.exp (b * L)) ≤ T * L := by
    calc
      _ ≤ (4 * primeEulerProductUpperConstant) * ((1 + b) * L) :=
        mul_le_mul_of_nonneg_left hlog (by positivity [primeEulerProductUpperConstant_pos])
      _ = _ := by dsimp [T]; ring
  have hone : 1 ≤ shiftedPrimeAvoidanceProduct (Real.exp (b * L)) * (T * L) :=
    ((div_le_iff₀ hden).mp hprod).trans (mul_le_mul_of_nonneg_left hdenle hprod0)
  have hAprod : A ≤ shiftedPrimeAvoidanceProduct (Real.exp (b * L)) * L^2 := by
    have h1 := mul_le_mul_of_nonneg_left hone hA
    have h2 := mul_le_mul_of_nonneg_left hLA
      (mul_nonneg hprod0 hL.le)
    nlinarith only [h1, h2]
  have hpow : L^2 * L^(-18 : ℝ) = L^(-16 : ℝ) := by
    rw [← Real.rpow_two, ← Real.rpow_add hL]
    norm_num
  calc
    _ ≤ (shiftedPrimeAvoidanceProduct (Real.exp (b * L)) * L^2) * L^(-18 : ℝ) :=
      mul_le_mul_of_nonneg_right hAprod (Real.rpow_nonneg hL.le _)
    _ = _ := by rw [mul_assoc, hpow]

end Bounty
end

section

/- Exact normalization of the omitted-prime sieve density in a unit class. -/

open Finset

namespace Bounty

theorem totient_eq_real_prime_avoidance (r : ℕ) :
    (r.totient : ℝ) = (r : ℝ) *
      ∏ p ∈ r.primeFactors, (1 - 1 / (p : ℝ)) := by
  have h := Nat.totient_eq_mul_prod_factors r
  have h' := congrArg (fun x : ℚ => (x : ℝ)) h
  push_cast at h'
  simpa only [one_div] using h'

theorem omitted_prime_avoidance_density (P : Finset ℕ) (r : ℕ)
    (hP : ∀ p ∈ P, p.Prime) (hr : 0 < r) (hpf : r.primeFactors ⊆ P) :
    (∏ p ∈ P.filter (fun p => ¬p ∣ r), (1 - 1 / (p : ℝ))) / (r : ℝ) =
      (∏ p ∈ P, (1 - 1 / (p : ℝ))) / (r.totient : ℝ) := by
  have hfilter : P.filter (fun p => p ∣ r) = r.primeFactors := by
    ext p
    simp only [mem_filter]
    constructor
    · intro hp
      exact Nat.mem_primeFactors.mpr ⟨hP p hp.1, hp.2, hr.ne'⟩
    · intro hp
      exact ⟨hpf hp, Nat.dvd_of_mem_primeFactors hp⟩
  have hsplit := prod_filter_mul_prod_filter_not
    (s := P) (p := fun p : ℕ => p ∣ r) (f := fun p : ℕ => (1 - 1 / (p : ℝ)))
  rw [hfilter] at hsplit
  have hr0 : (r : ℝ) ≠ 0 := by exact_mod_cast hr.ne'
  have hphi0 : (r.totient : ℝ) ≠ 0 := by
    exact_mod_cast (Nat.totient_pos.mpr hr).ne'
  apply (div_eq_div_iff hr0 hphi0).mpr
  rw [totient_eq_real_prime_avoidance, ← hsplit]
  ring

theorem small_prime_avoidance_unit_density {z : ℝ} (hz : 0 ≤ z) (r : ℕ)
    (hr : 0 < r) (hpf : ∀ p ∈ r.primeFactors, (p : ℝ) ≤ z) :
    (∏ p ∈ (primeBand 0 z).filter (fun p => ¬p ∣ r), (1 - 1 / (p : ℝ))) / (r : ℝ) =
      (∏ p ∈ primeBand 0 z, (1 - 1 / (p : ℝ))) / (r.totient : ℝ) := by
  apply omitted_prime_avoidance_density _ r (fun _ hp => small_prime_pool_prime hp) hr
  intro p hp
  exact (mem_small_prime_pool_iff hz p).mpr ⟨Nat.prime_of_mem_primeFactors hp, hpf p hp⟩

end Bounty
end

section

/- Exact residue-class interval counts and their unit discrepancy. -/

open Finset

namespace Bounty

theorem nat_mod_eq_iff_dvd_shift (r u n : ℕ) (hr : 0 < r) :
    n % r = u % r ↔ r ∣ n + (r - u % r) := by
  have hu : u % r ≤ r := (Nat.mod_lt u hr).le
  have heq : u % r + (r - u % r) = r := Nat.add_sub_of_le hu
  constructor
  · intro hn
    apply Nat.dvd_of_mod_eq_zero
    calc
      (n + (r - u % r)) % r = (u % r + (r - u % r)) % r := by
        simp only [Nat.add_mod, hn, Nat.mod_mod]
      _ = 0 := by rw [heq, Nat.mod_self]
  · intro hd
    have hmod : Nat.ModEq r (n + (r - u % r)) (u % r + (r - u % r)) := by
      show (n + (r - u % r)) % r = (u % r + (r - u % r)) % r
      rw [Nat.mod_eq_zero_of_dvd hd, heq, Nat.mod_self]
    have hn := Nat.ModEq.add_right_cancel (Nat.ModEq.refl (r - u % r)) hmod
    simpa only [Nat.ModEq, Nat.mod_mod] using hn

theorem interval_residue_shift_image (A B r u : ℕ) (hr : 0 < r) :
    ((Ioc A B).filter (fun n => n % r = u % r)).image (fun n => n + (r - u % r)) =
      (Ioc (A + (r - u % r)) (B + (r - u % r))).filter (fun n => r ∣ n) := by
  ext m
  constructor
  · intro hm
    obtain ⟨n, hn, rfl⟩ := mem_image.mp hm
    obtain ⟨hnI, hnR⟩ := mem_filter.mp hn
    obtain ⟨ha, hb⟩ := mem_Ioc.mp hnI
    apply mem_filter.mpr
    exact ⟨mem_Ioc.mpr ⟨by omega, by omega⟩, (nat_mod_eq_iff_dvd_shift r u n hr).mp hnR⟩
  · intro hm
    obtain ⟨hmI, hmR⟩ := mem_filter.mp hm
    obtain ⟨ha, hb⟩ := mem_Ioc.mp hmI
    have hshift : m - (r - u % r) + (r - u % r) = m := by omega
    apply mem_image.mpr
    refine ⟨m - (r - u % r), mem_filter.mpr ⟨?_, ?_⟩, hshift⟩
    · exact mem_Ioc.mpr ⟨by omega, by omega⟩
    · apply (nat_mod_eq_iff_dvd_shift r u _ hr).mpr
      rwa [hshift]

theorem interval_residue_error_le_one (A B r u : ℕ) (hAB : A ≤ B) (hr : 0 < r) :
    |(((Ioc A B).filter (fun n => n % r = u % r)).card : ℝ) -
      ((B : ℝ) - A) / r| ≤ 1 := by
  have hcard := congrArg Finset.card (interval_residue_shift_image A B r u hr)
  rw [card_image_of_injective _ (fun _ _ h => Nat.add_right_cancel h)] at hcard
  rw [hcard]
  have he := interval_multiples_error_le_one (A + (r - u % r)) (B + (r - u % r)) r
    (by omega) hr
  simpa only [Nat.cast_add, add_sub_add_right_eq_sub] using he



theorem exists_residue_divisibility_crt (r d u : ℕ) (hr : 0 < r) (hd : 0 < d)
    (hcop : r.Coprime d) :
    ∃ v : ℕ, v < r * d ∧ ∀ n : ℕ,
      (n % r = u % r ∧ d ∣ n) ↔ n % (r * d) = v := by
  let v := Nat.chineseRemainder hcop u 0
  have hv : (v : ℕ) < r * d := Nat.chineseRemainder_lt_mul hcop u 0 hr.ne' hd.ne'
  refine ⟨v, hv, ?_⟩
  intro n
  constructor
  · rintro ⟨hnr, hnd⟩
    have h := Nat.chineseRemainder_modEq_unique hcop
      (show Nat.ModEq r n u from hnr) (Nat.modEq_zero_iff_dvd.mpr hnd)
    change Nat.ModEq (r * d) n v at h
    simpa only [Nat.ModEq, Nat.mod_eq_of_lt hv] using h
  · intro hn
    have h : Nat.ModEq (r * d) n v := by
      show n % (r * d) = (v : ℕ) % (r * d)
      rwa [Nat.mod_eq_of_lt hv]
    exact ⟨(h.of_dvd (dvd_mul_right r d)).trans v.property.1,
      Nat.modEq_zero_iff_dvd.mp ((h.of_dvd (dvd_mul_left d r)).trans v.property.2)⟩

theorem interval_residue_divisibility_error_le_one (A B r u d : ℕ)
    (hAB : A ≤ B) (hr : 0 < r) (hd : 0 < d) (hcop : r.Coprime d) :
    |(((Ioc A B).filter (fun n => n % r = u % r ∧ d ∣ n)).card : ℝ) -
      ((B : ℝ) - A) / (r * d : ℕ)| ≤ 1 := by
  obtain ⟨v, hv, hiff⟩ := exists_residue_divisibility_crt r d u hr hd hcop
  have hset : (Ioc A B).filter (fun n => n % r = u % r ∧ d ∣ n) =
      (Ioc A B).filter (fun n => n % (r * d) = v % (r * d)) := by
    apply filter_congr
    intro n hn
    rw [Nat.mod_eq_of_lt hv]
    exact hiff n
  rw [hset]
  exact interval_residue_error_le_one A B (r * d) v hAB (Nat.mul_pos hr hd)


end Bounty
end

section

/- Exact least-prime-factor extraction, including repeated prime factors. -/

open Finset

namespace Bounty




theorem buchstab_cofactor_prime_factors (n : ℕ) :
    ∀ p ∈ (n/n.minFac).primeFactors, n.minFac ≤ p := by
  intro p hp
  apply Nat.minFac_le_of_dvd (Nat.prime_of_mem_primeFactors hp).two_le
  exact (Nat.dvd_of_mem_primeFactors hp).trans (Nat.div_dvd_of_dvd (Nat.minFac_dvd n))

theorem buchstab_minFac_mul {p m : ℕ} (hp : p.Prime) (hm : m ≠ 0)
    (hrough : ∀ q ∈ m.primeFactors, p ≤ q) : (p*m).minFac = p := by
  have hpm1 : p*m ≠ 1 := by intro h; exact hp.ne_one (Nat.eq_one_of_mul_eq_one_right h)
  have hprime := Nat.minFac_prime hpm1
  apply le_antisymm (Nat.minFac_le_of_dvd hp.two_le (dvd_mul_right p m))
  rcases hprime.dvd_mul.mp (Nat.minFac_dvd (p*m)) with hdiv | hdiv
  · exact ((Nat.prime_dvd_prime_iff_eq hprime hp).mp hdiv).symm.le
  · exact hrough _ (Nat.mem_primeFactors.mpr ⟨hprime, hdiv, hm⟩)

noncomputable def buchstabCompositeCofactors (S : Finset ℕ) (N p : ℕ) : Finset ℕ := by
  classical
  exact (Icc p N).filter (fun m => p*m ∈ S ∧ ∀ q ∈ m.primeFactors, p ≤ q)

theorem buchstab_minFac_fiber_image (S : Finset ℕ) {N p : ℕ} (hp : p.Prime)
    (hSlo : ∀ n ∈ S, 2 ≤ n) (hShi : ∀ n ∈ S, n ≤ N) :
    S.filter (fun n => ¬n.Prime ∧ n.minFac = p) =
      (buchstabCompositeCofactors S N p).image (fun m => p*m) := by
  classical
  ext n
  constructor
  · intro hn
    obtain ⟨hnS, hnprime, hnfac⟩ := mem_filter.mp hn
    have hn0 : 0 < n := lt_of_lt_of_le (by norm_num : 0 < 2) (hSlo n hnS)
    have hdvd : p ∣ n := hnfac ▸ Nat.minFac_dvd n
    have hmul : p*(n/p) = n := Nat.mul_div_cancel' hdvd
    apply mem_image.mpr
    refine ⟨n/p, mem_filter.mpr ⟨mem_Icc.mpr ⟨?_, ?_⟩, (by rwa [hmul]), ?_⟩, hmul⟩
    · simpa only [hnfac] using Nat.minFac_le_div hn0 hnprime
    · exact (Nat.div_le_self n p).trans (hShi n hnS)
    · simpa only [hnfac] using buchstab_cofactor_prime_factors n
  · intro hn
    obtain ⟨m, hm, rfl⟩ := mem_image.mp hn
    obtain ⟨hmI, hmS, hmrough⟩ := mem_filter.mp hm
    have hpm : p ≤ m := (mem_Icc.mp hmI).1
    have hm0 : m ≠ 0 := ne_of_gt (hp.pos.trans_le hpm)
    refine mem_filter.mpr ⟨hmS, Nat.not_prime_mul hp.ne_one ?_, buchstab_minFac_mul hp hm0 hmrough⟩
    exact ne_of_gt (hp.one_lt.trans_le hpm)

end Bounty

end

section

/- Common smooth moduli with an independently specified ambient lower bound. -/

namespace Bounty

/- The ambient primes need only exceed the smoothness bound; their lower
endpoint need not be twice the scale. -/
theorem exists_real_smooth_prime_modulus_above_smoothness {y δ : ℝ}
    (hy : 1 ≤ y) (P S : Finset ℕ) (hsub : P ⊆ S)
    (hprime : ∀ p ∈ S, p.Prime)
    (hbound : ∀ p ∈ S, (p : ℝ) ≤ 5 * y)
    (hlarge : ∀ p ∈ S, y ^ δ < (p : ℝ))
    (hsmooth : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → (q : ℝ) ≤ y ^ δ) :
    ∃ (L : ℕ) (g : ℕ → (ZMod L)ˣ),
      0 < L ∧ (∀ p ∈ P, p - 1 ∣ L) ∧
      (∀ q ∈ L.primeFactors, (q : ℝ) ≤ y ^ δ) ∧
      Real.log (L : ℝ) ≤ y ^ δ * Real.log (5 * y) ∧
      Nat.card (ZMod L)ˣ ≤ L ∧ ∀ p ∈ S, (g p : ZMod L) = p := by
  have hypos : 0 < y := lt_of_lt_of_le zero_lt_one hy
  have hP : ∀ p ∈ P, p.Prime := fun p hp => hprime p (hsub hp)
  have hLpos : 0 < primePredecessorLCM P := primePredecessorLCM_pos hP
  have hsmooth' : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → q ≤ ⌊y ^ δ⌋₊ := by
    intro p hp q hq hdiv
    exact Nat.le_floor (hsmooth p hp q hq hdiv)
  have hLsmooth : ∀ q ∈ (primePredecessorLCM P).primeFactors, (q : ℝ) ≤ y ^ δ := by
    intro q hq
    have hsmall : (q : ℝ) ≤ (⌊y ^ δ⌋₊ : ℝ) := by
      exact_mod_cast primePredecessorLCM_smooth hP hsmooth' hq
    exact hsmall.trans (Nat.floor_le (Real.rpow_nonneg hypos.le _))
  have hcoprime : ∀ p ∈ S, p.Coprime (primePredecessorLCM P) := by
    intro p hp
    apply prime_coprime_of_primeFactors_lt (hprime p hp) hLpos
    intro q hq
    exact_mod_cast (hLsmooth q hq).trans_lt (hlarge p hp)
  let g : ℕ → (ZMod (primePredecessorLCM P))ˣ := fun p =>
    if hp : p ∈ S then ZMod.unitOfCoprime p (hcoprime p hp) else 1
  refine ⟨primePredecessorLCM P, g, hLpos, ?_, hLsmooth,
    log_primePredecessorLCM_le_real hy hP (fun p hp => hbound p (hsub hp)) hsmooth,
    card_zmod_units_le hLpos, ?_⟩
  · intro p hp
    exact predecessor_dvd_primePredecessorLCM hp
  · intro p hp
    simp only [g, dif_pos hp, ZMod.coe_unitOfCoprime]

end Bounty
end

section

/- Exact grouping of consecutive operators and variable-state rows.
No additivity, positivity, or norm assumptions are required. -/

namespace Bounty







def finiteRowSegment {S : ℕ → Type*} {V : Type*}
    (row : ∀ i, (S (i + 1) → V) → S i → V) (a : ℕ) :
    ∀ len, (S (a + len) → V) → S a → V
  | 0, F => F
  | len + 1, F => finiteRowSegment row a len (row (a + len) F)

theorem finite_row_composition_segment {S : ℕ → Type*} {V : Type*}
    (row : ∀ i, (S (i + 1) → V) → S i → V) (a len : ℕ) (F : S (a + len) → V) :
    finiteRowComposition row (a + len) F =
      finiteRowComposition row a (finiteRowSegment row a len F) := by
  induction len with
  | zero => rfl
  | succ len ih =>
    change finiteRowComposition row (a + len) (row (a + len) F) = _
    exact ih (row (a + len) F)

def finiteRowBlockCut (length : ℕ → ℕ) : ℕ → ℕ
  | 0 => 0
  | n + 1 => finiteRowBlockCut length n + length n

def finiteRowGrouped {S : ℕ → Type*} {V : Type*}
    (row : ∀ i, (S (i + 1) → V) → S i → V) (length : ℕ → ℕ) (i : ℕ) :
    (S (finiteRowBlockCut length (i + 1)) → V) → S (finiteRowBlockCut length i) → V :=
  finiteRowSegment row (finiteRowBlockCut length i) (length i)

theorem finite_row_grouped_composition {S : ℕ → Type*} {V : Type*}
    (row : ∀ i, (S (i + 1) → V) → S i → V) (length : ℕ → ℕ)
    (n : ℕ) (F : S (finiteRowBlockCut length n) → V) :
    finiteRowComposition (S := fun i => S (finiteRowBlockCut length i)) (finiteRowGrouped row length) n F =
      finiteRowComposition row (finiteRowBlockCut length n) F := by
  induction n with
  | zero => rfl
  | succ n ih =>
    change finiteRowComposition (S := fun i => S (finiteRowBlockCut length i)) (finiteRowGrouped row length) n
      (finiteRowSegment row (finiteRowBlockCut length n) (length n) F) = _
    rw [ih]
    exact (finite_row_composition_segment row (finiteRowBlockCut length n) (length n) F).symm

def visitThreeBlockLength (i : ℕ) : ℕ := if i % 2 = 0 then 1 else 3

theorem visit_three_block_cut (i : ℕ) :
    finiteRowBlockCut visitThreeBlockLength i = 2 * i - i % 2 := by
  induction i with
  | zero => rfl
  | succ i ih =>
    simp only [finiteRowBlockCut, ih, visitThreeBlockLength]
    split_ifs <;> omega

theorem visit_three_block_cut_even (n : ℕ) :
    finiteRowBlockCut visitThreeBlockLength (2 * n) = 4 * n := by
  rw [visit_three_block_cut]
  omega

theorem visit_three_block_cut_odd (n : ℕ) :
    finiteRowBlockCut visitThreeBlockLength (2 * n + 1) = 4 * n + 1 := by
  rw [visit_three_block_cut]
  omega

section

variable
  {S : ℕ → Type*}
  {V : Type*}
  (row : ∀ i, (S (i + 1) → V) → S i → V)

include S V row

theorem finite_row_composition_terminal_cast  {m n : ℕ} (h : m = n) (F : S n → V) :
    finiteRowComposition row m (fun s => F (cast (congrArg S h) s)) =
      finiteRowComposition row n F := by
  cases h
  rfl

theorem finite_row_visit_three_grouping  (n : ℕ) (F : S (4 * n + 1) → V) :
    finiteRowComposition (S := fun i => S (finiteRowBlockCut visitThreeBlockLength i)) (finiteRowGrouped row visitThreeBlockLength) (2 * n + 1)
        (fun s => F (cast (congrArg S (visit_three_block_cut_odd n)) s)) =
      finiteRowComposition row (4 * n + 1) F := by
  rw [finite_row_grouped_composition]
  exact finite_row_composition_terminal_cast row (visit_three_block_cut_odd n) F

theorem finite_row_segment_one  (a : ℕ) (F : S (a + 1) → V) :
    finiteRowSegment row a 1 F = row a F := rfl

theorem finite_row_segment_three  (a : ℕ) (F : S (a + 3) → V) :
    finiteRowSegment row a 3 F = row a (row (a + 1) (row (a + 2) F)) := rfl

end


theorem visit_three_block_length_even (n : ℕ) : visitThreeBlockLength (2 * n) = 1 := by
  simp [visitThreeBlockLength]

theorem visit_three_block_length_odd (n : ℕ) : visitThreeBlockLength (2 * n + 1) = 3 := by
  simp [visitThreeBlockLength]

end Bounty
end

section

/- Multiplicative constants pass through finite tensor rows whenever they
pass through each coordinate row. This retains the complete joint test. -/

namespace Bounty

theorem fin_tensor_row_mul_left (N : ℕ) {S T : Fin N → Type*}
    (row : (g : Fin N) → (T g → ℂ) → S g → ℂ)
    (hrow : ∀ g c F s, row g (fun t => c * F t) s = c * row g F s)
    (c : ℂ) (F : ((g : Fin N) → T g) → ℂ) (s : (g : Fin N) → S g) :
    finTensorRow N row (fun t => c * F t) s = c * finTensorRow N row F s := by
  induction N with
  | zero => rfl
  | succ N ih =>
    simp only [finTensorRow]
    have ht : (fun t => finTensorRow N (fun g => row g.succ)
        (fun u => c * F (Fin.cons t u)) (Fin.tail s)) =
        (fun t => c * finTensorRow N (fun g => row g.succ)
          (fun u => F (Fin.cons t u)) (Fin.tail s)) := by
      funext t
      exact ih _ (fun g => hrow g.succ) _ _
    rw [ht, hrow]




end Bounty
end

section

/- The target permutation in a labeled physical edge is undone by the
corresponding inverse permutation in the chronological row schedule. -/

namespace Bounty

def physicalInversePermutations {G : Type*} {J ell : ℕ}
    (σ : PhysicalPermutations G J ell) : PhysicalPermutations G J ell :=
  fun g => (σ g).symm

theorem physical_permute_inverse {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (σ : PhysicalPermutations G J ell) (L : PhysicalMarkLists P J ell) :
    physicalPermuteLabels (physicalInversePermutations σ) (physicalPermuteLabels σ L) = L := by
  funext g
  apply Function.Embedding.ext
  intro i
  exact (σ g).apply_symm_apply i |> congrArg (L g)




end Bounty
end

section

/- Exact local residue counts for the two-variable upper-bound sieve. -/

open Finset

namespace Bounty

theorem finite_mul_one_pair_card {R : Type*} [CommMonoid R] [Fintype R] [DecidableEq R] :
    ((univ : Finset (R × R)).filter (fun v => v.1 * v.2 = 1)).card = Fintype.card Rˣ := by
  classical
  let e : Rˣ ≃ {v : R × R // v.1 * v.2 = 1} :=
    { toFun := fun u => ⟨(u, ↑u⁻¹), by simp⟩
      invFun := fun v => ⟨v.1.1, v.1.2, v.2, by simpa only [mul_comm] using v.2⟩
      left_inv := fun u => by apply Units.ext; rfl
      right_inv := fun v => by apply Subtype.ext; rfl }
  simpa only [Fintype.card_subtype] using (Fintype.card_congr e).symm

theorem finite_mul_zero_pair_card {R : Type*} [Semiring R] [NoZeroDivisors R]
    [Fintype R] [DecidableEq R] :
    ((univ : Finset (R × R)).filter (fun v => v.1 * v.2 = 0)).card + 1 =
      2 * Fintype.card R := by
  classical
  let S : Finset (R × R) := Finset.product ({0} : Finset R) univ
  let T : Finset (R × R) := Finset.product (univ : Finset R) {0}
  have hzero : (univ : Finset (R × R)).filter (fun v => v.1 * v.2 = 0) = S ∪ T := by
    ext v
    simp only [S, T, Finset.product_eq_sprod, mem_filter, mem_univ, true_and, mem_union, Finset.mem_product,
      mem_singleton, and_true, mul_eq_zero]
  have hinter : S ∩ T = {(0, 0)} := by
    ext v
    simp only [S, T, Finset.product_eq_sprod, mem_inter, Finset.mem_product, mem_singleton, mem_univ, and_true, true_and]
    constructor
    · rintro ⟨h1, h2⟩
      exact Prod.ext h1 h2
    · intro hv
      cases hv
      exact ⟨rfl, rfl⟩
  have h := card_union_add_card_inter S T
  rw [hinter] at h
  simpa only [hzero, S, T, Finset.product_eq_sprod, Finset.card_product, card_singleton, card_univ, one_mul, mul_one,
    two_mul] using h

theorem prime_mul_zero_pair_card (p : ℕ) [Fact p.Prime] :
    ((univ : Finset (ZMod p × ZMod p)).filter (fun v => v.1 * v.2 = 0)).card = 2*p - 1 := by
  have h := finite_mul_zero_pair_card (R := ZMod p)
  rw [ZMod.card] at h
  omega

theorem prime_mul_one_pair_card (p : ℕ) [Fact p.Prime] :
    ((univ : Finset (ZMod p × ZMod p)).filter (fun v => v.1 * v.2 = 1)).card = p - 1 := by
  rw [finite_mul_one_pair_card, ZMod.card_units]

theorem prime_zero_or_one_pair_card (p : ℕ) [Fact p.Prime] :
    ((univ : Finset (ZMod p × ZMod p)).filter
      (fun v => v.1 * v.2 = 0 ∨ v.1 * v.2 = 1)).card = 3*p - 2 := by
  have hdisj : Disjoint
      ((univ : Finset (ZMod p × ZMod p)).filter (fun v => v.1 * v.2 = 0))
      ((univ : Finset (ZMod p × ZMod p)).filter (fun v => v.1 * v.2 = 1)) := by
    apply disjoint_left.mpr
    intro v h0 h1
    have hzero := (mem_filter.mp h0).2
    have hone := (mem_filter.mp h1).2
    exact zero_ne_one (hzero.symm.trans hone)
  rw [filter_or, card_union_of_disjoint hdisj, prime_mul_zero_pair_card, prime_mul_one_pair_card]
  have hp := (Fact.out : p.Prime).two_le
  omega

end Bounty
end

section

/- Disjoint prime pools give uniform polynomial atom bounds for arbitrary
subsets of grouped coordinates, with a factorial cost only within each group. -/

open Finset
open scoped Classical

namespace Bounty

theorem group_fiber_fin_product {G X M : Type*} [Fintype G] [Fintype X]
    [DecidableEq G] [CommMonoid M] (j : X → G) (f : X → M) :
    (∏ g, ∏ i : Fin (Fintype.card {x : X // j x = g}),
      f (((Fintype.equivFin {x : X // j x = g}).symm i).val)) = ∏ x, f x := by
  calc
    _ = ∏ g, ∏ x : {x : X // j x = g}, f x.val := by
      apply prod_congr rfl
      intro g _
      exact (Fintype.equivFin {x : X // j x = g}).symm.prod_comp (fun x => f x.val)
    _ = _ := Fintype.prod_fiberwise j f

theorem prime_group_index_physical_atom_rpow {G X : Type*} [Fintype G] [Fintype X]
    [DecidableEq G] [DecidableEq X] (j : X → G) (P : G → Finset ℕ) (V : G → ℝ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h))) (m : ℕ)
    {v L D : ℝ} (hv : 0 < v) (hL : 0 < L) (hV : ∀ g, v ≤ V g)
    (hk : ∀ g, Fintype.card {x : X // j x = g} ≤ m)
    (hcard : (Fintype.card G : ℝ) ≤ D * Real.log L) (n : ℕ) :
    (∑ a ∈ univ.filter (fun a : (∀ x : X, P (j x)) => (∏ x, (a x).val : ℕ) = n),
      finiteProductWeight (physicalLabelLaw (P := fun x : X => P (j x))
        (fun x => V (j x))) a) ≤
      L ^ (D * Real.log (primeFiberFactorBound v m)) / (n : ℝ) := by
  let k := fun g => Fintype.card {x : X // j x = g}
  let pick := fun g (i : Fin (k g)) =>
    ((Fintype.equivFin {x : X // j x = g}).symm i).val
  have hpick (g : G) (i : Fin (k g)) : j (pick g i) = g :=
    ((Fintype.equivFin {x : X // j x = g}).symm i).property
  let x := fun (a : ∀ i : X, P (j i)) g (i : Fin (k g)) => (a (pick g i)).val
  have hxinj : Function.Injective x := by
    intro a b hab
    funext i
    apply Subtype.ext
    have hi := congrFun (congrFun hab (j i))
      ((Fintype.equivFin {x : X // j x = j i}) ⟨i, rfl⟩)
    have he : pick (j i) ((Fintype.equivFin {x : X // j x = j i}) ⟨i, rfl⟩) = i := by
      exact congrArg Subtype.val
        ((Fintype.equivFin {x : X // j x = j i}).symm_apply_apply ⟨i, rfl⟩)
    change (a (pick (j i) _)).val = (b (pick (j i) _)).val at hi
    exact he ▸ hi
  have hx (a : ∀ i : X, P (j i)) (g : G) (i : Fin (k g)) : x a g i ∈ P g := by
    have hi := (a (pick g i)).property
    simpa only [hpick] using hi
  have hprod (a : ∀ i : X, P (j i)) :
      (∏ g, ∏ i, x a g i) = ∏ i, (a i).val :=
    group_fiber_fin_product j (fun i => (a i).val)
  have hweight (a : ∀ i : X, P (j i)) :
      (∏ g, ∏ i, (1 / (x a g i : ℝ)) / V g) =
      finiteProductWeight (physicalLabelLaw (P := fun i : X => P (j i))
        (fun i => V (j i))) a := by
    calc
      _ = ∏ g, ∏ i : Fin (k g), (1 / ((a (pick g i)).val : ℝ)) / V (j (pick g i)) := by
        simp only [hpick, x]
      _ = ∏ i, (1 / ((a i).val : ℝ)) / V (j i) :=
        group_fiber_fin_product j (fun i => (1 / ((a i).val : ℝ)) / V (j i))
      _ = _ := by
        unfold finiteProductWeight physicalLabelLaw
        apply prod_congr rfl
        intro i _
        rw [div_div, mul_comm]
  have hb := prime_group_slot_harmonic_atom_rpow P k hprime hdisj x hxinj hx
    V m hv hL hV hk hcard n
  simpa only [sum_filter, hprod, hweight] using hb

theorem prime_subset_group_fiber_card {G : Type*} [DecidableEq G]
    {I : G → Type*} [∀ g, DecidableEq (I g)]
    (r : Finset G) (probes : ∀ g, Finset (I g)) (U : Finset (Sigma I))
    (hU : U ⊆ r.sigma probes) (g : G) :
    Fintype.card {i : U // i.val.fst = g} ≤ (probes g).card := by
  let f : {i : U // i.val.fst = g} → probes g := by
    rintro ⟨⟨⟨g', i⟩, hi⟩, hg⟩
    dsimp at hg
    subst g'
    exact ⟨i, (mem_sigma.mp (hU hi)).2⟩
  have hf : Function.Injective f := by
    rintro ⟨⟨⟨g₁, i₁⟩, hi₁⟩, hg₁⟩ ⟨⟨⟨g₂, i₂⟩, hi₂⟩, hg₂⟩ he
    dsimp at hg₁ hg₂
    subst g₁
    subst g₂
    have he' : i₁ = i₂ := congrArg Subtype.val he
    subst i₂
    rfl
  simpa only [Fintype.card_coe] using Fintype.card_le_of_injective f hf

theorem prime_subset_physical_atom_rpow {G : Type*} [Fintype G] [DecidableEq G]
    {I : G → Type*} [∀ g, DecidableEq (I g)]
    (P : G → Finset ℕ) (V : G → ℝ)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
    (r : Finset G) (probes : ∀ g, Finset (I g)) (m : ℕ)
    {v L D : ℝ} (hv : 0 < v) (hL : 0 < L) (hV : ∀ g, v ≤ V g)
    (hm : ∀ g, (probes g).card ≤ m)
    (hcard : (Fintype.card G : ℝ) ≤ D * Real.log L)
    (U : Finset (Sigma I)) (hU : U ⊆ r.sigma probes) (n : ℕ) :
    (∑ a ∈ univ.filter (fun a : (∀ i : U, P i.val.fst) => (∏ i, (a i).val : ℕ) = n),
      finiteProductWeight (physicalLabelLaw (P := fun i : U => P i.val.fst)
        (fun i => V i.val.fst)) a) ≤
      L ^ (D * Real.log (primeFiberFactorBound v m)) / (n : ℝ) := by
  exact prime_group_index_physical_atom_rpow (fun i : U => i.val.fst) P V hprime
    hdisj m hv hL hV (fun g => (prime_subset_group_fiber_card r probes U hU g).trans (hm g))
    hcard n

end Bounty
end

section

/- Scalar factors in finite chronological row compositions with varying
state types. Only multiplicative homogeneity of the unweighted rows is used. -/

open Finset

namespace Bounty

theorem finite_row_composition_mul {S : ℕ → Type*} {V : Type*} [CommMonoid V]
    (row : (i : ℕ) → (S (i + 1) → V) → S i → V) (n : ℕ)
    (hrow : ∀ i, i < n → ∀ c F s, row i (fun t => c * F t) s = c * row i F s)
    (c : V) (F : S n → V) :
    finiteRowComposition row n (fun t => c * F t) =
      fun s => c * finiteRowComposition row n F s := by
  induction n with
  | zero => rfl
  | succ n ih =>
    have he : row n (fun t => c * F t) = fun s => c * row n F s :=
      funext (hrow n (Nat.lt_succ_self n) c F)
    rw [finite_row_composition_succ, he]
    exact ih (fun i hi => hrow i (Nat.lt_trans hi (Nat.lt_succ_self n))) (row n F)

theorem finite_row_composition_scalar_rows {S : ℕ → Type*} {V : Type*} [CommMonoid V]
    (row weighted : (i : ℕ) → (S (i + 1) → V) → S i → V)
    (c : ℕ → V) (n : ℕ)
    (hrow : ∀ i, i < n → ∀ d F s, row i (fun t => d * F t) s = d * row i F s)
    (hweighted : ∀ i, i < n → ∀ F s, weighted i F s = c i * row i F s)
    (F : S n → V) :
    finiteRowComposition weighted n F =
      fun s => (∏ i ∈ range n, c i) * finiteRowComposition row n F s := by
  induction n with
  | zero => simp only [finite_row_composition_zero, range_zero, prod_empty, one_mul]
  | succ n ih =>
    have hr := fun i hi => hrow i (Nat.lt_trans hi (Nat.lt_succ_self n))
    have hw := fun i hi => hweighted i (Nat.lt_trans hi (Nat.lt_succ_self n))
    have he : weighted n F = fun s => c n * row n F s :=
      funext (hweighted n (Nat.lt_succ_self n) F)
    rw [finite_row_composition_succ, he, ih hr hw,
      finite_row_composition_mul row n hr (c n) (row n F)]
    simp only [prod_range_succ, finite_row_composition_succ, mul_assoc]

theorem finite_row_composition_weighted {S : ℕ → Type*} {V : Type*} [CommMonoid V]
    (row : (i : ℕ) → (S (i + 1) → V) → S i → V)
    (c : ℕ → V) (n : ℕ)
    (hrow : ∀ i, i < n → ∀ d F s, row i (fun t => d * F t) s = d * row i F s)
    (F : S n → V) :
    finiteRowComposition (fun i F s => c i * row i F s) n F =
      fun s => (∏ i ∈ range n, c i) * finiteRowComposition row n F s :=
  finite_row_composition_scalar_rows row (fun i F s => c i * row i F s) c n hrow
    (fun _ _ _ _ => rfl) F

end Bounty
end

