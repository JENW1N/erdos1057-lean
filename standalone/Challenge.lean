section

/- The smooth diagonal bound depends on UV and coefficient bounds, not on the allocation scale E. -/

open Finset

namespace Bounty

theorem typeII_actual_smooth_diagonal (M H : Finset ℕ) (α aH : ℕ → ℂ)
    {L E U V A B : ℝ} (hL : 0 < L) (hE : 0 < E) (hU : 0 < U) (hV : 0 < V)
    (hMpos : ∀ m ∈ M, 0 < m) (hM : ∀ m ∈ M, (m : ℝ) ≤ 2 * U)
    (hH : ∀ h ∈ H, 0 < h) (hα : ∀ m ∈ M, ‖α m‖ ≤ A)
    (haH : ∀ h ∈ H, ‖aH h‖ ≤ B * (h.divisors.card : ℝ)) :
    let EF := Icc ⌈E / (2 * L ^ 88)⌉₊ ⌊2 * E⌋₊
    let NF := Icc ⌈V / 2⌉₊ ⌊3 * V⌋₊
    let η := fun e n : ℕ => typeIIEMajorant (L ^ 88) ((e : ℝ) / E) *
      typeIINMajorant ((n : ℝ) / V)
    typeIIDiagonalEnergy EF NF M H η α aH ≤
      A ^ 2 * B ^ 2 * (2 * (⌊6 * U * V⌋₊ : ℝ) * (1 + Real.log ⌊6 * U * V⌋₊) ^ 15) := by
  dsimp only
  let EF := Icc ⌈E / (2 * L ^ 88)⌉₊ ⌊2 * E⌋₊
  let NF := Icc ⌈V / 2⌉₊ ⌊3 * V⌋₊
  let η := fun e n : ℕ => typeIIEMajorant (L ^ 88) ((e : ℝ) / E) *
    typeIINMajorant ((n : ℝ) / V)
  have hEF : ∀ e ∈ EF, 0 < e := by
    intro e he
    have hlo := (Nat.le_ceil (E / (2 * L ^ 88))).trans
      (by exact_mod_cast (mem_Icc.mp he).1 : (⌈E / (2 * L ^ 88)⌉₊ : ℝ) ≤ e)
    have hp : (0 : ℝ) < e := lt_of_lt_of_le (by positivity) hlo
    exact_mod_cast hp
  have hNF : ∀ n ∈ NF, 0 < n := by
    intro n hn
    have hlo := (Nat.le_ceil (V / 2)).trans
      (by exact_mod_cast (mem_Icc.mp hn).1 : (⌈V / 2⌉₊ : ℝ) ≤ n)
    have hp : (0 : ℝ) < n := lt_of_lt_of_le (by positivity) hlo
    exact_mod_cast hp
  have hNupper : ∀ n ∈ NF, (n : ℝ) ≤ 3 * V := by
    intro n hn
    exact (by exact_mod_cast (mem_Icc.mp hn).2 : (n : ℝ) ≤ (⌊3 * V⌋₊ : ℝ)).trans
      (Nat.floor_le (by positivity))
  have hX : ∀ m ∈ M, ∀ n ∈ NF, m * n ≤ ⌊6 * U * V⌋₊ := by
    intro m hm n hn
    apply Nat.le_floor
    push_cast
    calc
      (m : ℝ) * n ≤ (2 * U) * (3 * V) :=
        mul_le_mul (hM m hm) (hNupper n hn) (Nat.cast_nonneg _) (by positivity)
      _ = 6 * U * V := by ring
  have hη : ∀ e ∈ EF, ∀ n ∈ NF, 0 ≤ η e n ∧ η e n ≤ 1 := by
    intro e _ n _
    have he := typeII_e_majorant_bounds (L ^ 88) ((e : ℝ) / E)
    have hn := typeII_n_majorant_bounds ((n : ℝ) / V)
    refine ⟨mul_nonneg he.1 hn.1, ?_⟩
    exact (mul_le_mul he.2 hn.2 hn.1 (by norm_num)).trans_eq (by norm_num)
  have hbound := typeII_diagonal_energy_bound EF NF M H ⌊6 * U * V⌋₊ η α aH
    (C := 1) (by norm_num) hEF hH hMpos hNF hX hη hα haH
  simpa only [one_mul] using hbound

end Bounty
end

section

/- Pointwise control of the complex truncated coefficient on every integer. -/

open Finset Filter Real

namespace Bounty

theorem eventually_candidate_box_pointwise_error {c : ℝ} (hc : 0 < c) (r : ℕ) (D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ), 0 ≤ q → ∀ (jStar : ℕ) (E : ℝ) (u : ℕ),
      ‖(candidateCompactRangeCoefficient c L q r jStar E u : ℂ) -
        candidateBoxRangeCoefficient c L q r jStar E L u‖ ≤
          L^(-D)*candidateCoefficient c L q r jStar u := by
  obtain ⟨C,hC,hL1,hdecay⟩ := active_allocation_fourier_bounds (candidateAllocationRadius r)
  obtain ⟨M,hM⟩ := exists_candidate_truncation_order hc hC r D
  obtain ⟨CM,hCM,htrunc⟩ := hdecay M
  filter_upwards [hM M le_rfl CM hCM.le, eventually_ge_atTop (1 : ℝ)] with L hcost hL
  intro q hq jStar E u
  let N := (candidateQIndices c L).card*r
  let err : ℝ := N*CM*C^(N-1)*L^(-(M : ℝ))
  have herr : 0 ≤ err := by dsimp [err]; positivity
  have hsingle (x : ∀ slot, candidateQSlotChoices c L r jStar slot) :
      ‖(candidateRangeAllocationMass c L r jStar x E : ℂ) -
        candidateBoxRangeAllocationMass c L r jStar x E L‖ ≤ (2 : ℝ)^N*err := by
    apply candidate_range_box_error c L r jStar x E L herr
    intro take hkeep
    exact htrunc _ (log E) _ _ _ take hkeep L hL
  have hcost' : (2 : ℝ)^N*err ≤ L^(-D) := by
    convert hcost using 1
    dsimp [N,err]
    ring
  exact (candidate_box_coefficient_error c L hq r jStar E L u hsingle).trans
    (mul_le_mul_of_nonneg_right hcost' (candidate_coefficient_nonneg c L hq r jStar u))

theorem eventually_candidate_box_norm_bound {c : ℝ} (hc : 0 < c) (r : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ), 0 ≤ q → ∀ (jStar : ℕ) (E : ℝ) (u : ℕ),
      ‖candidateBoxRangeCoefficient c L q r jStar E L u‖ ≤
        2*candidateCoefficient c L q r jStar u := by
  filter_upwards [eventually_candidate_box_pointwise_error hc r 0] with L he
  intro q hq jStar E u
  have he' := he q hq jStar E u
  simp only [neg_zero, rpow_zero, one_mul] at he'
  have hb := candidate_compact_range_coefficient_bounds c L hq r jStar E u
  calc
    _ ≤ ‖(candidateCompactRangeCoefficient c L q r jStar E u : ℂ) -
          candidateBoxRangeCoefficient c L q r jStar E L u‖ +
        ‖(candidateCompactRangeCoefficient c L q r jStar E u : ℂ)‖ := by
      simpa only [add_comm] using
        norm_le_insert (candidateCompactRangeCoefficient c L q r jStar E u : ℂ)
          (candidateBoxRangeCoefficient c L q r jStar E L u)
    _ ≤ candidateCoefficient c L q r jStar u + candidateCoefficient c L q r jStar u := by
      apply add_le_add he'
      simpa only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hb.1] using hb.2
    _ = _ := by ring

end Bounty
end

