      ring
    · have ha : ¬ (Function.Injective (fun j => (z j).1) ∧
          (∀ j, (z j).1 ∉ H) ∧ S.card + b.val ≤ B) := fun h => hf ⟨h.1, h.2.1⟩
      rw [if_neg ha, if_neg hf, mul_zero, mul_zero, zero_div, mul_zero, zero_mul]
  · have ha : ¬ (Function.Injective (fun j => (z j).1) ∧
        (∀ j, (z j).1 ∉ H) ∧ S.card + b.val ≤ B) := fun h => hc h.2.2
