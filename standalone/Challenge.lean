theorem ghost_phase_capped_visit_eq_of_card_le (a : I → Bool)
    (h : (p : I) → R p) (η β : I → ℝ) (cap : ℕ)
    (hc : Fintype.card I ≤ cap) (z w : (p : I) → GhostPhaseState (R p)) :
    ghostPhaseCappedVisit a h η β cap z w =
      ∏ p, ghostPhaseVisit (a p) (h p) (η p) (β p) (z p) (w p) := by
  have hz : (ghostPhasePendingSupport z).card ≤ cap := (card_le_univ _).trans hc
  exact if_pos hz

theorem ghost_phase_capped_edge_eq_of_card_le (atgt asrc : I → Bool)
    (htgt hsrc : (p : I) → R p) (β V : I → ℝ) (cap : ℕ)
    (hc : Fintype.card I ≤ cap) (z w : (p : I) → GhostPhaseState (R p)) :
    ghostPhaseCappedEdge atgt asrc htgt hsrc β V cap z w =
      ∏ p, ghostPhaseRunEdge (atgt p) (asrc p) (htgt p) (hsrc p)
        (β p) (V p) (z p) (w p) := by
  have hz : (ghostPhasePendingSupport z).card ≤ cap := (card_le_univ _).trans hc
  exact if_pos hz

