section
open scoped BigOperators Classical
section

variable
  {X Y : Type*}
  [sharedInstance1 : Fintype X]
  [sharedInstance2 : Fintype Y]
  (π : X → ℕ)
  (τ : Y → ℕ)
  (hπ : ∀ x, 0 < π x)
  (hτ : ∀ y, 0 < τ y)
  (U V : ℕ)
  (hU : 0 < U)
  (hV : 0 < V)
  (μ : X → ℝ)
  (ν : Y → ℝ)
  (hμ : ∀ x, 0 ≤ μ x)
  (hν : ∀ y, 0 ≤ ν y)
  (KA : X → X → ℂ)
  (KB : Y → Y → ℂ)
  (f : X → ℂ)
  (g : Y → ℂ)

include X Y sharedInstance1 sharedInstance2 π τ hπ hτ U V hU hV μ ν hμ hν KA KB f g

theorem two_kernel_full_phase_enlarged_dyadic_bound
    
    (hf : ∀ x, finiteKernelTestTransform μ KA f x ≠ 0 →
      (U : ℝ) / 2 ≤ π x ∧ (π x : ℝ) ≤ 4 * U)
    (hg : ∀ y, finiteKernelTestTransform ν KB g y ≠ 0 →
      (V : ℝ) / 2 ≤ τ y ∧ (τ y : ℝ) ≤ 4 * V)
    (hEA : (∑ x, μ x * ‖finiteKernelTestTransform μ KA f x‖ ^ 2) ≤
      4 * ∑ x, μ x * ‖f x‖ ^ 2)
    (hEB : (∑ y, ν y * ‖finiteKernelTestTransform ν KB g y‖ ^ 2) ≤
      4 * ∑ y, ν y * ‖g y‖ ^ 2)
    {C D : ℝ} (hC : 0 ≤ C) (hD : 0 ≤ D)
    (hμatom : ∀ m : ℕ,
      (∑ x ∈ Finset.univ.filter (fun x => π x = m), μ x) ≤ C / (m : ℝ))
    (hνatom : ∀ m : ℕ,
      (∑ y ∈ Finset.univ.filter (fun y => τ y = m), ν y) ≤ D / (m : ℝ))
    {u : ℤ} {r : ℕ} (hr : 0 < r) (hcop : (r : ℤ).gcd u = 1)
    {β : ℝ} (hβ : |β| ≤ 1 / (r : ℝ) ^ 2) (ζ : ℝ) :
    ‖∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) *
      finiteTwoKernelAverage μ ν KA KB x y
        (fun d e => minorProductPhase ζ ((u : ℝ) / r + β) (π d) (τ e))‖ ^ 2 ≤
      1024 * (6 * C * D * (1 + Real.log r) *
        (1 / (r : ℝ) + 1 / (U : ℝ) + 1 / (V : ℝ) + (r : ℝ) / ((U : ℝ) * V)) *
        (∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2) := by
  have hUR : (0 : ℝ) < U := by exact_mod_cast hU
  have hVR : (0 : ℝ) < V := by exact_mod_cast hV
  have hrR : (0 : ℝ) < r := by exact_mod_cast hr
  have hpr : ∀ x, finiteKernelTestTransform μ KA f x ≠ 0 →
      1 ≤ π x ∧ π x < 1 + 4 * U := by
    intro x hx
    have hu : π x ≤ 4 * U := by exact_mod_cast (hf x hx).2
    exact ⟨hπ x, by omega⟩
  have htr : ∀ y, finiteKernelTestTransform ν KB g y ≠ 0 →
      (0 : ℤ) ≤ τ y ∧ (τ y : ℤ) ≤ 0 + (4 * V : ℕ) := by
    intro y hy
    have hv : τ y ≤ 4 * V := by exact_mod_cast (hg y hy).2
    constructor
    · positivity
    · exact_mod_cast (show τ y ≤ 0 + 4 * V by omega)
  have hb := two_kernel_supported_rational_bound π τ 1 (4 * U) 0 (4 * V)
    μ ν hμ hν KA KB f g
    (fun x => Complex.exp ((ζ * Real.log (π x : ℝ) : ℝ) * Complex.I))
    (fun y => Complex.exp ((ζ * Real.log (τ y : ℝ) : ℝ) * Complex.I))
    (fun x => real_mellin_factor_norm ζ (π x)) (fun y => real_mellin_factor_norm ζ (τ y))
    hpr htr hC hD (show 0 < (U : ℝ) / 2 by positivity)
    (show 0 < (V : ℝ) / 2 by positivity)
    (fun x hx => (hf x hx).1) (fun y hy => (hg y hy).1)
    hEA hEB hμatom hνatom hr hcop hβ
  have heq : (fun d e => minorProductPhase ζ ((u : ℝ) / r + β) (π d) (τ e)) =
      (fun d e => Complex.exp ((ζ * Real.log (π d : ℝ) : ℝ) * Complex.I) *
        Complex.exp ((ζ * Real.log (τ e : ℝ) : ℝ) * Complex.I) *
        (Complex.exp (Complex.I * (2 * Real.pi * (((u : ℝ) / r + β) * τ e) : ℝ))) ^ π d) := by
    funext d e
    exact minor_product_phase_factor ζ _ (hπ d) (hτ e)
  rw [heq]
  apply hb.trans
  have hL : 1 ≤ 1 + Real.log (r : ℝ) := by
    have := Real.log_nonneg (by exact_mod_cast hr : (1 : ℝ) ≤ r)
    linarith
  have hEf : 0 ≤ ∑ x, μ x * ‖f x‖ ^ 2 :=
    Finset.sum_nonneg (fun x _ => mul_nonneg (hμ x) (sq_nonneg _))
  have hEg : 0 ≤ ∑ y, ν y * ‖g y‖ ^ 2 :=
    Finset.sum_nonneg (fun y _ => mul_nonneg (hν y) (sq_nonneg _))
  convert rational_enlarged_dyad_energy_le hUR hVR hrR hL hC hD hEf hEg using 1 <;>
    first | rfl | (push_cast; ring)

theorem kernel_full_phase_dyadic_comparison
    
    (hf : ∀ x, f x ≠ 0 → U ≤ π x ∧ π x < 2 * U)
    (hg : ∀ y, g y ≠ 0 → V ≤ τ y ∧ τ y < 2 * V)
    (hTf : ∀ x, finiteKernelTestTransform μ KA f x ≠ 0 →
      (U : ℝ) / 2 ≤ π x ∧ (π x : ℝ) ≤ 4 * U)
    (hTg : ∀ y, finiteKernelTestTransform ν KB g y ≠ 0 →
      (V : ℝ) / 2 ≤ τ y ∧ (τ y : ℝ) ≤ 4 * V)
    (hEA : (∑ x, μ x * ‖finiteKernelTestTransform μ KA f x‖ ^ 2) ≤
      4 * ∑ x, μ x * ‖f x‖ ^ 2)
    (hEB : (∑ y, ν y * ‖finiteKernelTestTransform ν KB g y‖ ^ 2) ≤
      4 * ∑ y, ν y * ‖g y‖ ^ 2)
    {C D : ℝ} (hC : 0 ≤ C) (hD : 0 ≤ D)
    (hμatom : ∀ m : ℕ,
      (∑ x ∈ Finset.univ.filter (fun x => π x = m), μ x) ≤ C / (m : ℝ))
    (hνatom : ∀ m : ℕ,
      (∑ y ∈ Finset.univ.filter (fun y => τ y = m), ν y) ≤ D / (m : ℝ))
    {u : ℤ} {r : ℕ} (hr : 0 < r) (hcop : (r : ℤ).gcd u = 1)
    {β : ℝ} (hβ : |β| ≤ 1 / (r : ℝ) ^ 2) (ζ : ℝ) :
    let phase := fun x y => minorProductPhase ζ ((u : ℝ) / r + β) (π x) (τ y)
    ‖∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) *
      ((phase x y - finiteTwoKernelAverage μ ν KA KB x y phase) * f x * g y)‖ ≤
      33 * Real.sqrt (6 * C * D * (1 + Real.log r) *
        (1 / (r : ℝ) + 1 / (U : ℝ) + 1 / (V : ℝ) + (r : ℝ) / ((U : ℝ) * V))) *
        Real.sqrt ((∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2) := by
  intro phase
  have hraw := minor_product_phase_dyadic_bound π τ hπ hτ U V hU hV μ ν hμ hν
    f g hf hg hC hD hμatom hνatom hr hcop hβ ζ
  have havg := two_kernel_full_phase_enlarged_dyadic_bound π τ hπ hτ U V hU hV μ ν hμ hν
    KA KB f g hTf hTg hEA hEB hC hD hμatom hνatom hr hcop hβ ζ
  let H := 6 * C * D * (1 + Real.log r) *
    (1 / (r : ℝ) + 1 / (U : ℝ) + 1 / (V : ℝ) + (r : ℝ) / ((U : ℝ) * V))
  have hH : 0 ≤ H := by
    have hl := Real.log_nonneg (by exact_mod_cast hr : (1 : ℝ) ≤ r)
    dsimp only [H]
    positivity
  have hEf : 0 ≤ ∑ x, μ x * ‖f x‖ ^ 2 :=
    Finset.sum_nonneg (fun x _ => mul_nonneg (hμ x) (sq_nonneg _))
  have hEg : 0 ≤ ∑ y, ν y * ‖g y‖ ^ 2 :=
    Finset.sum_nonneg (fun y _ => mul_nonneg (hν y) (sq_nonneg _))
  have hp := norm_sub_le_thirty_three_sqrt (mul_nonneg (mul_nonneg hH hEf) hEg) hraw havg
  have he : (∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) *
      ((phase x y - finiteTwoKernelAverage μ ν KA KB x y phase) * f x * g y)) =
      (∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) * phase x y) -
      (∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) *
        finiteTwoKernelAverage μ ν KA KB x y phase) := by
    simp_rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl
    intro x _
    apply Finset.sum_congr rfl
    intro y _
    push_cast
    ring
  rw [he]
  convert hp using 1
  rw [mul_assoc H, Real.sqrt_mul hH]
  ring

end

