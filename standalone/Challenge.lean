theorem finiteCrossNumerator_fraction (a c l:(_root_.OAI.ActualEisensteinCubic.O)) (p h:ι→(_root_.OAI.ActualEisensteinCubic.O))
    (hc:c≠0) (hp:∀i,p i≠0) :
