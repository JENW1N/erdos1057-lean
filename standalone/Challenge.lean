namespace CubicKubota
open ActualEisensteinCubic ConcreteTraceCRT CubicEisenstein CubicJacobiGlobal CubicRamified



lemma levelTwo_entry_integer (g : levelTwo) (i j : Fin 2) :
    (3:(_root_.OAI.ActualEisensteinCubic.O))∣((g:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) i j-((levelTwoRight g) i j:ℤ)) := by
  have he : Matrix.SpecialLinearGroup.map (n:=Fin 2)
      (Ideal.Quotient.mk (Ideal.span {(3:(_root_.OAI.ActualEisensteinCubic.O))})) (g:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) =
      Matrix.SpecialLinearGroup.map (n:=Fin 2)
      (Ideal.Quotient.mk (Ideal.span {(3:(_root_.OAI.ActualEisensteinCubic.O))})) (rationalEmbedding (levelTwoRight g)) := by
    rw [←levelTwo_product g,map_mul]
    have hn : Matrix.SpecialLinearGroup.map (n:=Fin 2)
        (Ideal.Quotient.mk (Ideal.span {(3:(_root_.OAI.ActualEisensteinCubic.O))})) (levelTwoLeft g:SL(2,(_root_.OAI.ActualEisensteinCubic.O)))=1 := (levelTwoLeft g).property
    rw [hn,one_mul]
  have h := congrArg (fun A : SL(2,(_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {(3:(_root_.OAI.ActualEisensteinCubic.O))})=>A i j) he
  exact Ideal.mem_span_singleton.mp ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp h)

def integerUpper (b : ℤ) : SL(2,ℤ) := ⟨!![1,b;0,1],by simp [Matrix.det_fin_two_of]⟩
def integerLower (c : ℤ) : SL(2,ℤ) := ⟨!![1,0;c,1],by simp [Matrix.det_fin_two_of]⟩

lemma levelTwoComplexCharacter_primary (g : levelTwo)
    (ha : lambda^2∣((g:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) 0 0)-1) :
    levelTwoComplexCharacter g =
      eisEmbedding (symbol ((g:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) 1 0) ((g:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) 0 0)) := by
  let A : SL(2,(_root_.OAI.ActualEisensteinCubic.O)) := g
  let b : ℤ := levelTwoRight g 0 1
  let c : ℤ := levelTwoRight g 1 0
  have hA : (3:(_root_.OAI.ActualEisensteinCubic.O))∣A 0 0-1 := three_dvd_primary_sub_one _ ha
  have hB : (3:(_root_.OAI.ActualEisensteinCubic.O))∣A 0 1-(b:(_root_.OAI.ActualEisensteinCubic.O)) := levelTwo_entry_integer g 0 1
  have hC : (3:(_root_.OAI.ActualEisensteinCubic.O))∣A 1 0-(c:(_root_.OAI.ActualEisensteinCubic.O)) := levelTwo_entry_integer g 1 0
  have hdet : A 0 0*A 1 1-A 0 1*A 1 0=1 := by
    simpa only [Matrix.det_fin_two] using A.property
  have hD : (3:(_root_.OAI.ActualEisensteinCubic.O))∣A 1 1-(1+(b:(_root_.OAI.ActualEisensteinCubic.O))*(c:(_root_.OAI.ActualEisensteinCubic.O))) := by
    have hh := dvd_add (dvd_add (dvd_neg.mpr (dvd_mul_of_dvd_left hA (A 1 1)))
      (dvd_mul_of_dvd_left hB (A 1 0))) (dvd_mul_of_dvd_right hC (b:(_root_.OAI.ActualEisensteinCubic.O)))
    convert hh using 1 ; linear_combination hdet
  let N : SL(2,(_root_.OAI.ActualEisensteinCubic.O)) := ⟨!![A 0 0,A 0 1-(b:(_root_.OAI.ActualEisensteinCubic.O))*A 0 0;
    A 1 0-(c:(_root_.OAI.ActualEisensteinCubic.O))*A 0 0,A 1 1-(c:(_root_.OAI.ActualEisensteinCubic.O))*A 0 1-(b:(_root_.OAI.ActualEisensteinCubic.O))*(A 1 0-(c:(_root_.OAI.ActualEisensteinCubic.O))*A 0 0)],by
    rw [Matrix.det_fin_two_of]
    linear_combination hdet⟩
  have hN : N∈levelThree := by
    apply (mem_levelThree_iff_entries N).mpr
    intro i j
    fin_cases i <;> fin_cases j
    · exact hA
    · have hh:=dvd_sub hB (dvd_mul_of_dvd_right hA (b:(_root_.OAI.ActualEisensteinCubic.O)))
      convert hh using 1 ; dsimp [N] ; ring
    · have hh:=dvd_sub hC (dvd_mul_of_dvd_right hA (c:(_root_.OAI.ActualEisensteinCubic.O)))
      convert hh using 1 ; dsimp [N] ; ring
    · have hh:=dvd_add (dvd_sub (dvd_sub hD (dvd_mul_of_dvd_right hB (c:(_root_.OAI.ActualEisensteinCubic.O))))
        (dvd_mul_of_dvd_right hC (b:(_root_.OAI.ActualEisensteinCubic.O)))) (dvd_mul_of_dvd_right hA ((b:(_root_.OAI.ActualEisensteinCubic.O))*(c:(_root_.OAI.ActualEisensteinCubic.O))))
      convert hh using 1 ; dsimp [N] ; ring
  let lengthScale : levelTwo := ⟨rationalEmbedding (integerLower c),rational_mem_levelTwo _⟩
  let U : levelTwo := ⟨rationalEmbedding (integerUpper b),rational_mem_levelTwo _⟩
  let n : levelThree := ⟨N,hN⟩
  let n2 : levelTwo := ⟨N,levelThree_le_levelTwo hN⟩
  have he : g=lengthScale*n2*U := by
    apply Subtype.ext
    apply Matrix.SpecialLinearGroup.ext
    intro i j
    change A i j = (((!![(1 : ℤ), 0; c, 1]).map (Int.castRingHom (_root_.OAI.ActualEisensteinCubic.O)) *
      (N : Matrix (Fin 2) (Fin 2) (_root_.OAI.ActualEisensteinCubic.O))) *
      (!![(1 : ℤ), b; 0, 1]).map (Int.castRingHom (_root_.OAI.ActualEisensteinCubic.O))) i j
    fin_cases i <;> fin_cases j <;>
      norm_num [N, Matrix.mul_apply, Fin.sum_univ_two] <;> ring
  conv_lhs => rw [he,map_mul,map_mul]
  have hL : levelTwoComplexCharacter lengthScale=1 := levelTwoComplexCharacter_rational _
  have hU : levelTwoComplexCharacter U=1 := levelTwoComplexCharacter_rational _
  rw [hL,hU,one_mul,mul_one]
  change levelTwoComplexCharacter ⟨(n:SL(2,(_root_.OAI.ActualEisensteinCubic.O))),levelThree_le_levelTwo n.property⟩=_
  rw [levelTwoComplexCharacter_restrict]
