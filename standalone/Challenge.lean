/- Every ghost target retains the full source active tuples, including
invalid local events whose target falls back to the source. Consequently
the target is reconstructed exactly from source active labels and target
pending memory. No event-validity or nonzero-weight premise is needed. -/

namespace Bounty

theorem boundedGhostEventTarget_active {P Z : Type*} (t B : ℕ)
    (s : BoundedOrderedState P Z t B) (e : BoundedGhostEvent t B s) :
    (boundedGhostEventTarget t B s e).1 = s.1 := by
  unfold boundedGhostEventTarget
  dsimp only
  split_ifs <;> rfl




theorem coupledGhostJointEventTarget_active {G : Type*} {P Z : G → Type*}
    (M : G → ℕ) (B : ℕ) (s : ProductBoundedOrderedState P Z M B)
    (e : CoupledGhostEvent M B s) (g : G) :
    (coupledGhostJointEventTarget M B s e g).1 = (s g).1 :=
  boundedGhostEventTarget_active (M g) B (s g) (e g)




universe uJ uK uG uP uA

section

variable {J : Type uJ} {K : Type uK} {G : Type uG} {P : G → Type uP}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type uA)
  (Δ D : ∀ k c, A k c → G → ℤ)

theorem fullMixedMemoryEventTarget_ghost_active (j : J)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullMixedMemoryEvent n S B A Δ D (.inl j) s) (g : G) :
    (fullMixedMemoryEventTarget n S B A Δ D (.inl j) s e g).1 = (s g).1 :=
  coupledGhostJointEventTarget_active M B s e.down g




theorem fullPermutationMixedEventTarget_ghost_active (j : J)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s) (g : G) :
    (fullPermutationMixedEventTarget n S B A Δ D (some (.inl j)) s e g).1 = (s g).1 :=
  fullMixedMemoryEventTarget_ghost_active n S B A Δ D j s e g




