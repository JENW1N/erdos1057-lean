variable
  {G I : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hprime : ∀ g p, p ∈ P g → p.Prime)
  (V : G → ℝ)
  (patterns : Finset I)
  (C : I → G → Finset (Fin J))
  {q : ℝ}
  (hq : 0 ≤ q)
  (ζ : ℕ → I → ℝ)
  (k : ℕ → I → ℤ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)

include G I sharedInstance1 sharedInstance2 P J ell hP hprime V patterns C q hq ζ k K

/- CRT transfers the physical path factorization to every independent
residue vector, simultaneously along the entire path. -/
theorem physical_residue_path_term_factor 
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (N : ℕ) (r : PhysicalResidues P) :
    deterministicBarePathTerm
      (fun j a r L => physicalTranslateResidues r (physicalBareStep C (k j) a L))
      (fun j => physicalResidueStepCoeff V patterns C q (ζ j) (k j) (K j))
      (fun _ _ => (1 : ℂ)) (N + 1) r (L 0)
      (fun j : Fin (N + 1) => (a j.val, L (j.val + 1))) =
        physicalBareWalkScalar V patterns C ζ K a L (N + 1) *
          ((∏ j ∈ range (N + 2), physicalResidueVertexWeight (L j)
            (physicalEndpointSchedule q (N + 1) j)
            (physicalTranslateResidues r
              (physicalBareOffset C k a L (N + 1) j)) : ℝ) : ℂ) := by
  obtain ⟨n, rfl⟩ := physical_residues_of_int_surjective hP hprime r
  exact physical_residue_path_term_factor_int V patterns C hq ζ k K a L N n

/- Every finite positive-length residue path has the walk factorization
used to sum its mass against the independent-residue initial law. -/
theorem physical_residue_finite_path_factor 
    (N : ℕ) (L₀ : PhysicalMarkLists P J ell)
    (p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (r : PhysicalResidues P) :
    let a := finitePathLabels p
    let L := finitePathMarks L₀ p
    physicalResidueBarePathTerm V patterns C q ζ k K (N + 1) r L₀ p =
        physicalBareWalkScalar V patterns C ζ K a L (N + 1) *
          ((∏ j ∈ range (N + 2), physicalResidueVertexWeight (L j)
            (physicalEndpointSchedule q (N + 1) j)
            (physicalTranslateResidues r
              (physicalBareOffset C k a L (N + 1) j)) : ℝ) : ℂ) := by
  have h := physical_residue_path_term_factor hP hprime V patterns C hq ζ k K
    (finitePathLabels p) (finitePathMarks L₀ p) N r
  rw [finite_path_sequences] at h
  exact h

end

end

section
open Finset
theorem physical_residue_bare_path_mass_bound {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (patterns : Finset I) (C : I → G → Finset (Fin J))
    (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (H : ℝ) (hH : 0 ≤ H) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    (∀ j (x : PhysicalBareResidueState P J ell),
      (∑ y : PhysicalBareResidueState P J ell, ∑ a : PhysicalEdgeLabels P J ell patterns C,
        ‖physicalResidueLabeledCoeff V patterns C q (ζ j) (k j) (K j) a x y‖) ≤ H) →
    ∀ n : ℕ,
    (∑ x : PhysicalBareResidueState P J ell, physicalResidueInitialMass V x *
      ∑ p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
        ‖deterministicBarePathTerm
          (fun j a r L => physicalTranslateResidues r (physicalBareStep C (k j) a L))
          (fun j => physicalResidueStepCoeff V patterns C q (ζ j) (k j) (K j))
          (fun _ _ => (1 : ℂ)) n x.1 x.2 p‖) ≤ H^n := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro hrow n
  have hb := physical_residue_averaged_path_bound V hV hMass patterns C q ζ k K H hH
    hrow (fun _ _ => (1 : ℂ)) (fun _ _ => by simp) n
  have he (x : PhysicalBareResidueState P J ell) :
      (∑ p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalBareResidueState P J ell,
        ‖labeledPathTerm (fun j a u v => physicalResidueLabeledCoeff V patterns C q (ζ j) (k j) (K j) a u v)
          (fun _ => (1 : ℂ)) n x p‖) =
      ∑ p : Fin n → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
        ‖deterministicBarePathTerm
          (fun j a r L => physicalTranslateResidues r (physicalBareStep C (k j) a L))
          (fun j => physicalResidueStepCoeff V patterns C q (ζ j) (k j) (K j))
          (fun _ _ => (1 : ℂ)) n x.1 x.2 p‖ := by
    exact deterministic_target_absolute_path_sum _ _ (fun _ _ => (1 : ℂ)) n x.1 x.2
  simpa only [he] using hb
end

