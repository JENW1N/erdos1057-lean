/- Finite-depth Buchstab densities and their stable integral recursion. -/

open Filter
open scoped Topology

namespace Bounty

noncomputable def buchstabDepthDensity : ℕ → ℝ → ℝ → ℝ
  | 0, _, w => 1/w
  | n+1, γ, w => 1/w + ∫ α in γ..max γ (w/2), buchstabDepthDensity n α (w-α)/α

theorem buchstab_depth_density_step_eq {γ w : ℝ} (hγ : 0 < γ) (n : ℕ)
    (hw : w ≤ ((n : ℝ)+2)*γ) :
    buchstabDepthDensity (n+1) γ w = buchstabDepthDensity n γ w := by
  induction n generalizing γ w with
  | zero =>
    have hhalf : w/2 ≤ γ := by norm_num at hw; linarith
    simp only [buchstabDepthDensity, max_eq_left hhalf, intervalIntegral.integral_same, add_zero]
  | succ n ih =>
    by_cases hhalf : w/2 ≤ γ
    · simp only [buchstabDepthDensity, max_eq_left hhalf, intervalIntegral.integral_same, add_zero]
    · have hhalf' : γ ≤ w/2 := le_of_lt (lt_of_not_ge hhalf)
      simp only [buchstabDepthDensity, max_eq_right hhalf']
      congr 1
      apply intervalIntegral.integral_congr
      intro α hα
      have hαg : γ ≤ α := (Set.mem_Icc.mp (by simpa only [Set.uIcc_of_le hhalf'] using hα)).1
      have hα0 : 0 < α := hγ.trans_le hαg
      have hwa : w-α ≤ ((n : ℝ)+2)*α := by
        have hm := mul_le_mul_of_nonneg_left hαg (show 0 ≤ (n : ℝ)+3 by positivity)
        push_cast at hw
        nlinarith
      change buchstabDepthDensity (n+1) α (w-α)/α = buchstabDepthDensity n α (w-α)/α
      rw [ih hα0 hwa]

theorem buchstab_depth_density_add_eq {γ w : ℝ} (hγ : 0 < γ) (n k : ℕ)
    (hw : w ≤ ((n : ℝ)+2)*γ) :
    buchstabDepthDensity (n+k) γ w = buchstabDepthDensity n γ w := by
  induction k with
  | zero => simp only [Nat.add_zero]
  | succ k ih =>
    rw [Nat.add_succ, buchstab_depth_density_step_eq hγ (n+k), ih]
    push_cast
    nlinarith

theorem buchstab_depth_density_stable {γ w : ℝ} (hγ : 0 < γ) (m n : ℕ)
    (hm : w ≤ ((m : ℝ)+2)*γ) (hn : w ≤ ((n : ℝ)+2)*γ) :
    buchstabDepthDensity m γ w = buchstabDepthDensity n γ w := by
  by_cases hmn : m ≤ n
  · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hmn
    exact (buchstab_depth_density_add_eq hγ m k hm).symm
  · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le (Nat.le_of_not_ge hmn)
    exact buchstab_depth_density_add_eq hγ n k hn

noncomputable def buchstabDensity (γ w : ℝ) : ℝ :=
  buchstabDepthDensity ⌊w/γ⌋₊ γ w

theorem buchstab_density_depth_bound {γ w : ℝ} (hγ : 0 < γ) :
    w ≤ ((⌊w/γ⌋₊ : ℝ)+2)*γ := by
  have hf := Nat.lt_floor_add_one (w/γ)
  have hh := (div_lt_iff₀ hγ).mp hf
  nlinarith

theorem buchstab_depth_density_eq_density {γ w : ℝ} (hγ : 0 < γ) (n : ℕ)
    (hw : w ≤ ((n : ℝ)+2)*γ) :
    buchstabDepthDensity n γ w = buchstabDensity γ w :=
  buchstab_depth_density_stable hγ n ⌊w/γ⌋₊ hw (buchstab_density_depth_bound hγ)




theorem buchstab_density_integral_recursion {γ w : ℝ} (hγ : 0 < γ) :
    buchstabDensity γ w = 1/w +
      ∫ α in γ..max γ (w/2), buchstabDensity α (w-α)/α := by
  let n := ⌊w/γ⌋₊
  have hw : w ≤ ((n : ℝ)+2)*γ := buchstab_density_depth_bound hγ
  have hs := buchstab_depth_density_step_eq hγ n hw
  change buchstabDepthDensity n γ w = _
  rw [← hs, buchstabDepthDensity]
  congr 1
  by_cases hhalf : w/2 ≤ γ
  · simp only [max_eq_left hhalf, intervalIntegral.integral_same]
  · have hhalf' : γ ≤ w/2 := le_of_lt (lt_of_not_ge hhalf)
    rw [max_eq_right hhalf']
    apply intervalIntegral.integral_congr
    intro α hα
    have hαg : γ ≤ α := (Set.mem_Icc.mp (by simpa only [Set.uIcc_of_le hhalf'] using hα)).1
    have hα0 : 0 < α := hγ.trans_le hαg
    have hwa : w-α ≤ ((n : ℝ)+2)*α := by
      have hm := mul_le_mul_of_nonneg_left hαg (show 0 ≤ (n : ℝ)+2 by positivity)
      linarith
    change buchstabDepthDensity n α (w-α)/α = buchstabDensity α (w-α)/α
    rw [buchstab_depth_density_eq_density hα0 n hwa]

theorem buchstab_density_integral_identity {b : ℝ} (hb : 0 < b) (hbhalf : b ≤ 1/2) :
    (∫ α in b..(1/2 : ℝ), buchstabDensity α (1-α)/α) = buchstabDensity b 1-1 := by
  have h := buchstab_density_integral_recursion (w := 1) hb
  rw [max_eq_right hbhalf] at h
  norm_num at h
  linarith

end Bounty
end

