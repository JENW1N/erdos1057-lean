variable
  {X Y : Type*}
  [sharedInstance1 : Fintype X]
  [sharedInstance2 : Fintype Y]
  (μ : X → ℝ)
  (ν : Y → ℝ)
  (KA : X → X → ℂ)
  (KB : Y → Y → ℂ)
  (x : X)
  (y : Y)

include X Y sharedInstance1 sharedInstance2 μ ν KA KB x y

theorem finite_two_kernel_average_norm_le  (F : X → Y → ℂ) (L RA RB : ℝ)
    (hμ : ∀ d, 0 ≤ μ d) (hν : ∀ e, 0 ≤ ν e) (hL : 0 ≤ L)
    (hA : ∑ d, μ d * ‖KA d x‖ ≤ RA) (hB : ∑ e, ν e * ‖KB e y‖ ≤ RB)
    (hF : ∀ d e, KA d x * KB e y ≠ 0 → ‖F d e‖ ≤ L) :
    ‖finiteTwoKernelAverage μ ν KA KB x y F‖ ≤ L * RA * RB := by
  have hRA : 0 ≤ RA := (sum_nonneg fun d _ => mul_nonneg (hμ d) (norm_nonneg _)).trans hA
  have hRBsum : 0 ≤ ∑ e, ν e * ‖KB e y‖ :=
    sum_nonneg fun e _ => mul_nonneg (hν e) (norm_nonneg _)
  have hterm (d : X) (e : Y) :
      ‖((μ d : ℂ) * KA d x) * ((ν e : ℂ) * KB e y) * F d e‖ ≤
        L * (μ d * ‖KA d x‖) * (ν e * ‖KB e y‖) := by
    by_cases hz : KA d x * KB e y = 0
    · rcases mul_eq_zero.mp hz with hz | hz <;> simp [hz]
    · simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hμ d),
        abs_of_nonneg (hν e)]
      calc
        _ ≤ (μ d * ‖KA d x‖ * (ν e * ‖KB e y‖)) * L :=
          mul_le_mul_of_nonneg_left (hF d e hz)
            (mul_nonneg (mul_nonneg (hμ d) (norm_nonneg _)) (mul_nonneg (hν e) (norm_nonneg _)))
        _ = _ := by ring
  calc
    _ ≤ ∑ d, ∑ e, ‖((μ d : ℂ) * KA d x) * ((ν e : ℂ) * KB e y) * F d e‖ :=
      (norm_sum_le _ _).trans (sum_le_sum fun d _ => norm_sum_le _ _)
    _ ≤ ∑ d, ∑ e, L * (μ d * ‖KA d x‖) * (ν e * ‖KB e y‖) :=
      sum_le_sum fun d _ => sum_le_sum fun e _ => hterm d e
    _ = L * (∑ d, μ d * ‖KA d x‖) * (∑ e, ν e * ‖KB e y‖) := by
      simp only [mul_sum, sum_mul]
      rw [sum_comm]
    _ ≤ L * RA * RB :=
      mul_le_mul (mul_le_mul_of_nonneg_left hA hL) hB hRBsum (mul_nonneg hL hRA)

theorem finite_two_kernel_multiplier_replacement  (M phase : X → Y → ℂ) (L RA RB : ℝ)
    (hμ : ∀ d, 0 ≤ μ d) (hν : ∀ e, 0 ≤ ν e) (hL : 0 ≤ L)
    (hA : ∑ d, μ d * ‖KA d x‖ ≤ RA) (hB : ∑ e, ν e * ‖KB e y‖ ≤ RB)
    (hphase : ∀ d e, ‖phase d e‖ ≤ 1)
    (hM : ∀ d e, KA d x * KB e y ≠ 0 → ‖M d e - M x y‖ ≤ L) :
    ‖finiteTwoKernelAverage μ ν KA KB x y (fun d e => M d e * phase d e) -
        M x y * finiteTwoKernelAverage μ ν KA KB x y phase‖ ≤ L * RA * RB := by
  rw [← finite_two_kernel_average_mul, ← finite_two_kernel_average_sub]
  apply finite_two_kernel_average_norm_le μ ν KA KB x y _ L RA RB hμ hν hL hA hB
  intro d e hde
  change ‖M d e * phase d e - M x y * phase d e‖ ≤ L
  rw [← sub_mul, norm_mul]
  calc
    _ ≤ L * 1 := mul_le_mul (hM d e hde) (hphase d e) (norm_nonneg _) hL
    _ = L := mul_one _

end

end

section

open Finset
open scoped Classical

noncomputable def cleanNonemptySubsets {I : Type*} [DecidableEq I] (U : Finset I) : Finset (Finset I) :=
  U.powerset.erase ∅

theorem clean_mem_nonempty_subsets {I : Type*} [DecidableEq I] (U A : Finset I) :
    A ∈ cleanNonemptySubsets U ↔ A ≠ ∅ ∧ A ⊆ U := by
  simp [cleanNonemptySubsets]

theorem clean_nonempty_subsets_mono {I : Type*} [DecidableEq I] {U V : Finset I} (hUV : U ⊆ V) :
    cleanNonemptySubsets U ⊆ cleanNonemptySubsets V := by
  intro A hA
  rw [clean_mem_nonempty_subsets] at hA ⊢
  exact ⟨hA.1, hA.2.trans hUV⟩

theorem clean_nonempty_subset_sign_sum {I : Type*} [DecidableEq I] (U : Finset I) :
    (∑ A ∈ cleanNonemptySubsets U, (-1 : ℂ) ^ A.card) = if U = ∅ then 0 else -1 := by
  by_cases hU : U = ∅
  · simp [hU, cleanNonemptySubsets]
  · rw [if_neg hU]
    have h : (∑ A ∈ U.powerset, (-1 : ℂ) ^ A.card) = 0 := by
      exact_mod_cast (sum_powerset_neg_one_pow_card_of_nonempty (nonempty_iff_ne_empty.mpr hU))
    have he := sum_erase_add U.powerset (fun A : Finset I => (-1 : ℂ) ^ A.card)
      (show (∅ : Finset I) ∈ U.powerset by simp)
    change (∑ A ∈ U.powerset.erase ∅, (-1 : ℂ) ^ A.card) = -1
    simpa only [card_empty, pow_zero, h, zero_sub] using eq_sub_of_add_eq he

theorem clean_double_subset_sign_sum {I J : Type*} [DecidableEq I] [DecidableEq J] (U : Finset I) (V : Finset J) :
    (∑ A ∈ cleanNonemptySubsets U, ∑ B ∈ cleanNonemptySubsets V,
      (-1 : ℂ) ^ (A.card + B.card)) = if U = ∅ ∨ V = ∅ then 0 else 1 := by
  simp only [pow_add, ← mul_sum, ← sum_mul, clean_nonempty_subset_sign_sum]
  split_ifs <;> simp_all

theorem clean_signed_component_cancellation {I J : Type*} [DecidableEq I] [DecidableEq J] (U : Finset I) (V : Finset J)
    (r : ℂ) (q : Finset I → Finset J → ℂ) :
    r - (∑ A ∈ cleanNonemptySubsets U, ∑ B ∈ cleanNonemptySubsets V,
        (-1 : ℂ) ^ (A.card + B.card) * q A B) =
      (if U = ∅ ∨ V = ∅ then r else 0) -
        ∑ A ∈ cleanNonemptySubsets U, ∑ B ∈ cleanNonemptySubsets V,
          (-1 : ℂ) ^ (A.card + B.card) * (q A B - r) := by
  simp only [mul_sub, sum_sub_distrib, ← sum_mul, clean_double_subset_sign_sum]
  split_ifs <;> ring

noncomputable def cleanSignedComponentBlock {I J : Type*} [DecidableEq I] [DecidableEq J] (U : Finset I) (V : Finset J)
    (r : Finset I → Finset J → ℂ) (q : Finset I → Finset J → Finset I → Finset J → ℂ) : ℂ :=
  ∑ S ∈ U.powerset, ∑ T ∈ V.powerset,
    (r S T - ∑ A ∈ cleanNonemptySubsets (U \ S), ∑ B ∈ cleanNonemptySubsets (V \ T),
      (-1 : ℂ) ^ (A.card + B.card) * q S T A B)

noncomputable def cleanSignedComponentError {I J : Type*} [DecidableEq I] [DecidableEq J] (U : Finset I) (V : Finset J)
    (r : Finset I → Finset J → ℂ) (q : Finset I → Finset J → Finset I → Finset J → ℂ) : ℂ :=
  ∑ S ∈ U.powerset, ∑ T ∈ V.powerset,
    ∑ A ∈ cleanNonemptySubsets (U \ S), ∑ B ∈ cleanNonemptySubsets (V \ T),
      (-1 : ℂ) ^ (A.card + B.card) * (q S T A B - r S T)

theorem clean_exceptional_component_sum {I J : Type*} [DecidableEq I] [DecidableEq J] (U : Finset I) (V : Finset J)
    (r : Finset I → Finset J → ℂ) :
    (∑ S ∈ U.powerset, ∑ T ∈ V.powerset,
      if U \ S = ∅ ∨ V \ T = ∅ then r S T else 0) =
      (∑ T ∈ V.powerset, r U T) + ∑ S ∈ U.powerset.erase U, r S V := by
  rw [← sum_erase_add U.powerset _ (show U ∈ U.powerset by simp)]
  have hfull : (∑ T ∈ V.powerset, if U \ U = ∅ ∨ V \ T = ∅ then r U T else 0) =
      ∑ T ∈ V.powerset, r U T := by simp
  rw [hfull, add_comm]
  congr 1
  apply sum_congr rfl
  intro S hS
  have hSU : S ⊆ U := mem_powerset.mp (mem_erase.mp hS).2
  have hne : U \ S ≠ ∅ := by
    intro h
    exact (mem_erase.mp hS).1 ((sdiff_eq_empty_iff_subset.mp h).antisymm hSU).symm
  calc
    (∑ T ∈ V.powerset, if U \ S = ∅ ∨ V \ T = ∅ then r S T else 0) =
        ∑ T ∈ V.powerset, if T = V then r S T else 0 := by
      apply sum_congr rfl
      intro T hT
      have hTV := mem_powerset.mp hT
      have he : V \ T = ∅ ↔ T = V := by
        constructor
        · intro h; exact hTV.antisymm (sdiff_eq_empty_iff_subset.mp h)
        · rintro rfl; simp
      simp only [hne, false_or, he]
    _ = r S V := by simp

theorem clean_signed_block_cancellation {I J : Type*} [DecidableEq I] [DecidableEq J] (U : Finset I) (V : Finset J)
    (r : Finset I → Finset J → ℂ) (q : Finset I → Finset J → Finset I → Finset J → ℂ) :
    cleanSignedComponentBlock U V r q =
      ((∑ T ∈ V.powerset, r U T) + ∑ S ∈ U.powerset.erase U, r S V) -
        cleanSignedComponentError U V r q := by
  unfold cleanSignedComponentBlock cleanSignedComponentError
  calc
    _ = ∑ S ∈ U.powerset, ∑ T ∈ V.powerset,
        ((if U \ S = ∅ ∨ V \ T = ∅ then r S T else 0) -
          ∑ A ∈ cleanNonemptySubsets (U \ S), ∑ B ∈ cleanNonemptySubsets (V \ T),
            (-1 : ℂ) ^ (A.card + B.card) * (q S T A B - r S T)) := by
      apply sum_congr rfl
      intro S _
      apply sum_congr rfl
      intro T _
      exact clean_signed_component_cancellation _ _ _ _
    _ = _ := by simp only [sum_sub_distrib]; rw [clean_exceptional_component_sum]

/- Each probe is indicated, missing but not freed, or freed. -/
theorem clean_admissible_subset_count {I : Type*} [DecidableEq I] (U : Finset I) :
    (∑ S ∈ U.powerset, (cleanNonemptySubsets (U \ S)).card) ≤ 3 ^ U.card := by
  calc
    _ ≤ ∑ S ∈ U.powerset, 2 ^ (U \ S).card := by
      apply sum_le_sum
      intro S _
      exact (card_erase_le).trans_eq (card_powerset _)
    _ = 3 ^ U.card := by
      have h := prod_add (fun _ : I => (1 : ℕ)) (fun _ : I => (2 : ℕ)) U
      simpa only [prod_const, one_pow, one_mul, show (1 : ℕ) + 2 = 3 by rfl] using h.symm

theorem clean_signed_component_error_bound {I J : Type*} [DecidableEq I] [DecidableEq J] (U : Finset I) (V : Finset J)
    (r : Finset I → Finset J → ℂ) (q : Finset I → Finset J → Finset I → Finset J → ℂ)
    (ε : ℝ) (hε : 0 ≤ ε)
    (herr : ∀ S ∈ U.powerset, ∀ T ∈ V.powerset,
      ∀ A ∈ cleanNonemptySubsets (U \ S), ∀ B ∈ cleanNonemptySubsets (V \ T),
        ‖q S T A B - r S T‖ ≤ ε) :
    ‖cleanSignedComponentError U V r q‖ ≤ (3 : ℝ) ^ (U.card + V.card) * ε := by
  have hU : (∑ S ∈ U.powerset, ((cleanNonemptySubsets (U \ S)).card : ℝ)) ≤ 3 ^ U.card := by
    exact_mod_cast clean_admissible_subset_count U
  have hV : (∑ T ∈ V.powerset, ((cleanNonemptySubsets (V \ T)).card : ℝ)) ≤ 3 ^ V.card := by
    exact_mod_cast clean_admissible_subset_count V
  calc
    _ ≤ ∑ S ∈ U.powerset, ∑ T ∈ V.powerset,
        ∑ A ∈ cleanNonemptySubsets (U \ S), ∑ B ∈ cleanNonemptySubsets (V \ T),
          ‖(-1 : ℂ) ^ (A.card + B.card) * (q S T A B - r S T)‖ := by
      unfold cleanSignedComponentError
      exact (norm_sum_le _ _).trans (sum_le_sum fun S _ =>
        (norm_sum_le _ _).trans (sum_le_sum fun T _ =>
          (norm_sum_le _ _).trans (sum_le_sum fun A _ => norm_sum_le _ _)))
    _ ≤ ∑ S ∈ U.powerset, ∑ T ∈ V.powerset,
        ∑ A ∈ cleanNonemptySubsets (U \ S), ∑ B ∈ cleanNonemptySubsets (V \ T), ε := by
      apply sum_le_sum
      intro S hS
      apply sum_le_sum
      intro T hT
      apply sum_le_sum
      intro A hA
      apply sum_le_sum
      intro B hB
      simpa only [norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul] using herr S hS T hT A hA B hB
    _ = (∑ S ∈ U.powerset, ((cleanNonemptySubsets (U \ S)).card : ℝ)) *
        (∑ T ∈ V.powerset, ((cleanNonemptySubsets (V \ T)).card : ℝ)) * ε := by
      simp only [sum_const, nsmul_eq_mul]
      simp_rw [← mul_sum]
      rw [← sum_mul, ← sum_mul]
      ring
    _ ≤ (3 : ℝ) ^ U.card * 3 ^ V.card * ε := by
      apply mul_le_mul_of_nonneg_right _ hε
      exact mul_le_mul hU hV (sum_nonneg fun _ _ => Nat.cast_nonneg _) (by positivity)
    _ = _ := by rw [pow_add]



end

