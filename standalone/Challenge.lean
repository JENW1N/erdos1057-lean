theorem repeated_big_untilted_target_mass_nonneg {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 ≤ V g)
    (C : G → Finset (Fin J)) (target : RepeatedBigLists P J ell) :
    0 ≤ repeatedBigTargetMass V (fun _ _ => 1) C target := by
  unfold repeatedBigTargetMass
  apply prod_nonneg
  intro g hg
  apply prod_nonneg
  intro s hs
  simpa only [tiltedPhysicalBirthLaw, div_one] using physical_label_law_nonneg V hV g (target g s.val)

theorem repeated_big_untilted_fresh_mass_sum {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) :
    (∑ fresh : RepeatedBigFresh P C ell, repeatedBigFreshMass V (fun _ _ => 1) C fresh) = 1 := by
  unfold repeatedBigFreshMass
  simp only [tiltedPhysicalBirthLaw, div_one]
  have hout := (Fintype.prod_sum
    (fun g (f : {s : PhysicalSlots J ell // repeatedBigUnshared C g s} → P g) =>
      ∏ s, physicalLabelLaw V g (f s))).symm
  rw [hout]
  apply prod_eq_one
  intro g hg
  rw [← Fintype.prod_sum]
  apply prod_eq_one
  intro s hs
  exact physical_label_law_sum V g (hV g) (hMass g)

theorem repeated_big_untilted_compatible_target_mass_sum {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (source : RepeatedBigLists P J ell) :
    (∑ target : RepeatedBigLists P J ell, if repeatedBigSharedCompatible C source target
      then repeatedBigTargetMass V (fun _ _ => 1) C target else 0) = 1 := by
  rw [← repeated_big_target_sum]
  simp_rw [repeated_big_fill_mass]
  exact repeated_big_untilted_fresh_mass_sum V C hV hMass

theorem repeated_big_untilted_kernel_norm_le {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 ≤ V g) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    (aux : PhysicalAuxLabels P C) (source target : RepeatedBigLists P J ell) :
    ‖repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖ ≤
      physicalAuxMass V C aux * B *
        (if repeatedBigSharedCompatible C source target then
          repeatedBigTargetMass V (fun _ _ => 1) C target else 0) := by
  have ha := physical_aux_mass_nonneg V C hV aux
  have ht := repeated_big_untilted_target_mass_nonneg V hV C target
  unfold repeatedBigKernel
  by_cases h : repeatedBigSharedCompatible C source target ∧
      repeatedBigAuxAvoids C aux source ∧ repeatedBigAuxAvoids C aux target
  · rw [if_pos h, if_pos h.1, norm_mul, norm_mul, physical_phase_norm, mul_one, Complex.norm_real,
      Real.norm_eq_abs, abs_of_nonneg (mul_nonneg ha ht)]
    calc
      _ ≤ (physicalAuxMass V C aux * repeatedBigTargetMass V (fun _ _ => 1) C target) * B :=
        mul_le_mul_of_nonneg_left (hK source target aux) (mul_nonneg ha ht)
      _ = _ := by ring
  · rw [if_neg h, norm_zero]
    by_cases hs : repeatedBigSharedCompatible C source target
    · rw [if_pos hs]
      exact mul_nonneg (mul_nonneg ha hB) ht
    · rw [if_neg hs, mul_zero]

/- Both independent draws and endpoint collision bans are the actual kernel's.
Dropping the bans can only increase this nonnegative row mass. -/
theorem repeated_big_untilted_kernel_row_bound {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    (source : RepeatedBigLists P J ell) :
    (∑ aux, ∑ target, ‖repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖) ≤ B := by
  calc
    _ ≤ ∑ aux : PhysicalAuxLabels P C, ∑ target : RepeatedBigLists P J ell,
        physicalAuxMass V C aux * B *
          (if repeatedBigSharedCompatible C source target then
            repeatedBigTargetMass V (fun _ _ => 1) C target else 0) := by
      exact sum_le_sum (fun aux _ => sum_le_sum (fun target _ =>
        repeated_big_untilted_kernel_norm_le V C (fun g => (hV g).le) ζ K B hB hK aux source target))
    _ = ∑ aux : PhysicalAuxLabels P C, physicalAuxMass V C aux * B := by
      simp_rw [← mul_sum, repeated_big_untilted_compatible_target_mass_sum V C hV hMass source, mul_one]
    _ = B := by rw [← sum_mul, physical_aux_mass_sum V C hV hMass, one_mul]
end

