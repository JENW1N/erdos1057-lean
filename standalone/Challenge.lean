theorem unrestricted_product_energy_le
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, t g ≤ T)
    (phase : ∀ g, UnrestrictedBoundedPhase (n g) (Δ g) (D g) (t g) B)
    (hphase : ∀ g s stores promotions e fresh, ‖phase g s stores promotions e fresh‖ ≤ 1)
    (groups : Finset G)
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (unrestrictedProductOperator n Δ D μ ρ V t B phase groups f) ≤
    unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ groups.card *
      finiteWeightedEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) f := by
  rw [← unrestricted_projected_product_eq_of_symmetric n Δ D μ ρ V t B phase groups f hf]
  exact (by
    have h := finite_coordinate_finset_energy_le
      (fun g => boundedOrderedStateWeight (μ g) (unrestrictedResidueWeight (μ g)))
      (fun g s => boundedOrderedStateWeight_nonneg (μ g) (unrestrictedResidueWeight (μ g))
        (hμ g) (fun z => hμ g z.1) s)
      (fun g => unrestrictedProjectedOperator (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B (phase g))
      (fun _ => unrestrictedEdgeEnergyBound ρ v vmin vmax T)
      (fun _ => unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T)
      (fun g f => unrestricted_projected_operator_energy_le (n g) (Δ g) (D g) (μ g)
        hρ0 hρ1 hv hvmin (hVlo g) (hVhi g) (hμ g) (hmass g) (t g) B T (ht g)
        (phase g) (hphase g) f) groups f
    simpa only [prod_const, finiteWeightedEnergy, finiteProductWeight, productMemoryWeight,
      unrestrictedProjectedProductOperator] using h
