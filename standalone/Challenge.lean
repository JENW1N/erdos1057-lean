    (hU : U ⊆ G∪S)
    (hn : FirstPassCubeLabels.normalizedColumn p
      (fun R => g (FirstPassCubeLabels.columnLog p X R)) (G∪S) ≠ 0) :
    primeProductNorm p U ≤ X*Real.exp A := by
