open Finset
theorem physical_group_unshared_source_not_dvd {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (havoid : physicalAuxAvoids C aux L) (g : G)
    (i : Fin (ell + (C g).card)) :
    ¬ ((physicalGroupUnsharedEmbedding C L g i).val : ℤ) ∣
      (physicalD C L aux : ℤ) := by
  rw [Int.natCast_dvd_natCast]
  exact physical_unshared_mark_not_dvd_D C L aux hP hdis havoid g
    (physicalGroupUnsharedIndex (ell := ell) (C g) i).val
    (physicalGroupUnsharedIndex (ell := ell) (C g) i).property

theorem physical_group_unshared_target_not_dvd {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L R : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hlist : physicalListAdmissible C aux L R)
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (i : Fin (ell + (C g).card)) :
    ¬ ((physicalGroupUnsharedEmbedding C R g i).val : ℤ) ∣
      (physicalD C L aux : ℤ) := by
  rw [physical_D_eq_of_shared C hlist.1 aux]
  exact physical_group_unshared_source_not_dvd C R aux hP hdis hlist.2.2 g i

theorem physical_group_phase_delta_as_integer_step {G : Type*}
    {P : G → Finset ℕ} (a b k D : ℤ) (hstep : b = a + k * D) (g : G) :
    physicalGroupPhaseDelta (P := P) a b g =
      fun p : ↥(P g) => ((-k * D : ℤ) : ZMod p.val) := by
  funext p
  unfold physicalGroupPhaseDelta
  congr 1
  rw [hstep]
  ring
end

section
open Finset
theorem exists_prime_reciprocal_shell_bound :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ w : ℝ, 1 < w → primeBandHarmonic w (w^2) ≤ C := by
  obtain ⟨vmin, vmax, t0, _, hvmax, _, hlarge⟩ :=
    exists_primeBandHarmonic_threshold (by norm_num : (1 : ℝ) < 2)
  let M := primeBandHarmonic 0 (Real.exp (2*t0))
  have hM : 0 ≤ M := primeBandHarmonic_nonneg _ _
  refine ⟨vmax + M, add_nonneg hvmax.le hM, ?_⟩
  intro w hw
  have hw0 : 0 < w := zero_lt_one.trans hw
  have he : Real.exp (2 * Real.log w) = w^2 := by
    rw [two_mul, Real.exp_add, Real.exp_log hw0, pow_two]
  by_cases ht : t0 ≤ Real.log w
  · have hb := (hlarge (Real.log w) ht).2
    rw [Real.exp_log hw0, he] at hb
    exact hb.trans (le_add_of_nonneg_right hM)
  · have hwtop : w^2 ≤ Real.exp (2*t0) := by
      rw [← he]
      apply Real.exp_le_exp.mpr
      linarith
    have hsub : primeBand w (w^2) ⊆ primeBand 0 (Real.exp (2*t0)) := by
      intro p hp
      obtain ⟨hp, hwp, hpw⟩ := (mem_primeBand_iff hw0.le (sq_nonneg w) p).mp hp
      exact (mem_primeBand_iff le_rfl (Real.exp_pos _).le p).mpr
        ⟨hp, hw0.trans hwp, hpw.trans hwtop⟩
    have hb : primeBandHarmonic w (w^2) ≤ M :=
      sum_le_sum_of_subset_of_nonneg hsub (fun p _ _ => by positivity)
    exact hb.trans (le_add_of_nonneg_left hvmax.le)

theorem finite_prime_reciprocal_shell_le_band (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) {w : ℝ} (hw : 1 < w) :
    (∑ p ∈ P.filter (fun p : ℕ => w < (p : ℝ) ∧ (p : ℝ) ≤ w^2), 1 / (p : ℝ)) ≤
      primeBandHarmonic w (w^2) := by
  have hsub : P.filter (fun p : ℕ => w < (p : ℝ) ∧ (p : ℝ) ≤ w^2) ⊆
      primeBand w (w^2) := by
    intro p hp
    obtain ⟨hp, hlo, hhi⟩ := mem_filter.mp hp
    exact (mem_primeBand_iff (zero_lt_one.trans hw).le (sq_nonneg w) p).mpr
      ⟨hP p hp, hlo, hhi⟩
  exact sum_le_sum_of_subset_of_nonneg hsub (fun p _ _ => by positivity)

theorem exists_finite_prime_reciprocal_shell_bound :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ P : Finset ℕ, (∀ p ∈ P, p.Prime) →
      ∀ w : ℝ, 1 < w →
        (∑ p ∈ P.filter (fun p : ℕ => w < (p : ℝ) ∧ (p : ℝ) ≤ w^2), 1 / (p : ℝ)) ≤ C := by
  obtain ⟨C, hC, hbound⟩ := exists_prime_reciprocal_shell_bound
  refine ⟨C, hC, ?_⟩
  intro P hP w hw
  exact (finite_prime_reciprocal_shell_le_band P hP hw).trans (hbound w hw)
end

section
open Finset
theorem interval_multiples_card (A B d : ℕ) (hAB : A ≤ B) :
    ((Ioc A B).filter (fun n => d ∣ n)).card = B / d - A / d := by
  have hd : Disjoint ((Ioc 0 A).filter (fun n => d ∣ n))
      ((Ioc A B).filter (fun n => d ∣ n)) :=
    (Ioc_disjoint_Ioc_of_le (le_refl A)).mono (filter_subset _ _) (filter_subset _ _)
  have hu : ((Ioc 0 A).filter (fun n => d ∣ n)) ∪
      ((Ioc A B).filter (fun n => d ∣ n)) = (Ioc 0 B).filter (fun n => d ∣ n) := by
    rw [← filter_union, Ioc_union_Ioc_eq_Ioc (Nat.zero_le A) hAB]
  have hcard := card_union_of_disjoint hd
  rw [hu, Nat.Ioc_filter_dvd_card_eq_div, Nat.Ioc_filter_dvd_card_eq_div] at hcard
  omega

theorem nat_real_div_lt_cast_div_add_one (m d : ℕ) (hd : 0 < d) :
    (m : ℝ) / (d : ℝ) < ((m / d : ℕ) : ℝ) + 1 := by
  have hm : m < (m / d + 1) * d := by
    calc
      m = m % d + d * (m / d) := (Nat.mod_add_div m d).symm
      _ < d + d * (m / d) := Nat.add_lt_add_right (Nat.mod_lt m hd) _
      _ = (m / d + 1) * d := by ring
  have hmR : (m : ℝ) < (((m / d : ℕ) : ℝ) + 1) * (d : ℝ) := by exact_mod_cast hm
  exact (div_lt_iff₀ (Nat.cast_pos.mpr hd)).mpr hmR

theorem interval_multiples_error_lt_one (A B d : ℕ) (hAB : A ≤ B) (hd : 0 < d) :
    |(((Ioc A B).filter (fun n => d ∣ n)).card : ℝ) -
      ((B : ℝ) - (A : ℝ)) / (d : ℝ)| < 1 := by
  rw [interval_multiples_card A B d hAB, Nat.cast_sub (Nat.div_le_div_right hAB), sub_div]
  have hAlo : ((A / d : ℕ) : ℝ) ≤ (A : ℝ) / d := Nat.cast_div_le
  have hBlo : ((B / d : ℕ) : ℝ) ≤ (B : ℝ) / d := Nat.cast_div_le
  have hAhi := nat_real_div_lt_cast_div_add_one A d hd
  have hBhi := nat_real_div_lt_cast_div_add_one B d hd
  apply abs_lt.mpr
  constructor <;> linarith

theorem interval_multiples_error_le_one (A B d : ℕ) (hAB : A ≤ B) (hd : 0 < d) :
    |(((Ioc A B).filter (fun n => d ∣ n)).card : ℝ) -
      ((B : ℝ) - (A : ℝ)) / (d : ℝ)| ≤ 1 :=
  (interval_multiples_error_lt_one A B d hAB hd).le
end

section
open Finset
theorem mem_small_prime_pool_iff {z : ℝ} (hz : 0 ≤ z) (p : ℕ) :
    p ∈ primeBand 0 z ↔ p.Prime ∧ (p : ℝ) ≤ z := by
  rw [mem_primeBand_iff le_rfl hz]
  constructor
  · exact fun hp => ⟨hp.1, hp.2.2⟩
  · exact fun hp => ⟨hp.1, Nat.cast_pos.mpr hp.1.pos, hp.2⟩

theorem small_prime_pool_prime {z : ℝ} {p : ℕ} (hp : p ∈ primeBand 0 z) : p.Prime :=
  (mem_filter.mp hp).2

theorem small_prime_pool_le {z : ℝ} (hz : 0 ≤ z) {p : ℕ} (hp : p ∈ primeBand 0 z) :
    (p : ℝ) ≤ z := ((mem_small_prime_pool_iff hz p).mp hp).2

theorem small_prime_avoidance_iff_rough {z : ℝ} {n : ℕ} (hz : 0 ≤ z) (hn : n ≠ 0) :
    (∀ p ∈ primeBand 0 z, ¬p ∣ n) ↔ ∀ p ∈ n.primeFactors, z < (p : ℝ) := by
  constructor
  · intro hav p hp
    by_contra hnot
    exact hav p ((mem_small_prime_pool_iff hz p).mpr
      ⟨Nat.prime_of_mem_primeFactors hp, le_of_not_gt hnot⟩) (Nat.dvd_of_mem_primeFactors hp)
  · intro hrough p hp hdiv
    have hlarge := hrough p (Nat.mem_primeFactors.mpr ⟨small_prime_pool_prime hp, hdiv, hn⟩)
    exact (not_lt_of_ge (small_prime_pool_le hz hp)) hlarge

theorem interval_small_prime_avoidance_eq_rough (A B : ℕ) {z : ℝ} (hz : 0 ≤ z) :
    (Ioc A B).filter (fun n : ℕ => ∀ p ∈ primeBand 0 z, ¬p ∣ n) =
      (Ioc A B).filter (fun n : ℕ => ∀ p : ℕ, p ∈ n.primeFactors → z < (p : ℝ)) := by
  classical
  apply filter_congr
  intro n hn
  have hn0 : n ≠ 0 := (lt_of_le_of_lt (Nat.zero_le A) (mem_Ioc.mp hn).1).ne'
  exact small_prime_avoidance_iff_rough hz hn0






end

section
open Finset MeasureTheory
private theorem theta_eq_log_sum (x : ℝ) :
    Chebyshev.theta x =
      ∑ n ∈ Icc 0 ⌊x⌋₊, if n.Prime then Real.log (n : ℝ) else 0 := by
  rw [Chebyshev.theta_eq_sum_Icc, sum_filter]

private theorem theta_quotient_integrable {z : ℝ} (hz : 1 ≤ z) :
    IntervalIntegrable (fun t => Chebyshev.theta t / t^2) volume 1 z := by
  rw [intervalIntegrable_iff_integrableOn_Icc_of_le hz]
  have hg : IntegrableOn (fun t : ℝ => (t^2)⁻¹) (Set.Icc 1 z) := by
    apply ContinuousOn.integrableOn_Icc
    intro t ht
    have ht0 : t ≠ 0 := by linarith [ht.1]
    have ht2 : t^2 ≠ 0 := pow_ne_zero 2 ht0
    fun_prop
  have hi := integrableOn_mul_sum_Icc
    (fun n => if n.Prime then Real.log (n : ℝ) else 0) (by norm_num : (0 : ℝ) ≤ 1)
    hg (m := 0)
  simpa only [← theta_eq_log_sum, div_eq_mul_inv, mul_comm] using hi

theorem prime_log_reciprocal_sum_eq_abel {z : ℝ} (hz : 1 ≤ z) :
    (∑ p ∈ primeBand 0 z, Real.log (p : ℝ) / p) =
      Chebyshev.theta z / z + ∫ t in (1 : ℝ)..z, Chebyshev.theta t / t^2 := by
  let c : ℕ → ℝ := fun n => if n.Prime then Real.log (n : ℝ) else 0
  have hc (x : ℝ) : (∑ n ∈ Icc 0 ⌊x⌋₊, c n) = Chebyshev.theta x :=
    (theta_eq_log_sum x).symm
  have hd : ∀ t ∈ Set.Icc (1 : ℝ) z, DifferentiableAt ℝ (fun t : ℝ => t⁻¹) t := by
    intro t ht
    have ht0 : t ≠ 0 := by linarith [ht.1]
    fun_prop
  have hi : IntegrableOn (deriv (fun t : ℝ => t⁻¹)) (Set.Icc 1 z) := by
    simp only [deriv_inv']
    apply ContinuousOn.integrableOn_Icc
    intro t ht
    have ht0 : t ≠ 0 := by linarith [ht.1]
    have ht2 : t^2 ≠ 0 := pow_ne_zero 2 ht0
    fun_prop
  have hs := sum_mul_eq_sub_sub_integral_mul c (by norm_num : (0 : ℝ) ≤ 1) hz hd hi
  have hl : (∑ n ∈ Ioc ⌊(1 : ℝ)⌋₊ ⌊z⌋₊, (n : ℝ)⁻¹ * c n) =
      ∑ p ∈ primeBand 0 z, Real.log (p : ℝ) / p := by
    have hsets : (Ioc 1 ⌊z⌋₊).filter Nat.Prime = primeBand 0 z := by
      ext p
      simp only [primeBand, Nat.floor_zero, mem_filter, mem_Ioc]
      constructor
      · rintro ⟨⟨hp, hpz⟩, hprime⟩
        exact ⟨⟨by omega, hpz⟩, hprime⟩
      · rintro ⟨⟨_, hpz⟩, hprime⟩
        exact ⟨⟨hprime.one_lt, hpz⟩, hprime⟩
    rw [Nat.floor_one, ← hsets, sum_filter]
    apply sum_congr rfl
    intro p _
    simp only [c, mul_ite, mul_zero, div_eq_mul_inv]
    split_ifs <;> ring
  have he : (fun t : ℝ => deriv (fun t : ℝ => t⁻¹) t *
      ∑ n ∈ Icc 0 ⌊t⌋₊, c n) = (fun t => -(Chebyshev.theta t / t^2)) := by
    funext t
    rw [deriv_inv, hc]
    ring
  rw [hl, hc, hc, Chebyshev.theta_one, mul_zero, sub_zero,
    he, integral_neg, ← intervalIntegral.integral_of_le hz, sub_neg_eq_add] at hs
  simpa only [div_eq_mul_inv, mul_comm] using hs

theorem prime_log_reciprocal_sum_le {z : ℝ} (hz : 1 ≤ z) :
    (∑ p ∈ primeBand 0 z, Real.log (p : ℝ) / p) ≤
      Real.log 4 * (1 + Real.log z) := by
  have hz0 : 0 < z := zero_lt_one.trans_le hz
  have hlog : IntervalIntegrable (fun t : ℝ => 1 / t) volume 1 z := by
    apply ContinuousOn.intervalIntegrable
    intro t ht
    rw [Set.uIcc_of_le hz] at ht
    have ht0 : t ≠ 0 := by linarith [ht.1]
    fun_prop
  have hib : (∫ t in (1 : ℝ)..z, Chebyshev.theta t / t^2) ≤
      Real.log 4 * Real.log z := by
    calc
      _ ≤ ∫ t in (1 : ℝ)..z, Real.log 4 * (1 / t) := by
        apply intervalIntegral.integral_mono_on hz (theta_quotient_integrable hz)
          (hlog.const_mul _)
        intro t ht
        have ht0 : 0 < t := zero_lt_one.trans_le ht.1
        have htheta := Chebyshev.theta_le_log4_mul_x ht0.le
        calc
          Chebyshev.theta t / t^2 ≤ (Real.log 4 * t) / t^2 :=
            div_le_div_of_nonneg_right htheta (sq_nonneg t)
          _ = Real.log 4 * (1 / t) := by field_simp
      _ = Real.log 4 * Real.log z := by
        rw [intervalIntegral.integral_const_mul]
        congr 1
        simp only [one_div]
        rw [integral_inv (by simp [Set.uIcc_of_le hz]), div_one]
  have he : Chebyshev.theta z / z ≤ Real.log 4 := by
    exact (div_le_iff₀ hz0).mpr (Chebyshev.theta_le_log4_mul_x hz0.le)
  rw [prime_log_reciprocal_sum_eq_abel hz]
  nlinarith

theorem finite_prime_log_reciprocal_sum_le (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) {z : ℝ} (hz : 1 ≤ z)
    (hbound : ∀ p ∈ P, (p : ℝ) ≤ z) :
    (∑ p ∈ P, Real.log (p : ℝ) / p) ≤ Real.log 4 * (1 + Real.log z) := by
  apply le_trans _ (prime_log_reciprocal_sum_le hz)
  apply sum_le_sum_of_subset_of_nonneg
  · intro p hp
    exact (mem_primeBand_iff (by norm_num) (by linarith) p).mpr
      ⟨hP p hp, by exact_mod_cast (hP p hp).pos, hbound p hp⟩
  · intro p _ _
    exact div_nonneg (Real.log_natCast_nonneg p) (Nat.cast_nonneg p)

theorem subset_log_moment_bound {ι : Type*} (P : Finset ι) (a w : ι → ℝ)
    (ha : ∀ p ∈ P, 0 ≤ a p) (hw : ∀ p ∈ P, 0 ≤ w p) :
    (∑ S ∈ P.powerset, (∑ p ∈ S, w p) * ∏ p ∈ S, a p) ≤
      (∏ p ∈ P, (1 + a p)) * ∑ p ∈ P, w p * a p := by
  classical
  induction P using Finset.induction_on with
  | empty => simp
  | @insert p P hp ih =>
    have hap := ha p (mem_insert_self _ _)
    have hwp := hw p (mem_insert_self _ _)
    have haP : ∀ r ∈ P, 0 ≤ a r := fun r hr => ha r (mem_insert_of_mem hr)
    have hwP : ∀ r ∈ P, 0 ≤ w r := fun r hr => hw r (mem_insert_of_mem hr)
    have hrec := ih haP hwP
    have hZ : 0 ≤ ∏ r ∈ P, (1 + a r) :=
      prod_nonneg (fun r hr => by linarith [haP r hr])
    have hnew : (∑ S ∈ P.powerset, (∑ r ∈ insert p S, w r) *
        ∏ r ∈ insert p S, a r) =
        a p * (∑ S ∈ P.powerset, (∑ r ∈ S, w r) * ∏ r ∈ S, a r) +
        (w p * a p) * ∏ r ∈ P, (1 + a r) := by
      rw [prod_one_add, mul_sum, mul_sum, ← sum_add_distrib]
      apply sum_congr rfl
      intro S hS
      have hpS : p ∉ S := fun h => hp ((mem_powerset.mp hS) h)
      rw [sum_insert hpS, prod_insert hpS]
      ring
    rw [sum_powerset_insert hp, hnew, prod_insert hp, sum_insert hp]
    have hdiff := mul_nonneg hap (sub_nonneg.mpr hrec)
    have hextra := mul_nonneg (mul_nonneg hap (mul_nonneg hwp hap)) hZ
    nlinarith

/- A logarithmic moment bound converts directly into a bound for reciprocal mass. -/
theorem finite_reciprocal_mass_le_of_log_moment (T : Finset ℕ)
    (hT : ∀ n ∈ T, 0 < n) {B : ℝ} (hB : 0 < B)
    (hmoment : (∑ n ∈ T, Real.log (n : ℝ) / n) ≤
      B * ∑ n ∈ T, 1 / (n : ℝ)) :
    (∑ n ∈ T, 1 / (n : ℝ)) ≤ 2 + 4 * B := by
  classical
  let F : Finset ℕ := T.filter (fun n : ℕ => (n : ℝ) ≤ Real.exp (2 * B))
  have hF : F ⊆ Icc 1 ⌊Real.exp (2 * B)⌋₊ := by
    intro n hn
    obtain ⟨hnT, hcut⟩ := mem_filter.mp hn
    exact mem_Icc.mpr ⟨hT n hnT, Nat.le_floor hcut⟩
  have hlow : (∑ n ∈ F, 1 / (n : ℝ)) ≤ 1 + 2 * B := by
    calc
      _ ≤ ∑ n ∈ Icc 1 ⌊Real.exp (2 * B)⌋₊, 1 / (n : ℝ) :=
        sum_le_sum_of_subset_of_nonneg hF (fun n _ _ => by positivity)
      _ = (harmonic ⌊Real.exp (2 * B)⌋₊ : ℝ) := by
        simp only [harmonic_eq_sum_Icc, Rat.cast_sum, Rat.cast_inv, Rat.cast_natCast,
          one_div]
      _ ≤ 1 + Real.log (Real.exp (2 * B)) :=
        harmonic_floor_le_one_add_log _ (Real.one_le_exp (by linarith))
      _ = 1 + 2 * B := by rw [Real.log_exp]
  have hpoint (n : ℕ) (hn : n ∈ T) :
      (2 * B) * (1 / (n : ℝ)) ≤
        (2 * B) * (if (n : ℝ) ≤ Real.exp (2 * B) then 1 / (n : ℝ) else 0) +
          Real.log (n : ℝ) / n := by
    have hn0 : (0 : ℝ) < n := by exact_mod_cast hT n hn
    split_ifs with hcut
    · linarith [div_nonneg (Real.log_natCast_nonneg n) hn0.le]
    · have hlog : 2 * B ≤ Real.log (n : ℝ) :=
        (Real.le_log_iff_exp_le hn0).mpr (le_of_not_ge hcut)
      simpa only [mul_zero, zero_add, mul_one_div] using
        (div_le_div_of_nonneg_right hlog hn0.le)
  have hsum := sum_le_sum hpoint
  simp only [sum_add_distrib, ← mul_sum, ← sum_filter] at hsum
  change (2 * B) * (∑ n ∈ T, 1 / (n : ℝ)) ≤
    (2 * B) * (∑ n ∈ F, 1 / (n : ℝ)) +
      ∑ n ∈ T, Real.log (n : ℝ) / n at hsum
  have hhalf : (∑ n ∈ T, 1 / (n : ℝ)) ≤ 2 * (∑ n ∈ F, 1 / (n : ℝ)) := by
    nlinarith
  linarith

theorem finite_prime_euler_product_le_of_log_sum (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) {B : ℝ} (hB : 0 < B)
    (hlog : (∑ p ∈ P, Real.log (p : ℝ) / p) ≤ B) :
    (∏ p ∈ P, (1 + 1 / (p : ℝ))) ≤ 2 + 4 * B := by
  classical
  let T : Finset ℕ := P.powerset.image (fun S : Finset ℕ => ∏ p ∈ S, p)
  have hinj : Set.InjOn (fun S : Finset ℕ => ∏ p ∈ S, p) P.powerset := by
    intro S hS U hU heq
    have hs : (∏ p ∈ S, p).primeFactors = S := Nat.primeFactors_prod
      (fun p hp => hP p ((mem_powerset.mp hS) hp))
    have hu : (∏ p ∈ U, p).primeFactors = U := Nat.primeFactors_prod
      (fun p hp => hP p ((mem_powerset.mp hU) hp))
    rw [← hs, ← hu]
    exact congrArg Nat.primeFactors heq
  have hpos (S : Finset ℕ) (hS : S ∈ P.powerset) : 0 < ∏ p ∈ S, p :=
    prod_pos (fun p hp => (hP p ((mem_powerset.mp hS) hp)).pos)
  have hT : ∀ n ∈ T, 0 < n := by
    intro n hn
    obtain ⟨S, hS, rfl⟩ := mem_image.mp hn
    exact hpos S hS
  have hprod (S : Finset ℕ) :
      (1 : ℝ) / ((∏ p ∈ S, p : ℕ) : ℝ) = ∏ p ∈ S, 1 / (p : ℝ) := by
    simp only [Nat.cast_prod, one_div, prod_inv_distrib]
  have hmass : (∑ n ∈ T, 1 / (n : ℝ)) = ∏ p ∈ P, (1 + 1 / (p : ℝ)) := by
    change (∑ n ∈ P.powerset.image (fun S => ∏ p ∈ S, p), 1 / (n : ℝ)) = _
    rw [sum_image hinj]
    simp_rw [hprod]
    exact (prod_one_add P).symm
  have hmoment : (∑ n ∈ T, Real.log (n : ℝ) / n) =
      ∑ S ∈ P.powerset, (∑ p ∈ S, Real.log (p : ℝ)) * ∏ p ∈ S, 1 / (p : ℝ) := by
    change (∑ n ∈ P.powerset.image (fun S => ∏ p ∈ S, p), Real.log (n : ℝ) / n) = _
    rw [sum_image hinj]
    apply sum_congr rfl
    intro S hS
    rw [div_eq_mul_inv, ← one_div, hprod]
    congr 1
    rw [Nat.cast_prod, Real.log_prod]
    intro p hp
    exact_mod_cast (hP p ((mem_powerset.mp hS) hp)).ne_zero
  rw [← hmass]
  apply finite_reciprocal_mass_le_of_log_moment T hT hB
  rw [hmoment, hmass]
  calc
    _ ≤ (∏ p ∈ P, (1 + 1 / (p : ℝ))) * ∑ p ∈ P, Real.log (p : ℝ) * (1 / p) :=
      subset_log_moment_bound P (fun p => 1 / (p : ℝ)) (fun p => Real.log (p : ℝ))
        (fun p _ => by positivity) (fun p _ => Real.log_natCast_nonneg p)
    _ ≤ (∏ p ∈ P, (1 + 1 / (p : ℝ))) * B := by
      apply mul_le_mul_of_nonneg_left _ (prod_nonneg (fun p _ => by positivity))
      simpa only [mul_one_div] using hlog
    _ = B * ∏ p ∈ P, (1 + 1 / (p : ℝ)) := by ring

theorem finite_prime_euler_product_le (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) {z : ℝ} (hz : 1 ≤ z)
    (hbound : ∀ p ∈ P, (p : ℝ) ≤ z) :
    (∏ p ∈ P, (1 + 1 / (p : ℝ))) ≤
      2 + 4 * Real.log 4 * (1 + Real.log z) := by
  have hB : 0 < Real.log 4 * (1 + Real.log z) :=
    mul_pos (Real.log_pos (by norm_num)) (by linarith [Real.log_nonneg hz])
  convert finite_prime_euler_product_le_of_log_sum P hP hB
    (finite_prime_log_reciprocal_sum_le P hP hz hbound) using 1
  ring

noncomputable def primeEulerProductUpperConstant : ℝ :=
  (2 + 4 * Real.log 4) / Real.log 2 + 4 * Real.log 4

theorem primeEulerProductUpperConstant_pos : 0 < primeEulerProductUpperConstant := by
  have h2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have h4 : 0 < Real.log 4 := Real.log_pos (by norm_num)
  unfold primeEulerProductUpperConstant
  positivity

theorem finite_prime_euler_product_le_log (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) {z : ℝ} (hz : 1 ≤ z)
    (hbound : ∀ p ∈ P, (p : ℝ) ≤ z) :
    (∏ p ∈ P, (1 + 1 / (p : ℝ))) ≤
      primeEulerProductUpperConstant * Real.log (2 * z) := by
  apply (finite_prime_euler_product_le P hP hz hbound).trans
  have h2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have h4 : 0 < Real.log 4 := Real.log_pos (by norm_num)
  have hzlog : 0 ≤ Real.log z := Real.log_nonneg hz
  have hz0 : z ≠ 0 := ne_of_gt (zero_lt_one.trans_le hz)
  unfold primeEulerProductUpperConstant
  rw [Real.log_mul (by norm_num) hz0]
  have hcancel : ((2 + 4 * Real.log 4) / Real.log 2) * Real.log 2 =
      2 + 4 * Real.log 4 := div_mul_cancel₀ _ h2.ne'
  have hpos : 0 ≤ (2 + 4 * Real.log 4) / Real.log 2 := by positivity
  nlinarith [mul_nonneg hpos hzlog, mul_nonneg h4.le h2.le]



end

section
open scoped BigOperators Classical
theorem finite_probability_gram_diagonal {X : Type*} [Fintype X]
    (μ : X → ℝ) (hmass : ∑ x, μ x = 1) (ψ : X → ℂ)
    (hunit : ∀ x, μ x ≠ 0 → ‖ψ x‖ = 1) :
    (∑ x, (μ x : ℂ) * (starRingEnd ℂ) (ψ x) * ψ x) = 1 := by
  calc
    _ = ∑ x, (μ x : ℂ) := by
      apply Finset.sum_congr rfl
      intro x _
      by_cases hx : μ x = 0
      · simp only [hx, Complex.ofReal_zero, zero_mul]
      · rw [mul_assoc, Complex.conj_mul', hunit x hx]
        simp
    _ = 1 := by rw [← Complex.ofReal_sum, hmass, Complex.ofReal_one]

theorem finite_measure_frame_reverse_pairing {X I : Type*} [Fintype X] [Fintype I]
    (μ : X → ℝ) (ψ : I → X → ℂ) (k : I) (y : X) :
    (∑ x, (μ x : ℂ) * finiteMeasureFrameKernel ψ x y * (starRingEnd ℂ) (ψ k x)) =
      ∑ i, (∑ x, (μ x : ℂ) * (starRingEnd ℂ) (ψ k x) * ψ i x) * (starRingEnd ℂ) (ψ i y) := by
  unfold finiteMeasureFrameKernel
  simp_rw [Finset.mul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro x _
  ring

theorem finite_probability_frame_reproduction {X I : Type*} [Fintype X] [Fintype I]
    (μ : X → ℝ) (hmass : ∑ x, μ x = 1) (ψ : I → X → ℂ)
    (hunit : ∀ i x, μ x ≠ 0 → ‖ψ i x‖ = 1)
    {ε : ℝ} (hε : 0 ≤ ε)
    (hoff : ∀ i j, i ≠ j →
      ‖∑ x, (μ x : ℂ) * (starRingEnd ℂ) (ψ i x) * ψ j x‖ ≤ ε)
    (k : I) (y : X) (hy : ∀ i, ‖ψ i y‖ ≤ 1) :
    ‖(∑ x, (μ x : ℂ) * finiteMeasureFrameKernel ψ x y * (starRingEnd ℂ) (ψ k x)) -
      (starRingEnd ℂ) (ψ k y)‖ ≤ (Fintype.card I - 1 : ℕ) * ε := by
  rw [finite_measure_frame_reverse_pairing,
    ← Finset.sum_erase_add _ _ (Finset.mem_univ k),
    finite_probability_gram_diagonal μ hmass (ψ k) (hunit k), one_mul, add_sub_cancel_right]
  calc
    _ ≤ ∑ i ∈ Finset.univ.erase k,
        ‖(∑ x, (μ x : ℂ) * (starRingEnd ℂ) (ψ k x) * ψ i x) * (starRingEnd ℂ) (ψ i y)‖ := norm_sum_le _ _
    _ ≤ ∑ _i ∈ Finset.univ.erase k, ε := by
      apply Finset.sum_le_sum
      intro i hi
      rw [norm_mul, Complex.norm_conj]
      simpa only [mul_one] using mul_le_mul (hoff k i (Finset.ne_of_mem_erase hi).symm)
        (hy i) (norm_nonneg _) hε
    _ = _ := by simp
end

section
open scoped BigOperators Classical
theorem prime_family_log_cell_gram (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ C : ℝ, 0 < C ∧ ∀ Q : ℕ, 0 < Q →
      ∀ {I : Type*} [Fintype I] [DecidableEq I],
      ∀ (P : I → Finset ℕ) (V : I → ℝ) (i : I),
      (∀ j, 0 < V j) → (∀ j p, p ∈ P j → 0 < p) →
      (∀ j, ∑ p ∈ P j, 1 / (p : ℝ) = V j) →
      ∀ a b : ℝ, P i = primeBand a b → 2 ≤ a → 0 ≤ b →
      ∀ h : ℝ, 0 < h → ∀ d : ℤ,
      ∀ t s : BoundedPrimitiveCharacter Q, t ≠ s →
        ‖∑ x : (∀ j, P j),
          if upperLogCell h (Real.log (∏ j, (x j).val : ℕ)) = d then
            (finiteProductWeight (physicalLabelLaw V) x : ℂ) *
              boundedPrimitiveValue t ((∏ j, (x j).val : ℕ) : ZMod (boundedPrimitiveModulus t)) *
              star (boundedPrimitiveValue s ((∏ j, (x j).val : ℕ) : ZMod (boundedPrimitiveModulus s))) else 0‖ ≤
            (C / V i) * a ^ (-(1 : ℝ) / 32) * (1 + Real.log (Q * Q : ℕ) / Real.log a) := by
  obtain ⟨C, hC, hbnd⟩ := prime_tuple_log_cell_correlation_bound hZ
  refine ⟨C, hC, ?_⟩
  intro Q hQ I _ _ P V i hV hp hmass a b hPi ha hb h hh d t s hts
  have hVi := hV i
  have hlog : 0 < Real.log a := Real.log_pos (by linarith)
  have hraw := hbnd (boundedPrimitiveModulus t) (boundedPrimitiveModulus s)
    (bounded_primitive_modulus_pos t) (bounded_primitive_modulus_pos s)
    (boundedPrimitiveValue t) (boundedPrimitiveValue s)
    (bounded_primitive_value_primitive t) (bounded_primitive_value_primitive s)
    (fun he => hts (bounded_primitive_character_injective Q he))
    P V i hV hp hmass a b hPi ha hb h hh d
  have hprod : boundedPrimitiveModulus t * boundedPrimitiveModulus s ≤ Q * Q :=
    Nat.mul_le_mul (bounded_primitive_modulus_le t) (bounded_primitive_modulus_le s)
  have hpos : (0 : ℝ) < (boundedPrimitiveModulus t * boundedPrimitiveModulus s : ℕ) := by
    exact_mod_cast Nat.mul_pos (bounded_primitive_modulus_pos t) (bounded_primitive_modulus_pos s)
  have hl := Real.log_le_log hpos (show ((boundedPrimitiveModulus t * boundedPrimitiveModulus s : ℕ) : ℝ) ≤ (Q * Q : ℕ) by exact_mod_cast hprod)
  apply hraw.trans
  exact mul_le_mul_of_nonneg_left
    (add_le_add le_rfl (div_le_div_of_nonneg_right hl hlog.le)) (by positivity)
end

section
open scoped BigOperators Classical
section

variable
  {I : Type*}
  [sharedInstance1 : Fintype I]
  [sharedInstance2 : DecidableEq I]
  (P : I → Finset ℕ)
  (V : I → ℝ)

include I sharedInstance1 sharedInstance2 P V

theorem prime_ideal_kernel_conj  (Q : ℕ) (h : ℝ) (kept : Finset ℤ) (x y : ∀ j, P j) :
    (starRingEnd ℂ) (primeProductIdealKernel P V Q h kept x y) =
      primeProductIdealKernel P V Q h kept y x :=
  finite_cell_kernel_conj _ _ _ _ x y

theorem prime_ideal_kernel_log_localized  (Q : ℕ) {h : ℝ} (hh : 0 < h)
    (kept : Finset ℤ) (x y : ∀ j, P j) (hne : primeProductIdealKernel P V Q h kept x y ≠ 0) :
    |Real.log (∏ j, (x j).val : ℕ) - Real.log (∏ j, (y j).val : ℕ)| < h := by
  apply upper_log_cell_distance_lt hh
  unfold primeProductIdealKernel finiteCellFrameKernel at hne
  split_ifs at hne with he
  · exact he.1
  · exact (hne rfl).elim

theorem prime_ideal_kernel_norm_le  (Q : ℕ) (h : ℝ) (kept : Finset ℤ)
    {ξ : ℝ} (hξ : 0 < ξ)
    (hkept : ∀ d ∈ kept, ξ ≤ finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
      (fun x => upperLogCell h (Real.log (∏ j, (x j).val : ℕ))) d) (x y : ∀ j, P j) :
    ‖primeProductIdealKernel P V Q h kept x y‖ ≤ (Q * Q : ℕ) / ξ := by
  have hψ (t : BoundedPrimitiveCharacter Q) (z : ∀ j, P j) :
      ‖star (boundedPrimitiveValue t ((∏ j, (z j).val : ℕ) : ZMod (boundedPrimitiveModulus t)))‖ ≤ 1 := by
    rw [norm_star]
    exact (boundedPrimitiveValue t).norm_le_one _
  have hb := finite_cell_kernel_norm_le
    (finiteProductWeight (physicalLabelLaw (P := P) V))
    (fun z => upperLogCell h (Real.log (∏ j, (z j).val : ℕ))) kept _ hψ hξ hkept x y
  exact hb.trans (div_le_div_of_nonneg_right (by exact_mod_cast bounded_primitive_character_card_le Q) hξ.le)

theorem prime_ideal_kernel_abs_row_le  (hV : ∀ i, 0 ≤ V i) (Q : ℕ) (h : ℝ) (kept : Finset ℤ)
    (hkept : ∀ d ∈ kept, 0 < finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
      (fun x => upperLogCell h (Real.log (∏ j, (x j).val : ℕ))) d) (x : ∀ j, P j) :
    (∑ y, finiteProductWeight (physicalLabelLaw V) y * ‖primeProductIdealKernel P V Q h kept x y‖) ≤
      (Q * Q : ℕ) := by
  have hμ (z : ∀ j, P j) : 0 ≤ finiteProductWeight (physicalLabelLaw V) z :=
    Finset.prod_nonneg (fun j _ => physical_label_law_nonneg V hV j (z j))
  have hψ (t : BoundedPrimitiveCharacter Q) (z : ∀ j, P j) :
      ‖star (boundedPrimitiveValue t ((∏ j, (z j).val : ℕ) : ZMod (boundedPrimitiveModulus t)))‖ ≤ 1 := by
    rw [norm_star]
    exact (boundedPrimitiveValue t).norm_le_one _
  exact (finite_cell_kernel_abs_row_le _ hμ _ kept hkept _ hψ x).trans
    (by exact_mod_cast bounded_primitive_character_card_le Q)

theorem prime_ideal_kernel_abs_column_le  (hV : ∀ i, 0 ≤ V i) (Q : ℕ) (h : ℝ) (kept : Finset ℤ)
    (hkept : ∀ d ∈ kept, 0 < finiteCellMass (finiteProductWeight (physicalLabelLaw (P := P) V))
      (fun x => upperLogCell h (Real.log (∏ j, (x j).val : ℕ))) d) (y : ∀ j, P j) :
    (∑ x, finiteProductWeight (physicalLabelLaw V) x * ‖primeProductIdealKernel P V Q h kept x y‖) ≤
      (Q * Q : ℕ) := by
  have hn (x : ∀ j, P j) : ‖primeProductIdealKernel P V Q h kept x y‖ =
      ‖primeProductIdealKernel P V Q h kept y x‖ := by
    rw [← prime_ideal_kernel_conj P V Q h kept y x, Complex.norm_conj]
  simp_rw [hn]
  exact prime_ideal_kernel_abs_row_le P V hV Q h kept hkept y

end

