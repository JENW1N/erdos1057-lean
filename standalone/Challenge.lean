variable
  {G I : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (V : G → ℝ)
  (patterns : Finset I)
  (C : I → G → Finset (Fin J))

include G I sharedInstance1 sharedInstance2 P J ell V patterns C

theorem physical_residue_bare_path_term_zero_of_invalid
     (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (N : ℕ) (r : PhysicalResidues P) (L₀ : PhysicalMarkLists P J ell)
    (p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (hL : ¬ physicalResidueMarksValid r L₀) :
    physicalResidueBarePathTerm V patterns C q ζ k K (N + 1) r L₀ p = 0 := by
  simp only [physicalResidueBarePathTerm, deterministicBarePathTerm,
    physicalResidueStepCoeff, physicalResidueVertexWeight, if_neg hL,
    zero_mul, Complex.ofReal_zero, mul_zero]

/- A deterministic residue path starting at an integer residue vector is
exactly the corresponding unrestricted physical path. -/
theorem physical_residue_path_term_int  (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (t : ℕ) (n : ℤ) (L : PhysicalMarkLists P J ell)
    (p : Fin t → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    deterministicBarePathTerm
      (fun j a r L => physicalTranslateResidues r (physicalBareStep C (k j) a L))
      (fun j => physicalResidueStepCoeff V patterns C q (ζ j) (k j) (K j))
      (fun _ _ => (1 : ℂ)) t (physicalResiduesOfInt P n) L p =
    translatedPathTerm (fun j => physicalBareStep C (k j))
      (fun j => physicalBareKernel V patterns C q (ζ j) (k j) (K j))
      (fun _ _ => (1 : ℂ)) t n L p := by
  induction t generalizing n L with
  | zero => rfl
  | succ t ih =>
    simp only [deterministicBarePathTerm, translatedPathTerm,
      physical_translate_residues_int, physical_residue_step_coeff_int, ih]
    rfl

/- Positive-length residue paths at integer sources factor into the
unrestricted walk scalar and the scheduled residue vertex product. -/
theorem physical_residue_path_term_factor_int  {q : ℝ} (hq : 0 ≤ q)
    (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (N : ℕ) (n : ℤ) :
    deterministicBarePathTerm
      (fun j a r L => physicalTranslateResidues r (physicalBareStep C (k j) a L))
      (fun j => physicalResidueStepCoeff V patterns C q (ζ j) (k j) (K j))
      (fun _ _ => (1 : ℂ)) (N + 1) (physicalResiduesOfInt P n) (L 0)
      (fun j : Fin (N + 1) => (a j.val, L (j.val + 1))) =
        physicalBareWalkScalar V patterns C ζ K a L (N + 1) *
          ((∏ j ∈ range (N + 2), physicalResidueVertexWeight (L j)
            (physicalEndpointSchedule q (N + 1) j)
            (physicalTranslateResidues (physicalResiduesOfInt P n)
              (physicalBareOffset C k a L (N + 1) j)) : ℝ) : ℂ) := by
  rw [physical_residue_path_term_int]
  simpa only [physical_translate_residues_int, physical_residue_vertex_weight_int, mul_one] using
    physical_free_path_term_factor V patterns C hq ζ k K (fun _ _ => (1 : ℂ)) a L N n

end


