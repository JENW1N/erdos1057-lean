    FullActiveEdgeSampleIndex n (S k) B A Δ D s sk ↪
      FullMixedLocalBirthAddress S B (some (.inr k) : Option (J ⊕ K)) where
  toFun i := ⟨i.1, i.2.val⟩
  inj' := by
    rintro ⟨g, a⟩ ⟨h, b⟩ he
    change (⟨g, a.val⟩ : (g : Fin N) × Fin (S k g)ᶜ.card) = ⟨h, b.val⟩ at he
    simp only [Sigma.mk.inj_iff] at he
    rcases he with ⟨rfl, he⟩
    have hab : a = b := Subtype.ext (eq_of_heq he)
    subst b
    rfl

