theorem exists_low_cutoff_rough_logarithmic_cell_upper {a : ℝ} (ha : 0 < a) :
    ∃ C : ℝ, 0 < C ∧ ∀ S : ℝ, ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ,
      Real.exp (a*L) ≤ Y →
      ((roughBand Y (Real.exp (L^(-S))*Y) (Real.exp ((a/40)*L))).card : ℝ) ≤
        C*(Real.exp (L^(-S))*Y-Y)/L := by
  obtain ⟨K, hK, hcount⟩ := exists_real_rough_integer_interval_count
  refine ⟨40*(K+1)/a+1, by positivity, ?_⟩
  intro S
  have hb : 0 < 3*a/4 := by positivity
  filter_upwards [eventually_linear_exponential_profile_le_rpow hb hb K 0 (S+1),
    eventually_gt_atTop (0 : ℝ)] with L hprofile hL
  intro Y hY
  let len := Real.exp (L^(-S))*Y-Y
  let z := Real.exp ((a/40)*L)
