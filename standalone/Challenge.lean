/- Four dyadic input factors need only five dyads after collapsing their coefficients. -/

open Finset

namespace Bounty

theorem four_dyadic_factor_product_bounds {UD UA UB UC : ℝ} {d a b c : ℕ}
    (hUD : 0 < UD) (hUA : 0 < UA) (hUB : 0 < UB) (hUC : 0 < UC)
    (hd : UD ≤ (d : ℝ) ∧ (d : ℝ) ≤ 2*UD) (ha : UA ≤ (a : ℝ) ∧ (a : ℝ) ≤ 2*UA)
    (hb : UB ≤ (b : ℝ) ∧ (b : ℝ) ≤ 2*UB) (hc : UC ≤ (c : ℝ) ∧ (c : ℝ) ≤ 2*UC) :
    UD*UA*UB*UC ≤ (d*a*b*c : ℕ) ∧ (d*a*b*c : ℕ) ≤ 16*(UD*UA*UB*UC) := by
  rcases hd with ⟨hdlo,hdhi⟩
  rcases ha with ⟨halo,hahi⟩
  rcases hb with ⟨hblo,hbhi⟩
  rcases hc with ⟨hclo,hchi⟩
  push_cast
  constructor
  · gcongr
  · calc
      _ ≤ (2*UD)*(2*UA)*(2*UB)*(2*UC) := by gcongr
      _ = _ := by ring




