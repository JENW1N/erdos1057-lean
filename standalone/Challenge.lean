open Finset
def deterministicBarePathTerm {R M A S : Type*} [Mul S]
    (step : ℕ → A → R → M → R) (weight : ℕ → A → R → M → M → S)
    (terminal : R → M → S) : (n : ℕ) → R → M → (Fin n → A × M) → S
  | 0, r, m, _ => terminal r m
  | n + 1, r, m, p => weight n (p 0).1 r m (p 0).2 *
      deterministicBarePathTerm step weight terminal n
        (step n (p 0).1 r m) (p 0).2 (Fin.tail p)







theorem deterministic_target_absolute_path_sum {R M A : Type*}
    [Fintype R] [Fintype M] [Fintype A]
    (step : ℕ → A → R → M → R) (weight : ℕ → A → R → M → M → ℂ)
    (terminal : R → M → ℂ) (n : ℕ) (r : R) (m : M) :
    (∑ p : Fin n → A × (R × M),
      ‖labeledPathTerm (fun j => deterministicTargetKernel (step j) (weight j))
        (fun x => terminal x.1 x.2) n (r, m) p‖) =
      ∑ p : Fin n → A × M, ‖deterministicBarePathTerm step weight terminal n r m p‖ := by
  classical
  induction n generalizing r m with
  | zero => simp [labeledPathTerm, deterministicBarePathTerm]
  | succ n ih =>
    calc
      _ = ∑ z : A × (R × M), ∑ p : Fin n → A × (R × M),
          ‖deterministicTargetKernel (step n) (weight n) z.1 (r, m) z.2‖ *
            ‖labeledPathTerm (fun j => deterministicTargetKernel (step j) (weight j))
              (fun x => terminal x.1 x.2) n z.2 p‖ := by
        rw [← Equiv.sum_comp (Fin.consEquiv (fun _ : Fin (n + 1) => A × (R × M)))
          (fun p => ‖labeledPathTerm
            (fun j => deterministicTargetKernel (step j) (weight j))
            (fun x => terminal x.1 x.2) (n + 1) (r, m) p‖), Fintype.sum_prod_type]
        apply sum_congr rfl
        intro z _
        apply sum_congr rfl
        intro p _
        exact norm_mul _ _
      _ = ∑ z : A × (R × M),
          ‖deterministicTargetKernel (step n) (weight n) z.1 (r, m) z.2‖ *
            ∑ p : Fin n → A × M,
              ‖deterministicBarePathTerm step weight terminal n z.2.1 z.2.2 p‖ := by
        apply sum_congr rfl
        intro z _
        rw [← mul_sum]
        exact congrArg (fun s => ‖deterministicTargetKernel (step n) (weight n) z.1 (r, m) z.2‖ * s)
          (ih z.2.1 z.2.2)
      _ = ∑ z : A × M, ∑ p : Fin n → A × M,
          ‖weight n z.1 r m z.2‖ *
            ‖deterministicBarePathTerm step weight terminal n (step n z.1 r m) z.2 p‖ := by
        simp [Fintype.sum_prod_type, deterministicTargetKernel, apply_ite, ite_mul, mul_sum]
      _ = _ := by
        symm
        rw [← Equiv.sum_comp (Fin.consEquiv (fun _ : Fin (n + 1) => A × M))
          (fun p => ‖deterministicBarePathTerm step weight terminal (n + 1) r m p‖),
          Fintype.sum_prod_type]
        apply sum_congr rfl
        intro z _
        apply sum_congr rfl
        intro p _
        exact norm_mul _ _
end

