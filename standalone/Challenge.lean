section
open Finset
open scoped Classical
/- Restricting the actual edge action to one distinct target and fresh labels
outside old memory leaves one promotion/fresh event for each storage subset.
The actual memory cutoff and arbitrary complex event phase are retained. -/
theorem unrestricted_edge_action_fixed_target {P Z : Type*}
    [Fintype P] [DecidableEq P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V : ℝ) (eligible : Finset (Fin N)) (B : ℕ)
    (f : Fin N ↪ P) (hlabel : ∀ j, label (old j) = f j) (target : Fin t ↪ P)
    (e : distinctPromotedTargetSlots f target ↪ eligible)
    (hmatch : ∀ s : distinctPromotedTargetSlots f target, f (e s).val = target s.val)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) :
    unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B
      (fun stores promotions g fresh =>
        if FixedTargetEdgeEventValid f target ⟨promotions, g, fresh⟩
          then phase stores promotions g fresh else 0) F =
      ∑ stores : Finset (Fin t),
        (unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores
          (distinctPromotedTargetSlots f target) e (distinctCanonicalFresh f target) : ℂ) *
        phase stores (distinctPromotedTargetSlots f target) e (distinctCanonicalFresh f target) *
        (if (unrestrictedEdgeOutput source old seed transport stores
            (distinctPromotedTargetSlots f target) e).1 ≤ B then
          F target (unrestrictedEdgeOutput source old seed transport stores
            (distinctPromotedTargetSlots f target) e) else 0) := by
  classical
  unfold unrestrictedEdgeAction
  apply sum_congr rfl
  intro stores _
  have h := sum_fixed_target_edge_subsets_injections_fresh f target eligible e hmatch
    (fun event : FixedTargetEdgeEvent (Fin t) (Fin N) P eligible =>
      (unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores
        event.1 event.2.1 event.2.2 : ℂ) *
      phase stores event.1 event.2.1 event.2.2 *
      (if (unrestrictedEdgeOutput source old seed transport stores event.1 event.2.1).1 ≤ B then
        F (unrestrictedEdgeTarget old label event.1 event.2.1 event.2.2)
          (unrestrictedEdgeOutput source old seed transport stores event.1 event.2.1) else 0))
  dsimp only [fixedTargetCanonicalEvent] at h
  rw [distinct_unrestricted_edge_target old label f hlabel target eligible e hmatch] at h
  refine Eq.trans ?_ h
  apply sum_congr rfl
  intro U _
  apply sum_congr rfl
  intro g _
  apply sum_congr rfl
  intro fresh _
  by_cases hv : FixedTargetEdgeEventValid f target ⟨U, g, fresh⟩ <;>
    simp only [hv, if_true, if_false, mul_zero, zero_mul]
end

