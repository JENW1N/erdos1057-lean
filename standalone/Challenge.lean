    ∫w in cuspPeriodStrip a b,cubicResidualFunction (M•w)*arbitraryCuspWeightedPhase ρ freq w∂hyperbolicVolume :=
  letI rootPolicy_hyperbolicMeasurableSpace := @OAI.CubicEisenstein.hyperbolicMeasurableSpace
