  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ) (steps : List (Option (J ⊕ K)))

theorem full_mixed_common_ledger_forest_expansion {Ω : Type*}
    (hedge : ∀ k H x e, edgePhase k H x e =
      (if FullMixedLocalBirthAvoids (J := J) n S B A Δ D H (some (.inr k)) x e ∧
          FullMixedLocalBirthDistinct (J := J) n S B A Δ D (some (.inr k)) x e then 1 else 0) *
        edgePhase k (fun _ => ∅) x e)
    (paths : Finset Ω)
    (x : Ω → ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : ∀ a, FullPermutationMixedPath n S B A Δ D steps (x a))
    (hx : ∀ a ∈ paths, FullActiveInjective (x a))
    (hcover : ∀ a ∈ paths, FullMixedLedgerCovers n B (fullActiveInitialLedger (x a), x a))
    (F : Ω → ℂ) (encode : ((g : Fin N) × P g) → ℤ) (hencode : Function.Injective encode) :
    (∑ a ∈ paths, F a *
      (finiteEventPathWeight (FullPermutationMixedEvent n S B A Δ D)
        (fullPermutationMixedEventTarget n S B A Δ D)
        (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps (x a) (p a) : ℂ) *
      fullMixedLedgerInducedPhase n S B A Δ D steps fullActiveInitialLedger
        (finiteEventLocalPhase
          (fun tag (s : FullMixedLedgerState n (M := M) B) =>
            FullPermutationMixedEvent n S B A Δ D tag s.2)
          (fullMixedLedgerTarget n S B A Δ D) (fullMixedLedgerPhase n S B A Δ D edgePhase) steps) (x a) (p a)) =
    ∑ code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)),
      (-1 : ℂ) ^ birthForestRank code * birthForestPathSum paths
        (fun a => F a * fullMixedCommonResidualWeight n S B A Δ D edgePhase ω μ q ρ V steps (x a) (p a))
        (fun a => fullMixedCommonIndexedPerformed n S B A Δ D steps (x a) (p a))
        (fun a => fullMixedCommonIndexedValue n S B A Δ D steps encode (x a) (p a)) code := by
  rw [← full_mixed_common_path_forest_expansion n S B A Δ D steps paths x p hx encode hencode
    (fun a => F a * fullMixedCommonResidualWeight n S B A Δ D edgePhase ω μ q ρ V steps (x a) (p a))]
  apply sum_congr rfl
  intro a ha
  rw [mul_assoc, full_mixed_physical_weighted_phase_factor n S B A Δ D edgePhase hedge
    ω μ q ρ V steps fullActiveInitialLedger (x a) (p a) (hcover a ha)]
  unfold fullMixedCommonResidualWeight
  ring

end Full
