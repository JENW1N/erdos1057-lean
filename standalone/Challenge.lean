open MeasureTheory

namespace Bounty

theorem exists_local_log_mellin_energy_constant {j : ℕ} (hj : 2 ≤ j) :
    ∃ C : ℝ, 0 < C ∧ ∀ (S : Finset ℕ) (a : ℕ → ℂ), (∀ n ∈ S, 0 < n) →
      ∀ h Y : ℝ, 0 < h → 0 < Y →
      (∫ v in Set.Icc (Y/2) (3*Y), ‖localLogConvolution S a (h*Y) v‖^2) ≤
        3*Y*h^2*C * ∫ t : ℝ, (1+|h*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2 := by
  obtain ⟨C, hC, hop⟩ := exists_local_mellin_transform_energy_constant hj
  refine ⟨C, hC, ?_⟩
  intro S a hS h Y hh hY
  let g := centeredLocalMellinPolynomial S a Y
  have hg : Continuous g := centered_local_mellin_polynomial_continuous S a Y
  have hgM : ∃ M : ℝ, ∀ t, ‖g t‖ ≤ M := by
    refine ⟨∑ n ∈ S, ‖a n‖, ?_⟩
    intro t
    rw [centered_local_mellin_polynomial_norm]
    exact local_mellin_polynomial_norm_le S a t
  obtain ⟨hloc, hbound⟩ := hop h hh g hg hgM
  have heI : (fun u : ℝ => ‖localMellinTransform h g u‖^2) =ᵐ[
      volume.restrict (Set.Icc (Real.log (1/2:ℝ)) (Real.log 3))]
      (fun u : ℝ => ‖(typeIISmoothRho 2 u : ℂ)*localMellinTransform h g u‖^2) := by
    filter_upwards [ae_restrict_mem measurableSet_Icc] with u hu
    rw [local_mellin_rho_one_on_log_dyad hu, Complex.ofReal_one, one_mul]
  have hTi : IntegrableOn (fun u : ℝ => ‖localMellinTransform h g u‖^2)
      (Set.Icc (Real.log (1/2:ℝ)) (Real.log 3)) := hloc.integrableOn.congr heI.symm
  rw [logarithmic_dyad_integral_substitution hY]
  have hscale : (h/(2*Real.pi))^2 ≤ h^2 := by
    apply pow_le_pow_left₀ (by positivity)
    apply div_le_self hh.le
    linarith [Real.two_le_pi]
  calc
    _ ≤ ∫ u in Set.Icc (Real.log (1/2:ℝ)) (Real.log 3),
        (3*Y*h^2) * ‖localMellinTransform h g u‖^2 := by
      apply integral_mono_of_nonneg
      · filter_upwards [] with u
        exact mul_nonneg (mul_nonneg hY.le (Real.exp_pos u).le) (sq_nonneg _)
      · exact hTi.const_mul _
      · filter_upwards [ae_restrict_mem measurableSet_Icc] with u hu
        rw [local_log_convolution_mellin_coordinates S a hS hh hY u,
          norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity), mul_pow]
        have hu3 : Real.exp u ≤ 3 := by
          simpa only [Real.exp_log (by norm_num : (0:ℝ)<3)] using Real.exp_le_exp.mpr hu.2
        have hc : Y*Real.exp u*(h/(2*Real.pi))^2 ≤ 3*Y*h^2 := by
          calc
            _ ≤ Y*3*h^2 := mul_le_mul
              (mul_le_mul_of_nonneg_left hu3 hY.le) hscale (sq_nonneg _)
              (mul_nonneg hY.le (by norm_num))
            _ = _ := by ring
        simpa only [mul_assoc] using mul_le_mul_of_nonneg_right hc
          (sq_nonneg ‖localMellinTransform h g u‖)
    _ = (3*Y*h^2) * ∫ u in Set.Icc (Real.log (1/2:ℝ)) (Real.log 3),
        ‖localMellinTransform h g u‖^2 := integral_const_mul _ _
    _ ≤ (3*Y*h^2) * (C * ∫ t : ℝ, (1+|h*t|)^(-(j:ℝ))*‖g t‖^2) :=
      mul_le_mul_of_nonneg_left hbound (by positivity)
    _ = _ := by
      simp only [g, centered_local_mellin_polynomial_norm]
      ring

end Bounty
end

section

/- The original event updates only its common birth slots; initial prime labels are seeded once at the boundary. -/

open Classical
namespace Bounty
section History
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))

noncomputable def fullMixedCommonAddressWrite (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)
    (history : FullMixedCommonBirthAddress M B steps → Option (Sigma P)) :
    FullMixedCommonBirthAddress M B steps → Option (Sigma P)
  | .inl a => history (.inl a)
  | .inr a => if h : a.1 = u then
      fullMixedCommonEventBirthLabel n S B A Δ D (steps.get u) s e
        (cast (congrArg (fun v : Fin steps.length => FullMixedCommonLocalAddress M B (steps.get v)) h) a.2)
    else history (.inr a)

noncomputable def fullMixedCommonHistoryWrite (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) : Option (Sigma P) :=
  fullMixedCommonAddressWrite n S B A Δ D steps u s e
    (fun a => history ((fullMixedCommonBirthOrder M B steps).symm a)) (fullMixedCommonBirthOrder M B steps i)

noncomputable def fullMixedCommonHistorySeed
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) : Option (Sigma P) :=
  match fullMixedCommonBirthOrder M B steps i with
  | .inl a => some (fullMixedCommonInitialPrime s a)
  | .inr _ => history i

theorem full_mixed_common_history_write_here (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (a : FullMixedCommonLocalAddress M B (steps.get u)) :
    fullMixedCommonHistoryWrite n S B A Δ D steps u s e history
      ((fullMixedCommonBirthOrder M B steps).symm (.inr ⟨u, a⟩)) =
      fullMixedCommonEventBirthLabel n S B A Δ D (steps.get u) s e a := by
  unfold fullMixedCommonHistoryWrite
  rw [Equiv.apply_symm_apply]
  simp [fullMixedCommonAddressWrite]

theorem full_mixed_common_history_write_other (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)))
    (hi : fullMixedCommonOwner M B steps (fullMixedCommonBirthOrder M B steps i) ≠ some u) :
    fullMixedCommonHistoryWrite n S B A Δ D steps u s e history i = history i := by
  obtain ⟨a, rfl⟩ := (fullMixedCommonBirthOrder M B steps).symm.surjective i
  cases a with
  | inl a => simp [fullMixedCommonHistoryWrite, fullMixedCommonAddressWrite]
  | inr a =>
    have hv : a.1 ≠ u := by
      simpa only [Equiv.apply_symm_apply, fullMixedCommonOwner, ne_eq, Option.some.injEq] using hi
    simp [fullMixedCommonHistoryWrite, fullMixedCommonAddressWrite, hv]

end History
end Bounty
