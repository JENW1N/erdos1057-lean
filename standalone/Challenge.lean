    PhysicalGroupSelectedData P ell C ≃
      PhysicalSelectedData (fun h => P (e.symm h)) ell (fun j h => C j (e.symm h)) :=
  Equiv.prodCongr (Equiv.piCongrRight (fun j => physicalAuxGroupReindex e P J (C j)))
    (Equiv.prodCongr (Equiv.piCongrRight (fun _ => physicalMarkGroupReindex e P J ell))
      (Equiv.prodCongr (Equiv.piCongrRight (fun _ => physicalPermutationGroupReindex e J ell))
        (Equiv.piCongrRight (fun _ => physicalPermutationGroupReindex e J ell))))

def physicalPrimeReindex {G H : Type*} (e : G ≃ H) (P : G → Finset ℕ) :
    PhysicalPrime (fun h => P (e.symm h)) ≃ PhysicalPrime P :=
