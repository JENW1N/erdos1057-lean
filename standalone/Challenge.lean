/- Selected arrays and initial marks are the exact coordinates of small plans. -/

namespace Bounty

variable {S I V K : Type} {Ps : S → Finset ℕ} {J ell n : ℕ}

abbrev PhysicalSmallSelectedArrays (Ps : S → Finset ℕ) (J ell n : ℕ) (I : Type) :=
  (Fin n → I) × (Fin (n + 1) → PhysicalMarkLists Ps J ell) ×
    (Fin n → PhysicalPermutations S J ell) × (Fin n → PhysicalPermutations S J ell)

def physicalSmallSelectedBlockEquiv :
    PhysicalSmallSelectedArrays Ps J ell n I ≃
      PhysicalMarkLists Ps J ell × (Fin n → PhysicalSmallBlockData Ps J ell I) where
  toFun d := (d.2.1 0, fun j => (d.1 j, d.2.1 j.succ, d.2.2.1 j, d.2.2.2 j))
  invFun p := ((fun j => (p.2 j).1), Fin.cons p.1 (fun j => (p.2 j).2.1),
    (fun j => (p.2 j).2.2.1), (fun j => (p.2 j).2.2.2))
  left_inv := by
    rintro ⟨i, L, σ, τ⟩
    have hL : Fin.cons (L 0) (fun j => L j.succ) = L := by
      funext j
      exact Fin.cases rfl (fun _ => rfl) j
    exact congrArg (fun L' => (i, L', σ, τ)) hL
  right_inv := by
    rintro ⟨L, d⟩
    apply Prod.ext rfl
    funext j
    rfl

noncomputable def physicalSmallSelectedBlockPlanEquiv (last : V) (bs : List (V × K)) :
    PhysicalSmallSelectedArrays Ps J ell bs.length I ≃
      PhysicalMarkLists Ps J ell ×
        PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I)
          (physicalBlockFineSteps bs last) :=
  physicalSmallSelectedBlockEquiv.trans
    (Equiv.prodCongr (Equiv.refl _) (physicalSmallBlockPlanEquiv last bs))

abbrev PhysicalSmallSelectedChoices (Ps : S → Finset ℕ) (ell n : ℕ)
    (C : I → S → Finset (Fin J)) :=
  Σ i : Fin n → I, PhysicalGroupSelectedData Ps ell (fun j => C (i j))

def physicalEmptyAuxLabels (C : S → Finset (Fin J)) (hC : ∀ g, C g = ∅) :
    PhysicalAuxLabels Ps C :=
  fun g s => False.elim (by simpa only [hC g, Finset.notMem_empty] using s.property)

def physicalSmallSelectedArraysEquiv (C : I → S → Finset (Fin J))
    (hC : ∀ i g, C i g = ∅) :
    PhysicalSmallSelectedChoices Ps ell n C ≃ PhysicalSmallSelectedArrays Ps J ell n I where
  toFun d := (d.1, d.2.2.1, d.2.2.2.1, d.2.2.2.2)
  invFun d := ⟨d.1, (fun j => physicalEmptyAuxLabels (C (d.1 j)) (hC (d.1 j))),
    d.2.1, d.2.2.1, d.2.2.2⟩
  left_inv := by
    rintro ⟨i, a, L, σ, τ⟩
    have ha : (fun j => physicalEmptyAuxLabels (Ps := Ps) (C (i j)) (hC (i j))) = a := by
      funext j g s
      exact False.elim (by simpa only [hC (i j) g, Finset.notMem_empty] using s.property)
    exact congrArg (fun a' => (⟨i, a', L, σ, τ⟩ : PhysicalSmallSelectedChoices Ps ell n C)) ha
  right_inv := by rintro ⟨i, L, σ, τ⟩; rfl

end Bounty
end

