/- The exact raw shared-draw formula also retains shared-dependent phases,
position guards, and auxiliary-label exclusions. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_normalized_cut_sum_eq_raw_draws {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J)) (V : G → ℝ)
    (F : GroupMarkedLists P (fun g => ell + (C g).card) →
      GroupMarkedLists P (fun g => ell + (C g).card) →
      PhysicalAuxLabels P (fun g => univ \ C g) → ℂ) :
    (∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
      if physicalSharedCompatible C L R then
        ((physicalStateMass V J ell * physicalCompletionMass V C ell /
          (physicalSharedFactor C L : ℝ) : ℝ) : ℂ) *
          F (physicalGroupUnsharedEmbedding C L) (physicalGroupUnsharedEmbedding C R)
            (physicalSharedAux C L) else 0) =
      ∑ u : GroupMarkedLists P (fun g => ell + (C g).card),
      ∑ v : GroupMarkedLists P (fun g => ell + (C g).card),
      ∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
        if physicalRawCutGood C u v s then
          ((physicalAuxMass V (fun g => univ \ C g) s *
            physicalCompletionMass V C ell ^ 2 : ℝ) : ℂ) * F u v s else 0 := by
  have haux (d : PhysicalJointCutData P C ell) :
      physicalSharedAux C (physicalCutGlue C d.1 d.2.1) = fun g j => d.1 g j := by
    simpa only [physical_cut_pair_inverse_left] using physical_cut_pair_inverse_shared_aux C d
  rw [physical_joint_normalized_sum_eq_shared_draw_sum]
  simp only [physical_cut_glue_unshared, haux]
  exact physical_joint_cut_sum_eq_raw_sum P C
    (fun u v s => ((physicalAuxMass V (fun g => univ \ C g) s *
      physicalCompletionMass V C ell ^ 2 : ℝ) : ℂ) * F u v s)

end Bounty
end

section

/- The shared-exclusion loss after both conditional marked-list averages. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_cut_shared_pair_average_error {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime) (V : G → ℝ)
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (aux : PhysicalAuxLabels P C) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (b : GroupMarkedLists P (fun g => ell + (C g).card) →
      GroupMarkedLists P (fun g => ell + (C g).card) → ℂ)
    {H : ℝ} (hH : 0 ≤ H)
    (hb : ∀ (u : GroupMarkedListsAt P (fun g => ell + (C g).card) (w : ℤ))
      (v : GroupMarkedListsAt P (fun g => ell + (C g).card) (z : ℤ)), ‖b u.val v.val‖ ≤ H) :
    ‖groupMarkedAverage P (fun g => ell + (C g).card) (w : ℤ) (fun u =>
        groupMarkedAverage P (fun g => ell + (C g).card) (z : ℤ) (fun v =>
          ∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
            if physicalRawCutGood C u v s then
              if ∀ g j, s g j ∉ physicalSharedForbidden C aux g w z
                then (physicalAuxMass V (fun g => univ \ C g) s : ℂ) * b u v else 0
            else 0)) -
      groupMarkedAverage P (fun g => ell + (C g).card) (w : ℤ)
        (fun u => groupMarkedAverage P (fun g => ell + (C g).card) (z : ℤ) (b u))‖ ≤
      (∑ g, (J - (C g).card : ℕ) *
        (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)) * H := by
  have hwL : 0 ≤ Real.log (w : ℝ) := Real.log_nonneg (by exact_mod_cast (show 1 ≤ w from hw))
  have hzL : 0 ≤ Real.log (z : ℝ) := Real.log_nonneg (by exact_mod_cast (show 1 ≤ z from hz))
  have hδ : 0 ≤ ∑ g, (J - (C g).card : ℕ) *
      (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin) := by
    apply sum_nonneg
    intro g _
    have hv0 := (hV g).le
    positivity
  simp only [← group_marked_average_sub]
  apply group_marked_pair_average_norm_le P (fun g => ell + (C g).card) (w : ℤ) (z : ℤ)
    _ (mul_nonneg hδ hH)
  intro u v
  have hu : ∀ g i, (u.val g i).val ∣ w := by
    intro g i
    exact_mod_cast u.property g i
  have hv : ∀ g i, (v.val g i).val ∣ z := by
    intro g i
    exact_mod_cast v.property g i
  exact (physical_cut_shared_constant_error C hprime V hV hMass u.val v.val aux
    hw hz hu hv hPmin hp (b u.val v.val)).trans
      (mul_le_mul_of_nonneg_left (hb u v) hδ)

end Bounty
end

