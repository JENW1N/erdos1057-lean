/- A weighted Cauchy--Schwarz estimate for one complex matrix row. -/
theorem complex_row_weighted_cauchy {ι : Type*} (s : Finset ι)
    (K f : ι → ℂ) (v : ι → ℝ) (hv : ∀ j ∈ s, 0 < v j) :
    ‖∑ j ∈ s, K j * f j‖ ^ 2 ≤
      (∑ j ∈ s, ‖K j‖ * v j) * ∑ j ∈ s, ‖K j‖ * ‖f j‖ ^ 2 / v j := by
  have hnorm : ‖∑ j ∈ s, K j * f j‖ ≤ ∑ j ∈ s, ‖K j‖ * ‖f j‖ := by
    simpa only [norm_mul] using norm_sum_le s (fun j => K j * f j)
  have hsq : ‖∑ j ∈ s, K j * f j‖ ^ 2 ≤ (∑ j ∈ s, ‖K j‖ * ‖f j‖) ^ 2 :=
    (sq_le_sq₀ (norm_nonneg _) (Finset.sum_nonneg fun j _ => by positivity)).mpr hnorm
  refine hsq.trans (Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul s ?_ ?_ ?_)
  · intro j hj
    exact mul_nonneg (norm_nonneg _) (hv j hj).le
  · intro j hj
    exact div_nonneg (by positivity) (hv j hj).le
  · intro j hj
    have hvj : v j ≠ 0 := (hv j hj).ne'
    apply le_of_eq
    field_simp

/- Weighted Schur for a transition matrix. No symmetry is assumed. The column
bound uses the underlying measure, and the matrix action itself is unweighted. -/
theorem finite_weighted_schur_transition {ι : Type*} (s : Finset ι)
    (μ v : ι → ℝ) (K : ι → ι → ℂ)
    (hμ : ∀ i ∈ s, 0 ≤ μ i) (hv : ∀ i ∈ s, 0 < v i)
    {A B : ℝ}
    (hrow : ∀ i ∈ s, (∑ j ∈ s, ‖K i j‖ * v j) ≤ A * v i)
    (hcol : ∀ j ∈ s, (∑ i ∈ s, μ i * ‖K i j‖ * v i) ≤ B * μ j * v j)
    (f : ι → ℂ) :
    (∑ i ∈ s, μ i * ‖∑ j ∈ s, K i j * f j‖ ^ 2) ≤
      A * B * ∑ j ∈ s, μ j * ‖f j‖ ^ 2 := by
  classical
  rcases s.eq_empty_or_nonempty with rfl | ⟨i₀, hi₀⟩
  · simp
  have hA : 0 ≤ A := by
    have hsum : 0 ≤ ∑ j ∈ s, ‖K i₀ j‖ * v j :=
      Finset.sum_nonneg fun j hj => mul_nonneg (norm_nonneg _) (hv j hj).le
    have hAv : 0 ≤ A * v i₀ := hsum.trans (hrow i₀ hi₀)
    exact nonneg_of_mul_nonneg_left hAv (hv i₀ hi₀)
  have hpoint : ∀ i ∈ s, ‖∑ j ∈ s, K i j * f j‖ ^ 2 ≤
      A * v i * ∑ j ∈ s, ‖K i j‖ * ‖f j‖ ^ 2 / v j := by
    intro i hi
    exact (complex_row_weighted_cauchy s (K i) f v hv).trans
      (mul_le_mul_of_nonneg_right (hrow i hi)
        (Finset.sum_nonneg fun j hj => div_nonneg (by positivity) (hv j hj).le))
  calc
    (∑ i ∈ s, μ i * ‖∑ j ∈ s, K i j * f j‖ ^ 2) ≤
        ∑ i ∈ s, μ i * (A * v i * ∑ j ∈ s, ‖K i j‖ * ‖f j‖ ^ 2 / v j) :=
      Finset.sum_le_sum fun i hi => mul_le_mul_of_nonneg_left (hpoint i hi) (hμ i hi)
    _ = A * ∑ j ∈ s, (‖f j‖ ^ 2 / v j) * ∑ i ∈ s, μ i * ‖K i j‖ * v i := by
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro j hj
      apply Finset.sum_congr rfl
      intro i hi
      ring
    _ ≤ A * ∑ j ∈ s, (‖f j‖ ^ 2 / v j) * (B * μ j * v j) := by
      apply mul_le_mul_of_nonneg_left _ hA
      apply Finset.sum_le_sum
      intro j hj
      exact mul_le_mul_of_nonneg_left (hcol j hj) (div_nonneg (sq_nonneg _) (hv j hj).le)
    _ = A * B * ∑ j ∈ s, μ j * ‖f j‖ ^ 2 := by
      simp_rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j hj
      have hvj : v j ≠ 0 := (hv j hj).ne'
      field_simp

/- A weighted transpose identity turns row bounds for two kernels into the
column bound needed by Schur. The kernels need not be symmetric or equal. -/
theorem finite_weighted_schur_of_transpose {ι : Type*} (s : Finset ι)
    (μ v : ι → ℝ) (K K' : ι → ι → ℂ)
    (hμ : ∀ i ∈ s, 0 ≤ μ i) (hv : ∀ i ∈ s, 0 < v i)
    (htranspose : ∀ i ∈ s, ∀ j ∈ s,
      (μ i : ℂ) * K i j = (μ j : ℂ) * K' j i)
    {A B : ℝ}
    (hrow : ∀ i ∈ s, (∑ j ∈ s, ‖K i j‖ * v j) ≤ A * v i)
    (hrow' : ∀ j ∈ s, (∑ i ∈ s, ‖K' j i‖ * v i) ≤ B * v j)
    (f : ι → ℂ) :
    (∑ i ∈ s, μ i * ‖∑ j ∈ s, K i j * f j‖ ^ 2) ≤
      A * B * ∑ j ∈ s, μ j * ‖f j‖ ^ 2 := by
  apply finite_weighted_schur_transition s μ v K hμ hv hrow
  intro j hj
  calc
    (∑ i ∈ s, μ i * ‖K i j‖ * v i) =
        μ j * ∑ i ∈ s, ‖K' j i‖ * v i := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i hi
      have hn : μ i * ‖K i j‖ = μ j * ‖K' j i‖ := by
        have he := congrArg norm (htranspose i hi j hj)
        simpa [abs_of_nonneg (hμ i hi), abs_of_nonneg (hμ j hj)] using he
      rw [hn, mul_assoc]
    _ ≤ μ j * (B * v j) := mul_le_mul_of_nonneg_left (hrow' j hj) (hμ j hj)
    _ = B * μ j * v j := by ring




/- The square-root formulation of the transition-matrix estimate. -/
theorem finite_weighted_schur_transition_norm {ι : Type*} (s : Finset ι)
    (μ v : ι → ℝ) (K : ι → ι → ℂ)
    (hμ : ∀ i ∈ s, 0 ≤ μ i) (hv : ∀ i ∈ s, 0 < v i)
    {A B : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hrow : ∀ i ∈ s, (∑ j ∈ s, ‖K i j‖ * v j) ≤ A * v i)
    (hcol : ∀ j ∈ s, (∑ i ∈ s, μ i * ‖K i j‖ * v i) ≤ B * μ j * v j)
    (f : ι → ℂ) :
    Real.sqrt (∑ i ∈ s, μ i * ‖∑ j ∈ s, K i j * f j‖ ^ 2) ≤
      Real.sqrt (A * B) * Real.sqrt (∑ j ∈ s, μ j * ‖f j‖ ^ 2) := by
  have h := Real.sqrt_le_sqrt (finite_weighted_schur_transition s μ v K hμ hv hrow hcol f)
  simpa only [Real.sqrt_mul (mul_nonneg hA hB)] using h
end

section

noncomputable def tensorSchurWeight {ι α : Type*} [Fintype ι]
    (v : ι → α → ℝ) (x : ι → α) : ℝ := ∏ i, v i (x i)

noncomputable def tensorSchurKernel {ι α : Type*} [Fintype ι]
    (K : ι → α → α → ℂ) (x y : ι → α) : ℂ := ∏ i, K i (x i) (y i)

theorem tensorSchurWeight_nonneg {ι α : Type*} [Fintype ι]
    (v : ι → α → ℝ) (hv : ∀ i a, 0 ≤ v i a) (x : ι → α) :
    0 ≤ tensorSchurWeight v x :=
  Finset.prod_nonneg fun i _ => hv i (x i)

theorem tensorSchurWeight_pos {ι α : Type*} [Fintype ι]
    (v : ι → α → ℝ) (hv : ∀ i a, 0 < v i a) (x : ι → α) :
    0 < tensorSchurWeight v x :=
  Finset.prod_pos fun i _ => hv i (x i)

/- The absolute weighted row sum of a finite tensor kernel factors exactly. -/
theorem tensor_schur_row_sum {ι α : Type*} [Fintype ι] [Fintype α] [DecidableEq ι]
    (K : ι → α → α → ℂ) (v : ι → α → ℝ) (x : ι → α) :
    (∑ y : ι → α, ‖tensorSchurKernel K x y‖ * tensorSchurWeight v y) =
      ∏ i, ∑ b, ‖K i (x i) b‖ * v i b := by
  classical
  unfold tensorSchurKernel tensorSchurWeight
  simp_rw [norm_prod, ← Finset.prod_mul_distrib]
  exact (Fintype.prod_sum fun i b => ‖K i (x i) b‖ * v i b).symm

/- Coordinate row bounds multiply, without symmetry or sign conditions on the
complex kernels. -/
theorem tensor_schur_row_bound {ι α : Type*} [Fintype ι] [Fintype α] [DecidableEq ι]
    (K : ι → α → α → ℂ) (v : ι → α → ℝ) (A : ι → ℝ)
    (hv : ∀ i a, 0 ≤ v i a)
    (hrow : ∀ i a, (∑ b, ‖K i a b‖ * v i b) ≤ A i * v i a)
    (x : ι → α) :
    (∑ y : ι → α, ‖tensorSchurKernel K x y‖ * tensorSchurWeight v y) ≤
      (∏ i, A i) * tensorSchurWeight v x := by
  rw [tensor_schur_row_sum]
  unfold tensorSchurWeight
  rw [← Finset.prod_mul_distrib]
  exact Finset.prod_le_prod₀
    (fun i _ => Finset.sum_nonneg fun b _ => mul_nonneg (norm_nonneg _) (hv i b))
    (fun i _ => hrow i (x i))

/- Coordinate weighted transpose identities multiply to a weighted transpose
identity for the tensor kernel. -/
theorem tensor_schur_weighted_transpose {ι α : Type*} [Fintype ι]
    (μ : ι → α → ℝ) (K K' : ι → α → α → ℂ)
    (htranspose : ∀ i a b, (μ i a : ℂ) * K i a b = (μ i b : ℂ) * K' i b a)
    (x y : ι → α) :
    (tensorSchurWeight μ x : ℂ) * tensorSchurKernel K x y =
      (tensorSchurWeight μ y : ℂ) * tensorSchurKernel K' y x := by
  unfold tensorSchurWeight tensorSchurKernel
  simp only [Complex.ofReal_prod, ← Finset.prod_mul_distrib]
  exact Finset.prod_congr rfl fun i _ => htranspose i (x i) (y i)

/- Full absolute row estimates survive restriction to an arbitrary finite
cutoff, hence control the actual restricted operator in weighted squared L2. -/
theorem finite_weighted_schur_cutoff {α : Type*} [Fintype α]
    (S : Finset α) (μ v : α → ℝ) (K K' : α → α → ℂ)
    (hμ : ∀ a, 0 ≤ μ a) (hv : ∀ a, 0 < v a)
    (htranspose : ∀ a b, (μ a : ℂ) * K a b = (μ b : ℂ) * K' b a)
    {A B : ℝ}
    (hrow : ∀ a, (∑ b, ‖K a b‖ * v b) ≤ A * v a)
    (hrow' : ∀ a, (∑ b, ‖K' a b‖ * v b) ≤ B * v a)
    (f : α → ℂ) :
    (∑ a ∈ S, μ a * ‖∑ b ∈ S, K a b * f b‖ ^ 2) ≤
      A * B * ∑ b ∈ S, μ b * ‖f b‖ ^ 2 := by
  apply finite_weighted_schur_of_transpose S μ v K K'
    (fun a _ => hμ a) (fun a _ => hv a)
    (fun a _ b _ => htranspose a b)
  · intro a ha
    exact (Finset.sum_le_univ_sum_of_nonneg
      (fun b => mul_nonneg (norm_nonneg _) (hv b).le)).trans (hrow a)
  · intro a ha
    exact (Finset.sum_le_univ_sum_of_nonneg
      (fun b => mul_nonneg (norm_nonneg _) (hv b).le)).trans (hrow' a)

/- Tensorized coordinate bounds control every finite cutoff of the product
state space, including cutoffs coupling different coordinates. -/
theorem tensor_schur_cutoff {ι α : Type*} [Fintype ι] [Fintype α] [DecidableEq ι]
    (S : Finset (ι → α)) (μ v : ι → α → ℝ) (K K' : ι → α → α → ℂ)
    (hμ : ∀ i a, 0 ≤ μ i a) (hv : ∀ i a, 0 < v i a)
    (htranspose : ∀ i a b, (μ i a : ℂ) * K i a b = (μ i b : ℂ) * K' i b a)
    (A B : ι → ℝ)
    (hrow : ∀ i a, (∑ b, ‖K i a b‖ * v i b) ≤ A i * v i a)
    (hrow' : ∀ i a, (∑ b, ‖K' i a b‖ * v i b) ≤ B i * v i a)
    (f : (ι → α) → ℂ) :
    (∑ x ∈ S, tensorSchurWeight μ x *
      ‖∑ y ∈ S, tensorSchurKernel K x y * f y‖ ^ 2) ≤
      (∏ i, A i) * (∏ i, B i) * ∑ y ∈ S, tensorSchurWeight μ y * ‖f y‖ ^ 2 := by
  apply finite_weighted_schur_cutoff S (tensorSchurWeight μ) (tensorSchurWeight v)
    (tensorSchurKernel K) (tensorSchurKernel K')
    (tensorSchurWeight_nonneg μ hμ) (tensorSchurWeight_pos v hv)
    (tensor_schur_weighted_transpose μ K K' htranspose)
  · exact tensor_schur_row_bound K v A (fun i a => (hv i a).le) hrow
  · exact tensor_schur_row_bound K' v B (fun i a => (hv i a).le) hrow'
end

section
open Finset
/- The factorial weight of a single species with occupancy `n`. -/
noncomputable def ghostWeight (ν : ℝ) (n : ℕ) : ℝ := ν ^ n / (n.factorial : ℝ)

/- A ghost transition retains `k` old particles, terminates the others, and
creates `m-k` particles. The birth coefficient is `C`, the termination coefficient `D`. -/
noncomputable def ghostKernel (A D C ν : ℝ) (n m : ℕ) : ℝ :=
  ∑ k ∈ range (min n m + 1),
    (n.choose k : ℝ) * A ^ k * D ^ (n - k) * (C * ν) ^ (m - k) /
      ((m - k).factorial : ℝ)

/- Choosing particles cancels the corresponding occupancy factorials. -/
theorem ghostWeight_mul_choose (ν : ℝ) {n k : ℕ} (hk : k ≤ n) :
    ghostWeight ν n * (n.choose k : ℝ) =
      ν ^ n / ((k.factorial : ℝ) * ((n - k).factorial : ℝ)) := by
  have hn : (n.factorial : ℝ) ≠ 0 := by positivity
  have hkf : (k.factorial : ℝ) ≠ 0 := by positivity
  have hnk : ((n - k).factorial : ℝ) ≠ 0 := by positivity
  have hfac : (n.choose k : ℝ) * (k.factorial : ℝ) * ((n - k).factorial : ℝ) =
      (n.factorial : ℝ) := by exact_mod_cast Nat.choose_mul_factorial_mul_factorial hk
  unfold ghostWeight
  field_simp
  linear_combination (ν ^ n) * hfac

/- Weighted transposition exchanges births and terminations. This remains exact
for any finite occupancy cutoff, including repeated particles of the same species. -/
theorem ghostKernel_weighted_transpose (A D C ν : ℝ) (n m : ℕ) :
    ghostWeight ν n * ghostKernel A D C ν n m =
      ghostWeight ν m * ghostKernel A C D ν m n := by
  unfold ghostKernel
  rw [mul_sum, mul_sum, min_comm m n]
  apply sum_congr rfl
  intro k hk
  have hkn : k ≤ n := (Nat.le_min.mp (Nat.le_of_lt_succ (mem_range.mp hk))).1
  have hkm : k ≤ m := (Nat.le_min.mp (Nat.le_of_lt_succ (mem_range.mp hk))).2
  have hn : ν ^ n = ν ^ k * ν ^ (n - k) := by
    rw [← pow_add, Nat.add_sub_of_le hkn]
  have hm : ν ^ m = ν ^ k * ν ^ (m - k) := by
    rw [← pow_add, Nat.add_sub_of_le hkm]
  calc
    ghostWeight ν n * ((n.choose k : ℝ) * A ^ k * D ^ (n - k) *
        (C * ν) ^ (m - k) / ((m - k).factorial : ℝ)) =
      (ghostWeight ν n * (n.choose k : ℝ)) * A ^ k * D ^ (n - k) *
        (C * ν) ^ (m - k) / ((m - k).factorial : ℝ) := by ring
    _ = (ghostWeight ν m * (m.choose k : ℝ)) * A ^ k * C ^ (m - k) *
        (D * ν) ^ (n - k) / ((n - k).factorial : ℝ) := by
      rw [ghostWeight_mul_choose ν hkn, ghostWeight_mul_choose ν hkm, hn, hm, mul_pow, mul_pow]
      ring
    _ = ghostWeight ν m * ((m.choose k : ℝ) * A ^ k * C ^ (m - k) *
        (D * ν) ^ (n - k) / ((n - k).factorial : ℝ)) := by ring

/- Reindex a finite birth-and-retention sum by the number retained and then born. -/
theorem ghost_triangular_sum (f : ℕ → ℕ → ℝ) (n B : ℕ) :
    (∑ m ∈ range (B + 1), ∑ k ∈ range (min n m + 1), f k (m - k)) =
      ∑ k ∈ range (n + 1), ∑ b ∈ range (B + 1 - k), f k b := by
  have hinner (m : ℕ) :
      (∑ k ∈ range (min n m + 1), f k (m - k)) =
        ∑ k ∈ range (n + 1), if k ≤ m then f k (m - k) else 0 := by
    calc
      _ = ∑ k ∈ range (min n m + 1), if k ≤ m then f k (m - k) else 0 := by
        apply sum_congr rfl
        intro k hk
        have hkm : k ≤ m := (Nat.le_min.mp (Nat.le_of_lt_succ (mem_range.mp hk))).2
        rw [if_pos hkm]
      _ = _ := by
        apply sum_subset
        · intro k hk
          simp only [mem_range] at *
          omega
        · intro k hk hnot
          simp only [mem_range] at hk hnot
          rw [if_neg (by omega)]
  simp_rw [hinner]
  rw [sum_comm]
  apply sum_congr rfl
  intro k hk
  rw [← sum_filter]
  have hfilter : (range (B + 1)).filter (fun m => k ≤ m) = Ico k (B + 1) := by
    ext m
    simp only [mem_filter, mem_range, mem_Ico]
    omega
  rw [hfilter, sum_Ico_eq_sum_range]
  apply sum_congr rfl
  intro b hb
  rw [Nat.add_sub_cancel_left]

/- Exact finite row formula after separating retained particles from births. -/
theorem ghostKernel_row_sum (A D C ν v : ℝ) (n B : ℕ) :
    (∑ m ∈ range (B + 1), ghostKernel A D C ν n m * v ^ m) =
      ∑ k ∈ range (n + 1),
        ((n.choose k : ℝ) * A ^ k * D ^ (n - k) * v ^ k) *
          ∑ b ∈ range (B + 1 - k), (C * ν * v) ^ b / (b.factorial : ℝ) := by
  calc
    _ = ∑ m ∈ range (B + 1), ∑ k ∈ range (min n m + 1),
        ((n.choose k : ℝ) * A ^ k * D ^ (n - k) * v ^ k) *
          ((C * ν * v) ^ (m - k) / ((m - k).factorial : ℝ)) := by
      apply sum_congr rfl
      intro m hm
      unfold ghostKernel
      rw [sum_mul]
      apply sum_congr rfl
      intro k hk
      have hkm : k ≤ m := (Nat.le_min.mp (Nat.le_of_lt_succ (mem_range.mp hk))).2
      have hv : v ^ m = v ^ k * v ^ (m - k) := by
        rw [← pow_add, Nat.add_sub_of_le hkm]
      rw [hv, mul_pow]
      ring
    _ = ∑ k ∈ range (n + 1), ∑ b ∈ range (B + 1 - k),
        ((n.choose k : ℝ) * A ^ k * D ^ (n - k) * v ^ k) *
          ((C * ν * v) ^ b / (b.factorial : ℝ)) :=
      ghost_triangular_sum (fun k b =>
        ((n.choose k : ℝ) * A ^ k * D ^ (n - k) * v ^ k) *
          ((C * ν * v) ^ b / (b.factorial : ℝ))) n B
    _ = _ := by simp_rw [mul_sum]

/- The truncated positive row is bounded uniformly in the truncation level. -/
theorem ghostKernel_row_le (A D C ν v : ℝ) (n B : ℕ)
    (hA : 0 ≤ A) (hD : 0 ≤ D) (hC : 0 ≤ C) (hν : 0 ≤ ν) (hv : 0 ≤ v) :
    (∑ m ∈ range (B + 1), ghostKernel A D C ν n m * v ^ m) ≤
      Real.exp (C * ν * v) * (A * v + D) ^ n := by
  rw [ghostKernel_row_sum]
  calc
    _ ≤ ∑ k ∈ range (n + 1),
        ((n.choose k : ℝ) * A ^ k * D ^ (n - k) * v ^ k) * Real.exp (C * ν * v) := by
      apply sum_le_sum
      intro k hk
      apply mul_le_mul_of_nonneg_left
      · exact Real.sum_le_exp_of_nonneg (by positivity) _
      · positivity
    _ = Real.exp (C * ν * v) * (A * v + D) ^ n := by
      rw [add_pow, mul_sum]
      apply sum_congr rfl
      intro k hk
      rw [mul_pow]
      ring

/- Factorial occupancy weights are positive for a positive species weight. -/
theorem ghostWeight_pos {ν : ℝ} (hν : 0 < ν) (n : ℕ) : 0 < ghostWeight ν n := by
  unfold ghostWeight
  positivity

/- Replacing the signed coefficients by their absolute values dominates the kernel. -/
theorem abs_ghostKernel_le (A D C ν : ℝ) (n m : ℕ) :
    |ghostKernel A D C ν n m| ≤ ghostKernel |A| |D| |C| |ν| n m := by
  unfold ghostKernel
  calc
    _ ≤ ∑ k ∈ range (min n m + 1),
        |(n.choose k : ℝ) * A ^ k * D ^ (n - k) * (C * ν) ^ (m - k) /
          ((m - k).factorial : ℝ)| := abs_sum_le_sum_abs _ _
    _ = _ := by
      apply sum_congr rfl
      intro k hk
      simp only [abs_div, abs_mul, abs_pow, Nat.abs_cast]

/- The absolute row estimate in the Schur weight `v^n`, with the exact source constants. -/
theorem ghostKernel_abs_row_le {A ν v : ℝ} (D C : ℝ) (n B : ℕ)
    (hA : 0 ≤ A) (hν : 0 ≤ ν) (hv : 0 < v) :
    (∑ m ∈ range (B + 1), |ghostKernel A D C ν n m| * v ^ m) ≤
      Real.exp (|C| * ν * v) * (A + |D| / v) ^ n * v ^ n := by
  calc
    _ ≤ ∑ m ∈ range (B + 1), ghostKernel A |D| |C| ν n m * v ^ m := by
      apply sum_le_sum
      intro m hm
      apply mul_le_mul_of_nonneg_right _ (pow_nonneg hv.le _)
      simpa only [abs_of_nonneg hA, abs_of_nonneg hν] using abs_ghostKernel_le A D C ν n m
    _ ≤ Real.exp (|C| * ν * v) * (A * v + |D|) ^ n :=
      ghostKernel_row_le A |D| |C| ν v n B hA (abs_nonneg _) (abs_nonneg _) hν hv.le
    _ = Real.exp (|C| * ν * v) * (A + |D| / v) ^ n * v ^ n := by
      have heq : A * v + |D| = (A + |D| / v) * v := by field_simp
      rw [heq, mul_pow]
      ring

/- Damping makes the absolute row constant independent of the input occupancy. -/
theorem ghostKernel_abs_row_le_of_damping {A ν v : ℝ} (D C : ℝ) (n B : ℕ)
    (hA : 0 ≤ A) (hν : 0 ≤ ν) (hv : 0 < v) (hdamp : A + |D| / v ≤ 1) :
    (∑ m ∈ range (B + 1), |ghostKernel A D C ν n m| * v ^ m) ≤
      Real.exp (|C| * ν * v) * v ^ n := by
  apply (ghostKernel_abs_row_le D C n B hA hν hv).trans
  have hp : (A + |D| / v) ^ n ≤ 1 := pow_le_one₀ (by positivity) hdamp
  nlinarith [mul_nonneg (Real.exp_pos (|C| * ν * v)).le (pow_nonneg hv.le n),
    mul_le_mul_of_nonneg_left hp
      (mul_nonneg (Real.exp_pos (|C| * ν * v)).le (pow_nonneg hv.le n))]
end

section

/- Product factorial measure on bounded species occupancies. -/
noncomputable def ghostMemoryWeight {ι : Type*} [Fintype ι] {B : ℕ}
    (ν : ι → ℝ) (x : ι → Fin (B + 1)) : ℝ :=
  ∏ i, ghostWeight (ν i) (x i)

/- The tensor product of the signed scalar ghost kernels. -/
noncomputable def ghostMemoryKernel {ι : Type*} [Fintype ι] {B : ℕ}
    (A D C ν : ι → ℝ) (x y : ι → Fin (B + 1)) : ℂ :=
  ∏ i, (ghostKernel (A i) (D i) (C i) (ν i) (x i) (y i) : ℂ)

/- Actual row action, with the input and output restricted to the same cutoff. -/
noncomputable def ghostMemoryAction {ι : Type*} [Fintype ι] {B : ℕ}
    (S : Finset (ι → Fin (B + 1))) (A D C ν : ι → ℝ)
    (f : (ι → Fin (B + 1)) → ℂ) (x : ι → Fin (B + 1)) : ℂ :=
  ∑ y ∈ S, ghostMemoryKernel A D C ν x y * f y

/- The finite ghost memory operator has a cutoff-independent weighted L2 bound.
Signed birth and termination coefficients are permitted. -/
theorem ghostMemory_l2_sq_le {ι : Type*} [Fintype ι] {B : ℕ}
    (S : Finset (ι → Fin (B + 1))) (A D C ν v : ι → ℝ)
    (hA : ∀ i, 0 ≤ A i) (hν : ∀ i, 0 < ν i) (hv : ∀ i, 0 < v i)
    (hD : ∀ i, A i + |D i| / v i ≤ 1)
    (hC : ∀ i, A i + |C i| / v i ≤ 1)
    (f : (ι → Fin (B + 1)) → ℂ) :
    (∑ x ∈ S, ghostMemoryWeight ν x * ‖ghostMemoryAction S A D C ν f x‖ ^ 2) ≤
      Real.exp (∑ i, (|C i| + |D i|) * ν i * v i) *
        ∑ y ∈ S, ghostMemoryWeight ν y * ‖f y‖ ^ 2 := by
  classical
  let μ : ι → Fin (B + 1) → ℝ := fun i n => ghostWeight (ν i) n
  let w : ι → Fin (B + 1) → ℝ := fun i n => v i ^ (n : ℕ)
  let K : ι → Fin (B + 1) → Fin (B + 1) → ℂ :=
    fun i n m => (ghostKernel (A i) (D i) (C i) (ν i) n m : ℂ)
  let K' : ι → Fin (B + 1) → Fin (B + 1) → ℂ :=
    fun i n m => (ghostKernel (A i) (C i) (D i) (ν i) n m : ℂ)
  have hμ : ∀ i n, 0 ≤ μ i n := fun i n => (ghostWeight_pos (hν i) n).le
  have hw : ∀ i n, 0 < w i n := fun i n => pow_pos (hv i) n
  have htranspose : ∀ i n m, (μ i n : ℂ) * K i n m = (μ i m : ℂ) * K' i m n := by
    intro i n m
    simpa only [μ, K, K', Complex.ofReal_mul] using
      congrArg (fun t : ℝ => (t : ℂ))
        (ghostKernel_weighted_transpose (A i) (D i) (C i) (ν i) n m)
  have hrow : ∀ i n, (∑ m, ‖K i n m‖ * w i m) ≤
      Real.exp (|C i| * ν i * v i) * w i n := by
    intro i n
    simp only [K, w, Complex.norm_real, Real.norm_eq_abs]
    rw [Fin.sum_univ_eq_sum_range
      (fun m : ℕ => |ghostKernel (A i) (D i) (C i) (ν i) (n : ℕ) m| * v i ^ m) (B + 1)]
    exact ghostKernel_abs_row_le_of_damping (D i) (C i) n B (hA i) (hν i).le (hv i) (hD i)
  have hrow' : ∀ i n, (∑ m, ‖K' i n m‖ * w i m) ≤
      Real.exp (|D i| * ν i * v i) * w i n := by
    intro i n
    simp only [K', w, Complex.norm_real, Real.norm_eq_abs]
    rw [Fin.sum_univ_eq_sum_range
      (fun m : ℕ => |ghostKernel (A i) (C i) (D i) (ν i) (n : ℕ) m| * v i ^ m) (B + 1)]
    exact ghostKernel_abs_row_le_of_damping (C i) (D i) n B (hA i) (hν i).le (hv i) (hC i)
  have h := tensor_schur_cutoff S μ w K K' hμ hw htranspose
    (fun i => Real.exp (|C i| * ν i * v i))
    (fun i => Real.exp (|D i| * ν i * v i)) hrow hrow' f
  have hprod : (∏ i, Real.exp (|C i| * ν i * v i)) *
      (∏ i, Real.exp (|D i| * ν i * v i)) =
        Real.exp (∑ i, (|C i| + |D i|) * ν i * v i) := by
    rw [← Finset.prod_mul_distrib]
    simp_rw [← Real.exp_add]
    rw [← Real.exp_sum]
    congr 1
    apply Finset.sum_congr rfl
    intro i hi
    ring
  simpa only [hprod, tensorSchurWeight, tensorSchurKernel,
    ghostMemoryWeight, ghostMemoryAction, ghostMemoryKernel, μ, K] using h
end

section

/- Telescoping toward the last index leaves only the strictly later factors. -/
theorem lifespan_suffix_telescoping {A : Type*} [CommRing A]
    (a : ℕ → A) (n : ℕ) :
    (∏ i ∈ Finset.range n, (1 - a i)) =
      1 - ∑ j ∈ Finset.range n, a j * ∏ t ∈ Finset.Ioo j n, (1 - a t) := by
  have h := Finset.prod_one_sub_ordered (ι := OrderDual ℕ) (Finset.range n) a
  change (∏ i ∈ Finset.range n, (1 - a i)) =
    1 - ∑ j ∈ Finset.range n, a j *
      ∏ t ∈ (Finset.range n).filter (fun t => j < t), (1 - a t) at h
  rw [h]
  congr 1
  apply Finset.sum_congr rfl
  intro j hj
  congr 1
  have he : (Finset.range n).filter (fun t => j < t) = Finset.Ioo j n := by
    ext t
    simp [and_comm]
  rw [he]







/- A pair of residue hits forces the two endpoints to coincide, and fixes the
residue in every interior damping factor. -/
theorem lifespan_residue_pair_sum {R : Type*} [Fintype R] [DecidableEq R]
    (h : ℕ → R) (η : ℕ → ℝ) (j i : ℕ) :
    (∑ r : R, (η j * (if r = h j then 1 else 0)) *
      (η i * (if r = h i then 1 else 0)) *
        ∏ t ∈ Finset.Ioo j i, (1 - η t * (if r = h t then 1 else 0))) =
      η j * η i * (if h j = h i then
        ∏ t ∈ Finset.Ioo j i, (1 - η t * (if h t = h j then 1 else 0)) else 0) := by
  classical
  rw [Finset.sum_eq_single (h j)]
  · by_cases hij : h j = h i <;> simp [hij, eq_comm]
  · intro r hr hneq
    simp [hneq]
  · simp






end

section
open Finset
/- Occupancy vector of an ordered tuple; every position contributes once. -/
noncomputable def tupleOccupancy {ι : Type*} [DecidableEq ι] {n : ℕ}
    (p : Fin n → ι) : ι → ℕ :=
  ∑ j, Pi.single (p j) 1

theorem tupleOccupancy_apply {ι : Type*} [DecidableEq ι] {n : ℕ}
    (p : Fin n → ι) (i : ι) :
    tupleOccupancy p i = (univ.filter (fun j => p j = i)).card := by
  simp [tupleOccupancy, Finset.sum_apply, Pi.single_apply, eq_comm]

section

variable
  {ι : Type*}
  [sharedInstance1 : Fintype ι]
  [sharedInstance2 : DecidableEq ι]
  (ν : ι → ℝ)
  (n : ℕ)

include ι sharedInstance1 sharedInstance2 ν n

/- The same polynomial expanded by ordered positions and by occupancies. -/
theorem tuple_occupancy_generating_identity  :
    (∑ p : Fin n → ι,
      AddMonoidAlgebra.single (tupleOccupancy p) (∏ j, ν (p j))) =
    ∑ k ∈ (univ : Finset ι).piAntidiag n,
      AddMonoidAlgebra.single k
        ((Nat.multinomial univ k : ℝ) * ∏ i, ν i ^ k i) := by
  let z : ι → AddMonoidAlgebra ℝ (ι → ℕ) :=
    fun i => AddMonoidAlgebra.single (Pi.single i 1) (ν i)
  have htuple : (∑ i, z i) ^ n =
      ∑ p : Fin n → ι,
        AddMonoidAlgebra.single (tupleOccupancy p) (∏ j, ν (p j)) := by
    rw [Finset.sum_pow']
    simp only [Fintype.piFinset_univ]
    apply Finset.sum_congr rfl
    intro p hp
    exact AddMonoidAlgebra.prod_single univ (fun j => Pi.single (p j) 1)
      (fun j => ν (p j))
  rw [← htuple, Finset.sum_pow_eq_sum_piAntidiag]
  apply Finset.sum_congr rfl
  intro k hk
  have hexp : (∑ i, k i • Pi.single i (1 : ℕ)) = k := by
    ext i
    simp [Finset.sum_apply, Pi.single_apply]
  simp only [z, AddMonoidAlgebra.single_pow, AddMonoidAlgebra.prod_single, hexp]
  rw [← nsmul_eq_mul]
  simp

/- Grouping ordered tuples by occupancy, with an arbitrary occupancy test. -/
theorem sum_tuple_eq_multinomial  (F : (ι → ℕ) → ℝ) :
    (∑ p : Fin n → ι, (∏ j, ν (p j)) * F (tupleOccupancy p)) =
      ∑ k ∈ (univ : Finset ι).piAntidiag n,
        (Nat.multinomial univ k : ℝ) * (∏ i, ν i ^ k i) * F k := by
  let T : AddMonoidAlgebra ℝ (ι → ℕ) →+ ℝ :=
    (Finsupp.liftAddHom (fun k => AddMonoidHom.mulRight (F k))).comp
      AddMonoidAlgebra.coeffAddEquiv.toAddMonoidHom
  have hT (k : ι → ℕ) (r : ℝ) : T (AddMonoidAlgebra.single k r) = r * F k := by
    simp [T]
  have h := congrArg T (tuple_occupancy_generating_identity ν n)
  simpa only [map_sum, hT] using h

/- The ordered `1/n!` measure is exactly the product occupancy-factorial
measure. There are no positivity assumptions on the weights or the test. -/
theorem sum_tuple_div_factorial_eq_occupancy  (F : (ι → ℕ) → ℝ) :
    (∑ p : Fin n → ι, (∏ j, ν (p j)) * F (tupleOccupancy p)) /
        (n.factorial : ℝ) =
      ∑ k ∈ (univ : Finset ι).piAntidiag n,
        (∏ i, ν i ^ k i / ((k i).factorial : ℝ)) * F k := by
  rw [sum_tuple_eq_multinomial, Finset.sum_div]
  apply Finset.sum_congr rfl
  intro k hk
  have hsum : ∑ i, k i = n := (Finset.mem_piAntidiag.mp hk).1
  have hfac : (∏ i, ((k i).factorial : ℝ)) * (Nat.multinomial univ k : ℝ) =
      (n.factorial : ℝ) := by
    exact_mod_cast (Nat.multinomial_spec univ k).trans (congrArg Nat.factorial hsum)
  have hd : (∏ i, ((k i).factorial : ℝ)) ≠ 0 := by positivity
  have hn : (n.factorial : ℝ) ≠ 0 := by positivity
  rw [Finset.prod_div_distrib]
  field_simp
  linear_combination ((∏ i, ν i ^ k i) * F k) * hfac

end

end

section
open Finset
structure GhostLifespanState (R : Type*) where
  pending : R → ℝ
  completed : ℝ

/- The effective one-visit transition after cancellation of the auxiliary rho
factors. The reciprocal residue/baseline cost `β` is paid once at birth. -/
noncomputable def ghostLifespanStep {R : Type*} [DecidableEq R]
    (hit : R) (η β : ℝ) (s : GhostLifespanState R) : GhostLifespanState R where
  pending := fun r => s.pending r * (1 - η * (if r = hit then 1 else 0)) -
    β * η * (if r = hit then 1 else 0)
  completed := s.completed - η * s.pending hit

/- Start with the unborn state and no pending or completed lifespan. -/
noncomputable def ghostLifespanRun {R : Type*} [DecidableEq R]
    (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) : ℕ → GhostLifespanState R
  | 0 => ⟨fun _ => 0, 0⟩
  | n + 1 => ghostLifespanStep (h n) (η n) β (ghostLifespanRun h η β n)




/- A finite conservation identity records every termination while retaining
its sign. No absolute values or positivity assumptions are used. -/
theorem ghostLifespan_completed_balance {R : Type*} [Fintype R] [DecidableEq R]
    (h : ℕ → R) (η : ℕ → ℝ) (β : ℝ) (n : ℕ) :
    (ghostLifespanRun h η β n).completed =
      (∑ r : R, (ghostLifespanRun h η β n).pending r) + β * ∑ i ∈ range n, η i := by
  induction n with
  | zero => simp [ghostLifespanRun]
  | succ n ih =>
      have hstep : (∑ r : R, (ghostLifespanRun h η β (n + 1)).pending r) =
          (∑ r : R, (ghostLifespanRun h η β n).pending r) -
            η n * (ghostLifespanRun h η β n).pending (h n) - β * η n := by
        simp only [ghostLifespanRun, ghostLifespanStep, mul_sub, mul_one, sum_sub_distrib]
        simp only [mul_ite, mul_one, mul_zero, sum_ite_eq', mem_univ, if_true]
        ring
      change (ghostLifespanRun h η β n).completed -
        η n * (ghostLifespanRun h η β n).pending (h n) = _
      rw [hstep, ih, sum_range_succ]
      ring









end

section
open Finset
/- Simultaneous active hits and the damping at the inactive visits. -/
noncomputable def activeResidueWeight {R : Type*} [DecidableEq R]
    (visits active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ) (r : R) : ℝ :=
  (∏ i ∈ active, if r = h i then 1 else 0) *
    ∏ i ∈ visits \ active, (1 - η i * (if r = h i then 1 else 0))

/- An active visit fixes the residue. Further active visits impose only
compatibility, with no additional reciprocal-residue factor. -/
theorem active_lifespan_residue_sum {R : Type*} [Fintype R] [DecidableEq R]
    (visits active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ)
    (a : ℕ) (ha : a ∈ active) :
    (∑ r : R, activeResidueWeight visits active h η r) =
      if ∀ i ∈ active, h i = h a then
        ∏ i ∈ visits \ active, (1 - η i * (if h i = h a then 1 else 0))
      else 0 := by
  classical
  rw [sum_eq_single (h a)]
  · simp only [activeResidueWeight, prod_boole]
    have he : (∀ i ∈ active, h a = h i) ↔ (∀ i ∈ active, h i = h a) := by
      constructor <;> intro hh i hi <;> exact (hh i hi).symm
    simp only [he]
    split <;> simp_all [eq_comm]
  · intro r hr hne
    have hh : ¬ (∀ i ∈ active, r = h i) := fun hc => hne (hc a ha)
    simp [activeResidueWeight, prod_boole, hh]
  · simp










/- Split a finite time set before, during and after a closed lifespan. -/
theorem active_lifespan_split_product (s : Finset ℕ) (f : ℕ → ℝ)
    {a z : ℕ} (haz : a ≤ z) :
    (∏ i ∈ s, f i) =
      (∏ i ∈ s.filter (fun i => i < a), f i) *
      (∏ i ∈ s.filter (fun i => a ≤ i ∧ i ≤ z), f i) *
      ∏ i ∈ s.filter (fun i => z < i), f i := by
  have h₁ := prod_filter_mul_prod_filter_not s (fun i => i < a) f
  have h₂ := prod_filter_mul_prod_filter_not
    (s.filter (fun i => ¬ i < a)) (fun i => i ≤ z) f
  have hm : (s.filter (fun i => ¬ i < a)).filter (fun i => i ≤ z) =
      s.filter (fun i => a ≤ i ∧ i ≤ z) := by
    ext i
    simp only [mem_filter, not_lt, and_assoc]
  have ht : (s.filter (fun i => ¬ i < a)).filter (fun i => ¬ i ≤ z) =
      s.filter (fun i => z < i) := by
    ext i
    simp only [mem_filter, not_lt, not_le]
    constructor
    · rintro ⟨⟨hi, _⟩, hzi⟩
      exact ⟨hi, hzi⟩
    · rintro ⟨hi, hzi⟩
      exact ⟨⟨hi, by omega⟩, hzi⟩
  rw [hm, ht] at h₂
  rw [← h₁, ← h₂, mul_assoc]







/- When `a` and `z` are the first and last active visits, the surviving
damping product has exactly the prefix, interior gaps and suffix expected
by the single-lifespan description. -/
theorem active_lifespan_first_last_product {R : Type*} [Fintype R] [DecidableEq R]
    (active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ)
    {n a z : ℕ} (ha : a ∈ active) (hz : z ∈ active) (hzn : z < n)
    (hend : ∀ i ∈ active, a ≤ i ∧ i ≤ z) :
    (∑ r : R, activeResidueWeight (range n) active h η r) =
      if ∀ i ∈ active, h i = h a then
        (∏ i ∈ range a, (1 - η i * (if h i = h a then 1 else 0))) *
        (∏ i ∈ Ioo a z \ active, (1 - η i * (if h i = h a then 1 else 0))) *
        ∏ i ∈ Ioo z n, (1 - η i * (if h i = h a then 1 else 0))
      else 0 := by
  have haz : a ≤ z := (hend a ha).2
  have hp : (range n \ active).filter (fun i => i < a) = range a := by
    ext i
    simp only [mem_filter, mem_sdiff, mem_range]
    constructor
    · exact fun ht => ht.2
    · intro hi
      refine ⟨⟨by omega, ?_⟩, hi⟩
      intro hia
      have := (hend i hia).1
      omega
  have hm : (range n \ active).filter (fun i => a ≤ i ∧ i ≤ z) =
      Ioo a z \ active := by
    ext i
    simp only [mem_filter, mem_sdiff, mem_range, mem_Ioo]
    constructor
    · rintro ⟨⟨hin, hia⟩, hai, hiz⟩
      have hne₁ : i ≠ a := by rintro rfl; exact hia ha
      have hne₂ : i ≠ z := by rintro rfl; exact hia hz
      exact ⟨⟨by omega, by omega⟩, hia⟩
    · rintro ⟨⟨hai, hiz⟩, hia⟩
      exact ⟨⟨by omega, hia⟩, by omega, by omega⟩
  have hs : (range n \ active).filter (fun i => z < i) = Ioo z n := by
    ext i
    simp only [mem_filter, mem_sdiff, mem_range, mem_Ioo]
    constructor
    · rintro ⟨⟨hin, _⟩, hzi⟩
      exact ⟨hzi, hin⟩
    · rintro ⟨hzi, hin⟩
      refine ⟨⟨hin, ?_⟩, hzi⟩
      intro hia
      have := (hend i hia).2
      omega
  rw [active_lifespan_residue_sum _ _ _ _ a ha]
  split
  · rw [active_lifespan_split_product _ _ haz, hp, hm, hs]
  · rfl
end

section
open Finset
section

variable
  {ι : Type*}
  [sharedInstance1 : Fintype ι]
  [sharedInstance2 : DecidableEq ι]
  (m : ι → ℕ)
  [sharedInstance4 : ∀ i, NeZero (m i)]
  (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))

include ι sharedInstance1 sharedInstance2 m sharedInstance4 hc

/- A complete period maps bijectively to its tuple of local residues. -/
theorem lifespan_crt_bijective  :
    Function.Bijective (fun k : Fin (∏ i, m i) => fun i => (k.val : ZMod (m i))) := by
  apply (Fintype.bijective_iff_surjective_and_card _).2
  constructor
  · intro r
    have hm : ∀ i ∈ (univ : Finset ι), m i ≠ 0 := fun i _ => NeZero.ne (m i)
    have hp : Set.Pairwise (↑(univ : Finset ι)) (Function.onFun Nat.Coprime m) := by
      intro i _ j _ hij
      exact hc hij
    let k := Nat.chineseRemainderOfFinset (fun i => (r i).val) m univ hm hp
    have hk : k.val < ∏ i, m i :=
      Nat.chineseRemainderOfFinset_lt_prod (fun i => (r i).val) m hm hp
    refine ⟨⟨k.val, hk⟩, ?_⟩
    funext i
    have he : (k.val : ZMod (m i)) = ((r i).val : ZMod (m i)) :=
      (ZMod.natCast_eq_natCast_iff _ _ _).2 (k.property i (mem_univ i))
    exact he.trans (ZMod.natCast_zmod_val (r i))
  · simp only [Fintype.card_fin, Fintype.card_pi, ZMod.card]

/- Signed weights at independent local residues factor exactly over a
complete period. This is an identity, so no cancellation is discarded. -/
theorem lifespan_crt_sum 
    (f : ∀ i, ZMod (m i) → ℝ) :
    (∑ k ∈ range (∏ i, m i), ∏ i, f i (k : ZMod (m i))) =
      ∏ i, ∑ r : ZMod (m i), f i r := by
  rw [← Fin.sum_univ_eq_sum_range]
  let e := Equiv.ofBijective _ (lifespan_crt_bijective m hc)
  calc
    _ = ∑ r : ∀ i, ZMod (m i), ∏ i, f i (r i) :=
      e.sum_comp (fun r => ∏ i, f i (r i))
    _ = _ := (Fintype.prod_sum f).symm

end
















end

section
open Finset
/- Every full block of a periodic sequence contributes the same signed sum. -/
theorem periodic_full_blocks (f : ℕ → ℝ) {M : ℕ}
    (hf : Function.Periodic f M) (k : ℕ) :
    (∑ i ∈ range (k * M), f i) = (k : ℝ) * ∑ i ∈ range M, f i := by
  induction k with
  | zero => simp
  | succ k ih =>
      rw [Nat.succ_mul, sum_range_add, ih]
      have hs : (∑ i ∈ range M, f (k * M + i)) = ∑ i ∈ range M, f i := by
        apply sum_congr rfl
        intro i hi
        simpa [Nat.add_comm] using hf.nat_mul k i
      rw [hs, Nat.cast_add, Nat.cast_one]
      ring

/- Split a periodic sum into its full blocks and the final incomplete block. -/
theorem periodic_quotient_remainder (f : ℕ → ℝ) {M : ℕ}
    (hf : Function.Periodic f M) (N : ℕ) :
    (∑ i ∈ range N, f i) =
      ((N / M : ℕ) : ℝ) * (∑ i ∈ range M, f i) + ∑ i ∈ range (N % M), f i := by
  have hn : N / M * M + N % M = N := by
    simpa only [Nat.mul_comm] using Nat.div_add_mod N M
  conv_lhs => rw [← hn]
  rw [sum_range_add, periodic_full_blocks f hf]
  congr 1
  apply sum_congr rfl
  intro i hi
  simpa [Nat.add_comm] using hf.nat_mul (N / M) i

/- The error in replacing a finite sum by its period mean is controlled by
twice the absolute mass of one period, uniformly in the interval length. -/
theorem periodic_mean_error (f : ℕ → ℝ) {M : ℕ} (hM : 0 < M)
    (hf : Function.Periodic f M) (N : ℕ) :
    |(∑ i ∈ range N, f i) - ((N : ℝ) / M) * ∑ i ∈ range M, f i| ≤
      2 * ∑ i ∈ range M, |f i| := by
  have hMr : (0 : ℝ) < M := by exact_mod_cast hM
  have hn : (N : ℝ) = ((N / M : ℕ) : ℝ) * M + ((N % M : ℕ) : ℝ) := by
    have hnat : N = N / M * M + N % M := by
      simpa only [Nat.mul_comm] using (Nat.div_add_mod N M).symm
    exact_mod_cast hnat
  have he : (∑ i ∈ range N, f i) - ((N : ℝ) / M) * ∑ i ∈ range M, f i =
      (∑ i ∈ range (N % M), f i) -
        (((N % M : ℕ) : ℝ) / M) * ∑ i ∈ range M, f i := by
    rw [periodic_quotient_remainder f hf N]
    conv_lhs => rw [hn]
    field_simp
    ring
  have hratio0 : (0 : ℝ) ≤ ((N % M : ℕ) : ℝ) / M := by positivity
  have hratio1 : (((N % M : ℕ) : ℝ) / M) ≤ 1 := by
    apply (div_le_one hMr).2
    exact_mod_cast (Nat.mod_lt N hM).le
  have hpart : |∑ i ∈ range (N % M), f i| ≤ ∑ i ∈ range M, |f i| := by
    calc
      _ ≤ ∑ i ∈ range (N % M), |f i| := abs_sum_le_sum_abs _ _
      _ ≤ ∑ i ∈ range M, |f i| := by
        apply sum_le_sum_of_subset_of_nonneg
        · exact range_mono (Nat.mod_lt N hM).le
        · intro i hi hnot
          exact abs_nonneg _
  have hwhole : |∑ i ∈ range M, f i| ≤ ∑ i ∈ range M, |f i| :=
    abs_sum_le_sum_abs _ _
  rw [he]
  calc
    _ ≤ |∑ i ∈ range (N % M), f i| +
        |(((N % M : ℕ) : ℝ) / M) * ∑ i ∈ range M, f i| := abs_sub _ _
    _ = |∑ i ∈ range (N % M), f i| +
        (((N % M : ℕ) : ℝ) / M) * |∑ i ∈ range M, f i| := by
          rw [abs_mul, abs_of_nonneg hratio0]
    _ ≤ (∑ i ∈ range M, |f i|) + 1 * (∑ i ∈ range M, |f i|) := by
      exact add_le_add hpart (mul_le_mul hratio1 hwhole (abs_nonneg _) (by positivity))
    _ = _ := by ring

/- The product of local residue weights is periodic with the product modulus. -/
theorem lifespan_crt_periodic {ι : Type*} [Fintype ι] [DecidableEq ι]
    (m : ι → ℕ) (f : ∀ i, ZMod (m i) → ℝ) :
    Function.Periodic (fun k : ℕ => ∏ i, f i (k : ZMod (m i))) (∏ i, m i) := by
  intro k
  apply prod_congr rfl
  intro i hi
  have hm : ((∏ j, m j : ℕ) : ZMod (m i)) = 0 :=
    (ZMod.natCast_eq_zero_iff _ _).2 (dvd_prod_of_mem m hi)
  rw [Nat.cast_add, hm, add_zero]

/- A finite interval differs from its CRT mean by a bounded boundary error.
The absolute local masses, rather than a supremum over tuples, control it. -/
theorem lifespan_crt_interval_error {ι : Type*} [Fintype ι] [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (f : ∀ i, ZMod (m i) → ℝ) (N : ℕ) :
    |(∑ k ∈ range N, ∏ i, f i (k : ZMod (m i))) -
      ((N : ℝ) / ((∏ i, m i) : ℕ)) * (∏ i, ∑ r : ZMod (m i), f i r)| ≤
      2 * ∏ i, ∑ r : ZMod (m i), |f i r| := by
  have hM : 0 < ∏ i, m i := prod_pos (fun i _ => Nat.pos_of_ne_zero (NeZero.ne (m i)))
  have he := periodic_mean_error (fun k : ℕ => ∏ i, f i (k : ZMod (m i)))
    hM (lifespan_crt_periodic m f) N
  rw [lifespan_crt_sum m hc f] at he
  simpa only [abs_prod, lifespan_crt_sum m hc (fun i r => |f i r|)] using he



end

section
open Finset
/- Elementary symmetric sum of the local exclusion weights. -/
noncomputable def exclusionElementary {ι : Type*} (s : Finset ι)
    (w : ι → ℝ) (k : ℕ) : ℝ := ∑ t ∈ s.powersetCard k, ∏ i ∈ t, w i

/- Truncate the product expansion strictly before degree `k`. -/
noncomputable def exclusionTruncation {ι : Type*} (s : Finset ι)
    (w : ι → ℝ) (k : ℕ) : ℝ :=
  ∑ j ∈ range k, (-1 : ℝ)^j * exclusionElementary s w j

theorem exclusion_elementary_zero {ι : Type*} (s : Finset ι) (w : ι → ℝ) :
    exclusionElementary s w 0 = 1 := by simp [exclusionElementary]

theorem exclusion_elementary_empty_succ {ι : Type*} (w : ι → ℝ) (k : ℕ) :
    exclusionElementary ∅ w (k + 1) = 0 := by
  have he : (∅ : Finset ι).powersetCard (k + 1) = ∅ :=
    powersetCard_eq_empty.mpr (by simp)
  simp [exclusionElementary, he]

/- Separating subsets according to whether they contain the new index. -/
theorem exclusion_elementary_insert {ι : Type*} [DecidableEq ι]
    {s : Finset ι} {a : ι} (ha : a ∉ s) (w : ι → ℝ) (k : ℕ) :
    exclusionElementary (insert a s) w (k + 1) =
      exclusionElementary s w (k + 1) + w a * exclusionElementary s w k := by
  have hd : Disjoint (s.powersetCard (k + 1)) ((s.powersetCard k).image (insert a)) := by
    apply disjoint_left.2
    intro t ht hti
    rcases mem_image.mp hti with ⟨u, hu, rfl⟩
    exact ha ((mem_powersetCard.mp ht).1 (mem_insert_self a u))
  unfold exclusionElementary
  rw [powersetCard_succ_insert ha, sum_union hd, sum_image]
  · rw [mul_sum]
    congr 1
    apply sum_congr rfl
    intro t ht
    exact prod_insert (fun hat => ha ((mem_powersetCard.mp ht).1 hat))
  · intro t ht u hu he
    have ht' : a ∉ t := fun hat => ha ((mem_powersetCard.mp ht).1 hat)
    have hu' : a ∉ u := fun hau => ha ((mem_powersetCard.mp hu).1 hau)
    simpa only [erase_insert ht', erase_insert hu'] using congrArg (fun t => t.erase a) he

/- The truncated expansion respects insertion, with adjacent degrees. -/
theorem exclusion_truncation_insert {ι : Type*} [DecidableEq ι]
    {s : Finset ι} {a : ι} (ha : a ∉ s) (w : ι → ℝ) (k : ℕ) :
    exclusionTruncation (insert a s) w (k + 1) =
      exclusionTruncation s w (k + 1) - w a * exclusionTruncation s w k := by
  unfold exclusionTruncation
  rw [sum_range_succ', sum_range_succ' (fun j => (-1 : ℝ)^j * exclusionElementary s w j)]
  simp only [exclusion_elementary_zero, pow_zero, one_mul]
  simp_rw [exclusion_elementary_insert ha, mul_add, sum_add_distrib]
  rw [mul_sum]
  have he : (∑ j ∈ range k, (-1 : ℝ)^(j + 1) * (w a * exclusionElementary s w j)) =
      -(∑ j ∈ range k, w a * ((-1 : ℝ)^j * exclusionElementary s w j)) := by
    rw [← sum_neg_distrib]
    apply sum_congr rfl
    intro j hj
    rw [pow_succ]
    ring
  rw [he]
  ring

section

variable
  {ι : Type*}
  (s : Finset ι)
  (w : ι → ℝ)

include ι s w

/- Bonferroni's signed remainder lies between zero and the next elementary
symmetric sum, for arbitrary finite weights in the unit interval. -/
theorem exclusion_bonferroni 
    (hw : ∀ i ∈ s, 0 ≤ w i ∧ w i ≤ 1) (k : ℕ) :
    0 ≤ (-1 : ℝ)^k * ((∏ i ∈ s, (1 - w i)) - exclusionTruncation s w k) ∧
    (-1 : ℝ)^k * ((∏ i ∈ s, (1 - w i)) - exclusionTruncation s w k) ≤
      exclusionElementary s w k := by
  classical
  induction s using Finset.induction_on generalizing k with
  | empty =>
      cases k with
      | zero => simp [exclusionTruncation, exclusionElementary]
      | succ k =>
          simp [exclusionTruncation, exclusion_elementary_zero,
            exclusion_elementary_empty_succ, sum_range_succ']
  | @insert a s ha ih =>
      have hwa := hw a (mem_insert_self a s)
      have hws : ∀ i ∈ s, 0 ≤ w i ∧ w i ≤ 1 := fun i hi => hw i (mem_insert_of_mem hi)
      cases k with
      | zero =>
          simp only [pow_zero, one_mul, exclusionTruncation, range_zero, sum_empty,
            sub_zero, exclusion_elementary_zero]
          exact ⟨prod_nonneg (fun i hi => sub_nonneg.mpr (hw i hi).2),
            prod_le_one₀ (fun i hi => sub_nonneg.mpr (hw i hi).2)
              (fun i hi => sub_le_self _ (hw i hi).1)⟩
      | succ k =>
          have hk := ih hws k
          have hk1 := ih hws (k + 1)
          rw [prod_insert ha, exclusion_truncation_insert ha,
            exclusion_elementary_insert ha]
          have he : (-1 : ℝ)^(k + 1) *
              ((1 - w a) * (∏ i ∈ s, (1 - w i)) -
                (exclusionTruncation s w (k + 1) - w a * exclusionTruncation s w k)) =
              (-1 : ℝ)^(k + 1) *
                ((∏ i ∈ s, (1 - w i)) - exclusionTruncation s w (k + 1)) +
              w a * ((-1 : ℝ)^k *
                ((∏ i ∈ s, (1 - w i)) - exclusionTruncation s w k)) := by
            rw [pow_succ]
            ring
          rw [he]
          exact ⟨add_nonneg hk1.1 (mul_nonneg hwa.1 hk.1),
            add_le_add hk1.2 (mul_le_mul_of_nonneg_left hk.2 hwa.1)⟩

/- The elementary symmetric sum is at most the corresponding exponential
coefficient, without any upper bound on the nonnegative weights. -/
theorem exclusion_elementary_factorial 
    (hw : ∀ i ∈ s, 0 ≤ w i) (k : ℕ) :
    exclusionElementary s w k * (k.factorial : ℝ) ≤ (∑ i ∈ s, w i)^k := by
  classical
  induction s using Finset.induction_on generalizing k with
  | empty =>
      cases k <;> simp [exclusion_elementary_zero, exclusion_elementary_empty_succ]
  | @insert a s ha ih =>
      have hwa := hw a (mem_insert_self a s)
      have hws : ∀ i ∈ s, 0 ≤ w i := fun i hi => hw i (mem_insert_of_mem hi)
      have hsum : 0 ≤ ∑ i ∈ s, w i := sum_nonneg hws
      cases k with
      | zero => simp [exclusion_elementary_zero]
      | succ k =>
          rw [exclusion_elementary_insert ha, sum_insert ha]
          have hk := ih hws k
          have hk1 := ih hws (k + 1)
          have hmul := mul_le_mul_of_nonneg_left hk
            (show 0 ≤ w a * ((k + 1 : ℕ) : ℝ) by positivity)
          have hpow := pow_add_mul_le_add_pow hsum
            (show 0 ≤ 2 * (∑ i ∈ s, w i) + w a by positivity) (k + 1)
          simp only [Nat.add_sub_cancel] at hpow
          have he : (exclusionElementary s w (k + 1) + w a * exclusionElementary s w k) *
                ((k + 1).factorial : ℝ) =
              exclusionElementary s w (k + 1) * ((k + 1).factorial : ℝ) +
                (w a * ((k + 1 : ℕ) : ℝ)) * (exclusionElementary s w k * (k.factorial : ℝ)) := by
            rw [Nat.factorial_succ, Nat.cast_mul]
            ring
          rw [he]
          calc
            _ ≤ (∑ i ∈ s, w i)^(k + 1) +
                (w a * ((k + 1 : ℕ) : ℝ)) * (∑ i ∈ s, w i)^k := add_le_add hk1 hmul
            _ = (∑ i ∈ s, w i)^(k + 1) +
                ((k + 1 : ℕ) : ℝ) * (∑ i ∈ s, w i)^k * w a := by ring
            _ ≤ ((∑ i ∈ s, w i) + w a)^(k + 1) := hpow
            _ = _ := by rw [add_comm]

/- The standard factorial bound, written in the form used to control the
gap between adjacent Bonferroni truncations. -/
theorem exclusion_elementary_le_pow_div_factorial  (hw : ∀ i ∈ s, 0 ≤ w i) (k : ℕ) :
    exclusionElementary s w k ≤ (∑ i ∈ s, w i)^k / (k.factorial : ℝ) := by
  apply (le_div_iff₀ (by exact_mod_cast Nat.factorial_pos k)).2
  exact exclusion_elementary_factorial s w hw k

/- Absolute truncation error, before replacing the elementary coefficient
by its exponential majorant. -/
theorem exclusion_truncation_error 
    (hw : ∀ i ∈ s, 0 ≤ w i ∧ w i ≤ 1) (k : ℕ) :
    |(∏ i ∈ s, (1 - w i)) - exclusionTruncation s w k| ≤
      exclusionElementary s w k := by
  obtain ⟨h0, h1⟩ := exclusion_bonferroni s w hw k
  calc
    _ = |(-1 : ℝ)^k * ((∏ i ∈ s, (1 - w i)) - exclusionTruncation s w k)| := by
      simp [abs_mul]
    _ = _ := abs_of_nonneg h0
    _ ≤ _ := h1

end







end

section
open Finset
/- A finite nonnegative average preserves the Bonferroni remainder bound. -/
theorem exclusion_average_remainder {ι Ω : Type*} (s : Finset ι) (t : Finset Ω)
    (μ : Ω → ℝ) (X : Ω → ι → ℝ) (hμ : ∀ x ∈ t, 0 ≤ μ x)
    (hX : ∀ x ∈ t, ∀ i ∈ s, 0 ≤ X x i ∧ X x i ≤ 1) (k : ℕ) :
    |(∑ x ∈ t, μ x * ∏ i ∈ s, (1 - X x i)) -
      (∑ x ∈ t, μ x * exclusionTruncation s (X x) k)| ≤
      ∑ x ∈ t, μ x * exclusionElementary s (X x) k := by
  rw [← sum_sub_distrib]
  calc
    _ ≤ ∑ x ∈ t, |μ x * (∏ i ∈ s, (1 - X x i)) -
        μ x * exclusionTruncation s (X x) k| := abs_sum_le_sum_abs _ _
    _ ≤ _ := by
      apply sum_le_sum
      intro x hx
      rw [← mul_sub, abs_mul, abs_of_nonneg (hμ x hx)]
      exact mul_le_mul_of_nonneg_left (exclusion_truncation_error s (X x) (hX x hx) k) (hμ x hx)

/- The error for a signed truncation is bounded by the sum of its moment
errors. Its alternating coefficients have absolute value one. -/
theorem exclusion_average_truncation_error {ι Ω : Type*} (s : Finset ι) (t : Finset Ω)
    (μ : Ω → ℝ) (X : Ω → ι → ℝ) (v : ι → ℝ) (d : ℕ → ℝ) (k : ℕ)
    (hd : ∀ j < k, |(∑ x ∈ t, μ x * exclusionElementary s (X x) j) -
      exclusionElementary s v j| ≤ d j) :
    |(∑ x ∈ t, μ x * exclusionTruncation s (X x) k) -
      exclusionTruncation s v k| ≤ ∑ j ∈ range k, d j := by
  have he : (∑ x ∈ t, μ x * exclusionTruncation s (X x) k) - exclusionTruncation s v k =
      ∑ j ∈ range k, (-1 : ℝ)^j *
        ((∑ x ∈ t, μ x * exclusionElementary s (X x) j) - exclusionElementary s v j) := by
    simp only [exclusionTruncation, mul_sum]
    rw [sum_comm, ← sum_sub_distrib]
    apply sum_congr rfl
    intro j hj
    rw [mul_sub, mul_sum]
    congr 1
    apply sum_congr rfl
    intro x hx
    ring
  rw [he]
  calc
    _ ≤ ∑ j ∈ range k, |(-1 : ℝ)^j *
        ((∑ x ∈ t, μ x * exclusionElementary s (X x) j) - exclusionElementary s v j)| :=
      abs_sum_le_sum_abs _ _
    _ ≤ _ := by
      apply sum_le_sum
      intro j hj
      simpa only [abs_mul, abs_pow, abs_neg, abs_one, one_pow, one_mul] using hd j (mem_range.mp hj)

section

variable
  {ι Ω : Type*}
  (s : Finset ι)
  (t : Finset Ω)
  (μ : Ω → ℝ)
  (X : Ω → ι → ℝ)
  (v : ι → ℝ)
  (d : ℕ → ℝ)
  (hμ : ∀ x ∈ t, 0 ≤ μ x)
  (hX : ∀ x ∈ t, ∀ i ∈ s, 0 ≤ X x i ∧ X x i ≤ 1)
  (hv : ∀ i ∈ s, 0 ≤ v i ∧ v i ≤ 1)
  (k : ℕ)
  (hd : ∀ j ≤ k, |(∑ x ∈ t, μ x * exclusionElementary s (X x) j) -
      exclusionElementary s v j| ≤ d j)

include ι Ω s t μ X v d hμ hX hv k hd

/- Moment comparison through degree `k` controls the full product. This
form allows arithmetic CRT errors to be inserted independently at each degree. -/
theorem exclusion_moment_transfer  :
    |(∑ x ∈ t, μ x * ∏ i ∈ s, (1 - X x i)) - (∏ i ∈ s, (1 - v i))| ≤
      2 * exclusionElementary s v k + ∑ j ∈ range (k + 1), d j := by
  have hrem := exclusion_average_remainder s t μ X hμ hX k
  have htrunc := exclusion_average_truncation_error s t μ X v d k
    (fun j hj => hd j hj.le)
  have hvrem := exclusion_truncation_error s v hv k
  have hmoment := (le_abs_self ((∑ x ∈ t, μ x * exclusionElementary s (X x) k) -
    exclusionElementary s v k)).trans (hd k le_rfl)
  have htri := abs_sub_le
    (∑ x ∈ t, μ x * ∏ i ∈ s, (1 - X x i))
    (∑ x ∈ t, μ x * exclusionTruncation s (X x) k) (∏ i ∈ s, (1 - v i))
  have htri₂ := abs_sub_le (∑ x ∈ t, μ x * exclusionTruncation s (X x) k)
    (exclusionTruncation s v k) (∏ i ∈ s, (1 - v i))
  rw [abs_sub_comm (∏ i ∈ s, (1 - v i))] at hvrem
  rw [sum_range_succ]
  linarith

/- A quantitative version using only the sum of the model exclusion
probabilities and the finite arithmetic moment errors. -/
theorem exclusion_moment_transfer_factorial  :
    |(∑ x ∈ t, μ x * ∏ i ∈ s, (1 - X x i)) - (∏ i ∈ s, (1 - v i))| ≤
      2 * ((∑ i ∈ s, v i)^k / (k.factorial : ℝ)) + ∑ j ∈ range (k + 1), d j := by
  refine (exclusion_moment_transfer s t μ X v d hμ hX hv k hd).trans ?_
  have he := exclusion_elementary_le_pow_div_factorial s v (fun i hi => (hv i hi).1) k
  linarith

end

end

section
open Finset
/- The uniform local mean of a residue weight. -/
noncomputable def exclusionLocalMean {ι : Type*} (m : ι → ℕ) [∀ i, NeZero (m i)]
    (X : ∀ i, ZMod (m i) → ℝ) (i : ι) : ℝ := (∑ r, X i r) / (m i : ℝ)

/- The unnormalized local absolute mass, controlling the CRT boundary error. -/
noncomputable def exclusionLocalMass {ι : Type*} (m : ι → ℕ) [∀ i, NeZero (m i)]
    (X : ∀ i, ZMod (m i) → ℝ) (i : ι) : ℝ := ∑ r, |X i r|







/- Local means of unit-interval weights are again in the unit interval. -/
theorem exclusion_local_mean_unit {ι : Type*} (m : ι → ℕ) [∀ i, NeZero (m i)]
    (X : ∀ i, ZMod (m i) → ℝ) (i : ι) (hX : ∀ r, 0 ≤ X i r ∧ X i r ≤ 1) :
    0 ≤ exclusionLocalMean m X i ∧ exclusionLocalMean m X i ≤ 1 := by
  have hm : (0 : ℝ) < m i := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne (m i))
  constructor
  · exact div_nonneg (sum_nonneg (fun r hr => (hX r).1)) hm.le
  · apply (div_le_one hm).2
    calc
      (∑ r, X i r) ≤ ∑ _r : ZMod (m i), (1 : ℝ) := sum_le_sum (fun r hr => (hX r).2)
      _ = _ := by simp [ZMod.card]



end

section
open Finset
theorem exclusion_elementary_one {ι : Type*} (s : Finset ι) (w : ι → ℝ) :
    exclusionElementary s w 1 = ∑ i ∈ s, w i := by
  classical
  simp [exclusionElementary, powersetCard_one]

/- The finite union bound for arbitrary numbers in the unit interval. -/
theorem exclusion_product_defect_le_sum {ι : Type*} (s : Finset ι) (w : ι → ℝ)
    (hw : ∀ i ∈ s, 0 ≤ w i ∧ w i ≤ 1) :
    1 - ∏ i ∈ s, (1 - w i) ≤ ∑ i ∈ s, w i := by
  have h := (exclusion_bonferroni s w hw 2).1
  norm_num [exclusionTruncation, sum_range_succ, exclusion_elementary_zero,
    exclusion_elementary_one] at h
  linarith

/- Repeated visits at the same residue are collected into a single local
weight, retaining the complete damping product at that residue. -/
noncomputable def visitExclusion {R : Type*} [DecidableEq R]
    (visits : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ) (r : R) : ℝ :=
  1 - ∏ i ∈ visits, (1 - η i * (if r = h i then 1 else 0))

theorem visit_exclusion_unit {R : Type*} [DecidableEq R]
    (visits : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ)
    (hη : ∀ i ∈ visits, 0 ≤ η i ∧ η i ≤ 1) (r : R) :
    0 ≤ visitExclusion visits h η r ∧ visitExclusion visits h η r ≤ 1 := by
  have hd : ∀ i ∈ visits, 0 ≤ η i * (if r = h i then 1 else 0) ∧
      η i * (if r = h i then 1 else 0) ≤ 1 := by
    intro i hi
    by_cases hir : r = h i
    · simpa [hir] using hη i hi
    · simp [hir]
  have hp0 : 0 ≤ ∏ i ∈ visits, (1 - η i * (if r = h i then 1 else 0)) :=
    prod_nonneg (fun i hi => sub_nonneg.mpr (hd i hi).2)
  have hp1 : (∏ i ∈ visits, (1 - η i * (if r = h i then 1 else 0))) ≤ 1 :=
    prod_le_one₀ (fun i hi => sub_nonneg.mpr (hd i hi).2)
      (fun i hi => sub_le_self _ (hd i hi).1)
  dsimp [visitExclusion]
  constructor <;> linarith

/- Repeated hits cannot increase the total exclusion mass beyond the sum
of the individual visit weights. -/
theorem visit_exclusion_mass {R : Type*} [Fintype R] [DecidableEq R]
    (visits : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ)
    (hη : ∀ i ∈ visits, 0 ≤ η i ∧ η i ≤ 1) :
    (∑ r : R, visitExclusion visits h η r) ≤ ∑ i ∈ visits, η i := by
  have hb : ∀ r, visitExclusion visits h η r ≤
      ∑ i ∈ visits, η i * (if r = h i then 1 else 0) := by
    intro r
    apply exclusion_product_defect_le_sum
    intro i hi
    by_cases hir : r = h i
    · simpa [hir] using hη i hi
    · simp [hir]
  calc
    _ ≤ ∑ r : R, ∑ i ∈ visits, η i * (if r = h i then 1 else 0) :=
      sum_le_sum (fun r hr => hb r)
    _ = _ := by rw [sum_comm]; simp

/- Dividing by the residue count gives the local probability estimate used
in the sum of exclusion probabilities. -/
theorem visit_exclusion_mean_bound (q : ℕ) [NeZero q]
    (visits : Finset ℕ) (h : ℕ → ZMod q) (η : ℕ → ℝ)
    (hη : ∀ i ∈ visits, 0 ≤ η i ∧ η i ≤ 1) :
    (∑ r : ZMod q, visitExclusion visits h η r) / (q : ℝ) ≤
      (∑ i ∈ visits, η i) / (q : ℝ) := by
  exact div_le_div_of_nonneg_right (visit_exclusion_mass visits h η hη) (Nat.cast_nonneg q)

/- A small local exclusion probability leaves an exponentially bounded
survival probability. -/
theorem exclusion_exp_lower {v : ℝ} (hv0 : 0 ≤ v) (hv1 : v ≤ 1 / 2) :
    Real.exp (-2 * v) ≤ 1 - v := by
  have hp : 0 < 1 - v := by linarith
  have hl : -2 * v ≤ 1 - (1 - v)⁻¹ := by
    apply (mul_le_mul_iff_right₀ hp).mp
    have hinv := mul_inv_cancel₀ hp.ne'
    have hquad := mul_nonneg hv0 (show 0 ≤ 1 - 2 * v by linarith)
    nlinarith
  have hlog := hl.trans (Real.one_sub_inv_le_log_of_pos hp)
  calc
    _ ≤ Real.exp (Real.log (1 - v)) := Real.exp_le_exp.mpr hlog
    _ = _ := Real.exp_log hp

section

variable
  {ι : Type*}
  (s : Finset ι)
  (v : ι → ℝ)
  (hv : ∀ i ∈ s, 0 ≤ v i ∧ v i ≤ 1 / 2)

include ι s v hv

/- Independent local survival factors retain mass at least `exp(-2 λ)`
when their exclusion probabilities are at most one half. -/
theorem exclusion_product_exp_lower  :
    Real.exp (-2 * ∑ i ∈ s, v i) ≤ ∏ i ∈ s, (1 - v i) := by
  calc
    _ = ∏ i ∈ s, Real.exp (-2 * v i) := by rw [mul_sum, Real.exp_sum]
    _ ≤ _ := prod_le_prod₀ (fun i hi => (Real.exp_pos _).le)
      (fun i hi => exclusion_exp_lower (hv i hi).1 (hv i hi).2)

/- An absolute error becomes a relative one at the cost of the reciprocal
survival lower bound. -/
theorem exclusion_relative_error  {A E : ℝ}
    (hE : |A - ∏ i ∈ s, (1 - v i)| ≤ E) :
    |A / (∏ i ∈ s, (1 - v i)) - 1| ≤
      Real.exp (2 * ∑ i ∈ s, v i) * E := by
  have hp := exclusion_product_exp_lower s v hv
  have hp0 : 0 < ∏ i ∈ s, (1 - v i) := (Real.exp_pos _).trans_le hp
  have hE0 : 0 ≤ E := (abs_nonneg _).trans hE
  calc
    _ = |A - ∏ i ∈ s, (1 - v i)| / (∏ i ∈ s, (1 - v i)) := by
      calc
        _ = |(A - ∏ i ∈ s, (1 - v i)) / (∏ i ∈ s, (1 - v i))| := by
          congr 1
          field_simp
        _ = _ := by rw [abs_div, abs_of_pos hp0]
    _ ≤ E / (∏ i ∈ s, (1 - v i)) := div_le_div_of_nonneg_right hE hp0.le
    _ ≤ E / Real.exp (-2 * ∑ i ∈ s, v i) :=
      div_le_div_of_nonneg_left hE0 (Real.exp_pos _) hp
    _ = _ := by rw [show -2 * (∑ i ∈ s, v i) = -(2 * ∑ i ∈ s, v i) by ring,
      Real.exp_neg]; field_simp

end




end

section
open Finset
/- CRT with one distinguished coordinate and an arbitrary finite set of
other coordinates. The distinguished weight can have either sign. -/
theorem distinguished_crt_error {ι : Type*} [DecidableEq ι]
    (q : ℕ) [NeZero q] (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (hqm : ∀ i, Nat.Coprime q (m i)) (F : ZMod q → ℝ)
    (X : ∀ i, ZMod (m i) → ℝ) (s : Finset ι) (N : ℕ) :
    |(∑ n ∈ range N, F (n : ZMod q) * ∏ i ∈ s, X i (n : ZMod (m i))) -
      ((N : ℝ) / q) * (∑ r : ZMod q, F r) * (∏ i ∈ s, exclusionLocalMean m X i)| ≤
      2 * (∑ r : ZMod q, |F r|) * ∏ i ∈ s, exclusionLocalMass m X i := by
  let M : Unit ⊕ s → ℕ := Sum.elim (fun _ => q) (fun i => m i)
  let W : ∀ i, ZMod (M i) → ℝ := fun i =>
    match i with
    | .inl _ => F
    | .inr j => X j
  let : ∀ i, NeZero (M i) := fun i => by
    cases i <;> dsimp [M] <;> infer_instance
  have hM : Pairwise (fun i j => Nat.Coprime (M i) (M j)) := by
    intro i j hij
    cases i with
    | inl i =>
        cases j with
        | inl j => exact False.elim (hij (by congr))
        | inr j => exact hqm j
    | inr i =>
        cases j with
        | inl j => exact (hqm i).symm
        | inr j => exact hc (fun h => hij (congrArg Sum.inr (Subtype.ext h)))
  have he := lifespan_crt_interval_error M hM W N
  simp only [Fintype.prod_sum_type, Fintype.prod_unique] at he
  change |(∑ n ∈ range N, F (n : ZMod q) * ∏ i : s, X i (n : ZMod (m i))) -
      ((N : ℝ) / ((q * ∏ i : s, m i) : ℕ)) *
        ((∑ r : ZMod q, F r) * ∏ i : s, ∑ r, X i r)| ≤
      2 * ((∑ r : ZMod q, |F r|) * ∏ i : s, ∑ r, |X i r|) at he
  have hp : ∀ n : ℕ, (∏ i : s, X i (n : ZMod (m i))) =
      ∏ i ∈ s, X i (n : ZMod (m i)) := fun n =>
    prod_coe_sort s (fun i => X i (n : ZMod (m i)))
  simp_rw [hp] at he
  rw [prod_coe_sort s m, prod_coe_sort s (fun i => ∑ r, X i r),
    prod_coe_sort s (fun i => ∑ r, |X i r|)] at he
  have hmain : ((N : ℝ) / ((q * ∏ i ∈ s, m i) : ℕ)) *
        ((∑ r : ZMod q, F r) * ∏ i ∈ s, ∑ r, X i r) =
      ((N : ℝ) / q) * (∑ r : ZMod q, F r) * ∏ i ∈ s, exclusionLocalMean m X i := by
    simp only [exclusionLocalMean, prod_div_distrib, Nat.cast_mul, prod_natCast]
    ring
  rw [hmain] at he
  simpa only [exclusionLocalMass, mul_assoc] using he

/- The normalized finite averaging weight associated to a fixed active
residue. It has mass approximately one, with the boundary error retained. -/
noncomputable def activeCongruenceWeight (q N : ℕ) (r : ZMod q) (n : ℕ) : ℝ :=
  (q : ℝ) / N * (if (n : ZMod q) = r then 1 else 0)

theorem active_congruence_weight_nonneg (q N : ℕ) (r : ZMod q) (n : ℕ) :
    0 ≤ activeCongruenceWeight q N r n := by
  unfold activeCongruenceWeight
  positivity

section

variable
  {ι : Type*}
  [sharedInstance1 : DecidableEq ι]
  (q : ℕ)
  [sharedInstance3 : NeZero q]
  (m : ι → ℕ)
  [sharedInstance5 : ∀ i, NeZero (m i)]
  (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
  (hqm : ∀ i, Nat.Coprime q (m i))
  (r : ZMod q)
  (X : ∀ i, ZMod (m i) → ℝ)
  (s : Finset ι)

include ι sharedInstance1 q sharedInstance3 m sharedInstance5 hc hqm r X s

/- A fixed active congruence multiplies the monomial boundary error by
`q`, and changes none of the model means at the coprime inactive moduli. -/
theorem conditioned_crt_monomial  {N : ℕ} (hN : 0 < N) :
    |(∑ n ∈ range N, activeCongruenceWeight q N r n * ∏ i ∈ s, X i (n : ZMod (m i))) -
      (∏ i ∈ s, exclusionLocalMean m X i)| ≤
      (2 * (q : ℝ) / N) * ∏ i ∈ s, exclusionLocalMass m X i := by
  have hq : (q : ℝ) ≠ 0 := by exact_mod_cast NeZero.ne q
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  have hs : 0 ≤ (q : ℝ) / N := by positivity
  have he := distinguished_crt_error q m hc hqm (fun t => if t = r then 1 else 0) X s N
  simp only [sum_ite_eq', mem_univ, if_true, abs_ite, abs_one, abs_zero, mul_one] at he
  have halg : (∑ n ∈ range N, activeCongruenceWeight q N r n * ∏ i ∈ s, X i (n : ZMod (m i))) -
      (∏ i ∈ s, exclusionLocalMean m X i) =
      ((q : ℝ) / N) *
        ((∑ n ∈ range N, (if (n : ZMod q) = r then 1 else 0) * ∏ i ∈ s, X i (n : ZMod (m i))) -
          ((N : ℝ) / q) * ∏ i ∈ s, exclusionLocalMean m X i) := by
    simp only [activeCongruenceWeight, mul_assoc, ← mul_sum]
    field_simp
  rw [halg, abs_mul, abs_of_nonneg hs]
  calc
    _ ≤ ((q : ℝ) / N) * (2 * ∏ i ∈ s, exclusionLocalMass m X i) :=
      mul_le_mul_of_nonneg_left he hs
    _ = _ := by ring

/- The elementary-moment comparison retains the same active-modulus cost
at every degree, including degree zero. -/
theorem conditioned_crt_moment  {N : ℕ} (hN : 0 < N) (k : ℕ) :
    |(∑ n ∈ range N, activeCongruenceWeight q N r n *
        exclusionElementary s (fun i => X i (n : ZMod (m i))) k) -
      exclusionElementary s (exclusionLocalMean m X) k| ≤
      (2 * (q : ℝ) / N) * exclusionElementary s (exclusionLocalMass m X) k := by
  have he : (∑ n ∈ range N, activeCongruenceWeight q N r n *
        exclusionElementary s (fun i => X i (n : ZMod (m i))) k) -
      exclusionElementary s (exclusionLocalMean m X) k =
      ∑ t ∈ s.powersetCard k,
        ((∑ n ∈ range N, activeCongruenceWeight q N r n * ∏ i ∈ t, X i (n : ZMod (m i))) -
          ∏ i ∈ t, exclusionLocalMean m X i) := by
    simp only [exclusionElementary, mul_sum]
    rw [sum_comm, ← sum_sub_distrib]
  rw [he]
  calc
    _ ≤ ∑ t ∈ s.powersetCard k,
        |(∑ n ∈ range N, activeCongruenceWeight q N r n * ∏ i ∈ t, X i (n : ZMod (m i))) -
          ∏ i ∈ t, exclusionLocalMean m X i| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ t ∈ s.powersetCard k,
        (2 * (q : ℝ) / N) * ∏ i ∈ t, exclusionLocalMass m X i := by
      exact sum_le_sum (fun t ht => conditioned_crt_monomial q m hc hqm r X t hN)
    _ = _ := by rw [← mul_sum]; rfl

/- Finite residue replacement conditioned on the active congruence. The
error uses only low-degree masses at the inactive moduli. -/
theorem conditioned_crt_product_error 
    (hX : ∀ i ∈ s, ∀ t, 0 ≤ X i t ∧ X i t ≤ 1) {N : ℕ} (hN : 0 < N) (k : ℕ) :
    |(∑ n ∈ range N, activeCongruenceWeight q N r n *
        ∏ i ∈ s, (1 - X i (n : ZMod (m i)))) -
      (∏ i ∈ s, (1 - exclusionLocalMean m X i))| ≤
      2 * ((∑ i ∈ s, exclusionLocalMean m X i)^k / (k.factorial : ℝ)) +
        (2 * (q : ℝ) / N) * ∑ j ∈ range (k + 1), exclusionElementary s (exclusionLocalMass m X) j := by
  have he := exclusion_moment_transfer_factorial s (range N) (activeCongruenceWeight q N r)
    (fun n i => X i (n : ZMod (m i))) (exclusionLocalMean m X)
    (fun j => (2 * (q : ℝ) / N) * exclusionElementary s (exclusionLocalMass m X) j)
    (fun n hn => active_congruence_weight_nonneg q N r n)
    (fun n hn i hi => hX i hi _) (fun i hi => exclusion_local_mean_unit m X i (hX i hi)) k
    (fun j hj => conditioned_crt_moment q m hc hqm r X s hN j)
  rwa [← mul_sum] at he

/- Relative residue replacement with a fixed active congruence. The
independent survival probability is bounded below before division. -/
theorem conditioned_crt_relative_error 
    (hX : ∀ i ∈ s, ∀ t, 0 ≤ X i t ∧ X i t ≤ 1)
    (hsmall : ∀ i ∈ s, exclusionLocalMean m X i ≤ 1 / 2)
    {N : ℕ} (hN : 0 < N) (k : ℕ) :
    |(∑ n ∈ range N, activeCongruenceWeight q N r n *
        ∏ i ∈ s, (1 - X i (n : ZMod (m i)))) /
        (∏ i ∈ s, (1 - exclusionLocalMean m X i)) - 1| ≤
      Real.exp (2 * ∑ i ∈ s, exclusionLocalMean m X i) *
        (2 * ((∑ i ∈ s, exclusionLocalMean m X i)^k / (k.factorial : ℝ)) +
          (2 * (q : ℝ) / N) * ∑ j ∈ range (k + 1), exclusionElementary s (exclusionLocalMass m X) j) := by
  apply exclusion_relative_error s (exclusionLocalMean m X)
    (fun i hi => ⟨(exclusion_local_mean_unit m X i (hX i hi)).1, hsmall i hi⟩)
  exact conditioned_crt_product_error q m hc hqm r X s hX hN k

end

end

section
open Finset
/- A factorial tail bound sufficient for an arbitrary prescribed
exponential precision, using only a linear choice of degree. -/
theorem exclusion_factorial_exp_bound {ℓ : ℝ} (hℓ : 0 ≤ ℓ) (k : ℕ) :
    ℓ^k / (k.factorial : ℝ) ≤ Real.exp (3 * ℓ - k) := by
  rw [Real.exp_sub]
  apply (le_div_iff₀ (Real.exp_pos _)).2
  have he : (Real.exp 1)^k = Real.exp (k : ℝ) := by
    rw [← Real.exp_nat_mul]
    simp
  calc
    (ℓ^k / (k.factorial : ℝ)) * Real.exp (k : ℝ) =
        (Real.exp 1 * ℓ)^k / (k.factorial : ℝ) := by rw [mul_pow, he]; ring
    _ ≤ Real.exp (Real.exp 1 * ℓ) := Real.pow_div_factorial_le_exp _ (by positivity) k
    _ ≤ Real.exp (3 * ℓ) := Real.exp_le_exp.mpr
      (mul_le_mul_of_nonneg_right Real.exp_one_lt_three.le hℓ)

/- The finite sum of elementary absolute masses has a bound involving
only their total mass and the truncation degree. -/
theorem exclusion_truncated_mass_bound {ι : Type*} (s : Finset ι) (c : ι → ℝ)
    (hc : ∀ i ∈ s, 0 ≤ c i) (k : ℕ) :
    (∑ j ∈ range (k + 1), exclusionElementary s c j) ≤
      (k + 1 : ℕ) * (1 + ∑ i ∈ s, c i)^k := by
  have hsum : 0 ≤ ∑ i ∈ s, c i := sum_nonneg hc
  calc
    _ ≤ ∑ _j ∈ range (k + 1), (1 + ∑ i ∈ s, c i)^k := by
      apply sum_le_sum
      intro j hj
      have hjk : j ≤ k := by have := mem_range.mp hj; omega
      calc
        exclusionElementary s c j ≤ (∑ i ∈ s, c i)^j / (j.factorial : ℝ) :=
          exclusion_elementary_le_pow_div_factorial s c hc j
        _ ≤ (∑ i ∈ s, c i)^j := div_le_self (pow_nonneg hsum j)
          (by exact_mod_cast Nat.factorial_pos j)
        _ ≤ (1 + ∑ i ∈ s, c i)^j := pow_le_pow_left₀ hsum (by linarith) j
        _ ≤ (1 + ∑ i ∈ s, c i)^k := pow_le_pow_right₀ (by linarith) hjk
    _ = _ := by simp

/- The factorial part of the relative error is at most half the requested
precision once the degree exceeds a linear threshold. -/
theorem exclusion_relative_tail_small {ℓ B : ℝ} (hℓ : 0 ≤ ℓ) (k : ℕ)
    (hk : 5 * ℓ + B + Real.log 4 ≤ (k : ℝ)) :
    Real.exp (2 * ℓ) * (2 * (ℓ^k / (k.factorial : ℝ))) ≤ Real.exp (-B) / 2 := by
  calc
    _ ≤ Real.exp (2 * ℓ) * (2 * Real.exp (3 * ℓ - k)) := by
      gcongr
      exact exclusion_factorial_exp_bound hℓ k
    _ = 2 * Real.exp (5 * ℓ - k) := by
      rw [mul_left_comm, ← Real.exp_add]
      congr 2
      ring
    _ ≤ 2 * Real.exp (-B - Real.log 4) := by
      apply mul_le_mul_of_nonneg_left _ (by norm_num)
      exact Real.exp_le_exp.mpr (by linarith)
    _ = _ := by rw [Real.exp_sub, Real.exp_log (by norm_num : (0 : ℝ) < 4)]; ring

/- A direct numerical condition for the arithmetic half of the relative
error. Its logarithm will later be compared with the interval length. -/
theorem exclusion_relative_arithmetic_small {ℓ B C q N T : ℝ}
    (hN : 0 < N) (hq : 0 ≤ q) (k : ℕ)
    (hT : T ≤ (k + 1 : ℕ) * (1 + C)^k)
    (hsize : 4 * q * (k + 1 : ℕ) * Real.exp (B + 2 * ℓ) * (1 + C)^k ≤ N) :
    Real.exp (2 * ℓ) * ((2 * q / N) * T) ≤ Real.exp (-B) / 2 := by
  have hexp : Real.exp (B + 2 * ℓ) * Real.exp (-B) = Real.exp (2 * ℓ) := by
    rw [← Real.exp_add]
    congr 1
    ring
  calc
    _ ≤ Real.exp (2 * ℓ) * ((2 * q / N) * ((k + 1 : ℕ) * (1 + C)^k)) := by
      exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hT (by positivity)) (by positivity)
    _ = ((4 * q * (k + 1 : ℕ) * Real.exp (B + 2 * ℓ) * (1 + C)^k) / N) *
        (Real.exp (-B) / 2) := by
      rw [show (4 * q * (k + 1 : ℕ) * Real.exp (B + 2 * ℓ) * (1 + C)^k / N) *
          (Real.exp (-B) / 2) =
          (2 * q / N) * (k + 1 : ℕ) * (1 + C)^k *
            (Real.exp (B + 2 * ℓ) * Real.exp (-B)) by ring, hexp]
      ring
    _ ≤ 1 * (Real.exp (-B) / 2) :=
      mul_le_mul_of_nonneg_right ((div_le_one hN).2 hsize) (by positivity)
    _ = _ := one_mul _

/- Finite numerical assumptions that ensure exponentially small relative
error after both the Bonferroni and CRT contributions are included. -/
theorem residue_replacement_error_small {ℓ B C q N T : ℝ}
    (hℓ : 0 ≤ ℓ) (hN : 0 < N) (hq : 0 ≤ q) (k : ℕ)
    (hk : 5 * ℓ + B + Real.log 4 ≤ (k : ℝ))
    (hT : T ≤ (k + 1 : ℕ) * (1 + C)^k)
    (hsize : 4 * q * (k + 1 : ℕ) * Real.exp (B + 2 * ℓ) * (1 + C)^k ≤ N) :
    Real.exp (2 * ℓ) * (2 * (ℓ^k / (k.factorial : ℝ)) + (2 * q / N) * T) ≤
      Real.exp (-B) := by
  rw [mul_add]
  have htail := exclusion_relative_tail_small hℓ k hk
  have harith := exclusion_relative_arithmetic_small hN hq k hT hsize
  linarith

/- An additive logarithmic budget suffices for the interval-size condition. -/
theorem residue_size_condition_of_log {ℓ B C q N : ℝ}
    (hC : 0 ≤ C) (hq : 0 < q) (hN : 0 < N) (k : ℕ)
    (hlog : Real.log 4 + Real.log q + Real.log (k + 1 : ℕ) + B + 2 * ℓ +
      (k : ℝ) * Real.log (1 + C) ≤ Real.log N) :
    4 * q * (k + 1 : ℕ) * Real.exp (B + 2 * ℓ) * (1 + C)^k ≤ N := by
  apply (Real.log_le_log_iff (by positivity) hN).mp
  have he : Real.log (4 * q * (k + 1 : ℕ) * Real.exp (B + 2 * ℓ) * (1 + C)^k) =
      Real.log 4 + Real.log q + Real.log (k + 1 : ℕ) + B + 2 * ℓ +
        (k : ℝ) * Real.log (1 + C) := by
    rw [Real.log_mul (by positivity) (by positivity),
      Real.log_mul (by positivity) (by positivity),
      Real.log_mul (by positivity) (by positivity),
      Real.log_mul (by norm_num) hq.ne', Real.log_exp, Real.log_pow]
    ring
  rwa [he]

/- An explicit finite criterion for exponentially accurate residue
replacement with the active congruence imposed. -/
theorem conditioned_crt_exponential_error {ι : Type*} [DecidableEq ι]
    (q : ℕ) [NeZero q] (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (hqm : ∀ i, Nat.Coprime q (m i)) (r : ZMod q)
    (X : ∀ i, ZMod (m i) → ℝ) (s : Finset ι)
    (hX : ∀ i ∈ s, ∀ t, 0 ≤ X i t ∧ X i t ≤ 1)
    (hsmall : ∀ i ∈ s, exclusionLocalMean m X i ≤ 1 / 2)
    {N : ℕ} (hN : 0 < N) (k : ℕ) (B : ℝ)
    (hk : 5 * (∑ i ∈ s, exclusionLocalMean m X i) + B + Real.log 4 ≤ (k : ℝ))
    (hsize : 4 * (q : ℝ) * (k + 1 : ℕ) *
      Real.exp (B + 2 * ∑ i ∈ s, exclusionLocalMean m X i) *
        (1 + ∑ i ∈ s, exclusionLocalMass m X i)^k ≤ N) :
    |(∑ n ∈ range N, activeCongruenceWeight q N r n *
        ∏ i ∈ s, (1 - X i (n : ZMod (m i)))) /
        (∏ i ∈ s, (1 - exclusionLocalMean m X i)) - 1| ≤ Real.exp (-B) := by
  refine (conditioned_crt_relative_error q m hc hqm r X s hX hsmall hN k).trans ?_
  exact residue_replacement_error_small
    (sum_nonneg (fun i hi => (exclusion_local_mean_unit m X i (hX i hi)).1))
    (by exact_mod_cast hN) (Nat.cast_nonneg q) k hk
    (exclusion_truncated_mass_bound s (exclusionLocalMass m X)
      (fun i hi => sum_nonneg (fun t ht => abs_nonneg _)) k) hsize
end

section
open Finset
/- Parameterize an integer interval by its nonnegative offsets. -/
theorem integer_interval_sum {A : Type*} [AddCommMonoid A]
    (f : ℤ → A) (z : ℤ) (N : ℕ) :
    (∑ n ∈ range N, f (z + n)) = ∑ n ∈ Ico z (z + N), f n := by
  refine sum_bij (fun n hn => z + (n : ℤ)) ?_ ?_ ?_ ?_
  · intro n hn
    simp only [mem_range] at hn
    simp only [mem_Ico]
    omega
  · intro a ha b hb he
    omega
  · intro n hn
    simp only [mem_Ico] at hn
    refine ⟨(n - z).toNat, ?_, ?_⟩
    · simp only [mem_range]
      omega
    · omega
  · intro n hn
    rfl

section

variable
  {ι : Type*}
  (m : ι → ℕ)
  [sharedInstance2 : ∀ i, NeZero (m i)]
  (X : ∀ i, ZMod (m i) → ℝ)
  (z : ℤ)
  (i : ι)

include ι m sharedInstance2 X z i

/- Translation preserves the uniform local mean. -/
theorem exclusion_local_mean_translate  :
    exclusionLocalMean m (fun j t => X j ((z : ZMod (m j)) + t)) i =
      exclusionLocalMean m X i := by
  unfold exclusionLocalMean
  congr 1
  exact Equiv.sum_comp (Equiv.addLeft (z : ZMod (m i))) (X i)

/- Translation preserves the local absolute mass as well. -/
theorem exclusion_local_mass_translate  :
    exclusionLocalMass m (fun j t => X j ((z : ZMod (m j)) + t)) i =
      exclusionLocalMass m X i := by
  unfold exclusionLocalMass
  exact Equiv.sum_comp (Equiv.addLeft (z : ZMod (m i))) (fun t => |X i t|)

end


/- The same active-residue weight, evaluated at integer positions. -/
noncomputable def activeIntegerCongruenceWeight (q N : ℕ) (r : ZMod q) (n : ℤ) : ℝ :=
  (q : ℝ) / N * (if (n : ZMod q) = r then 1 else 0)

theorem active_congruence_weight_translate (q N : ℕ) (r : ZMod q) (z : ℤ) (n : ℕ) :
    activeCongruenceWeight q N (r - z) n =
      activeIntegerCongruenceWeight q N r (z + n) := by
  simp only [activeCongruenceWeight, activeIntegerCongruenceWeight, Int.cast_add,
    Int.cast_natCast, eq_sub_iff_add_eq, add_comm]

/- Exponentially accurate relative residue replacement on an arbitrary
integer interval, with one fixed active congruence. -/
theorem conditioned_crt_integer_interval {ι : Type*} [DecidableEq ι]
    (q : ℕ) [NeZero q] (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (hqm : ∀ i, Nat.Coprime q (m i)) (r : ZMod q)
    (X : ∀ i, ZMod (m i) → ℝ) (s : Finset ι)
    (hX : ∀ i ∈ s, ∀ t, 0 ≤ X i t ∧ X i t ≤ 1)
    (hsmall : ∀ i ∈ s, exclusionLocalMean m X i ≤ 1 / 2)
    {N : ℕ} (hN : 0 < N) (z : ℤ) (k : ℕ) (B : ℝ)
    (hk : 5 * (∑ i ∈ s, exclusionLocalMean m X i) + B + Real.log 4 ≤ (k : ℝ))
    (hsize : 4 * (q : ℝ) * (k + 1 : ℕ) *
      Real.exp (B + 2 * ∑ i ∈ s, exclusionLocalMean m X i) *
        (1 + ∑ i ∈ s, exclusionLocalMass m X i)^k ≤ N) :
    |(∑ n ∈ Ico z (z + N), activeIntegerCongruenceWeight q N r n *
        ∏ i ∈ s, (1 - X i (n : ZMod (m i)))) /
        (∏ i ∈ s, (1 - exclusionLocalMean m X i)) - 1| ≤ Real.exp (-B) := by
  have hsmall' : ∀ i ∈ s,
      exclusionLocalMean m (fun j t => X j ((z : ZMod (m j)) + t)) i ≤ 1 / 2 := by
    intro i hi
    simpa only [exclusion_local_mean_translate] using hsmall i hi
  have he := conditioned_crt_exponential_error q m hc hqm (r - z)
    (fun j t => X j ((z : ZMod (m j)) + t)) s (fun i hi t => hX i hi _) hsmall' hN k B
    (by simpa only [exclusion_local_mean_translate] using hk)
    (by simpa only [exclusion_local_mean_translate, exclusion_local_mass_translate] using hsize)
  simp_rw [exclusion_local_mean_translate, active_congruence_weight_translate] at he
  rw [← integer_interval_sum]
  simpa only [Int.cast_add, Int.cast_natCast] using he

/- Multiplying both the finite average and its model by a deterministic
nonnegative damping factor preserves a relative-error estimate, including
the case where that damping factor is zero. -/
theorem restore_deterministic_damping {A P D E : ℝ} (hP : 0 < P) (hD : 0 ≤ D)
    (hE : |A / P - 1| ≤ E) : |D * A - D * P| ≤ E * (D * P) := by
  have he : |A / P - 1| * P = |A - P| := by
    calc
      _ = |(A / P - 1) * P| := by rw [abs_mul, abs_of_pos hP]
      _ = _ := by congr 1; field_simp
  have hb := mul_le_mul_of_nonneg_right hE hP.le
  rw [he] at hb
  calc
    _ = D * |A - P| := by rw [← mul_sub, abs_mul, abs_of_nonneg hD]
    _ ≤ D * (E * P) := mul_le_mul_of_nonneg_left hb hD
    _ = _ := by ring
end

section
open Finset
/- Congruence at each coprime factor is equivalent to congruence at their
product, for arbitrary integer positions. -/
theorem integer_congruences_product_iff {ι : Type*} (m : ι → ℕ) (s : Finset ι)
    (hc : (s : Set ι).Pairwise (fun i j => Nat.Coprime (m i) (m j))) (n c : ℤ) :
    (∀ i ∈ s, (n : ZMod (m i)) = (c : ZMod (m i))) ↔
      (n : ZMod (∏ i ∈ s, m i)) = (c : ZMod (∏ i ∈ s, m i)) := by
  simp only [ZMod.intCast_eq_intCast_iff_dvd_sub]
  rw [prod_natCast]
  constructor
  · intro h
    exact prod_dvd_of_coprime (fun i hi j hj hij => (hc hi hj hij).isCoprime) h
  · intro h i hi
    exact (dvd_prod_of_mem (fun j => (m j : ℤ)) hi).trans h

/- Arbitrary prescribed residues at pairwise coprime positive moduli have
a common integer representative, unique modulo the product. -/
theorem active_congruences_representative {ι : Type*}
    (m : ι → ℕ) [∀ i, NeZero (m i)] (s : Finset ι)
    (hc : (s : Set ι).Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (r : ∀ i, ZMod (m i)) :
    ∃ c : ℤ, ∀ n : ℤ, (∀ i ∈ s, (n : ZMod (m i)) = r i) ↔
      (n : ZMod (∏ i ∈ s, m i)) = (c : ZMod (∏ i ∈ s, m i)) := by
  have hm : ∀ i ∈ s, m i ≠ 0 := fun i hi => NeZero.ne (m i)
  let c := Nat.chineseRemainderOfFinset (fun i => (r i).val) m s hm hc
  have hr : ∀ i ∈ s, ((c.val : ℤ) : ZMod (m i)) = r i := by
    intro i hi
    rw [Int.cast_natCast]
    have he : (c.val : ZMod (m i)) = ((r i).val : ZMod (m i)) :=
      (ZMod.natCast_eq_natCast_iff _ _ _).2 (c.property i hi)
    exact he.trans (ZMod.natCast_zmod_val (r i))
  refine ⟨c.val, ?_⟩
  intro n
  rw [← integer_congruences_product_iff m s hc n c.val]
  constructor
  · intro h i hi
    exact (h i hi).trans (hr i hi).symm
  · intro h i hi
    exact (h i hi).trans (hr i hi)

/- The product of active-hit indicators is exactly one indicator at the
active product modulus, so it incurs only one density factor. -/
theorem active_indicator_product {ι : Type*} [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)] (s : Finset ι)
    (hc : (s : Set ι).Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (r : ∀ i, ZMod (m i)) :
    ∃ c : ℤ, ∀ n : ℤ,
      (∏ i ∈ s, (if (n : ZMod (m i)) = r i then (1 : ℝ) else 0)) =
        if (n : ZMod (∏ i ∈ s, m i)) = (c : ZMod (∏ i ∈ s, m i)) then 1 else 0 := by
  obtain ⟨c, hc⟩ := active_congruences_representative m s hc r
  refine ⟨c, ?_⟩
  intro n
  rw [prod_boole]
  simp only [hc n]

/- A nonnegative deterministic damping factor can be restored without
weakening the relative finite-interval estimate. -/
theorem conditioned_crt_damped_interval {ι : Type*} [DecidableEq ι]
    (q : ℕ) [NeZero q] (m : ι → ℕ) [∀ i, NeZero (m i)]
    (hc : Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (hqm : ∀ i, Nat.Coprime q (m i)) (r : ZMod q)
    (X : ∀ i, ZMod (m i) → ℝ) (s : Finset ι)
    (hX : ∀ i ∈ s, ∀ t, 0 ≤ X i t ∧ X i t ≤ 1)
    (hsmall : ∀ i ∈ s, exclusionLocalMean m X i ≤ 1 / 2)
    {N : ℕ} (hN : 0 < N) (z : ℤ) (k : ℕ) (B D : ℝ) (hD : 0 ≤ D)
    (hk : 5 * (∑ i ∈ s, exclusionLocalMean m X i) + B + Real.log 4 ≤ (k : ℝ))
    (hsize : 4 * (q : ℝ) * (k + 1 : ℕ) *
      Real.exp (B + 2 * ∑ i ∈ s, exclusionLocalMean m X i) *
        (1 + ∑ i ∈ s, exclusionLocalMass m X i)^k ≤ N) :
    |(D / (N : ℝ)) * (∑ n ∈ Ico z (z + N),
        (if (n : ZMod q) = r then 1 else 0) * ∏ i ∈ s, (1 - X i (n : ZMod (m i)))) -
      (D / (q : ℝ)) * (∏ i ∈ s, (1 - exclusionLocalMean m X i))| ≤
      Real.exp (-B) * ((D / (q : ℝ)) * ∏ i ∈ s, (1 - exclusionLocalMean m X i)) := by
  have he := conditioned_crt_integer_interval q m hc hqm r X s hX hsmall hN z k B hk hsize
  have hP : 0 < ∏ i ∈ s, (1 - exclusionLocalMean m X i) := by
    apply prod_pos
    intro i hi
    linarith [hsmall i hi]
  have hb := restore_deterministic_damping hP (show 0 ≤ D / (q : ℝ) by positivity) he
  have hq : (q : ℝ) ≠ 0 := by exact_mod_cast NeZero.ne q
  have hmean : (D / (q : ℝ)) *
      (∑ n ∈ Ico z (z + N), activeIntegerCongruenceWeight q N r n *
        ∏ i ∈ s, (1 - X i (n : ZMod (m i)))) =
      (D / (N : ℝ)) * (∑ n ∈ Ico z (z + N), (if (n : ZMod q) = r then 1 else 0) *
        ∏ i ∈ s, (1 - X i (n : ZMod (m i)))) := by
    simp only [activeIntegerCongruenceWeight, mul_assoc, ← mul_sum]
    field_simp
  rwa [hmean] at hb
end

section
open Finset
/- The inactive damping of a prime whose residue was fixed by an active visit. -/
noncomputable def activeVisitDamping {R : Type*} [DecidableEq R]
    (visits active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ) (a : ℕ) : ℝ :=
  ∏ i ∈ visits \ active, (1 - η i * (if h i = h a then 1 else 0))

/- Incompatible active visits vanish pointwise, before any averaging. -/
theorem active_residue_weight_incompatible {R : Type*} [DecidableEq R]
    (visits active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ)
    {a z : ℕ} (ha : a ∈ active) (hz : z ∈ active) (haz : h a ≠ h z) (r : R) :
    activeResidueWeight visits active h η r = 0 := by
  have hn : ¬ ∀ i ∈ active, r = h i := by
    intro hh
    exact haz ((hh a ha).symm.trans (hh z hz))
  simp [activeResidueWeight, prod_boole, hn]

/- Compatible active visits fix one residue; all their inactive damping
can then be evaluated at that residue and factored out. -/
theorem active_residue_weight_factor {R : Type*} [DecidableEq R]
    (visits active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ)
    (a : ℕ) (ha : a ∈ active) (hc : ∀ i ∈ active, h i = h a) (r : R) :
    activeResidueWeight visits active h η r =
      (if r = h a then 1 else 0) * activeVisitDamping visits active h η a := by
  classical
  by_cases hr : r = h a
  · subst r
    have he : ∀ i ∈ active, h a = h i := fun i hi => (hc i hi).symm
    have hp : (∏ i ∈ active, (if h a = h i then (1 : ℝ) else 0)) = 1 := by
      apply prod_eq_one
      intro i hi
      simp only [if_pos (he i hi)]
    unfold activeResidueWeight activeVisitDamping
    rw [hp]
    simp only [ite_true, one_mul]
    apply prod_congr rfl
    intro i hi
    simp only [eq_comm]
  · have he : ¬ ∀ i ∈ active, r = h i := fun hh => hr (hh a ha)
    simp [activeResidueWeight, prod_boole, he, hr]

/- The factored damping is nonnegative for unit-interval visit weights. -/
theorem active_visit_damping_nonneg {R : Type*} [DecidableEq R]
    (visits active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ) (a : ℕ)
    (hη : ∀ i ∈ visits, 0 ≤ η i ∧ η i ≤ 1) :
    0 ≤ activeVisitDamping visits active h η a := by
  apply prod_nonneg
  intro i hi
  have hηi := hη i (mem_sdiff.mp hi).1
  by_cases hh : h i = h a
  · simp only [hh, if_true, mul_one]
    linarith
  · simp [hh]

/- A family of compatible active primes contributes exactly one combined
congruence, times the product of its deterministic inactive damping. -/
theorem active_path_residue_factorization {ι : Type*} [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)] (S : Finset ι) (visits : Finset ℕ)
    (active : ι → Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ) (a : ι → ℕ)
    (hm : (S : Set ι).Pairwise (fun i j => Nat.Coprime (m i) (m j)))
    (ha : ∀ i ∈ S, a i ∈ active i)
    (hc : ∀ i ∈ S, ∀ j ∈ active i, h i j = h i (a i)) :
    ∃ c : ℤ, ∀ n : ℤ,
      (∏ i ∈ S, activeResidueWeight visits (active i) (h i) η (n : ZMod (m i))) =
        (if (n : ZMod (∏ i ∈ S, m i)) = (c : ZMod (∏ i ∈ S, m i)) then 1 else 0) *
          ∏ i ∈ S, activeVisitDamping visits (active i) (h i) η (a i) := by
  obtain ⟨c, hroot⟩ := active_indicator_product m S hm (fun i => h i (a i))
  refine ⟨c, ?_⟩
  intro n
  calc
    _ = ∏ i ∈ S, (if (n : ZMod (m i)) = h i (a i) then 1 else 0) *
        activeVisitDamping visits (active i) (h i) η (a i) := by
      apply prod_congr rfl
      intro i hi
      exact active_residue_weight_factor visits (active i) (h i) η (a i) (ha i hi) (hc i hi) _
    _ = _ := by rw [prod_mul_distrib, hroot n]

/- A single incompatible active prime makes the full active-family
contribution vanish at every integer position. -/
theorem active_path_residue_incompatible {ι : Type*} [DecidableEq ι]
    (m : ι → ℕ) (S : Finset ι) (visits : Finset ℕ)
    (active : ι → Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ)
    {i : ι} (hi : i ∈ S) {a z : ℕ} (ha : a ∈ active i) (hz : z ∈ active i)
    (haz : h i a ≠ h i z) (n : ℤ) :
    (∏ j ∈ S, activeResidueWeight visits (active j) (h j) η (n : ZMod (m j))) = 0 := by
  apply prod_eq_zero hi
  exact active_residue_weight_incompatible visits (active i) (h i) η ha hz haz _
end

section

/- Reservoir indices whose group labels lie in the selected subgroup. -/
noncomputable def subgroupReservoir {G ι : Type*} [Group G]
    (S : Finset ι) (g : ι → G) (H : Subgroup G) : Finset ι := by
  classical
  exact S.filter fun i => g i ∈ H

theorem subgroupReservoir_top {G ι : Type*} [Group G]
    (S : Finset ι) (g : ι → G) : subgroupReservoir S g ⊤ = S := by
  classical
  simp [subgroupReservoir]

/- A proper subgroup of a finite group has at most half its order. -/
theorem subgroup_card_twice_le {G : Type*} [Group G] [Finite G]
    {K H : Subgroup G} (hKH : K < H) : 2 * Nat.card K ≤ Nat.card H := by
  have hKpos : 0 < Nat.card K := Nat.card_pos
  have hlt : Nat.card K < Nat.card H := by
    by_contra h
    exact hKH.ne (Subgroup.eq_of_le_of_card_ge hKH.le (by omega))
  obtain ⟨d, hd⟩ := Subgroup.card_dvd_of_le hKH.le
  have hd2 : 2 ≤ d := by nlinarith
  nlinarith

/- Logarithmic subgroup complexity drops by at least one at a proper inclusion. -/
theorem subgroup_log_card_step {G : Type*} [Group G] [Finite G]
    {K H : Subgroup G} (hKH : K < H) :
    Nat.log 2 (Nat.card K) + 1 ≤ Nat.log 2 (Nat.card H) := by
  have h := Nat.log_mono_right (b := 2) (subgroup_card_twice_le hKH)
  rw [Nat.mul_comm 2 (Nat.card K), Nat.log_mul_base (by decide) Nat.card_pos.ne'] at h
  exact h

/- There is a subgroup retaining all but `M * log₂ |G|` reservoir indices,
while every proper subgroup of it loses at least `M` further indices.
The argument works for any finite group, without commutativity. -/
theorem exists_pruned_subgroup {G ι : Type*} [Group G] [Finite G]
    (S : Finset ι) (g : ι → G) {M : ℝ} (hM : 0 ≤ M) :
    ∃ H : Subgroup G,
      (S.card : ℝ) - ((subgroupReservoir S g H).card : ℝ) ≤
        M * Nat.log 2 (Nat.card G) ∧
      ∀ K : Subgroup G, K < H →
        M ≤ ((subgroupReservoir S g H).card : ℝ) -
          ((subgroupReservoir S g K).card : ℝ) := by
  classical
  let := Fintype.ofFinite (Subgroup G)
  let potential : Subgroup G → ℝ := fun H =>
    ((subgroupReservoir S g H).card : ℝ) - M * Nat.log 2 (Nat.card H)
  obtain ⟨H, _, hmax⟩ := Finset.exists_max_image
    (Finset.univ : Finset (Subgroup G)) potential Finset.univ_nonempty
  have hmax' : ∀ K : Subgroup G, potential K ≤ potential H :=
    fun K => hmax K (Finset.mem_univ K)
  refine ⟨H, ?_, ?_⟩
  · have htop := hmax' ⊤
    simp only [potential, subgroupReservoir_top, Subgroup.card_top] at htop
    have hpenalty : 0 ≤ M * (Nat.log 2 (Nat.card H) : ℝ) :=
      mul_nonneg hM (Nat.cast_nonneg _)
    linarith
  · intro K hKH
    have hK := hmax' K
    have hlog : (Nat.log 2 (Nat.card K) : ℝ) + 1 ≤ Nat.log 2 (Nat.card H) := by
      exact_mod_cast subgroup_log_card_step hKH
    have hmul := mul_le_mul_of_nonneg_left hlog hM
    dsimp [potential] at hK
    nlinarith

/- A proper subgroup of `H` remains proper when regarded in the ambient group. -/
theorem map_subtype_lt_of_ne_top {G : Type*} [Group G] (H : Subgroup G)
    (K : Subgroup H) (hK : K ≠ ⊤) : K.map H.subtype < H := by
  have h : K.map H.subtype < (⊤ : Subgroup H).map H.subtype :=
    Subgroup.map_subtype_lt_map_subtype.mpr (lt_top_iff_ne_top.mpr hK)
  simpa only [← MonoidHom.range_eq_map, Subgroup.range_subtype] using h

section

variable
  {G ι : Type*}
  [sharedInstance1 : Group G]
  [sharedInstance2 : Finite G]
  (S : Finset ι)
  (g : ι → G)
  {M : ℝ}
  (hM : 0 ≤ M)

include G ι sharedInstance1 sharedInstance2 S g M hM

/- Pruning expressed directly for every proper subgroup of the retained group. -/
theorem exists_pruned_subgroup_internal  :
    ∃ H : Subgroup G,
      (S.card : ℝ) - ((subgroupReservoir S g H).card : ℝ) ≤
        M * Nat.log 2 (Nat.card G) ∧
      ∀ K : Subgroup H, K ≠ ⊤ →
        M ≤ ((subgroupReservoir S g H).card : ℝ) -
          ((subgroupReservoir S g (K.map H.subtype)).card : ℝ) := by
  obtain ⟨H, hloss, hstable⟩ := exists_pruned_subgroup S g hM
  refine ⟨H, hloss, ?_⟩
  intro K hK
  exact hstable _ (map_subtype_lt_of_ne_top H K hK)

/- If the pruning budget is at most half the reservoir, at least half survives. -/
theorem exists_pruned_subgroup_half 
    (hbudget : M * Nat.log 2 (Nat.card G) ≤ (S.card : ℝ) / 2) :
    ∃ H : Subgroup G,
      (S.card : ℝ) / 2 ≤ ((subgroupReservoir S g H).card : ℝ) ∧
      ∀ K : Subgroup H, K ≠ ⊤ →
        M ≤ ((subgroupReservoir S g H).card : ℝ) -
          ((subgroupReservoir S g (K.map H.subtype)).card : ℝ) := by
  obtain ⟨H, hloss, hstable⟩ := exists_pruned_subgroup_internal S g hM
  exact ⟨H, by linarith, hstable⟩

/- In particular every nontrivial multiplicative character of the retained
subgroup has at least `M` indices outside its kernel. -/
theorem exists_character_pruned_subgroup 
    (hbudget : M * Nat.log 2 (Nat.card G) ≤ (S.card : ℝ) / 2) :
    ∃ H : Subgroup G,
      (S.card : ℝ) / 2 ≤ ((subgroupReservoir S g H).card : ℝ) ∧
      ∀ χ : H →* ℂ, χ ≠ 1 →
        M ≤ ((subgroupReservoir S g H).card : ℝ) -
          ((subgroupReservoir S g (χ.ker.map H.subtype)).card : ℝ) := by
  obtain ⟨H, hhalf, hstable⟩ := exists_pruned_subgroup_half S g hM hbudget
  refine ⟨H, hhalf, ?_⟩
  intro χ hχ
  exact hstable χ.ker (fun h => hχ (MonoidHom.ker_eq_top_iff.mp h))

end

end

section

open scoped BigOperators

/- Powers of a unit complex number move at most linearly far from one. -/
theorem norm_pow_sub_one_le {z : ℂ} (hz : ‖z‖ = 1) (j : ℕ) :
    ‖z ^ j - 1‖ ≤ (j : ℝ) * ‖z - 1‖ := by
  induction j with
  | zero => simp
  | succ j ih =>
    have he : z ^ (j + 1) - 1 = z * (z ^ j - 1) + (z - 1) := by ring
    rw [he]
    calc
      ‖z * (z ^ j - 1) + (z - 1)‖ ≤ ‖z * (z ^ j - 1)‖ + ‖z - 1‖ := norm_add_le _ _
      _ = ‖z ^ j - 1‖ + ‖z - 1‖ := by rw [norm_mul, hz, one_mul]
      _ ≤ (j : ℝ) * ‖z - 1‖ + ‖z - 1‖ := by linarith
      _ = (↑(j + 1) : ℝ) * ‖z - 1‖ := by push_cast; ring

/- A nontrivial `m`th root of unity is at least `2/m` away from one. -/
theorem root_unity_norm_sub_one_lower {z : ℂ} {m : ℕ} (hm : 0 < m)
    (hpow : z ^ m = 1) (hz1 : z ≠ 1) :
    2 / (m : ℝ) ≤ ‖z - 1‖ := by
  have hnorm : ‖z‖ = 1 :=
    (isOfFinOrder_iff_pow_eq_one.mpr ⟨m, hm, hpow⟩).norm_eq_one
  have hgeom : (∑ j ∈ Finset.range m, z ^ j) = 0 := by
    rw [geom_sum_eq hz1, hpow, sub_self, zero_div]
  have hsum : (m : ℝ) ≤ (∑ j ∈ Finset.range m, (j : ℝ)) * ‖z - 1‖ := by
    calc
      (m : ℝ) = ‖∑ j ∈ Finset.range m, (z ^ j - 1)‖ := by
        rw [Finset.sum_sub_distrib, hgeom]
        simp
      _ ≤ ∑ j ∈ Finset.range m, ‖z ^ j - 1‖ := norm_sum_le _ _
      _ ≤ ∑ j ∈ Finset.range m, (j : ℝ) * ‖z - 1‖ := by
        exact Finset.sum_le_sum (fun j _ => norm_pow_sub_one_le hnorm j)
      _ = _ := (Finset.sum_mul _ _ _).symm
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  have hsumtwice : (∑ j ∈ Finset.range m, (j : ℝ)) * 2 = (m : ℝ) * (m - 1 : ℝ) := by
    have h := congrArg (fun n : ℕ => (n : ℝ)) (Finset.sum_range_id_mul_two m)
    have hm1 : 1 ≤ m := hm
    simpa only [Nat.cast_mul, Nat.cast_ofNat, Nat.cast_sum, Nat.cast_sub hm1,
      Nat.cast_one] using h
  have htwice : (m : ℝ) * 2 ≤ (m : ℝ) * ((m - 1 : ℝ) * ‖z - 1‖) := by
    calc
      (m : ℝ) * 2 ≤ ((∑ j ∈ Finset.range m, (j : ℝ)) * ‖z - 1‖) * 2 :=
        mul_le_mul_of_nonneg_right hsum (by norm_num)
      _ = ((∑ j ∈ Finset.range m, (j : ℝ)) * 2) * ‖z - 1‖ := by ring
      _ = _ := by rw [hsumtwice]; ring
  have htwo : 2 ≤ (m - 1 : ℝ) * ‖z - 1‖ := (mul_le_mul_iff_right₀ hm').mp htwice
  apply (div_le_iff₀ hm').mpr
  nlinarith [norm_nonneg (z - 1)]

/- A polynomial lower bound on the phase gap of a nontrivial root of unity. -/
theorem root_unity_re_gap {z : ℂ} {m : ℕ} (hm : 0 < m)
    (hpow : z ^ m = 1) (hz1 : z ≠ 1) :
    2 / (m : ℝ) ^ 2 ≤ 1 - z.re := by
  have hnorm : ‖z‖ = 1 :=
    (isOfFinOrder_iff_pow_eq_one.mpr ⟨m, hm, hpow⟩).norm_eq_one
  have hlower := root_unity_norm_sub_one_lower hm hpow hz1
  have hsquare := pow_le_pow_left₀ (by positivity : 0 ≤ 2 / (m : ℝ)) hlower 2
  have he : (2 / (m : ℝ)) ^ 2 = 2 * (2 / (m : ℝ) ^ 2) := by ring
  rw [he, Complex.norm_sub_one_sq_eq_of_norm_eq_one hnorm] at hsquare
  linarith

/- An upper bound on the order gives a common phase-gap bound. -/
theorem root_unity_re_gap_of_order_le {z : ℂ} {m R : ℕ} (hm : 0 < m)
    (hmR : m ≤ R) (hpow : z ^ m = 1) (hz1 : z ≠ 1) :
    2 / (R : ℝ) ^ 2 ≤ 1 - z.re := by
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  have hR' : (0 : ℝ) < R := by exact_mod_cast hm.trans_le hmR
  have hmR' : (m : ℝ) ≤ R := by exact_mod_cast hmR
  apply le_trans _ (root_unity_re_gap hm hpow hz1)
  apply (div_le_div_iff₀ (sq_pos_of_pos hR') (sq_pos_of_pos hm')).mpr
  nlinarith

/- Root-of-unity values contribute a nonnegative phase gap. -/
theorem root_unity_re_gap_nonneg {z : ℂ} {m : ℕ} (hm : 0 < m)
    (hpow : z ^ m = 1) : 0 ≤ 1 - z.re := by
  have hnorm : ‖z‖ = 1 :=
    (isOfFinOrder_iff_pow_eq_one.mpr ⟨m, hm, hpow⟩).norm_eq_one
  have h := Complex.re_le_norm z
  linarith

section

variable
  {ι : Type*}
  (S : Finset ι)
  (z : ι → ℂ)
  {m R : ℕ}
  (hm : 0 < m)
  (hmR : m ≤ R)
  (hpow : ∀ p ∈ S, (z p) ^ m = 1)

include ι S z m R hm hmR hpow

/- The count of separated values gives a total phase-energy lower bound. -/
theorem root_unity_phase_sum_le  :
    (2 / (R : ℝ) ^ 2) * ((S.filter fun p => z p ≠ 1).card : ℝ) ≤
      ∑ p ∈ S, (1 - (z p).re) := by
  classical
  calc
    _ = ∑ _p ∈ S.filter (fun p => z p ≠ 1), (2 / (R : ℝ) ^ 2) := by simp; ring
    _ ≤ ∑ p ∈ S.filter (fun p => z p ≠ 1), (1 - (z p).re) := by
      apply Finset.sum_le_sum
      intro p hp
      obtain ⟨hp, hz1⟩ := Finset.mem_filter.mp hp
      exact root_unity_re_gap_of_order_le hm hmR (hpow p hp) hz1
    _ ≤ ∑ p ∈ S, (1 - (z p).re) := by
      apply Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ S)
      intro p hp _
      exact root_unity_re_gap_nonneg hm (hpow p hp)

/- If at least `M` values are nontrivial, the phase energy is at least `2M/R²`. -/
theorem root_unity_phase_sum_lower  {M : ℝ}
    (hcount : M ≤ ((S.filter fun p => z p ≠ 1).card : ℝ)) :
    2 * M / (R : ℝ) ^ 2 ≤ ∑ p ∈ S, (1 - (z p).re) := by
  calc
    _ = (2 / (R : ℝ) ^ 2) * M := by ring
    _ ≤ (2 / (R : ℝ) ^ 2) * ((S.filter fun p => z p ≠ 1).card : ℝ) :=
      mul_le_mul_of_nonneg_left hcount (by positivity)
    _ ≤ _ := root_unity_phase_sum_le S z hm hmR hpow

end

end

section

open scoped BigOperators

/- The normalized squared geometric sum. -/
noncomputable def fejerPolynomial (R : ℕ) (z : ℂ) : ℝ :=
  ‖∑ j ∈ Finset.range R, z ^ j‖ ^ 2 / R

theorem fejerPolynomial_nonneg (R : ℕ) (z : ℂ) :
    0 ≤ fejerPolynomial R z := by
  exact div_nonneg (sq_nonneg _) (Nat.cast_nonneg _)

/- If all powers in the geometric sum lie in the right half-plane with
real part at least one half, the Fejér polynomial is at least `R / 4`. -/
theorem fejerPolynomial_lower_of_re {R : ℕ} (hR : 0 < R) (z : ℂ)
    (hre : ∀ j ∈ Finset.range R, (1 / 2 : ℝ) ≤ (z ^ j).re) :
    (R : ℝ) / 4 ≤ fejerPolynomial R z := by
  have hR' : (0 : ℝ) < R := by exact_mod_cast hR
  have hsum : (R : ℝ) / 2 ≤ (∑ j ∈ Finset.range R, z ^ j).re := by
    calc
      (R : ℝ) / 2 = ∑ _j ∈ Finset.range R, (1 / 2 : ℝ) := by simp; ring
      _ ≤ ∑ j ∈ Finset.range R, (z ^ j).re := Finset.sum_le_sum hre
      _ = _ := by simp
  have hnorm : (R : ℝ) / 2 ≤ ‖∑ j ∈ Finset.range R, z ^ j‖ :=
    hsum.trans (Complex.re_le_norm _)
  unfold fejerPolynomial
  apply (le_div_iff₀ hR').mpr
  nlinarith [norm_nonneg (∑ j ∈ Finset.range R, z ^ j)]

/- The elementary finite counting estimate behind Fejér concentration. -/
theorem card_filter_le_of_sum_le {ι : Type*} (S : Finset ι) (F : ι → ℝ)
    (hF : ∀ p ∈ S, 0 ≤ F p) {c B : ℝ} (hc : 0 < c)
    (hsum : ∑ p ∈ S, F p ≤ B) :
    ((S.filter fun p => c ≤ F p).card : ℝ) ≤ B / c := by
  classical
  apply (le_div_iff₀ hc).mpr
  calc
    ((S.filter fun p => c ≤ F p).card : ℝ) * c =
        ∑ _p ∈ S.filter (fun p => c ≤ F p), c := by simp
    _ ≤ ∑ p ∈ S.filter (fun p => c ≤ F p), F p := by
      apply Finset.sum_le_sum
      intro p hp
      exact (Finset.mem_filter.mp hp).2
    _ ≤ ∑ p ∈ S, F p := by
      exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ S)
        (fun p hp _ => hF p hp)
    _ ≤ B := hsum

/- Total mass at most `2Q` permits at most `8Q/R` large Fejér values. -/
theorem fejer_large_values_card_le {ι : Type*} (S : Finset ι) (z : ι → ℂ)
    {R : ℕ} (hR : 0 < R) {Q : ℝ}
    (hsum : ∑ p ∈ S, fejerPolynomial R (z p) ≤ 2 * Q) :
    ((S.filter fun p => (R : ℝ) / 4 ≤ fejerPolynomial R (z p)).card : ℝ)
      ≤ 8 * Q / R := by
  classical
  have hR' : (0 : ℝ) < R := by exact_mod_cast hR
  have h := card_filter_le_of_sum_le S (fun p => fejerPolynomial R (z p))
    (fun p _ => fejerPolynomial_nonneg R (z p)) (by positivity : 0 < (R : ℝ) / 4) hsum
  convert h using 1
  field_simp
  ring

/- Shifting a geometric sum exposes its first coefficient. -/
theorem geometric_sum_succ (R : ℕ) (z : ℂ) :
    (∑ j ∈ Finset.range (R + 1), z ^ j) =
      1 + z * ∑ j ∈ Finset.range R, z ^ j := by
  rw [Finset.sum_range_succ']
  simp only [pow_zero, Finset.mul_sum, pow_succ']
  ring

/- The unnormalized Fejér polynomial satisfies this exact recurrence. -/
theorem geometric_norm_sq_succ (R : ℕ) (z : ℂ) (hz : ‖z‖ = 1) :
    ‖∑ j ∈ Finset.range (R + 1), z ^ j‖ ^ 2 =
      ‖∑ j ∈ Finset.range R, z ^ j‖ ^ 2 + 1 +
        2 * ∑ j ∈ Finset.range R, (z ^ (j + 1)).re := by
  rw [geometric_sum_succ, ← Complex.normSq_eq_norm_sq,
    Complex.normSq_add]
  simp only [map_one, one_mul, Complex.conj_re, Complex.normSq_eq_norm_sq,
    norm_mul, hz, one_mul]
  have hsum : (z * ∑ j ∈ Finset.range R, z ^ j).re =
      ∑ j ∈ Finset.range R, (z ^ (j + 1)).re := by
    simp only [Finset.mul_sum, ← pow_succ', Complex.re_sum]
  rw [hsum]
  ring

/- Low-power moment bounds control the total unnormalized Fejér mass. -/
theorem sum_geometric_norm_sq_le {ι : Type*} (S : Finset ι) (z : ι → ℂ)
    (hz : ∀ p ∈ S, ‖z p‖ = 1) (A : ℝ) (R : ℕ)
    (hmoment : ∀ j : ℕ, 1 ≤ j → j < R →
      ∑ p ∈ S, ((z p) ^ j).re ≤ A) :
    ∑ p ∈ S, ‖∑ j ∈ Finset.range R, (z p) ^ j‖ ^ 2 ≤
      (R : ℝ) * S.card + (R : ℝ) * (R - 1 : ℝ) * A := by
  induction R with
  | zero => simp
  | succ R ih =>
    have hprev : ∀ j : ℕ, 1 ≤ j → j < R →
        ∑ p ∈ S, ((z p) ^ j).re ≤ A := by
      intro j hj hjR
      exact hmoment j hj (by omega)
    have hrec : (∑ p ∈ S, ‖∑ j ∈ Finset.range (R + 1), (z p) ^ j‖ ^ 2) =
        (∑ p ∈ S, ‖∑ j ∈ Finset.range R, (z p) ^ j‖ ^ 2) + S.card +
          2 * ∑ j ∈ Finset.range R, ∑ p ∈ S, ((z p) ^ (j + 1)).re := by
      calc
        _ = ∑ p ∈ S, (‖∑ j ∈ Finset.range R, (z p) ^ j‖ ^ 2 + 1 +
              2 * ∑ j ∈ Finset.range R, ((z p) ^ (j + 1)).re) := by
          apply Finset.sum_congr rfl
          intro p hp
          exact geometric_norm_sq_succ R (z p) (hz p hp)
        _ = _ := by
          simp only [Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul,
            mul_one, ← Finset.mul_sum]
          rw [Finset.sum_comm]
    have hm : (∑ j ∈ Finset.range R, ∑ p ∈ S, ((z p) ^ (j + 1)).re) ≤ R * A := by
      calc
        _ ≤ ∑ _j ∈ Finset.range R, A := by
          apply Finset.sum_le_sum
          intro j hj
          exact hmoment (j + 1) (by omega) (by have := Finset.mem_range.mp hj; omega)
        _ = _ := by simp
    rw [hrec]
    have hp := ih hprev
    push_cast
    nlinarith

/- The Fejér total mass follows directly from the real parts of all
nontrivial low-power moments. -/
theorem sum_fejerPolynomial_le {ι : Type*} (S : Finset ι) (z : ι → ℂ)
    (hz : ∀ p ∈ S, ‖z p‖ = 1) (A : ℝ) {R : ℕ} (hR : 0 < R)
    (hmoment : ∀ j : ℕ, 1 ≤ j → j < R →
      ∑ p ∈ S, ((z p) ^ j).re ≤ A) :
    ∑ p ∈ S, fejerPolynomial R (z p) ≤ S.card + (R - 1 : ℝ) * A := by
  have hR' : (0 : ℝ) < R := by exact_mod_cast hR
  simp only [fejerPolynomial, ← Finset.sum_div]
  apply (div_le_iff₀ hR').mpr
  have h := sum_geometric_norm_sq_le S z hz A R hmoment
  nlinarith

/- A norm bound for each ambient power sum suffices for the Fejér estimate. -/
theorem sum_fejerPolynomial_le_of_norm {ι : Type*} (S : Finset ι) (z : ι → ℂ)
    (hz : ∀ p ∈ S, ‖z p‖ = 1) (A : ℝ) {R : ℕ} (hR : 0 < R)
    (hmoment : ∀ j : ℕ, 1 ≤ j → j < R →
      ‖∑ p ∈ S, (z p) ^ j‖ ≤ A) :
    ∑ p ∈ S, fejerPolynomial R (z p) ≤ S.card + (R - 1 : ℝ) * A := by
  apply sum_fejerPolynomial_le S z hz A hR
  intro j hj hjR
  calc
    (∑ p ∈ S, ((z p) ^ j).re) = (∑ p ∈ S, (z p) ^ j).re := by simp
    _ ≤ ‖∑ p ∈ S, (z p) ^ j‖ := Complex.re_le_norm _
    _ ≤ A := hmoment j hj hjR

/- The usual short angular arc forces a large Fejér value. -/
theorem fejerPolynomial_lower_of_abs_angle {R : ℕ} (hR : 0 < R) {θ : ℝ}
    (hθ : |θ| ≤ 1 / (R : ℝ)) :
    (R : ℝ) / 4 ≤ fejerPolynomial R (Complex.exp (θ * Complex.I)) := by
  apply fejerPolynomial_lower_of_re hR
  intro j hj
  have hR' : (0 : ℝ) < R := by exact_mod_cast hR
  have hjR : (j : ℝ) ≤ R := by exact_mod_cast (Finset.mem_range.mp hj).le
  have habs : |(j : ℝ) * θ| ≤ 1 := by
    rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg j)]
    calc
      (j : ℝ) * |θ| ≤ (R : ℝ) * (1 / (R : ℝ)) :=
        mul_le_mul hjR hθ (abs_nonneg _) (by positivity)
      _ = 1 := by field_simp
  have hsq : ((j : ℝ) * θ) ^ 2 ≤ 1 := by
    have := (sq_le_sq₀ (abs_nonneg ((j : ℝ) * θ)) (by norm_num : (0 : ℝ) ≤ 1)).mpr habs
    simpa only [sq_abs, one_pow] using this
  have hcos := Real.one_sub_sq_div_two_le_cos (x := (j : ℝ) * θ)
  rw [← Complex.exp_nat_mul]
  have he : (j : ℂ) * ((θ : ℂ) * Complex.I) = (((j : ℝ) * θ : ℝ) : ℂ) * Complex.I := by
    push_cast
    ring
  rw [he]
  simp only [Complex.exp_re, Complex.mul_re, Complex.ofReal_re, Complex.I_re,
    Complex.ofReal_im, Complex.I_im, mul_zero, sub_self, Real.exp_zero,
    Complex.mul_im, mul_one, add_zero, one_mul]
  nlinarith




/- Unit complex numbers in the principal short arc have large Fejér value. -/
theorem fejerPolynomial_lower_of_abs_arg {R : ℕ} (hR : 0 < R) {z : ℂ}
    (hz : ‖z‖ = 1) (harg : |z.arg| ≤ 1 / (R : ℝ)) :
    (R : ℝ) / 4 ≤ fejerPolynomial R z := by
  have he : Complex.exp (z.arg * Complex.I) = z := by
    simpa only [hz, Complex.ofReal_one, one_mul] using Complex.norm_mul_exp_arg_mul_I z
  rw [← he]
  exact fejerPolynomial_lower_of_abs_angle hR harg

/- The principal short-arc bound for arbitrary unit complex values. -/
theorem short_arg_card_le_of_moments {ι : Type*} (S : Finset ι) (z : ι → ℂ)
    (hz : ∀ p ∈ S, ‖z p‖ = 1) (A : ℝ) {R : ℕ} (hR : 0 < R)
    (hsmall : (R - 1 : ℝ) * A ≤ S.card)
    (hmoment : ∀ j : ℕ, 1 ≤ j → j < R → ‖∑ p ∈ S, (z p) ^ j‖ ≤ A) :
    ((S.filter fun p => |(z p).arg| ≤ 1 / (R : ℝ)).card : ℝ) ≤ 8 * S.card / R := by
  classical
  have hsum := sum_fejerPolynomial_le_of_norm S z hz A hR hmoment
  have hmass : (∑ p ∈ S, fejerPolynomial R (z p)) ≤ 2 * S.card := by linarith
  apply le_trans _ (fejer_large_values_card_le S z hR hmass)
  exact_mod_cast Finset.card_le_card (show
    (S.filter fun p => |(z p).arg| ≤ 1 / (R : ℝ)) ⊆
      S.filter (fun p => (R : ℝ) / 4 ≤ fejerPolynomial R (z p)) from by
    intro p hp
    obtain ⟨hp, harg⟩ := Finset.mem_filter.mp hp
    exact Finset.mem_filter.mpr ⟨hp, fejerPolynomial_lower_of_abs_arg hR (hz p hp) harg⟩)
end

section

/- Away from an arc of radius `1/R`, a unit complex number has definite energy. -/
theorem unit_energy_lower_of_abs_arg {R : ℕ} (hR : 0 < R) {z : ℂ}
    (hz : ‖z‖ = 1) (harg : 1 / (R : ℝ) ≤ |z.arg|) :
    2 / (Real.pi ^ 2 * (R : ℝ) ^ 2) ≤ 1 - z.re := by
  have hR' : (0 : ℝ) < R := by exact_mod_cast hR
  have hcos : Real.cos z.arg = z.re := by
    simpa only [hz, one_mul] using Complex.norm_mul_cos_arg z
  have hc := Real.cos_le_one_sub_mul_cos_sq (Complex.abs_arg_le_pi z)
  rw [hcos] at hc
  have hs : (1 / (R : ℝ)) ^ 2 ≤ z.arg ^ 2 := by
    have h := (sq_le_sq₀ (by positivity : 0 ≤ 1 / (R : ℝ)) (abs_nonneg z.arg)).mpr harg
    simpa only [sq_abs] using h
  calc
    2 / (Real.pi ^ 2 * (R : ℝ) ^ 2) =
        (2 / Real.pi ^ 2) * (1 / (R : ℝ)) ^ 2 := by field_simp
    _ ≤ (2 / Real.pi ^ 2) * z.arg ^ 2 :=
      mul_le_mul_of_nonneg_left hs (by positivity)
    _ ≤ 1 - z.re := by linarith

/- A large retained set and a small ambient short arc force positive character energy. -/
theorem energy_lower_of_short_arc_card {ι : Type*} (S T : Finset ι)
    (hTS : T ⊆ S) (z : ι → ℂ) (hz : ∀ i ∈ T, ‖z i‖ = 1)
    {R : ℕ} (hR : 0 < R) {N : ℝ} (hT : N / 2 ≤ T.card)
    (harc : ((S.filter fun i => |(z i).arg| ≤ 1 / (R : ℝ)).card : ℝ) ≤ N / 8) :
    3 * N / (4 * Real.pi ^ 2 * (R : ℝ) ^ 2) ≤
      ∑ i ∈ T, (1 - (z i).re) := by
  classical
  let arc : ι → Prop := fun i => |(z i).arg| ≤ 1 / (R : ℝ)
  let U := T.filter fun i => ¬ arc i
  have hR' : (0 : ℝ) < R := by exact_mod_cast hR
  have hsmall : ((T.filter arc).card : ℝ) ≤ N / 8 := by
    apply le_trans _ harc
    exact_mod_cast Finset.card_le_card (Finset.filter_subset_filter _ hTS)
  have hsplit : ((T.filter arc).card : ℝ) + (U.card : ℝ) = T.card := by
    exact_mod_cast Finset.card_filter_add_card_filter_not (s := T) arc
  have hU : 3 * N / 8 ≤ (U.card : ℝ) := by linarith
  have hterm : ∀ i ∈ U, 2 / (Real.pi ^ 2 * (R : ℝ) ^ 2) ≤ 1 - (z i).re := by
    intro i hi
    obtain ⟨hiT, hiarc⟩ := Finset.mem_filter.mp hi
    exact unit_energy_lower_of_abs_arg hR (hz i hiT) (le_of_lt (not_le.mp hiarc))
  calc
    3 * N / (4 * Real.pi ^ 2 * (R : ℝ) ^ 2) =
        (3 * N / 8) * (2 / (Real.pi ^ 2 * (R : ℝ) ^ 2)) := by ring
    _ ≤ (U.card : ℝ) * (2 / (Real.pi ^ 2 * (R : ℝ) ^ 2)) :=
      mul_le_mul_of_nonneg_right hU (by positivity)
    _ = ∑ _i ∈ U, 2 / (Real.pi ^ 2 * (R : ℝ) ^ 2) := by simp
    _ ≤ ∑ i ∈ U, (1 - (z i).re) := Finset.sum_le_sum hterm
    _ ≤ ∑ i ∈ T, (1 - (z i).re) := by
      apply Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ T)
      intro i hi _
      have h := Complex.re_le_norm (z i)
      rw [hz i hi] at h
      linarith

/- Ambient low-power character moments force high energy on any retained half-reservoir. -/
theorem energy_lower_of_moments {ι : Type*} (S T : Finset ι) (hTS : T ⊆ S)
    (z : ι → ℂ) (hz : ∀ i ∈ S, ‖z i‖ = 1) (A : ℝ)
    {R : ℕ} (hR : 0 < R) {N : ℝ} (hT : N / 2 ≤ T.card)
    (hRlarge : 64 * (S.card : ℝ) ≤ N * R)
    (hsmall : (R - 1 : ℝ) * A ≤ S.card)
    (hmoment : ∀ j : ℕ, 1 ≤ j → j < R → ‖∑ i ∈ S, (z i) ^ j‖ ≤ A) :
    3 * N / (4 * Real.pi ^ 2 * (R : ℝ) ^ 2) ≤
      ∑ i ∈ T, (1 - (z i).re) := by
  apply energy_lower_of_short_arc_card S T hTS z (fun i hi => hz i (hTS hi)) hR hT
  have hcard := short_arg_card_le_of_moments S z hz A hR hsmall hmoment
  apply hcard.trans
  have hR' : (0 : ℝ) < R := by exact_mod_cast hR
  apply (div_le_iff₀ hR').mpr
  nlinarith
end

