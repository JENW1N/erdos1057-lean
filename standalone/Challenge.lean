section
open Finset
abbrev PhysicalPermutations (G : Type*) (J ell : ℕ) :=
  G → Equiv.Perm (PhysicalSlots J ell)

/- Reorder each group's ordered marks by an independent slot permutation. -/
def physicalPermutationEquiv {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (σ : PhysicalPermutations G J ell) : PhysicalState P J ell ≃ PhysicalState P J ell where
  toFun x := ⟨x.1, ⟨fun g => (σ g).toEmbedding.trans (x.2.val g), fun g s => x.2.property g (σ g s)⟩⟩
  invFun x := ⟨x.1, ⟨fun g => (σ g).symm.toEmbedding.trans (x.2.val g), fun g s => x.2.property g ((σ g).symm s)⟩⟩
  left_inv x := by
    apply physical_state_ext
    · rfl
    · funext g
      apply Function.Embedding.ext
      intro s
      exact congrArg (x.2.val g) ((σ g).apply_symm_apply s)
  right_inv x := by
    apply physical_state_ext
    · rfl
    · funext g
      apply Function.Embedding.ext
      intro s
      exact congrArg (x.2.val g) ((σ g).symm_apply_apply s)

theorem physical_permutation_position {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (σ : PhysicalPermutations G J ell) (x : PhysicalState P J ell) :
    (physicalPermutationEquiv σ x).1 = x.1 := rfl










/- Uniformly average over all independent within-group slot permutations. -/
noncomputable def physicalSymmetrize {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (f : PhysicalState P J ell → ℂ)
    (x : PhysicalState P J ell) : ℂ :=
  (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
    ∑ σ : PhysicalPermutations G J ell, f (physicalPermutationEquiv σ x)









end

section
open Finset
theorem finite_uniform_average_row_bound {A X : Type*} [Fintype A] [Nonempty A]
    (rows : Finset X) (K : A → X → ℂ) {C : ℝ} (hC : 0 ≤ C)
    (hrow : ∀ a, (∑ y ∈ rows, ‖K a y‖) ≤ C) :
    (∑ y ∈ rows, ‖(Fintype.card A : ℂ)⁻¹ * ∑ a, K a y‖) ≤ C := by
  classical
  have hn : (Fintype.card A : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hmass : (∑ _a : A, (Fintype.card A : ℝ)⁻¹) ≤ 1 := by
    simp only [sum_const, card_univ, nsmul_eq_mul, mul_inv_cancel₀ hn, le_refl]
  have hh := auxiliary_complex_row_bound (univ : Finset A) rows
    (fun _ => (Fintype.card A : ℝ)⁻¹) K hC
    (fun _ _ => inv_nonneg.mpr (Nat.cast_nonneg _)) hmass (fun a _ => hrow a)
  simpa only [Complex.ofReal_inv, Complex.ofReal_natCast, ← mul_sum] using hh

/- A row estimate over all finite sets remains true after any bijective
reindexing of the source and target states. -/
theorem equiv_kernel_row_bound {X : Type*} (K : X → X → ℂ) {C : ℝ}
    (hrow : ∀ x rows, (∑ y ∈ rows, ‖K x y‖) ≤ C)
    (a b : X ≃ X) (x : X) (rows : Finset X) :
    (∑ y ∈ rows, ‖K (a x) (b y)‖) ≤ C := by
  have hh := hrow (a x) (rows.map b.toEmbedding)
  simpa only [sum_map, Equiv.coe_toEmbedding] using hh

/- Averaging independently on both ends of a kernel preserves its
absolute row bound, including for cutoffs not invariant under the maps. -/
theorem finite_permutation_kernel_row_bound {A B X : Type*}
    [Fintype A] [Nonempty A] [Fintype B] [Nonempty B]
    (a : A → X ≃ X) (b : B → X ≃ X) (K : X → X → ℂ) {C : ℝ} (hC : 0 ≤ C)
    (hrow : ∀ x rows, (∑ y ∈ rows, ‖K x y‖) ≤ C) (x : X) (rows : Finset X) :
    (∑ y ∈ rows, ‖(Fintype.card A : ℂ)⁻¹ * ∑ i,
      (Fintype.card B : ℂ)⁻¹ * ∑ j, K (a i x) (b j y)‖) ≤ C := by
  apply finite_uniform_average_row_bound rows _ hC
  intro i
  apply finite_uniform_average_row_bound rows _ hC
  intro j
  exact equiv_kernel_row_bound K hrow (a i) (b j) x rows
end

section
open Finset
noncomputable def physicalSymmetricKernel {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (K : PhysicalState P J ell → PhysicalState P J ell → ℂ)
    (x y : PhysicalState P J ell) : ℂ :=
  physicalSymmetrize (fun a => physicalSymmetrize (K a) y) x

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (K : PhysicalState P J ell → PhysicalState P J ell → ℂ)

include G sharedInstance1 sharedInstance2 P J ell K

theorem physical_symmetric_kernel_double_sum 
    (x y : PhysicalState P J ell) :
    physicalSymmetricKernel K x y = (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
      (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
      ∑ σ : PhysicalPermutations G J ell, ∑ τ : PhysicalPermutations G J ell,
        K (physicalPermutationEquiv σ x) (physicalPermutationEquiv τ y) := by
  classical
  unfold physicalSymmetricKernel physicalSymmetrize
  rw [← mul_sum, mul_assoc]

/- Symmetrizing the transpose is the transpose of the symmetrized kernel. -/
theorem physical_symmetric_kernel_transpose 
    (x y : PhysicalState P J ell) :
    physicalSymmetricKernel (fun a b => K b a) x y = physicalSymmetricKernel K y x := by
  classical
  rw [physical_symmetric_kernel_double_sum, physical_symmetric_kernel_double_sum]
  congr 1
  exact sum_comm

/- Averaging permutations on both endpoints preserves every uniform
absolute row bound on finite subsets of the physical state space. -/
theorem physical_symmetric_kernel_row_bound 
    {A : ℝ} (hA : 0 ≤ A)
    (hrow : ∀ x rows, (∑ y ∈ rows, ‖K x y‖) ≤ A)
    (x : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)) :
    (∑ y ∈ rows, ‖physicalSymmetricKernel K x y‖) ≤ A := by
  exact finite_permutation_kernel_row_bound
    (fun σ : PhysicalPermutations G J ell => physicalPermutationEquiv σ)
    (fun τ : PhysicalPermutations G J ell => physicalPermutationEquiv τ) K hA hrow x rows

/- The corresponding column bound follows by transposing before averaging. -/
theorem physical_symmetric_kernel_column_bound 
    {A : ℝ} (hA : 0 ≤ A)
    (hcol : ∀ y rows, (∑ x ∈ rows, ‖K x y‖) ≤ A)
    (y : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)) :
    (∑ x ∈ rows, ‖physicalSymmetricKernel K x y‖) ≤ A := by
  have hh := physical_symmetric_kernel_row_bound (fun a b => K b a) hA hcol y rows
  simpa only [physical_symmetric_kernel_transpose] using hh

end

end

section
open Finset
/- Absolute row and column bounds for the full symmetrized physical
operator. The only pattern loss is the sum of the coefficient bounds. -/
theorem exists_physical_operator_bounds {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell m : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] [DecidableEq G] (P : G → Finset ℕ)
      (J : ℕ) (V : G → ℝ), (∀ g, v ≤ V g) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      ∀ (I : Type) (patterns : Finset I) (C : I → G → Finset (Fin J))
        (ζ : I → ℝ) (k : I → ℤ)
        (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
        (B : I → ℝ),
        (∀ i ∈ patterns, ∀ g, (C i g).card ≤ m) →
        (∀ i ∈ patterns, 0 ≤ B i) →
        (∀ i ∈ patterns, ∀ a b aux, ‖K i a b aux‖ ≤ B i) →
        ∀ (x : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)),
        let W := fun a b => ∑ i ∈ patterns, physicalPatternKernel V (C i) q (ζ i) (k i) (K i) a b
        (∑ y ∈ rows, ‖physicalSymmetricKernel W x y‖) ≤ (∑ i ∈ patterns, B i) * A^(Fintype.card G) ∧
        (∑ y ∈ rows, ‖physicalSymmetricKernel W y x‖) ≤ (∑ i ∈ patterns, B i) * A^(Fintype.card G) := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_pattern_row_bound hq0 hq1 hv ell m
  refine ⟨A, hA, ?_⟩
  intro G _ _ P J V hV hMass I patterns C ζ k K B hC hB hK x rows
  classical
  let W := fun a b => ∑ i ∈ patterns, physicalPatternKernel V (C i) q (ζ i) (k i) (K i) a b
  have hnonneg : 0 ≤ (∑ i ∈ patterns, B i) * A^(Fintype.card G) :=
    mul_nonneg (sum_nonneg hB) (pow_nonneg (zero_le_one.trans hA) _)
  have hrow : ∀ a s, (∑ b ∈ s, ‖W a b‖) ≤ (∑ i ∈ patterns, B i) * A^(Fintype.card G) := by
    intro a s
    apply pattern_absolute_row_bound patterns s _ B (A^(Fintype.card G))
    intro i hi
    have hh := hbound G P J V (C i) hV (hC i hi) hMass (ζ i) (k i) (K i) (B i) (hB i hi) (hK i hi) a s
    simpa only [mul_comm] using hh
  have hcol : ∀ b s, (∑ a ∈ s, ‖W a b‖) ≤ (∑ i ∈ patterns, B i) * A^(Fintype.card G) := by
    intro b s
    apply pattern_absolute_row_bound patterns s _ B (A^(Fintype.card G))
    intro i hi
    have hKi : ∀ a b aux, ‖(starRingEnd ℂ) (K i b a aux)‖ ≤ B i := by
      intro a b aux
      rw [RCLike.norm_conj]
      exact hK i hi b a aux
    have hh := hbound G P J V (C i) hV (hC i hi) hMass (-(ζ i)) (-(k i))
      (fun a b aux => (starRingEnd ℂ) (K i b a aux)) (B i) (hB i hi) hKi b s
    simpa only [physical_pattern_norm_reverse, mul_comm] using hh
  exact ⟨physical_symmetric_kernel_row_bound W hnonneg hrow x rows,
    physical_symmetric_kernel_column_bound W hnonneg hcol x rows⟩

/- Any constant-measure kernel with uniform row and column bounds
satisfies the finite weighted Schur estimate. -/
theorem constant_measure_schur {X : Type*} (rows : Finset X) (K : X → X → ℂ)
    {μ A : ℝ} (hμ : 0 ≤ μ)
    (hrow : ∀ x ∈ rows, (∑ y ∈ rows, ‖K x y‖) ≤ A)
    (hcol : ∀ y ∈ rows, (∑ x ∈ rows, ‖K x y‖) ≤ A) (f : X → ℂ) :
    (∑ x ∈ rows, μ * ‖∑ y ∈ rows, K x y * f y‖^2) ≤ A^2 * ∑ y ∈ rows, μ * ‖f y‖^2 := by
  have hr : ∀ x ∈ rows, (∑ y ∈ rows, ‖K x y‖ * (1 : ℝ)) ≤ A * 1 := by
    simpa only [mul_one] using hrow
  have hc : ∀ y ∈ rows, (∑ x ∈ rows, μ * ‖K x y‖ * (1 : ℝ)) ≤ A * μ * 1 := by
    intro y hy
    simp only [mul_one]
    rw [← mul_sum]
    exact (mul_le_mul_of_nonneg_left (hcol y hy) hμ).trans_eq (mul_comm _ _)
  simpa only [pow_two] using finite_weighted_schur_transition rows (fun _ => μ) (fun _ => (1 : ℝ))
    K (fun _ _ => hμ) (fun _ _ => zero_lt_one) hr hc f
end

section
open Finset
/- Enumerate all physical states whose position belongs to a finite set. -/
noncomputable def physicalCutoff {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) (I : Finset ℤ) : Finset (PhysicalState P J ell) := by
  classical
  letI := physicalCutoffFintype P J ell I
  exact (univ : Finset {x : PhysicalState P J ell // x.1 ∈ I}).map ⟨Subtype.val, Subtype.val_injective⟩

theorem mem_physical_cutoff {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) (I : Finset ℤ) (x : PhysicalState P J ell) :
    x ∈ physicalCutoff P J ell I ↔ x.1 ∈ I := by
  classical
  unfold physicalCutoff
  simp only [mem_map, mem_univ, true_and, Function.Embedding.coeFn_mk]
  constructor
  · rintro ⟨y, rfl⟩
    exact y.property
  · intro hx
    exact ⟨⟨x, hx⟩, rfl⟩

theorem physical_cutoff_permutation {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) (I : Finset ℤ) (σ : PhysicalPermutations G J ell) (x : PhysicalState P J ell) :
    physicalPermutationEquiv σ x ∈ physicalCutoff P J ell I ↔ x ∈ physicalCutoff P J ell I := by
  rw [mem_physical_cutoff, mem_physical_cutoff, physical_permutation_position]

/- A permutation of the marks preserves finite counting measure on
any complete position cutoff. -/
theorem physical_permutation_sum {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) (I : Finset ℤ) (σ : PhysicalPermutations G J ell)
    (f : PhysicalState P J ell → ℂ) :
    (∑ x ∈ physicalCutoff P J ell I, f (physicalPermutationEquiv σ x)) =
      ∑ x ∈ physicalCutoff P J ell I, f x := by
  apply sum_equiv (physicalPermutationEquiv σ)
  · intro x
    exact (physical_cutoff_permutation P J ell I σ x).symm
  · intro x _
    rfl






end

section
open Finset
noncomputable def physicalAbsolutePattern {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (x y : PhysicalState P J ell) : ℝ :=
  ∑ aux : PhysicalAuxLabels P C, ‖physicalEdgeCoeff V C q ζ k K aux x y‖

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (V : G → ℝ)
  (C : G → Finset (Fin J))
  (q ζ : ℝ)
  (k : ℤ)
  (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
  (x y : PhysicalState P J ell)

include G sharedInstance1 sharedInstance2 P J ell V C q ζ k K x y

theorem physical_absolute_pattern_nonneg  : 0 ≤ physicalAbsolutePattern V C q ζ k K x y :=
  sum_nonneg (fun _ _ => norm_nonneg _)

theorem physical_pattern_norm_le_absolute  :
    ‖physicalPatternKernel V C q ζ k K x y‖ ≤ physicalAbsolutePattern V C q ζ k K x y :=
  norm_sum_le _ _

theorem physical_absolute_pattern_reverse  :
    physicalAbsolutePattern V C q (-ζ) (-k) (fun a b f => (starRingEnd ℂ) (K b a f)) y x =
      physicalAbsolutePattern V C q ζ k K x y := by
  unfold physicalAbsolutePattern
  simp only [physical_edge_reverse, RCLike.norm_conj]

end


/- The expanded auxiliary sum obeys the same row bound as the summed
complex kernel, without relying on cancellation between its terms. -/
theorem physical_absolute_pattern_row_le {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    {q A B : ℝ} (ζ : ℝ) (k : ℤ) (hV : ∀ g, 0 < V g) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (x : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)) (hB : 0 ≤ B)
    (hK : ∀ aux y, y ∈ rows → ‖K x.2.val y.2.val aux‖ ≤ B)
    (hA : ∀ aux, (Nat.card (PhysicalCompatibleTargets C x aux k) : ℝ) * physicalCompletionMass V C ell *
      physicalDamping P J ell q (physicalNextPosition C x aux k) ≤ A) :
    (∑ y ∈ rows, physicalAbsolutePattern V C q ζ k K x y) ≤ A * B := by
  classical
  unfold physicalAbsolutePattern
  rw [sum_comm]
  calc
    _ ≤ ∑ aux : PhysicalAuxLabels P C, physicalAuxMass V C aux * A * B :=
      sum_le_sum (fun aux _ => physical_edge_norm_row_le V C ζ k hV hq0 hq1 K aux x rows hB (hK aux) (hA aux))
    _ = (∑ aux : PhysicalAuxLabels P C, physicalAuxMass V C aux) * A * B := by rw [sum_mul, sum_mul]
    _ = A * B := by rw [physical_aux_mass_sum V C hV hMass, one_mul]

theorem exists_physical_absolute_pattern_row_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell m : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] [DecidableEq G] (P : G → Finset ℕ)
      (J : ℕ) (V : G → ℝ) (C : G → Finset (Fin J)),
      (∀ g, v ≤ V g) → (∀ g, (C g).card ≤ m) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      ∀ (ζ : ℝ) (k : ℤ)
        (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
        (B : ℝ), 0 ≤ B → (∀ a b aux, ‖K a b aux‖ ≤ B) →
        ∀ (x : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)),
        (∑ y ∈ rows, physicalAbsolutePattern V C q ζ k K x y) ≤ A^(Fintype.card G) * B := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_compatible_target_mass_bound hq0 hq1 hv ell m
  refine ⟨A, hA, ?_⟩
  intro G _ _ P J V C hV hC hMass ζ k K B hB hK x rows
  exact physical_absolute_pattern_row_le V C ζ k (fun g => hv.trans_le (hV g)) hq0 hq1.le hMass K x rows hB
    (fun aux y _ => hK x.2.val y.2.val aux) (fun aux => hbound G P J V C hV hC x aux k)
end

section
open Finset
noncomputable def physicalAverageMass {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (M : PhysicalState P J ell → PhysicalState P J ell → ℝ)
    (x y : PhysicalState P J ell) : ℝ :=
  (Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ *
    ∑ σ : PhysicalPermutations G J ell, (Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ *
      ∑ τ : PhysicalPermutations G J ell, M (physicalPermutationEquiv σ x) (physicalPermutationEquiv τ y)

theorem physical_average_mass_nonneg {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (M : PhysicalState P J ell → PhysicalState P J ell → ℝ)
    (hM : ∀ x y, 0 ≤ M x y) (x y : PhysicalState P J ell) :
    0 ≤ physicalAverageMass M x y := by
  unfold physicalAverageMass
  exact mul_nonneg (inv_nonneg.mpr (Nat.cast_nonneg _))
    (sum_nonneg (fun σ _ => mul_nonneg (inv_nonneg.mpr (Nat.cast_nonneg _))
      (sum_nonneg (fun τ _ => hM _ _))))

theorem physical_average_mass_cast {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (M : PhysicalState P J ell → PhysicalState P J ell → ℝ)
    (x y : PhysicalState P J ell) :
    (physicalAverageMass M x y : ℂ) = physicalSymmetricKernel (fun a b => (M a b : ℂ)) x y := by
  simp only [physicalAverageMass, physicalSymmetricKernel, physicalSymmetrize,
    Complex.ofReal_mul, Complex.ofReal_sum, Complex.ofReal_inv, Complex.ofReal_natCast]

/- Comparison for one finite uniform average, before adding its terms. -/
theorem finite_uniform_average_norm_le {A : Type*} [Fintype A]
    (K : A → ℂ) (M : A → ℝ) (hKM : ∀ a, ‖K a‖ ≤ M a) :
    ‖(Fintype.card A : ℂ)⁻¹ * ∑ a, K a‖ ≤ (Fintype.card A : ℝ)⁻¹ * ∑ a, M a := by
  rw [norm_mul, norm_inv, Complex.norm_natCast]
  exact mul_le_mul_of_nonneg_left ((norm_sum_le _ _).trans (sum_le_sum (fun a _ => hKM a)))
    (inv_nonneg.mpr (Nat.cast_nonneg _))

/- A pointwise majorant before symmetrization majorizes the complete
symmetrized kernel after independent averaging of both endpoints. -/
theorem physical_symmetric_kernel_norm_le_mass {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (K : PhysicalState P J ell → PhysicalState P J ell → ℂ)
    (M : PhysicalState P J ell → PhysicalState P J ell → ℝ)
    (hKM : ∀ x y, ‖K x y‖ ≤ M x y) (x y : PhysicalState P J ell) :
    ‖physicalSymmetricKernel K x y‖ ≤ physicalAverageMass M x y := by
  apply finite_uniform_average_norm_le
  intro σ
  apply finite_uniform_average_norm_le
  intro τ
  exact hKM _ _

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (M : PhysicalState P J ell → PhysicalState P J ell → ℝ)

include G sharedInstance1 sharedInstance2 P J ell M

theorem physical_average_mass_transpose 
    (x y : PhysicalState P J ell) :
    physicalAverageMass (fun a b => M b a) x y = physicalAverageMass M y x := by
  apply Complex.ofReal_injective
  rw [physical_average_mass_cast, physical_average_mass_cast, physical_symmetric_kernel_transpose]

/- Nonnegative averaging preserves the absolute row sum, not just a
norm bound for the corresponding complex operator. -/
theorem physical_average_mass_row_bound 
    (hM : ∀ x y, 0 ≤ M x y) {A : ℝ} (hA : 0 ≤ A)
    (hrow : ∀ x rows, (∑ y ∈ rows, M x y) ≤ A)
    (x : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)) :
    (∑ y ∈ rows, physicalAverageMass M x y) ≤ A := by
  have hr : ∀ x rows, (∑ y ∈ rows, ‖(M x y : ℂ)‖) ≤ A := by
    intro x rows
    simpa only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hM _ _)] using hrow x rows
  have hh := physical_symmetric_kernel_row_bound (fun x y => (M x y : ℂ)) hA hr x rows
  simpa only [← physical_average_mass_cast, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (physical_average_mass_nonneg M hM _ _)] using hh

theorem physical_average_mass_column_bound 
    (hM : ∀ x y, 0 ≤ M x y) {A : ℝ} (hA : 0 ≤ A)
    (hcol : ∀ y rows, (∑ x ∈ rows, M x y) ≤ A)
    (y : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)) :
    (∑ x ∈ rows, physicalAverageMass M x y) ≤ A := by
  have hh := physical_average_mass_row_bound (fun a b => M b a) (fun a b => hM b a) hA hcol y rows
  simpa only [physical_average_mass_transpose] using hh

end

end

section
open Finset
/- Sum absolute sampled-edge coefficients over the auxiliary choices
and patterns, then average over both endpoint permutations. -/
noncomputable def physicalAbsoluteOperator {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (x y : PhysicalState P J ell) : ℝ :=
  physicalAverageMass (fun a b => ∑ i ∈ patterns, physicalAbsolutePattern V (C i) q (ζ i) (k i) (K i) a b) x y




/- The expanded nonnegative operator pointwise dominates the original
complex operator, including both symmetrizing averages. -/
theorem physical_operator_norm_le_absolute {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (x y : PhysicalState P J ell) :
    ‖physicalSymmetricKernel (fun a b =>
      ∑ i ∈ patterns, physicalPatternKernel V (C i) q (ζ i) (k i) (K i) a b) x y‖ ≤
      physicalAbsoluteOperator V patterns C q ζ k K x y := by
  apply physical_symmetric_kernel_norm_le_mass
  intro a b
  exact (norm_sum_le _ _).trans (sum_le_sum (fun i _ =>
    physical_pattern_norm_le_absolute V (C i) q (ζ i) (k i) (K i) a b))

/- The stronger absolute bounds apply before all path labels are summed.
Consequently no cancellation is used in bounding expanded path masses. -/
theorem exists_physical_absolute_operator_bounds {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell m : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] [DecidableEq G] (P : G → Finset ℕ)
      (J : ℕ) (V : G → ℝ), (∀ g, v ≤ V g) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      ∀ (I : Type) (patterns : Finset I) (C : I → G → Finset (Fin J))
        (ζ : I → ℝ) (k : I → ℤ)
        (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
        (B : I → ℝ),
        (∀ i ∈ patterns, ∀ g, (C i g).card ≤ m) →
        (∀ i ∈ patterns, 0 ≤ B i) →
        (∀ i ∈ patterns, ∀ a b aux, ‖K i a b aux‖ ≤ B i) →
        ∀ (x : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)),
        (∑ y ∈ rows, physicalAbsoluteOperator V patterns C q ζ k K x y) ≤
          (∑ i ∈ patterns, B i) * A^(Fintype.card G) ∧
        (∑ y ∈ rows, physicalAbsoluteOperator V patterns C q ζ k K y x) ≤
          (∑ i ∈ patterns, B i) * A^(Fintype.card G) := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_absolute_pattern_row_bound hq0 hq1 hv ell m
  refine ⟨A, hA, ?_⟩
  intro G _ _ P J V hV hMass I patterns C ζ k K B hC hB hK x rows
  classical
  let W := fun a b => ∑ i ∈ patterns, physicalAbsolutePattern V (C i) q (ζ i) (k i) (K i) a b
  have hW : ∀ a b, 0 ≤ W a b := fun a b => sum_nonneg (fun i _ =>
    physical_absolute_pattern_nonneg V (C i) q (ζ i) (k i) (K i) a b)
  have hnonneg : 0 ≤ (∑ i ∈ patterns, B i) * A^(Fintype.card G) :=
    mul_nonneg (sum_nonneg hB) (pow_nonneg (zero_le_one.trans hA) _)
  have hrow : ∀ a s, (∑ b ∈ s, W a b) ≤ (∑ i ∈ patterns, B i) * A^(Fintype.card G) := by
    intro a s
    unfold W
    rw [sum_comm]
    calc
      _ ≤ ∑ i ∈ patterns, A^(Fintype.card G) * B i := sum_le_sum (fun i hi =>
        hbound G P J V (C i) hV (hC i hi) hMass (ζ i) (k i) (K i) (B i) (hB i hi) (hK i hi) a s)
      _ = _ := by rw [← mul_sum, mul_comm]
  have hcol : ∀ b s, (∑ a ∈ s, W a b) ≤ (∑ i ∈ patterns, B i) * A^(Fintype.card G) := by
    intro b s
    unfold W
    rw [sum_comm]
    calc
      _ ≤ ∑ i ∈ patterns, A^(Fintype.card G) * B i := by
        apply sum_le_sum
        intro i hi
        have hKi : ∀ a b aux, ‖(starRingEnd ℂ) (K i b a aux)‖ ≤ B i := by
          intro a b aux
          rw [RCLike.norm_conj]
          exact hK i hi b a aux
        have hh := hbound G P J V (C i) hV (hC i hi) hMass (-(ζ i)) (-(k i))
          (fun a b aux => (starRingEnd ℂ) (K i b a aux)) (B i) (hB i hi) hKi b s
        simpa only [physical_absolute_pattern_reverse] using hh
      _ = _ := by rw [← mul_sum, mul_comm]
  exact ⟨physical_average_mass_row_bound W hW hnonneg hrow x rows,
    physical_average_mass_column_bound W hW hnonneg hcol x rows⟩
end

section
open Finset
/- A finite maximum over all source lists and auxiliary labels. -/
noncomputable def physicalDMax {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (J ell : ℕ) (C : G → Finset (Fin J)) : ℕ :=
  univ.sup (fun a : PhysicalMarkLists P J ell × PhysicalAuxLabels P C => physicalD C a.1 a.2)

theorem physical_D_le_max {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (J ell : ℕ) (C : G → Finset (Fin J))
    (labels : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C) :
    physicalD C labels aux ≤ physicalDMax P J ell C := by
  exact le_sup (f := fun a : PhysicalMarkLists P J ell × PhysicalAuxLabels P C => physicalD C a.1 a.2)
    (mem_univ (labels, aux))

/- Natural displacement bound, allowing negative translation steps. -/
noncomputable def physicalStepBound {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (J ell : ℕ) (C : G → Finset (Fin J)) (k : ℤ) : ℕ :=
  k.natAbs * physicalDMax P J ell C

theorem physical_admissible_displacement {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) {x y : PhysicalState P J ell}
    (h : physicalAdmissible C aux k x y) :
    (y.1 - x.1).natAbs ≤ physicalStepBound P J ell C k := by
  have he : y.1 - x.1 = k * (physicalD C x.2.val aux : ℕ) := by rw [h.2.2.2]; ring
  rw [he, Int.natAbs_mul, Int.natAbs_natCast]
  exact Nat.mul_le_mul_left _ (physical_D_le_max P J ell C x.2.val aux)

theorem physical_step_bound_neg {G : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (J ell : ℕ) (C : G → Finset (Fin J)) (k : ℤ) :
    physicalStepBound P J ell C (-k) = physicalStepBound P J ell C k := by
  simp only [physicalStepBound, Int.natAbs_neg]

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (V : G → ℝ)
  (C : G → Finset (Fin J))
  (q ζ : ℝ)
  (k : ℤ)
  (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)

include G sharedInstance1 sharedInstance2 P J ell V C q ζ k K

/- Coefficients outside the displacement bound vanish individually. -/
theorem physical_edge_zero_of_far 
    (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell)
    (hfar : physicalStepBound P J ell C k < (y.1 - x.1).natAbs) :
    physicalEdgeCoeff V C q ζ k K aux x y = 0 := by
  classical
  have hnot : ¬ physicalAdmissible C aux k x y := fun h =>
    (not_lt_of_ge (physical_admissible_displacement C aux k h)) hfar
  simp only [physicalEdgeCoeff, if_neg hnot]

theorem physical_absolute_pattern_zero_of_far 
    (x y : PhysicalState P J ell)
    (hfar : physicalStepBound P J ell C k < (y.1 - x.1).natAbs) :
    physicalAbsolutePattern V C q ζ k K x y = 0 := by
  unfold physicalAbsolutePattern
  apply sum_eq_zero
  intro aux _
  rw [physical_edge_zero_of_far V C q ζ k K aux x y hfar, norm_zero]

end

end

section
open Finset
noncomputable def physicalOperatorStepBound {G I : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (J ell : ℕ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (k : I → ℤ) : ℕ :=
  patterns.sup (fun i => physicalStepBound P J ell (C i) (k i))

theorem physical_operator_step_bound_neg {G I : Type*} [Fintype G] [DecidableEq G]
    (P : G → Finset ℕ) (J ell : ℕ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (k : I → ℤ) :
    physicalOperatorStepBound P J ell patterns C (fun i => -(k i)) =
      physicalOperatorStepBound P J ell patterns C k := by
  simp only [physicalOperatorStepBound, physical_step_bound_neg]

/- Taking absolute values, adding patterns, and averaging mark permutations
do not enlarge the possible displacement of any individual edge. -/
theorem physical_absolute_operator_zero_of_far {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (x y : PhysicalState P J ell)
    (hfar : physicalOperatorStepBound P J ell patterns C k < (y.1 - x.1).natAbs) :
    physicalAbsoluteOperator V patterns C q ζ k K x y = 0 := by
  classical
  have hzero : ∀ σ τ : PhysicalPermutations G J ell,
      (∑ i ∈ patterns, physicalAbsolutePattern V (C i) q (ζ i) (k i) (K i)
        (physicalPermutationEquiv σ x) (physicalPermutationEquiv τ y)) = 0 := by
    intro σ τ
    apply sum_eq_zero
    intro i hi
    apply physical_absolute_pattern_zero_of_far
    change physicalStepBound P J ell (C i) (k i) < (y.1 - x.1).natAbs
    exact (le_sup (f := fun i => physicalStepBound P J ell (C i) (k i)) hi).trans_lt hfar
  simp only [physicalAbsoluteOperator, physicalAverageMass, hzero, sum_const_zero, mul_zero]




/- The complex physical kernel has the same finite displacement bound. -/
theorem physical_operator_zero_of_far {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (x y : PhysicalState P J ell)
    (hfar : physicalOperatorStepBound P J ell patterns C k < (y.1 - x.1).natAbs) :
    physicalSymmetricKernel (fun a b =>
      ∑ i ∈ patterns, physicalPatternKernel V (C i) q (ζ i) (k i) (K i) a b) x y = 0 := by
  apply norm_eq_zero.mp
  apply le_antisymm _ (norm_nonneg _)
  have hh := physical_operator_norm_le_absolute V patterns C q ζ k K x y
  rwa [physical_absolute_operator_zero_of_far V patterns C q ζ k K x y hfar] at hh
end

section
open Finset
theorem integer_walk_displacement {p : ℕ → ℤ} {N b : ℕ}
    (hstep : ∀ j < N, (p (j + 1) - p j).natAbs ≤ b) :
    ∀ j ≤ N, (p j - p 0).natAbs ≤ j * b := by
  intro j
  induction j with
  | zero => simp
  | succ j ih =>
    intro hj
    have hjN : j < N := by omega
    have hh := ih (by omega)
    calc
      (p (j + 1) - p 0).natAbs = ((p (j + 1) - p j) + (p j - p 0)).natAbs := by congr 1; ring
      _ ≤ (p (j + 1) - p j).natAbs + (p j - p 0).natAbs := Int.natAbs_add_le _ _
      _ ≤ b + j * b := Nat.add_le_add (hstep j hjN) hh
      _ = (j + 1) * b := by ring

/- The union of radius-R integer intervals around a finite starting set. -/
def reachablePositions (I : Finset ℤ) (R : ℕ) : Finset ℤ :=
  I.biUnion (fun n => Icc (n - (R : ℤ)) (n + (R : ℤ)))

theorem mem_reachable_positions {I : Finset ℤ} {R : ℕ} {n r : ℤ}
    (hr : r ∈ I) (hd : (n - r).natAbs ≤ R) : n ∈ reachablePositions I R := by
  have hh : ((n - r).natAbs : ℤ) ≤ (R : ℤ) := by exact_mod_cast hd
  rw [Int.natCast_natAbs] at hh
  have habs := abs_le.mp hh
  exact mem_biUnion.mpr ⟨r, hr, mem_Icc.mpr ⟨by omega, by omega⟩⟩









end

section
open Finset
/- Finite operator action in reverse step order, matching finitePathMass. -/
noncomputable def finitePathAction {X R : Type*} [Fintype X] [Semiring R]
    (K : ℕ → X → X → R) (terminal : X → R) : ℕ → X → R
  | 0, x => terminal x
  | n + 1, x => ∑ y, K n x y * finitePathAction K terminal n y

/- One fully expanded path records an edge label and the next state
at each step. Its weight includes the terminal value. -/
def labeledPathTerm {A X R : Type*} [Mul R]
    (K : ℕ → A → X → X → R) (terminal : X → R) :
    (n : ℕ) → X → (Fin n → A × X) → R
  | 0, x, _ => terminal x
  | n + 1, x, p => K n (p 0).1 x (p 0).2 * labeledPathTerm K terminal n (p 0).2 (Fin.tail p)

/- Finite matrix iteration is exactly the sum over all edge labels
and all visited states, without any suppression of individual terms. -/
theorem finite_labeled_path_expansion {A X R : Type*} [Fintype A] [Fintype X] [Semiring R]
    (K : ℕ → A → X → X → R) (terminal : X → R) (n : ℕ) (x : X) :
    (∑ p : Fin n → A × X, labeledPathTerm K terminal n x p) =
      finitePathAction (fun j a b => ∑ label, K j label a b) terminal n x := by
  classical
  induction n generalizing x with
  | zero => simp [labeledPathTerm, finitePathAction]
  | succ n ih =>
    calc
      _ = ∑ z : A × X, ∑ p : Fin n → A × X,
          K n z.1 x z.2 * labeledPathTerm K terminal n z.2 p := by
        rw [← Equiv.sum_comp (Fin.consEquiv (fun _ : Fin (n + 1) => A × X))
          (fun p => labeledPathTerm K terminal (n + 1) x p), Fintype.sum_prod_type]
        rfl
      _ = ∑ z : A × X, K n z.1 x z.2 *
          finitePathAction (fun j a b => ∑ label, K j label a b) terminal n z.2 := by
        apply sum_congr rfl
        intro z _
        rw [← mul_sum, ih]
      _ = _ := by
        rw [Fintype.sum_prod_type, sum_comm]
        simp only [finitePathAction, sum_mul]

/- Norms factor over every individual labeled path. -/
theorem norm_labeled_path_term {A X : Type*}
    (K : ℕ → A → X → X → ℂ) (terminal : X → ℂ) (n : ℕ)
    (x : X) (p : Fin n → A × X) :
    ‖labeledPathTerm K terminal n x p‖ =
      labeledPathTerm (fun j a x y => ‖K j a x y‖) (fun y => ‖terminal y‖) n x p := by
  induction n generalizing x with
  | zero => rfl
  | succ n ih =>
    simp only [labeledPathTerm, norm_mul, ih]

theorem real_finite_path_action_eq_mass {X : Type*} [Fintype X]
    (K : ℕ → X → X → ℝ) (terminal : X → ℝ) (n : ℕ) (x : X) :
    finitePathAction K terminal n x = finitePathMass univ K terminal n x := by
  induction n generalizing x with
  | zero => rfl
  | succ n ih => simp only [finitePathAction, finitePathMass, ih]

/- The sum of the norms of all fully expanded path terms is exactly
iteration of the kernel that sums the norms of individual edge coefficients. -/
theorem absolute_labeled_path_expansion {A X : Type*} [Fintype A] [Fintype X]
    (K : ℕ → A → X → X → ℂ) (terminal : X → ℂ) (n : ℕ) (x : X) :
    (∑ p : Fin n → A × X, ‖labeledPathTerm K terminal n x p‖) =
      finitePathMass univ (fun j a b => ∑ label, ‖K j label a b‖)
        (fun y => ‖terminal y‖) n x := by
  simp only [norm_labeled_path_term]
  rw [finite_labeled_path_expansion, real_finite_path_action_eq_mass]

/- Uniform absolute row bounds control the sum of all expanded path
magnitudes, not only the norm after the paths have been added. -/
theorem absolute_labeled_path_bound {A X : Type*} [Fintype A] [Fintype X]
    (K : ℕ → A → X → X → ℂ) (terminal : X → ℂ) {B : ℝ} (hB : 0 ≤ B)
    (hrow : ∀ j x, (∑ y, ∑ label, ‖K j label x y‖) ≤ B)
    (ht : ∀ x, ‖terminal x‖ ≤ 1) (n : ℕ) (x : X) :
    (∑ p : Fin n → A × X, ‖labeledPathTerm K terminal n x p‖) ≤ B^n := by
  rw [absolute_labeled_path_expansion]
  exact finite_path_mass_le_pow univ _ _ hB
    (fun _ _ _ _ _ => sum_nonneg (fun _ _ => norm_nonneg _))
    (fun j x _ => hrow j x) (fun x _ => ht x) n x (mem_univ x)
end

section
open Finset
abbrev PhysicalEdgeLabels {G I : Type*} (P : G → Finset ℕ) (J ell : ℕ)
    (patterns : Finset I) (C : I → G → Finset (Fin J)) :=
  PhysicalPermutations G J ell × PhysicalPermutations G J ell ×
    (Σ i : patterns, PhysicalAuxLabels P (C i.val))

theorem physical_edge_labels_sum {G I R : Type*} [Fintype G] [DecidableEq G] [AddCommMonoid R]
    {P : G → Finset ℕ} {J ell : ℕ} (patterns : Finset I) (C : I → G → Finset (Fin J))
    (F : PhysicalPermutations G J ell → PhysicalPermutations G J ell →
      (i : I) → PhysicalAuxLabels P (C i) → R) :
    (∑ a : PhysicalEdgeLabels P J ell patterns C, F a.1 a.2.1 a.2.2.1.val a.2.2.2) =
      ∑ σ : PhysicalPermutations G J ell, ∑ τ : PhysicalPermutations G J ell,
        ∑ i ∈ patterns, ∑ aux : PhysicalAuxLabels P (C i), F σ τ i aux := by
  classical
  simp only [Fintype.sum_prod_type, Fintype.sum_sigma]
  apply sum_congr rfl
  intro σ _
  apply sum_congr rfl
  intro τ _
  exact sum_coe_sort patterns (fun i => ∑ aux : PhysicalAuxLabels P (C i), F σ τ i aux)

noncomputable def physicalLabeledCoeff {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : PhysicalEdgeLabels P J ell patterns C) (x y : PhysicalState P J ell) : ℂ :=
  (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
    (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
    physicalEdgeCoeff V (C a.2.2.1.val) q (ζ a.2.2.1.val) (k a.2.2.1.val) (K a.2.2.1.val)
      a.2.2.2 (physicalPermutationEquiv a.1 x) (physicalPermutationEquiv a.2.1 y)

/- The labeled coefficients sum to exactly the symmetrized physical
operator, with both permutation normalizations included. -/
theorem physical_labeled_coefficient_sum {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (x y : PhysicalState P J ell) :
    (∑ a : PhysicalEdgeLabels P J ell patterns C, physicalLabeledCoeff V patterns C q ζ k K a x y) =
      physicalSymmetricKernel (fun b c => ∑ i ∈ patterns,
        physicalPatternKernel V (C i) q (ζ i) (k i) (K i) b c) x y := by
  classical
  unfold physicalLabeledCoeff
  rw [physical_edge_labels_sum patterns C (fun σ τ i aux =>
    (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
      (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ *
      physicalEdgeCoeff V (C i) q (ζ i) (k i) (K i) aux
        (physicalPermutationEquiv σ x) (physicalPermutationEquiv τ y)),
    physical_symmetric_kernel_double_sum]
  simp only [← mul_sum, physicalPatternKernel]

/- Taking the norm before summing any edge labels gives exactly the
expanded absolute operator, retaining all normalization factors. -/
theorem physical_labeled_coefficient_abs_sum {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (x y : PhysicalState P J ell) :
    (∑ a : PhysicalEdgeLabels P J ell patterns C, ‖physicalLabeledCoeff V patterns C q ζ k K a x y‖) =
      physicalAbsoluteOperator V patterns C q ζ k K x y := by
  classical
  unfold physicalLabeledCoeff
  simp only [norm_mul, norm_inv, Complex.norm_natCast]
  rw [physical_edge_labels_sum patterns C (fun σ τ i aux =>
    (Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ *
      (Fintype.card (PhysicalPermutations G J ell) : ℝ)⁻¹ *
      ‖physicalEdgeCoeff V (C i) q (ζ i) (k i) (K i) aux
        (physicalPermutationEquiv σ x) (physicalPermutationEquiv τ y)‖)]
  unfold physicalAbsoluteOperator physicalAverageMass physicalAbsolutePattern
  simp only [← mul_sum, mul_assoc]
end

section
open Finset Classical



/- A normalized starting distribution preserves the labeled path bound,
including when the terminal condition depends on the starting state. -/
theorem averaged_absolute_labeled_path_bound {A X : Type*} [Fintype A] [Fintype X]
    (K : ℕ → A → X → X → ℂ) (terminal : X → X → ℂ) (μ : X → ℝ)
    {B : ℝ} (hB : 0 ≤ B)
    (hrow : ∀ j x, (∑ y, ∑ label, ‖K j label x y‖) ≤ B)
    (ht : ∀ x y, ‖terminal x y‖ ≤ 1) (hμ : ∀ x, 0 ≤ μ x)
    (hmass : (∑ x, μ x) ≤ 1) (n : ℕ) :
    (∑ x, μ x * ∑ p : Fin n → A × X, ‖labeledPathTerm K (terminal x) n x p‖) ≤ B^n := by
  calc
    _ ≤ ∑ x, μ x * B^n := sum_le_sum (fun x _ => mul_le_mul_of_nonneg_left
      (absolute_labeled_path_bound K (terminal x) hB hrow (ht x) n x) (hμ x))
    _ = (∑ x, μ x) * B^n := by rw [sum_mul]
    _ ≤ 1 * B^n := mul_le_mul_of_nonneg_right hmass (pow_nonneg hB n)
    _ = B^n := one_mul _
end

section
open Finset
/- Logarithmically many group losses and polynomial total pattern mass
give a fixed power of L, with no dependence on the shared-slot count. -/
theorem group_pattern_weight_power_bound {L A B C D : ℝ} {s : ℕ}
    (hL : 0 < L) (hA : 1 ≤ A) (hs : (s : ℝ) ≤ D * Real.log L)
    (hB : B ≤ L^C) : B * A^s ≤ L^(C + D * Real.log A) := by
  have hA0 : 0 ≤ A := zero_le_one.trans hA
  have hprod : A^s ≤ L^(D * Real.log A) := by
    simpa only [prod_const, card_range] using
      group_product_bound_of_log_card (range s) (fun _ => A) hA hL
        (fun _ _ => hA0) (fun _ _ => le_rfl) (by simpa only [card_range] using hs)
  calc
    _ ≤ L^C * A^s := mul_le_mul_of_nonneg_right hB (pow_nonneg hA0 s)
    _ ≤ L^C * L^(D * Real.log A) := mul_le_mul_of_nonneg_left hprod (Real.rpow_nonneg hL.le C)
    _ = _ := (Real.rpow_add hL _ _).symm



end

