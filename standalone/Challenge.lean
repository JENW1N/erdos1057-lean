abbrev PhysicalFullBoundedState {N : ℕ} (P : Fin N → Finset ℕ) (J ell B : ℕ) :=
  ProductBoundedOrderedState (fun g => ↥(P g))
    (fun g => UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) (fun _ => J + ell) B

noncomputable def physicalFullEdgeD {N J ell : ℕ} {P : Fin N → Finset ℕ}
    (C : Fin N → Finset (Fin J))
    (c : SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)))
    (aux : PhysicalAuxLabels P C) (_g : Fin N) : ℤ := physicalFullSharedD C c aux

noncomputable def physicalFullEdgeDelta {N J ell : ℕ} {P : Fin N → Finset ℕ}
    (C : Fin N → Finset (Fin J)) (k : ℤ)
    (c : SharedActiveLabels (fun g => ↥(P g))
      (fun g => physicalFullSharedIndices (ell := ell) (C g)))
    (aux : PhysicalAuxLabels P C) (g : Fin N) : ℤ := -k * physicalFullEdgeD C c aux g

abbrev PhysicalFullEdgeEvent {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (C : Fin N → Finset (Fin J)) (k : ℤ) (x : PhysicalFullBoundedState P J ell B) :=
  FullActiveEdgeEvent (fun g (p : ↥(P g)) => p.val)
    (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
    (physicalFullEdgeDelta C k) (physicalFullEdgeD C) x

