/- The original determinant and spatial indices discharge every saturation-scale input. -/

open Finset Filter

namespace Bounty

theorem eventually_actual_harmonic_scale_inputs {b K : ℝ} (hb : 0 < b) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop, ∀ U V : ℝ,
      Real.exp (b*L) ≤ U → U ≤ Real.exp L → Real.exp (b*L) ≤ V → V ≤ Real.exp L →
      ∀ k ∈ Icc (-(typeIIAdmissibleDeterminantBound L K : ℤ)) (typeIIAdmissibleDeterminantBound L K : ℤ),
      ∀ j ∈ range (typeIISmoothDyadicCount L),
      let Z := typeIISmoothDyadicScale U V (U*L^(-K)) j
      0 < Z ∧ Z ≤ 24*U^2*V*L^88/(U*L^(-K)) ∧ |(k : ℝ)| ≤ Z ∧ 3*Z < Real.exp (4*L) := by
  filter_upwards [eventually_typeII_actual_dyadic_geometry hb hK,
    eventually_candidate_cross_scale_below_cutoff hb hK,eventually_ge_atTop (1 : ℝ)]
    with L hgeo hcut hL
  intro U V hUlo hUhi hVlo hVhi k hk j hj
  obtain ⟨hU,hV,hE,_,_,_,hscale,_⟩ := hgeo U V (U*L^(-K)) hUlo hUhi hVlo hVhi rfl
  have hpos := typeII_smooth_dyadic_scale_pos hU hV hE j
  have hupper := typeII_smooth_dyadic_scale_le hL hU hV hE (mem_range.mp hj)
  have hk' : |(k : ℝ)| ≤ (typeIIAdmissibleDeterminantBound L K : ℝ) := by
    apply abs_le.mpr
    have hh := mem_Icc.mp hk
    constructor
    · exact_mod_cast hh.1
    · exact_mod_cast hh.2
  refine ⟨hpos,hupper,?_,?_⟩
  · exact hk'.trans ((le_max_right _ _).trans
      (hscale.trans (typeII_smooth_dyadic_scale_mono_zero hU hV hE j)))
  · exact hcut U V (U*L^(-K)) _ hUlo hUhi hVlo hVhi rfl hpos hupper

end Bounty
