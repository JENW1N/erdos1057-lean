theorem birth_forest_operation_multiplier_congr_on_owner
    {m : ℕ} {Op : Type*} (code : BirthForestCode m) (owner : Fin m → Op)
    (θ : (Fin m × Fin m) → ℝ) (performed performed' : Fin m → Prop)
    (label label' : Fin m → ℤ) (o : Op)
    (hp : ∀ j, owner j = o → (performed j ↔ performed' j))
    (hl : ∀ j, owner j = o → label j = label' j) :
    birthForestOperationMultiplier code owner θ performed label o =
      birthForestOperationMultiplier code owner θ performed' label' o := by
  classical
