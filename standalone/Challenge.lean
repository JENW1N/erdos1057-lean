/- The exact retained harmonic target, with every original finite support preserved. -/

open Finset Filter MeasureTheory

namespace Bounty

noncomputable def candidateB0HarmonicCorrelation (c L q : ℝ) (r jStar : ℕ)
    (P : Finset ℕ) (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (ν Z : ℝ) (k : ℤ)
    (M : Finset ℕ) (α : ℕ → ℂ) (χ : DirichletCharacter ℂ (2*k.natAbs))
    (ζ : EuclideanSpace ℝ (Fin 3)) : ℂ :=
  typeIIRetainedHarmonicCorrelation Z k M (candidateRetainedAllocationSupport c L r jStar P take) α
    (fun n => markedDivisorWeight (candidatePIndices c L) (candidatePBand (c*L)) q
      (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p:ℝ)) (fun _ => 1) (n:ℤ))
    (fun h => candidateRemainingComplexCoefficient c L r jStar take twist
      (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) h))
    (2*Real.pi*ν) χ ζ

theorem candidate_B0_retained_eq_separated (c L q : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (ν : ℝ) :
    candidateB0RetainedCoefficient c L q r jStar take twist ν =
      typeIISeparatedH
        (fun n => markedDivisorWeight (candidatePIndices c L) (candidatePBand (c*L)) q
          (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p:ℝ)) (fun _ => 1) (n:ℤ))
        (fun h => candidateRemainingComplexCoefficient c L r jStar take twist
          (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) h))
        (2*Real.pi*ν) := by
  rw [candidate_B0_retained_eq_phase]
  funext h
  simp only [candidateRetainedComplexCoefficient, typeIISeparatedH, mul_assoc]

end Bounty

section
/- Compact Fourier separation of the literal Type II coupled cutoff. -/

open Finset Filter MeasureTheory Real
open scoped Topology

namespace ThirdTypeIICompact
open Bounty

noncomputable def phase (x : Fin 3 → ℝ) (ξ : EuclideanSpace ℝ (Fin 3)) : ℂ :=
  ∏ i, (x i : ℂ) ^ (((2 * Real.pi * ξ i : ℝ) : ℂ) * Complex.I)

noncomputable def weight (A L U V E Z : ℝ) (k : ℤ)
    (ξ : EuclideanSpace ℝ (Fin 3)) : ℂ :=
  (∏ i, ((![U,U,Z] i : ℝ) : ℂ) ^ (-((2 * Real.pi * ξ i : ℝ) : ℂ) * Complex.I)) *
    typeIIPulledFourier A (L^88) (U/(2*(k:ℝ)*E)) (Z/((k:ℝ)*U*V)) (1/(U*V)) ξ

noncomputable def cutoff (L V E : ℝ) (k : ℤ) (x : Fin 3 → ℝ) : ℝ :=
  typeIIEMajorant (L^88) (((x 1-x 0)/(2*(k:ℝ)))/E) *
    typeIINMajorant (((x 1-x 0)*x 2/((k:ℝ)*x 0*x 1)+1/x 0)/V)

theorem weight_mul_phase_eq (A L U V E Z : ℝ) (k : ℤ)
    (x : Fin 3 → ℝ) (hU : 0 < U) (hZ : 0 < Z) (hx : ∀ i, 0 < x i)
    (ξ : EuclideanSpace ℝ (Fin 3)) :
    weight A L U V E Z k ξ * phase x ξ =
      typeIIPulledFourierIntegrand A (L^88) (U/(2*(k:ℝ)*E))
        (Z/((k:ℝ)*U*V)) (1/(U*V)) (typeIILogCoordinates x ![U,U,Z]) ξ := by
  have hs : ∀ i, 0 < (![U,U,Z] i : ℝ) := by intro i; fin_cases i <;> assumption
  rw [typeIIPulledFourierIntegrand, typeII_pulled_logarithmic_phase_separation x _ hx hs]
  unfold weight phase
  ring

theorem exists_coupled_cutoff_separation {A K D : ℝ} (hA : 0 ≤ A) (hD : 0 ≤ D) :
    ∃ F : ℝ, 0 < F ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (U V E Z : ℝ) (k : ℤ), 0 < U → 0 < V → 0 < Z → k ≠ 0 →
      E = U*L^(-K) → 1 ≤ U*V → Z ≤ 24*U^2*V*L^88/E →
      ∀ x : Fin 3 → ℝ, (∀ i, 0 < x i) →
      (∀ i, typeIILogCoordinates x ![U,U,Z] i ∈ Set.Icc (-A) A) →
      ‖(cutoff L V E k x : ℂ) -
        ∫ ξ in {ξ : EuclideanSpace ℝ (Fin 3) | ‖ξ‖ ≤ L^F},
          weight A L U V E Z k ξ * phase x ξ‖ ≤ L^(-D) := by
  have ha : 0 ≤ typeIIScaleEnvelopeExponent K (K+89) := by
    unfold typeIIScaleEnvelopeExponent
    exact (le_max_right _ _).trans ((le_max_right _ _).trans (le_max_right _ _))
  obtain ⟨F, hF, hcut⟩ := typeII_pulled_fourier_exists_power_cutoff hA ha hD
  refine ⟨F, hF, ?_⟩
  filter_upwards [hcut, eventually_ge_atTop (24:ℝ)] with L hcut hL
  intro U V E Z k hU hV hZ hk hE hUV hZbound x hx hbox
  have hp := typeII_localized_parameter_envelope hL hU hV hZ.le hk hE hUV hZbound
  have hb := hcut (typeIIScaleParameters L U V E Z k) hp (typeIILogCoordinates x ![U,U,Z])
  have hxvec : ![x 0,x 1,x 2] = x := by ext i; fin_cases i <;> rfl
  have he := typeII_scale_log_cutoff_eq_majorants (L := L) (E := E) (k := (k:ℝ))
    (hx 0) (hx 1) (hx 2) hU hV hZ (by exact_mod_cast hk)
    (by simpa only [hxvec] using hbox)
  simp only [hxvec] at he
  change ‖(typeIIPulledCutoff A (L^88) (U/(2*(k:ℝ)*E))
    (Z/((k:ℝ)*U*V)) (1/(U*V)) (typeIILogCoordinates x ![U,U,Z]) : ℂ) -
    ∫ ξ in {ξ : EuclideanSpace ℝ (Fin 3) | ‖ξ‖ ≤ L^F},
      typeIIPulledFourierIntegrand A (L^88) (U/(2*(k:ℝ)*E))
        (Z/((k:ℝ)*U*V)) (1/(U*V)) (typeIILogCoordinates x ![U,U,Z]) ξ‖ ≤ L^(-D) at hb
  rw [he] at hb
  simpa only [cutoff, ← weight_mul_phase_eq A L U V E Z k x hU hZ hx] using hb

theorem integrable_weight_mul_phase (A L U V E Z : ℝ) (k : ℤ)
    (x : Fin 3 → ℝ) (hU : 0 < U) (hZ : 0 < Z) (hx : ∀ i, 0 < x i) :
    Integrable (fun ξ => weight A L U V E Z k ξ * phase x ξ) := by
  simpa only [weight_mul_phase_eq A L U V E Z k x hU hZ hx] using
    typeII_pulled_fourier_integrand_integrable A (L^88) (U/(2*(k:ℝ)*E))
      (Z/((k:ℝ)*U*V)) (1/(U*V)) (typeIILogCoordinates x ![U,U,Z])

theorem finite_cutoff_error {ι : Type*} (S : Finset ι) (ω : ι → ℂ)
    (x : ι → Fin 3 → ℝ) (A L U V E Z : ℝ) (k : ℤ)
    (T : Set (EuclideanSpace ℝ (Fin 3))) (ε : ℝ) (hU : 0 < U) (hZ : 0 < Z)
    (hx : ∀ i ∈ S, ω i ≠ 0 → ∀ j, 0 < x i j)
    (herr : ∀ i ∈ S, ω i ≠ 0 →
      ‖(cutoff L V E k (x i) : ℂ) -
        ∫ ξ in T, weight A L U V E Z k ξ * phase (x i) ξ‖ ≤ ε) :
    ‖(∑ i ∈ S, ω i * (cutoff L V E k (x i) : ℂ)) -
      ∫ ξ in T, weight A L U V E Z k ξ * ∑ i ∈ S, ω i * phase (x i) ξ‖ ≤
      ε * ∑ i ∈ S, ‖ω i‖ := by
  have hi (i : ι) (h : i ∈ S) : IntegrableOn
      (fun ξ => ω i * (weight A L U V E Z k ξ * phase (x i) ξ)) T := by
    by_cases hz : ω i = 0
    · simp only [hz, zero_mul]
      exact integrableOn_zero
    · exact ((integrable_weight_mul_phase A L U V E Z k (x i) hU hZ (hx i h hz)).const_mul _).integrableOn
  have hs : (fun ξ => weight A L U V E Z k ξ * ∑ i ∈ S, ω i * phase (x i) ξ) =
      fun ξ => ∑ i ∈ S, ω i * (weight A L U V E Z k ξ * phase (x i) ξ) := by
    funext ξ
    rw [mul_sum]
    apply sum_congr rfl
    intro i _
    ring
  rw [hs, integral_finsetSum S hi]
  simp_rw [integral_const_mul]
  rw [← sum_sub_distrib]
  calc
    _ ≤ ∑ i ∈ S, ‖ω i * (cutoff L V E k (x i) : ℂ) -
        ω i * ∫ ξ in T, weight A L U V E Z k ξ * phase (x i) ξ‖ := norm_sum_le _ _
    _ ≤ ∑ i ∈ S, ε * ‖ω i‖ := by
      apply sum_le_sum
      intro i h
      by_cases hz : ω i = 0
      · simp only [hz, zero_mul, sub_zero, norm_zero, mul_zero, le_refl]
      · rw [← mul_sub, norm_mul, mul_comm ε]
        exact mul_le_mul_of_nonneg_left (herr i h hz) (norm_nonneg _)
    _ = _ := (mul_sum ..).symm

theorem exists_finite_coupled_cutoff_separation {A K D : ℝ} (hA : 0 ≤ A) (hD : 0 ≤ D) :
    ∃ F : ℝ, 0 < F ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (U V E Z : ℝ) (k : ℤ), 0 < U → 0 < V → 0 < Z → k ≠ 0 →
      E = U*L^(-K) → 1 ≤ U*V → Z ≤ 24*U^2*V*L^88/E →
      ∀ {ι : Type} (S : Finset ι) (ω : ι → ℂ) (x : ι → Fin 3 → ℝ),
      (∀ i ∈ S, ω i ≠ 0 → (∀ j, 0 < x i j) ∧
        (∀ j, typeIILogCoordinates (x i) ![U,U,Z] j ∈ Set.Icc (-A) A)) →
      ‖(∑ i ∈ S, ω i * (cutoff L V E k (x i) : ℂ)) -
        ∫ ξ in {ξ : EuclideanSpace ℝ (Fin 3) | ‖ξ‖ ≤ L^F},
          weight A L U V E Z k ξ * ∑ i ∈ S, ω i * phase (x i) ξ‖ ≤
        L^(-D) * ∑ i ∈ S, ‖ω i‖ := by
  obtain ⟨F, hF, hcut⟩ := exists_coupled_cutoff_separation (K := K) hA hD
  refine ⟨F, hF, ?_⟩
  filter_upwards [hcut] with L hcut
  intro U V E Z k hU hV hZ hk hE hUV hZbound ι S ω x hx
  exact finite_cutoff_error S ω x A L U V E Z k _ _ hU hZ
    (fun i hi hn => (hx i hi hn).1)
    (fun i hi hn => hcut U V E Z k hU hV hZ hk hE hUV hZbound (x i)
      (hx i hi hn).1 (hx i hi hn).2)

theorem weight_norm (A L U V E Z : ℝ) (k : ℤ) (hU : 0 < U) (hZ : 0 < Z)
    (ξ : EuclideanSpace ℝ (Fin 3)) :
    ‖weight A L U V E Z k ξ‖ =
      ‖typeIIPulledFourier A (L^88) (U/(2*(k:ℝ)*E)) (Z/((k:ℝ)*U*V)) (1/(U*V)) ξ‖ := by
  have hs : ∀ i, 0 < (![U,U,Z] i : ℝ) := by intro i; fin_cases i <;> assumption
  have hp : ‖∏ i, ((![U,U,Z] i : ℝ) : ℂ) ^
      (-((2 * Real.pi * ξ i : ℝ) : ℂ) * Complex.I)‖ = 1 := by
    rw [norm_prod]
    apply prod_eq_one
    intro i _
    rw [Complex.norm_cpow_eq_rpow_re_of_pos (hs i)]
    simp
  rw [weight, norm_mul, hp, one_mul]

theorem exists_weight_l1_bound {A K : ℝ} (hA : 0 ≤ A) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (U V E Z : ℝ) (k : ℤ), 0 < U → 0 < V → 0 < Z → k ≠ 0 →
      E = U*L^(-K) → 1 ≤ U*V → Z ≤ 24*U^2*V*L^88/E →
      (∫ ξ : EuclideanSpace ℝ (Fin 3), ‖weight A L U V E Z k ξ‖) ≤ L^C := by
  have ha : 0 ≤ typeIIScaleEnvelopeExponent K (K+89) := by
    unfold typeIIScaleEnvelopeExponent
    exact (le_max_right _ _).trans ((le_max_right _ _).trans (le_max_right _ _))
  obtain ⟨C, hC, hb⟩ := typeII_pulled_fourier_polynomial_l1_cost hA ha
  refine ⟨C, hC, ?_⟩
  filter_upwards [hb, eventually_ge_atTop (24:ℝ)] with L hb hL
  intro U V E Z k hU hV hZ hk hE hUV hZbound
  have hp := typeII_localized_parameter_envelope hL hU hV hZ.le hk hE hUV hZbound
  simp_rw [weight_norm A L U V E Z k hU hZ]
  exact hb (typeIIScaleParameters L U V E Z k) hp

theorem integral_weight_le (A L U V E Z : ℝ) (k : ℤ)
    (hU : 0 < U) (hZ : 0 < Z) (T : Set (EuclideanSpace ℝ (Fin 3)))
    (hT : MeasurableSet T) (f : EuclideanSpace ℝ (Fin 3) → ℂ)
    {R : ℝ} (hR : 0 ≤ R) (hf : ∀ ξ ∈ T, ‖f ξ‖ ≤ R) :
    ‖∫ ξ in T, weight A L U V E Z k ξ * f ξ‖ ≤
      (∫ ξ : EuclideanSpace ℝ (Fin 3), ‖weight A L U V E Z k ξ‖) * R := by
  have hi : Integrable (fun ξ => ‖weight A L U V E Z k ξ‖) := by
    simp_rw [weight_norm A L U V E Z k hU hZ]
    exact (typeII_pulled_fourier_integrable A (L^88) (U/(2*(k:ℝ)*E))
      (Z/((k:ℝ)*U*V)) (1/(U*V))).norm
  calc
    _ ≤ ∫ ξ in T, ‖weight A L U V E Z k ξ‖ * R := by
      apply norm_integral_le_of_norm_le (hi.mul_const R).integrableOn
      filter_upwards [ae_restrict_mem hT] with ξ hξ
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_left (hf ξ hξ) (norm_nonneg _)
    _ = (∫ ξ in T, ‖weight A L U V E Z k ξ‖) * R := integral_mul_const _ _
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (setIntegral_le_integral hi (Eventually.of_forall (fun _ => norm_nonneg _))) hR

theorem exists_finite_cutoff_bound {A K : ℝ} (hA : 0 ≤ A) :
    ∃ C : ℝ, 0 < C ∧ ∀ D : ℝ, 0 ≤ D → ∃ F : ℝ, 0 < F ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (U V E Z : ℝ) (k : ℤ), 0 < U → 0 < V → 0 < Z → k ≠ 0 →
      E = U*L^(-K) → 1 ≤ U*V → Z ≤ 24*U^2*V*L^88/E →
      ∀ {ι : Type} (S : Finset ι) (ω : ι → ℂ) (x : ι → Fin 3 → ℝ),
      (∀ i ∈ S, ω i ≠ 0 → (∀ j, 0 < x i j) ∧
        (∀ j, typeIILogCoordinates (x i) ![U,U,Z] j ∈ Set.Icc (-A) A)) →
      ∀ R : ℝ, 0 ≤ R →
      (∀ ξ : EuclideanSpace ℝ (Fin 3), ‖ξ‖ ≤ L^F →
        ‖∑ i ∈ S, ω i * phase (x i) ξ‖ ≤ R) →
      ‖∑ i ∈ S, ω i * (cutoff L V E k (x i) : ℂ)‖ ≤
        L^(-D) * ∑ i ∈ S, ‖ω i‖ + L^C * R := by
  obtain ⟨C, hC, hcost⟩ := exists_weight_l1_bound (K := K) hA
  refine ⟨C, hC, ?_⟩
  intro D hD
  obtain ⟨F, hF, hcut⟩ := exists_finite_coupled_cutoff_separation (K := K) hA hD
  refine ⟨F, hF, ?_⟩
  filter_upwards [hcost, hcut] with L hcost hcut
  intro U V E Z k hU hV hZ hk hE hUV hZbound ι S ω x hx R hR hf
  have he := hcut U V E Z k hU hV hZ hk hE hUV hZbound S ω x hx
  let t := ∫ ξ in {ξ : EuclideanSpace ℝ (Fin 3) | ‖ξ‖ ≤ L^F},
    weight A L U V E Z k ξ * ∑ i ∈ S, ω i * phase (x i) ξ
  have ht : ‖t‖ ≤ L^C * R :=
    (integral_weight_le A L U V E Z k hU hZ _
      (isClosed_le continuous_norm continuous_const).measurableSet _ hR hf).trans
      (mul_le_mul_of_nonneg_right (hcost U V E Z k hU hV hZ hk hE hUV hZbound) hR)
  calc
    _ = ‖((∑ i ∈ S, ω i * (cutoff L V E k (x i) : ℂ))-t)+t‖ := by rw [sub_add_cancel]
    _ ≤ ‖(∑ i ∈ S, ω i * (cutoff L V E k (x i) : ℂ))-t‖+‖t‖ := norm_add_le _ _
    _ ≤ _ := add_le_add he ht

end ThirdTypeIICompact
end

section
/- Direct dyadic character estimates from the compact cutoff bound. -/

open Finset Filter MeasureTheory Real
open scoped Topology ComplexConjugate

namespace ThirdTypeIIEnergy
open Bounty ThirdTypeIICompact

def coordinates (y : TypeIIShiftIndex) : Fin 3 → ℝ :=
  ![(y.2.1.1:ℝ),(y.2.2.1:ℝ),(y.1.2:ℝ)]

noncomputable def amplitude (Z : ℝ) {d : ℕ} (χ : DirichletCharacter ℂ d)
    (α aH : ℕ → ℂ) (y : TypeIIShiftIndex) : ℂ :=
  (typeIISmoothDyadic ((y.1.2:ℝ)/Z):ℂ) * typeIICrossCharacterAmplitude χ α aH y

theorem exists_dyadic_character_bound (K : ℝ) :
    ∃ C : ℝ, 0 < C ∧ ∀ D : ℝ, 0 ≤ D → ∃ F : ℝ, 0 < F ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (U V E Z : ℝ) (k : ℤ), 0 < U → 0 < V → 0 < Z → k ≠ 0 →
      E = U*L^(-K) → 1 ≤ U*V → Z ≤ 24*U^2*V*L^88/E →
      ∀ (M H Zs : Finset ℕ) (α aH : ℕ → ℂ)
        (χ : DirichletCharacter ℂ (2*k.natAbs)),
      (∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U)) →
      (∀ z ∈ Zs, 0 < z ∧ 0 < (z:ℤ)+k) →
      ∀ R : ℝ, 0 ≤ R →
      (∀ ξ : EuclideanSpace ℝ (Fin 3), ‖ξ‖ ≤ L^F →
        ‖∑ y ∈ typeIICrossSlice M H Zs k,
          amplitude Z χ α aH y * phase (coordinates y) ξ‖ ≤ R) →
      ‖∑ y ∈ typeIICrossSlice M H Zs k,
        (typeIISmoothDyadic ((y.1.2:ℝ)/Z):ℂ) *
          typeIIRealShiftWeight
            (fun e n => typeIIEMajorant (L^88) (e/E) * typeIINMajorant (n/V)) α aH y *
          χ (y.2.1.1 : ZMod (2*k.natAbs)) * conj (χ (y.2.2.1 : ZMod (2*k.natAbs)))‖ ≤
        L^(-D) * (∑ z ∈ Zs, factorizationAbsoluteMass M H α aH z *
          factorizationAbsoluteMass M H α aH ((z:ℤ)+k).toNat) + L^C * R := by
  classical
  obtain ⟨C, hC, hbound⟩ := exists_finite_cutoff_bound (A := 1) (K := K) (by norm_num)
  refine ⟨C, hC, ?_⟩
  intro D hD
  obtain ⟨F, hF, hbound⟩ := hbound D hD
  refine ⟨F, hF, ?_⟩
  filter_upwards [hbound, eventually_ge_atTop (1:ℝ)] with L hbound hL
  intro U V E Z k hU hV hZ hk hE hUV hZbound M H Zs α aH χ hM hpos R hR hphase
  have hMpos : ∀ m ∈ M, 0 < m := by
    intro m hm
    exact_mod_cast hU.trans_le (hM m hm).1
  have hgeom : ∀ y ∈ typeIICrossSlice M H Zs k, amplitude Z χ α aH y ≠ 0 →
      (∀ i, 0 < coordinates y i) ∧
      (∀ i, typeIILogCoordinates (coordinates y) ![U,U,Z] i ∈ Set.Icc (-1) 1) := by
    intro y hy hn
    obtain ⟨hks, hpairs⟩ := mem_product.mp (mem_filter.mp hy).1
    obtain ⟨hm, hm'⟩ := mem_product.mp hpairs
    have hmy := hM _ (mem_product.mp hm).1
    have hm'y := hM _ (mem_product.mp hm').1
    have hzy := (hpos _ (mem_product.mp hks).2).1
    have hψ : typeIISmoothDyadic ((y.1.2:ℝ)/Z) ≠ 0 := by
      intro hz
      exact hn (by simp only [amplitude, hz, Complex.ofReal_zero, zero_mul])
    constructor
    · intro i
      fin_cases i
      · exact hU.trans_le hmy.1
      · exact hU.trans_le hm'y.1
      · change (0:ℝ) < (y.1.2:ℝ)
        exact_mod_cast hzy
    · intro i
      fin_cases i
      · exact typeII_factor_two_log_box hU hmy
      · exact typeII_factor_two_log_box hU hm'y
      · exact typeII_smooth_dyadic_log_box hψ
  have hb := hbound U V E Z k hU hV hZ hk hE hUV hZbound
    (typeIICrossSlice M H Zs k) (amplitude Z χ α aH) coordinates hgeom R hR hphase
  have hsum :
      (∑ y ∈ typeIICrossSlice M H Zs k,
        amplitude Z χ α aH y * (cutoff L V E k (coordinates y):ℂ)) =
      ∑ y ∈ typeIICrossSlice M H Zs k,
        (typeIISmoothDyadic ((y.1.2:ℝ)/Z):ℂ) *
          typeIIRealShiftWeight
            (fun e n => typeIIEMajorant (L^88) (e/E) * typeIINMajorant (n/V)) α aH y *
          χ (y.2.1.1 : ZMod (2*k.natAbs)) * conj (χ (y.2.2.1 : ZMod (2*k.natAbs))) := by
    apply sum_congr rfl
    intro y hy
    have hky : y.1.1 = k := mem_singleton.mp (mem_product.mp (mem_product.mp (mem_filter.mp hy).1).1).1
    dsimp only [amplitude, cutoff, coordinates, typeIIRealShiftWeight,
      typeIICrossCharacterAmplitude, typeIIRealE, typeIIRealN]
    rw [hky]
    push_cast
    ring
  rw [hsum] at hb
  apply hb.trans
  apply add_le_add _ le_rfl
  apply mul_le_mul_of_nonneg_left _ (Real.rpow_nonneg (by linarith : 0 ≤ L) _)
  exact typeII_cross_character_absolute_mass_le M H Zs k Z typeIISmoothDyadic α aH χ
    hMpos hk (fun z _ => by rw [abs_of_nonneg (typeII_smooth_dyadic_bounds _).1]; exact (typeII_smooth_dyadic_bounds _).2) hpos

theorem localized_factorization_mass (M H Zs : Finset ℕ) (α aH : ℕ → ℂ)
    (k : ℤ) (Z : ℝ) {A B : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hα : ∀ m ∈ M, ‖α m‖ ≤ A)
    (haH : ∀ h ∈ H, h ≠ 0 → ‖aH h‖ ≤ B*(h.divisors.card:ℝ))
    (hpos : ∀ z ∈ Zs, 0 < z ∧ 0 < (z:ℤ)+k)
    (hloc : ∀ z ∈ Zs, (z:ℝ) ≤ 2*Z) (hk : |(k:ℝ)| ≤ Z) :
    (∑ z ∈ Zs, factorizationAbsoluteMass M H α aH z *
      factorizationAbsoluteMass M H α aH ((z:ℤ)+k).toNat) ≤
      (A*B)^2*(⌈3*Z⌉₊:ℝ)*(1+log (⌈3*Z⌉₊:ℝ))^15 := by
  have hZ : 0 ≤ Z := (abs_nonneg (k:ℝ)).trans hk
  have hN : ∀ z ∈ Zs, z ≤ ⌈3*Z⌉₊ ∧ ((z:ℤ)+k).toNat ≤ ⌈3*Z⌉₊ := by
    intro z hz
    have hc : 3*Z ≤ (⌈3*Z⌉₊:ℝ) := Nat.le_ceil _
    have hzR := hloc z hz
    have hkR := (abs_le.mp hk).2
    constructor
    · exact_mod_cast (show (z:ℝ) ≤ (⌈3*Z⌉₊:ℝ) by linarith)
    · have hi : (z:ℤ)+k ≤ (⌈3*Z⌉₊:ℤ) := by
        exact_mod_cast (show (((z:ℤ)+k:ℤ):ℝ) ≤ (⌈3*Z⌉₊:ℝ) by push_cast; linarith)
      omega
  exact factorization_absolute_cross_moment Zs (fun z => z)
    (fun z => ((z:ℤ)+k).toNat) ⌈3*Z⌉₊ M H α aH hA hB hα haH
    (by intro x _ y _ h; exact h)
    (by
      intro x hx y hy h
      have := (hpos x hx).2
      have := (hpos y hy).2
      change ((x:ℤ)+k).toNat = ((y:ℤ)+k).toNat at h
      omega)
    (fun z hz => Nat.ne_of_gt (hpos z hz).1)
    (by intro z hz; have := (hpos z hz).2; omega)
    (fun z hz => (hN z hz).1) (fun z hz => (hN z hz).2)

theorem exists_dyadic_power_bound (K : ℝ) :
    ∃ C : ℝ, 0 < C ∧ ∀ A B D : ℝ, ∃ F : ℝ, 0 < F ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (U V E Z : ℝ) (k : ℤ), 0 < U → 0 < V → 1 ≤ Z → k ≠ 0 →
      E = U*L^(-K) → 1 ≤ U*V → Z ≤ 24*U^2*V*L^88/E →
      log Z ≤ 3*L → |(k:ℝ)| ≤ Z →
      ∀ (M H Zs : Finset ℕ) (α aH : ℕ → ℂ)
        (χ : DirichletCharacter ℂ (2*k.natAbs)),
      (∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U)) →
      (∀ z ∈ Zs, 0 < z ∧ 0 < (z:ℤ)+k) → (∀ z ∈ Zs, (z:ℝ) ≤ 2*Z) →
      (∀ m ∈ M, ‖α m‖ ≤ L^A) →
      (∀ h ∈ H, h ≠ 0 → ‖aH h‖ ≤ L^B*(h.divisors.card:ℝ)) →
      ∀ R : ℝ, 0 ≤ R →
      (∀ ξ : EuclideanSpace ℝ (Fin 3), ‖ξ‖ ≤ L^F →
        ‖∑ y ∈ typeIICrossSlice M H Zs k,
          amplitude Z χ α aH y * phase (coordinates y) ξ‖ ≤ R) →
      ‖∑ y ∈ typeIICrossSlice M H Zs k,
        (typeIISmoothDyadic ((y.1.2:ℝ)/Z):ℂ) *
          typeIIRealShiftWeight
            (fun e n => typeIIEMajorant (L^88) (e/E) * typeIINMajorant (n/V)) α aH y *
          χ (y.2.1.1 : ZMod (2*k.natAbs)) * conj (χ (y.2.2.1 : ZMod (2*k.natAbs)))‖ ≤
        Z*L^(-D) + L^C * R := by
  obtain ⟨C, hC, hbound⟩ := exists_dyadic_character_bound K
  refine ⟨C, hC, ?_⟩
  intro A B D
  let T := max 0 (D+2*(A+B)+16)
  obtain ⟨F, hF, hbound⟩ := hbound T (le_max_left _ _)
  refine ⟨F, hF, ?_⟩
  filter_upwards [hbound, eventually_localized_divisor_moment_cost (by norm_num : (0:ℝ) ≤ 3),
    eventually_ge_atTop (1:ℝ)] with L hbound hcost hL
  intro U V E Z k hU hV hZ hk hE hUV hZupper hlog hksize
    M H Zs α aH χ hM hpos hloc hα haH R hR hphase
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hZ0 : 0 < Z := zero_lt_one.trans_le hZ
  have hb := hbound U V E Z k hU hV hZ0 hk hE hUV hZupper M H Zs α aH χ hM hpos R hR hphase
  have hm := localized_factorization_mass M H Zs α aH k Z
    (rpow_nonneg hL0.le A) (rpow_nonneg hL0.le B) hα haH hpos hloc hksize
  have hp : (L^A*L^B)^2 = L^(2*(A+B)) := by
    rw [← rpow_add hL0, ← rpow_mul_natCast hL0.le]
    congr 1
    ring
  have hm' : (∑ z ∈ Zs, factorizationAbsoluteMass M H α aH z *
      factorizationAbsoluteMass M H α aH ((z:ℤ)+k).toNat) ≤ Z*L^(2*(A+B)+16) := by
    calc
      _ ≤ (L^A*L^B)^2*(⌈3*Z⌉₊:ℝ)*(1+log (⌈3*Z⌉₊:ℝ))^15 := hm
      _ = L^(2*(A+B))*((⌈3*Z⌉₊:ℝ)*(1+log (⌈3*Z⌉₊:ℝ))^15) := by rw [hp]; ring
      _ ≤ L^(2*(A+B))*(Z*L^(16:ℝ)) :=
        mul_le_mul_of_nonneg_left (hcost Z hZ hlog) (rpow_nonneg hL0.le _)
      _ = _ := by rw [rpow_add hL0]; ring
  have he : L^(-T)*(Z*L^(2*(A+B)+16)) ≤ Z*L^(-D) := by
    calc
      _ = Z*L^(-T+(2*(A+B)+16)) := by rw [rpow_add hL0 (-T) (2*(A+B)+16)]; ring
      _ ≤ _ := mul_le_mul_of_nonneg_left (rpow_le_rpow_of_exponent_le hL
        (by have := le_max_right 0 (D+2*(A+B)+16); dsimp only [T]; linarith)) hZ0.le
  exact hb.trans (add_le_add ((mul_le_mul_of_nonneg_left hm' (rpow_nonneg hL0.le _)).trans he) le_rfl)

end ThirdTypeIIEnergy
end

section
/- The finite spatial phase sum, normalized as a harmonic correlation. -/

open Finset
open scoped ComplexConjugate

namespace CompactTypeIIHarmonic
open Bounty

theorem phase_sum_eq_harmonic
    (Z : ℝ) (k : ℤ) (M H Zs : Finset ℕ)
    (α : ℕ → ℂ) (W : ℕ → ℝ) (B : ℕ → ℂ) (ρ : ℝ)
    (χ : DirichletCharacter ℂ (2*k.natAbs))
    (hM : ∀ m ∈ M, 0 < m) (hk : k ≠ 0) (hZ : 0 < Z)
    (hpos : ∀ z ∈ Zs, 0 < z ∧ 0 < (z : ℤ)+k)
    (ξ : EuclideanSpace ℝ (Fin 3)) :
    (∑ y ∈ typeIICrossSlice M H Zs k,
      ((typeIISmoothDyadic ((y.1.2:ℝ)/Z):ℂ) *
        typeIICrossCharacterAmplitude χ α (typeIISeparatedH W B ρ) y) *
      (∏ i, ((![(y.2.1.1:ℝ),(y.2.2.1:ℝ),(y.1.2:ℝ)] : Fin 3 → ℝ) i : ℂ) ^
        (((2*Real.pi*ξ i : ℝ):ℂ)*Complex.I))) =
    (Z : ℂ) * ∑ z ∈ Zs,
      ((typeIIHarmonicDyadic ((z:ℝ)/Z)/(z:ℝ):ℝ):ℂ) *
        typeIICrossPairCoefficient M H
          (fun m => α m*χ (m : ZMod (2*k.natAbs))) W B ρ
          (2*Real.pi*ξ 0) (2*Real.pi*ξ 1) (2*Real.pi*ξ 2) z
          ((z:ℤ)+k).toNat := by
  classical
  calc
    _ = ∑ y ∈ typeIICrossSlice M H Zs k,
        ((typeIISmoothDyadic ((y.1.2:ℝ)/Z):ℂ) *
          typeIICrossCharacterAmplitude χ α (typeIISeparatedH W B ρ) y) *
        typeIICrossFourierPowers y ξ := by
      apply sum_congr rfl
      intro y hy
      have hy' := mem_product.mp (mem_filter.mp hy).1
      have hm := (mem_product.mp (mem_product.mp hy'.2).1).1
      have hm' := (mem_product.mp (mem_product.mp hy'.2).2).1
      have hz := (mem_product.mp hy'.1).2
      rw [typeII_cross_fourier_powers_eq y (hM _ hm) (hM _ hm') (hpos _ hz).1 ξ]
    _ = ∑ z ∈ Zs, (typeIISmoothDyadic ((z:ℝ)/Z):ℂ) *
        typeIICrossPairCoefficient M H
          (fun m => α m*χ (m : ZMod (2*k.natAbs))) W B ρ
          (2*Real.pi*ξ 0) (2*Real.pi*ξ 1) (2*Real.pi*ξ 2) z
          ((z:ℤ)+k).toNat := by
      rw [typeII_cross_slice_sum_singletons M H Zs k _ hM hk]
      apply sum_congr rfl
      intro z hz
      rw [← typeII_cross_slice_singleton_eq_cross_pair_coefficient M H k z
        ((z:ℤ)+k).toNat (fun m => α m*χ (m : ZMod (2*k.natAbs))) W B ρ
        (2*Real.pi*ξ 0) (2*Real.pi*ξ 1) (2*Real.pi*ξ 2) hM hk
        (Int.toNat_of_nonneg (hpos z hz).2.le).symm, mul_sum]
      apply sum_congr rfl
      intro y hy
      have hzy : y.1.2 = z := mem_singleton.mp
        (mem_product.mp (mem_product.mp (mem_filter.mp hy).1).1).2
      simp only [typeIICrossCharacterAmplitude, typeIICrossFourierPowers, hzy, map_mul]
      ring
    _ = _ := by
      rw [typeII_finite_harmonic_normalization Zs hZ typeIISmoothDyadic
        _ (fun z hz => (hpos z hz).1)]
      rfl

end CompactTypeIIHarmonic
end

section
/- A direct dyadic Type II estimate from the literal harmonic correlation. -/

open Finset Filter MeasureTheory Real
open scoped Topology ComplexConjugate

namespace ThirdTypeIIHarmonic
open Bounty ThirdTypeIICompact ThirdTypeIIEnergy

theorem exists_dyadic_harmonic_bound (K a b D : ℝ) :
    ∃ Q F : ℝ, 0 < Q ∧ 0 < F ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (U V E Z : ℝ) (k : ℤ), 0 < U → 0 < V → 1 ≤ Z → k ≠ 0 →
      E = U*L^(-K) → 1 ≤ U*V → Z ≤ 24*U^2*V*L^88/E →
      log Z ≤ 3*L → |(k:ℝ)| ≤ Z →
      ∀ (M H Zs : Finset ℕ) (α : ℕ → ℂ) (W : ℕ → ℝ) (B : ℕ → ℂ) (ρ : ℝ)
        (χ : DirichletCharacter ℂ (2*k.natAbs)),
      (∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U)) →
      (∀ z ∈ Zs, 0 < z ∧ 0 < (z:ℤ)+k) → (∀ z ∈ Zs, (z:ℝ) ≤ 2*Z) →
      (∀ m ∈ M, ‖α m‖ ≤ L^a) →
      (∀ h ∈ H, h ≠ 0 → ‖typeIISeparatedH W B ρ h‖ ≤ L^b*(h.divisors.card:ℝ)) →
      (∀ ξ : EuclideanSpace ℝ (Fin 3), ‖ξ‖ ≤ L^F →
        ‖∑ z ∈ Zs, ((typeIIHarmonicDyadic ((z:ℝ)/Z)/(z:ℝ):ℝ):ℂ) *
          typeIICrossPairCoefficient M H (fun m => α m*χ (m : ZMod (2*k.natAbs))) W B ρ
            (2*Real.pi*ξ 0) (2*Real.pi*ξ 1) (2*Real.pi*ξ 2) z ((z:ℤ)+k).toNat‖ ≤ L^(-Q)) →
      ‖∑ y ∈ typeIICrossSlice M H Zs k,
        (typeIISmoothDyadic ((y.1.2:ℝ)/Z):ℂ) *
          typeIIRealShiftWeight
            (fun e n => typeIIEMajorant (L^88) (e/E) * typeIINMajorant (n/V))
            α (typeIISeparatedH W B ρ) y *
          χ (y.2.1.1 : ZMod (2*k.natAbs)) * conj (χ (y.2.2.1 : ZMod (2*k.natAbs)))‖ ≤
        Z*L^(-D) := by
  obtain ⟨C, hC, hbound⟩ := exists_dyadic_power_bound K
  obtain ⟨F, hF, hbound⟩ := hbound a b (D+1)
  let Q := max 1 (C+D+1)
  refine ⟨Q, F, lt_of_lt_of_le zero_lt_one (le_max_left _ _), hF, ?_⟩
  filter_upwards [hbound, eventually_ge_atTop (2:ℝ)] with L hbound hL
  intro U V E Z k hU hV hZ hk hE hUV hZupper hlog hksize
    M H Zs α W B ρ χ hM hpos hloc hα haH hcorr
  have hL0 : 0 < L := by linarith
  have hZ0 : 0 < Z := zero_lt_one.trans_le hZ
  have hMpos : ∀ m ∈ M, 0 < m := by
    intro m hm
    exact_mod_cast hU.trans_le (hM m hm).1
  have hphase : ∀ ξ : EuclideanSpace ℝ (Fin 3), ‖ξ‖ ≤ L^F →
      ‖∑ y ∈ typeIICrossSlice M H Zs k,
        amplitude Z χ α (typeIISeparatedH W B ρ) y * phase (coordinates y) ξ‖ ≤ Z*L^(-Q) := by
    intro ξ hξ
    have he := CompactTypeIIHarmonic.phase_sum_eq_harmonic Z k M H Zs α W B ρ χ hMpos hk hZ0 hpos ξ
    change (∑ y ∈ typeIICrossSlice M H Zs k,
      amplitude Z χ α (typeIISeparatedH W B ρ) y * phase (coordinates y) ξ) = _ at he
    rw [he, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hZ0]
    exact mul_le_mul_of_nonneg_left (hcorr ξ hξ) hZ0.le
  have hb := hbound U V E Z k hU hV hZ hk hE hUV hZupper hlog hksize
    M H Zs α (typeIISeparatedH W B ρ) χ hM hpos hloc hα haH (Z*L^(-Q)) (by positivity) hphase
  have hexp : C-Q ≤ -(D+1) := by
    have := le_max_right 1 (C+D+1)
    dsimp only [Q]
    linarith
  have hp : L^C*(Z*L^(-Q)) ≤ Z*L^(-(D+1)) := by
    calc
      _ = Z*L^(C-Q) := by rw [sub_eq_add_neg, rpow_add hL0 C (-Q)]; ring
      _ ≤ _ := mul_le_mul_of_nonneg_left (rpow_le_rpow_of_exponent_le (by linarith) hexp) hZ0.le
  have hsum : Z*L^(-(D+1))+Z*L^(-(D+1)) ≤ Z*L^(-D) := by
    rw [show -(D+1) = -D-1 by ring, rpow_sub hL0, rpow_one]
    calc
      _ = (2/L)*(Z*L^(-D)) := by ring
      _ ≤ _ := mul_le_of_le_one_left (by positivity) ((div_le_one hL0).mpr hL)
  exact hb.trans ((add_le_add le_rfl hp).trans hsum)

end ThirdTypeIIHarmonic
end

section
/- Norm bounds for the finite normalized character and determinant sums. -/

open Finset
open scoped ComplexConjugate

namespace CompactTypeIINormalization
open Bounty

theorem normalized_family_bound {n : ℕ} [NeZero n] {ι : Type*}
    (J : Finset ι) (S : DirichletCharacter ℂ n → ι → ℂ) (δ : ι → ℝ)
    (hS : ∀ χ, ∀ j ∈ J, ‖S χ j‖ ≤ δ j) :
    ‖(1/(n.totient:ℂ)) * ∑ χ, ∑ j ∈ J, S χ j‖ ≤ ∑ j ∈ J, δ j := by
  classical
  have hcard : Fintype.card (DirichletCharacter ℂ n) = n.totient := by
    rw [← Nat.card_eq_fintype_card]
    exact DirichletCharacter.card_eq_totient_of_hasEnoughRootsOfUnity ℂ n
  have hφ : (0:ℝ) < n.totient := by
    exact_mod_cast Nat.totient_pos.mpr (NeZero.pos n)
  rw [norm_mul, norm_div, norm_one, Complex.norm_natCast]
  calc
    _ ≤ (1/(n.totient:ℝ)) * ∑ _χ : DirichletCharacter ℂ n, ∑ j ∈ J, δ j := by
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      apply (norm_sum_le _ _).trans
      apply sum_le_sum
      intro χ _
      exact (norm_sum_le _ _).trans (sum_le_sum (hS χ))
    _ = ∑ j ∈ J, δ j := by simp [hcard, ne_of_gt hφ]

theorem character_slice_bound
    (L U V E : ℝ) (k : ℤ) (M H Zs : Finset ℕ) (α aH : ℕ → ℂ)
    (hL : 0 < L) (hU : 0 < U) (hV : 0 < V) (hE : 0 < E)
    (hUV : 4 ≤ U*V) (hk : k ≠ 0)
    (hM : ∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U))
    (δ : ℕ → ℝ)
    (hδ : ∀ χ : DirichletCharacter ℂ (2*k.natAbs),
      ∀ j ∈ range (typeIISmoothDyadicCount L),
      ‖∑ y ∈ typeIICrossSlice M H Zs k,
        (typeIISmoothDyadic ((y.1.2:ℝ)/typeIISmoothDyadicScale U V E j):ℂ) *
          typeIIRealShiftWeight
            (fun e n => typeIIEMajorant (L^88) (e/E) * typeIINMajorant (n/V)) α aH y *
          χ (y.2.1.1 : ZMod (2*k.natAbs)) * conj (χ (y.2.2.1 : ZMod (2*k.natAbs)))‖ ≤ δ j) :
    ‖typeIIRealCharacterSlice M H Zs k
      (fun e n => typeIIEMajorant (L^88) (e/E) * typeIINMajorant (n/V)) α aH‖ ≤
      ∑ j ∈ range (typeIISmoothDyadicCount L), δ j := by
  classical
  let : NeZero (2*k.natAbs) := ⟨by
    simpa only [ne_eq, mul_eq_zero, OfNat.ofNat_ne_zero, false_or, Int.natAbs_eq_zero] using hk⟩
  rw [typeIIRealCharacterSlice, dite_eq_right hk]
  unfold typeIIRealCharacterAverage
  simp_rw [typeII_majorant_character_dyadic_partition L U V E k M H Zs α aH
    _ hL hU hV hE hUV hM]
  exact normalized_family_bound _ _ δ hδ

theorem signed_interval_norm_le (N : ℕ) (f : ℤ → ℂ) (δ : ℝ)
    (hzero : f 0 = 0)
    (hbound : ∀ k ∈ Icc (-(N:ℤ)) (N:ℤ), k ≠ 0 → ‖f k‖ ≤ δ) :
    ‖∑ k ∈ Icc (-(N:ℤ)) (N:ℤ), f k‖ ≤ (2*(N:ℝ))*δ := by
  classical
  have heq : (∑ k ∈ Icc (-(N:ℤ)) (N:ℤ), f k) =
      ∑ k ∈ (Icc (-(N:ℤ)) (N:ℤ)).filter (fun k => k ≠ 0), f k := by
    rw [sum_filter]
    apply sum_congr rfl
    intro k _
    by_cases hk : k = 0 <;> simp [hk, hzero]
  rw [heq]
  calc
    _ ≤ ∑ _k ∈ (Icc (-(N:ℤ)) (N:ℤ)).filter (fun k => k ≠ 0), δ := by
      apply (norm_sum_le _ _).trans
      exact sum_le_sum (fun k hk => hbound k (mem_filter.mp hk).1 (mem_filter.mp hk).2)
    _ = (2*(N:ℝ))*δ := by simp [signed_interval_nonzero_card]

end CompactTypeIINormalization
end

section
/- A direct bound for the off-diagonal energy from harmonic correlations. -/

open Finset Filter Real
open scoped ComplexConjugate

namespace CompactTypeIIOffDiagonal
open Bounty CompactTypeIINormalization

theorem exists_off_diagonal_harmonic_bound (K a b T : ℝ) :
    ∃ Q F : ℝ, 0 < Q ∧ 0 < F ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (U V E Wrough : ℝ) (N : ℕ), 0 < U → 0 < V → E = U*L^(-K) →
      4 ≤ U*V → max 1 (N:ℝ) ≤ typeIISmoothDyadicScale U V E 0 →
      log (24*U^2*V*L^88/E) ≤ 3*L →
      (2*U)/(2*(E/(2*L^88))) ≤ (N:ℝ) → (N:ℝ) ≤ Wrough → 2 ≤ Wrough →
      ∀ (M H : Finset ℕ) (α : ℕ → ℂ) (W : ℕ → ℝ) (B : ℕ → ℂ) (ρ : ℝ),
      (∀ m ∈ M, (m:ℝ) ∈ Set.Icc U (2*U)) → (∀ h ∈ H, 0 < h) →
      (∀ m ∈ M, ‖α m‖ ≤ L^a) →
      (∀ h ∈ H, h ≠ 0 → ‖typeIISeparatedH W B ρ h‖ ≤ L^b*(h.divisors.card:ℝ)) →
      (∀ m ∈ M, α m ≠ 0 → ∀ p ∈ m.primeFactors, Wrough < (p:ℝ)) →
      (∀ k ∈ Icc (-(N:ℤ)) (N:ℤ), k ≠ 0 →
        ∀ j ∈ range (typeIISmoothDyadicCount L),
        ∀ χ : DirichletCharacter ℂ (2*k.natAbs),
        ∀ ξ : EuclideanSpace ℝ (Fin 3), ‖ξ‖ ≤ L^F →
        let M₀ := M.filter (fun m => α m ≠ 0)
        let Z := typeIISmoothDyadicScale U V E j
        let Zs := typeIIActiveCrossZ Z k (Icc 0 (M₀.sup id * H.sup id))
        ‖∑ z ∈ Zs, ((typeIIHarmonicDyadic ((z:ℝ)/Z)/(z:ℝ):ℝ):ℂ) *
          typeIICrossPairCoefficient M₀ H (fun m => α m*χ (m : ZMod (2*k.natAbs))) W B ρ
            (2*Real.pi*ξ 0) (2*Real.pi*ξ 1) (2*Real.pi*ξ 2) z ((z:ℤ)+k).toNat‖ ≤ L^(-Q)) →
      typeIIOffDiagonalEnergy (Icc ⌈E/(2*L^88)⌉₊ ⌊2*E⌋₊)
        (Icc ⌈V/2⌉₊ ⌊3*V⌋₊) M H
        (fun e n => typeIIEMajorant (L^88) ((e:ℝ)/E) * typeIINMajorant ((n:ℝ)/V))
        α (typeIISeparatedH W B ρ) ≤
      (2*(N:ℝ)) * (∑ j ∈ range (typeIISmoothDyadicCount L), typeIISmoothDyadicScale U V E j) * L^(-T) := by
  classical
  obtain ⟨Q, F, hQ, hF, hbound⟩ := ThirdTypeIIHarmonic.exists_dyadic_harmonic_bound K a b T
  refine ⟨Q, F, hQ, hF, ?_⟩
  filter_upwards [hbound, eventually_ge_atTop (1:ℝ)] with L hbound hL
  intro U V E Wrough N hU hV hE hUV hbase hlog hN hNW hWr M H α W B ρ
    hM hH hα haH hrough hcorr
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hE0 : 0 < E := by rw [hE]; positivity
  let M₀ := M.filter (fun m => α m ≠ 0)
  let Zs := Icc 0 (M₀.sup id * H.sup id)
  let η := fun e n : ℝ => typeIIEMajorant (L^88) (e/E) * typeIINMajorant (n/V)
  let aH := typeIISeparatedH W B ρ
  have hM₀ : ∀ m ∈ M₀, (m:ℝ) ∈ Set.Icc U (2*U) := by
    intro m hm
    exact hM m (mem_filter.mp hm).1
  have hslices : ∀ k ∈ Icc (-(N:ℤ)) (N:ℤ), k ≠ 0 →
      ‖typeIIRealCharacterSlice M₀ H Zs k η α aH‖ ≤
        ∑ j ∈ range (typeIISmoothDyadicCount L), typeIISmoothDyadicScale U V E j * L^(-T) := by
    intro k hk hk0
    apply character_slice_bound L U V E k M₀ H Zs α aH hL0 hU hV hE0 hUV hk0 hM₀
    intro χ j hj
    let Z := typeIISmoothDyadicScale U V E j
    have hZ0 : 0 < Z := typeII_smooth_dyadic_scale_pos hU hV hE0 j
    have hZmono : typeIISmoothDyadicScale U V E 0 ≤ Z :=
      typeII_smooth_dyadic_scale_mono_zero hU hV hE0 j
    have hZ1 : 1 ≤ Z := (le_trans (le_max_left _ _) hbase).trans hZmono
    have hZN : (N:ℝ) ≤ Z := (le_trans (le_max_right _ _) hbase).trans hZmono
    have hZupper : Z ≤ 24*U^2*V*L^88/E :=
      typeII_smooth_dyadic_scale_le hL hU hV hE0 (mem_range.mp hj)
    have hZlog : log Z ≤ 3*L := (Real.log_le_log hZ0 hZupper).trans hlog
    have hksize : |(k:ℝ)| ≤ Z := by
      have hi : |k| ≤ (N:ℤ) := abs_le.mpr (mem_Icc.mp hk)
      have hr : |(k:ℝ)| ≤ (N:ℝ) := by exact_mod_cast hi
      exact hr.trans hZN
    have hb := hbound U V E Z k hU hV hZ1 hk0 hE (by linarith) hZupper hZlog hksize
      M₀ H (typeIIActiveCrossZ Z k Zs) α W B ρ χ hM₀
      (fun z hz => ⟨(mem_filter.mp hz).2.1, (mem_filter.mp hz).2.2.1⟩)
      (fun z hz => (mem_filter.mp hz).2.2.2)
      (fun m hm => hα m (mem_filter.mp hm).1) haH
      (hcorr k hk hk0 j hj χ)
