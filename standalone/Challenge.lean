open MeasureTheory
open scoped FourierTransform

namespace Bounty

noncomputable def localMellinTransform (h : ℝ) (g : ℝ → ℂ) (u : ℝ) : ℂ :=
  (Real.exp (-u) : ℂ) * ∫ t : ℝ, Complex.exp (((-t*u:ℝ):ℂ)*Complex.I) *
    𝓕 localMellinKernelSchwartz (Real.exp (-u)*(h*t)/(2*Real.pi)) * g t

theorem local_mellin_amplitude_joint_continuous (j : ℕ) :
    Continuous (Function.uncurry (localMellinAmplitude j)) := by
  have hr := (typeII_smooth_rho_contDiff 2).continuous
  have hK := (𝓕 localMellinKernelSchwartz).continuous
  have hw : Continuous (fun p : ℝ × ℝ => (1+p.1^2)^((j:ℝ)/4)) :=
    (by fun_prop : Continuous (fun p : ℝ × ℝ => 1+p.1^2)).rpow_const
      (fun p => Or.inl (by positivity))
  unfold localMellinAmplitude Function.uncurry
  fun_prop

theorem local_mellin_amplitude_weight_cancel (j : ℕ) (h t u : ℝ) :
    localMellinAmplitude (4*j) (h*t) u * (mellinDecayWeight j h t : ℂ) =
      ((typeIISmoothRho 2 u * Real.exp (-u) : ℝ) : ℂ) *
        𝓕 localMellinKernelSchwartz (Real.exp (-u)*(h*t)/(2*Real.pi)) := by
  have he : (((4*j:ℕ):ℝ)/4) = (j:ℝ) := by push_cast; ring
  simp only [localMellinAmplitude, he, Real.rpow_natCast, mellinDecayWeight,
    Complex.ofReal_inv]
  rw [mul_assoc, mul_inv_cancel₀ (by exact_mod_cast (ne_of_gt (pow_pos (by positivity : 0 < 1+(h*t)^2) j))), mul_one]

theorem local_mellin_transform_weighted_representation (j : ℕ) (h : ℝ)
    (g : ℝ → ℂ) (u : ℝ) :
    (typeIISmoothRho 2 u : ℂ) * localMellinTransform h g u =
      ∫ t : ℝ, Complex.exp (((-t*u:ℝ):ℂ)*Complex.I) *
        localMellinAmplitude (4*j) (h*t) u * ((mellinDecayWeight j h t : ℂ) * g t) := by
  unfold localMellinTransform
  rw [← integral_const_mul, ← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with t
  have hc := local_mellin_amplitude_weight_cancel j h t u
  rw [Complex.ofReal_mul] at hc
  linear_combination -Complex.exp (((-t*u:ℝ):ℂ)*Complex.I) * g t * hc

theorem local_mellin_rho_one_on_log_dyad {u : ℝ}
    (hu : u ∈ Set.Icc (Real.log (1/2:ℝ)) (Real.log 3)) :
    typeIISmoothRho 2 u = 1 := by
  apply typeII_smooth_rho_eq_one
  have h2 := Real.log_le_sub_one_of_pos (by norm_num : (0:ℝ) < 2)
  have h3 := Real.log_le_sub_one_of_pos (by norm_num : (0:ℝ) < 3)
  have hh : Real.log (1/2:ℝ) = -Real.log 2 := by rw [one_div, Real.log_inv]
  constructor <;> linarith [hu.1, hu.2]

end Bounty
