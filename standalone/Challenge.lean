open Finset
theorem totient_sieve_prime_product_not_coprime (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (n : ℕ) :
    ¬ Nat.Coprime (∏ p ∈ P, p) n ↔ ∃ p ∈ P, p ∣ n := by
  constructor
  · intro h
    by_contra hnot
    apply h
    apply Nat.coprime_prod_left_iff.mpr
    intro p hp
    apply (hP p hp).coprime_iff_not_dvd.mpr
    intro hd
    exact hnot ⟨p, hp, hd⟩
  · rintro ⟨p, hp, hpn⟩ hc
    exact ((hP p hp).coprime_iff_not_dvd.mp
      ((Nat.coprime_prod_left_iff.mp hc) p hp)) hpn

theorem totient_sieve_noncoprime_divisor_mass (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (n : ℕ) :
    (∑ d ∈ (∏ p ∈ P, p).divisors.filter (fun d => ¬ Nat.Coprime d n),
      1 / (Nat.totient d : ℝ)) ≤
      (∑ p ∈ P.filter (fun p => p ∣ n), 1 / ((p : ℝ) - 1)) *
        ∏ p ∈ P, (1 + 1 / ((p : ℝ) - 1)) := by
  classical
  calc
    _ = ∑ S ∈ P.powerset,
        if ¬ Nat.Coprime (∏ p ∈ S, p) n then
          1 / (Nat.totient (∏ p ∈ S, p) : ℝ) else 0 := by
      rw [sum_filter, totient_sieve_sum_divisors_eq_subsets P hP]
    _ = ∑ S ∈ P.powerset.filter (fun S => ∃ p ∈ S, p ∣ n),
        ∏ p ∈ S, 1 / ((p : ℝ) - 1) := by
      rw [sum_filter]
      apply sum_congr rfl
      intro S hS
      have hSP : ∀ p ∈ S, p.Prime := fun p hp => hP p ((mem_powerset.mp hS) hp)
      simp only [totient_sieve_prime_product_not_coprime S hSP n,
        totient_sieve_prime_product_reciprocal S hSP]
    _ ≤ _ := by
      apply totient_sieve_subset_union_bound
      intro p hp
      have hple : (1 : ℝ) < p := by exact_mod_cast (hP p hp).one_lt
      positivity

theorem totient_sieve_noncoprime_mass_of_subset (P M : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime)
    (hM : M ⊆ (∏ p ∈ P, p).divisors) (n : ℕ) :
    (∑ d ∈ M.filter (fun d => ¬ Nat.Coprime d n), 1 / (Nat.totient d : ℝ)) ≤
      (∑ p ∈ P.filter (fun p => p ∣ n), 1 / ((p : ℝ) - 1)) *
        ∏ p ∈ P, (1 + 1 / ((p : ℝ) - 1)) := by
  apply le_trans _ (totient_sieve_noncoprime_divisor_mass P hP n)
  apply sum_le_sum_of_subset_of_nonneg (filter_subset_filter _ hM)
  intro d _ _
  positivity

