/- A finite collection of positive natural numbers below a real bound has at most
the natural floor of that bound many elements. -/
theorem card_positive_nat_finset_le_floor {S : Finset ℕ} {x : ℝ}
    (hpos : ∀ p ∈ S, 0 < p) (hbound : ∀ p ∈ S, (p : ℝ) ≤ x) :
    S.card ≤ ⌊x⌋₊ := by
  have hsub : S ⊆ Finset.Icc 1 ⌊x⌋₊ := by
    intro p hp
    exact Finset.mem_Icc.mpr ⟨hpos p hp, Nat.le_floor (hbound p hp)⟩
  simpa using Finset.card_le_card hsub

theorem prime_interval_card_le_floor {S : Finset ℕ} {y : ℝ}
    (hprime : ∀ p ∈ S, p.Prime) (hbound : ∀ p ∈ S, (p : ℝ) ≤ 5 * y) :
    S.card ≤ ⌊5 * y⌋₊ :=
  card_positive_nat_finset_le_floor (fun p hp => (hprime p hp).pos) hbound

theorem prime_interval_card_le {S : Finset ℕ} {y : ℝ} (hy : 0 ≤ y)
    (hprime : ∀ p ∈ S, p.Prime) (hbound : ∀ p ∈ S, (p : ℝ) ≤ 5 * y) :
    (S.card : ℝ) ≤ 5 * y := by
  have hcard : (S.card : ℝ) ≤ (⌊5 * y⌋₊ : ℝ) := by
    exact_mod_cast prime_interval_card_le_floor hprime hbound
  exact hcard.trans (Nat.floor_le (by positivity))

/- The integer smooth-modulus estimate with floors removed from its conclusion. -/
theorem log_primePredecessorLCM_le_real {P : Finset ℕ} {y δ : ℝ}
    (hy : 1 ≤ y) (hprime : ∀ p ∈ P, p.Prime)
    (hbound : ∀ p ∈ P, (p : ℝ) ≤ 5 * y)
    (hsmooth : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → (q : ℝ) ≤ y ^ δ) :
    Real.log (primePredecessorLCM P : ℝ) ≤ y ^ δ * Real.log (5 * y) := by
  have hypos : 0 < y := lt_of_lt_of_le zero_lt_one hy
  have hB : 1 ≤ ⌊5 * y⌋₊ := Nat.le_floor (by norm_num; linarith)
  have hbound' : ∀ p ∈ P, p - 1 ≤ ⌊5 * y⌋₊ := by
    intro p hp
    exact (Nat.sub_le p 1).trans (Nat.le_floor (hbound p hp))
  have hsmooth' : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → q ≤ ⌊y ^ δ⌋₊ := by
    intro p hp q hq hdiv
    exact Nat.le_floor (hsmooth p hp q hq hdiv)
  have hlog := log_primePredecessorLCM_le hprime hB hbound' hsmooth'
  have hBpos : (0 : ℝ) < (⌊5 * y⌋₊ : ℕ) := by exact_mod_cast hB
  have hBreal : (⌊5 * y⌋₊ : ℝ) ≤ 5 * y := Nat.floor_le (by positivity)
  have hKreal : (⌊y ^ δ⌋₊ : ℝ) ≤ y ^ δ :=
    Nat.floor_le (Real.rpow_nonneg hypos.le _)
  have hlogB : 0 ≤ Real.log (⌊5 * y⌋₊ : ℝ) := by
    apply Real.log_nonneg
    exact_mod_cast hB
  exact hlog.trans (mul_le_mul hKreal (Real.log_le_log hBpos hBreal)
    hlogB (Real.rpow_nonneg hypos.le _))



end

