open Finset
section

variable
  {G I : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P : G → Finset ℕ}
  [sharedInstance4 : ∀ p : PhysicalPrime P, NeZero p.2.val]
  {J ell : ℕ}
  (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hprime : ∀ g p, p ∈ P g → p.Prime)
  (V : G → ℝ)

include G I sharedInstance1 sharedInstance2 P sharedInstance4 J ell hP hprime V

theorem physical_residue_path_norm_expectation  (patterns : Finset I) (C : I → G → Finset (Fin J))
    {q : ℝ} (hq : 0 ≤ q) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (N : ℕ) (L₀ : PhysicalMarkLists P J ell)
    (p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    (∑ r : PhysicalResidues P, (∏ a : PhysicalPrime P, 1 / (a.2.val : ℝ)) *
      ‖physicalResidueBarePathTerm V patterns C q ζ k K (N + 1) r L₀ p‖) =
      ‖physicalBareWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L₀ p) (N + 1)‖ *
        physicalFiniteResidueExpectation C q k N L₀ p := by
  let L := finitePathMarks L₀ p
  let a := finitePathLabels p
  let W := fun r : PhysicalResidues P => ∏ j ∈ range (N + 2),
    physicalResidueVertexWeight (L j) (physicalEndpointSchedule q (N + 1) j)
      (physicalTranslateResidues r (physicalBareOffset C k a L (N + 1) j))
  have hW (r : PhysicalResidues P) : 0 ≤ W r :=
    physical_residue_vertex_product_nonneg _ _ _ _
      (fun j _ => physical_endpoint_schedule_nonneg hq (N + 1) j) r
  have he (r : PhysicalResidues P) :
      ‖physicalResidueBarePathTerm V patterns C q ζ k K (N + 1) r L₀ p‖ =
        ‖physicalBareWalkScalar V patterns C ζ K a L (N + 1)‖ * W r := by
    rw [physical_residue_finite_path_factor hP hprime V patterns C hq ζ k K]
    change ‖physicalBareWalkScalar V patterns C ζ K a L (N + 1) * (W r : ℂ)‖ = _
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hW r)]
  simp only [he]
  calc
    _ = ‖physicalBareWalkScalar V patterns C ζ K a L (N + 1)‖ *
        ∑ r : PhysicalResidues P, (∏ a : PhysicalPrime P, 1 / (a.2.val : ℝ)) * W r := by
      rw [mul_sum]
      apply sum_congr rfl
      intro r _
      ring
    _ = _ := congrArg (fun z => ‖physicalBareWalkScalar V patterns C ζ K a L (N + 1)‖ * z)
      (physical_residue_vertex_expectation hP hprime L (range (N + 2))
        (physicalBareOffset C k a L (N + 1)) (physicalEndpointSchedule q (N + 1)))

theorem physical_residue_expected_walk_mass  (patterns : Finset I) (C : I → G → Finset (Fin J))
    {q : ℝ} (hq : 0 ≤ q) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (N : ℕ) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    (∑ x : PhysicalBareResidueState P J ell, physicalResidueInitialMass V x *
      ∑ p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
        ‖physicalResidueBarePathTerm V patterns C q ζ k K (N + 1) x.1 x.2 p‖) =
      physicalStateMass V J ell * ∑ L₀ : PhysicalMarkLists P J ell,
        ∑ p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
          ‖physicalBareWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L₀ p) (N + 1)‖ *
            physicalFiniteResidueExpectation C q k N L₀ p := by
  classical
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  let F := fun (r : PhysicalResidues P) (L : PhysicalMarkLists P J ell) =>
    ∑ p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
      ‖physicalResidueBarePathTerm V patterns C q ζ k K (N + 1) r L p‖
  have hF : ∀ r L, ¬ physicalResidueMarksValid r L → F r L = 0 := by
    intro r L h
    apply sum_eq_zero
    intro p _
    rw [physical_residue_bare_path_term_zero_of_invalid V patterns C q ζ k K N r L p h, norm_zero]
  change (∑ x : PhysicalBareResidueState P J ell, physicalResidueInitialMass V x * F x.1 x.2) = _
  rw [physical_residue_initial_mass_sum_of_supported V F hF]
  congr 1
  apply sum_congr rfl
  intro L₀ _
  simp only [F, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro p _
  exact physical_residue_path_norm_expectation hP hprime V patterns C hq ζ k K N L₀ p

theorem physical_expected_walk_mass_bound  (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (patterns : Finset I) (C : I → G → Finset (Fin J))
    {q : ℝ} (hq : 0 ≤ q) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (H : ℝ) (hH : 0 ≤ H) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    (∀ j (x : PhysicalBareResidueState P J ell),
      (∑ y : PhysicalBareResidueState P J ell, ∑ a : PhysicalEdgeLabels P J ell patterns C,
        ‖physicalResidueLabeledCoeff V patterns C q (ζ j) (k j) (K j) a x y‖) ≤ H) →
    ∀ N : ℕ,
      physicalStateMass V J ell * ∑ L₀ : PhysicalMarkLists P J ell,
        ∑ p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
          ‖physicalBareWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L₀ p) (N + 1)‖ *
            physicalFiniteResidueExpectation C q k N L₀ p ≤ H^(N + 1) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro hrow N
  rw [← physical_residue_expected_walk_mass hP hprime V patterns C hq ζ k K N]
  exact physical_residue_bare_path_mass_bound V hV hMass patterns C q ζ k K H hH hrow (N + 1)

/- Integer-return paths are a subset of unrestricted residue walks.
This is the exact nonnegative mass needed to sum the CRT error estimates. -/
theorem physical_expected_return_mass_bound  (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (patterns : Finset I) (C : I → G → Finset (Fin J))
    {q : ℝ} (hq : 0 ≤ q) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (H : ℝ) (hH : 0 ≤ H) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    (∀ j (x : PhysicalBareResidueState P J ell),
      (∑ y : PhysicalBareResidueState P J ell, ∑ a : PhysicalEdgeLabels P J ell patterns C,
        ‖physicalResidueLabeledCoeff V patterns C q (ζ j) (k j) (K j) a x y‖) ≤ H) →
    ∀ N : ℕ,
      physicalStateMass V J ell * ∑ L₀ : PhysicalMarkLists P J ell,
        ∑ p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
          ‖physicalBareReturnScalar V patterns C ζ k K (finitePathLabels p) (finitePathMarks L₀ p) (N + 1)‖ *
            physicalFiniteResidueExpectation C q k N L₀ p ≤ H^(N + 1) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  intro hrow N
  calc
    _ ≤ physicalStateMass V J ell * ∑ L₀ : PhysicalMarkLists P J ell,
        ∑ p : Fin (N + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
          ‖physicalBareWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L₀ p) (N + 1)‖ *
            physicalFiniteResidueExpectation C q k N L₀ p := by
      apply mul_le_mul_of_nonneg_left _ (physical_state_mass_pos V hV J ell).le
      apply sum_le_sum
      intro L₀ _
      apply sum_le_sum
      intro p _
      exact mul_le_mul_of_nonneg_right
        (physical_bare_return_scalar_norm_le V patterns C ζ k K (finitePathLabels p) (finitePathMarks L₀ p) (N + 1))
        (physical_finite_residue_expectation_nonneg hP hprime C hq k N L₀ p)
    _ ≤ _ := physical_expected_walk_mass_bound hP hprime V hV hMass patterns C hq ζ k K H hH hrow N

end

