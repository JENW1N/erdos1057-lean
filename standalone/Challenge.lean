/- The common forest mask is an exact causal factor on original paths, starting from the actual initial prime labels. -/

open Finset Classical
namespace Bounty
section Factor
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))

noncomputable def fullMixedCommonForestHistoryGain (t : ℕ) (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P)) : ℝ :=
  if ht : t < steps.length then
    if steps.get ⟨t, ht⟩ = tag then
      if birthForestStageCondition (fullMixedCommonIndexStage M B steps) (Fin.succ ⟨t, ht⟩)
        (fullMixedCommonStepHistoryUpdate n S B A Δ D steps t tag s e history) code then 1 else 0
    else 0
  else 0




theorem full_mixed_common_forest_history_gain_owner (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D (steps.get u) s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P)) :
    fullMixedCommonForestHistoryGain n S B A Δ D steps code u.val (steps.get u) s e history =
      if birthForestStageCondition (fullMixedCommonIndexStage M B steps) u.succ
        (fullMixedCommonHistoryWrite n S B A Δ D steps u s e history) code then 1 else 0 := by
  unfold fullMixedCommonForestHistoryGain
  rw [dif_pos u.isLt, if_pos rfl, full_mixed_common_step_history_update_owner]

theorem full_mixed_common_forest_history_factor
    (hcode : ∀ i, fullMixedCommonIndexStage M B steps i = 0 → code i = none)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P)) :
    finiteEventHistoryFactor (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullMixedCommonStepHistoryUpdate n S B A Δ D steps)
      (fullMixedCommonForestHistoryGain n S B A Δ D steps code) 0 steps s p
      (fullMixedCommonHistorySeed n B steps s history) =
    if birthForestCompatible
      (fun i => fullMixedCommonBirthPerformed n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i))
      (fun i => fullMixedCommonBirthLabel n S B A Δ D steps s p (fullMixedCommonBirthOrder M B steps i)) code
      then 1 else 0 := by
  rw [finite_event_history_factor_eq_prod]
  trans (∏ u : Fin steps.length,
    if birthForestStageCondition (fullMixedCommonIndexStage M B steps) u.succ
      (fullMixedCommonPathHistory n S B A Δ D steps s p history (u.val + 1)) code then (1 : ℝ) else 0)
  · apply prod_congr rfl
    intro u _
    dsimp only
    rw [Nat.zero_add,
      full_mixed_common_path_history_at n S B A Δ D steps s p history u.val (Nat.le_of_lt u.isLt),
      full_mixed_common_forest_history_gain_owner,
      full_mixed_common_path_history_write]
  · rw [prod_condition_indicators]
    simp only [← full_mixed_common_forest_compatible_iff_history_stages n S B A Δ D steps s p history code hcode]

end Factor
