def cubicTwoSupplement : (_root_.OAI.ActualEisensteinCubic.O)→*ℂ where
  toFun n:=
    letI := cubicTwoIdeal_isMaximal
    (actualSextic cubicTwoIdeal cubicTwoIdeal_good ^ 2) (Ideal.Quotient.mk cubicTwoIdeal n)
  map_one' := by simp
  map_mul' x y := by simp only [map_mul]

def quadraticTwoSupplement : (_root_.OAI.ActualEisensteinCubic.O)→*ℂ :=
  InitialMeanSquare.normCharacter (ZMod.χ₈.ringHomComp (Int.castRingHom ℂ))

def twoSupplement : (_root_.OAI.ActualEisensteinCubic.O)→*ℂ := cubicTwoSupplement^2*quadraticTwoSupplement

lemma cubicTwoSupplement_norm (n:(_root_.OAI.ActualEisensteinCubic.O)) : ‖cubicTwoSupplement n‖≤1 := by
  letI := cubicTwoIdeal_isMaximal
  let : Fintype ((_root_.OAI.ActualEisensteinCubic.O)⧸cubicTwoIdeal) := ActualEisensteinCubic.quotientFintype cubicTwoIdeal
  change ‖(actualSextic cubicTwoIdeal cubicTwoIdeal_good ^ 2)
    (Ideal.Quotient.mk cubicTwoIdeal n)‖≤1
  exact FiniteRayExpansion.norm_char_le_one _ _

lemma twoSupplement_norm (n:(_root_.OAI.ActualEisensteinCubic.O)) : ‖twoSupplement n‖≤1 := by
  change ‖cubicTwoSupplement n^2*quadraticTwoSupplement n‖≤1
  rw [norm_mul,norm_pow]
  apply (mul_le_of_le_one_left (norm_nonneg _)
    _).trans (InitialMeanSquare.normCharacter_norm_le_one _ n)
  exact pow_le_one₀ (norm_nonneg _) (cubicTwoSupplement_norm n)

lemma cubicTwoSupplement_periodic (x y:(_root_.OAI.ActualEisensteinCubic.O)) (hxy:x-y∈Ideal.span {(8:(_root_.OAI.ActualEisensteinCubic.O))}) :
    cubicTwoSupplement x=cubicTwoSupplement y := by
  letI := cubicTwoIdeal_isMaximal
  have h2:x-y∈cubicTwoIdeal:=by
    obtain ⟨k,hk⟩:=Ideal.mem_span_singleton.mp hxy
    apply Ideal.mem_span_singleton.mpr
    refine ⟨-4*k,?_⟩
    change x-y=(-2:(_root_.OAI.ActualEisensteinCubic.O))*(-4*k)
    rw [hk]
    ring
  change (actualSextic cubicTwoIdeal cubicTwoIdeal_good ^ 2) (Ideal.Quotient.mk cubicTwoIdeal x)=
    (actualSextic cubicTwoIdeal cubicTwoIdeal_good ^ 2) (Ideal.Quotient.mk cubicTwoIdeal y)
  rw [Ideal.Quotient.eq.mpr h2]

lemma twoSupplement_periodic :
    CanonicalCoefficientClass.FactorsModulo (Ideal.span {(8:(_root_.OAI.ActualEisensteinCubic.O))}) twoSupplement := by
  intro x y hxy
  change cubicTwoSupplement x^2*quadraticTwoSupplement x=
    cubicTwoSupplement y^2*quadraticTwoSupplement y
  rw [cubicTwoSupplement_periodic x y hxy]
