section

/- On valid edge outputs, promoted labels already in the ledger add no births. -/

open Finset
open scoped Classical
namespace Bounty

theorem unrestricted_target_ledger_union {P Z : Type*} [DecidableEq P] {t N : ℕ}
    (H : Finset P) (old : Fin N → Z) (label : Z → P)
    (promotions : Finset (Fin t)) {eligible : Finset (Fin N)}
    (e : promotions ↪ ↥eligible) (fresh : UnrestrictedFreshLabels P promotions)
    (hold : ∀ j, label (old j) ∈ H) :
    H ∪ univ.image (unrestrictedEdgeTarget old label promotions e fresh) =
      H ∪ univ.image fresh := by
  ext p
  simp only [mem_union, mem_image, mem_univ, true_and]
  constructor
  · rintro (hp | ⟨i, rfl⟩)
    · exact Or.inl hp
    · by_cases hi : i ∈ promotions
      · left
        simpa only [unrestrictedEdgeTarget, unrestrictedTargetLabels, dif_pos hi]
          using hold (e ⟨i, hi⟩).val
      · right
        exact ⟨⟨i, hi⟩, by simp only [unrestrictedEdgeTarget, unrestrictedTargetLabels, dif_neg hi]⟩
  · rintro (hp | ⟨i, rfl⟩)
    · exact Or.inl hp
    · right
      exact ⟨i.val, by simp only [unrestrictedEdgeTarget, unrestrictedTargetLabels, dif_neg i.property]⟩

theorem bounded_edge_ledger_union_of_output_le {P : Type*} [DecidableEq P]
    (n : P → ℕ) (Δ D : ℤ) (t B : ℕ) (H : Finset P)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s)
    (hold : ∀ i, (s.2.2 i).1 ∈ H)
    (hout : (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
      (unrestrictedResidueTransport n Δ) e.1 e.2.1 e.2.2.1).1 ≤ B) :
    H ∪ univ.image (unrestrictedBoundedEventTarget n Δ D t B s e).1 =
      H ∪ univ.image e.2.2.2 := by
  simp only [unrestrictedBoundedEventTarget, dif_pos hout]
  exact unrestricted_target_ledger_union H s.2.2 Sigma.fst e.2.1 e.2.2.1 e.2.2.2 hold

theorem bounded_edge_ledger_union_of_nonzero {P : Type*} [DecidableEq P]
    (n : P → ℕ) (Δ D : ℤ) (t B : ℕ) (H : Finset P)
    (μ : P → ℝ) (ρ V : ℝ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s)
    (hold : ∀ i, (s.2.2 i).1 ∈ H)
    (hw : unrestrictedBoundedEventWeight n Δ D μ ρ V t B s e ≠ 0) :
    H ∪ univ.image (unrestrictedBoundedEventTarget n Δ D t B s e).1 =
      H ∪ univ.image e.2.2.2 := by
  apply bounded_edge_ledger_union_of_output_le n Δ D t B H s e hold
  by_contra h
  apply hw
  simp only [unrestrictedBoundedEventWeight, h, and_false, if_false]

end Bounty
end

section

/- The exact baseline for the endpoint damping schedule in a physical root path. -/

open Finset
namespace Bounty

noncomputable def physicalEndpointBaseline (q : ℝ) (edges p : ℕ) : ℝ :=
  1 - (∑ j ∈ range (edges + 1), (1 - physicalEndpointSchedule q edges j)) / (p : ℝ)

section

variable
  {q : ℝ}
  (hq0 : 0 ≤ q)
  (hq1 : q ≤ 1)

include q hq0 hq1

theorem physical_endpoint_damping_sum_nonneg 
    (edges : ℕ) :
    0 ≤ ∑ j ∈ range (edges + 1), (1 - physicalEndpointSchedule q edges j) := by
  apply sum_nonneg
  intro j hj
  exact sub_nonneg.mpr (physical_endpoint_schedule_unit hq0 hq1 edges j).2

theorem physical_endpoint_damping_sum_le 
    (edges : ℕ) :
    (∑ j ∈ range (edges + 1), (1 - physicalEndpointSchedule q edges j)) ≤ edges + 1 := by
  calc
    _ ≤ ∑ _j ∈ range (edges + 1), (1 : ℝ) := by
      apply sum_le_sum
      intro j hj
      linarith [(physical_endpoint_schedule_unit hq0 hq1 edges j).1]
    _ = _ := by simp

theorem physical_endpoint_baseline_bounds 
    (edges p : ℕ) (hp : 0 < p) (hsize : 2 * (edges + 1) ≤ p) :
    1 / 2 ≤ physicalEndpointBaseline q edges p ∧ physicalEndpointBaseline q edges p ≤ 1 := by
  apply memory_baseline_bounds (physical_endpoint_damping_sum_nonneg hq0 hq1 edges)
    (by exact_mod_cast hp)
  have hsize' : (2 : ℝ) * (edges + 1) ≤ p := by exact_mod_cast hsize
  linarith [physical_endpoint_damping_sum_le hq0 hq1 edges]

theorem physical_endpoint_baseline_pos 
    (edges p : ℕ) (hp : 0 < p) (hsize : 2 * (edges + 1) ≤ p) :
    0 < physicalEndpointBaseline q edges p := by
  linarith [(physical_endpoint_baseline_bounds hq0 hq1 edges p hp hsize).1]

end


end Bounty
end

section

/- Injective encoding preserves equality and distinctness of present optional labels. -/

namespace Bounty

theorem optional_encoded_eq_iff {α : Type*} (encode : α → ℤ)
    (hencode : Function.Injective encode) (a b : Option α)
    (ha : a.isSome = true) (hb : b.isSome = true) :
    (a.map encode).getD 0 = (b.map encode).getD 0 ↔ a = b := by
  cases a with
  | none => cases ha
  | some a =>
    cases b with
    | none => cases hb
    | some b =>
      simpa only [Option.map_some, Option.getD_some, Option.some.injEq] using
        hencode.eq_iff

theorem birth_values_distinct_option_equiv_iff {ι α : Type*} {m : ℕ}
    (e : Fin m ≃ ι) (label : ι → Option α) (performed : ι → Prop)
    (hperformed : ∀ a, performed a ↔ (label a).isSome = true)
    (encode : α → ℤ) (hencode : Function.Injective encode) :
    birthValuesDistinct (fun i => performed (e i))
      (fun i => ((label (e i)).map encode).getD 0) ↔
      Set.InjOn label {a | performed a} := by
  constructor
  · intro h a ha b hb hab
    have hai : performed (e (e.symm a)) := by simpa only [e.apply_symm_apply] using (show performed a from ha)
    have hbi : performed (e (e.symm b)) := by simpa only [e.apply_symm_apply] using (show performed b from hb)
    have hi := h hai hbi (show ((label (e (e.symm a))).map encode).getD 0 =
        ((label (e (e.symm b))).map encode).getD 0 from by
      simp only [e.apply_symm_apply, hab])
    exact e.symm.injective hi
  · intro h i hi j hj hij
    apply e.injective
    apply h hi hj
    exact (optional_encoded_eq_iff encode hencode _ _
      ((hperformed _).mp hi) ((hperformed _).mp hj)).mp hij

end Bounty

namespace Bounty

theorem optional_label_injOn_iff_same_some {ι α : Type*}
    (label : ι → Option α) (performed : ι → Prop)
    (hperformed : ∀ a, performed a ↔ (label a).isSome = true) :
    Set.InjOn label {a | performed a} ↔
      ∀ a b z, label a = some z → label b = some z → a = b := by
  constructor
  · intro h a b z ha hb
    apply h
    · apply (hperformed a).mpr
      simp only [ha, Option.isSome_some]
    · apply (hperformed b).mpr
      simp only [hb, Option.isSome_some]
    · exact ha.trans hb.symm
  · intro h a ha b _ hab
    cases hl : label a with
    | none =>
      have hp := (hperformed a).mp ha
      simp only [hl, Option.isSome_none, Bool.false_eq_true] at hp
    | some z => exact h a b z hl (hab.symm.trans hl)

end Bounty
end

