private theorem zero_removed_tsum (f : RootNotationPrimitiveRows03.O → ℂ) :
    (∑' h : RootNotationPrimitiveRows03.O, if h = 0 then 0 else f h) = ∑' h : {h : RootNotationPrimitiveRows03.O // h ≠ 0}, f h.val := by
  rw [← tsum_subtype_eq_of_support_subset (s := {h : RootNotationPrimitiveRows03.O | h ≠ 0}) (by
    intro h hh hz
    subst h
    exact hh (by simp))]
