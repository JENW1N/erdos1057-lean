section

/- Unit coefficients embed the actual shorter divisor convolutions in the fourfold estimate. -/

open Finset Filter

namespace Bounty

theorem divisor_unit_convolution (f : ℕ → ℂ) {n : ℕ} (hn : n ≠ 0) :
    (∑ d ∈ n.divisors, (if d = 1 then (1 : ℂ) else 0)*f (n/d)) = f n := by
  classical
  rw [sum_eq_single 1]
  · simp only [ite_true, Nat.div_one, one_mul]
  · intro b _ hb
    rw [if_neg hb,zero_mul]
  · intro hnot
    exact False.elim (hnot (Nat.mem_divisors.mpr ⟨one_dvd n,hn⟩))

theorem endpoint_four_unit_left (α β γ : ℕ → ℂ) {n : ℕ} (hn : n ≠ 0) :
    endpointFourConvolution (fun d => if d = 1 then 1 else 0) α β γ n =
      endpointTripleConvolution α β γ n := by
  exact divisor_unit_convolution _ hn

theorem endpoint_triple_unit_left (β γ : ℕ → ℂ) {n : ℕ} (hn : n ≠ 0) :
    endpointTripleConvolution (fun d => if d = 1 then 1 else 0) β γ n =
      ∑ d ∈ n.divisors, β d*γ (n/d) := by
  classical
  unfold endpointTripleConvolution
  rw [sum_eq_single 1]
  · simp only [ite_true, Nat.div_one, one_mul]
  · intro b _ hb
    simp only [if_neg hb,zero_mul,sum_const_zero]
  · intro hnot
    exact False.elim (hnot (Nat.mem_divisors.mpr ⟨one_dvd n,hn⟩))

end Bounty
