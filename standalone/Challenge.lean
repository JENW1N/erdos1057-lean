/- The same bound measured against the original vectors before tail averaging. -/
theorem finite_signed_ideal_block_envelope {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ y, μ i y = 1)
    (U V : Finset I) (k : (∀ i, X i) → ℂ) (hk : ∀ x, ‖k x‖ ≤ 1)
    (K : Finset I → Finset I → (∀ i, X i) → (∀ i, X i) → ℂ)
    (f g : (∀ i, X i) → ℂ) (a b θA θB : ℝ)
    (hf : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) ≤ a)
    (hg : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) ≤ b)
    (hA : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ U U.toList f)) ≤
      θA * a)
    (hB : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ V V.toList g)) ≤
      θB * b)
    (hzero : ∀ S ∈ U.powerset, ∀ T ∈ V.powerset,
      ∀ A ∈ cleanNonemptySubsets U, ∀ B ∈ cleanNonemptySubsets V,
        ¬(A ⊆ U \ S ∧ B ⊆ V \ T) →
        cleanKernelPairing (finiteProductWeight μ) (K A B)
          (finiteCoordinateComponent μ S U.toList f)
          (finiteCoordinateComponent μ T V.toList g) = 0)
    (ε : ℝ) (hε : 0 ≤ ε)
    (herr : ∀ S ∈ U.powerset, ∀ T ∈ V.powerset,
      ∀ A ∈ cleanNonemptySubsets (U \ S), ∀ B ∈ cleanNonemptySubsets (V \ T),
        ‖cleanKernelPairing (finiteProductWeight μ) (K A B)
            (finiteCoordinateComponent μ S U.toList f)
            (finiteCoordinateComponent μ T V.toList g) -
          cleanRawPairing (finiteProductWeight μ) k
            (finiteCoordinateComponent μ S U.toList f)
            (finiteCoordinateComponent μ T V.toList g)‖ ≤
        ε * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ)
          (finiteCoordinateComponent μ S U.toList f)) *
          Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ)
            (finiteCoordinateComponent μ T V.toList g))) :
    ‖cleanRawPairing (finiteProductWeight μ) k f g -
      ∑ A ∈ cleanNonemptySubsets U, ∑ B ∈ cleanNonemptySubsets V,
        (-1 : ℂ) ^ (A.card + B.card) * cleanKernelPairing (finiteProductWeight μ) (K A B) f g‖ ≤
      (θA + θB + (3 : ℝ) ^ (U.card + V.card) * ε) * a * b := by
  have hc := finite_probe_signed_cancellation_bound μ hμ hmass U V k K f g hzero ε hε herr
  have he := finite_exceptional_pairing_envelope μ hμ hmass U V k hk f g a b θA θB hf hg hA hB
  have ha : 0 ≤ a := (Real.sqrt_nonneg _).trans hf
  have hab := mul_le_mul hf hg (Real.sqrt_nonneg _) ha
  have hscale : (3 : ℝ) ^ (U.card + V.card) * ε *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) ≤
      (3 : ℝ) ^ (U.card + V.card) * ε * a * b := by
    have hn : 0 ≤ (3 : ℝ) ^ (U.card + V.card) * ε := mul_nonneg (by positivity) hε
    simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hab hn
  calc
    _ ≤ _ := hc
    _ ≤ (θA + θB) * a * b + (3 : ℝ) ^ (U.card + V.card) * ε * a * b := add_le_add he hscale
    _ = _ := by ring
end

