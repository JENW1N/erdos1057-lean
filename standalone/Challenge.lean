/- Both adjacent active-slot averages absorb the physical/canonical encoding
change. The initial forbidden sets are fixed throughout the averages. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_mixed_clean_initial_projected_reencode {S G : Type*}
    [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (initial : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ θ ρ : ℝ) (k : ℤ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r))
    (hPs : ∀ s p, p ∈ Ps s → 0 < p) (hP : ∀ g p, p ∈ P g → 0 < p) :
    cleanFullMemoryActiveMap (physicalMixedCleanInitialAction initial V b C ζ θ ρ k K d
      (cleanFullMemoryActiveMap f)) =
    cleanFullMemoryActiveMap (cleanFullMemoryInitialEventAction initial V b C ζ θ ρ k
      (canonicalMixedEdgeD C d) K d (cleanFullMemoryActiveMap f)) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  have hin : (fun y r => cleanFullMemoryActiveMap f
      ((fullActivePermutation (cleanPhysicalSlotChange C)).symm y) r) =
      cleanFullMemoryActiveMap f := by
    funext y r
    exact fullActiveAverage_invariant (fun z => f z r)
      (fun g => (cleanPhysicalSlotChange C g).symm) y
  have hs : ∀ r, ProductMemorySymmetric (fun x => cleanFullMemoryActiveMap f x r) :=
    fun r => fullActiveAverage_symmetric (fun x => f x r) (hf r)
  have he (r : PhysicalResidues Ps) :
      (fun x => physicalMixedCleanInitialAction initial V b C ζ θ ρ k K d
        (cleanFullMemoryActiveMap f) (fullActivePermutation (cleanPhysicalSlotChange C) x) r) =
      (fun x => cleanFullMemoryInitialEventAction initial V b C ζ θ ρ k
        (canonicalMixedEdgeD C d) K d (cleanFullMemoryActiveMap f) x r) := by
    funext x
    have h := physical_mixed_clean_initial_action_reencode initial V b C ζ θ ρ k K d
      (cleanFullMemoryActiveMap f) hs hPs hP x r
    rw [hin] at h
    exact h
  funext x r
  have ha := fullActiveAverage_absorb_input_permutation
    (fun y => physicalMixedCleanInitialAction initial V b C ζ θ ρ k K d
      (cleanFullMemoryActiveMap f) y r) (cleanPhysicalSlotChange C)
  rw [he r] at ha
  exact (congrFun ha x).symm

end Bounty
