/- A genuine mixed-measure promotion rarity estimate. The finite choice
index can jointly encode small-source permutations and fixed auxiliary
draws. Only the scalar eligible-position probability remains as input;
all per-choice operator bounds are proved for the actual capped events. -/

open Finset
open scoped Classical

namespace Bounty

theorem exists_physical_small_big_promotion_average_energy_bound
    {q vs : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (S G Q : Type) [Fintype S] [DecidableEq S]
      [Fintype G] [DecidableEq G] [Fintype Q]
      (Ps : S → Finset ℕ) [∀ p : PhysicalPrime Ps, NeZero p.2.val]
      (P : G → Type) [∀ g, Fintype (P g)] (n : ∀ g, P g → ℕ)
      [∀ g p, NeZero (n g p)] (J : ℕ) (M : G → ℕ)
      (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
      (Δ D : Q → PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
      (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
      (kbig : Q → SharedActiveLabels P shared → ℤ)
      (Vs : S → ℝ), (∀ s, vs ≤ Vs s) →
      ∀ (_aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
        (v vmin vmax : ℝ), 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g p, 0 ≤ μ g p) → (∀ g, ∑ p, μ g p ≤ 2) →
      ∀ (T : ℕ), (∀ g, (shared g)ᶜ.card ≤ T) →
      ∀ (π : Q → ℝ), (∀ a, 0 ≤ π a) → (∑ a, π a ≤ 1) →
      ∀ (σ : Q → PhysicalPermutations S J ell)
        (good : PhysicalSmallBigState Ps J ell
          (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → Prop)
        (Φ : ∀ a, ∀ s : PhysicalSmallBigState Ps J ell
          (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
          PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B (Δ a) (D a)) s → ℂ)
        (H : ℝ), 0 ≤ H → (∀ a s e, ‖Φ a s e‖ ≤ H) →
      ∀ (δ : ℝ), 0 ≤ δ →
      (∀ s, good s → (∑ a, if physicalSmallBigEligible n shared B (Δ a) (D a)
        (physicalSmallBigPermutation (σ a) s) then π a else 0) ≤ δ) →
      ∀ (F : PhysicalSmallBigState Ps J ell
        (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ),
      (∀ s, ProductMemorySymmetric (fun x => F (s, x))) →
      physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (fun s => ∑ a, (π a : ℂ) * (if good s then
          physicalSmallBigFullPhasedAction n shared B (Δ a) (D a) μ ρ V (kbig a) Vs q
            (fun y e => if ∃ g, (e.2.2 g).2.1.Nonempty then Φ a y e else 0) F
            (physicalSmallBigPermutation (σ a) s) else 0)) ≤
        δ * (H ^ 2 * (A ^ (2 * Fintype.card S) *
          unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G)) *
          physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_small_big_phased_energy_bound hq0 hq1 hvs ell
  refine ⟨A, hA, ?_⟩
  intro S G Q _ dS _ dG _
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro Ps _ P _ n _ J M shared B Δ D μ ρ V kbig Vs hVs aux
    v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht π hπ hπmass σ good Φ H hH hΦ
    δ hδ hrare F hF
  refine physical_small_big_sparse_permutation_energy_le Vs (fun s => hvs.trans_le (hVs s))
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)) π hπ hπmass σ good
    (fun a => physicalSmallBigEligible n shared B (Δ a) (D a)) _ ?_ hδ ?_ hrare F ?_
  · intro a s hno
    exact physical_small_big_promoting_zero n shared B (Δ a) (D a) μ ρ V (kbig a) Vs q
      (Φ a) F s hno
  · exact mul_nonneg (sq_nonneg H) (mul_nonneg (pow_nonneg (zero_le_one.trans hA) _)
      (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _))
  · intro a
    apply hbound S G Ps P n J M shared B (Δ a) (D a) μ ρ V (kbig a) Vs hVs aux
      v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht _ H hH _ F hF
    intro s e
    split_ifs
    · exact hΦ a s e
    · simpa only [norm_zero] using hH

end Bounty
end

