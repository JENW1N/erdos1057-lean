section

/- The actual large P-part contribution, including all rough shifted divisors. -/

open Finset Filter Real

namespace Bounty

noncomputable def candidateLargePRoughDivisorMass (c L q : ℝ) (r jStar : ℕ) (X : ℝ) : ℝ :=
  ∑ u ∈ (arithmeticProductWindow 1 (exp L)).filter
    (fun u => X < (primePoolPart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) u : ℝ)),
      candidateCoefficient c L q r jStar u * ((roughDivisors (exp (sqrt L)) (2*u+1)).card : ℝ)

theorem arithmetic_window_rough_divisors_bound {L : ℝ} (hL : log 33 ≤ L)
    {u : ℕ} (hu : u ∈ arithmeticProductWindow 1 (exp L)) :
    ((roughDivisors (exp (sqrt L)) (2*u+1)).card : ℝ) ≤ exp ((2*log 2)*sqrt L) := by
  have hL0 : 0 < L := (log_pos (by norm_num : (1 : ℝ) < 33)).trans_le hL
  have hE : (33 : ℝ) ≤ exp L := (log_le_iff_le_exp (by norm_num)).mp hL
  have huhi : (u : ℝ) ≤ 16*exp L := by
    simpa only [one_mul] using ((mem_arithmeticProductWindow_iff one_ne_zero (exp L)).mp hu).2
  apply roughDivisors_card_le_exp_sqrt hL0 (by omega : 2*u+1 ≠ 0)
  calc
    ((2*u+1 : ℕ) : ℝ) = 2*(u : ℝ)+1 := by norm_cast
    _ ≤ 33*exp L := by linarith
    _ ≤ exp L*exp L := mul_le_mul_of_nonneg_right hE (exp_pos _).le
    _ = exp (2*L) := by rw [← exp_add]; congr 1; ring

theorem candidate_large_P_rough_mass_le {c L q : ℝ} (hq : 0 ≤ q) (hL : log 33 ≤ L)
    (r jStar : ℕ) (X : ℝ) :
    candidateLargePRoughDivisorMass c L q r jStar X ≤
      candidateLargePWindowMass c L q r jStar X * exp ((2*log 2)*sqrt L) := by
  unfold candidateLargePRoughDivisorMass candidateLargePWindowMass
  rw [sum_mul]
  apply sum_le_sum
  intro u hu
  exact mul_le_mul_of_nonneg_left (arithmetic_window_rough_divisors_bound hL (mem_filter.mp hu).1)
    (candidate_coefficient_nonneg c L hq r jStar u)

theorem exists_candidate_large_P_rough_exp_bound {c q : ℝ} (hc : 0 < c)
    (hq0 : 0 ≤ q) (hq1 : q < 1) (r : ℕ) (κ : ℝ) :
    ∃ C : ℝ, ∀ jStar : ℕ, ∀ᶠ L : ℝ in atTop,
      candidateLargePRoughDivisorMass c L q r jStar (exp (κ*L)) ≤
        16*exp L*exp (-κ*L^(3/5 : ℝ))*L^C*exp ((2*log 2)*sqrt L) := by
  obtain ⟨CP, hP⟩ := exists_candidate_marked_smooth_tail_exp_bound (κ := κ) hc hq0 hq1 1
  obtain ⟨CQ, hCQ, hQ⟩ := exists_candidate_Q_harmonic_polynomial_bounds hc r
  refine ⟨CP+CQ, ?_⟩
  intro jStar
  filter_upwards [hP, hQ jStar, eventually_candidate_Q_weight_free_support hc r,
    eventually_ge_atTop (log 33)] with L hp hq hfree hL
  have hL0 : 0 < L := (log_pos (by norm_num : (1 : ℝ) < 33)).trans_le hL
  have htail := candidate_large_P_window_le_tail (mul_nonneg hc.le hL0.le) hq0 r jStar
    (exp (κ*L)) (hfree jStar)
  have hQ0 : 0 ≤ candidateQHarmonicMass c L r jStar :=
    tsum_nonneg (fun n => div_nonneg (candidate_Q_weight_nonneg c L r jStar n) (Nat.cast_nonneg n))
  calc
    _ ≤ (16*exp L*candidateMarkedSmoothTail c L q 1 (exp (κ*L))*
        candidateQHarmonicMass c L r jStar)*exp ((2*log 2)*sqrt L) :=
      (candidate_large_P_rough_mass_le hq0 hL r jStar _).trans
        (mul_le_mul_of_nonneg_right htail (exp_pos _).le)
    _ ≤ (16*exp L*(exp (-κ*L^(3/5 : ℝ))*L^CP)*L^CQ)*exp ((2*log 2)*sqrt L) := by
      apply mul_le_mul_of_nonneg_right _ (exp_pos _).le
      exact mul_le_mul (mul_le_mul_of_nonneg_left hp (by positivity)) hq.2 hQ0 (by positivity)
    _ = _ := by rw [rpow_add hL0]; ring

theorem eventually_candidate_large_P_rough_power_saving {c q κ : ℝ} (hc : 0 < c)
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hκ : 0 < κ) (r jStar : ℕ) (D : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      candidateLargePRoughDivisorMass c L q r jStar (exp (κ*L)) ≤ exp L*L^(-D) := by
  obtain ⟨C, hC⟩ := exists_candidate_large_P_rough_exp_bound hc hq0 hq1 r κ
  have hK : 0 ≤ (2 : ℝ)*log 2 := by positivity
  filter_upwards [hC jStar, eventually_exp_neg_rpow_mul_rpow_mul_exp_sqrt_le
    (by norm_num : (1/2 : ℝ) < 3/5) hκ hK C (D+1),
    eventually_ge_atTop (16 : ℝ)] with L hmass hdecay hL
  have hL0 : 0 < L := by linarith
  calc
    _ ≤ 16*exp L*((exp (-κ*L^(3/5 : ℝ))*L^C)*exp ((2*log 2)*sqrt L)) := by
      convert hmass using 1
      ring
    _ ≤ 16*exp L*L^(-(D+1)) := mul_le_mul_of_nonneg_left hdecay (by positivity)
    _ = (16/L)*(exp L*L^(-D)) := by
      rw [show -(D+1) = -D+(-1) by ring, rpow_add hL0, rpow_neg_one]
      ring
    _ ≤ exp L*L^(-D) := by
      have hh : 16/L ≤ 1 := (div_le_one hL0).mpr hL
      exact mul_le_of_le_one_left (by positivity) hh

end Bounty
end

