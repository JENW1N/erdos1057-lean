  intro i _ hi
  exact full_mixed_common_none_owner_empty B steps u htag i hi.1

theorem full_mixed_common_forest_history_gain_none (u : Fin steps.length) (htag : steps.get u = none)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D none s)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P)) :
    fullMixedCommonForestHistoryGain n S B A Δ D steps code u.val none s e history = 1 := by
  rw [full_mixed_common_forest_history_gain_tagged n S B A Δ D steps code u none htag]
  apply if_pos
  intro i hi
  exact False.elim (full_mixed_common_none_owner_empty B steps u htag i hi)
