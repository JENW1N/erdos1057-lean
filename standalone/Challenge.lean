open Finset Filter
theorem exists_candidate_marked_weight_rpow_bound {c q : ℝ}
    (hc : 0 < c) (hq0 : 0 ≤ q) (hq1 : q < 1) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop, ∀ u : ℤ,
      0 ≤ markedDivisorWeight (candidatePIndices c L) (candidatePBand (c * L)) q
        (fun j => ∑ p ∈ candidatePBand (c * L) j, 1 / (p : ℝ)) (fun _ => 1) u ∧
      markedDivisorWeight (candidatePIndices c L) (candidatePBand (c * L)) q
        (fun j => ∑ p ∈ candidatePBand (c * L) j, 1 / (p : ℝ)) (fun _ => 1) u ≤ L^C := by
  obtain ⟨v, V, hv, hV, hpool⟩ := exists_candidate_P_pool_bounds hc
  refine ⟨(2 / (5 * Real.log 2)) * Real.log (markedDivisorBound q v 1),
    mul_nonneg (by positivity) (Real.log_nonneg (one_le_markedDivisorBound q v 1)), ?_⟩
  filter_upwards [hpool] with L hp
  rcases hp with ⟨hL, _, _, hcard, _, hdata⟩
  intro u
  constructor
  · exact marked_divisor_weight_nonneg _ _ hq0 _ _
      (fun _ _ => sum_nonneg (fun _ _ => by positivity)) u
  · exact marked_divisor_weight_le_rpow _ _ hq0 hq1 hv (zero_lt_one.trans_le hL)
      _ _ 1 (fun j hj => (hdata j hj).1) (fun _ _ => le_rfl) hcard u

theorem eventually_rpow_mul_exp_sqrt_le (C K : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      L^C * Real.exp (K * Real.sqrt L) ≤ Real.exp ((K + 1) * Real.sqrt L) := by
  filter_upwards [eventually_mul_rpow_log_add_le_rpow
    (a := (0 : ℝ)) (b := (1/2 : ℝ)) (c := (1 : ℝ))
    (by norm_num) (by norm_num) (by norm_num) C 0,
    eventually_gt_atTop (0 : ℝ)] with L h hL
  simp only [Real.rpow_zero, mul_one, add_zero, one_mul] at h
  rw [Real.rpow_def_of_pos hL, ← Real.exp_add]
  apply Real.exp_le_exp.mpr
  rw [Real.sqrt_eq_rpow]
  nlinarith

/- Any nonnegative factor with a square-root exponential bound can be
multiplied by the actual marked weight with just one extra unit in its exponent. -/
theorem eventually_candidate_marked_multiplier_bound {c q : ℝ}
    (hc : 0 < c) (hq0 : 0 ≤ q) (hq1 : q < 1) (K : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (u : ℤ) (a : ℝ), 0 ≤ a →
      a ≤ Real.exp (K * Real.sqrt L) →
      a * markedDivisorWeight (candidatePIndices c L) (candidatePBand (c * L)) q
        (fun j => ∑ p ∈ candidatePBand (c * L) j, 1 / (p : ℝ)) (fun _ => 1) u ≤
          Real.exp ((K + 1) * Real.sqrt L) := by
  obtain ⟨C, hC, hweight⟩ := exists_candidate_marked_weight_rpow_bound hc hq0 hq1
  filter_upwards [hweight, eventually_rpow_mul_exp_sqrt_le C K] with L hw habsorb
  intro u a ha habound
  calc
    _ ≤ Real.exp (K * Real.sqrt L) * L^C :=
      mul_le_mul habound (hw u).2 (hw u).1 (Real.exp_pos _).le
    _ = L^C * Real.exp (K * Real.sqrt L) := mul_comm _ _
    _ ≤ _ := habsorb
end

