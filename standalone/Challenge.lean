section

/- The static initial-ledger exclusion costs a square-root rare-target
error. Its complete finite-family budget still has arbitrary power decay. -/

open Filter

namespace Bounty

noncomputable def repeatedBigInitialError (s m J ell Q : ℕ) (xi P v : ℝ) : ℝ :=
  (1 + (2 : ℝ) ^ (m * s) * (((Q * Q : ℕ) : ℝ) / xi) ^ 2) *
    Real.sqrt ((s : ℝ) * (((ell + m : ℕ) : ℝ) * ((J + ell : ℕ) : ℝ)) / (v * P))

theorem repeated_big_initial_error_sq_le (s m J ell Q : ℕ)
    (xi P v : ℝ) (hP : 0 < P) (hv : 0 < v) (hell : ell ≤ m) :
    (repeatedBigInitialError s m J ell Q xi P v) ^ 2 ≤
      2 * repeatedBigNumericError s (2 * m) J ell (Q * Q) (xi ^ 2) 0 P v := by
  let u := (2 : ℝ) ^ (m * s) * (((Q * Q : ℕ) : ℝ) / xi) ^ 2
  let delta := (s : ℝ) * (((ell + m : ℕ) : ℝ) * ((J + ell : ℕ) : ℝ)) / (v * P)
  let d := (s : ℝ) * (((2 * m : ℕ) : ℝ) * (2 * ((J + ell : ℕ) : ℝ))) / (v * P)
  have hd : 0 ≤ delta := by dsimp [delta]; positivity
  have hdelta : delta ≤ d := by
    dsimp [delta, d]
    apply div_le_div_of_nonneg_right _ (mul_pos hv hP).le
    apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg s)
    have hm : ((ell + m : ℕ) : ℝ) ≤ 2 * ((2 * m : ℕ) : ℝ) := by
      exact_mod_cast (show ell + m ≤ 2 * (2 * m) by omega)
    have hh := mul_le_mul_of_nonneg_right hm (Nat.cast_nonneg (J + ell))
    nlinarith
  have hcoef : (1 + u) ^ 2 ≤ 2 * (1 + u ^ 2) := by nlinarith [sq_nonneg (u - 1)]
  have hpow : ((2 : ℝ) ^ (m * s)) ^ 2 = (2 : ℝ) ^ ((2 * m) * s) := by
    rw [← pow_mul]
    congr 1
    ring
  have hratio : ((((Q * Q : ℕ) : ℝ) / xi) ^ 2) =
      (((Q * Q) * (Q * Q) : ℕ) : ℝ) / (xi ^ 2) := by
    rw [div_pow]
    simp only [pow_two, Nat.cast_mul]
  have hu : u ^ 2 = (2 : ℝ) ^ ((2 * m) * s) *
      ((((Q * Q) * (Q * Q) : ℕ) : ℝ) / (xi ^ 2)) ^ 2 := by
    dsimp [u]
    rw [mul_pow, hpow, hratio]
  have hleft : (repeatedBigInitialError s m J ell Q xi P v) ^ 2 = (1 + u) ^ 2 * delta := by
    unfold repeatedBigInitialError
    rw [mul_pow, Real.sq_sqrt hd]
  have hright : repeatedBigNumericError s (2 * m) J ell (Q * Q) (xi ^ 2) 0 P v =
      (1 + u ^ 2) * d := by
    rw [hu]
    simp only [repeatedBigNumericError, mul_zero, zero_div, zero_add, d]
  rw [hleft, hright]
  have hc := mul_le_mul hcoef hdelta hd (by positivity : 0 ≤ 2 * (1 + u ^ 2))
  nlinarith

theorem eventually_repeated_big_initial_error_small (m J ell : ℕ)
    {a q x v c : ℝ} (ha : 0 ≤ a) (hq : 0 ≤ q) (hx : 0 ≤ x)
    (hv : 0 < v) (hc : 0 < c) (hell : ell ≤ m) (E : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (s Q : ℕ) (xi P : ℝ),
      (s : ℝ) ≤ a * Real.log L → (Q : ℝ) ≤ L ^ q →
      L ^ (-x) ≤ xi → Real.exp (L ^ c) ≤ P →
      repeatedBigInitialError s m J ell Q xi P v ≤ L ^ (-E) := by
  filter_upwards [eventually_repeated_big_numeric_error_small (2 * m) J ell ha
      (show 0 ≤ 2 * q by positivity) (show 0 ≤ 2 * x by positivity)
      (show (0 : ℝ) ≤ 0 by norm_num) hv hc (2 * E + 2),
    eventually_ge_atTop (2 : ℝ)] with L herr hL
  intro s Q xi P hs hQ hxi hP
  have hL0 : 0 < L := by linarith
  have hP0 : 0 < P := (Real.exp_pos _).trans_le hP
  have hQ' : ((Q * Q : ℕ) : ℝ) ≤ L ^ (2 * q) := by
    calc
      _ = (Q : ℝ) ^ 2 := by simp [pow_two]
      _ ≤ (L ^ q) ^ 2 := pow_le_pow_left₀ (Nat.cast_nonneg _) hQ 2
      _ = _ := by rw [← Real.rpow_natCast, ← Real.rpow_mul hL0.le]; congr 1; ring
  have hxi' : L ^ (-(2 * x)) ≤ xi ^ 2 := by
    calc
      _ = (L ^ (-x)) ^ (2 : ℕ) := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul hL0.le]
        congr 1
        ring
      _ ≤ _ := pow_le_pow_left₀ (Real.rpow_nonneg hL0.le _) hxi 2
  have hn := herr s (Q * Q) (xi ^ 2) 0 P hs hQ' hxi' le_rfl (by positivity) hP
  have hsquare := (repeated_big_initial_error_sq_le s m J ell Q xi P v hP0 hv hell).trans
    (mul_le_mul_of_nonneg_left hn (by norm_num))
  have hpower : 2 * L ^ (-(2 * E + 2)) ≤ (L ^ (-E)) ^ 2 := by
    have hden : 2 ≤ L ^ (2 : ℕ) := by nlinarith
    rw [show -(2 * E + 2) = (-E) * 2 - 2 by ring,
      Real.rpow_sub hL0, Real.rpow_mul hL0.le,
      ← mul_div_assoc]
    simp only [Real.rpow_two]
    apply (div_le_iff₀ (sq_pos_of_pos hL0)).mpr
    nlinarith [sq_nonneg (L ^ (-E))]
  have hfinal := hsquare.trans hpower
  nlinarith [Real.rpow_pos_of_pos hL0 (-E)]

end Bounty
end

section

/- A uniform harmonic Mellin loss for interval character sums in a dyad. -/

open Finset

namespace Bounty

theorem harmonic_mellin_interval_variation {v Y : ℝ} {m n : ℕ}
    (hY : 0 < Y) (hmn : m < n) (hYm : Y ≤ (m+1 : ℕ)) (hn : (n : ℝ) ≤ 2*Y) :
    ‖harmonicMellinWeight v n‖+
      (∑ i ∈ Ioc m (n-1), ‖harmonicMellinWeight v (i+1)-harmonicMellinWeight v i‖) ≤
      (3+2*|v|)/Y := by
  have hn0 : 0 < (n : ℝ) := Nat.cast_pos.mpr (lt_of_le_of_lt (Nat.zero_le _) hmn)
  have hYn : Y ≤ (n : ℝ) := hYm.trans (Nat.cast_le.mpr hmn)
  have hstep : ∀ i ∈ Ioc m (n-1),
      ‖harmonicMellinWeight v (i+1)-harmonicMellinWeight v i‖ ≤ (1+|v|)/Y^2 := by
    intro i hi
    have hYi : Y ≤ (i : ℝ) := hYm.trans (Nat.cast_le.mpr (mem_Ioc.mp hi).1)
    simpa only [add_sub_cancel_left, mul_one] using
      harmonic_mellin_weight_variation_lower_scale (v := v) hY hYi (show (i : ℝ) ≤ i+1 by linarith)
  have hcard : ((Ioc m (n-1)).card : ℝ) ≤ 2*Y := by
    apply le_trans _ hn
    rw [Nat.card_Ioc]
    exact_mod_cast ((Nat.sub_le (n-1) m).trans (Nat.sub_le n 1))
  calc
    _ ≤ 1/Y+∑ _i ∈ Ioc m (n-1), (1+|v|)/Y^2 := by
      apply add_le_add
      · rw [norm_harmonic_mellin_weight v hn0]
        exact one_div_le_one_div_of_le hY hYn
      · exact sum_le_sum hstep
    _ = 1/Y+((Ioc m (n-1)).card : ℝ)*((1+|v|)/Y^2) := by
      simp only [sum_const, nsmul_eq_mul]
    _ ≤ 1/Y+(2*Y)*((1+|v|)/Y^2) := by gcongr
    _ = _ := by field_simp; ring

theorem norm_harmonic_mellin_interval_sum_le {v Y B : ℝ} {m n : ℕ}
    (g : ℕ → ℂ) (hY : 0 < Y) (hmn : m < n) (hYm : Y ≤ (m+1 : ℕ))
    (hn : (n : ℝ) ≤ 2*Y) (hB : 0 ≤ B)
    (hprefix : ∀ i ∈ Icc m n, ‖∑ j ∈ Ioc m i, g j‖ ≤ B) :
    ‖∑ i ∈ Ioc m n, harmonicMellinWeight v i*g i‖ ≤ ((3+2*|v|)/Y)*B := by
  apply (norm_complex_sum_Ioc_le_of_interval_prefix
    (fun i => harmonicMellinWeight v i) g hmn hprefix).trans
  simpa only [Nat.cast_add, Nat.cast_one] using
    mul_le_mul_of_nonneg_right (harmonic_mellin_interval_variation (v := v) hY hmn hYm hn) hB

end Bounty
end

section

/- Forest constraints on projected labels of the original independent sample coordinates. -/

open Finset Classical

namespace Bounty

noncomputable def finiteLabelMass {Z α : Type*} [Fintype Z] [DecidableEq α]
    (label : Z → α) (w : Z → ℝ) (a : α) : ℝ := ∑ z, if label z = a then w z else 0

theorem finiteLabelMass_nonneg {Z α : Type*} [Fintype Z] [DecidableEq α]
    (label : Z → α) (w : Z → ℝ) (hw : ∀ z, 0 ≤ w z) (a : α) :
    0 ≤ finiteLabelMass label w a := by
  exact sum_nonneg fun z _ => by split_ifs <;> simp_all

theorem finiteLabelMass_total {Z α : Type*} [Fintype Z] [Fintype α] [DecidableEq α]
    (label : Z → α) (w : Z → ℝ) : ∑ a, finiteLabelMass label w a = ∑ z, w z := by
  unfold finiteLabelMass
  rw [sum_comm]
  simp

theorem labeled_product_sum {I : Type*} [Fintype I] [DecidableEq I]
    (Z : I → Type*) [∀ i, Fintype (Z i)] {α : Type*} [Fintype α] [DecidableEq α]
    (label : ∀ i, Z i → α) (w : ∀ i, Z i → ℝ) (F : (I → α) → ℝ) :
    (∑ f : ∀ i, Z i, (∏ i, w i (f i)) * F (fun i => label i (f i))) =
      ∑ a : I → α, (∏ i, finiteLabelMass (label i) (w i) (a i)) * F a := by
  symm
  unfold finiteLabelMass
  simp_rw [Fintype.prod_sum (fun i z => if label i z = _ then w i z else 0), sum_mul]
  rw [sum_comm]
  apply sum_congr rfl
  intro f _
  simp only [prod_ite_zero, mem_univ, forall_const]
  have he (a : I → α) : (∀ i, label i (f i) = a i) ↔ (fun i => label i (f i)) = a :=
    ⟨fun h => funext h, fun h i => congrFun h i⟩
  simp_rw [he, ite_mul, zero_mul]
  exact Fintype.sum_ite_eq _ _

theorem labeled_birth_forest_sum_le {n : ℕ} (Z : Fin n → Type*) [∀ i, Fintype (Z i)]
    {α : Type*} [Fintype α] [DecidableEq α]
    (label : ∀ i, Z i → α) (w : ∀ i, Z i → ℝ) (code : BirthForestCode n)
    (M ε : Fin n → ℝ) (hM : ∀ i, 0 ≤ M i) (hε : ∀ i, 0 ≤ ε i)
    (hw : ∀ i z, 0 ≤ w i z) (hsum : ∀ i, ∑ z, w i z ≤ M i)
    (hatom : ∀ i a, finiteLabelMass (label i) (w i) a ≤ ε i) :
    (∑ f : ∀ i, Z i, if birthForestEqualValues code (fun i => label i (f i)) then
      ∏ i, w i (f i) else 0) ≤ ∏ i, match code i with | none => M i | some _ => ε i := by
  have he := labeled_product_sum Z label w (fun a => if birthForestEqualValues code a then 1 else 0)
  simp only [mul_ite, mul_one, mul_zero] at he
  rw [he]
  have hb := birthForestCausalMass_le_coordinate_costs code
    (fun i _ a => finiteLabelMass (label i) (w i) a) M ε hM hε
    (fun i _ a => finiteLabelMass_nonneg _ _ (hw i) a)
    (fun i _ => (finiteLabelMass_total (label i) (w i)).le.trans (hsum i))
    (fun i _ a => hatom i a)
  apply le_trans ?_ hb
  apply le_of_eq
  unfold birthForestCausalMass birthForestCausalAssignmentMass
  apply sum_congr rfl
  intro f _
  rw [birthForestAssignmentMass_eq]

end Bounty
end

section

/- Reindex actual bounded edge events without changing their birth slots. -/

open Finset Classical
namespace Bounty

noncomputable def residueEligibleReindex {P : Type*} (n : P → ℕ) (Δ D : ℤ)
    {N : ℕ} (old : Fin N → UnrestrictedResidueParticle n) (τ : Equiv.Perm (Fin N)) :
    unrestrictedResidueEligible n Δ D old ≃ unrestrictedResidueEligible n Δ D (old ∘ τ) where
  toFun j := ⟨τ.symm j, by
    rw [unrestricted_residue_eligible_perm, mem_unrestrictedPermutedEligible,
      Equiv.apply_symm_apply]
    exact j.property⟩
  invFun := fun ⟨j, hj⟩ => ⟨τ j, by
    rwa [unrestricted_residue_eligible_perm, mem_unrestrictedPermutedEligible] at hj⟩
  left_inv j := by ext; simp
  right_inv j := by ext; simp

noncomputable def residuePromotionReindex {P I : Type*} (n : P → ℕ) (Δ D : ℤ)
    {N : ℕ} (old : Fin N → UnrestrictedResidueParticle n) (τ : Equiv.Perm (Fin N)) :
    (I ↪ ↥(unrestrictedResidueEligible n Δ D old)) ≃
      (I ↪ ↥(unrestrictedResidueEligible n Δ D (old ∘ τ))) :=
  Equiv.embeddingCongr (Equiv.refl I) (residueEligibleReindex n Δ D old τ)

theorem residuePromotionReindex_val {P I : Type*} (n : P → ℕ) (Δ D : ℤ)
    {N : ℕ} (old : Fin N → UnrestrictedResidueParticle n) (τ : Equiv.Perm (Fin N))
    (e : I ↪ ↥(unrestrictedResidueEligible n Δ D old)) (i : I) :
    (residuePromotionReindex n Δ D old τ e i).val = τ.symm (e i).val := rfl

noncomputable def boundedEdgeMemoryReindex {P : Type*} (n : P → ℕ) (Δ D : ℤ)
    {t B : ℕ} (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (τ : Equiv.Perm (Fin s.2.1.val)) :
    UnrestrictedBoundedEvent n Δ D t B s ≃
      UnrestrictedBoundedEvent n Δ D t B (boundedGhostMemoryPermute s τ) :=
  Equiv.sigmaCongrRight fun _ => Equiv.sigmaCongrRight fun _ =>
    Equiv.prodCongr (residuePromotionReindex n Δ D s.2.2 τ) (Equiv.refl _)

theorem boundedEdgeMemoryReindex_apply {P : Type*} (n : P → ℕ) (Δ D : ℤ)
    {t B : ℕ} (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (τ : Equiv.Perm (Fin s.2.1.val)) (e : UnrestrictedBoundedEvent n Δ D t B s) :
    boundedEdgeMemoryReindex n Δ D s τ e =
      ⟨e.1, e.2.1, residuePromotionReindex n Δ D s.2.2 τ e.2.2.1, e.2.2.2⟩ := rfl

theorem residue_promotion_reindex_survivors {P I : Type*} [Fintype I]
    (n : P → ℕ) (Δ D : ℤ) {N : ℕ} (old : Fin N → UnrestrictedResidueParticle n)
    (τ : Equiv.Perm (Fin N)) (e : I ↪ ↥(unrestrictedResidueEligible n Δ D old)) :
    unrestrictedEdgeSurvivors (residuePromotionReindex n Δ D old τ e) =
      (unrestrictedEdgeSurvivors e).map τ.symm.toEmbedding := by
  have hs : promotionSelectedIndices (residuePromotionReindex n Δ D old τ e) =
      (promotionSelectedIndices e).map τ.symm.toEmbedding := by
    simp only [promotionSelectedIndices, map_map]
    rfl
  rw [unrestrictedEdgeSurvivors, hs]
  simp [unrestrictedEdgeSurvivors, Finset.map_sdiff]

theorem residue_promotion_reindex_memory {P I : Type*} [Fintype I]
    (n : P → ℕ) (Δ D : ℤ) {N b : ℕ} (old : Fin N → UnrestrictedResidueParticle n)
    (τ : Equiv.Perm (Fin N)) (e : I ↪ ↥(unrestrictedResidueEligible n Δ D old))
    (stored : Fin b → UnrestrictedResidueParticle n) :
    orderedTupleOccupancy (unrestrictedEdgeMemory (old ∘ τ) (unrestrictedResidueTransport n Δ)
      stored (residuePromotionReindex n Δ D old τ e)) =
    orderedTupleOccupancy (unrestrictedEdgeMemory old (unrestrictedResidueTransport n Δ) stored e) := by
  simp only [unrestrictedEdgeMemory, retained_birth_tuple_occupancy]
  rw [residue_promotion_reindex_survivors]
  congr 1
  simp [retainedTupleOccupancy, sum_map, Function.comp_apply]

theorem residue_promotion_reindex_target {P : Type*} (n : P → ℕ) (Δ D : ℤ)
    {N t : ℕ} (old : Fin N → UnrestrictedResidueParticle n) (τ : Equiv.Perm (Fin N))
    (promotions : Finset (Fin t)) (e : promotions ↪ ↥(unrestrictedResidueEligible n Δ D old))
    (fresh : UnrestrictedFreshLabels P promotions) :
    unrestrictedEdgeTarget (old ∘ τ) Sigma.fst promotions
        (residuePromotionReindex n Δ D old τ e) fresh =
      unrestrictedEdgeTarget old Sigma.fst promotions e fresh := by
  unfold unrestrictedEdgeTarget
  congr 1
  funext i
  simp [Function.comp_apply, residuePromotionReindex_val]

end Bounty
end

section

/- Local symmetric-test equality implies equality for a joint symmetric continuation. -/

open Finset Classical
namespace Bounty

theorem product_memory_test_congr {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z t B → ℂ) (hf : ProductMemorySymmetric f)
    (x y : ProductBoundedOrderedState P Z t B)
    (hxy : ∀ g (h : BoundedOrderedState (P g) (Z g) (t g) B → ℂ),
      BoundedOrderedSymmetric h → h (y g) = h (x g)) : f y = f x := by
  let z (s : Finset G) : ProductBoundedOrderedState P Z t B :=
    fun g => if g ∈ s then y g else x g
  have hc := (product_memory_symmetric_iff_coordinate f).mp hf
  have hs (s : Finset G) : f (z s) = f x := by
    induction s using Finset.induction_on with
    | empty => simp only [z, notMem_empty, if_false]
    | @insert g s hg ih =>
      have hz : z (insert g s) = Function.update (z s) g (y g) := by
        funext j
        by_cases hj : j = g
        · subst j
          simp [z]
        · simp [z, hj]
      rw [hz]
      have hl := hxy g (fun a => f (Function.update (z s) g a))
        ((finite_local_memory_invariant_iff _).mp
          (finite_coordinate_invariant_slice g _ f (hc g) (z s)))
      rw [hl]
      have he : Function.update (z s) g (x g) = z s := by
        have hval : z s g = x g := by simp only [z, hg, if_false]
        rw [← hval, Function.update_eq_self]
      rw [he, ih]
  simpa only [z, mem_univ, if_true] using hs univ

abbrev productMemoryReindex {G : Type*} {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (x : ProductBoundedOrderedState P Z t B)
    (τ : ∀ g, Equiv.Perm (Fin (x g).2.1.val)) : ProductBoundedOrderedState P Z t B :=
  fun g => boundedGhostMemoryPermute (x g) (τ g)




theorem product_memory_reindex_at {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (x : ProductBoundedOrderedState P Z t B) (g : G)
    (τ : Equiv.Perm (Fin (x g).2.1.val)) :
    productMemoryReindex x (Function.update (fun h => Equiv.refl (Fin (x h).2.1.val)) g τ) =
      productMemoryPermuteAt x g τ := by
  funext h
  by_cases hh : h = g
  · subst h
    simp only [productMemoryReindex, Function.update_self, productMemoryPermuteAt]
  · simp only [productMemoryReindex, Function.update_of_ne hh, boundedGhostMemoryPermute,
      Equiv.refl_apply, Function.comp_def, productMemoryPermuteAt]

end Bounty
end

