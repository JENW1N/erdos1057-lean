section

/- Arbitrary power saving for the actual shared-draw error, uniformly over
cuts, harmonic masses, logarithmic list lengths, and polynomial endpoint logarithms. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem eventually_physical_shared_error_polynomial_decay {c v A B : ℝ} (hc : 0 < c) (hv : 0 < v) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (E F D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type*) [Fintype G] (J : ℕ) (C : G → Finset (Fin J)) (V : G → ℝ)
      (T H Pmin : ℝ),
      (∀ g, v ≤ V g) → (J * Fintype.card G : ℕ) ≤ A * Real.log L →
      0 ≤ T → T ≤ B * L^F → 0 ≤ H → H ≤ L ^ E → Real.exp (L ^ c) ≤ Pmin →
      (∑ g : G, (J - (C g).card : ℕ) * T / (V g * Pmin)) *
        (H + H / (1 / 2 : ℝ) ^ (2 * ∑ g : G, (J - (C g).card))) ≤ L ^ (-D) := by
  let e : ℝ := A * Real.log 4
  let C0 : ℝ := A * B / v
  have hC0 : 0 ≤ C0 := by dsimp only [C0]; positivity
  filter_upwards [eventually_polynomial_div_exp_power hc (2*C0) (1+F+E+e) D,
    eventually_ge_atTop (1 : ℝ)] with L hdec hL
  intro G _ J C V T H Pmin hV hJ hT hTL hH hHL hPmin
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hP0 : 0 < Pmin := (Real.exp_pos _).trans_le hPmin
  have hJL : ((J * Fintype.card G : ℕ) : ℝ) ≤ A * L :=
    hJ.trans (mul_le_mul_of_nonneg_left (Real.log_le_self hL0.le) hA)
  have hδ : (∑ g : G, (J - (C g).card : ℕ) * T / (V g * Pmin)) ≤
      C0 * L^(1+F) / Real.exp (L^c) := by
    calc
      _ ≤ (Fintype.card G : ℝ) * J * T / (v * Pmin) :=
        physical_shared_error_uniform_bound C V hv hP0 hT hV
      _ ≤ (A*L) * (B*L^F) / (v * Real.exp (L^c)) := by
        have hjn : (Fintype.card G : ℝ) * J ≤ A*L := by
          simpa only [Nat.cast_mul, mul_comm] using hJL
        apply div_le_div₀ (by positivity)
          (mul_le_mul hjn hTL hT (by positivity))
          (mul_pos hv (Real.exp_pos _))
          (mul_le_mul_of_nonneg_left hPmin hv.le)
      _ = _ := by
        rw [Real.rpow_add hL0, Real.rpow_one]
        dsimp only [C0]
        field_simp
  have hother : H + H / (1 / 2 : ℝ) ^ (2 * ∑ g : G, (J - (C g).card)) ≤
      2 * L^E * L^e := by
    calc
      _ ≤ 2 * H * (4 : ℝ) ^ (J * Fintype.card G) := physical_shared_half_overlap_bound C hH
      _ ≤ 2 * L^E * L^e :=
        mul_le_mul (mul_le_mul_of_nonneg_left hHL (by norm_num))
          (by simpa only [Nat.mul_one, Nat.cast_one, mul_one] using
            (four_pow_length_le_rpow (n := 1) hL0 hJ)) (by positivity) (by positivity)
  calc
    _ ≤ (C0 * L^(1+F) / Real.exp (L^c)) * (2 * L^E * L^e) :=
      mul_le_mul hδ hother (by positivity) (by positivity)
    _ = (2*C0) * L^(1+F+E+e) / Real.exp (L^c) := by
      simp only [Real.rpow_add hL0]
      ring
    _ ≤ _ := hdec

end Bounty
end

