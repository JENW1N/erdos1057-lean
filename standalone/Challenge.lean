    (a b c0 d U w x:_root_.OAI.ActualEisensteinCubic.O) (hc0:c0≠0)
    (hdet:a*d-b*(c0*∏i,p i)=1)
    (hbez:U*(∏i,p i)+(ramifiedTraceLambda^3*w)*c0=1)
    (σ ε : ∀i,(_root_.OAI.ActualEisensteinCubic.O⧸Ideal.span {p i})ˣ) (h : ∀i,_root_.OAI.ActualEisensteinCubic.O⧸Ideal.span {p i})
    (ha : ∀i,Ideal.Quotient.mk (Ideal.span {p i}) a=(σ i:_root_.OAI.ActualEisensteinCubic.O⧸Ideal.span {p i})*h i)
    (hε : ∀i,Ideal.Quotient.mk (Ideal.span {p i})
      (ramifiedTraceLambda^3*c0*cofactor p i)*(σ i:_root_.OAI.ActualEisensteinCubic.O⧸Ideal.span {p i})*(ε i:_root_.OAI.ActualEisensteinCubic.O⧸Ideal.span {p i})=-1) :
    let : ∀ i, Field (_root_.OAI.ActualEisensteinCubic.O⧸Ideal.span {p i}) := fun i => A4phaseField (Ideal.span {p i})
