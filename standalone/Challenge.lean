namespace Bounty
section Reindex
variable {G H : Type*} (e : G ≃ H) (P : G → Finset ℕ) (J ell : ℕ)

def physicalMarkGroupReindex : PhysicalMarkLists P J ell ≃
    PhysicalMarkLists (fun h => P (e.symm h)) J ell :=
  Equiv.piCongrLeft' (fun g => PhysicalSlots J ell ↪ ↥(P g)) e

def physicalAuxGroupReindex (C : G → Finset (Fin J)) : PhysicalAuxLabels P C ≃
    PhysicalAuxLabels (fun h => P (e.symm h)) (fun h => C (e.symm h)) :=
  Equiv.piCongrLeft' (fun g => ↥(C g) → ↥(P g)) e

def physicalPermutationGroupReindex : PhysicalPermutations G J ell ≃ PhysicalPermutations H J ell :=
  Equiv.piCongrLeft' (fun _ => Equiv.Perm (PhysicalSlots J ell)) e










theorem physical_permute_group_reindex (σ : PhysicalPermutations G J ell)
    (L : PhysicalMarkLists P J ell) :
    physicalMarkGroupReindex e P J ell (physicalPermuteLabels σ L) =
      physicalPermuteLabels (physicalPermutationGroupReindex e J ell σ)
        (physicalMarkGroupReindex e P J ell L) := rfl

end Reindex
end Bounty
