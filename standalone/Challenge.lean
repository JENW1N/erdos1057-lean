/- Each fixed small plan supplies the exact original big-step multiplier. -/

open scoped Classical
namespace Bounty

variable {I : Type} {N M J ell n : ℕ} {P : Fin N → Finset ℕ}
  (groups : Finset (Fin N)) (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
  (k : ℕ → I → ℤ)
  (p : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns)

noncomputable def physicalRootPlanMultiplier (j : Fin (n + 1)) : ℤ :=
  k (n - j.val) (physicalRootSmallPlanPattern groups patterns C hC p j).val *
    (physicalSharedProduct (physicalSharedPrefix
      (physicalPermuteLabels ((physicalRootSmallPlanSmallData groups patterns C hC p).2.2.1 j)
        ((physicalRootSmallPlanSmallData groups patterns C hC p).2.1 j.castSucc))) : ℕ)

theorem physical_root_small_plan_path_pattern
    (db : PhysicalRootSmallPlanBigData groups patterns C hC p) (j : Fin (n + 1)) :
    ((physicalRootSmallPlanPath groups patterns C hC p db).2 j).1.2.2.1 =
      physicalRootSmallPlanPattern groups patterns C hC p j := rfl

theorem physical_root_plan_offset_step
    (e : {g // g ∉ groupsᶜ} ≃ Fin M)
    (db : PhysicalRootSmallPlanBigData groups patterns C hC p) (j : Fin (n + 1)) :
    let old := physicalRootSmallPlanPath groups patterns C hC p db
    let dn := physicalRootNumberedBigData groups e patterns C hC p db
    physicalPathSelectedOffset C k old.1 old.2 j.succ =
      physicalPathSelectedOffset C k old.1 old.2 j.castSucc +
      physicalRootPlanMultiplier groups patterns C hC k p j *
        (physicalD (fun g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val (e.symm g).val)
          (physicalPermuteLabels (dn.2.2.1 j) (dn.2.1 j.castSucc)) (dn.1 j) : ℤ) := by
  dsimp only
  have ho := physical_path_selected_offset_step C k
    (physicalRootSmallPlanPath groups patterns C hC p db).1
    (physicalRootSmallPlanPath groups patterns C hC p db).2 j
  rw [physical_root_small_plan_selected_coordinates] at ho
  dsimp only [physicalPathSelectedMultiplier] at ho
  rw [physical_root_small_plan_path_pattern] at ho
  have hsplit := physical_selected_group_inverse_D (fun g => g ∈ groupsᶜ)
    (fun j => C (physicalRootSmallPlanPattern groups patterns C hC p j).val)
    (physicalRootSmallPlanSmallData groups patterns C hC p) db j
  dsimp only at hsplit
  rw [hsplit] at ho
  have hempty := physical_D_empty_cut
    (fun g : ↥groupsᶜ => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)
    (fun g => hC (physicalRootSmallPlanPattern groups patterns C hC p j) g)
    ((physicalRootSmallPlanSmallData groups patterns C hC p).1 j)
    (physicalPermuteLabels ((physicalRootSmallPlanSmallData groups patterns C hC p).2.2.1 j)
      ((physicalRootSmallPlanSmallData groups patterns C hC p).2.1 j.castSucc))
  have hfin : @Subtype.fintype (Fin N) (fun g => g ∈ groupsᶜ)
      (fun g => Classical.propDecidable (g ∈ groupsᶜ)) (Fin.fintype N) =
      Finset.Subtype.fintype groupsᶜ := Subsingleton.elim _ _
  rw [hfin, hempty] at ho
  have hd := physical_selected_group_reindexed_D e
    (fun g : {g // g ∉ groupsᶜ} => P g.val)
    (fun j g => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val) db j
  dsimp only at hd
  dsimp only [physicalRootNumberedBigData]
  rw [hd]
  have hbig : @Subtype.fintype (Fin N) (fun g => g ∉ groupsᶜ)
      (fun g => @instDecidableNot (g ∈ groupsᶜ) (Classical.propDecidable (g ∈ groupsᶜ)))
      (Fin.fintype N) =
      @Subtype.fintype (Fin N) (fun g => g ∉ groupsᶜ)
        (fun g => @instDecidableNot (g ∈ groupsᶜ) (Finset.decidableMem g groupsᶜ))
        (Fin.fintype N) := Subsingleton.elim _ _
  rw [hbig] at ho
  simpa only [physicalRootPlanMultiplier, Nat.cast_mul, mul_assoc] using ho

theorem physical_root_plan_multiplier_not_dvd
    (e : {g // g ∉ groupsᶜ} ≃ Fin M)
    (hP : ∀ g a, a ∈ P g → Nat.Prime a)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ t < n + 1, ∀ i ∈ patterns, ∀ g a, a ∈ P g → ¬ (a : ℤ) ∣ k t i)
    (j : Fin (n + 1)) (g : Fin M) (a : ↥(P (e.symm g).val)) :
    ¬ (a.val : ℤ) ∣ physicalRootPlanMultiplier groups patterns C hC k p j := by
  have hd : ∀ s : ↥groupsᶜ, ∀ g : Fin M, Disjoint (P s.val) (P (e.symm g).val) := by
    intro s g
    apply hdis
    intro he
    apply (e.symm g).property
    simpa only [← he] using s.property
  apply physical_big_prime_not_dvd_effective_multiplier
    (fun s => hP s.val) (fun g => hP (e.symm g).val) hd
    (physicalSharedPrefix
      (physicalPermuteLabels ((physicalRootSmallPlanSmallData groups patterns C hC p).2.2.1 j)
        ((physicalRootSmallPlanSmallData groups patterns C hC p).2.1 j.castSucc)))
  exact hk (n - j.val) (by omega) _ (physicalRootSmallPlanPattern groups patterns C hC p j).property
    (e.symm g).val a.val a.property

end Bounty
