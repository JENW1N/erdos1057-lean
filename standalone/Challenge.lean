/- Smoothing by convolution with a fixed kernel `ψ`, applied to the zero-extension from `K`. -/
def smoothFun (u : let : MeasurableSpace E := instMeasurableSpaceSmoothing1 (E := E); let : BorelSpace E := instBorelSpaceSmoothing1 (E := E); let : OpensMeasurableSpace E := instOpensMeasurableSpaceSmoothing1 (E := E); let : MeasurableAdd E := instMeasurableAddSmoothing1 (E := E); MeasureTheory.Lp ℝ (2 : ℝ≥0∞) (volume.restrict K)) :
    let : MeasurableSpace E := instMeasurableSpaceSmoothing1 (E := E)
    let : BorelSpace E := instBorelSpaceSmoothing1 (E := E)
    let : OpensMeasurableSpace E := instOpensMeasurableSpaceSmoothing1 (E := E)
    let : MeasurableAdd E := instMeasurableAddSmoothing1 (E := E)
    E → ℝ :=
  let : MeasurableSpace E := instMeasurableSpaceSmoothing1 (E := E)
  let : BorelSpace E := instBorelSpaceSmoothing1 (E := E)
  let : OpensMeasurableSpace E := instOpensMeasurableSpaceSmoothing1 (E := E)
  let : MeasurableAdd E := instMeasurableAddSmoothing1 (E := E)
  (extendByZeroFun (K := K) u) ⋆[ContinuousLinearMap.lsmul ℝ ℝ, (volume : Measure E)] ψ

lemma continuous_smoothFun
    (hKm : let : MeasurableSpace E := instMeasurableSpaceSmoothing1 (E := E); let : BorelSpace E := instBorelSpaceSmoothing1 (E := E); let : OpensMeasurableSpace E := instOpensMeasurableSpaceSmoothing1 (E := E); let : MeasurableAdd E := instMeasurableAddSmoothing1 (E := E); MeasurableSet K) (hψc : Continuous ψ) (hψcs : HasCompactSupport ψ)
    (u : let : MeasurableSpace E := instMeasurableSpaceSmoothing1 (E := E); let : BorelSpace E := instBorelSpaceSmoothing1 (E := E); let : OpensMeasurableSpace E := instOpensMeasurableSpaceSmoothing1 (E := E); let : MeasurableAdd E := instMeasurableAddSmoothing1 (E := E); MeasureTheory.Lp ℝ (2 : ℝ≥0∞) (volume.restrict K)) :
    let : MeasurableSpace E := instMeasurableSpaceSmoothing1 (E := E)
    let : BorelSpace E := instBorelSpaceSmoothing1 (E := E)
    let : OpensMeasurableSpace E := instOpensMeasurableSpaceSmoothing1 (E := E)
    let : MeasurableAdd E := instMeasurableAddSmoothing1 (E := E)
    Continuous (smoothFun (K := K) ψ u) := by
  let : MeasurableSpace E := instMeasurableSpaceSmoothing1 (E := E)
  let : BorelSpace E := instBorelSpaceSmoothing1 (E := E)
  let : OpensMeasurableSpace E := instOpensMeasurableSpaceSmoothing1 (E := E)
  let : MeasurableAdd E := instMeasurableAddSmoothing1 (E := E)
