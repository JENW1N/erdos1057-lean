noncomputable def upperLogCell (h z : ℝ) : ℤ := ⌈z / h⌉

theorem upper_log_cell_eq_iff {h : ℝ} (hh : 0 < h) (z : ℝ) (d : ℤ) :
    upperLogCell h z = d ↔ ((d : ℝ) - 1) * h < z ∧ z ≤ (d : ℝ) * h := by
  rw [upperLogCell, Int.ceil_eq_iff, lt_div_iff₀ hh, div_le_iff₀ hh]

theorem upper_log_cell_nat_eq_iff {h : ℝ} (hh : 0 < h) {n : ℕ} (hn : 0 < n) (d : ℤ) :
    upperLogCell h (Real.log n) = d ↔
      Real.exp (((d : ℝ) - 1) * h) < (n : ℝ) ∧ (n : ℝ) ≤ Real.exp ((d : ℝ) * h) := by
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  rw [upper_log_cell_eq_iff hh, Real.lt_log_iff_exp_lt hnR, Real.log_le_iff_le_exp hnR]

theorem upper_log_cell_distance_lt {h x y : ℝ} (hh : 0 < h)
    (heq : upperLogCell h x = upperLogCell h y) : |x - y| < h := by
  let d := upperLogCell h y
  have hx := (upper_log_cell_eq_iff hh x d).mp heq
  have hy := (upper_log_cell_eq_iff hh y d).mp rfl
  rw [abs_lt]
  constructor <;> nlinarith
end

