theorem logarithmic_shifted_prime_avoidance_product_tendsto :
    Tendsto (fun z : ℝ => Real.log z * shiftedPrimeAvoidanceProduct z) atTop
      (𝓝 (shiftedSieveRatioConstant * Mertens.primeProductLimitConstant)) := by
  have ht := odd_prime_correction_product_tendsto.mul logarithmic_prime_avoidance_product_tendsto
  apply ht.congr'
  filter_upwards [eventually_ge_atTop (2 : ℝ)] with z hz
  rw [shifted_prime_avoidance_product_factorization hz]
  ring

theorem exponential_shifted_prime_avoidance_product_tendsto {b : ℝ} (hb : 0 < b) :
    Tendsto (fun L : ℝ => L * shiftedPrimeAvoidanceProduct (Real.exp (b*L))) atTop
      (𝓝 (shiftedSieveRatioConstant * Mertens.primeProductLimitConstant/b)) := by
  have he : Tendsto (fun L : ℝ => Real.exp (b*L)) atTop atTop :=
    Real.tendsto_exp_atTop.comp (tendsto_id.const_mul_atTop hb)
  have h := (logarithmic_shifted_prime_avoidance_product_tendsto.comp he).div_const b
  convert h using 1
  ext L
  simp only [Function.comp_apply, Real.log_exp]
  field_simp




