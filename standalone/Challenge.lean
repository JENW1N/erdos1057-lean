section

/- The actual free-label divisor set has the support and prime lower bounds
required by the invariant endpoint exclusion estimate. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_free_prime_set_supported {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (hprime : ∀ g p, p ∈ P g → p.Prime) (Q : Finset ℕ) (hQ : ∀ g, P g ⊆ Q)
    {p : ℕ} (hp : p ∈ physicalFreePrimeSet C aux) : p ∈ Nat.factoredNumbers Q := by
  obtain ⟨g, j, rfl⟩ := (physical_mem_free_prime_set C aux p).mp hp
  have h := hprime g _ (aux g j).property
  apply Nat.mem_factoredNumbers_of_primeFactors_subset h.ne_zero
  rw [h.primeFactors]
  exact singleton_subset_iff.mpr (hQ g (aux g j).property)

theorem physical_free_prime_set_lower {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    {Pmin : ℝ} (hP : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    {p : ℕ} (hp : p ∈ physicalFreePrimeSet C aux) : Pmin ≤ (p : ℝ) := by
  obtain ⟨g, j, rfl⟩ := (physical_mem_free_prime_set C aux p).mp hp
  exact hP g (aux g j)

end Bounty
