theorem finite_weighted_sum_cauchy {X : Type*} (s : Finset X)
    (μ : X → ℝ) (hμ : ∀ x ∈ s, 0 ≤ μ x) (f : X → ℂ) :
    ‖∑ x ∈ s, (μ x : ℂ) * f x‖ ^ 2 ≤
      (∑ x ∈ s, μ x) * ∑ x ∈ s, μ x * ‖f x‖ ^ 2 := by
  have h := complex_row_weighted_cauchy s (fun x => (μ x : ℂ)) f (fun _ => 1)
    (fun _ _ => by norm_num)
  simp only [Complex.norm_real, Real.norm_eq_abs, mul_one, div_one] at h
  have ha : ∀ x ∈ s, |μ x| = μ x := fun x hx => abs_of_nonneg (hμ x hx)
  simpa only [Finset.sum_congr rfl ha,
    Finset.sum_congr rfl (fun x hx => congrArg (fun a => a * ‖f x‖ ^ 2) (ha x hx))] using h

theorem finite_weighted_fiber_energy_le {X Y : Type*} [Fintype X]
    (values : Finset Y) (π : X → Y) (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x)
    (f : X → ℂ) {B : ℝ} (hB : 0 ≤ B)
    (hmass : ∀ y ∈ values, (∑ x ∈ Finset.univ.filter (fun x => π x = y), μ x) ≤ B) :
    (∑ y ∈ values, ‖∑ x ∈ Finset.univ.filter (fun x => π x = y), (μ x : ℂ) * f x‖ ^ 2) ≤
      B * ∑ x, μ x * ‖f x‖ ^ 2 := by
  have hc (y : Y) (hy : y ∈ values) :
      ‖∑ x ∈ Finset.univ.filter (fun x => π x = y), (μ x : ℂ) * f x‖ ^ 2 ≤
      B * ∑ x ∈ Finset.univ.filter (fun x => π x = y), μ x * ‖f x‖ ^ 2 := by
    exact (finite_weighted_sum_cauchy _ μ (fun x _ => hμ x) f).trans
      (mul_le_mul_of_nonneg_right (hmass y hy)
        (Finset.sum_nonneg (fun x _ => mul_nonneg (hμ x) (sq_nonneg _))))
  calc
    _ ≤ ∑ y ∈ values, B * ∑ x ∈ Finset.univ.filter (fun x => π x = y), μ x * ‖f x‖ ^ 2 :=
      Finset.sum_le_sum hc
    _ = B * ∑ x, ∑ y ∈ values, if π x = y then μ x * ‖f x‖ ^ 2 else 0 := by
      simp only [Finset.sum_filter]
      rw [← Finset.mul_sum, Finset.sum_comm]
    _ ≤ B * ∑ x, μ x * ‖f x‖ ^ 2 := by
      apply mul_le_mul_of_nonneg_left _ hB
      apply Finset.sum_le_sum
      intro x _
      by_cases hx : π x ∈ values
      · simp [Finset.sum_ite_eq, hx]
      · simp [Finset.sum_ite_eq, hx, mul_nonneg (hμ x) (sq_nonneg _)]
end

