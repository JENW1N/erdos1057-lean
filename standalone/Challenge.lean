theorem rational_kernel_reproduction {X Y : Type*} [Fintype X] [Fintype Y]
    (π : X → ℕ) (τ : Y → ℕ) (μ : X → ℝ) (ν : Y → ℝ)
    (KA : X → X → ℂ) (KB : Y → Y → ℂ) (x : X) (y : Y)
    {r Q : ℕ} (hr : 0 < r) (hrQ : r ≤ Q) (u : ℤ)
    (hπ : ∀ d, (π d).Coprime r) (hτ : ∀ e, (τ e).Coprime r)
    {εA εB : ℝ} (hεA : 0 ≤ εA) (hεB : 0 ≤ εB)
    (hA : ∀ χ : DirichletCharacter ℂ r,
      ‖(∑ d, (μ d : ℂ) * KA d x * χ (π d : ZMod r)) - χ (π x : ZMod r)‖ ≤ εA)
    (hB : ∀ χ : DirichletCharacter ℂ r,
      ‖(∑ e, (ν e : ℂ) * KB e y * χ (τ e : ZMod r)) - χ (τ y : ZMod r)‖ ≤ εB) :
    ‖finiteTwoKernelAverage μ ν KA KB x y (fun d e =>
        Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * (π d * τ e)) : ℝ))) -
      Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * (π x * τ y)) : ℝ))‖ ≤
        Real.sqrt (Q : ℝ) * (εA + εB + εA * εB) := by
  obtain ⟨c, hc, he⟩ := rational_bilinear_character_expansion hr hrQ u
  let χA := fun (ψ : AddChar (Additive (ZMod r)ˣ) ℂ) (d : X) =>
    unitAddCharDirichlet ψ (π d : ZMod r)
  let χB := fun (ψ : AddChar (Additive (ZMod r)ˣ) ℂ) (e : Y) =>
    unitAddCharDirichlet ψ (τ e : ZMod r)
  have hphase (d : X) (e : Y) :
      (∑ ψ, c ψ * (χA ψ d * χB ψ e)) =
        Complex.exp (Complex.I * (2 * Real.pi * ((u : ℝ) / r * (π d * τ e)) : ℝ)) := by
    simpa only [χA, χB, mul_assoc] using he (π d) (τ e) (hπ d) (hτ e)
  have hb := finite_two_kernel_expansion_error Finset.univ μ ν KA KB x y c χA χB
    εA εB (Real.sqrt (Q : ℝ)) hεA hεB hc
    (fun ψ _ => (unitAddCharDirichlet ψ).norm_le_one _) (fun ψ _ => (unitAddCharDirichlet ψ).norm_le_one _)
    (fun ψ _ => hA (unitAddCharDirichlet ψ)) (fun ψ _ => hB (unitAddCharDirichlet ψ))
  simpa only [hphase] using hb
end

