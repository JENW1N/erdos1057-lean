section

/- The storage-only part of the full dirty edge is a difference of two
positive tensor restrictions. Its transpose is the reverse edge with some
promotion and no storage. The event formulas retain both total cutoffs. -/

open Finset Classical

namespace Bounty

theorem finite_transfer_mask_difference {G : Type*} [Fintype G]
    (p q : G → Prop) [DecidablePred p] [DecidablePred q] :
    (∏ g, if p g then (1 : ℝ) else 0) -
      (∏ g, if p g ∧ q g then (1 : ℝ) else 0) =
      if (∀ g, p g) ∧ (∃ g, ¬ q g) then 1 else 0 := by
  simp only [Fintype.prod_ite_zero, prod_const_one]
  have hh : (∀ g, p g ∧ q g) ↔ (∀ g, p g) ∧ (∀ g, q g) := forall_and
  simp only [hh]
  by_cases hp : ∀ g, p g
  · by_cases hq : ∀ g, q g
    · simp [hp, hq]
    · have hq' : ∃ g, ¬ q g := not_forall.mp hq
      simp [hp, hq, hq']
  · simp [hp]

section

variable {G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (t : G → ℕ) (B : ℕ)

noncomputable def unrestrictedStorageOnlyProduct :=
  unrestrictedCoupledCutoffProductOperator n Δ D μ ρ V t B
    (fun _ e => if (∀ g, (e g).2.1 = ∅) ∧ (∃ g, (e g).1 ≠ ∅) then 1 else 0)

noncomputable def unrestrictedReversePromotionOnlyProduct :=
  unrestrictedCoupledCutoffProductOperator n (fun g => -Δ g) D μ ρ V t B
    (fun _ e => ((∏ g, V g ^ (e g).2.1.card / V g ^ (e g).1.card : ℝ) : ℂ) *
      (if (∀ g, (e g).1 = ∅) ∧ (∃ g, (e g).2.1 ≠ ∅) then 1 else 0))

/- Two tensor restrictions differ exactly by the nonempty-storage gate. -/
theorem unrestricted_storage_only_product_difference
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :
    unrestrictedStorageOnlyProduct n Δ D μ ρ V t B f =
      fun s => productMemoryCutoff (unrestrictedRealSlotProduct n Δ D μ ρ V t B
          (fun _ _ T => if T = ∅ then 1 else 0) (productMemoryCutoff f)) s -
        productMemoryCutoff (unrestrictedRealSlotProduct n Δ D μ ρ V t B
          (fun _ S T => if T = ∅ ∧ S = ∅ then 1 else 0) (productMemoryCutoff f)) s := by
  rw [unrestricted_real_slot_product_eq_coupled, unrestricted_real_slot_product_eq_coupled]
  funext s
  unfold unrestrictedStorageOnlyProduct unrestrictedCoupledCutoffProductOperator productMemoryCutoff
  split_ifs with hcap
  · simp only [unrestrictedCoupledProductOperator, finiteProductEventAction]
    rw [← sum_sub_distrib]
    apply sum_congr rfl
    intro e he
    have hm := finite_transfer_mask_difference (fun g => (e g).2.1 = ∅)
      (fun g => (e g).1 = ∅)
    have hc := congrArg (fun r : ℝ => (r : ℂ)) hm
    have hcast (p : Prop) [Decidable p] : Complex.ofReal (if p then (1 : ℝ) else 0) =
        if p then (1 : ℂ) else 0 := by split_ifs <;> rfl
    simp only [Complex.ofReal_sub, hcast] at hc
    rw [← sub_mul, ← mul_sub, hc]
  · simp only [sub_self]

theorem unrestricted_reverse_promotion_only_product_difference
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ) :
    unrestrictedReversePromotionOnlyProduct n Δ D μ ρ V t B f =
      fun s => productMemoryCutoff (unrestrictedRealSlotProduct n (fun g => -Δ g) D μ ρ V t B
          (fun g S T => V g ^ T.card / V g ^ S.card * (if S = ∅ then 1 else 0))
          (productMemoryCutoff f)) s -
        productMemoryCutoff (unrestrictedRealSlotProduct n (fun g => -Δ g) D μ ρ V t B
          (fun g S T => V g ^ T.card / V g ^ S.card * (if S = ∅ ∧ T = ∅ then 1 else 0))
          (productMemoryCutoff f)) s := by
  rw [unrestricted_real_slot_product_eq_coupled, unrestricted_real_slot_product_eq_coupled]
  funext s
  unfold unrestrictedReversePromotionOnlyProduct unrestrictedCoupledCutoffProductOperator productMemoryCutoff
  split_ifs with hcap
  · simp only [unrestrictedCoupledProductOperator, finiteProductEventAction]
    rw [← sum_sub_distrib]
    apply sum_congr rfl
    intro e he
    have hm := finite_transfer_mask_difference (fun g => (e g).1 = ∅)
      (fun g => (e g).2.1 = ∅)
    have hc := congrArg (fun r : ℝ => (r : ℂ)) hm
    have hcast (p : Prop) [Decidable p] : Complex.ofReal (if p then (1 : ℝ) else 0) =
        if p then (1 : ℂ) else 0 := by split_ifs <;> rfl
    simp only [Complex.ofReal_sub, hcast] at hc
    simp only [prod_mul_distrib, Complex.ofReal_mul]
    rw [← sub_mul, ← mul_sub, ← mul_sub, hc]
  · simp only [sub_self]

theorem unrestricted_storage_only_product_symmetric
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (unrestrictedStorageOnlyProduct n Δ D μ ρ V t B f) := by
  rw [unrestricted_storage_only_product_difference]
  have ha := productMemoryCutoff_symmetric _
    (unrestricted_real_slot_product_symmetric n Δ D μ ρ V t B
      (fun _ _ T => if T = ∅ then 1 else 0) (productMemoryCutoff f)
      (productMemoryCutoff_symmetric f hf))
  have hb := productMemoryCutoff_symmetric _
    (unrestricted_real_slot_product_symmetric n Δ D μ ρ V t B
      (fun _ S T => if T = ∅ ∧ S = ∅ then 1 else 0) (productMemoryCutoff f)
      (productMemoryCutoff_symmetric f hf))
  intro x j τ
  dsimp only
  rw [ha x j τ, hb x j τ]

theorem unrestricted_reverse_promotion_only_product_symmetric
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (unrestrictedReversePromotionOnlyProduct n Δ D μ ρ V t B f) := by
  rw [unrestricted_reverse_promotion_only_product_difference]
  have ha := productMemoryCutoff_symmetric _
    (unrestricted_real_slot_product_symmetric n (fun j => -Δ j) D μ ρ V t B
      (fun j S T => V j ^ T.card / V j ^ S.card * (if S = ∅ then 1 else 0))
      (productMemoryCutoff f) (productMemoryCutoff_symmetric f hf))
  have hb := productMemoryCutoff_symmetric _
    (unrestricted_real_slot_product_symmetric n (fun j => -Δ j) D μ ρ V t B
      (fun j S T => V j ^ T.card / V j ^ S.card * (if S = ∅ ∧ T = ∅ then 1 else 0))
      (productMemoryCutoff f) (productMemoryCutoff_symmetric f hf))
  intro x j τ
  dsimp only
  rw [ha x j τ, hb x j τ]

/- Full product/factorial-measure storage adjoint with the exact reverse
volume ratio, all group sums, and both total caps. -/
theorem unrestricted_storage_only_product_pairing
    (hV : ∀ g, V g ≠ 0)
    (f g : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B → ℂ)
    (hf : ProductMemorySymmetric f) (hg : ProductMemorySymmetric g) :
    (∑ s, (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)) s : ℂ) *
      f s * unrestrictedStorageOnlyProduct n Δ D μ ρ V t B g s) =
    ∑ s, (productMemoryWeight μ (fun j => unrestrictedResidueWeight (μ j)) s : ℂ) *
      unrestrictedReversePromotionOnlyProduct n Δ D μ ρ V t B f s * g s := by
  rw [unrestricted_storage_only_product_difference,
    unrestricted_reverse_promotion_only_product_difference]
  simp only [mul_sub, sub_mul, sum_sub_distrib]
  rw [unrestricted_real_slot_cutoff_pairing n Δ D μ ρ V t B hV
      (fun _ _ T => if T = ∅ then 1 else 0) f g hf hg,
    unrestricted_real_slot_cutoff_pairing n Δ D μ ρ V t B hV
      (fun _ S T => if T = ∅ ∧ S = ∅ then 1 else 0) f g hf hg]

end

end Bounty
end

section

/- Bilinear transposition of a finite external permutation uses its inverse.
The external counting measure is preserved exactly, with no cardinality factor. -/

open Finset Classical

namespace Bounty

theorem finite_external_bilinear_transpose {X R : Type*} [Fintype X] [Fintype R]
    (μ : X → ℝ) (A T : (X → ℂ) → X → ℂ) (τ : R ≃ R)
    (f g : X → R → ℂ)
    (hpair : ∀ r q, (∑ x, (μ x : ℂ) * f x r * A (fun y => g y q) x) =
      ∑ x, (μ x : ℂ) * T (fun y => f y r) x * g x q) :
    (∑ r, ∑ x, (μ x : ℂ) * f x r * A (fun y => g y (τ r)) x) =
      ∑ r, ∑ x, (μ x : ℂ) * T (fun y => f y (τ.symm r)) x * g x r := by
  calc
    _ = ∑ r, ∑ x, (μ x : ℂ) * T (fun y => f y r) x * g x (τ r) := by
      apply sum_congr rfl
      intro r hr
      exact hpair r (τ r)
    _ = _ := by
      simpa only [Equiv.symm_apply_apply] using τ.sum_comp
        (fun r => ∑ x, (μ x : ℂ) * T (fun y => f y (τ.symm r)) x * g x r)

theorem finite_external_fiber_average_pairing {C X R : Type*}
    [Fintype X] [Fintype R] {A : C → Type*} [∀ c, Fintype (A c)]
    (μ : X → ℝ) (ω : ∀ c, A c → ℝ)
    (T U : ∀ c, A c → (X → ℂ) → X → ℂ) (τ : ∀ c, A c → R ≃ R)
    (f g : C → X → R → ℂ) (c : C)
    (hpair : ∀ a r q, (∑ x, (μ x : ℂ) * f c x r * T c a (fun y => g c y q) x) =
      ∑ x, (μ x : ℂ) * U c a (fun y => f c y r) x * g c x q) :
    (∑ r, ∑ x, (μ x : ℂ) * f c x r * finiteExternalFiberAverage ω T τ g c x r) =
      ∑ r, ∑ x, (μ x : ℂ) *
        finiteExternalFiberAverage ω U (fun c a => (τ c a).symm) f c x r * g c x r := by
  unfold finiteExternalFiberAverage
  simp only [mul_sum, sum_mul]
  have hrotate (H : R → X → A c → ℂ) :
      (∑ r, ∑ x, ∑ a, H r x a) = ∑ a, ∑ r, ∑ x, H r x a := by
    calc
      _ = ∑ r, ∑ a, ∑ x, H r x a := by
        apply sum_congr rfl
        intro r hr
        exact sum_comm
      _ = _ := sum_comm
  rw [hrotate, hrotate]
  apply sum_congr rfl
  intro a ha
  have h := congrArg (fun z : ℂ => (ω c a : ℂ) * z)
    (finite_external_bilinear_transpose μ (T c a) (U c a) (τ c a)
      (f c) (g c) (hpair a))
  simpa only [mul_sum, mul_assoc, mul_comm, mul_left_comm] using h

/- Shared-coordinate reassembly and the auxiliary sum preserve the inverse
external permutation in the exact full-space transpose. -/
theorem equiv_external_fiber_average_pairing {X C Y R : Type*}
    [Fintype X] [Fintype C] [Fintype Y] [Fintype R]
    {A : C → Type*} [∀ c, Fintype (A c)]
    (e : X ≃ C × Y) (W : X → ℝ) (κ : C → ℝ) (μ : Y → ℝ)
    (hW : ∀ c y, W (e.symm (c, y)) = κ c * μ y)
    (ω : ∀ c, A c → ℝ) (T U : ∀ c, A c → (Y → ℂ) → Y → ℂ)
    (τ : ∀ c, A c → R ≃ R) (f g : X → R → ℂ)
    (hpair : ∀ c a r q,
      (∑ y, (μ y : ℂ) * f (e.symm (c, y)) r * T c a (fun z => g (e.symm (c, z)) q) y) =
      ∑ y, (μ y : ℂ) * U c a (fun z => f (e.symm (c, z)) r) y * g (e.symm (c, y)) q) :
    (∑ r, ∑ x, (W x : ℂ) * f x r * equivExternalFiberAverage e ω T τ g x r) =
      ∑ r, ∑ x, (W x : ℂ) *
        equivExternalFiberAverage e ω U (fun c a => (τ c a).symm) f x r * g x r := by
  have hs (u v : X → R → ℂ) :
      (∑ r, ∑ x, (W x : ℂ) * u x r * v x r) =
      ∑ c, (κ c : ℂ) * ∑ r, ∑ y, (μ y : ℂ) * u (e.symm (c, y)) r * v (e.symm (c, y)) r := by
    simp_rw [← e.symm.sum_comp]
    simp only [Fintype.sum_prod_type, hW, Complex.ofReal_mul]
    rw [sum_comm]
    apply sum_congr rfl
    intro c hc
    simp only [mul_sum, mul_assoc]
  rw [hs, hs]
  apply sum_congr rfl
  intro c hc
  congr 1
  have h := finite_external_fiber_average_pairing μ ω T U τ
    (fun c y r => f (e.symm (c, y)) r) (fun c y r => g (e.symm (c, y)) r) c (hpair c)
  simpa only [equivExternalFiberAverage, Equiv.apply_symm_apply] using h




end Bounty
end

