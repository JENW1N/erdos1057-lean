    ((H.relIndex K:ℝ≥0∞) • integralQuotientVolume K) :=
  letI rootPolicy_hyperbolicMeasurableSpace := @OAI.CubicEisenstein.hyperbolicMeasurableSpace
  ⟨integralCoverMap_measurable hHK,integralCoverMap_measure hHK hK⟩

