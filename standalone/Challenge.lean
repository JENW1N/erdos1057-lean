section

/- The actual small-mark extraction error is negligible on square multiples. -/

open Finset

namespace Bounty

theorem invariant_marked_prime_peel_error_energy
    {G : Type*} [DecidableEq G] (groups : Finset G) (P : G → Finset ℕ)
    {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v)
    (V : G → ℝ) (t : G → ℕ) (T : ℕ)
    (hV : ∀ g ∈ groups, v ≤ V g) (ht : ∀ g ∈ groups, t g ≤ T)
    (hprime : ∀ g ∈ groups, ∀ p ∈ P g, p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (hg : g ∈ groups) (k : ℕ) (htg : t g = k + 1)
    (Q : Finset ℕ) (hQ : P g ⊆ Q) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (S : Finset ℕ) (N : ℕ) (hS : ∀ n ∈ S, 0 < n ∧ n ≤ N) :
    (∑ n ∈ S, ‖(markedDivisorWeight groups P q V t (n : ℤ) : ℂ) *
        invariantTripleEndpoint Q α β γ n -
      markedPrimePeel groups P q V t g k (invariantTripleEndpoint Q α β γ) n‖ ^ 2) ≤
      ((markedDivisorBound q v T) ^ groups.card * (1 + 2 * Real.log N / v)) ^ 2 *
        (((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) *
          ∑ p ∈ P g, 1 / (p : ℝ) ^ 2) := by
  have hsupport (p : ℕ) (hp : p ∈ P g) : p ∈ Nat.factoredNumbers Q := by
    apply Nat.mem_factoredNumbers_of_primeFactors_subset (hprime g hg p hp).ne_zero
    rw [(hprime g hg p hp).primeFactors]
    exact singleton_subset_iff.mpr (hQ hp)
  have hinvariant (n p : ℕ) (hp : p ∈ P g) (hpn : p ∣ n) :
      invariantTripleEndpoint Q α β γ (n / p) = invariantTripleEndpoint Q α β γ n := by
    have he := invariant_triple_endpoint_mul_supported (hsupport p hp) α β γ (n / p)
    rw [Nat.mul_div_cancel' hpn] at he
    exact he.symm
  apply invariant_triple_endpoint_square_error_energy Q (P g) α β γ
    hA hB hC hα hβ hγ hsupport S N (fun n hn => (hS n hn).2)
  · intro n _ hsq
    exact sub_eq_zero.mpr (marked_prime_peel_exact groups P q V t hprime hdis
      g hg k htg n hsq (invariantTripleEndpoint Q α β γ) (hinvariant n))
  · intro n hn
    exact marked_prime_peel_error_norm_le groups P hq0 hq1 hv V t T hV ht g hg k
      (by omega) (hprime g hg) (invariantTripleEndpoint Q α β γ) n N
      (hS n hn).1 (hS n hn).2 (hinvariant n)

end Bounty
