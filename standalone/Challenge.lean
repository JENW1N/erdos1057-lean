theorem physical_free_prime_set_card_le_total {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C) :
    (physicalFreePrimeSet C aux).card ≤ J * Fintype.card G := by
  apply (physical_free_prime_set_card C aux).trans
  calc
    _ ≤ ∑ _g : G, J := sum_le_sum (fun g _ =>
      (card_le_card (subset_univ (C g))).trans_eq (by simp))
    _ = _ := by simp [Nat.mul_comm]

theorem physical_free_reciprocal_bound {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hP : ∀ g (p : P g), Pmin ≤ (p.val : ℝ)) :
    (∑ p ∈ physicalFreePrimeSet C aux, 1/(p : ℝ)) ≤ (J * Fintype.card G : ℕ) / Pmin := by
  apply (finite_reciprocal_sum_le_card_div _ hPmin
    (fun _ hp => physical_free_prime_set_lower C aux hP hp)).trans
  exact div_le_div_of_nonneg_right (Nat.cast_le.mpr (physical_free_prime_set_card_le_total C aux)) hPmin.le

theorem eventually_physical_free_error_decay {c A : ℝ} (hc : 0 < c) (hA : 0 ≤ A)
    (E D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type) [Fintype G] (J : ℕ) (P : G → Finset ℕ)
      (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C) (H : ℝ),
      (J * Fintype.card G : ℕ) ≤ A * Real.log L → 0 ≤ H → H ≤ L^E →
      (∀ g (p : P g), Real.exp (L^c) ≤ (p.val : ℝ)) →
      H * (∑ p ∈ physicalFreePrimeSet C aux, 1/(p : ℝ)) ≤ L^(-D) := by
  filter_upwards [eventually_polynomial_div_exp_power hc A (E+1) D,
    eventually_gt_atTop (0 : ℝ)] with L hdec hL
  intro G _ J P C aux H hcount hH hHL hP
  have hlog : Real.log L ≤ L := (Real.log_le_sub_one_of_pos hL).trans (by linarith)
  have hn : (0 : ℝ) ≤ (J * Fintype.card G : ℕ) := Nat.cast_nonneg _
  calc
    _ ≤ H * ((J * Fintype.card G : ℕ) / Real.exp (L^c)) :=
      mul_le_mul_of_nonneg_left (physical_free_reciprocal_bound C aux (Real.exp_pos _) hP) hH
    _ ≤ L^E * (A * L / Real.exp (L^c)) := by
      apply mul_le_mul hHL
        (div_le_div_of_nonneg_right (hcount.trans (mul_le_mul_of_nonneg_left hlog hA))
          (Real.exp_pos _).le)
        (div_nonneg hn (Real.exp_pos _).le) (Real.rpow_nonneg hL.le _)
    _ = A * L^(E+1) / Real.exp (L^c) := by rw [Real.rpow_add hL, Real.rpow_one]; ring
    _ ≤ _ := hdec

theorem eventually_candidate_free_error_decay {c : ℝ} (hc : 0 < c)
    (J : ℕ) (E D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
      ∀ (C : S → Finset (Fin J))
        (aux : PhysicalAuxLabels (fun g : S => candidatePBand (c*L) g.val) C) (H : ℝ),
      0 ≤ H → H ≤ L^E →
      H * (∑ p ∈ physicalFreePrimeSet C aux, 1/(p : ℝ)) ≤ L^(-D) := by
  obtain ⟨v, A, _, hA, hinputs⟩ := exists_candidate_shared_error_inputs hc J
  filter_upwards [hinputs,
    eventually_physical_free_error_decay (c := (1/10 : ℝ)) (by norm_num) hA E D]
      with L hinputs hdec
  intro S hS C aux H hH hHL
  obtain ⟨hcount, hdata⟩ := hinputs S hS
  exact hdec S J _ C aux H (by simpa only [Fintype.card_coe] using hcount) hH hHL
    (fun g p => ((hdata g).2 p.val p.property).2)

