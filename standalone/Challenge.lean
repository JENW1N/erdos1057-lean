/- The actual root residue model equals the baseline times its original memory-history sum. -/

open Finset
open scoped Classical
namespace Bounty

section Normalization
variable {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  [∀ a : PhysicalPrime P, NeZero a.2.val]
  (V : Fin N → ℝ) (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
