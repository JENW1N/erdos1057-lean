     let : ChartedSpace SpatialCoordinates KernelQuotient := kernelSpatialChartedSpace
     let : BorelSpace KernelQuotient := kernelQuotientBorel
     let : T2Space KernelQuotient := integralOrbitQuotientT2 globalKubotaKernel
     apply (hV.mul (f.2.1.continuous.norm.pow 2)).integrable_of_hasCompactSupport
     apply HasCompactSupport.of_support_subset_isCompact f.2.2
     intro q hq
     by_contra hn
