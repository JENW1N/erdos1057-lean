section

/- The balanced candidate bound for the actual global prime proxies. -/

open Finset Filter
namespace Bounty

theorem exists_candidate_balanced_logarithmic_prime_proxy_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ)*(r : ℝ)*c = 1) :
    ∃ C : ℝ, 0 < C ∧ ∃ J : ℕ, ∀ S : ℝ, 0 ≤ S →
      ∀ᶠ L : ℝ in atTop, ∀ κ : ℝ, 0 ≤ κ → κ ≤ 1/50 →
      ∀ jStar : ℕ, J < jStar → ∀ (F : Finset (ℕ × ℕ)) (u : ℕ × ℕ → ℕ),
        (∀ v ∈ F, balancedPairWindow κ L v) →
        (∀ v ∈ F, v.1*v.2=2*u v+1) →
        (∑ v ∈ F, candidateCoefficient c L q r jStar (u v)*
          primeLogarithmicProxy L S v.1*primeLogarithmicProxy L S v.2) ≤
          C*(κ+1/L)*candidateCoefficientWindowMass c L q r jStar/L := by
  obtain ⟨C,hC,J,hbound⟩ := exists_candidate_balanced_prime_proxy_bound
    hc hr hq0 hq1 hcenter (by norm_num : (0:ℝ)<1/5)
  refine ⟨C,hC,J,?_⟩
  intro S hS
  filter_upwards [hbound S,eventually_ge_atTop (5:ℝ)] with L hb hL
  intro κ hκ hκup jStar hj F u hF hprod
  have hL1 : 1 ≤ L := by linarith
  have hL0 : 0 < L := by linarith
  have hδ : 0 < L^(-S) := by positivity
  have hδ1 : L^(-S) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hL1 (by linarith)
  have hsmall : L^(-S) ≤ (2/5:ℝ)*L/2 := by linarith
  let Y : ℕ → ℝ := fun n => logarithmicCellBase (L^(-S)) (logarithmicCellIndex (L^(-S)) n)
  have hbase (n : ℕ) (hn : Real.exp (((1/2:ℝ)-2*κ)*L) ≤ (n:ℝ)) :
      Real.exp ((1/5:ℝ)*L) ≤ Y n := by
    have hlow : Real.exp ((2/5:ℝ)*L) ≤ (n:ℝ) := by
      apply le_trans _ hn
      apply Real.exp_le_exp.mpr
      exact mul_le_mul_of_nonneg_right (by linarith) hL0.le
    simpa only [show (2/5:ℝ)/2=1/5 by norm_num] using
      logarithmic_cell_base_lower hδ hsmall hlow
  have hh := hb κ hκ hκup jStar hj F u Y Y hF hprod
    (fun v hv => ⟨hbase v.1 (hF v hv).1,hbase v.2 (hF v hv).2.2.1⟩)
  exact hh

end Bounty
