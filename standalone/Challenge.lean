open Finset
open scoped Classical
theorem coherent_complete_global_birth_edge_row {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    {t : ℕ} (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (hshared : ∀ p, atgt p = true ∧ asrc p = true → delta p = 0)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport asrc) H q)
    (source target : Fin t ↪ P)
    (hsource : univ.image source = ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt)
    (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (eligible : Finset (Fin q.1))
    (heligible : ∀ j, j ∈ eligible ↔ (q.2 j).2 = delta (q.2 j).1)
    (β : P → ℝ) (ρ V : ℝ) (B : ℕ)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    unrestrictedEdgeAction source q.2 Sigma.fst (fun p => ⟨p, 0⟩)
      (unrestrictedPhaseTransport delta) (fun z => z.2 = 0)
      (fun p => β p / V) ρ V eligible B
      (fun _stores promotions g fresh =>
        if GlobalBirthEdgeEventValid H
          (globalBirthCoherentSupport (ghostPhaseActivitySupport asrc) H q hq).val target
          ⟨promotions, g, fresh⟩ then 1 else 0)
      (fun target q' => symmetricPhaseReadout
        (globalBirthMemoryBase (ghostPhaseActivitySupport atgt) (H ∪ univ.image target)) F q') =
      ∑ z, ((∏ p, (if atgt p && !(asrc p) then V⁻¹ else 1) *
        ghostPhaseDampedMovingEdge (atgt p) (asrc p) (delta p) (β p) ρ ρ (z p)
          (globalBirthMemoryReadout (ghostPhaseActivitySupport asrc) H q p) : ℝ) : ℂ) *
        (if (ghostPhasePendingSupport z).card ≤ B then F z else 0) := by
  let w := globalBirthMemoryReadout (ghostPhaseActivitySupport asrc) H q
  let f := globalBirthCoherentSupport (ghostPhaseActivitySupport asrc) H q hq
  have hw : ghostPhaseMask asrc w := global_birth_coherent_readout_mask asrc H q hq
  have hold : ∀ j, w (f.val j) = some (some (some (q.2 j).2)) :=
    global_birth_coherent_readout_particle (ghostPhaseActivitySupport asrc) H q hq
  have hborn : ghostPhaseBornSupport w = H :=
    global_birth_coherent_readout_born_support (ghostPhaseActivitySupport asrc) H q hq
  have heq : (fun j => (⟨f.val j, (q.2 j).2⟩ : Σ p, R p)) = q.2 := by
    funext j
    rfl
  have h := distinct_unrestricted_complete_global_birth_phase_row atgt asrc delta w hw hshared
    source target hsource htarget f (fun j => (q.2 j).2) hold eligible heligible β ρ V B F
  simpa only [heq, hborn] using h
end

section
open Finset
open scoped Classical
/- The actual-index ghost visit of a coherent snapshot equals the full
damped phase tensor visit with precisely the same output-memory cutoff. -/
theorem coherent_global_birth_visit_row {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (a : P → Bool) (h : (p : P) → R p) (β : P → ℝ)
    (η V ρ : ℝ) (hV : V ≠ 0) (cap : ℕ)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport a) H q)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    globalBirthGhostVisitIndexRow h β η V ρ cap (ghostPhaseActivitySupport a) H q.2 F =
      ∑ z, ((∏ p, ghostPhaseDampedVisit (a p) (h p) η (β p) ρ (z p)
        (globalBirthMemoryReadout (ghostPhaseActivitySupport a) H q p) : ℝ) : ℂ) *
        (if (ghostPhasePendingSupport z).card ≤ cap then F z else 0) := by
  apply global_birth_ghost_visit_index_row_eq a h β η V ρ hV cap
    (globalBirthMemoryReadout (ghostPhaseActivitySupport a) H q)
    (global_birth_coherent_readout_mask a H q hq) q.2 hq.label_injective
  · exact (global_birth_coherent_readout_pending_support _ H q hq).symm
  · exact global_birth_coherent_readout_particle _ H q hq
  · exact (global_birth_coherent_readout_born_support _ H q hq).symm

/- Each admissible literal visit event remains a coherent global snapshot,
including zero-weight events. Deaths retain their labels in the born set. -/
theorem coherent_global_birth_visit_output {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)]
    (a : P → Bool) (h : (p : P) → R p)
    (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport a) H q)
    (D B : Finset P) (hD : D ⊆ globalBirthVisitZeros h q.2)
    (hB : B ⊆ univ \ H) {b : ℕ} (birth : Fin b → P)
    (hb : Function.Injective birth) (hrange : univ.image birth = B) :
    GlobalBirthMemoryCoherent (ghostPhaseActivitySupport a) (H ∪ B)
      (globalBirthVisitOutput h q.2 D birth) := by
  let y := globalBirthMemoryReadout (ghostPhaseActivitySupport a) H q
  have hy : ghostPhaseMask a y := global_birth_coherent_readout_mask a H q hq
  have hs : univ.image (fun j => (q.2 j).1) = ghostPhasePendingSupport y :=
    (global_birth_coherent_readout_pending_support _ H q hq).symm
  have hp : ∀ j, y (q.2 j).1 = some (some (some (q.2 j).2)) :=
    global_birth_coherent_readout_particle _ H q hq
  have hborn : ghostPhaseBornSupport y = H :=
    global_birth_coherent_readout_born_support _ H q hq
  have hd : D ⊆ ghostVisitDeaths a h y := by
    rw [← global_birth_visit_zeros_eq a h y hy q.2 hs hp]
    exact hD
  have hnew : B ⊆ ghostVisitBirths a y := by
    rw [ghost_visit_births_eq_unborn a y hy, hborn]
    exact hB
  have hcoh := global_birth_memory_coherent_of_snapshot (ghostVisitBatchOutput h y D B)
    (globalBirthVisitOutput h q.2 D birth)
    (global_birth_visit_output_injective a h y D B hnew q.2 hp birth hrange hq.label_injective hb)
    (global_birth_visit_output_support a h y D B hd hnew q.2 hs birth hrange)
  rw [ghost_phase_state_active_support_of_mask a _ (ghost_visit_batch_mask a h y hy D B hd hnew),
    ghost_visit_batch_born_support a h y D B hd, hborn] at hcoh
  exact hcoh
end

