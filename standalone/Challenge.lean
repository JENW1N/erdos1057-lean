section

/- The literal mixed positive storage row transposes to reverse promotion.
The original small measure, both memory caps and all volume ratios are kept. -/

open Finset Classical

namespace Bounty

section

variable {S G : Type*} [Fintype S] [DecidableEq S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} [∀ p : PhysicalPrime Ps, NeZero p.2.val]
  {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {J ell : ℕ} {M : G → ℕ} (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (kbig : SharedActiveLabels P shared → ℤ)

noncomputable def physicalSmallBigStoragePhase
    (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (_r : PhysicalResidues Ps) (e : PhysicalSmallBigFullEvent n shared B Δ D d x) : ℂ :=
  if (∀ g, (e.2 g).2.1 = ∅) ∧ (∃ g, (e.2 g).1 ≠ ∅) then 1 else 0

noncomputable def physicalSmallBigReversePhase
    (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (_r : PhysicalResidues Ps)
    (e : PhysicalSmallBigFullEvent n shared B (fun d c g => -Δ d c g) D d x) : ℂ :=
  ((∏ g, V g ^ (e.2 g).2.1.card / V g ^ (e.2 g).1.card : ℝ) : ℂ) *
    (if (∀ g, (e.2 g).1 = ∅) ∧ (∃ g, (e.2 g).2.1 ≠ ∅) then 1 else 0)

noncomputable def physicalSmallBigStorageAction (Vs : S → ℝ) (q : ℝ)
    (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J)))) :=
  physicalSmallBigAction (ell := ell) Vs q 0 aux (fun _ => 1)
    (PhysicalSmallBigFullEvent n shared B Δ D) (physicalSmallBigFullTarget n shared B Δ D)
    (physicalSmallBigFullCoefficient n shared B Δ D μ ρ V (physicalSmallBigStoragePhase n shared B Δ D))
    (fun x => kbig (productActiveMemorySplit shared B x).1)

noncomputable def physicalSmallBigReverseAction (Vs : S → ℝ) (q : ℝ)
    (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J)))) :=
  physicalSmallBigAction (ell := ell) Vs q 0 aux (fun _ => 1)
    (PhysicalSmallBigFullEvent n shared B (fun d c g => -Δ d c g) D)
    (physicalSmallBigFullTarget n shared B (fun d c g => -Δ d c g) D)
    (physicalSmallBigFullCoefficient n shared B (fun d c g => -Δ d c g) D μ ρ V
      (physicalSmallBigReversePhase n shared B Δ D V))
    (fun x => -kbig (productActiveMemorySplit shared B x).1)

omit [DecidableEq S] [∀ p : PhysicalPrime Ps, NeZero p.2.val] [∀ g p, NeZero (n g p)] in
theorem physical_small_big_storage_prefix_eq
    (F : PhysicalSharedLists Ps J →
      ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → PhysicalResidues Ps → ℂ)
    (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (r : PhysicalResidues Ps) :
    physicalSmallBigPrefixAction (PhysicalSmallBigFullEvent n shared B Δ D)
      (physicalSmallBigFullTarget n shared B Δ D)
      (physicalSmallBigFullCoefficient n shared B Δ D μ ρ V (physicalSmallBigStoragePhase n shared B Δ D))
      (fun y => kbig (productActiveMemorySplit shared B y).1) F d x r =
    fullActiveStorageExternal (A := fun _ => Unit) n shared B (fun c _ => Δ d c) (fun c _ => D d c) (fun _ _ => 1)
      μ ρ V (fun c _ => physicalResidueTranslationEquiv (P := Ps) (kbig c * (physicalSharedProduct d : ℕ)))
      (F d) x r := by
  rw [physical_small_big_full_prefix_eq, full_active_storage_external_eq_sum]
  rfl

omit [DecidableEq S] [∀ p : PhysicalPrime Ps, NeZero p.2.val] [∀ g p, NeZero (n g p)] in
theorem physical_small_big_reverse_prefix_eq
    (F : PhysicalSharedLists Ps J →
      ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → PhysicalResidues Ps → ℂ)
    (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (r : PhysicalResidues Ps) :
    physicalSmallBigPrefixAction (PhysicalSmallBigFullEvent n shared B (fun d c g => -Δ d c g) D)
      (physicalSmallBigFullTarget n shared B (fun d c g => -Δ d c g) D)
      (physicalSmallBigFullCoefficient n shared B (fun d c g => -Δ d c g) D μ ρ V
        (physicalSmallBigReversePhase n shared B Δ D V))
      (fun y => -kbig (productActiveMemorySplit shared B y).1) F d x r =
    fullActiveReversePromotionExternal (A := fun _ => Unit) n shared B (fun c _ => Δ d c) (fun c _ => D d c) (fun _ _ => 1)
      μ ρ V (fun c _ => physicalResidueTranslationEquiv (P := Ps) (kbig c * (physicalSharedProduct d : ℕ)))
      (F d) x r := by
  rw [physical_small_big_full_prefix_eq n shared B (fun d c g => -Δ d c g) D μ ρ V
    (fun c => -kbig c) (physicalSmallBigReversePhase n shared B Δ D V) F d x r,
    full_active_reverse_promotion_external_eq_sum]
  have he : (fun c (_ : Unit) => physicalResidueTranslationEquiv (P := Ps)
      (-kbig c * (physicalSharedProduct d : ℕ))) =
      (fun c (_ : Unit) => (physicalResidueTranslationEquiv (P := Ps)
        (kbig c * (physicalSharedProduct d : ℕ))).symm) := by
    funext c u
    apply Equiv.ext
    intro r
    change physicalTranslateResidues r (-kbig c * (physicalSharedProduct d : ℕ)) =
      physicalTranslateResidues r (-(kbig c * (physicalSharedProduct d : ℕ)))
    rw [neg_mul]
  rw [he]
  rfl

theorem physical_small_big_storage_pairing
    (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s) (q : ℝ)
    (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J)))) (hV : ∀ g, V g ≠ 0)
    (u F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hu : ∀ s, ProductMemorySymmetric (fun x => u (s,x)))
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s,x))) :
    (∑ s, (physicalSmallBigMeasure Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) s : ℂ) *
      u s * physicalSmallBigStorageAction n shared B Δ D μ ρ V kbig Vs q aux F s) =
    ∑ s, (physicalSmallBigMeasure Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) s : ℂ) *
      physicalSmallBigReverseAction n shared B Δ D μ ρ V kbig Vs q aux u s * F s := by
  apply physical_small_big_transpose_of_prefix_pairing Vs hVs q
    (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) aux
  intro d
  simp_rw [physical_small_big_storage_prefix_eq, physical_small_big_reverse_prefix_eq]
  exact full_active_storage_external_pairing (A := fun _ => Unit) n shared B (fun c _ => Δ d c) (fun c _ => D d c)
    (fun _ _ => 1) μ ρ V
    (fun c _ => physicalResidueTranslationEquiv (P := Ps) (kbig c * (physicalSharedProduct d : ℕ)))
    hV (physicalSmallBigCondition Vs q u d) (physicalSmallBigCondition Vs q F d)
    (fun r => physical_small_big_condition_memory_symmetric Vs q u hu d r)
    (fun r => physical_small_big_condition_memory_symmetric Vs q F hF d r)

end

end Bounty
end

section

/- Exact clean/dirty separation on the genuine mixed small-residue and
big-memory row. The coefficient can depend on both small endpoints and on
all big event choices; both memory cutoffs remain inside the event weight. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {S X : Type*} [Fintype S]
  {P : S → Finset ℕ} {J ell : ℕ} (V : S → ℝ) (q : ℝ)
  (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
  (target : ∀ d x, E d x → X)
  (a : PhysicalResidues P → ∀ d x, E d x → ℝ) (k : X → ℤ)

theorem physical_small_big_phased_add
    (Φ Ψ : ∀ s : PhysicalSmallBigState P J ell X, PhysicalSmallBigEvent E s → ℂ)
    (F : PhysicalSmallBigState P J ell X → ℂ) :
    physicalSmallBigPhasedAction V q E target a k (fun s e => Φ s e + Ψ s e) F =
      physicalSmallBigPhasedAction V q E target a k Φ F +
        physicalSmallBigPhasedAction V q E target a k Ψ F := by
  funext s
  simp only [physicalSmallBigPhasedAction, mul_add, add_mul, sum_add_distrib,
    Pi.add_apply]




theorem physical_small_big_masked_norm_le_positive
    (hV : ∀ s, 0 < V s) (ha : ∀ r d x e, 0 ≤ a r d x e)
    (Q : ∀ s : PhysicalSmallBigState P J ell X, PhysicalSmallBigEvent E s → Prop)
    (Φ : ∀ s : PhysicalSmallBigState P J ell X, PhysicalSmallBigEvent E s → ℂ)
    (hΦ : ∀ s e, ‖Φ s e‖ ≤ 1)
    (F : PhysicalSmallBigState P J ell X → ℂ)
    (s : PhysicalSmallBigState P J ell X) :
    ‖physicalSmallBigPhasedAction V q E target a k
      (fun y e => if Q y e then Φ y e else 0) F s‖ ≤
    (physicalSmallBigPhasedAction V q E target a k
      (fun y e => if Q y e then 1 else 0) (complexNormEnvelope F) s).re := by
  unfold physicalSmallBigPhasedAction complexNormEnvelope
  exact finite_masked_event_norm_le_positive_re
    (physicalSmallBigPositiveWeight V q E a k s)
    (physical_small_big_positive_weight_nonneg V hV q E a ha k s)
    (Q s) (Φ s) (fun e => F (physicalSmallBigTarget E target k s e)) (hΦ s)

end

section

variable {S G : Type*} [Fintype S] [Fintype G] [dG : DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (kbig : SharedActiveLabels P shared → ℤ) (Vs : S → ℝ) (q : ℝ)




theorem physical_small_big_full_dirty_positive_split
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ) :
    physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q
      (fun _ e => if ¬ (∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅) then 1 else 0) F =
    physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q
      (fun _ e => if ∃ g, (e.2.2 g).2.1.Nonempty then 1 else 0) F +
    physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q
      (fun _ e => if (∀ g, (e.2.2 g).2.1 = ∅) ∧ (∃ g, (e.2.2 g).1.Nonempty)
        then 1 else 0) F := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold physicalSmallBigFullPhasedAction
  rw [← physical_small_big_phased_add]
  congr 1
  funext s e
  have h := finite_dirty_indicator (fun g => (e.2.2 g).1 = ∅) (fun g => (e.2.2 g).2.1 = ∅)
  simp only [Finset.nonempty_iff_ne_empty]
  convert h using 1 <;> split_ifs <;> rfl

end

end Bounty
end

section

/- The arbitrary-phase mixed action already enforces its source cap.
The uniform-average identity permits any finite enumeration of small-slot
permutations, including the enumeration in the omission probability law. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_average_uniform
    {S X : Type*} [Fintype S] [dS : DecidableEq S]
    {Ps : S → Finset ℕ} {J ell : ℕ}
    (fi : Fintype (PhysicalPermutations S J ell))
    (f : PhysicalSmallBigState Ps J ell X → ℂ) (s : PhysicalSmallBigState Ps J ell X) :
    physicalSmallBigAverage f s =
      ∑ σ ∈ fi.elems,
        ((1 / (@Fintype.card (PhysicalPermutations S J ell) fi : ℝ) : ℝ) : ℂ) *
          f (physicalSmallBigPermutation σ s) := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  let canon : Fintype (PhysicalPermutations S J ell) := Pi.instFintype
  rw [Subsingleton.elim fi canon]
  simp only [physicalSmallBigAverage, one_div, Complex.ofReal_inv,
    Complex.ofReal_natCast, mul_sum]
  rfl

section

variable {S G : Type*} [Fintype S] [Fintype G] [dG : DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (kbig : SharedActiveLabels P shared → ℤ) (Vs : S → ℝ) (q : ℝ)
  (Φ : ∀ s : PhysicalSmallBigState Ps J ell
    (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
    PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s → ℂ)
  (F : PhysicalSmallBigState Ps J ell
    (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)

theorem physical_small_big_full_phased_zero_above_cap
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (hs : ¬ productTotalMemory s.2 ≤ B) :
    physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q Φ F s = 0 := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold physicalSmallBigFullPhasedAction physicalSmallBigPhasedAction
  apply sum_eq_zero
  intro e _
  simp only [physicalSmallBigPositiveWeight, physicalSmallBigFullWeight,
    fullActiveEdgeEventWeight, unrestrictedJointCutoffEventWeight,
    productActiveMemorySplit_total_memory, hs, false_and, if_false,
    mul_zero, ite_self, Complex.ofReal_zero, zero_mul]




end

end Bounty
end

section

/- At a fixed original auxiliary draw, the actual clean mixed row factors
through the original small conditioning and the literal capped big event
sum. The initial ledger tests only new fresh draws, never auxiliaries. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {S G : Type*} [Fintype S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (kbig : SharedActiveLabels P shared → ℤ)

noncomputable def physicalSmallBigCleanInitialPhase
    (initial : ∀ g, Finset (P g))
    (Ψ : ∀ d x, PhysicalResidues Ps → PhysicalSmallBigFullEvent n shared B Δ D d x → ℂ)
    (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (r : PhysicalResidues Ps) (e : PhysicalSmallBigFullEvent n shared B Δ D d x) : ℂ :=
  if (∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅) ∧
      (∀ g i, (e.2 g).2.2.2 i ∉ initial g) then Ψ d x r e else 0

variable [dS : DecidableEq S] [∀ p : PhysicalPrime Ps, NeZero p.2.val]
  [∀ g p, NeZero (n g p)]

theorem physical_small_big_clean_initial_pairing
    (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s) (q : ℝ)
    (W : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℝ)
    (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
    (initial : ∀ g, Finset (P g))
    (Ψ : ∀ d x, PhysicalResidues Ps → PhysicalSmallBigFullEvent n shared B Δ D d x → ℂ)
    (sourceGate targetGate u F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ) :
    (∑ s, (physicalSmallBigMeasure Vs W s : ℂ) * (starRingEnd ℂ) (u s) *
      physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q
        (physicalSmallBigEndpointPhase (PhysicalSmallBigFullEvent n shared B Δ D)
          (physicalSmallBigFullTarget n shared B Δ D)
          (fun r d x e => physicalSmallBigCleanInitialPhase n shared B Δ D initial Ψ d x r e)
          (fun x => kbig (productActiveMemorySplit shared B x).1) sourceGate targetGate) F s) =
      ∑ d, ∑ r, ∑ x, (W x : ℂ) *
        (starRingEnd ℂ) (physicalSmallBigCondition Vs q (fun s => sourceGate s * u s) d x r) *
        fullActiveExternalCoefficientAction n shared B (fun _ => Unit)
          (fun c _ => Δ d c) (fun c _ => D d c) (fun _ _ => 1) μ ρ V
          (fun c _ => physicalResidueTranslationEquiv (P := Ps)
            (kbig c * (physicalSharedProduct d : ℕ)))
          (physicalSmallBigCleanInitialPhase n shared B Δ D initial Ψ d)
          (physicalSmallBigCondition Vs q (fun s => targetGate s * F s) d) x r := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  have h := physical_small_big_gated_pairing Vs hVs q W aux
    (PhysicalSmallBigFullEvent n shared B Δ D) (physicalSmallBigFullTarget n shared B Δ D)
    (physicalSmallBigFullWeight n shared B Δ D μ ρ V)
    (fun r d x e => physicalSmallBigCleanInitialPhase n shared B Δ D initial Ψ d x r e)
    (fun x => kbig (productActiveMemorySplit shared B x).1) sourceGate targetGate u F
  change _ = ∑ d, ∑ r, ∑ x, (W x : ℂ) *
    (starRingEnd ℂ) (physicalSmallBigCondition Vs q (fun s => sourceGate s * u s) d x r) *
    physicalSmallBigPrefixAction (PhysicalSmallBigFullEvent n shared B Δ D)
      (physicalSmallBigFullTarget n shared B Δ D)
      (physicalSmallBigFullCoefficient n shared B Δ D μ ρ V
        (physicalSmallBigCleanInitialPhase n shared B Δ D initial Ψ))
      (fun x => kbig (productActiveMemorySplit shared B x).1)
      (physicalSmallBigCondition Vs q (fun s => targetGate s * F s)) d x r at h
  simp_rw [physical_small_big_full_prefix_eq] at h
  exact h

end

end Bounty
end

section

/- Cauchy energy on larger smooth-cutoff ranges retains the original outside factor. -/

open Finset

namespace Bounty

theorem typeII_energy_enlarge (E₀ N₀ E N M H : Finset ℕ)
    (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ) (hE : E₀⊆E) (hN : N₀⊆N)
    (hη : ∀ e∈E, ∀ n∈N, 0≤η e n) :
    (∑ e∈E₀, ∑ n∈N₀, η e n*‖typeIIInnerSum M H α aH e n‖^2) ≤
      ∑ e∈E, ∑ n∈N, η e n*‖typeIIInnerSum M H α aH e n‖^2 := by
  calc
    _ ≤ ∑ e∈E₀, ∑ n∈N, η e n*‖typeIIInnerSum M H α aH e n‖^2 := by
      apply sum_le_sum
      intro e he
      exact sum_le_sum_of_subset_of_nonneg hN (fun n hn _ =>
        mul_nonneg (hη e (hE he) n hn) (sq_nonneg _))
    _ ≤ _ := sum_le_sum_of_subset_of_nonneg hE (fun e he _ =>
      sum_nonneg (fun n hn => mul_nonneg (hη e he n hn) (sq_nonneg _)))

theorem typeII_cauchy_enlarged_majorant (E₀ N₀ E N M H : Finset ℕ)
    (aE β α aH : ℕ → ℂ) (η : ℕ → ℕ → ℝ) (hEE : E₀⊆E) (hNN : N₀⊆N)
    (hE : ∀ e∈E, 0<e) (hη : ∀ e∈E, ∀ n∈N, 0≤η e n)
    (hη₀ : ∀ e∈E₀, ∀ n∈N₀, 1≤η e n) :
    ‖∑ e∈E₀, ∑ n∈N₀, aE e*β n*typeIIInnerSum M H α aH e n‖^2 ≤
      ((∑ e∈E₀, ‖aE e‖^2)*(∑ n∈N₀, ‖β n‖^2))*
        (typeIIDiagonalEnergy E N M H η α aH+typeIIOffDiagonalEnergy E N M H η α aH) := by
  rw [← typeII_energy_split E N M H η α aH hE]
  exact (typeII_cauchy_majorant E₀ N₀ M H aE β α aH η hη₀).trans
    (mul_le_mul_of_nonneg_left (typeII_energy_enlarge E₀ N₀ E N M H η α aH hEE hNN hη)
      (by positivity))

end Bounty
end

section

/- Finite determinant reindexing of the actual Type-II off-diagonal energy. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

abbrev TypeIIOffIndex := (ℕ × ℕ) × ((ℕ × ℕ) × (ℕ × ℕ))
abbrev TypeIIShiftIndex := (ℤ × ℕ) × ((ℕ × ℕ) × (ℕ × ℕ))

noncomputable def typeIIOffDiagonalSupport (E N M H : Finset ℕ) : Finset TypeIIOffIndex :=
  ((E ×ˢ N) ×ˢ ((M ×ˢ H) ×ˢ (M ×ˢ H))).filter (fun x =>
    x.2.1.1 ≠ x.2.2.1 ∧ x.2.1.1 * x.1.2 = 2 * x.1.1 * x.2.1.2 + 1 ∧
      x.2.2.1 * x.1.2 = 2 * x.1.1 * x.2.2.2 + 1)

noncomputable def typeIIOffCoefficient (α aH : ℕ → ℂ) (v w : ℕ × ℕ) : ℝ :=
  (α v.1 * conj (α w.1) * aH v.2 * conj (aH w.2)).re

def typeIIShiftMap (x : TypeIIOffIndex) : TypeIIShiftIndex :=
  (((x.2.1.1 : ℤ) * x.2.2.2 - (x.2.2.1 : ℤ) * x.2.1.2, x.2.2.1 * x.2.1.2), x.2)

def typeIIRecoveredE (y : TypeIIShiftIndex) : ℤ :=
  ((y.2.2.1 : ℤ) - y.2.1.1) / (2 * y.1.1)

def typeIIRecoveredN (y : TypeIIShiftIndex) : ℤ :=
  (2 * typeIIRecoveredE y * y.2.1.2 + 1) / y.2.1.1

def typeIIRecoveredIndex (y : TypeIIShiftIndex) : TypeIIOffIndex :=
  ((typeIIRecoveredE y |>.toNat, typeIIRecoveredN y |>.toNat), y.2)

noncomputable def typeIIShiftWeight (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ)
    (y : TypeIIShiftIndex) : ℝ :=
  η (typeIIRecoveredE y).toNat (typeIIRecoveredN y).toNat * typeIIOffCoefficient α aH y.2.1 y.2.2

theorem mem_typeII_off_diagonal_support {E N M H : Finset ℕ} {x : TypeIIOffIndex} :
    x ∈ typeIIOffDiagonalSupport E N M H ↔
      x.1.1 ∈ E ∧ x.1.2 ∈ N ∧ x.2.1.1 ∈ M ∧ x.2.1.2 ∈ H ∧
      x.2.2.1 ∈ M ∧ x.2.2.2 ∈ H ∧ x.2.1.1 ≠ x.2.2.1 ∧
      x.2.1.1 * x.1.2 = 2 * x.1.1 * x.2.1.2 + 1 ∧
      x.2.2.1 * x.1.2 = 2 * x.1.1 * x.2.2.2 + 1 := by
  simp only [typeIIOffDiagonalSupport, mem_filter, mem_product]
  tauto

theorem typeII_off_support_positive {E N M H : Finset ℕ} {x : TypeIIOffIndex}
    (hx : x ∈ typeIIOffDiagonalSupport E N M H) :
    0 < x.1.1 ∧ 0 < x.1.2 ∧ 0 < x.2.1.1 ∧ 0 < x.2.2.1 := by
  obtain ⟨he, hn, hm, hh, hm', hh', hne, hfirst, hsecond⟩ := mem_typeII_off_diagonal_support.mp hx
  have hn0 : x.1.2 ≠ 0 := by intro hz; simp [hz] at hfirst
  have hm0 : x.2.1.1 ≠ 0 := by intro hz; simp [hz] at hfirst
  have hm'0 : x.2.2.1 ≠ 0 := by intro hz; simp [hz] at hsecond
  refine ⟨?_, Nat.pos_of_ne_zero hn0, Nat.pos_of_ne_zero hm0, Nat.pos_of_ne_zero hm'0⟩
  by_contra h
  have he0 : x.1.1 = 0 := by omega
  simp only [he0, mul_zero, zero_mul, zero_add] at hfirst hsecond
  have hm1 := Nat.eq_one_of_mul_eq_one_right hfirst
  have hm'1 := Nat.eq_one_of_mul_eq_one_right hsecond
  exact hne (hm1.trans hm'1.symm)

theorem typeII_off_diagonal_energy_eq_support (E N M H : Finset ℕ)
    (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ) :
    typeIIOffDiagonalEnergy E N M H η α aH =
      ∑ x ∈ typeIIOffDiagonalSupport E N M H,
        η x.1.1 x.1.2 * typeIIOffCoefficient α aH x.2.1 x.2.2 := by
  classical
  unfold typeIIOffDiagonalEnergy typeIIOffDiagonalSupport
  simp only [sum_filter, sum_product, mul_sum]
  apply sum_congr rfl
  intro e he
  apply sum_congr rfl
  intro n hn
  apply sum_congr rfl
  intro m hm
  apply sum_congr rfl
  intro h hh
  apply sum_congr rfl
  intro m' hm'
  apply sum_congr rfl
  intro h' hh'
  by_cases hoff : m ≠ m'
  · by_cases hfirst : m * n = 2 * e * h + 1
    · by_cases hsecond : m' * n = 2 * e * h' + 1
      · simp [hoff, hfirst, hsecond, typeIIEquationTerm, typeIIOffCoefficient,
          map_mul, mul_assoc, mul_left_comm, mul_comm]
      · simp [hoff, hfirst, hsecond, typeIIEquationTerm]
    · simp [hoff, hfirst, typeIIEquationTerm]
  · simp [hoff]

theorem typeII_recovered_quotients {E N M H : Finset ℕ} {x : TypeIIOffIndex}
    (hx : x ∈ typeIIOffDiagonalSupport E N M H) :
    typeIIRecoveredE (typeIIShiftMap x) = (x.1.1 : ℤ) ∧
      typeIIRecoveredN (typeIIShiftMap x) = (x.1.2 : ℤ) := by
  obtain ⟨he, hn, hm, hh, hm', hh', hne, hfirst, hsecond⟩ := mem_typeII_off_diagonal_support.mp hx
  have hpos := typeII_off_support_positive hx
  obtain ⟨k, hk, huniq⟩ := typeII_determinant_unique_nat hfirst hsecond hne
  have heq : typeIIRecoveredE (typeIIShiftMap x) = (x.1.1 : ℤ) := by
    unfold typeIIRecoveredE typeIIShiftMap
    dsimp
    rw [hk.2.2.2]
    exact typeII_determinant_e_quotient hk.1 hk.2.1
  have hnq : typeIIRecoveredN (typeIIShiftMap x) = (x.1.2 : ℤ) := by
    unfold typeIIRecoveredN
    rw [heq]
    exact typeII_determinant_n_quotient (by exact_mod_cast hpos.2.2.1.ne') (by exact_mod_cast hfirst)
  exact ⟨heq, hnq⟩

theorem typeII_recovered_shift_map {E N M H : Finset ℕ} {x : TypeIIOffIndex}
    (hx : x ∈ typeIIOffDiagonalSupport E N M H) :
    typeIIRecoveredIndex (typeIIShiftMap x) = x := by
  obtain ⟨heq, hnq⟩ := typeII_recovered_quotients hx
  apply Prod.ext
  · apply Prod.ext <;> simp [typeIIRecoveredIndex, heq, hnq]
  · rfl

theorem typeII_shift_map_injective (E N M H : Finset ℕ) :
    Set.InjOn typeIIShiftMap (typeIIOffDiagonalSupport E N M H) := by
  intro x hx y hy hxy
  calc
    x = typeIIRecoveredIndex (typeIIShiftMap x) := (typeII_recovered_shift_map hx).symm
    _ = typeIIRecoveredIndex (typeIIShiftMap y) := congrArg typeIIRecoveredIndex hxy
    _ = y := typeII_recovered_shift_map hy

theorem typeII_shift_weight_map {E N M H : Finset ℕ} {x : TypeIIOffIndex}
    (hx : x ∈ typeIIOffDiagonalSupport E N M H) (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ) :
    typeIIShiftWeight η α aH (typeIIShiftMap x) =
      η x.1.1 x.1.2 * typeIIOffCoefficient α aH x.2.1 x.2.2 := by
  have hr := congrArg Prod.fst (typeII_recovered_shift_map hx)
  have he := congrArg (fun z : ℕ × ℕ => z.1) hr
  have hn := congrArg (fun z : ℕ × ℕ => z.2) hr
  unfold typeIIShiftWeight
  change (typeIIRecoveredE (typeIIShiftMap x)).toNat = x.1.1 at he
  change (typeIIRecoveredN (typeIIShiftMap x)).toNat = x.1.2 at hn
  rw [he, hn]
  rfl

theorem typeII_off_diagonal_energy_eq_shift_image (E N M H : Finset ℕ)
    (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ) :
    typeIIOffDiagonalEnergy E N M H η α aH =
      ∑ y ∈ (typeIIOffDiagonalSupport E N M H).image typeIIShiftMap,
        typeIIShiftWeight η α aH y := by
  rw [sum_image (typeII_shift_map_injective E N M H)]
  rw [typeII_off_diagonal_energy_eq_support]
  apply sum_congr rfl
  intro x hx
  exact (typeII_shift_weight_map hx η α aH).symm

end Bounty

end

section

/- Literal finite events on the genuine mixed state. Edges move both small
residues and small injective lists; visits change only big pending memory.
The auxiliary draw and both independent active permutation choices remain
part of each event. -/

open Finset
open scoped Classical

namespace Bounty

section
variable {H K S G : Type} {Ps : S → Finset ℕ} {P : G → Type}
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : K → ∀ g, Finset (Fin (M g))) (B : ℕ) (A : K → Type)
  (Δ D : ∀ k, PhysicalSharedLists Ps J → SharedActiveLabels P (shared k) → A k → G → ℤ)

def PhysicalSmallBigPathEvent : Option (H ⊕ K) →
    PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → Type _
  | none, _ => PhysicalPermutations S J ell × FullActiveSlotPermutations M
  | some (.inl _), s => CoupledGhostEvent M B s.2
  | some (.inr k), s => PhysicalMarkLists Ps J ell ×
      FullActiveEdgeEvent n (shared k) B (fun _ => A k)
        (Δ k (physicalSharedPrefix s.1.2)) (D k (physicalSharedPrefix s.1.2)) s.2

noncomputable abbrev physicalSmallBigPathEventFintype [Fintype S] [Fintype G]
    [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k, Fintype (A k)]
    (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)) :
    Fintype (PhysicalSmallBigPathEvent n shared B A Δ D tag s) := by
  cases tag with
  | none => dsimp [PhysicalSmallBigPathEvent]; infer_instance
  | some tag => cases tag <;> dsimp [PhysicalSmallBigPathEvent] <;> infer_instance

variable [Fintype S]
  (kbig : ∀ k, SharedActiveLabels P (shared k) → A k → ℤ)

noncomputable def physicalSmallBigPathEventTarget (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)) :
    PhysicalSmallBigPathEvent n shared B A Δ D tag s →
      PhysicalSmallBigState Ps J ell
        (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :=
  match tag with
  | none => fun e => ((s.1.1, physicalPermuteLabels e.1 s.1.2), fullActivePermutation e.2 s.2)
  | some (.inl _) => fun e => (s.1, coupledGhostJointEventTarget M B s.2 e)
  | some (.inr k) => fun e =>
      ((physicalTranslateResidues s.1.1
          (kbig k (productActiveMemorySplit (shared k) B s.2).1 e.2.1 *
            (physicalSharedProduct (physicalSharedPrefix s.1.2) : ℕ)), e.1),
        fullActiveEdgeEventTarget n (shared k) B (fun _ => A k)
          (Δ k (physicalSharedPrefix s.1.2)) (D k (physicalSharedPrefix s.1.2)) s.2 e.2)

variable [Fintype G]
  (ω : ∀ k, A k → ℝ) (μ : ∀ g, P g → ℝ)
  (qghost : H → ℝ) (ρ : ℝ) (V : G → ℝ) (Vs : S → ℝ) (qsmall : ℝ)

noncomputable def physicalSmallBigPathEventWeight (tag : Option (H ⊕ K))
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)) :
    PhysicalSmallBigPathEvent n shared B A Δ D tag s → ℝ :=
  match tag with
  | none => fun e => (Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹ *
      fullActivePermutationWeight M e.2
  | some (.inl j) => fun e => coupledGhostJointEventWeight
      (fun g => physicalGhostRetention (n g) (qghost j) ρ)
      (fun g => physicalGhostTermination (n g) (qghost j) ρ)
      (fun g => physicalGhostBirth (n g) (qghost j) ρ (V g))
      (fun g => unrestrictedResidueWeight (μ g)) M B s.2 e
  | some (.inr k) => fun e =>
      (if physicalSharedPrefix s.1.2 = physicalSharedPrefix e.1 then
        physicalCompletionMass Vs (fun _ => (∅ : Finset (Fin J))) ell *
          (physicalResidueVertexWeight s.1.2 (Real.sqrt qsmall) s.1.1 *
            physicalResidueVertexWeight e.1 (Real.sqrt qsmall)
              (physicalTranslateResidues s.1.1
                (kbig k (productActiveMemorySplit (shared k) B s.2).1 e.2.1 *
                  (physicalSharedProduct (physicalSharedPrefix s.1.2) : ℕ))))
       else 0) *
        fullActiveEdgeEventWeight n (shared k) B (fun _ => A k)
          (Δ k (physicalSharedPrefix s.1.2)) (D k (physicalSharedPrefix s.1.2))
          (fun _ a => ω k a) μ ρ V s.2 e.2

end
end Bounty
end

section

/- Genuine mixed rows preserve big pending-memory symmetry for signed phases
invariant under the complete old-index event correspondence. Both small
endpoints and every active/fresh observation may enter the coefficient. -/

open Finset Classical

namespace Bounty

section
variable {S G : Type*} [Fintype S] [Fintype G] [dG : DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {J ell : ℕ} {M : G → ℕ} (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (kbig : SharedActiveLabels P shared → ℤ)

noncomputable def physicalSmallBigEventMemoryReindex
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val)) :
    PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s ≃
      PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D)
        (s.1, productMemoryReindex s.2 τ) :=
  Equiv.prodCongr (Equiv.refl _) (fullEdgeMemoryReindex n shared B (fun _ => Unit)
    (fun c _ => Δ (physicalSharedPrefix s.1.2) c)
    (fun c _ => D (physicalSharedPrefix s.1.2) c) s.2 τ)

omit dG in
theorem physical_small_big_reindex_weight (Vs : S → ℝ) (q : ℝ)
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val))
    (e : PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s) :
    physicalSmallBigPositiveWeight Vs q (PhysicalSmallBigFullEvent n shared B Δ D)
      (physicalSmallBigFullWeight n shared B Δ D μ ρ V)
      (fun x => kbig (productActiveMemorySplit shared B x).1)
      (s.1, productMemoryReindex s.2 τ) (physicalSmallBigEventMemoryReindex n shared B Δ D s τ e) =
    physicalSmallBigPositiveWeight Vs q (PhysicalSmallBigFullEvent n shared B Δ D)
      (physicalSmallBigFullWeight n shared B Δ D μ ρ V)
      (fun x => kbig (productActiveMemorySplit shared B x).1) s e := by
  exact congrArg (fun w : ℝ =>
    if physicalSharedPrefix s.1.2 = physicalSharedPrefix e.1 then
      physicalCompletionMass Vs (fun _ => (∅ : Finset (Fin J))) ell *
        (physicalResidueVertexWeight s.1.2 (Real.sqrt q) s.1.1 *
          physicalResidueVertexWeight e.1 (Real.sqrt q) (physicalTranslateResidues s.1.1
            (kbig (productActiveMemorySplit shared B s.2).1 *
              (physicalSharedProduct (physicalSharedPrefix s.1.2) : ℕ)))) * w else 0)
    (full_edge_reindex_weight n shared B (fun _ => Unit)
      (fun c _ => Δ (physicalSharedPrefix s.1.2) c)
      (fun c _ => D (physicalSharedPrefix s.1.2) c) s.2 τ (fun _ _ => 1) μ ρ V e.2)

theorem physical_small_big_reindex_test
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val))
    (e : PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ z, ProductMemorySymmetric (fun x => F (z,x))) :
    F (physicalSmallBigTarget (PhysicalSmallBigFullEvent n shared B Δ D)
      (physicalSmallBigFullTarget n shared B Δ D)
      (fun x => kbig (productActiveMemorySplit shared B x).1)
      (s.1, productMemoryReindex s.2 τ) (physicalSmallBigEventMemoryReindex n shared B Δ D s τ e)) =
    F (physicalSmallBigTarget (PhysicalSmallBigFullEvent n shared B Δ D)
      (physicalSmallBigFullTarget n shared B Δ D)
      (fun x => kbig (productActiveMemorySplit shared B x).1) s e) := by
  exact full_edge_reindex_test n shared B (fun _ => Unit)
    (fun c _ => Δ (physicalSharedPrefix s.1.2) c)
    (fun c _ => D (physicalSharedPrefix s.1.2) c) s.2 τ e.2
    (fun y => F ((physicalTranslateResidues s.1.1
      (kbig (productActiveMemorySplit shared B s.2).1 *
        (physicalSharedProduct (physicalSharedPrefix s.1.2) : ℕ)), e.1), y)) (hF _)

theorem physical_small_big_full_signed_memory_symmetric (Vs : S → ℝ) (q : ℝ)
    (Φ : ∀ s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
      PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s → ℂ)
    (hΦ : ∀ (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
      (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val))
      (e : PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s),
      Φ (s.1, productMemoryReindex s.2 τ)
        (physicalSmallBigEventMemoryReindex n shared B Δ D s τ e) = Φ s e)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ z, ProductMemorySymmetric (fun x => F (z,x))) :
    ∀ z, ProductMemorySymmetric (fun x =>
      physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q Φ F (z,x)) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro z x g τ
  dsimp only
  refine (congrArg (fun y => physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q Φ F (z,y))
    (product_memory_reindex_at x g τ)).symm.trans ?_
  unfold physicalSmallBigFullPhasedAction physicalSmallBigPhasedAction
  rw [← (physicalSmallBigEventMemoryReindex n shared B Δ D (z,x)
    (Function.update (fun h => Equiv.refl (Fin (x h).2.1.val)) g τ)).sum_comp]
  apply sum_congr rfl
  intro e _
  let σ := Function.update (fun h => Equiv.refl (Fin (x h).2.1.val)) g τ
  have hw := physical_small_big_reindex_weight n shared B Δ D μ ρ V kbig Vs q (z,x) σ e
  have hp := hΦ (z,x) σ e
  have ht := physical_small_big_reindex_test n shared B Δ D kbig (z,x) σ e F hF
  exact congrArg₂ (fun a b : ℂ => a * b)
    (congrArg₂ (fun a b : ℂ => a * b) (congrArg Complex.ofReal hw) hp) ht

noncomputable def physicalSmallBigObservablePhase
    (Φ : PhysicalBareResidueState Ps J ell → PhysicalBareResidueState Ps J ell →
      (∀ g, Fin (M g) → P g) → (∀ g, Fin (M g) → P g) →
      (∀ g, EdgeDrawObservation (P g) (shared g)ᶜ.card) → ℂ)
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (e : PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s) : ℂ :=
  Φ s.1 (physicalSmallBigTarget (PhysicalSmallBigFullEvent n shared B Δ D)
    (physicalSmallBigFullTarget n shared B Δ D)
    (fun x => kbig (productActiveMemorySplit shared B x).1) s e).1
    (fun g => (s.2 g).1) (fun g => (physicalSmallBigFullTarget n shared B Δ D
      (physicalSharedPrefix s.1.2) s.2 e.2 g).1)
    (fun g => ⟨(e.2.2 g).1, (e.2.2 g).2.1, (e.2.2 g).2.2.2⟩)

omit [Fintype G] dG in
theorem physical_small_big_observable_phase_reindex
    (Φ : PhysicalBareResidueState Ps J ell → PhysicalBareResidueState Ps J ell →
      (∀ g, Fin (M g) → P g) → (∀ g, Fin (M g) → P g) →
      (∀ g, EdgeDrawObservation (P g) (shared g)ᶜ.card) → ℂ)
    (s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B))
    (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val))
    (e : PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s) :
    physicalSmallBigObservablePhase n shared B Δ D kbig Φ (s.1, productMemoryReindex s.2 τ)
      (physicalSmallBigEventMemoryReindex n shared B Δ D s τ e) =
    physicalSmallBigObservablePhase n shared B Δ D kbig Φ s e := by
  exact congrArg (fun target => Φ s.1
    (physicalSmallBigTarget (PhysicalSmallBigFullEvent n shared B Δ D)
      (physicalSmallBigFullTarget n shared B Δ D)
      (fun x => kbig (productActiveMemorySplit shared B x).1) s e).1
    (fun g => (s.2 g).1) target
    (fun g => ⟨(e.2.2 g).1, (e.2.2 g).2.1, (e.2.2 g).2.2.2⟩))
    (funext (full_edge_reindex_active n shared B (fun _ => Unit)
      (fun c _ => Δ (physicalSharedPrefix s.1.2) c)
      (fun c _ => D (physicalSharedPrefix s.1.2) c) s.2 τ e.2))




end
end Bounty
end

section

/- The fixed compact cutoff preserves the actual allocation exactly on good tuples. -/

open Finset Filter Real

namespace Bounty

noncomputable def candidateCompactAllocationWeight (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (R : ℝ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) : ℝ :=
  compactAllocationWeight (candidateAllocationRadius r) _
    (fun i => log (candidateAllocationValue c L r jStar x i))
    (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
    (candidateAllocationActive c L r jStar) R take

theorem candidate_compact_allocation_bounds (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (R : ℝ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) :
    0 ≤ candidateCompactAllocationWeight c L r jStar x R take ∧
      candidateCompactAllocationWeight c L r jStar x R take ≤
        candidateAllocationWeight c L r jStar x R take :=
  compact_allocation_weight_bounds _ _ _ _ _ _ _

theorem candidate_compact_allocation_total_mass_le_one (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (R : ℝ) :
    (∑ take, candidateCompactAllocationWeight c L r jStar x R take) ≤ 1 :=
  compact_allocation_total_mass_le_one _ _ _ _ _ _

theorem eventually_candidate_compact_allocation_exact {c : ℝ} (hc : 0 < c)
    {r : ℕ} (hr : 6 ≤ r) :
    ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ) (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
      (R : ℝ), 0 ≤ R → R ≤ smoothAllocationInventory _
        (fun i => log (candidateAllocationValue c L r jStar x i))
        (candidateAllocationActive c L r jStar)+88*log L →
      (∀ take, candidateCompactAllocationWeight c L r jStar x R take =
        candidateAllocationWeight c L r jStar x R take) ∧
      (∑ take, candidateCompactAllocationWeight c L r jStar x R take) = 1 := by
  filter_upwards [eventually_candidate_allocation_arguments_bounded hc hr] with L hargs
  intro jStar x R hR hcap
  have heq : ∀ take, candidateCompactAllocationWeight c L r jStar x R take =
      candidateAllocationWeight c L r jStar x R take := by
    intro take
    by_cases hpos : 0 < candidateAllocationWeight c L r jStar x R take
    · apply compact_allocation_eq_of_args
      intro i hi
      exact hargs jStar x R take hR hcap hpos i
    · have hb := candidate_compact_allocation_bounds c L r jStar x R take
      have hn := candidate_allocation_weight_nonneg c L r jStar x R take
      linarith
  refine ⟨heq, ?_⟩
  simp only [heq, candidate_allocation_total_mass]

theorem eventually_candidate_good_tuple_compact_allocation {c : ℝ} (hc : 0 < c)
    {r : ℕ} (hr : 6 ≤ r) :
    ∀ᶠ L : ℝ in atTop, ∀ (jStar P : ℕ) (hj : jStar ∈ candidateQIndices c L)
      (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (E b : ℝ),
      0 ≤ b → 1 ≤ E →
      exp L ≤ (P*orderedSlotProduct (candidateQSlotChoices c L r jStar) x : ℕ) →
      (P*(x (candidateRoughSlot c L r jStar (by omega) hj)).val : ℕ) ≤ exp (b/2*L) →
      log E ≤ (1-b)*L →
      (∀ take, candidateCompactAllocationWeight c L r jStar x (log E) take =
        candidateAllocationWeight c L r jStar x (log E) take) ∧
      (∑ take, candidateCompactAllocationWeight c L r jStar x (log E) take) = 1 := by
  filter_upwards [eventually_candidate_compact_allocation_exact hc hr,
    eventually_ge_atTop (1 : ℝ)] with L hL hL1
  intro jStar P hj x E b hb hE1 htotal hretained hE
  apply hL jStar x (log E) (log_nonneg hE1)
  have hi := candidate_allocation_inventory_of_product_bounds c L r jStar P (by omega) hj x
    L (b/2*L) htotal hretained
  have hlog := log_nonneg hL1
  nlinarith [mul_nonneg hb (zero_le_one.trans hL1)]

end Bounty
end

section

/- Explicit polynomial envelope for the actual Type-II scale parameters. -/

open Filter MeasureTheory

namespace Bounty

noncomputable def typeIIScaleParameters (L U V E Z : ℝ) (k : ℤ) : Fin 4 → ℝ :=
  ![L ^ 88, U / (2 * (k : ℝ) * E), Z / ((k : ℝ) * U * V), 1 / (U * V)]

noncomputable def typeIIScaleEnvelopeExponent (K₀ Cz : ℝ) : ℝ :=
  max 88 (max K₀ (max Cz 0))

theorem typeII_integer_abs_ge_one {k : ℤ} (hk : k ≠ 0) : 1 ≤ |(k : ℝ)| := by
  have hpos : (0 : ℤ) < |k| := abs_pos.mpr hk
  have h : (1 : ℤ) ≤ |k| := by omega
  exact_mod_cast h

theorem typeII_scale_first_coefficient {L U E K₀ : ℝ} {k : ℤ}
    (hL : 0 < L) (hU : 0 < U) (hk : k ≠ 0) (hE : E = U * L ^ (-K₀)) :
    U / (2 * (k : ℝ) * E) = L ^ K₀ / (2 * (k : ℝ)) := by
  have hkr : (k : ℝ) ≠ 0 := by exact_mod_cast hk
  rw [hE, Real.rpow_neg hL.le]
  have hp : L ^ K₀ ≠ 0 := (Real.rpow_pos_of_pos hL K₀).ne'
  field_simp

theorem typeII_scale_parameter_envelope {L U V E Z K₀ Cz : ℝ} {k : ℤ}
    (hL : 1 ≤ L) (hU : 0 < U) (hV : 0 < V) (hZ : 0 ≤ Z) (hk : k ≠ 0)
    (hE : E = U * L ^ (-K₀)) (hUV : 1 ≤ U * V)
    (hZbound : Z / (U * V) ≤ L ^ Cz) :
    ‖typeIIScaleParameters L U V E Z k‖ ≤ L ^ typeIIScaleEnvelopeExponent K₀ Cz := by
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hk1 := typeII_integer_abs_ge_one hk
  have hUV0 : 0 < U * V := mul_pos hU hV
  have ha : |U / (2 * (k : ℝ) * E)| ≤ L ^ K₀ := by
    rw [typeII_scale_first_coefficient hL0 hU hk hE, abs_div,
      abs_of_pos (Real.rpow_pos_of_pos hL0 K₀), abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
    exact div_le_self (Real.rpow_nonneg hL0.le _) (by linarith)
  have hb : |Z / ((k : ℝ) * U * V)| ≤ L ^ Cz := by
    rw [abs_div, abs_of_nonneg hZ, abs_mul, abs_mul, abs_of_pos hU, abs_of_pos hV]
    have hd : U * V ≤ |(k : ℝ)| * U * V := by nlinarith
    exact (div_le_div_of_nonneg_left hZ hUV0 hd).trans hZbound
  have hc : |1 / (U * V)| ≤ 1 := by
    rw [abs_of_pos (one_div_pos.mpr hUV0)]
    exact div_le_self (by norm_num) hUV
  have hM0 : 0 ≤ typeIIScaleEnvelopeExponent K₀ Cz := by
    unfold typeIIScaleEnvelopeExponent
    exact (le_max_right Cz 0).trans ((le_max_right K₀ (max Cz 0)).trans (le_max_right 88 _))
  apply (pi_norm_le_iff_of_nonneg (Real.rpow_nonneg hL0.le _)).mpr
  intro i
  fin_cases i
  · change ‖L ^ 88‖ ≤ _
    rw [Real.norm_of_nonneg (pow_nonneg hL0.le _), ← Real.rpow_natCast]
    exact Real.rpow_le_rpow_of_exponent_le hL (le_max_left _ _)
  · change ‖U / (2 * (k : ℝ) * E)‖ ≤ _
    rw [Real.norm_eq_abs]
    exact ha.trans (Real.rpow_le_rpow_of_exponent_le hL
      ((le_max_left K₀ _).trans (le_max_right 88 _)))
  · change ‖Z / ((k : ℝ) * U * V)‖ ≤ _
    rw [Real.norm_eq_abs]
    exact hb.trans (Real.rpow_le_rpow_of_exponent_le hL
      ((le_max_left Cz 0).trans ((le_max_right K₀ _).trans (le_max_right 88 _))))
  · change ‖1 / (U * V)‖ ≤ _
    rw [Real.norm_eq_abs]
    exact hc.trans (Real.one_le_rpow hL hM0)

end Bounty
end

section

/- An arbitrary logarithmic saving for replacing the literal sharp candidate window. -/

open Finset Filter Real

namespace Bounty

theorem exists_candidate_sharp_smoothing_error_bound {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) (A D : ℝ) :
    ∃ B : ℝ, 1 ≤ B ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (jStar : ℕ) (T : Finset ℕ) (ψ : ℕ → ℝ) (F : ℕ → ℕ → ℂ),
      arithmeticProductWindow 1 (exp L) ⊆ T →
      (∀ u ∈ T, 0 ≤ ψ u ∧ ψ u ≤ 1) →
      (∀ u ∈ T, u ∉ typeIIBoundaryWindow (exp L) (L^(-B)) →
        ψ u = if u ∈ arithmeticProductWindow 1 (exp L) then 1 else 0) →
      (∀ u ∈ typeIIBoundaryWindow (exp L) (L^(-B)),
        ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
      ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
          (candidateCoefficient c L q r jStar u : ℂ) *
            (∑ m ∈ (2*u+1).divisors, F u m)) -
        (∑ u ∈ T, (candidateCoefficient c L q r jStar u : ℂ) * (ψ u : ℂ) *
            (∑ m ∈ (2*u+1).divisors, F u m))‖ ≤ exp L * L^(-D) := by
  obtain ⟨B, hB, hbound⟩ := exists_candidate_boundary_divisor_test_bound hc hr hq0 hq1 A D
  refine ⟨B, hB, ?_⟩
  filter_upwards [hbound] with L hL
  intro jStar T ψ F hT hψ hmatch hF
  have herror := finite_divisor_sharp_smoothed_difference_norm_le T
    (typeIIBoundaryWindow (exp L) (L^(-B))) (arithmeticProductWindow 1 (exp L))
    (candidateCoefficient c L q r jStar) ψ F
    (candidate_coefficient_nonneg c L hq0 r jStar) hψ hmatch
  rw [inter_eq_right.mpr hT] at herror
  exact herror.trans (hL jStar F hF)




end Bounty
end

section

/- Removing a union of free-label divisibility exclusions costs the sum of reciprocal labels. -/

open Finset

namespace Bounty

section Endpoints

variable (Q T : Finset ℕ) (α β γ α' β' γ' : ℕ → ℂ)
  {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
  (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
  (hα' : ∀ m, ‖α' m‖ ≤ A) (hβ' : ∀ p, ‖β' p‖ ≤ B) (hγ' : ∀ r, ‖γ' r‖ ≤ C)
  (S : Finset ℤ) (δ : ℤ) (N : ℕ)
  (hT : ∀ d ∈ T, d ∈ Nat.factoredNumbers Q) (hδ : ∀ d ∈ T, (d : ℤ) ∣ δ)
  (hS : ∀ n ∈ S, 0 ≤ n ∧ n ≤ (N : ℤ))
  (hS' : ∀ n ∈ S, 0 ≤ n + δ ∧ n + δ ≤ (N : ℤ))

include hA hB hC hα hβ hγ hα' hβ' hγ' hT hδ hS hS'

theorem invariant_triple_endpoint_excluded_cross_bound :
    (∑ n ∈ S.filter (fun n => ∃ d ∈ T, (d : ℤ) ∣ n),
      ‖invariantTripleEndpoint Q α β γ n.natAbs‖ *
      ‖invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs‖) ≤
      ((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) * ∑ d ∈ T, 1 / (d : ℝ) := by
  classical
  let f := fun n : ℤ => ‖invariantTripleEndpoint Q α β γ n.natAbs‖ *
    ‖invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs‖
  have hpos : ∀ n, 0 ≤ f n := fun n => mul_nonneg (norm_nonneg _) (norm_nonneg _)
  have hpoint (n : ℤ) : (if ∃ d ∈ T, (d : ℤ) ∣ n then f n else 0) ≤
      ∑ d ∈ T, if (d : ℤ) ∣ n then f n else 0 := by
    by_cases hn : ∃ d ∈ T, (d : ℤ) ∣ n
    · obtain ⟨d, hd, hdn⟩ := hn
      rw [if_pos ⟨d, hd, hdn⟩]
      calc
        f n = (if (d : ℤ) ∣ n then f n else 0) := (if_pos hdn).symm
        _ ≤ _ := single_le_sum (s := T) (f := fun (e : ℕ) => if (e : ℤ) ∣ n then f n else 0)
          (a := d) (fun e _ => by split_ifs <;> positivity) hd
    · rw [if_neg hn]
      exact sum_nonneg (fun d _ => by split_ifs <;> positivity)
  change (∑ n ∈ S.filter (fun n => ∃ d ∈ T, (d : ℤ) ∣ n), f n) ≤ _
  rw [sum_filter]
  calc
    _ ≤ ∑ n ∈ S, ∑ d ∈ T, if (d : ℤ) ∣ n then f n else 0 :=
      sum_le_sum (fun n _ => hpoint n)
    _ = ∑ d ∈ T, ∑ n ∈ S.filter (fun n => (d : ℤ) ∣ n), f n := by
      rw [sum_comm]
      simp only [sum_filter]
    _ ≤ ∑ d ∈ T, (A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15 / d := by
      apply sum_le_sum
      intro d hd
      exact invariant_triple_endpoint_cross_multiples Q α β γ α' β' γ'
        hA hB hC hα hβ hγ hα' hβ' hγ' (S.filter (fun n => (d : ℤ) ∣ n)) δ d N
        (hT d hd) (hδ d hd) (fun n hn => (mem_filter.mp hn).2)
        (fun n hn => hS n (mem_filter.mp hn).1)
        (fun n hn => hS' n (mem_filter.mp hn).1)
    _ = _ := by
      rw [mul_sum]
      apply sum_congr rfl
      intro d _
      ring

theorem invariant_triple_endpoint_exclusion_error
    {Y K : ℝ} (hY : 0 < Y) (hK : 0 ≤ K) (hYlow : ∀ n ∈ S, Y ≤ (n : ℝ))
    (w : ℤ → ℂ) (hw : ∀ n ∈ S, ‖w n‖ ≤ K) :
    let f := fun n : ℤ => (w n / (n : ℂ)) *
      star (invariantTripleEndpoint Q α β γ n.natAbs) *
      invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs
    ‖(∑ n ∈ S, f n) -
      ∑ n ∈ S.filter (fun n => ¬ ∃ d ∈ T, (d : ℤ) ∣ n), f n‖ ≤
      (K / Y) * ((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) *
        ∑ d ∈ T, 1 / (d : ℝ) := by
  classical
  dsimp only
  let bad := fun n : ℤ => ∃ d ∈ T, (d : ℤ) ∣ n
  let f := fun n : ℤ => (w n / (n : ℂ)) *
    star (invariantTripleEndpoint Q α β γ n.natAbs) *
    invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs
  have heq : (∑ n ∈ S, f n) - ∑ n ∈ S.filter (fun n => ¬ bad n), f n =
      ∑ n ∈ S.filter bad, f n := by
    apply sub_eq_iff_eq_add.mpr
    exact (sum_filter_add_sum_filter_not S bad f).symm
  change ‖(∑ n ∈ S, f n) - ∑ n ∈ S.filter (fun n => ¬ bad n), f n‖ ≤ _
  rw [heq]
  apply (norm_sum_le _ _).trans
  calc
    _ ≤ ∑ n ∈ S.filter bad, (K / Y) *
        (‖invariantTripleEndpoint Q α β γ n.natAbs‖ *
          ‖invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs‖) := by
      apply sum_le_sum
      intro n hn
      have hnS := (mem_filter.mp hn).1
      have hn0 : (0 : ℝ) < n := hY.trans_le (hYlow n hnS)
      have hnC : ‖(n : ℂ)‖ = (n : ℝ) := by
        rw [← Complex.ofReal_intCast, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hn0]
      dsimp only [f]
      rw [norm_mul, norm_mul, norm_div, norm_star, hnC, mul_assoc]
      exact mul_le_mul_of_nonneg_right (div_le_div₀ hK (hw n hnS) hY (hYlow n hnS))
        (mul_nonneg (norm_nonneg _) (norm_nonneg _))
    _ = (K / Y) * ∑ n ∈ S.filter bad,
        ‖invariantTripleEndpoint Q α β γ n.natAbs‖ *
          ‖invariantTripleEndpoint Q α' β' γ' (n + δ).natAbs‖ := (mul_sum ..).symm
    _ ≤ _ := by
      rw [mul_assoc]
      exact mul_le_mul_of_nonneg_left
        (invariant_triple_endpoint_excluded_cross_bound Q T α β γ α' β' γ'
          hA hB hC hα hβ hγ hα' hβ' hγ' S δ N hT hδ hS hS') (div_nonneg hK hY.le)

end Endpoints

end Bounty
end

section

/- Exact Bochner integral separation of the original root-weighted physical pairing. -/

open Finset MeasureTheory

namespace Bounty

noncomputable def physicalMellinPairing
    {G I : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) (patterns : Finset I) (C : I → G → Finset (Fin J))
    (q : ℝ) (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (f g : ℤ → ℂ) (X Z v : ℝ) : ℂ :=
  inner ℂ (physicalEndpointVector P V J ell q positions (physicalMellinSource X Z v f))
    (physicalHilbertOperator V patterns C q (fun i => ζ i - v) k K positions
      (physicalEndpointVector P V J ell q positions g))




theorem physical_mellin_root_eq_integral
    {G I : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (hP : ∀ g p, p ∈ P g → 0 < p)
    (V : G → ℝ) (hV : ∀ g, 0 < V g) (patterns : Finset I)
    (C : I → G → Finset (Fin J)) {q : ℝ} (hq : 0 ≤ q)
    (ζ : I → ℝ) (k : I → ℤ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (positions : Finset ℤ) (f g : ℤ → ℂ)
    (hsource : ∀ n ∈ positions, f n ≠ 0 → 0 < n)
    (X Z : ℝ) (hX : X ≠ 0) (hZ : 0 < Z)
    (ρ : ℝ → ℂ) (ν : ℝ → ℝ) (hρ : Integrable ρ) (hν : Continuous ν)
    (Ψ : ℝ → ℂ)
    (hΨ : ∀ t : ℝ, 0 < t → Ψ t = ∫ v : ℝ, ρ v * physicalMellinPhase (ν v) t) :
    physicalMellinRootCorrelation V patterns C q ζ k K positions f g Ψ Z =
      (X : ℂ)⁻¹ * ∫ v : ℝ, ρ v * physicalMellinPairing V patterns C q ζ k K positions f g X Z (ν v) := by
  classical
  let c := physicalMellinAtomCoefficient V patterns C q ζ k K positions f g
  let t := fun a : PhysicalMellinAtom P J ell patterns C positions => physicalMellinAtomArgument Z a
  have he := finite_mellin_sum_representation univ ρ ν hρ hν c t Ψ (by
    intro a _ ha
    apply hΨ
    have hf : f a.1.val.1 ≠ 0 := by
      intro hf
      exact ha (physical_mellin_atom_coefficient_zero V patterns C q ζ k K positions f g a hf)
    exact physical_mellin_atom_argument_pos hZ hP a
      (hsource _ ((mem_physical_cutoff P J ell positions a.1.val).mp a.1.property) hf))
  have hi : (∫ v : ℝ, ρ v * physicalMellinPairing V patterns C q ζ k K positions f g X Z (ν v)) =
      (X : ℂ) * ((physicalStateMass V J ell : ℂ) *
        ∫ v : ℝ, ρ v * ∑ a, c a * physicalMellinPhase (ν v) (t a)) := by
    calc
      _ = ∫ v : ℝ, (X : ℂ) * ((physicalStateMass V J ell : ℂ) *
          (ρ v * ∑ a, c a * physicalMellinPhase (ν v) (t a))) := by
        apply integral_congr_ae
        exact Filter.Eventually.of_forall (fun v => by
          dsimp only [physicalMellinPairing]
          rw [physical_mellin_pairing_atoms hP V hV patterns C hq ζ k K
            positions f g hsource X Z (ν v) (ne_of_gt hZ)]
          dsimp only [c, t]
          ring)
      _ = _ := by rw [integral_const_mul, integral_const_mul]
  rw [physical_mellin_root_as_atoms]
  change (physicalStateMass V J ell : ℂ) * (∑ a, c a * Ψ (t a)) = _
  rw [he, hi]
  have hXc : (X : ℂ) ≠ 0 := by exact_mod_cast hX
  rw [inv_mul_cancel_left₀ hXc]

end Bounty
end

section

/- Smoothing precision is chosen before the Fourier truncation precision. -/

open Filter MeasureTheory

namespace Bounty

theorem typeII_window_fourier_polynomial_cost {B : ℝ} (hB : 0 ≤ B) :
    ∃ H : ℝ, 0 < H ∧ ∀ᶠ L : ℝ in atTop,
      (∫ ξ : ℝ, ‖typeIIWindowFourier (L ^ B) ξ‖) ≤ L ^ H := by
  obtain ⟨d, C, hC, hb⟩ := typeII_window_fourier_l1_polynomial
  refine ⟨B * d + 1, by positivity, ?_⟩
  filter_upwards [eventually_ge_atTop (max 1 (C * 2 ^ d))] with L hL
  have hL1 : 1 ≤ L := (le_max_left _ _).trans hL
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL1
  have hCL : C * 2 ^ d ≤ L := (le_max_right _ _).trans hL
  have hp : ‖L ^ B‖ ≤ L ^ B := by rw [Real.norm_eq_abs, abs_of_pos (Real.rpow_pos_of_pos hL0 B)]
  have hw : (1 + |L ^ B|) ^ d ≤ 2 ^ d * L ^ (B * d) := by
    simpa only [Real.norm_eq_abs] using parameter_weight_le_power hL1 hB hp d
  calc
    _ ≤ C * (1 + |L ^ B|) ^ d := hb _
    _ ≤ C * (2 ^ d * L ^ (B * d)) := mul_le_mul_of_nonneg_left hw hC
    _ = (C * 2 ^ d) * L ^ (B * d) := by ring
    _ ≤ L * L ^ (B * d) := mul_le_mul_of_nonneg_right hCL (Real.rpow_nonneg hL0.le _)
    _ = L ^ (B * d + 1) := by rw [Real.rpow_add hL0, Real.rpow_one]; ring

theorem typeII_window_smoothing_power_cutoff {B D : ℝ} (hB : 0 ≤ B) (hD : 0 ≤ D) :
    ∃ F : ℝ, 0 < F ∧ ∀ᶠ L : ℝ in atTop, ∀ s : ℝ,
      ‖(typeIIWindowSmooth (L ^ (-B)) (Real.exp s) : ℂ) -
        ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L ^ F}, typeIIWindowFourierIntegrand (L ^ B) s ξ‖ ≤
          L ^ (-D) := by
  obtain ⟨d, C, hC, hb⟩ := typeII_window_fourier_truncation_polynomial 1
  let F : ℝ := B * d + D + 1
  refine ⟨F, by dsimp [F]; positivity, ?_⟩
  filter_upwards [eventually_ge_atTop (max 1 (C * 2 ^ d))] with L hL
  have hL1 : 1 ≤ L := (le_max_left _ _).trans hL
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL1
  have hCL : C * 2 ^ d ≤ L := (le_max_right _ _).trans hL
  have hp : ‖L ^ B‖ ≤ L ^ B := by rw [Real.norm_eq_abs, abs_of_pos (Real.rpow_pos_of_pos hL0 B)]
  have hw : (1 + |L ^ B|) ^ d ≤ 2 ^ d * L ^ (B * d) := by
    simpa only [Real.norm_eq_abs] using parameter_weight_le_power hL1 hB hp d
  have hid : (L ^ (-B))⁻¹ = L ^ B := by rw [Real.rpow_neg hL0.le, inv_inv]
  have hδ : 0 < L ^ (-B) := Real.rpow_pos_of_pos hL0 _
  intro s
  have heq := typeII_window_log_cutoff_eq_smooth hδ s
  rw [hid] at heq
  rw [← heq]
  have hpower : 0 ≤ (L ^ F) ^ (-(1 : ℝ)) := Real.rpow_nonneg (Real.rpow_nonneg hL0.le _) _
  calc
    _ ≤ C * (1 + |L ^ B|) ^ d * (L ^ F) ^ (-(1 : ℝ)) := by
      simpa only [Nat.cast_one] using hb (L ^ B) (L ^ F) (Real.rpow_pos_of_pos hL0 F) s
    _ ≤ C * (2 ^ d * L ^ (B * d)) * (L ^ F) ^ (-(1 : ℝ)) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hw hC.le) hpower
    _ = (C * 2 ^ d) * (L ^ (B * d) * (L ^ F) ^ (-(1 : ℝ))) := by ring
    _ ≤ L * (L ^ (B * d) * (L ^ F) ^ (-(1 : ℝ))) :=
      mul_le_mul_of_nonneg_right hCL (mul_nonneg (Real.rpow_nonneg hL0.le _) hpower)
    _ = L ^ (-D) := by
      rw [← Real.rpow_mul hL0.le, mul_neg_one, ← Real.rpow_add hL0]
      conv_lhs => lhs; rw [← Real.rpow_one L]
      rw [← Real.rpow_add hL0]
      congr 1
      dsimp [F]
      ring

theorem typeII_window_mellin_power_cutoff {B D : ℝ} (hB : 0 ≤ B) (hD : 0 ≤ D) :
    ∃ F : ℝ, 0 < F ∧ ∀ᶠ L : ℝ in atTop, ∀ e h x : ℝ, 0 < e → 0 < h → 0 < x →
      ‖(typeIIWindowSmooth (L ^ (-B)) (e * h / x) : ℂ) -
        ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ L ^ F},
          ((x : ℂ) ^ (-((2 * Real.pi * ξ : ℝ) : ℂ) * Complex.I) *
            (e : ℂ) ^ (((2 * Real.pi * ξ : ℝ) : ℂ) * Complex.I) *
            (h : ℂ) ^ (((2 * Real.pi * ξ : ℝ) : ℂ) * Complex.I)) *
              typeIIWindowFourier (L ^ B) ξ‖ ≤ L ^ (-D) := by
  obtain ⟨F, hF, hf⟩ := typeII_window_smoothing_power_cutoff hB hD
  refine ⟨F, hF, ?_⟩
  filter_upwards [hf] with L hL
  intro e h x he hh hx
  have harg : 0 < e * h / x := div_pos (mul_pos he hh) hx
  have ht := hL (Real.log (e * h / x))
  rw [Real.exp_log harg] at ht
  convert ht using 2
  congr 1
  apply integral_congr_ae
  filter_upwards [] with ξ
  unfold typeIIWindowFourierIntegrand
  rw [typeII_window_mellin_phase he hh hx ξ]




end Bounty
end

section

/- Finite weighted Mellin sums and their exact integral linearity. -/

open Finset MeasureTheory

namespace Bounty

noncomputable def candidateWindowMellinKernel (L : ℝ) (u : ℕ) (ξ : ℝ) : ℂ :=
  (Real.exp L : ℂ) ^ (-((2*Real.pi*ξ : ℝ) : ℂ)*Complex.I) *
    (u : ℂ) ^ (((2*Real.pi*ξ : ℝ) : ℂ)*Complex.I)

theorem candidate_window_mellin_kernel_eq_exp (L : ℝ) {u : ℕ} (hu : 0 < u) (ξ : ℝ) :
    candidateWindowMellinKernel L u ξ =
      Complex.exp (((2*Real.pi*ξ*Real.log ((u:ℝ)/Real.exp L) : ℝ) : ℂ)*Complex.I) := by
  have h := typeII_window_mellin_phase (e := (u:ℝ)) (h := 1) (x := Real.exp L)
    (by exact_mod_cast hu) (by norm_num) (Real.exp_pos L) ξ
  simpa only [mul_one, Complex.ofReal_natCast, Complex.ofReal_one, Complex.one_cpow,
    candidateWindowMellinKernel] using h.symm

theorem candidate_window_mellin_kernel_integrable (L B : ℝ) {u : ℕ} (hu : 0 < u) :
    Integrable (fun ξ : ℝ => candidateWindowMellinKernel L u ξ * typeIIWindowFourier (L^B) ξ) := by
  apply (typeII_window_fourier_integrand_integrable (L^B)
    (Real.log ((u:ℝ)/Real.exp L))).congr
  apply Filter.Eventually.of_forall
  intro ξ
  dsimp only
  rw [candidate_window_mellin_kernel_eq_exp L hu]
  rfl

noncomputable def finiteWindowMellinIntegrand (L B : ℝ) (S : Finset ℕ)
    (a G : ℕ → ℂ) (ξ : ℝ) : ℂ :=
  ∑ u ∈ S, a u * (candidateWindowMellinKernel L u ξ * typeIIWindowFourier (L^B) ξ) * G u

section

variable
  (L B : ℝ)
  (S : Finset ℕ)
  (a G : ℕ → ℂ)

include L B S a G

theorem finite_window_mellin_integrand_separated  (ξ : ℝ) :
    finiteWindowMellinIntegrand L B S a G ξ =
      (Real.exp L : ℂ)^(-((2*Real.pi*ξ : ℝ):ℂ)*Complex.I) * typeIIWindowFourier (L^B) ξ *
        ∑ u ∈ S, a u * (u:ℂ)^(((2*Real.pi*ξ : ℝ):ℂ)*Complex.I) * G u := by
  simp only [finiteWindowMellinIntegrand, candidateWindowMellinKernel, mul_sum]
  apply sum_congr rfl
  intro u hu
  ring

theorem finite_window_mellin_integrable  (hS : ∀ u ∈ S, 0 < u) :
    Integrable (finiteWindowMellinIntegrand L B S a G) := by
  apply integrable_finsetSum
  intro u hu
  exact ((candidate_window_mellin_kernel_integrable L B (hS u hu)).const_mul (a u)).mul_const (G u)

theorem finite_window_mellin_setIntegral  (hS : ∀ u ∈ S, 0 < u) (E : Set ℝ) :
    (∫ ξ in E, finiteWindowMellinIntegrand L B S a G ξ) =
      ∑ u ∈ S, a u * (∫ ξ in E,
        candidateWindowMellinKernel L u ξ * typeIIWindowFourier (L^B) ξ) * G u := by
  unfold finiteWindowMellinIntegrand
  rw [integral_finsetSum]
  · apply sum_congr rfl
    intro u hu
    rw [integral_mul_const, integral_const_mul]
  · intro u hu
    exact (((candidate_window_mellin_kernel_integrable L B (hS u hu)).const_mul (a u)).mul_const
      (G u)).integrableOn

end


theorem finite_window_mellin_error_le (L B : ℝ) (S : Finset ℕ)
    (a G ψ : ℕ → ℂ) (hS : ∀ u ∈ S, 0 < u) (E : Set ℝ) (ε : ℝ)
    (hε : ∀ u ∈ S, ‖ψ u - (∫ ξ in E,
      candidateWindowMellinKernel L u ξ * typeIIWindowFourier (L^B) ξ)‖ ≤ ε) :
    ‖(∑ u ∈ S, a u * ψ u * G u) -
      (∫ ξ in E, finiteWindowMellinIntegrand L B S a G ξ)‖ ≤
        ε * ∑ u ∈ S, ‖a u‖ * ‖G u‖ := by
  rw [finite_window_mellin_setIntegral L B S a G hS E, ← sum_sub_distrib]
  calc
    _ ≤ ∑ u ∈ S, ‖a u * ψ u * G u - a u *
        (∫ ξ in E, candidateWindowMellinKernel L u ξ * typeIIWindowFourier (L^B) ξ) * G u‖ :=
      norm_sum_le _ _
    _ ≤ ∑ u ∈ S, ε * (‖a u‖ * ‖G u‖) := by
      apply sum_le_sum
      intro u hu
      rw [show a u * ψ u * G u - a u *
          (∫ ξ in E, candidateWindowMellinKernel L u ξ * typeIIWindowFourier (L^B) ξ) * G u =
          a u * (ψ u - (∫ ξ in E,
            candidateWindowMellinKernel L u ξ * typeIIWindowFourier (L^B) ξ)) * G u by ring,
        norm_mul, norm_mul]
      have hh := mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left (hε u hu) (norm_nonneg (a u))) (norm_nonneg (G u))
      nlinarith only [hh]
    _ = _ := (mul_sum ..).symm

end Bounty
end

