lemma coprimalityMask_good_part (u:ActualEisensteinCubic.Oˣ) (a b:ℕ) (r n:ActualEisensteinCubic.O)
    (hn:Supported (Ideal.span {n})) :
    coprimalityMask (u.val*lambda^a*(2:ActualEisensteinCubic.O)^b*r) n=coprimalityMask r n := by
  letI importedWitness0 := @OAI.ConcretePrimeRowBridge.instIsPrincipalIdealRingO
  have hl:IsCoprime lambda n:=
    PrimaryIdealUnitReindex.lambda_prime_actual.irreducible.coprime_iff_not_dvd.mpr ((supported_span_iff n).mp hn).1
  have hneg2:IsCoprime (-2:ActualEisensteinCubic.O) n:=negative_two_prime.irreducible.coprime_iff_not_dvd.mpr
    (by simpa only [neg_dvd] using ((supported_span_iff n).mp hn).2)
  have h2:IsCoprime (2:ActualEisensteinCubic.O) n:=hneg2.of_isCoprime_of_dvd_left ⟨-1,by ring⟩
  have hu:IsCoprime u.val n:=⟨(u⁻¹).val,0,by simp⟩
  have hla:IsCoprime (lambda^a) n:=hl.pow_left
  have h2b:IsCoprime ((2:ActualEisensteinCubic.O)^b) n:=h2.pow_left
  change (if IsCoprime (u.val*lambda^a*(2:ActualEisensteinCubic.O)^b*r) n then (1:ℂ) else 0)=_
  rw [IsCoprime.mul_left_iff,IsCoprime.mul_left_iff,IsCoprime.mul_left_iff]
  simp only [hu,hla,h2b,true_and]
  rfl

