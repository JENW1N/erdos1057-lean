    (s : PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B))
    (e : CoupledGhostEvent M B s.2) : ℂ :=
  φ s.1 (fun g => (s.2 g).1) (fun g => ⟨(e g).1.val, (e g).2.2⟩)

theorem physical_small_big_ghost_birth_phase_reindex
    {S G : Type*} {Ps : S → Finset ℕ} {P Z : G → Type*} {J ell : ℕ}
    (M : G → ℕ) (B : ℕ)
    (φ : PhysicalBareResidueState Ps J ell → (∀ g, Fin (M g) → P g) →
      (∀ g, FiniteOrderedTuple (Z g)) → ℂ)
