theorem physical_pair_sum_norm_le_from_bound {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (F : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → ℂ)
    (B : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → ℝ)
    (hB : ∀ L R, physicalSharedCompatible C L R → ‖F L R‖ ≤ B L R) :
