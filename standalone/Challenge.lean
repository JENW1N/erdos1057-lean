section

/- The actual mixed clean event row, with total dilation phase and original
small-residue translation, conjugates to the literal canonical clean action.
The initial ledger is fixed, and only actual fresh births are tested. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalMixedCleanInitialAction {S G : Type*}
    [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (initial : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ θ ρ : ℝ) (k : ℤ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (y : CleanFullMemoryState P J ell B) (rs : PhysicalResidues Ps) : ℂ :=
  let τ := fullActivePermutation (cleanPhysicalSlotChange C)
  let source := (cleanFullMemoryEquiv P J ell B (τ.symm y)).2.2.1
  let Sp := fun g => physicalFullSharedIndices (ell := ell) (C g)
  let cp := (productActiveMemorySplit Sp B y).1
  let sp := (productActiveMemorySplit Sp B y).2
  ∑ e : FullActiveEdgeEvent (fun g (p : P g) => p.val) Sp B
      (fun _ => PhysicalAuxLabels P C) (physicalMixedEdgeDelta C k d) (physicalMixedEdgeD C d) y,
    (fullActiveEdgeEventWeight (fun g (p : P g) => p.val) Sp B
      (fun _ => PhysicalAuxLabels P C) (physicalMixedEdgeDelta C k d) (physicalMixedEdgeD C d)
      (fun _ aux => physicalAuxMass V C aux) (fun g => tiltedPhysicalBirthLaw V g (b g)) ρ V y e : ℂ) *
    (if (∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅) ∧
        (∀ g i, (e.2 g).2.2.2 i ∉ initial g) then
      let fresh := physicalCleanFreshEquiv (fun g => ↥(P g)) C (fun g =>
        (unrestrictedJointEventTarget (fun g (p : P g) => p.val)
          (physicalMixedEdgeDelta C k d cp e.1) (physicalMixedEdgeD C d cp e.1)
          (fun g => (Sp g)ᶜ.card) B sp e.2 g).1)
      let target := repeatedBigFill C source (cleanFullFreshEquiv P C fresh)
      if repeatedBigAuxAvoids C e.1 source ∧ repeatedBigAuxAvoids C e.1 target then
        K source target e.1 * physicalPhase ζ (physicalMixedSharedD C d cp e.1) *
          physicalReturnPhase θ (physicalMixedBigStep C k cp e.1 * (physicalSharedProduct d : ℕ))
      else 0
    else 0) *
    f (fullActiveEdgeEventTarget (fun g (p : P g) => p.val) Sp B
      (fun _ => PhysicalAuxLabels P C) (physicalMixedEdgeDelta C k d) (physicalMixedEdgeD C d) y e)
      (physicalTranslateResidues rs (physicalMixedBigStep C k cp e.1 * (physicalSharedProduct d : ℕ)))

theorem physical_mixed_clean_total_phase {S G : Type*} [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {Z : G → Type*} {J ell B : ℕ}
    (C : G → Finset (Fin J)) (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B)
    (aux : PhysicalAuxLabels P C) (ζ : ℝ)
    (hPs : ∀ s p, p ∈ Ps s → 0 < p) (hP : ∀ g p, p ∈ P g → 0 < p) :
    physicalPhase ζ (physicalMixedSharedD C d
      (productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
        (fullActivePermutation (cleanPhysicalSlotChange C) x)).1 aux) =
      physicalPhase ζ (cleanFullSharedD C
        (productActiveMemorySplit (cleanFullSharedSlots C) B x).1 aux) *
      physicalPhase ζ (physicalSharedProduct d) := by
  unfold physicalMixedSharedD
  rw [clean_physical_shared_D_reencode]
  have hb : 0 < cleanFullSharedD C (productActiveMemorySplit (cleanFullSharedSlots C) B x).1 aux := by
    unfold cleanFullSharedD
    exact prod_pos fun g _ => mul_pos
      (prod_pos fun j _ => hP g _ ((productActiveMemorySplit (cleanFullSharedSlots C) B x).1 g j).property)
      (prod_pos fun j _ => hP g _ (aux g j).property)
  rw [physical_phase_mul ζ (clean_hybrid_shared_product_pos d hPs) hb, mul_comm]

theorem physical_mixed_clean_initial_action_reencode {S G : Type*}
    [Fintype S] [Fintype G] [dG : DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ g (p : P g), NeZero p.val]
    (initial : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ θ ρ : ℝ) (k : ℤ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : CleanFullMemoryState P J ell B → PhysicalResidues Ps → ℂ)
    (hf : ∀ r, ProductMemorySymmetric (fun x => f x r))
    (hPs : ∀ s p, p ∈ Ps s → 0 < p) (hP : ∀ g p, p ∈ P g → 0 < p)
    (x : CleanFullMemoryState P J ell B) (rs : PhysicalResidues Ps) :
    physicalMixedCleanInitialAction initial V b C ζ θ ρ k K d
      (fun y r => f ((fullActivePermutation (cleanPhysicalSlotChange C)).symm y) r)
      (fullActivePermutation (cleanPhysicalSlotChange C) x) rs =
    cleanFullMemoryInitialEventAction initial V b C ζ θ ρ k (canonicalMixedEdgeD C d) K d f x rs := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  let c := (productActiveMemorySplit (cleanFullSharedSlots C) B x).1
  let source := (cleanFullMemoryEquiv P J ell B x).2.2.1
  let Θ := fun (a : PhysicalAuxLabels P C) (fresh : ∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g) =>
    if repeatedBigAuxAvoids C a source ∧
        repeatedBigAuxAvoids C a (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) then
      K source (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) a *
        physicalPhase ζ (cleanFullSharedD C c a) * physicalReturnPhase θ (cleanFullSharedStep k C c a d) *
        physicalPhase ζ (physicalSharedProduct d) else 0
  have h := physical_mixed_clean_initial_sum_reencode initial C k d (physicalAuxMass V C)
    (fun g => tiltedPhysicalBirthLaw V g (b g)) ρ V Θ
    (fun a z => f z (physicalTranslateResidues rs (cleanFullSharedStep k C c a d)))
    (fun a => hf _) x
  dsimp only at h
  refine Eq.trans ?_ (h.trans ?_)
  · dsimp only [physicalMixedCleanInitialAction]
    apply sum_congr
    · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
    · intro e _
      rw [physical_mixed_clean_step_reencode C d x e.1 k]
      congr 1
      congr 1
      dsimp only [Θ, source, c]
      have hx : (fullActivePermutation (cleanPhysicalSlotChange C)).symm
          (fullActivePermutation (cleanPhysicalSlotChange C) x) = x :=
        Equiv.symm_apply_apply _ _
      have hsrc := congrArg (fun z : CleanFullMemoryState P J ell B =>
        (cleanFullMemoryEquiv P J ell B z).2.2.1) hx
      rw [hsrc]
      split_ifs
      · rw [physical_mixed_clean_total_phase C d x e.1 ζ hPs hP]
        ring
      all_goals rfl
  · unfold cleanFullMemoryInitialEventAction
    apply sum_congr
    · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
    · intro e _
      rfl

end Bounty
end

