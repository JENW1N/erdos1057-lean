    (fun i => hP i.1.1) (fun i => hP i.1.1)
    (fun i => hmass i.1.1) (fun i => hmass i.1.1)
    (hVlower a.1) (hVlower b.1) a₀ a₁ b₀ b₁ hPa hPb ha₀ ha₁ hb₀ hb₁
