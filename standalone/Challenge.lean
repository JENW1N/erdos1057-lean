theorem global_birth_visit_eq_bounded_ghost_ledger_sum {P : Type*} [Fintype P] [DecidableEq P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (β : P → ℝ) (η V ρ : ℝ) (H : Finset P)
    (t B : ℕ) (F : Finset P → BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
