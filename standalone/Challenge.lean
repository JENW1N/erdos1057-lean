/- The original root model over all finite paths, with the small-residue average appearing once. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_root_residue_model_mixed_unrestricted
    {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    [∀ a : PhysicalPrime P, NeZero a.2.val]
    (groups : Finset (Fin N)) (V : Fin N → ℝ) (patterns : Finset I)
    (C : I → Fin N → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (hV : ∀ g, 0 < V g)
    (hP : ∀ g a, a ∈ P g → Nat.Prime a)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ t < n + 1, ∀ i ∈ patterns, ∀ g a, a ∈ P g → ¬ (a : ℤ) ∣ k t i)
    (b : PhysicalPrime P → ℝ)
    (hb : ∀ a : PhysicalPrime P, a.1 ∈ groups →
      b a = 1 - (∑ j ∈ range (n + 2), (1 - physicalEndpointSchedule q (n + 1) j)) / a.2.val)
    (hb0 : ∀ a : PhysicalPrime P, a.1 ∈ groups → b a ≠ 0)
    (B : ℕ) (hB : (physicalPrimeGroups P groups).card ≤ B) :
    letI : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
    physicalRootResidueModel V patterns C q ζ k K n =
      (∏ a ∈ physicalPrimeGroups P groups, b a : ℝ) *
      ∑ r : PhysicalGroupResidues P groupsᶜ,
        (∏ a : ↥(physicalPrimeGroups P groupsᶜ), 1 / (a.val.2.val : ℝ)) *
        ∑ L : PhysicalMarkLists P J ell,
        ∑ p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
        (if physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p) (n + 1) (n + 1) = 0 then
        (((physicalStateMass (fun g : ↥groupsᶜ => V g.val) J ell *
          ∏ j ∈ range (n + 1), physicalCompletionMass (fun g : ↥groupsᶜ => V g.val)
            (fun g => C (finitePathLabels p j).2.2.1.val g.val) ell : ℝ) : ℂ) *
          physicalMemoryWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L p) (n + 1) *
          physicalGroupFiniteVertexWeight groupsᶜ C q k L p r *
          physicalGroupFiniteCappedHistory groups C q k
            (fun a => ((a.2.val : ℝ) * b a)⁻¹) V B L p) else 0) := by
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns C) := inferInstance
  unfold physicalRootResidueModel
  simp only [mul_sum]
  trans ∑ L : PhysicalMarkLists P J ell,
    ∑ p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell,
      (∏ a ∈ physicalPrimeGroups P groups, b a : ℝ) *
      ∑ r : PhysicalGroupResidues P groupsᶜ,
        (∏ a : ↥(physicalPrimeGroups P groupsᶜ), 1 / (a.val.2.val : ℝ)) *
        (if physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p) (n + 1) (n + 1) = 0 then
        (((physicalStateMass (fun g : ↥groupsᶜ => V g.val) J ell *
          ∏ j ∈ range (n + 1), physicalCompletionMass (fun g : ↥groupsᶜ => V g.val)
            (fun g => C (finitePathLabels p j).2.2.1.val g.val) ell : ℝ) : ℂ) *
          physicalMemoryWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L p) (n + 1) *
          physicalGroupFiniteVertexWeight groupsᶜ C q k L p r *
          physicalGroupFiniteCappedHistory groups C q k
            (fun a => ((a.2.val : ℝ) * b a)⁻¹) V B L p) else 0)
  · apply sum_congr rfl
    intro L _
    apply sum_congr rfl
    intro p _
    have hkp : ∀ j : Fin (n + 1), ∀ g s,
        ¬ (((physicalPathSelectedEquiv patterns C (L, p)).2.2.1 j.castSucc g s).val : ℤ) ∣
          physicalPathSelectedMultiplier C k p j := by
      intro j g s
      exact hk (n - j.val) (by omega) (p j).1.2.2.1.val (p j).1.2.2.1.property g _
        ((physicalPathSelectedEquiv patterns C (L, p)).2.2.1 j.castSucc g s).property
    simpa only [mul_assoc] using physical_finite_root_term_mixed_unrestricted
      groups V patterns C q ζ k K L p hV hP hdis hkp b hb hb0 B hB
  · simp only [mul_sum]
    conv_lhs =>
      arg 2
      ext L
      rw [sum_comm]
    rw [sum_comm]

end Bounty
