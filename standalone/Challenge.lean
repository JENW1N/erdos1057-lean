    (steps : List (Option (J ⊕ K)))

abbrev FullMixedBirthLexAddress :=
  Lex ((i : Fin steps.length) ×
    Lex ((g : Fin N) × Fin (fullMixedBirthCapacity S B (steps.get i) g)))

def fullMixedBirthLexEquiv :
