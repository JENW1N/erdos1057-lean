theorem ghost_phase_grouped_capped_visit
    (a : (g : G) → P g → Bool) (h : (g : G) → (p : P g) → R g p)
    (η β ρ : (g : G) → P g → ℝ) (cap : ℕ)
    (z w : (g : G) → (p : P g) → GhostPhaseState (R g p)) :
    (if (∑ g, (ghostPhasePendingSupport (z g)).card) ≤ cap then
      ∏ g, ghostPhaseCappedDampedVisit (a g) (h g) (η g) (β g) (ρ g) cap (z g) (w g)
    else 0) =
    ghostPhaseCappedDampedVisit (fun p : Σ g, P g => a p.1 p.2)
      (fun p => h p.1 p.2) (fun p => η p.1 p.2) (fun p => β p.1 p.2)
      (fun p => ρ p.1 p.2) cap (globalBirthFlattenPhase z) (globalBirthFlattenPhase w) := by
  classical
  unfold ghostPhaseCappedDampedVisit
  rw [global_birth_flatten_pending_card]
  split_ifs with hz
  · rw [Fintype.prod_sigma]
    apply prod_congr rfl
    intro g _
    have hg : (ghostPhasePendingSupport (z g)).card ≤ cap :=
      (single_le_sum (fun i _ => Nat.zero_le _) (mem_univ g)).trans hz
    rw [if_pos hg]
    rfl
  · rfl

variable [∀ g p, AddGroup (R g p)] [∀ g p, Fintype (R g p)]

