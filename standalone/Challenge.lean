theorem eventually_prime_proxy_character_discrepancy (hZ : PrimitiveZeroFreeRightOf (23 / 24))
    {a S T Bsave : ℝ} (ha : 0 < a) (hS : 0 ≤ S) (hT : 0 ≤ T)
