lemma outsidePrime_injective (S : Finset (Ideal ActualEisensteinCubic.O)) (hbad : fixedBadPrimes ⊆ S) (D : ℕ) :
    Function.Injective (fun i => Ideal.span {outsidePrime S D i}) := by
  intro i j hij
