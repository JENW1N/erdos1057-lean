open Finset Classical
noncomputable def fullActivePermutationWeight {G : Type*} [Fintype G] [DecidableEq G]
    (M : G → ℕ) (_τ : FullActiveSlotPermutations M) : ℝ :=
  (Fintype.card (FullActiveSlotPermutations M) : ℝ)⁻¹

theorem fullActivePermutationWeight_nonneg {G : Type*} [Fintype G] [DecidableEq G]
    (M : G → ℕ) (τ : FullActiveSlotPermutations M) : 0 ≤ fullActivePermutationWeight M τ :=
  inv_nonneg.mpr (Nat.cast_nonneg _)

theorem fullActivePermutationWeight_mass {G : Type*} [Fintype G] [DecidableEq G]
    (M : G → ℕ) : ∑ τ, fullActivePermutationWeight M τ = 1 := by
  have hc : (Fintype.card (FullActiveSlotPermutations M) : ℝ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  simp only [fullActivePermutationWeight, sum_const, card_univ, nsmul_eq_mul]
  exact mul_inv_cancel₀ hc

noncomputable def fullActiveAverage {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z M B → ℂ)
    (x : ProductBoundedOrderedState P Z M B) : ℂ :=
  ∑ τ : FullActiveSlotPermutations M, (fullActivePermutationWeight M τ : ℂ) *
    f (fullActivePermutation τ x)

theorem fullActiveAverage_symmetric {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ}
    (f : ProductBoundedOrderedState P Z M B → ℂ) (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (fullActiveAverage f) := by
  intro x g σ
  unfold fullActiveAverage
  apply sum_congr rfl
  intro τ _
  exact congrArg (fun z : ℂ => (fullActivePermutationWeight M τ : ℂ) * z)
    (fullActivePermutation_symmetric τ f hf x g σ)

theorem fullActiveAverage_energy_le {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
    {M : G → ℕ} {B : ℕ} (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (f : ProductBoundedOrderedState P Z M B → ℂ) :
    finiteWeightedEnergy (productMemoryWeight μ ν) (fullActiveAverage f) ≤
      finiteWeightedEnergy (productMemoryWeight μ ν) f := by
  calc
    _ ≤ ∑ τ, fullActivePermutationWeight M τ *
        finiteWeightedEnergy (productMemoryWeight μ ν) (fun x => f (fullActivePermutation τ x)) :=
      finite_subprobability_average_energy_le (fullActivePermutationWeight M) (productMemoryWeight μ ν)
        (fullActivePermutationWeight_nonneg M) (fullActivePermutationWeight_mass M).le
        (productMemoryWeight_nonneg μ ν hμ hν) (fun τ x => f (fullActivePermutation τ x))
    _ = _ := by
      simp_rw [fullActivePermutation_energy μ ν]
      rw [← sum_mul, fullActivePermutationWeight_mass, one_mul]
end

