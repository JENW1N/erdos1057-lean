theorem norm_div_real_bound_le_one {z : ℂ} {c : ℝ} (hc : 0 ≤ c) (hz : ‖z‖ ≤ c) :
    ‖z / (c : ℂ)‖ ≤ 1 := by
  by_cases hzero : c = 0
  · simp [hzero]
  · rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hc]
    exact (div_le_one (lt_of_le_of_ne hc (Ne.symm hzero))).mpr hz

theorem real_bound_mul_div_eq {z : ℂ} {c : ℝ} (hz : ‖z‖ ≤ c) :
    (c : ℂ) * (z / (c : ℂ)) = z := by
  by_cases hzero : c = 0
  · have hz0 : z = 0 := norm_eq_zero.mp (le_antisymm (hzero ▸ hz) (norm_nonneg _))
    simp [hzero, hz0]
  · have hc : (c : ℂ) ≠ 0 := by exact_mod_cast hzero
    exact mul_div_cancel₀ z hc

