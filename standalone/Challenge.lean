open Finset Filter
theorem eventually_log_sqrt_loss_le_linear (C K : ℝ) {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ L : ℝ in atTop, C * Real.log L + K * Real.sqrt L ≤ eps * L := by
  have heps2 : 0 < eps / 2 := by positivity
  filter_upwards [eventually_mul_rpow_log_add_le_rpow
      (a := (0 : ℝ)) (b := (1 : ℝ)) (by norm_num) (by norm_num) heps2 C 0,
    eventually_mul_rpow_log_add_le_rpow
      (a := (1/2 : ℝ)) (b := (1 : ℝ)) (by norm_num) (by norm_num) heps2 (max K 0) 0,
    Real.tendsto_log_atTop.eventually (eventually_ge_atTop (1 : ℝ)),
    eventually_gt_atTop (0 : ℝ)] with L hpoly hsqrt hlog hL
  simp only [Real.rpow_zero, Real.rpow_one, mul_one, add_zero] at hpoly hsqrt
  have hroot : K * Real.sqrt L ≤ (max K 0) * L^(1/2 : ℝ) * Real.log L := by
    calc
      _ ≤ max K 0 * Real.sqrt L :=
        mul_le_mul_of_nonneg_right (le_max_left _ _) (Real.sqrt_nonneg L)
      _ = max K 0 * L^(1/2 : ℝ) := by rw [Real.sqrt_eq_rpow]
      _ ≤ _ := le_mul_of_one_le_right
        (mul_nonneg (le_max_right _ _) (Real.rpow_nonneg hL.le _)) hlog
  linarith

/- The threshold is uniform over every finite set and every real weight.
No positivity of individual weights is required for this counting implication. -/
theorem eventually_weighted_mass_card_lower (C K : ℝ) {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ L : ℝ in atTop, ∀ (α : Type*) (S : Finset α) (w : α → ℝ),
      Real.exp L * L^(-C) ≤ (∑ u ∈ S, w u) →
      (∀ u ∈ S, w u ≤ Real.exp (K * Real.sqrt L)) →
      Real.exp ((1 - eps) * L) ≤ (S.card : ℝ) := by
  filter_upwards [eventually_log_sqrt_loss_le_linear C K heps,
    eventually_gt_atTop (0 : ℝ)] with L hloss hL
  intro α S w hmass hw
  have hsum : (∑ u ∈ S, w u) ≤ (S.card : ℝ) * Real.exp (K * Real.sqrt L) := by
    calc
      _ ≤ ∑ _u ∈ S, Real.exp (K * Real.sqrt L) := sum_le_sum hw
      _ = _ := by simp
  have hexp : Real.exp ((1 - eps) * L) * Real.exp (K * Real.sqrt L) ≤
      Real.exp L * L^(-C) := by
    rw [Real.rpow_def_of_pos hL, ← Real.exp_add, ← Real.exp_add]
    apply Real.exp_le_exp.mpr
    nlinarith
  have hbound := hexp.trans (hmass.trans hsum)
  have hpos := Real.exp_pos (K * Real.sqrt L)
  nlinarith
end

