open Finset Classical
noncomputable def activeTupleSplit {P : Type*} {M : ℕ} (S : Finset (Fin M)) :
    (Fin M → P) ≃ (Fin S.card → P) × (Fin Sᶜ.card → P) where
  toFun x := (fun j => x (S.equivFin.symm j), fun j => x (Sᶜ.equivFin.symm j))
  invFun y i := if h : i ∈ S then y.1 (S.equivFin ⟨i, h⟩)
    else y.2 (Sᶜ.equivFin ⟨i, mem_compl.mpr h⟩)
  left_inv x := by
    funext i
    by_cases h : i ∈ S <;> simp [h]
  right_inv y := by
    apply Prod.ext
    · funext j
      have h : (S.equivFin.symm j).val ∈ S := (S.equivFin.symm j).property
      simp [h]
    · funext j
      have h : (Sᶜ.equivFin.symm j).val ∉ S := mem_compl.mp (Sᶜ.equivFin.symm j).property
      simp [h]

theorem activeTupleSplit_weight {P : Type*} {M : ℕ} (S : Finset (Fin M))
    (μ : P → ℝ) (x : Fin M → P) :
    (∏ i, μ (x i)) =
      (∏ i, μ ((activeTupleSplit S x).1 i)) * (∏ i, μ ((activeTupleSplit S x).2 i)) := by
  have h : (∏ i : ↥S, μ (x i)) * (∏ i : ↥Sᶜ, μ (x i)) = ∏ i, μ (x i) := by
    rw [prod_coe_sort S (fun i => μ (x i)), prod_coe_sort Sᶜ (fun i => μ (x i))]
    exact prod_mul_prod_compl S (fun i => μ (x i))
  rw [← h]
  congr 1
  · exact (Equiv.prod_comp S.equivFin.symm (fun i : ↥S => μ (x i))).symm
  · exact (Equiv.prod_comp Sᶜ.equivFin.symm (fun i : ↥Sᶜ => μ (x i))).symm

noncomputable def activeMemorySplit {P Z : Type*} {M : ℕ}
    (S : Finset (Fin M)) (B : ℕ) :
    BoundedOrderedState P Z M B ≃
      (Fin S.card → P) × BoundedOrderedState P Z Sᶜ.card B :=
  (Equiv.prodCongr (activeTupleSplit S) (Equiv.refl (BoundedOrderedTuple Z B))).trans
    (Equiv.prodAssoc _ _ _)




theorem activeMemorySplit_weight {P Z : Type*} {M : ℕ}
    (S : Finset (Fin M)) (B : ℕ) (μ : P → ℝ) (ν : Z → ℝ)
    (x : BoundedOrderedState P Z M B) :
    boundedOrderedStateWeight μ ν x =
      (∏ i, μ ((activeMemorySplit S B x).1 i)) *
        boundedOrderedStateWeight μ ν (activeMemorySplit S B x).2 := by
  change (∏ i, μ (x.1 i)) * boundedOrderedMemoryWeight ν x.2 =
    (∏ i, μ ((activeTupleSplit S x.1).1 i)) *
      ((∏ i, μ ((activeTupleSplit S x.1).2 i)) * boundedOrderedMemoryWeight ν x.2)
  rw [activeTupleSplit_weight S μ x.1]
  exact mul_assoc _ _ _
end

