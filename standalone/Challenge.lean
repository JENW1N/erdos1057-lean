noncomputable def primeLogTerm {q : ℕ} (χ : DirichletCharacter ℂ q) (n : ℕ) : ℂ :=
  if n.Prime then (Real.log n : ℂ) * χ (n : ZMod q) else 0

theorem sum_primeLogTerm_range {q : ℕ} (χ : DirichletCharacter ℂ q) (n : ℕ) :
    (∑ j ∈ Finset.range (n + 1), primeLogTerm χ j) = twistedTheta χ n := by
  rw [twistedTheta, Finset.sum_filter]
  simp only [Nat.floor_natCast]
  rw [Nat.range_succ_eq_Icc_zero, ← Finset.add_sum_Ioc_eq_sum_Icc (Nat.zero_le n)]
  simp only [primeLogTerm, Nat.not_prime_zero, ↓reduceIte, zero_add]




/- A uniform prefix bound for prime-log sums controls every terminal interval. -/
theorem norm_prime_sum_Ioc_le {q : ℕ} (χ : DirichletCharacter ℂ q)
    {m n : ℕ} (hm : 1 ≤ m) {B : ℝ} (hB : 0 ≤ B)
    (hprefix : ∀ k : ℕ, k ≤ n → ‖twistedTheta χ k‖ ≤ B) :
    ‖∑ p ∈ (Finset.Ioc m n).filter Nat.Prime, χ (p : ZMod q)‖ ≤ 4 * B := by
  classical
  by_cases hmn : m < n
  · have hlog : ∀ i : ℕ, m + 1 ≤ i → 0 < Real.log i := by
      intro i hi
      apply Real.log_pos
      exact_mod_cast (show 1 < i by omega)
    have hf : ∀ i ∈ Finset.Icc (m + 1) n, 0 ≤ 1 / Real.log i := by
      intro i hi
      exact (one_div_pos.mpr (hlog i (Finset.mem_Icc.mp hi).1)).le
    have hanti : AntitoneOn (fun i : ℕ => 1 / Real.log i) (Set.Icc (m + 1) n) := by
      intro i hi j hj hij
      exact one_div_le_one_div_of_le (hlog i hi.1)
        (Real.log_le_log (by exact_mod_cast (show 0 < i by have := hi.1; omega)) (by exact_mod_cast hij))
    have hab := norm_sum_Ioc_smul_le_of_antitone (fun i : ℕ => 1 / Real.log i)
      (primeLogTerm χ) hmn hf hanti (fun k hk => by
        rw [sum_primeLogTerm_range]
        exact hprefix k (Finset.mem_Icc.mp hk).2)
    have heq : (∑ i ∈ Finset.Ioc m n, (1 / Real.log i) • primeLogTerm χ i) =
        ∑ p ∈ (Finset.Ioc m n).filter Nat.Prime, χ (p : ZMod q) := by
      rw [Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro i hi
      by_cases hp : i.Prime
      · simp only [primeLogTerm, hp, ↓reduceIte]
        rw [← Complex.real_smul, smul_smul]
        simp [(hlog i (by have := (Finset.mem_Ioc.mp hi).1; omega)).ne']
      · simp [primeLogTerm, hp]
    rw [heq] at hab
    have hl2 : (1 : ℝ) / 2 ≤ Real.log 2 := by
      have hh := Real.one_sub_inv_le_log_of_pos (by norm_num : (0 : ℝ) < 2)
      norm_num at hh ⊢
      exact hh
    have hln : (1 : ℝ) / 2 ≤ Real.log (m + 1 : ℕ) := hl2.trans
      (Real.log_le_log (by norm_num) (by exact_mod_cast (show 2 ≤ m + 1 by omega)))
    have hinv : 1 / Real.log (m + 1 : ℕ) ≤ 2 :=
      (div_le_iff₀ (hlog (m + 1) le_rfl)).mpr (by linarith)
    exact hab.trans (by nlinarith [mul_le_mul_of_nonneg_right hinv hB])
  · simp only [Finset.Ioc_eq_empty_of_le (by omega : n ≤ m), Finset.filter_empty,
      Finset.sum_empty, norm_zero]
    positivity












