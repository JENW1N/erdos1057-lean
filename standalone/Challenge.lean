section
open Finset
open scoped Classical
/- At a fixed length, finite-pool embeddings are exactly ordered ambient
draws selected by injectivity and membership in that pool. -/
theorem birth_pool_sum_eq_ambient_mask {P : Type*} [Fintype P] [DecidableEq P]
    (U : Finset P) (m : ℕ) (F : (Fin m → P) → ℂ) :
    (∑ f : Fin m ↪ U, F (fun j => (f j).val)) =
      ∑ f : Fin m → P, if Function.Injective f ∧ (∀ j, f j ∈ U) then F f else 0 := by
  rw [← sum_filter]
  apply sum_bij (fun f _ => fun j => (f j).val)
  · intro f _
    refine mem_filter.mpr ⟨mem_univ _, ?_, fun j => (f j).property⟩
    intro j k hjk
    exact f.injective (Subtype.ext hjk)
  · intro f _ g _ hfg
    apply Function.Embedding.ext
    intro j
    exact Subtype.ext (congrFun hfg j)
  · intro f hf
    have hv := (mem_filter.mp hf).2
    refine ⟨⟨fun j => ⟨f j, hv.2 j⟩, ?_⟩, mem_univ _, rfl⟩
    intro j k hjk
    exact hv.1 (congrArg Subtype.val hjk)
  · intro f _
    rfl

/- Extending the length range to the whole ambient label pool adds only
zero terms, since an accepted injection cannot exceed its allowed pool. -/
theorem birth_pool_batch_sum_eq_ambient_mask {P : Type*} [Fintype P] [DecidableEq P]
    (U : Finset P) (F : ∀ m, (Fin m → P) → ℂ) :
    (∑ m ∈ range (U.card + 1), ∑ f : Fin m ↪ U, F m (fun j => (f j).val)) =
      ∑ m ∈ range (Fintype.card P + 1), ∑ f : Fin m → P,
        if Function.Injective f ∧ (∀ j, f j ∈ U) then F m f else 0 := by
  simp_rw [birth_pool_sum_eq_ambient_mask]
  apply sum_subset (range_mono (Nat.add_le_add_right (card_le_univ U) 1))
  intro m _ hm
  apply sum_eq_zero
  intro f _
  apply if_neg
  intro hf
  let e : Fin m ↪ U := ⟨fun j => ⟨f j, hf.2 j⟩, fun _ _ h => hf.1 (congrArg Subtype.val h)⟩
  have hcard : m ≤ U.card := by
    simpa only [Fintype.card_fin, Fintype.card_coe] using Fintype.card_le_of_embedding e
  exact hm (mem_range.mpr (Nat.lt_succ_of_le hcard))

/- Ambient repeated-birth row with distinctness and the entire cumulative
ledger exclusion expressed only in an explicit acceptance predicate. -/
noncomputable def globalBirthGhostVisitAmbientRow {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (β : P → ℝ) (η V ρ : ℝ) (cap : ℕ)
    (H : Finset P) (old : Fin N → Σ p, R p)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ) : ℂ :=
  ∑ T ∈ (globalBirthVisitZeroIndices h old).powerset,
    ∑ m ∈ range (Fintype.card P + 1), ∑ f : Fin m → P,
      if Function.Injective f ∧ (∀ j, f j ∉ H) then
        ((((-η / ρ) ^ T.card * ((1 - η) / ρ ^ 2) ^ (globalBirthVisitZeroIndices h old \ T).card) *
          ((-η * V / ρ) ^ m * (∏ j, β (f j) / V)) / (m.factorial : ℝ) : ℝ) : ℂ) *
        (if (retainedBirthTuple old (univ \ T) (fun j => ⟨f j, h (f j)⟩)).1 ≤ cap then
          G (H ∪ univ.image f) (retainedBirthTuple old (univ \ T) (fun j => ⟨f j, h (f j)⟩))
        else 0)
      else 0

/- The original global-birth visit is exactly the ambient repeated-draw row.
Every ordered batch coefficient, including its single 1/m! factor, is unchanged. -/
theorem global_birth_ghost_visit_eq_ambient_row {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (β : P → ℝ) (η V ρ : ℝ) (cap : ℕ)
    (H : Finset P) (old : Fin N → Σ p, R p)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ) :
    globalBirthGhostVisitRawRow h β η V ρ cap H old G =
      globalBirthGhostVisitAmbientRow h β η V ρ cap H old G := by
  unfold globalBirthGhostVisitRawRow globalBirthGhostVisitAmbientRow
  apply sum_congr rfl
  intro T _
  have hs := birth_pool_batch_sum_eq_ambient_mask (univ \ H)
    (fun m f =>
      ((((-η / ρ) ^ T.card * ((1 - η) / ρ ^ 2) ^ (globalBirthVisitZeroIndices h old \ T).card) *
        ((-η * V / ρ) ^ m * (∏ j, β (f j) / V)) / (m.factorial : ℝ) : ℝ) : ℂ) *
      (if (retainedBirthTuple old (univ \ T) (fun j => ⟨f j, h (f j)⟩)).1 ≤ cap then
        G (H ∪ univ.image f) (retainedBirthTuple old (univ \ T) (fun j => ⟨f j, h (f j)⟩))
      else 0))
  simpa only [← global_visit_birth_range_image, mem_sdiff, mem_univ, true_and] using hs
end

section
open Finset
/- A separate coordinate equivalence at each physical vertex reindexes
both cuts of its visit and the adjoining cuts of its edges. -/
theorem finite_alternating_pairing_conjugate {X : Type*} [Fintype X]
    (e : ℕ → X ≃ X) (G E : ℕ → X → X → ℝ) (f q : X → ℝ) (n : ℕ) :
    finiteAlternatingPairing
      (fun j x y => G j ((e j).symm x) ((e j).symm y))
      (fun j x y => E j ((e (j + 1)).symm x) ((e j).symm y))
      (fun x => f ((e 0).symm x)) (fun x => q ((e n).symm x)) n =
      finiteAlternatingPairing G E f q n := by
  unfold finiteAlternatingPairing
  simp_rw [finite_alternating_action]
  have hK : (fun j x y => ∑ z,
      G (j + 1) ((e (j + 1)).symm x) ((e (j + 1)).symm z) *
        E j ((e (j + 1)).symm z) ((e j).symm y)) =
      (fun j x y => (fun u v => ∑ z, G (j + 1) u z * E j z v)
        ((e (j + 1)).symm x) ((e j).symm y)) := by
    funext j x y
    exact (e (j + 1)).symm.sum_comp
      (fun z => G (j + 1) ((e (j + 1)).symm x) z * E j z ((e j).symm y))
  have hF : (fun x => ∑ y, G 0 ((e 0).symm x) ((e 0).symm y) * f ((e 0).symm y)) =
      (fun x => (fun u => ∑ y, G 0 u y * f y) ((e 0).symm x)) := by
    funext x
    exact (e 0).symm.sum_comp (fun y => G 0 ((e 0).symm x) y * f y)
  rw [hK, hF]
  simp_rw [finite_path_action_conjugate_apply e
    (fun j u v => ∑ z, G (j + 1) u z * E j z v)
    (fun u => ∑ y, G 0 u y * f y) n]
  exact (e n).symm.sum_comp (fun x => q x * finitePathAction
    (fun j u v => ∑ z, G (j + 1) u z * E j z v)
    (fun u => ∑ y, G 0 u y * f y) n x)

section Shift
variable {I : Type*} {R : I → Type*} [∀ p, AddGroup (R p)]

def ghostPhaseTensorShift (h : (p : I) → R p) :
    ((p : I) → GhostPhaseState (R p)) ≃ ((p : I) → GhostPhaseState (R p)) :=
  Equiv.piCongrRight (fun p => ghostPhaseShift (h p))

theorem ghost_phase_tensor_shift_symm_apply (h : (p : I) → R p)
    (z : (p : I) → GhostPhaseState (R p)) (p : I) :
    (ghostPhaseTensorShift h).symm z p = (ghostPhaseShift (h p)).symm (z p) := rfl

theorem ghost_phase_run_initial_shift_symm {S : Type*} [AddGroup S]
    (a : Bool) (β V : ℝ) (h : S) (z : GhostPhaseState S) :
    ghostPhaseRunInitial a β V ((ghostPhaseShift h).symm z) =
      ghostPhaseRunInitial a β V z := by
  cases a <;> rcases z with _ | (_ | (_ | r)) <;> rfl

theorem ghost_phase_terminal_shift_symm {S : Type*} [AddGroup S]
    (a : Bool) (h : S) (z : GhostPhaseState S) :
    ghostPhaseTerminal a ((ghostPhaseShift h).symm z) = ghostPhaseTerminal a z := by
  cases a <;> rcases z with _ | (_ | (_ | r)) <;> rfl

variable [Fintype I]

theorem ghost_phase_pending_support_tensor_shift_symm (h : (p : I) → R p)
    (z : (p : I) → GhostPhaseState (R p)) :
    ghostPhasePendingSupport ((ghostPhaseTensorShift h).symm z) =
      ghostPhasePendingSupport z := by
  change ghostPhasePendingSupport (fun p => (ghostPhaseShift (h p)).symm (z p)) = _
  simpa only [ghostPhaseShift_symm] using
    ghost_phase_pending_support_shift (fun p => -h p) z

variable [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]

noncomputable def ghostPhaseCappedDampedMovingEdge (atgt asrc : I → Bool)
    (delta : (p : I) → R p) (β V ρtgt ρsrc : I → ℝ) (cap : ℕ)
    (z w : (p : I) → GhostPhaseState (R p)) : ℝ :=
  if (ghostPhasePendingSupport z).card ≤ cap then
    ∏ p, (if atgt p && !(asrc p) then (V p)⁻¹ else 1) *
      ghostPhaseDampedMovingEdge (atgt p) (asrc p) (delta p) (β p)
        (ρtgt p) (ρsrc p) (z p) (w p) else 0

omit [∀ p, Fintype (R p)] in
theorem ghost_phase_capped_damped_visit_relative_zero (a : I → Bool)
    (h : (p : I) → R p) (η β ρ : I → ℝ) (cap : ℕ)
    (z w : (p : I) → GhostPhaseState (R p)) :
    ghostPhaseCappedDampedVisit a h η β ρ cap
      ((ghostPhaseTensorShift h).symm z) ((ghostPhaseTensorShift h).symm w) =
    ghostPhaseCappedDampedVisit a (fun _ => 0) η β ρ cap z w := by
  unfold ghostPhaseCappedDampedVisit
  rw [ghost_phase_pending_support_tensor_shift_symm]
  split_ifs
  · apply prod_congr rfl
    intro p _
    exact ghost_phase_damped_visit_relative_zero (a p) (h p) (η p) (β p) (ρ p) (z p) (w p)
  · rfl

theorem ghost_phase_capped_damped_edge_conjugation (atgt asrc : I → Bool)
    (htgt hsrc : (p : I) → R p) (β V ρtgt ρsrc : I → ℝ) (cap : ℕ)
    (z w : (p : I) → GhostPhaseState (R p)) :
    ghostPhaseCappedDampedEdge atgt asrc htgt hsrc β V ρtgt ρsrc cap
      ((ghostPhaseTensorShift htgt).symm z) ((ghostPhaseTensorShift hsrc).symm w) =
    ghostPhaseCappedDampedMovingEdge atgt asrc (fun p => htgt p - hsrc p)
      β V ρtgt ρsrc cap z w := by
  unfold ghostPhaseCappedDampedEdge ghostPhaseCappedDampedMovingEdge
  rw [ghost_phase_pending_support_tensor_shift_symm]
  split_ifs
  · apply prod_congr rfl
    intro p _
    congr 1
    exact ghost_phase_damped_edge_conjugation (atgt p) (asrc p) (htgt p) (hsrc p)
      (β p) (ρtgt p) (ρsrc p) (z p) (w p)
  · rfl

end Shift

section History
variable {I : Type*} [Fintype I] [DecidableEq I] {R : I → Type*}
  [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
  (a : I → ℕ → Bool) (h : (p : I) → ℕ → R p) (η : I → ℕ → ℝ)
  (β V : I → ℝ) (ρ : I → ℕ → ℝ) (visitCap edgeCap : ℕ → ℕ)

noncomputable def ghostPhaseCappedMovingDampedHistory (n : ℕ) : ℝ :=
  finiteAlternatingPairing
    (fun j => ghostPhaseCappedDampedVisit (fun p => a p j) (fun _ => 0)
      (fun p => η p j) β (fun p => ρ p j) (visitCap j))
    (fun j => ghostPhaseCappedDampedMovingEdge (fun p => a p (j + 1)) (fun p => a p j)
      (fun p => h p (j + 1) - h p j) β V
      (fun p => ρ p (j + 1)) (fun p => ρ p j) (edgeCap j))
    (fun z => ∏ p, ghostPhaseRunInitial (a p 0) (β p) (V p) (z p))
    (fun z => ∏ p, ghostPhaseTerminal (a p n) (z p)) n




/- Reindex every phase cut to its absolute residue frame. All pending-card
cutoffs are preserved exactly, with no nonzero-rho assumption needed. -/
theorem ghost_phase_capped_moving_history_eq_absolute (n : ℕ) :
    ghostPhaseCappedMovingDampedHistory a h η β V ρ visitCap edgeCap n =
      ghostPhaseCappedDampedHistory a h η β V ρ visitCap edgeCap n := by
  have he := finite_alternating_pairing_conjugate
    (fun j => ghostPhaseTensorShift (fun p => h p j))
    (fun j => ghostPhaseCappedDampedVisit (fun p => a p j) (fun p => h p j)
      (fun p => η p j) β (fun p => ρ p j) (visitCap j))
    (fun j => ghostPhaseCappedDampedEdge (fun p => a p (j + 1)) (fun p => a p j)
      (fun p => h p (j + 1)) (fun p => h p j) β V
      (fun p => ρ p (j + 1)) (fun p => ρ p j) (edgeCap j))
    (fun z => ∏ p, ghostPhaseRunInitial (a p 0) (β p) (V p) (z p))
    (fun z => ∏ p, ghostPhaseTerminal (a p n) (z p)) n
  simpa only [ghostPhaseCappedMovingDampedHistory, ghostPhaseCappedDampedHistory,
    ghost_phase_capped_damped_visit_relative_zero, ghost_phase_capped_damped_edge_conjugation,
    ghost_phase_tensor_shift_symm_apply, ghost_phase_run_initial_shift_symm,
    ghost_phase_terminal_shift_symm] using he

/- The capped normalized moving history equals the undamped absolute-hit
history whenever every local rho is nonzero. No cap is discarded. -/
theorem ghost_phase_capped_moving_history_eq_undamped
    (hρ : ∀ p j, ρ p j ≠ 0) (n : ℕ) :
    ghostPhaseCappedMovingDampedHistory a h η β V ρ visitCap edgeCap n =
      ghostPhaseCappedHistory a h η β V visitCap edgeCap n := by
  rw [ghost_phase_capped_moving_history_eq_absolute,
    ghost_phase_capped_damped_history_eq a h η β V ρ visitCap edgeCap hρ n]

end History
end

section
open Finset
section Joint

variable {N : Nat} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] {R : (g : Fin N) → P g → Type*}

abbrev GlobalBirthJointState (R : (g : Fin N) → P g → Type*) :=
  (g : Fin N) → GlobalBirthHistoryState (R g)

abbrev GlobalBirthJointPhase (R : (g : Fin N) → P g → Type*) :=
  (g : Fin N) → (p : P g) → GhostPhaseState (R g p)

def GlobalBirthJointCoherent (a : (g : Fin N) → P g → Bool)
    (s : GlobalBirthJointState R) : Prop :=
  ∀ g, GlobalBirthMemoryCoherent (ghostPhaseActivitySupport (a g)) (s g).1 (s g).2

noncomputable def globalBirthJointReadout (a : (g : Fin N) → P g → Bool)
    (s : GlobalBirthJointState R) : GlobalBirthJointPhase R :=
  fun g => globalBirthMemoryReadout (ghostPhaseActivitySupport (a g)) (s g).1 (s g).2

def globalBirthJointLength (s : GlobalBirthJointState R) : Nat :=
  ∑ g, (s g).2.1

noncomputable def globalBirthJointPending (z : GlobalBirthJointPhase R) : Nat :=
  ∑ g, (ghostPhasePendingSupport (z g)).card

def globalBirthJointRawCutoff (cap : Nat) (G : GlobalBirthJointState R → ℂ)
    (s : GlobalBirthJointState R) : ℂ :=
  if globalBirthJointLength s ≤ cap then G s else 0

noncomputable def globalBirthJointPhaseCutoff (cap : Nat) (F : GlobalBirthJointPhase R → ℂ)
    (z : GlobalBirthJointPhase R) : ℂ :=
  if globalBirthJointPending z ≤ cap then F z else 0

theorem global_birth_coherent_readout_pending_card {Q : Type*}
    [Fintype Q] [DecidableEq Q] {S : Q → Type*}
    (active born : Finset Q) (q : FiniteOrderedTuple (Σ p, S p))
    (hq : GlobalBirthMemoryCoherent active born q) :
    (ghostPhasePendingSupport (globalBirthMemoryReadout active born q)).card = q.1 := by
  rw [global_birth_coherent_readout_pending_support active born q hq]
  have hinj : Function.Injective (fun j => (q.2 j).1) := hq.label_injective
  rw [Finset.card_image_of_injective _ hinj]
  simp only [card_univ, Fintype.card_fin]

theorem global_birth_joint_readout_pending
    (a : (g : Fin N) → P g → Bool) (s : GlobalBirthJointState R)
    (hs : GlobalBirthJointCoherent a s) :
    globalBirthJointPending (globalBirthJointReadout a s) = globalBirthJointLength s := by
  apply Finset.sum_congr rfl
  intro g _
  exact global_birth_coherent_readout_pending_card _ _ _ (hs g)

theorem global_birth_joint_cutoff_readout
    (a : (g : Fin N) → P g → Bool) (cap : Nat)
    (G : GlobalBirthJointState R → ℂ) (F : GlobalBirthJointPhase R → ℂ)
    (hGF : ∀ s, GlobalBirthJointCoherent a s → G s = F (globalBirthJointReadout a s))
    (s : GlobalBirthJointState R) (hs : GlobalBirthJointCoherent a s) :
    globalBirthJointRawCutoff cap G s =
      globalBirthJointPhaseCutoff cap F (globalBirthJointReadout a s) := by
  unfold globalBirthJointRawCutoff globalBirthJointPhaseCutoff
  rw [global_birth_joint_readout_pending a s hs, hGF s hs]

variable [∀ g p, AddGroup (R g p)] [∀ g p, Fintype (R g p)]
  [∀ g p, DecidableEq (R g p)]

noncomputable def globalBirthJointRawRow
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (cap : Nat) (G : GlobalBirthJointState R → ℂ)
    (s : GlobalBirthJointState R) : ℂ :=
  finTensorRow N (fun g K t => globalBirthRawStepRow (step g)
    (fun H q => K (H, q)) t.1 t.2) (globalBirthJointRawCutoff cap G) s

noncomputable def globalBirthJointPhaseRow
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (cap : Nat) (F : GlobalBirthJointPhase R → ℂ)
    (z : GlobalBirthJointPhase R) : ℂ :=
  finTensorRow N (fun g => globalBirthRawStepPhaseRow (step g))
    (globalBirthJointPhaseCutoff cap F) z

/- The actual group rows commute with readout when the one joint cutoff
is applied to the completed output, regardless of the continuation's shape. -/
theorem global_birth_joint_raw_row_intertwines
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (cap : Nat) (G : GlobalBirthJointState R → ℂ) (F : GlobalBirthJointPhase R → ℂ)
    (hGF : ∀ s, GlobalBirthJointCoherent b s → G s = F (globalBirthJointReadout b s))
    (s : GlobalBirthJointState R) (hs : GlobalBirthJointCoherent a s) :
    globalBirthJointRawRow step cap G s =
      globalBirthJointPhaseRow step cap F (globalBirthJointReadout a s) := by
  unfold globalBirthJointRawRow globalBirthJointPhaseRow globalBirthJointReadout
  apply fin_tensor_row_intertwines_on N
    (S := fun g => GlobalBirthHistoryState (R g))
    (T := fun g => GlobalBirthHistoryState (R g))
    (X := fun g => (p : P g) → GhostPhaseState (R g p))
    (Y := fun g => (p : P g) → GhostPhaseState (R g p))
    (fun g K t => globalBirthRawStepRow (step g) (fun H q => K (H, q)) t.1 t.2)
    (fun g => globalBirthRawStepPhaseRow (step g))
    (fun g t => globalBirthMemoryReadout (ghostPhaseActivitySupport (a g)) t.1 t.2)
    (fun g t => globalBirthMemoryReadout (ghostPhaseActivitySupport (b g)) t.1 t.2)
    (fun g t => GlobalBirthMemoryCoherent (ghostPhaseActivitySupport (a g)) t.1 t.2)
    (fun g t => GlobalBirthMemoryCoherent (ghostPhaseActivitySupport (b g)) t.1 t.2)
  · intro g t ht K L hKL
    exact global_birth_raw_step_intertwines (step g) t.1 t.2 ht
      (fun H q => K (H, q)) L (fun H q hq _ => hKL (H, q) hq)
  · intro t ht
    exact global_birth_joint_cutoff_readout b cap G F hGF t ht
  · exact hs

end Joint
