theorem harmonic_cell_target_zero_of_not_mem {Y : ℝ} (hY : 0 < Y)
    (b : ℝ) (G : ℤ → ℂ) (n : ℤ) (hn : n ∉ harmonicCommonSupport Y) :
    harmonicCellTarget Y b G n = 0 := by
  apply harmonic_common_phased_target_zero_of_not_mem hY b G n
