open scoped Classical
/- A direct weighted bilinear estimate on the original tuple spaces.
Neither test is required to be constant on product fibers. -/
theorem weighted_product_rational_bilinear_bound
    {X Y : Type*} [Fintype X] [Fintype Y]
    (π : X → ℕ) (τ : Y → ℕ) (a N : ℕ) (A : ℤ) (V : ℕ)
    (hπrange : ∀ x, a ≤ π x ∧ π x < a + N)
    (hτrange : ∀ y, A ≤ (τ y : ℤ) ∧ (τ y : ℤ) ≤ A + (V : ℤ))
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (f : X → ℂ) (g : Y → ℂ)
    {C D P Q : ℝ} (hC : 0 ≤ C) (hD : 0 ≤ D) (hP : 0 < P) (hQ : 0 < Q)
    (hπ : ∀ x, P ≤ (π x : ℝ)) (hτ : ∀ y, Q ≤ (τ y : ℝ))
    (hμatom : ∀ m : ℕ,
      (∑ x ∈ Finset.univ.filter (fun x => π x = m), μ x) ≤ C / (m : ℝ))
    (hνatom : ∀ m : ℕ,
      (∑ y ∈ Finset.univ.filter (fun y => τ y = m), ν y) ≤ D / (m : ℝ))
    {u : ℤ} {r : ℕ} (hr : 0 < r) (hcop : (r : ℤ).gcd u = 1)
    {β : ℝ} (hβ : |β| ≤ 1 / (r : ℝ) ^ 2) :
    ‖∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) *
      (Complex.exp (Complex.I * (2 * Real.pi *
        (((u : ℝ) / r + β) * τ y) : ℝ))) ^ (π x)‖ ^ 2 ≤
      ((1 + 3 * (V : ℝ) / r) *
        (2 * (N : ℝ) + 2 * (r : ℝ) * (1 + Real.log r))) *
          ((C / P) * ∑ x, μ x * ‖f x‖ ^ 2) *
          ((D / Q) * ∑ y, ν y * ‖g y‖ ^ 2) := by
  let ρ : X → Fin N := fun x => ⟨π x - a, by obtain ⟨hlo, hhi⟩ := hπrange x; omega⟩
  have hρ : ∀ x, a + (ρ x).val = π x := by
    intro x
    obtain ⟨hlo, hhi⟩ := hπrange x
    dsimp only [ρ]
    omega
  let I := ↥(Finset.univ.image τ)
  let σ : Y → I := fun y => ⟨τ y, Finset.mem_image.mpr ⟨y, Finset.mem_univ y, rfl⟩⟩
  have hI : Function.Injective (fun i : I => i.val) := fun _ _ h => Subtype.ext h
  have hIr : ∀ i : I, A ≤ (i.val : ℤ) ∧ (i.val : ℤ) ≤ A + (V : ℤ) := by
    intro i
    obtain ⟨y, hy, he⟩ := Finset.mem_image.mp i.property
    simpa only [he] using hτrange y
  have hπ' : ∀ x, P ≤ (a + (ρ x).val : ℕ) := by
    intro x
    simpa only [hρ] using hπ x
  have hμ' : ∀ m : ℕ,
      (∑ x ∈ Finset.univ.filter (fun x => a + (ρ x).val = m), μ x) ≤ C / (m : ℝ) := by
    intro m
    simpa only [hρ] using hμatom m
  have hb := weighted_indexed_rational_bilinear_bound a N ρ σ (fun i : I => i.val)
    hI A V hIr μ ν hμ hν f g hC hD hP hQ hπ' hτ hμ' hνatom hr hcop hβ
  simpa only [hρ] using hb
end

