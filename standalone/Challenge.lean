theorem candidate_micro_Q_product_free {c L : ℝ} (hcL : 0 ≤ c*L)
    (hpool : ∀ p ∈ (candidatePIndices c L).biUnion (candidatePBand (c*L)),
      (p : ℝ) ≤ Real.exp (Real.sqrt L)) (r jStar J : ℕ)
    (x : ∀ i, candidateMicroQSlotChoices c L r jStar J i) :
    Disjoint (orderedSlotProduct (candidateMicroQSlotChoices c L r jStar J) x).primeFactors
      ((candidatePIndices c L).biUnion (candidatePBand (c*L))) := by
  classical
  apply disjoint_left.mpr
  intro p hp hP
  obtain ⟨hpp, hpdvd, _⟩ := Nat.mem_primeFactors.mp hp
  obtain ⟨slot, _, hpslot⟩ := ((Nat.prime_iff.mp hpp).dvd_finsetProd_iff (fun slot => (x slot).val)).mp hpdvd
  let s : (candidateQIndices c L) × Fin r :=
    (⟨slot.1.val, (mem_filter.mp slot.1.property).1⟩, slot.2)
  have hmem : p ∈ (x slot).val.primeFactors := Nat.mem_primeFactors.mpr
    ⟨hpp, hpslot, candidate_Q_slot_nonzero c L r jStar s (x slot).property⟩
  exact disjoint_left.mp (candidate_Q_slot_primeFactors_disjoint hcL hpool s (x slot).property) hmem hP

