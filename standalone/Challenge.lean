    let : BorelSpace E := instBorelSpaceEL2CompactnessTranslationIntegral (E := E)
    let : OpensMeasurableSpace E := instOpensMeasurableSpaceEL2CompactnessTranslationIntegral (E := E)
    let : MeasurableAdd E := instMeasurableAddEL2CompactnessTranslationIntegral (E := E)
    let : MeasurableNeg E := instMeasurableNegEL2CompactnessTranslationIntegral (E := E)
    kernelMeasure (E := E) ψ ((Metric.ball (0 : E) deltaLoss)ᶜ) = 0 := by
  let : MeasurableSpace E := instMeasurableSpaceEL2CompactnessTranslationIntegral (E := E)
  let : BorelSpace E := instBorelSpaceEL2CompactnessTranslationIntegral (E := E)
  let : OpensMeasurableSpace E := instOpensMeasurableSpaceEL2CompactnessTranslationIntegral (E := E)
  let : MeasurableAdd E := instMeasurableAddEL2CompactnessTranslationIntegral (E := E)
  let : MeasurableNeg E := instMeasurableNegEL2CompactnessTranslationIntegral (E := E)
