open scoped Classical
namespace Bounty
section Local
variable {S : Type} [Fintype S] {Ps : S → Finset ℕ}
  {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (cut : ℕ → Fin N → Finset (Fin J))

noncomputable def physicalSelectedSmallLocalUpdate
    (tag : Option (Fin (n + 1) ⊕ Fin n)) (r : PhysicalResidues Ps)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k tag s) : PhysicalResidues Ps :=
  physicalTranslateResidues r (physicalLocalDisplacement C k cut tag s e)

variable (Cs : Fin n → S → Finset (Fin J)) (Vs : S → ℝ) (q : ℝ)
  (ds : PhysicalGroupSelectedData Ps ell Cs)

noncomputable def physicalSelectedSmallLocalPhase
    (tag : Option (Fin (n + 1) ⊕ Fin n)) (r : PhysicalResidues Ps)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k tag s) : ℂ :=
  match tag with
  | none => (Nat.card (PhysicalPermutations S J ell) : ℂ)⁻¹
  | some (.inl _) => 1
  | some (.inr j) =>
      physicalBarePatternScalar Vs (Cs j) 0 (fun _ _ _ => 1) (ds.1 j)
        (physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc))
        (physicalPermuteLabels (ds.2.2.2 j) (ds.2.1 j.succ)) *
      ((physicalResidueVertexWeight (physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc))
          (Real.sqrt q) r *
        physicalResidueVertexWeight (physicalPermuteLabels (ds.2.2.2 j) (ds.2.1 j.succ))
          (Real.sqrt q) (physicalSelectedSmallLocalUpdate C k cut (some (.inr j)) r s e) : ℝ) : ℂ)

theorem physical_selected_small_local_phase_visit
    (j : Fin (n + 1)) (tag : Option (Fin (n + 1) ⊕ Fin n)) (htag : tag = some (.inl j))
    (r : PhysicalResidues Ps)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k tag s) :
    physicalSelectedSmallLocalPhase C k cut Cs Vs q ds tag r s e = 1 := by
  subst tag
  rfl

theorem physical_selected_small_local_phase_permutation
    (tag : Option (Fin (n + 1) ⊕ Fin n)) (htag : tag = none)
    (r : PhysicalResidues Ps)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k tag s) :
    physicalSelectedSmallLocalPhase C k cut Cs Vs q ds tag r s e =
      (Nat.card (PhysicalPermutations S J ell) : ℂ)⁻¹ := by
  subst tag
  rfl

theorem physical_selected_small_local_phase_edge
    (j : Fin n) (tag : Option (Fin (n + 1) ⊕ Fin n)) (htag : tag = some (.inr j))
    (r : PhysicalResidues Ps)
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B)
    (e : PhysicalFullLedgerEvent C k tag s) :
    physicalSelectedSmallLocalPhase C k cut Cs Vs q ds tag r s e =
      physicalBarePatternScalar Vs (Cs j) 0 (fun _ _ _ => 1) (ds.1 j)
        (physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc))
        (physicalPermuteLabels (ds.2.2.2 j) (ds.2.1 j.succ)) *
      ((physicalResidueVertexWeight (physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc))
          (Real.sqrt q) r *
        physicalResidueVertexWeight (physicalPermuteLabels (ds.2.2.2 j) (ds.2.1 j.succ))
          (Real.sqrt q) (physicalSelectedSmallLocalUpdate C k cut tag r s e) : ℝ) : ℂ) := by
  subst tag
  rfl

end Local
