open Filter
theorem exists_candidate_coefficient_window_mass_comparison {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) :
    ∃ Klo Khi : ℝ, 0 < Klo ∧ 0 < Khi ∧ ∃ J : ℕ,
      ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J < jStar →
        Klo * (Real.exp L / L) * candidateOneMarkedHarmonicMass c L q *
          candidateQHarmonicMass c L r jStar ≤ candidateCoefficientWindowMass c L q r jStar ∧
        candidateCoefficientWindowMass c L q r jStar ≤
          Khi * (Real.exp L / L) * candidateOneMarkedHarmonicMass c L q *
            candidateQHarmonicMass c L r jStar := by
  obtain ⟨Klo, hlo, J, hlower⟩ :=
    exists_candidate_coefficient_window_mass_lower hc hr hq0 hq1 hcenter
  obtain ⟨Khi, hhi, hupper⟩ := exists_candidate_coefficient_window_mass_upper hc hq0 hr
  refine ⟨Klo, Khi, hlo, hhi, J, ?_⟩
  filter_upwards [hlower, hupper] with L hloL hhiL
  intro jStar hj
  exact ⟨hloL jStar hj, hhiL jStar (lt_of_le_of_lt (Nat.zero_le J) hj)⟩






end

