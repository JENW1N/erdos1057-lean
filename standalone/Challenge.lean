theorem character_conj_apply_unit {q : ℕ} [NeZero q]
    (χ : DirichletCharacter ℂ q) {b : ZMod q} (hb : IsUnit b) :
    conj (χ b) = χ b⁻¹ := by
  rw [← Complex.star_def, MulChar.star_apply', MulChar.inv_apply]
  rcases hb with ⟨u, rfl⟩
  rw [Ring.inverse_unit, ZMod.inv_coe_unit]

theorem character_parseval {q : ℕ} [NeZero q]
    (S : Finset (ZMod q)) (hS : ∀ k ∈ S, IsUnit k) (F : ZMod q → ℂ) :
    (∑ χ : DirichletCharacter ℂ q, ‖∑ k ∈ S, F k * χ k‖ ^ 2) =
      (q.totient : ℝ) * ∑ k ∈ S, ‖F k‖ ^ 2 := by
  classical
  have hnorm (z : ℂ) : conj z * z = ((‖z‖ ^ 2 : ℝ) : ℂ) := by
    rw [← Complex.normSq_eq_conj_mul_self, Complex.normSq_eq_norm_sq]
  have hexpand (χ : DirichletCharacter ℂ q) :
      conj (∑ k ∈ S, F k * χ k) * (∑ k ∈ S, F k * χ k) =
        ∑ k ∈ S, ∑ l ∈ S, (conj (F k) * F l) * (χ k⁻¹ * χ l) := by
    simp only [map_sum, map_mul, sum_mul, mul_sum]
    rw [sum_comm]
    apply sum_congr rfl
    intro k hk
    apply sum_congr rfl
    intro l hl
    rw [character_conj_apply_unit χ (hS k hk)]
    ring
  have hc :
      (∑ χ : DirichletCharacter ℂ q,
        conj (∑ k ∈ S, F k * χ k) * (∑ k ∈ S, F k * χ k)) =
        (q.totient : ℂ) * ∑ k ∈ S, conj (F k) * F k := by
    simp_rw [hexpand]
    rw [sum_comm]
    rw [mul_sum]
    apply sum_congr rfl
    intro k hk
    rw [sum_comm]
    simp_rw [← mul_sum, DirichletCharacter.sum_char_inv_mul_char_eq ℂ (hS k hk)]
    simp [hk, mul_comm]
  simp_rw [hnorm] at hc
  exact_mod_cast hc


theorem character_inverse_parseval {q : ℕ} [NeZero q]
    (S : Finset (ZMod q)) (hS : ∀ k ∈ S, IsUnit k) (F : ZMod q → ℂ) :
    (∑ χ : DirichletCharacter ℂ q, ‖∑ k ∈ S, F k * χ⁻¹ k‖ ^ 2) =
      (q.totient : ℝ) * ∑ k ∈ S, ‖F k‖ ^ 2 := by
  rw [← character_parseval S hS F]
  exact Fintype.sum_bijective _ inv_involutive.bijective _ _ (fun _ => rfl)

theorem character_transform_additive_sum {q : ℕ} [NeZero q]
    {ι : Type*} (T : Finset ι) (a : ι → ℂ) (v : ι → ZMod q)
    {χ : DirichletCharacter ℂ q} (hχ : χ.IsPrimitive) :
    (∑ k ∈ univ.filter IsUnit,
      (∑ t ∈ T, a t * stdAddChar (v t * k)) * χ k) =
      gaussSum χ stdAddChar * ∑ t ∈ T, a t * χ⁻¹ (v t) := by
  classical
  have hfull :
      (∑ k ∈ univ.filter IsUnit,
        (∑ t ∈ T, a t * stdAddChar (v t * k)) * χ k) =
      ∑ k : ZMod q, (∑ t ∈ T, a t * stdAddChar (v t * k)) * χ k := by
    apply sum_subset (filter_subset _ _)
    intro k _ hk
    have hk' : ¬IsUnit k := by simpa only [mem_filter, mem_univ, true_and] using hk
    rw [MulChar.map_nonunit χ hk', mul_zero]
  rw [hfull]
  simp_rw [sum_mul]
  rw [sum_comm, mul_sum]
  apply sum_congr rfl
  intro t ht
  have hg := gaussSum_mulShift_of_isPrimitive stdAddChar hχ (v t)
  simp only [gaussSum, AddChar.mulShift_apply] at hg
  calc
    (∑ k : ZMod q, a t * stdAddChar (v t * k) * χ k) =
        a t * ∑ k : ZMod q, χ k * stdAddChar (v t * k) := by
      rw [mul_sum]
      apply sum_congr rfl
      intro k _
      ring
    _ = gaussSum χ stdAddChar * (a t * χ⁻¹ (v t)) := by
      rw [hg]
      simp only [gaussSum]
      ring


noncomputable def primitiveCharacters (q : ℕ) : Finset (DirichletCharacter ℂ q) := by
  classical
  exact univ.filter (fun χ => χ.IsPrimitive)

theorem primitive_character_sum_sq_le_additive {q : ℕ} [NeZero q]
    {ι : Type*} (T : Finset ι) (a : ι → ℂ) (v : ι → ZMod q) :
    (q : ℝ) / q.totient *
      (∑ χ ∈ primitiveCharacters q,
        ‖∑ t ∈ T, a t * χ (v t)‖ ^ 2) ≤
      ∑ k ∈ univ.filter IsUnit, ‖∑ t ∈ T, a t * stdAddChar (v t * k)‖ ^ 2 := by
  classical
  unfold primitiveCharacters
  let F : ZMod q → ℂ := fun k => ∑ t ∈ T, a t * stdAddChar (v t * k)
  have hid (χ : DirichletCharacter ℂ q) (hχ : χ.IsPrimitive) :
      ‖∑ k ∈ univ.filter IsUnit, F k * χ⁻¹ k‖ ^ 2 =
        (q : ℝ) * ‖∑ t ∈ T, a t * χ (v t)‖ ^ 2 := by
    have hi : χ⁻¹.IsPrimitive := by
      simpa only [DirichletCharacter.isPrimitive_def, DirichletCharacter.conductor_inv] using hχ
    have ht := character_transform_additive_sum T a v hi
    simp only [inv_inv] at ht
    change ‖∑ k ∈ univ.filter IsUnit,
      (∑ t ∈ T, a t * stdAddChar (v t * k)) * χ⁻¹ k‖ ^ 2 = _
    rw [ht, norm_mul, mul_pow, primitive_gaussSum_norm_sq hi]
  have hle :
      (∑ χ ∈ univ.filter (fun χ : DirichletCharacter ℂ q => χ.IsPrimitive),
        ‖∑ k ∈ univ.filter IsUnit, F k * χ⁻¹ k‖ ^ 2) ≤
      ∑ χ : DirichletCharacter ℂ q, ‖∑ k ∈ univ.filter IsUnit, F k * χ⁻¹ k‖ ^ 2 :=
    sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun χ _ _ => sq_nonneg _)
  rw [character_inverse_parseval _ (fun k hk => (mem_filter.mp hk).2) F] at hle
  have heq :
      (∑ χ ∈ univ.filter (fun χ : DirichletCharacter ℂ q => χ.IsPrimitive),
        ‖∑ k ∈ univ.filter IsUnit, F k * χ⁻¹ k‖ ^ 2) =
      (q : ℝ) * ∑ χ ∈ univ.filter (fun χ : DirichletCharacter ℂ q => χ.IsPrimitive),
        ‖∑ t ∈ T, a t * χ (v t)‖ ^ 2 := by
    rw [mul_sum]
    apply sum_congr rfl
    intro χ hχ
    exact hid χ (mem_filter.mp hχ).2
  rw [heq] at hle
  have hφ : (0 : ℝ) < q.totient := by
    exact_mod_cast Nat.totient_pos.mpr (NeZero.pos q)
  rw [div_mul_eq_mul_div, div_le_iff₀ hφ]
  simpa only [F, mul_comm] using hle


end Bounty
end

section

/- Exact small and large conductor decomposition of the candidate Type I mass. -/

open Finset

namespace Bounty

noncomputable def primitiveConductorNormTerm {Ω : Type*} (d f : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) : ℝ := by
  classical
  exact ∑ ψ ∈ (univ : Finset (DirichletCharacter ℂ f)).filter
    (fun ψ => ψ.IsPrimitive ∧ ψ ≠ 1),
    ‖∑ t ∈ T.filter (fun t => (value t).Coprime (d / f)),
      μ t * ψ (value t : ZMod f)‖

noncomputable def smallPrimitiveConductorNormSum {Ω : Type*} (d R : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) : ℝ :=
  ∑ f ∈ d.divisors.filter (fun f => 1 < f ∧ f ≤ R),
    primitiveConductorNormTerm d f T μ value

noncomputable def largePrimitiveConductorNormSum {Ω : Type*} (d R : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) : ℝ :=
  ∑ f ∈ d.divisors.filter (fun f => 1 < f ∧ R < f),
    primitiveConductorNormTerm d f T μ value

section

variable
  {Ω : Type*}
  (d R : ℕ)
  (T : Finset Ω)
  (μ : Ω → ℂ)
  (value : Ω → ℕ)

include Ω d R T μ value

theorem primitive_conductor_norm_split  :
    typeIPrimitiveConductorNormSum d T μ value =
      smallPrimitiveConductorNormSum d R T μ value +
        largePrimitiveConductorNormSum d R T μ value := by
  classical
  have h := sum_filter_add_sum_filter_not (d.divisors.filter (fun f => 1 < f))
    (fun f => f ≤ R) (fun f => primitiveConductorNormTerm d f T μ value)
  simpa only [typeIPrimitiveConductorNormSum, smallPrimitiveConductorNormSum,
    largePrimitiveConductorNormSum, filter_filter, not_le,
    primitiveConductorNormTerm] using h.symm

theorem small_primitive_conductor_norm_nonneg  :
    0 ≤ smallPrimitiveConductorNormSum d R T μ value := by
  unfold smallPrimitiveConductorNormSum primitiveConductorNormTerm
  positivity

theorem large_primitive_conductor_norm_nonneg  :
    0 ≤ largePrimitiveConductorNormSum d R T μ value := by
  unfold largePrimitiveConductorNormSum primitiveConductorNormTerm
  positivity

end


noncomputable def candidateSmallPrimitiveTypeIMass (c L q : ℝ) (r jStar N R : ℕ) : ℝ :=
  ∑ d ∈ oddSquarefreeModuli N,
    smallPrimitiveConductorNormSum d R (arithmeticProductWindow 1 (Real.exp L))
      (fun u => (candidateCoefficient c L q r jStar u : ℂ)) (fun u => u) /
      (d.totient : ℝ)

noncomputable def candidateLargePrimitiveTypeIMass (c L q : ℝ) (r jStar N R : ℕ) : ℝ :=
  ∑ d ∈ oddSquarefreeModuli N,
    largePrimitiveConductorNormSum d R (arithmeticProductWindow 1 (Real.exp L))
      (fun u => (candidateCoefficient c L q r jStar u : ℂ)) (fun u => u) /
      (d.totient : ℝ)

theorem candidate_primitive_typeI_mass_split (c L q : ℝ) (r jStar N R : ℕ) :
    candidatePrimitiveTypeIMass c L q r jStar N =
      candidateSmallPrimitiveTypeIMass c L q r jStar N R +
        candidateLargePrimitiveTypeIMass c L q r jStar N R := by
  unfold candidatePrimitiveTypeIMass candidateSmallPrimitiveTypeIMass
    candidateLargePrimitiveTypeIMass
  simp_rw [primitive_conductor_norm_split (R := R), add_div]
  exact sum_add_distrib

theorem candidate_small_primitive_mass_le (c L q : ℝ) (r jStar N R : ℕ)
    (B : ℕ → ℝ) (hB : ∀ f ∈ Icc 2 R, 0 ≤ B f) {D : ℝ}
    (hD : 1 ≤ D) (hND : (N : ℝ) ≤ D)
    (hbound : ∀ d ∈ (Icc 1 N).filter Squarefree,
      ∀ f ∈ d.divisors.filter (fun f => 1 < f ∧ f ≤ R),
      ∀ ψ : DirichletCharacter ℂ f, ψ.IsPrimitive → ψ ≠ 1 →
        ‖∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter
          (fun u => u.Coprime (d / f)),
          (candidateCoefficient c L q r jStar u : ℂ) * ψ (u : ZMod f)‖ ≤ B f) :
    candidateSmallPrimitiveTypeIMass c L q r jStar N R ≤
      ((2 * primeEulerProductUpperConstant) * Real.log (2 * D)) *
        ∑ f ∈ Icc 2 R, B f := by
  classical
  have h := small_primitive_conductor_mass_le N R
    (arithmeticProductWindow 1 (Real.exp L))
    (fun u => (candidateCoefficient c L q r jStar u : ℂ)) (fun u => u)
    B hB hD hND hbound
  apply le_trans _ h
  change (∑ d ∈ oddSquarefreeModuli N, _) ≤ _
  apply sum_le_sum_of_subset_of_nonneg
  · intro d hd
    exact mem_filter.mpr ⟨(mem_filter.mp hd).1, (mem_filter.mp hd).2.1⟩
  · intro d _ _
    apply div_nonneg _ (Nat.cast_nonneg _)
    exact small_primitive_conductor_norm_nonneg d R _ _ _

end Bounty
end

section

/- Explicit disjoint rectangle layers for finite dyadic prefixes. -/

open Finset

namespace Bounty

def shiftPrefixRectangle {α : Type*} (L : ℕ) (r : Finset α × Finset ℕ) :
    Finset α × Finset ℕ := (r.1, r.2.image (fun n => n + L))

noncomputable def dyadicPrefixLayer {α : Type*} (K d : ℕ)
    (M : Finset α) (κ : α → ℕ) : List (Finset α × Finset ℕ) := by
  classical
  exact match K, d with
  | 0, 0 => [(M.filter (fun m => 0 < κ m), {0})]
  | 0, _ + 1 => []
  | K + 1, 0 => [(M.filter (fun m => 2 ^ K ≤ κ m), range (2 ^ K))]
  | K + 1, d + 1 =>
      dyadicPrefixLayer K d (M.filter (fun m => κ m < 2 ^ K)) κ ++
        (dyadicPrefixLayer K d (M.filter (fun m => 2 ^ K ≤ κ m))
          (fun m => κ m - 2 ^ K)).map (shiftPrefixRectangle (2 ^ K))

theorem dyadicPrefixLayer_bounds {α : Type*} (K d : ℕ)
    (M : Finset α) (κ : α → ℕ) :
    ∀ r ∈ dyadicPrefixLayer K d M κ, r.1 ⊆ M ∧ r.2 ⊆ range (2 ^ K) := by
  classical
  induction K generalizing d M κ with
  | zero =>
    cases d with
    | zero => simp [dyadicPrefixLayer]
    | succ d => simp [dyadicPrefixLayer]
  | succ K ih =>
    cases d with
    | zero =>
      intro r hr
      simp only [dyadicPrefixLayer, List.mem_singleton] at hr
      subst r
      exact ⟨filter_subset _ _, range_mono (by simp only [pow_succ]; omega)⟩
    | succ d =>
      intro r hr
      simp only [dyadicPrefixLayer, List.mem_append, List.mem_map] at hr
      rcases hr with hl | ⟨r', hr', rfl⟩
      · obtain ⟨hm, hn⟩ := ih d _ κ r hl
        exact ⟨hm.trans (filter_subset _ _), hn.trans (range_mono (by simp only [pow_succ]; omega))⟩
      · obtain ⟨hm, hn⟩ := ih d _ (fun m => κ m - 2 ^ K) r' hr'
        refine ⟨hm.trans (filter_subset _ _), ?_⟩
        intro n hn'
        obtain ⟨k, hk, rfl⟩ := mem_image.mp hn'
        have hk' := mem_range.mp (hn hk)
        simp only [mem_range, pow_succ]
        omega

theorem dyadicPrefixLayer_pairwise {α : Type*} (K d : ℕ)
    (M : Finset α) (κ : α → ℕ) :
    (dyadicPrefixLayer K d M κ).Pairwise (fun r s =>
      Disjoint r.1 s.1 ∧ Disjoint r.2 s.2) := by
  classical
  induction K generalizing d M κ with
  | zero => cases d <;> simp [dyadicPrefixLayer]
  | succ K ih =>
    cases d with
    | zero => simp [dyadicPrefixLayer]
    | succ d =>
      rw [dyadicPrefixLayer, List.pairwise_append]
      refine ⟨ih d _ _, ?_, ?_⟩
      · rw [List.pairwise_map]
        apply (ih d _ _).imp
        intro r s hrs
        exact ⟨hrs.1, (Finset.disjoint_image (fun a b h => Nat.add_right_cancel h)).mpr hrs.2⟩
      · intro r hr s hs
        obtain ⟨s', hs', rfl⟩ := List.mem_map.mp hs
        obtain ⟨hrM, hrN⟩ := dyadicPrefixLayer_bounds K d _ κ r hr
        obtain ⟨hsM, hsN⟩ := dyadicPrefixLayer_bounds K d _
          (fun m => κ m - 2 ^ K) s' hs'
        constructor
        · apply disjoint_left.mpr
          intro m hm hm'
          have h₁ := (mem_filter.mp (hrM hm)).2
          have h₂ := (mem_filter.mp (hsM hm')).2
          omega
        · apply disjoint_left.mpr
          intro n hn hn'
          have h₁ := mem_range.mp (hrN hn)
          obtain ⟨k, hk, hkn⟩ := mem_image.mp hn'
          omega


def prefixRectangleSum {α E : Type*} [AddCommMonoid E]
    (w : α → ℕ → E) (r : Finset α × Finset ℕ) : E :=
  ∑ m ∈ r.1, ∑ n ∈ r.2, w m n

def prefixLayerSum {α E : Type*} [AddCommMonoid E]
    (w : α → ℕ → E) (L : List (Finset α × Finset ℕ)) : E :=
  (L.map (prefixRectangleSum w)).sum

section

variable
  {α E : Type*}
  [sharedInstance1 : AddCommMonoid E]
  (w : α → ℕ → E)

include α E sharedInstance1 w

theorem prefixRectangleSum_shift  (L : ℕ) (r : Finset α × Finset ℕ) :
    prefixRectangleSum w (shiftPrefixRectangle L r) =
      prefixRectangleSum (fun m n => w m (n + L)) r := by
  unfold prefixRectangleSum shiftPrefixRectangle
  apply sum_congr rfl
  intro m hm
  exact sum_image (fun a _ b _ h => Nat.add_right_cancel h)

theorem prefixLayerSum_append  (L R : List (Finset α × Finset ℕ)) :
    prefixLayerSum w (L ++ R) = prefixLayerSum w L + prefixLayerSum w R := by
  simp only [prefixLayerSum, List.map_append, List.sum_append]

theorem prefixLayerSum_shift  (N : ℕ) (L : List (Finset α × Finset ℕ)) :
    prefixLayerSum w (L.map (shiftPrefixRectangle N)) =
      prefixLayerSum (fun m n => w m (n + N)) L := by
  simp only [prefixLayerSum, List.map_map, Function.comp_def, prefixRectangleSum_shift]

end


private theorem prefix_sum_split {α E : Type*} [AddCommMonoid E]
    (M : Finset α) (κ : α → ℕ) (L : ℕ) (w : α → ℕ → E) :
    (∑ m ∈ M, ∑ n ∈ range (κ m), w m n) =
      prefixRectangleSum w (M.filter (fun m => L ≤ κ m), range L) +
      (∑ m ∈ M.filter (fun m => κ m < L), ∑ n ∈ range (κ m), w m n) +
      (∑ m ∈ M.filter (fun m => L ≤ κ m),
        ∑ n ∈ range (κ m - L), w m (n + L)) := by
  classical
  have hpart := sum_filter_add_sum_filter_not M (fun m => κ m < L)
    (fun m => ∑ n ∈ range (κ m), w m n)
  simp only [not_lt] at hpart
  rw [← hpart]
  have hright : (∑ m ∈ M.filter (fun m => L ≤ κ m),
      ∑ n ∈ range (κ m), w m n) =
      prefixRectangleSum w (M.filter (fun m => L ≤ κ m), range L) +
      ∑ m ∈ M.filter (fun m => L ≤ κ m),
        ∑ n ∈ range (κ m - L), w m (n + L) := by
    rw [prefixRectangleSum, ← sum_add_distrib]
    apply sum_congr rfl
    intro m hm
    have hLm := (mem_filter.mp hm).2
    nth_rw 1 [← Nat.add_sub_of_le hLm]
    rw [sum_range_add]
    simp only [Nat.add_comm]
  rw [hright]
  ac_rfl

theorem dyadicPrefixLayer_weighted_sum {α E : Type*} [AddCommMonoid E]
    (K : ℕ) (M : Finset α) (κ : α → ℕ)
    (hκ : ∀ m ∈ M, κ m ≤ 2 ^ K) (w : α → ℕ → E) :
    (∑ m ∈ M, ∑ n ∈ range (κ m), w m n) =
      ∑ d ∈ range (K + 1), prefixLayerSum w (dyadicPrefixLayer K d M κ) := by
  classical
  induction K generalizing M κ w with
  | zero =>
    simp only [zero_add, sum_range_one, dyadicPrefixLayer, prefixLayerSum,
      List.map_singleton, List.sum_singleton, prefixRectangleSum, sum_singleton]
    rw [sum_filter]
    apply sum_congr rfl
    intro m hm
    have h := hκ m hm
    simp only [pow_zero] at h
    by_cases hm' : 0 < κ m
    · have hk : κ m = 1 := by omega
      simp [hk]
    · have hk : κ m = 0 := by omega
      simp [hk]
  | succ K ih =>
    have hleft : ∀ m ∈ M.filter (fun m => κ m < 2 ^ K), κ m ≤ 2 ^ K := by
      intro m hm
      exact Nat.le_of_lt (mem_filter.mp hm).2
    have hright : ∀ m ∈ M.filter (fun m => 2 ^ K ≤ κ m), κ m - 2 ^ K ≤ 2 ^ K := by
      intro m hm
      have h := hκ m (mem_filter.mp hm).1
      simp only [pow_succ] at h
      omega
    rw [prefix_sum_split M κ (2 ^ K) w]
    rw [ih _ _ hleft w, ih _ _ hright (fun m n => w m (n + 2 ^ K))]
    conv_rhs => rw [sum_range_succ']
    simp only [dyadicPrefixLayer, prefixLayerSum_append, prefixLayerSum_shift]
    simp only [prefixLayerSum, List.map_singleton, List.sum_singleton]
    rw [sum_add_distrib]
    ac_rfl


theorem dyadicPrefixLayer_eq_nil {α : Type*} (K d : ℕ)
    (M : Finset α) (κ : α → ℕ) (hd : K < d) :
    dyadicPrefixLayer K d M κ = [] := by
  classical
  induction K generalizing d M κ with
  | zero => cases d <;> simp_all [dyadicPrefixLayer]
  | succ K ih =>
    cases d with
    | zero => omega
    | succ d =>
      simp only [dyadicPrefixLayer, ih d _ _ (by omega), List.map_nil, List.append_nil]





end Bounty
end

section

/- Exponential individual-character savings for a fixed positive prime-band exponent. -/

open Finset Filter

namespace Bounty

theorem eventually_prime_profile_exponential {c : ℝ} (hc : 0 < c) (C D : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      C * Real.exp (-(c / 32) * L) + D * L * Real.exp (-c * L) ≤
        Real.exp (-(c / 64) * L) := by
  have hsmall : 0 < c / 64 := div_pos hc (by norm_num)
  have hlarge : 0 < 63 * c / 64 := by positivity
  filter_upwards [eventually_linear_exponential_profile_le_rpow hsmall hlarge C D 0] with L hL
  simp only [neg_zero, Real.rpow_zero] at hL
  have hx : Real.exp (-(c / 64) * L) * Real.exp (-(c / 64) * L) =
      Real.exp (-(c / 32) * L) := by rw [← Real.exp_add]; congr 1; ring
  have hy : Real.exp (-(63 * c / 64) * L) * Real.exp (-(c / 64) * L) =
      Real.exp (-c * L) := by rw [← Real.exp_add]; congr 1; ring
  calc
    _ = (C * Real.exp (-(c / 64) * L) +
        D * L * Real.exp (-(63 * c / 64) * L)) * Real.exp (-(c / 64) * L) := by
      rw [add_mul, mul_assoc C, mul_assoc (D * L), hx, hy]
    _ ≤ 1 * Real.exp (-(c / 64) * L) :=
      mul_le_mul_of_nonneg_right hL (Real.exp_nonneg _)
    _ = _ := one_mul _

theorem eventually_prime_band_coprime_relative_exponential_bound
    (hZ : PrimitiveZeroFreeHalfPlane) {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (f : ℕ), 0 < f → (f : ℝ) ≤ Real.exp L →
      ∀ χ : DirichletCharacter ℂ f, χ ≠ 1 →
      ∀ b t U V : ℝ, 0 ≤ b → 0 < t → 0 ≤ U → 0 ≤ V →
      ∀ m : ℕ, m ≠ 0 → (m : ℝ) ≤ Real.exp L →
        ‖∑ p ∈ ((primeBand (Real.exp (c * L)) b).filter
          (fun p : ℕ => U < t * (p : ℝ) ∧ t * (p : ℝ) ≤ V)).filter
            (fun p => p.Coprime m), χ (p : ZMod f)‖ ≤
          (V / t) * Real.exp (-(c / 64) * L) := by
  obtain ⟨C, hC, hbound⟩ := ordinary_prime_band_product_coprime_relative_bound hZ
  have hlarge : ∀ᶠ L : ℝ in atTop, (2 : ℝ) ≤ Real.exp (c * L) :=
    (Real.tendsto_exp_atTop.comp (tendsto_id.const_mul_atTop hc)).eventually_ge_atTop 2
  filter_upwards [eventually_prime_profile_exponential hc
    (2 * C * (1 + 1 / c)) (1 / Real.log 2),
    hlarge, eventually_gt_atTop (0 : ℝ)] with L hdecay hlarge hL
  intro f hf hfL χ hχ b t U V hb ht hU hV m hm hmL
  apply (hbound f hf χ hχ (Real.exp (c * L)) b t U V hlarge hb ht hU hV m hm).trans
  apply mul_le_mul_of_nonneg_left _ (div_nonneg hV ht.le)
  exact (prime_coprime_relative_profile_bound hc hL hC.le hf hfL hm hmL).trans hdecay

end Bounty
end

section

/- Exact supported/free convolution with arbitrary complex tests on the product. -/

open Finset

namespace Bounty

theorem supported_free_window_complex_test_eq (P S : Finset ℕ)
    (a b W : ℕ → ℝ) (F : ℕ → ℂ) (X : ℝ)
    (hS : ∀ p ∈ S, p ∈ Nat.factoredNumbers P)
    (hb : ∀ n, b n ≠ 0 → n ≠ 0 ∧ Disjoint n.primeFactors P)
    (hprod : ∀ p ∈ S, ∀ n, b n ≠ 0 → W (p*n) = a p*b n)
    (hcovered : ∀ u ∈ arithmeticProductWindow 1 X, W u ≠ 0 →
      ∃ p ∈ S, ∃ n ∈ arithmeticProductWindow p X, b n ≠ 0 ∧ p*n = u) :
    (∑ p ∈ S, (a p : ℂ) * ∑ n ∈ arithmeticProductWindow p X, (b n : ℂ)*F (p*n)) =
      ∑ u ∈ arithmeticProductWindow 1 X, (W u : ℂ)*F u := by
  classical
  let T : Finset (Σ _p : ℕ, ℕ) :=
    S.sigma (fun p => (arithmeticProductWindow p X).filter (fun n => b n ≠ 0))
  let f : (Σ _p : ℕ, ℕ) → ℕ := fun z => z.1*z.2
  have hinj : Set.InjOn f T := by
    intro x hx y hy hxy
    have hx' := mem_sigma.mp hx
    have hy' := mem_sigma.mp hy
    have hbx := hb x.2 (mem_filter.mp hx'.2).2
    have hby := hb y.2 (mem_filter.mp hy'.2).2
    obtain ⟨hp, hn⟩ := supported_free_product_unique
      (hS x.1 hx'.1) hbx.1 hbx.2 (hS y.1 hy'.1) hby.1 hby.2 hxy
    exact Sigma.ext hp (heq_of_eq hn)
  have hsubset : T.image f ⊆ arithmeticProductWindow 1 X := by
    intro u hu
    obtain ⟨z, hz, rfl⟩ := mem_image.mp hu
    have hz' := mem_sigma.mp hz
    have hwindow := (mem_filter.mp hz'.2).1
    have hp0 := Nat.ne_zero_of_mem_factoredNumbers (hS z.1 hz'.1)
    have hrange := (mem_arithmeticProductWindow_iff hp0 X).mp hwindow
    apply (mem_arithmeticProductWindow_iff one_ne_zero X).mpr
    simpa only [one_mul, f] using hrange
  calc
    _ = ∑ z ∈ T, (W (f z) : ℂ)*F (f z) := by
      dsimp only [T, f]
      rw [sum_sigma]
      apply sum_congr rfl
      intro p hp
      rw [mul_sum, sum_filter]
      apply sum_congr rfl
      intro n _
      by_cases hbn : b n = 0
      · simp only [hbn, Complex.ofReal_zero, zero_mul, mul_zero, ne_eq, not_true_eq_false, if_false]
      · rw [if_pos hbn, hprod p hp n hbn, Complex.ofReal_mul]
        ring
    _ = ∑ u ∈ T.image f, (W u : ℂ)*F u := (sum_image (f := fun u => (W u : ℂ)*F u) hinj).symm
    _ = _ := by
      apply sum_subset hsubset
      intro u hu hnot
      have hWu : W u = 0 := by
        by_contra hWu
        obtain ⟨p, hp, n, hn, hbn, hpn⟩ := hcovered u hu hWu
        exact hnot (mem_image.mpr
          ⟨⟨p, n⟩, mem_sigma.mpr ⟨hp, mem_filter.mpr ⟨hn, hbn⟩⟩, hpn⟩)
      simp only [hWu, Complex.ofReal_zero, zero_mul]

end Bounty

end

section

/- Complex tests of ordered slot weights and exact extraction of one slot. -/

open Finset

namespace Bounty

section

variable
  {I : Type*}
  [sharedInstance1 : Fintype I]
  [sharedInstance2 : DecidableEq I]
  (choices : I → Finset ℕ)

include I sharedInstance1 sharedInstance2 choices

theorem ordered_slot_complex_window_sum  (normalization : ℝ) (S : Finset ℕ) (F : ℕ → ℂ) :
    (∑ n ∈ S, (orderedSlotWeight choices normalization n : ℂ) * F n) =
      ∑ x : ∀ i, choices i, if orderedSlotProduct choices x ∈ S then
        (1 / (normalization : ℂ)) * F (orderedSlotProduct choices x) else 0 := by
  classical
  simp only [orderedSlotWeight, Complex.ofReal_sum, apply_ite,
    Complex.ofReal_div, Complex.ofReal_one, Complex.ofReal_zero, sum_mul]
  rw [sum_comm]
  apply sum_congr
  · ext x
    simp
  · intro x _
    simp only [ite_mul, zero_mul]
    simp

theorem ordered_slot_complex_test_split  (i : I) (F : ℕ → ℂ) :
    (∑ x : ∀ j, choices j, F (orderedSlotProduct choices x)) =
      ∑ p : choices i, ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
        F (p.val * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y) := by
  classical
  let f : choices i × (∀ j : {j : I // j ≠ i}, choices j.val) → ℂ := fun z =>
    F (z.1.val * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) z.2)
  calc
    _ = ∑ z, f z := by
      apply Fintype.sum_equiv (Equiv.piSplitAt i (fun j => choices j))
      intro x
      simp only [f, Equiv.piSplitAt_apply]
      rw [ordered_slot_product_split choices i x]
    _ = _ := Fintype.sum_prod_type f

theorem ordered_slot_complex_window_split  (i : I) (normalization : ℝ) (S : Finset ℕ) (F : ℕ → ℂ) :
    (∑ n ∈ S, (orderedSlotWeight choices normalization n : ℂ) * F n) =
      ∑ p : choices i, ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
        if p.val * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y ∈ S then
          (1 / (normalization : ℂ)) *
            F (p.val * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y) else 0 := by
  rw [ordered_slot_complex_window_sum]
  exact ordered_slot_complex_test_split choices i
    (fun n => if n ∈ S then (1 / (normalization : ℂ)) * F n else 0)

end


end Bounty

end

