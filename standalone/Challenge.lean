/- In each cell/character term, the two weighted selected endpoint averages
are independent of the auxiliary prime draws. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_prime_cell_average
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (Q : ℕ) (h : ℝ) (keptA keptB : Finset ℤ)
    (S : Finset G) (hA : ∀ i ∈ A, i.1 ∈ S) (hB : ∀ i ∈ B, i.1 ∈ S)
    (q : ℝ) (w z : ℤ) (aux : PhysicalAuxLabels P (repeatedBigAuxCut A B)) :
    let PA := fun i : A => P i.val.1
    let PB := fun i : B => P i.val.1
    let VA := fun i : A => V i.val.1
    let VB := fun i : B => V i.val.1
    let a := fun d => ((1 / finiteCellMass (finiteProductWeight (physicalLabelLaw (P := PA) VA))
      (fun x => upperLogCell h (Real.log (∏ i, (x i).val : ℕ))) d : ℝ) : ℂ)
    let b := fun e => ((1 / finiteCellMass (finiteProductWeight (physicalLabelLaw (P := PB) VB))
      (fun x => upperLogCell h (Real.log (∏ i, (x i).val : ℕ))) e : ℝ) : ℂ)
    let marks := fun g => ell + (repeatedBigAuxCut A B g).card
    let W := fun n => markedDivisorWeight univ P q V marks n
    let split := repeatedBigAuxSplitEquiv P A B hU hAB aux
    ((W w*W z : ℝ) : ℂ) * groupMarkedAverage P marks w (fun u =>
      groupMarkedAverage P marks z (fun v =>
        physicalUnsharedPrimeCoefficient P V A B hU hAB Q h keptA keptB u v aux)) =
      ∑ d ∈ keptA, ∑ χ : BoundedPrimitiveCharacter Q,
        ∑ e ∈ keptB, ∑ ψ : BoundedPrimitiveCharacter Q,
          ((a d*b e) *
            ((starRingEnd ℂ) (primeProductCellCharacter PA h d χ split.1) *
              (starRingEnd ℂ) (primeProductCellCharacter PB h e ψ split.2))) *
            (((W w : ℂ) * groupMarkedAverage (fun g : S => P g.val)
                (fun g : S => marks g.val) w
                (fun u => primeProductCellCharacter PB h e ψ
                  (physicalSelectedPrimeRestriction A B B subset_union_right S hB u))) *
              ((W z : ℂ) * groupMarkedAverage (fun g : S => P g.val)
                (fun g : S => marks g.val) z
                (fun v => primeProductCellCharacter PA h d χ
                  (physicalSelectedPrimeRestriction A B A subset_union_left S hA v)))) := by
  dsimp only
  simp_rw [physical_prime_cell_expansion P V A B hU hAB Q h keptA keptB S hA hB]
  simp_rw [group_marked_average_sum]
  simp only [mul_sum]
  apply sum_congr rfl
  intro d _
  apply sum_congr rfl
  intro χ _
  apply sum_congr rfl
  intro e _
  apply sum_congr rfl
  intro ψ _
  have he := weighted_marked_pair_finite_expansion P q V
    (fun g => ell + (repeatedBigAuxCut A B g).card) w z S (univ : Finset Unit)
    (fun _ =>
      (((1 / finiteCellMass (finiteProductWeight (physicalLabelLaw (P := fun i : A => P i.val.1)
          (fun i => V i.val.1)))
        (fun x => upperLogCell h (Real.log (∏ i, (x i).val : ℕ))) d : ℝ) : ℂ) *
       ((1 / finiteCellMass (finiteProductWeight (physicalLabelLaw (P := fun i : B => P i.val.1)
          (fun i => V i.val.1)))
        (fun x => upperLogCell h (Real.log (∏ i, (x i).val : ℕ))) e : ℝ) : ℂ)) *
      ((starRingEnd ℂ) (primeProductCellCharacter (fun i : A => P i.val.1) h d χ
          (repeatedBigAuxSplitEquiv P A B hU hAB aux).1) *
        (starRingEnd ℂ) (primeProductCellCharacter (fun i : B => P i.val.1) h e ψ
          (repeatedBigAuxSplitEquiv P A B hU hAB aux).2)))
    (fun _ u => primeProductCellCharacter (fun i : B => P i.val.1) h e ψ
      (physicalSelectedPrimeRestriction A B B subset_union_right S hB u))
    (fun _ v => primeProductCellCharacter (fun i : A => P i.val.1) h d χ
      (physicalSelectedPrimeRestriction A B A subset_union_left S hA v))
  dsimp only at he
  simpa only [univ_unique, sum_singleton] using he

end Bounty
end

