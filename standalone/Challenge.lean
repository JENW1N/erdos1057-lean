section

/- Original sharp candidate sums reduce to actual truncated Mellin and allocation integrals. -/

open Finset Filter MeasureTheory Real

namespace Bounty

theorem exists_candidate_original_finite_mixed_mellin_reduction {c b q : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hq0 : 0 ≤ q) (hq1 : q < 1) (R : ℝ) (hR : 1 ≤ R) {r : ℕ} (hr : 6 ≤ r) :
    ∃ J : ℕ, ∀ jStar : ℕ, J < jStar → ∀ A D : ℝ,
      ∃ B : ℝ, 1 ≤ B ∧ ∃ K : ℝ, 0 < K ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (E : ℝ) (S : Finset ℕ) (F : ℕ → ℕ → ℂ),
        (∀ u ∈ S, 0 < u ∧ (u : ℝ) ≤ R*exp L) →
        arithmeticProductWindow 1 (exp L) ⊆ S →
        1 ≤ E → log E ≤ (1-b)*L →
        (∀ u, ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
        (∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors,
          ¬(∀ p ∈ m.primeFactors, exp (sqrt L) ≤ (p : ℝ)) → F u m = 0) →
        Integrable (candidateFiniteMixedMellinIntegrand c L q r jStar E B R S F) ∧
        ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
            (candidateCoefficient c L q r jStar u : ℂ)*∑ m ∈ (2*u+1).divisors, F u m) -
          (∫ ν in {ν : ℝ | ‖ν‖ ≤ L^K},
            candidateFiniteMixedMellinIntegrand c L q r jStar E B R S F ν)‖ ≤ exp L*L^(-D) := by
  obtain ⟨J,hJ⟩ := exists_candidate_original_finite_mellin_reduction hc hb hq0 hq1 R hR hr
  refine ⟨J,fun jStar hj A D => ?_⟩
  obtain ⟨B,hB,K,hK,hbound⟩ := hJ jStar hj A D
  refine ⟨B,hB,K,hK,?_⟩
  filter_upwards [hbound, eventually_candidate_finite_mixed_mellin_eq hc] with L hL heq
  intro E S F hS hSW hE hlogE hF hsupp
  have h := hL E S F hS hSW hE hlogE hF hsupp
  have he : candidateFiniteMellinIntegrand c L q r jStar E B S F =
      candidateFiniteMixedMellinIntegrand c L q r jStar E B R S F :=
    funext (heq q r jStar E B R S F hS)
  rwa [he] at h

end Bounty
