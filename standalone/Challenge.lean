theorem extend_complex_character {G : Type*} [CommGroup G] [Finite G]
    (H : Subgroup G) (χ : H →* ℂ) :
    ∃ ξ : G →* ℂ, ∀ h : H, ξ h = χ h := by
  obtain ⟨ξ, hξ⟩ := MonoidHom.domRestrict_surjective ℂ H χ.toHomUnits
  refine ⟨(Units.coeHom ℂ).comp ξ, ?_⟩
  intro h
  have heq := DFunLike.congr_fun hξ h
  exact congrArg (fun z : ℂˣ => (z : ℂ)) heq
end

