theorem candidate_Q_weight_le_roughDivisors_of_present {c L : ℝ} {r jStar : ℕ}
    (hcL : 0 ≤ c * L) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (hband : (candidateQBand (c * L) jStar).Nonempty)
    {n : ℕ} (hn : n ≠ 0) :
    candidateQWeight c L r jStar n ≤
      ((roughDivisors (Real.exp (Real.sqrt L)) n).card : ℝ) := by
  classical
  obtain ⟨q0, hq0⟩ := hband
  let P := fun j : candidateQIndices c L => candidateQBand (c * L) j.val
  let R := candidateRoughBand c L jStar
  let e := candidateRoughSlot c L r jStar hr hj
  have heq : candidateQSlotChoices c L r jStar = oneExceptionPrimeChoices P R e := by
    exact candidate_Q_choices_eq_single_rough c L r jStar hr hj
  have h := one_exception_ordered_slot_weight_le P R r e
    (fun _ _ hp => (mem_filter.mp hp).2) (candidate_Q_group_disjoint hcL)
    (fun _ hd => (roughBand_pos hd).ne') q0 hq0 n
  rw [candidateQWeight, heq]
  have h' : orderedSlotWeight (oneExceptionPrimeChoices P R e)
      ((r.factorial : ℝ)^(candidateQIndices c L).card) n ≤
        ((R.filter (fun d => d ∣ n)).card : ℝ) := by
    simpa only [Fintype.card_coe] using h
  refine h'.trans ?_
  exact Nat.cast_le.mpr (roughBand_divisor_filter_card_le hn)

theorem eventually_candidate_Q_weight_le_roughDivisors {c : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar n : ℕ,
      candidateQWeight c L r jStar n ≤ ((roughDivisors (Real.exp (Real.sqrt L)) n).card : ℝ) := by
  filter_upwards [eventually_candidateQBand_nonempty hc, eventually_ge_atTop (0 : ℝ)] with L hb hL
  intro jStar n
  by_cases hn : n = 0
  · subst n
    rw [candidate_Q_weight_zero_at_zero]
    positivity
  · by_cases hj : jStar ∈ candidateQIndices c L
    · exact candidate_Q_weight_le_roughDivisors_of_present (mul_nonneg hc.le hL) hr hj (hb jStar hj) hn
    · exact (candidate_Q_weight_le_one_of_rough_absent (mul_nonneg hc.le hL) hj n).trans
        (by exact_mod_cast one_le_roughDivisors_card (Real.exp (Real.sqrt L)) hn)

theorem eventually_candidate_Q_weight_le_divisors {c : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar n : ℕ,
      candidateQWeight c L r jStar n ≤ (n.divisors.card : ℝ) := by
  filter_upwards [eventually_candidate_Q_weight_le_roughDivisors hc hr] with L hL
  intro jStar n
  refine (hL jStar n).trans ?_
  exact_mod_cast card_filter_le n.divisors (fun d => ∀ p ∈ d.primeFactors, Real.exp (Real.sqrt L) ≤ (p : ℝ))

theorem wide_window_nat_le_exp_twice {L : ℝ} (hL : Real.log 16 ≤ L)
    {n : ℕ} (hn : (n : ℝ) ≤ 16 * Real.exp L) : (n : ℝ) ≤ Real.exp (2 * L) := by
  have h16 : (16 : ℝ) ≤ Real.exp L :=
    (Real.log_le_iff_le_exp (by norm_num : (0 : ℝ) < 16)).mp hL
  calc
    _ ≤ 16 * Real.exp L := hn
    _ ≤ Real.exp L * Real.exp L := mul_le_mul_of_nonneg_right h16 (Real.exp_pos _).le
    _ = Real.exp (2 * L) := by rw [← Real.exp_add]; congr 1; ring

theorem eventually_candidate_Q_weight_le_exp_sqrt {c : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar n : ℕ, (n : ℝ) ≤ 16 * Real.exp L →
      candidateQWeight c L r jStar n ≤ Real.exp ((2 * Real.log 2) * Real.sqrt L) := by
  filter_upwards [eventually_candidate_Q_weight_le_roughDivisors hc hr,
    eventually_ge_atTop (Real.log 16), eventually_gt_atTop (0 : ℝ)] with L hq hlarge hL
  intro jStar n hn
  by_cases hn0 : n = 0
  · subst n
    rw [candidate_Q_weight_zero_at_zero]
    exact (Real.exp_pos _).le
  · exact (hq jStar n).trans (roughDivisors_card_le_exp_sqrt hL hn0 (wide_window_nat_le_exp_twice hlarge hn))
end

