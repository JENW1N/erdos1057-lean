section

/- Function maps such as zero extension intertwine finite row compositions. -/

namespace Bounty

theorem finite_row_composition_test_maps {S T : Nat → Type*} {V : Type*}
    (rowS : (i : Nat) → (S (i + 1) → V) → S i → V)
    (rowT : (i : Nat) → (T (i + 1) → V) → T i → V)
    (map : (i : Nat) → (T i → V) → S i → V) (n : Nat)
    (hrow : ∀ i, i < n → ∀ F, map i (rowT i F) = rowS i (map (i + 1) F))
    (F : T n → V) :
    map 0 (finiteRowComposition rowT n F) = finiteRowComposition rowS n (map n F) := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [finite_row_composition_succ, finite_row_composition_succ,
        ← hrow n (Nat.lt_succ_self n)]
      exact ih (fun i hi => hrow i (Nat.lt_trans hi (Nat.lt_succ_self n))) (rowT n F)

