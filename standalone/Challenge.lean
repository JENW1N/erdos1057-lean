theorem finite_coordinate_average_of_independent {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (i : I) (hmass : ∑ y, μ i y = 1) (h : (∀ j, X j) → ℂ)
    (hi : ∀ x y, h (Function.update x i y) = h x) :
    finiteCoordinateAverage μ i h = h := by
  funext x
  rw [finite_coordinate_average_update]
  simp_rw [hi]
  rw [← sum_mul]
  have hm : (∑ y, (μ i y : ℂ)) = 1 := by exact_mod_cast hmass
  rw [hm, one_mul]

