/- Exact product separation for the actual harmonic Mellin weight. -/

namespace Bounty

theorem harmonic_mellin_weight_mul (v : ℝ) {s t : ℝ} (hs : 0 < s) (ht : 0 < t) :
    harmonicMellinWeight v (s*t) = harmonicMellinWeight v s*harmonicMellinWeight v t := by
  have he : Complex.I*((v*Real.log (s*t) : ℝ) : ℂ) =
      Complex.I*((v*Real.log s : ℝ) : ℂ)+Complex.I*((v*Real.log t : ℝ) : ℂ) := by
    rw [Real.log_mul hs.ne' ht.ne']
    push_cast
    ring
  unfold harmonicMellinWeight
  rw [he, Complex.exp_add]
  simp only [Complex.ofReal_mul]
  ring

end Bounty
