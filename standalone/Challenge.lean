variable
  {I : Type*}
  [sharedInstance1 : Fintype I]
  [sharedInstance2 : DecidableEq I]
  {X : I → Type*}
  [sharedInstance4 : ∀ i, Fintype (X i)]
  (μ : ∀ i, X i → ℝ)
  (U V : Finset I)
  (w : (∀ i, X i) → ℝ)

include I sharedInstance1 sharedInstance2 X sharedInstance4 μ U V w

theorem clean_raw_component_pairing_sum  (k f g : (∀ i, X i) → ℂ) :
    (∑ S ∈ U.powerset, ∑ T ∈ V.powerset,
      cleanRawPairing w k (finiteCoordinateComponent μ S U.toList f)
        (finiteCoordinateComponent μ T V.toList g)) = cleanRawPairing w k f g := by
  simp_rw [← clean_raw_pairing_sum_right, clean_component_sum]
  rw [← clean_raw_pairing_sum_left, clean_component_sum]

theorem clean_kernel_component_pairing_sum  (K : (∀ i, X i) → (∀ i, X i) → ℂ)
    (f g : (∀ i, X i) → ℂ) :
    (∑ S ∈ U.powerset, ∑ T ∈ V.powerset,
      cleanKernelPairing w K (finiteCoordinateComponent μ S U.toList f)
        (finiteCoordinateComponent μ T V.toList g)) = cleanKernelPairing w K f g := by
  simp_rw [← clean_kernel_pairing_sum_right, clean_component_sum]
  rw [← clean_kernel_pairing_sum_left, clean_component_sum]

theorem clean_raw_component_exceptional_pairing  (k f g : (∀ i, X i) → ℂ) :
    (∑ T ∈ V.powerset,
      cleanRawPairing w k (finiteCoordinateComponent μ U U.toList f)
        (finiteCoordinateComponent μ T V.toList g)) +
      (∑ S ∈ U.powerset.erase U,
        cleanRawPairing w k (finiteCoordinateComponent μ S U.toList f)
          (finiteCoordinateComponent μ V V.toList g)) =
      cleanRawPairing w k (finiteCoordinateComponent μ U U.toList f) g +
        cleanRawPairing w k (f - finiteCoordinateComponent μ U U.toList f)
          (finiteCoordinateComponent μ V V.toList g) := by
  rw [← clean_raw_pairing_sum_right, clean_component_sum,
    ← clean_raw_pairing_sum_left, clean_component_erase_sum]

end

