theorem physical_planned_small_update_transport
    (tag : Option (V ⊕ PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K)))
    (r : PhysicalResidues Ps)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : PhysicalPlannedResidueEvent n shared B A Δ D tag x) :
    physicalPlannedSmallUpdate n shared B A Δ' D' kbig tag r x
        (physicalPlannedParameterEventEquiv n shared B A Δ Δ' D D' hΔ hD tag x e) =
      physicalPlannedSmallUpdate n shared B A Δ D kbig tag r x e := by
  cases tag with
  | none => rfl
  | some tag =>
    cases tag with
    | inl v => rfl
    | inr key =>
      dsimp only [physicalPlannedSmallUpdate, physicalPlannedParameterEventEquiv,
        fullPermutationParameterEventEquiv]
      erw [full_active_parameter_auxiliary]

theorem physical_planned_small_phase_transport
    (Vs : S → ℝ) (qedge : K → ℝ)
    (tag : Option (V ⊕ PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K)))
    (r : PhysicalResidues Ps)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : PhysicalPlannedResidueEvent n shared B A Δ D tag x) :
    physicalPlannedSmallPhase n shared B A Δ' D' kbig Vs qedge tag r x
        (physicalPlannedParameterEventEquiv n shared B A Δ Δ' D D' hΔ hD tag x e) =
      physicalPlannedSmallPhase n shared B A Δ D kbig Vs qedge tag r x e := by
  cases tag with
  | none => rfl
  | some tag =>
    cases tag with
    | inl v => rfl
    | inr key =>
      dsimp only [physicalPlannedSmallPhase]
      rw [physical_planned_small_update_transport]

theorem physical_planned_small_ledger_transport
    (Vs : S → ℝ) (qedge : K → ℝ)
    (steps : List (Option (V ⊕ PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K))))
    (r : PhysicalResidues Ps)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FiniteEventPath (PhysicalPlannedResidueEvent n shared B A Δ D)
      (physicalPlannedResidueTarget n shared B A Δ D) steps x) :
    deterministicLedgerPhase (PhysicalPlannedResidueEvent n shared B A Δ' D')
        (physicalPlannedResidueTarget n shared B A Δ' D')
        (physicalPlannedSmallUpdate n shared B A Δ' D' kbig)
        (physicalPlannedSmallPhase n shared B A Δ' D' kbig Vs qedge) steps r x
        (physicalPlannedParameterPathEquiv n shared B A Δ Δ' D D' hΔ hD steps x p) =
      deterministicLedgerPhase (PhysicalPlannedResidueEvent n shared B A Δ D)
        (physicalPlannedResidueTarget n shared B A Δ D)
        (physicalPlannedSmallUpdate n shared B A Δ D kbig)
        (physicalPlannedSmallPhase n shared B A Δ D kbig Vs qedge) steps r x p := by
  exact deterministic_ledger_phase_equiv _ _ _ _ id _ _ _ _
    (physical_planned_small_update_transport n shared B A Δ Δ' D D' hΔ hD kbig)
    _ _ (physical_planned_small_phase_transport n shared B A Δ Δ' D D' hΔ hD kbig Vs qedge)
    steps r x p

theorem physical_mixed_plan_small_factor_transport
    (Vs : S → ℝ) (qedge : K → ℝ)
    (ks : List (Option (V ⊕ K))) (r : PhysicalResidues Ps) (L : PhysicalMarkLists Ps J ell)
    (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks)
