open Finset
def finitePartitionEquiv {I J : Type*} [Fintype I] [Fintype J]
    [DecidableEq I] [DecidableEq J] (S : Finset I) (T : Finset J)
    (left : S ≃ T) (right : ↥(Sᶜ) ≃ ↥(Tᶜ)) : I ≃ J where
  toFun x := if hx : x ∈ S then (left ⟨x, hx⟩).val
    else (right ⟨x, mem_compl.mpr hx⟩).val
  invFun y := if hy : y ∈ T then (left.symm ⟨y, hy⟩).val
    else (right.symm ⟨y, mem_compl.mpr hy⟩).val
  left_inv x := by
    by_cases hx : x ∈ S
    · simp only [dif_pos hx]
      have hy := (left ⟨x, hx⟩).property
      rw [dif_pos hy]
      exact congrArg Subtype.val (left.symm_apply_apply ⟨x, hx⟩)
    · simp only [dif_neg hx]
      have hy := mem_compl.mp (right ⟨x, mem_compl.mpr hx⟩).property
      rw [dif_neg hy]
      exact congrArg Subtype.val (right.symm_apply_apply ⟨x, mem_compl.mpr hx⟩)
  right_inv y := by
    by_cases hy : y ∈ T
    · simp only [dif_pos hy]
      have hx := (left.symm ⟨y, hy⟩).property
      rw [dif_pos hx]
      exact congrArg Subtype.val (left.apply_symm_apply ⟨y, hy⟩)
    · simp only [dif_neg hy]
      have hx := mem_compl.mp (right.symm ⟨y, mem_compl.mpr hy⟩).property
      rw [dif_neg hx]
      exact congrArg Subtype.val (right.apply_symm_apply ⟨y, mem_compl.mpr hy⟩)

