theorem bounded_primitive_contains {q Q : ℕ} (hq : 0 < q) (hqQ : q ≤ Q)
    (χ : DirichletCharacter ℂ q) (hχ : χ.IsPrimitive) :
    ∃ t : BoundedPrimitiveCharacter Q, boundedPrimitiveModulus t = q ∧
      ∀ n : ℕ, boundedPrimitiveValue t (n : ZMod (boundedPrimitiveModulus t)) = χ (n : ZMod q) := by
  cases q with
  | zero => omega
  | succ k =>
    refine ⟨⟨⟨⟨k, by omega⟩, χ⟩, hχ⟩, rfl, ?_⟩
    intro n
    rfl

theorem bounded_primitive_inducing {q Q : ℕ} (hq : 0 < q) (hqQ : q ≤ Q)
    (χ : DirichletCharacter ℂ q) :
    ∃ t : BoundedPrimitiveCharacter Q, boundedPrimitiveModulus t ≤ q ∧
      ∀ n : ℕ, n.Coprime q →
        boundedPrimitiveValue t (n : ZMod (boundedPrimitiveModulus t)) = χ (n : ZMod q) := by
  let : NeZero q := ⟨Nat.ne_of_gt hq⟩
  have hc : 0 < χ.conductor := Nat.pos_of_ne_zero χ.conductor_ne_zero
  have hcq : χ.conductor ≤ q := Nat.le_of_dvd hq χ.conductor_dvd_level
  obtain ⟨t, ht, heval⟩ := bounded_primitive_contains hc (hcq.trans hqQ)
    χ.primitiveCharacter χ.primitiveCharacter_isPrimitive
  refine ⟨t, ht ▸ hcq, ?_⟩
  intro n hn
  rw [heval]
  simpa only [Int.cast_natCast] using
    χ.primitiveCharacter_apply_of_isCoprime (Nat.isCoprime_iff_coprime.mpr hn)
end

