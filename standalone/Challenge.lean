section

/- A cofactor-first form of the least-prime-factor decomposition, including repeated primes. -/

open Finset

namespace Bounty

theorem buchstab_cofactors_as_rough_band {U V z : ℝ} (hU : 1 ≤ U) (hV : 0 ≤ V)
    {p : ℕ} (hp : p.Prime) (hpz : z < (p : ℝ)) :
    buchstabCompositeCofactors (roughBand U V z) ⌊V⌋₊ p =
      (roughBand 1 V z).filter (fun m => p ≤ m.minFac ∧ U < ((p*m : ℕ) : ℝ) ∧ ((p*m : ℕ) : ℝ) ≤ V) := by
  classical
  ext m
  constructor
  · intro hm
    obtain ⟨hmI, hmS, hmorder⟩ := mem_filter.mp hm
    have hpm : p ≤ m := (mem_Icc.mp hmI).1
    have hm0 : m ≠ 0 := (hp.pos.trans_le hpm).ne'
    have hm1 : m ≠ 1 := by have := hp.two_le.trans hpm; omega
    have hmrough : ∀ q ∈ m.primeFactors, z < (q : ℝ) := by
      intro q hq
      apply (mem_filter.mp hmS).2 q
      exact Nat.mem_primeFactors.mpr ⟨Nat.prime_of_mem_primeFactors hq,
        (Nat.dvd_of_mem_primeFactors hq).trans (dvd_mul_left m p),
        Nat.mul_ne_zero hp.ne_zero hm0⟩
    have hmR : m ∈ roughBand 1 V z := mem_filter.mpr
      ⟨mem_Ioc.mpr ⟨by simpa only [Nat.floor_one] using (show 1 < m by have := hp.two_le.trans hpm; omega),
        (mem_Icc.mp hmI).2⟩, hmrough⟩
    have hmin : p ≤ m.minFac := hmorder m.minFac
      (Nat.mem_primeFactors.mpr ⟨Nat.minFac_prime hm1, Nat.minFac_dvd m, hm0⟩)
    exact mem_filter.mpr ⟨hmR, hmin,
      Nat.lt_of_floor_lt (mem_Ioc.mp (mem_filter.mp hmS).1).1,
      (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hmS).1).2).trans (Nat.floor_le hV)⟩
  · intro hm
    obtain ⟨hmR, hmin, hprodlo, hprodhi⟩ := mem_filter.mp hm
    have hm0 : m ≠ 0 := (roughBand_pos hmR).ne'
    have hmrough := (mem_filter.mp hmR).2
    have hpm : p ≤ m := hmin.trans (Nat.minFac_le (roughBand_pos hmR))
    have hprodrough : ∀ q ∈ (p*m).primeFactors, z < (q : ℝ) := by
      intro q hq
      rw [Nat.primeFactors_mul hp.ne_zero hm0, hp.primeFactors] at hq
      rcases mem_union.mp hq with hqp | hqm
      · simpa only [mem_singleton.mp hqp] using hpz
      · exact hmrough q hqm
    have hprod : p*m ∈ roughBand U V z := mem_filter.mpr
      ⟨mem_Ioc.mpr ⟨(Nat.floor_lt (by linarith : 0 ≤ U)).mpr hprodlo,
        Nat.le_floor hprodhi⟩, hprodrough⟩
    apply mem_filter.mpr
    refine ⟨mem_Icc.mpr ⟨hpm, (mem_Ioc.mp (mem_filter.mp hmR).1).2⟩, hprod, ?_⟩
    intro q hq
    exact hmin.trans (Nat.minFac_le_of_dvd (Nat.prime_of_mem_primeFactors hq).two_le
      (Nat.dvd_of_mem_primeFactors hq))

theorem prime_part_of_rough_band {U V z : ℝ} (hU : 0 ≤ U) (hV : 0 ≤ V) :
    (roughBand U V z).filter Nat.Prime = primeBand (max U z) V := by
  classical
  ext p
  simp only [mem_filter, roughBand, mem_Ioc, Nat.floor_lt hU, Nat.le_floor_iff hV,
    mem_primeBand_iff (hU.trans (le_max_left _ _)) hV, max_lt_iff]
  constructor
  · rintro ⟨⟨⟨hUp, hpV⟩, hrough⟩, hp⟩
    have hpz : z < (p : ℝ) := hrough p (by rw [hp.primeFactors]; exact mem_singleton_self _)
    exact ⟨hp, ⟨hUp, hpz⟩, hpV⟩
  · rintro ⟨hp, ⟨hUp, hpz⟩, hpV⟩
    refine ⟨⟨⟨hUp, hpV⟩, ?_⟩, hp⟩
    intro q hq
    rw [hp.primeFactors] at hq
    simpa only [mem_singleton.mp hq] using hpz

end Bounty
end

