      have hr := endpoint_triple_dyadic_representation (Icc 1 ⌊16*(UA*UB*UC)⌋₊) A B C
        (fun n => if n ∈ A then α n else 0) (fun n => if n ∈ B then β n else 0)
        (fun n => if n ∈ C then γ n else 0) hApos hBpos hCpos
        (by intro n hn; exact if_neg hn) (by intro n hn; exact if_neg hn) (by intro n hn; exact if_neg hn)
