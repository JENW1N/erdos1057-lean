section

/- Square energy of central window averages with an arbitrary base frequency. -/

open Finset MeasureTheory

namespace Bounty

theorem harmonic_window_truncated_square (a b Y R w : ℝ) {P : ℝ → ℂ} {M E : ℝ}
    (hP : Continuous P) (hM : 0 ≤ M) (hPM : ∀ s, ‖P s‖ ≤ M)
    (hE : ∀ u, ‖u‖ ≤ R → (∫ s in Set.Icc a b, ‖P (s+w+2*Real.pi*u)‖^2) ≤ E) :
    IntegrableOn (fun s => ‖∫ u in {u : ℝ | ‖u‖ ≤ R},
      harmonicWindowLogFourier u * physicalMellinPhase (-2*Real.pi*u) Y *
        P (s+w+2*Real.pi*u)‖^2) (Set.Icc a b) ∧
    (∫ s in Set.Icc a b, ‖∫ u in {u : ℝ | ‖u‖ ≤ R},
      harmonicWindowLogFourier u * physicalMellinPhase (-2*Real.pi*u) Y *
        P (s+w+2*Real.pi*u)‖^2) ≤
      (∫ u in {u : ℝ | ‖u‖ ≤ R}, ‖harmonicWindowLogFourier u‖)^2 * E := by
  have hκc : Continuous (fun u => harmonicWindowLogFourier u *
      physicalMellinPhase (-2*Real.pi*u) Y) := by
    apply harmonicWindowLogFourier.continuous.mul
    unfold physicalMellinPhase
    fun_prop
  have hκi := physical_mellin_phase_integrable harmonicWindowLogFourier
    (fun u => -2*Real.pi*u) harmonic_window_log_fourier_integrable (by fun_prop) Y
  have hs : MeasurableSet {u : ℝ | ‖u‖ ≤ R} :=
    (isClosed_le continuous_norm continuous_const).measurableSet
  have hEA : ∀ᵐ u ∂(volume.restrict {u : ℝ | ‖u‖ ≤ R}),
      (∫ s in Set.Icc a b, ‖P ((s+2*Real.pi*u)+w)‖^2) ≤ E := by
    filter_upwards [ae_restrict_mem hs] with u hu
    simpa only [add_right_comm] using hE u hu
  have hPc : Continuous (fun s => P (s+w)) := hP.comp (continuous_id.add continuous_const)
  have ht := integrated_translate_average_square_ae (volume.restrict (Set.Icc a b))
    (volume.restrict {u : ℝ | ‖u‖ ≤ R}) (2*Real.pi) hκc hκi.integrableOn
    hPc hM (fun s => hPM (s+w)) hEA
  simpa only [IntegrableOn,norm_mul,physical_mellin_phase_norm,mul_one,add_right_comm] using ht

theorem harmonic_normalized_four_box_truncated_energy
    (a b Y R E w : ℝ) (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c)
    (henergy : ∀ u, ‖u‖ ≤ R → (∫ s in Set.Icc a b,
      ‖(∑ d ∈ D, δ d * harmonicMellinWeight (s+w+2*Real.pi*u) d) *
        (∑ a ∈ A, α a * harmonicMellinWeight (s+w+2*Real.pi*u) a) *
        (∑ b ∈ B, β b * harmonicMellinWeight (s+w+2*Real.pi*u) b) *
        (∑ c ∈ C, γ c * harmonicMellinWeight (s+w+2*Real.pi*u) c)‖^2) ≤ E) :
    let Q := fun s => ∫ u in {u : ℝ | ‖u‖ ≤ R},
      harmonicWindowLogFourier u * physicalMellinPhase (-2*Real.pi*u) Y *
        ((∑ d ∈ D, δ d * harmonicMellinWeight (s+w+2*Real.pi*u) d) *
          (∑ a ∈ A, α a * harmonicMellinWeight (s+w+2*Real.pi*u) a) *
          (∑ b ∈ B, β b * harmonicMellinWeight (s+w+2*Real.pi*u) b) *
          (∑ c ∈ C, γ c * harmonicMellinWeight (s+w+2*Real.pi*u) c))
    IntegrableOn (fun s => ‖Q s‖^2) (Set.Icc a b) ∧
      (∫ s in Set.Icc a b, ‖Q s‖^2) ≤
        (∫ u in {u : ℝ | ‖u‖ ≤ R}, ‖harmonicWindowLogFourier u‖)^2 * E := by
  let P : ℝ → ℂ := fun s =>
    (∑ d ∈ D, δ d * harmonicMellinWeight s d) *
      (∑ a ∈ A, α a * harmonicMellinWeight s a) *
      (∑ b ∈ B, β b * harmonicMellinWeight s b) *
      (∑ c ∈ C, γ c * harmonicMellinWeight s c)
  let M : ℝ := (∑ d ∈ D, ‖δ d‖) * (∑ a ∈ A, ‖α a‖) *
    (∑ b ∈ B, ‖β b‖) * (∑ c ∈ C, ‖γ c‖)
  have hc (S : Finset ℕ) (f : ℕ → ℂ) :
      Continuous (fun s : ℝ => ∑ n ∈ S, f n * harmonicMellinWeight s n) := by
    unfold harmonicMellinWeight
    fun_prop
  have hP : Continuous P := ((hc D δ).mul (hc A α)).mul (hc B β) |>.mul (hc C γ)
  have hPM (s : ℝ) : ‖P s‖ ≤ M := by
    have hb (S : Finset ℕ) (f : ℕ → ℂ) (hS : ∀ n ∈ S, 0 < n) :
        ‖∑ n ∈ S, f n * harmonicMellinWeight s n‖ ≤ ∑ n ∈ S, ‖f n‖ := by
      simpa only [mul_comm,div_one] using finite_mellin_norm_le_mass S f s 1
        zero_lt_one (fun n hn => by exact_mod_cast (Nat.succ_le_iff.mpr (hS n hn)))
    dsimp only [P,M]
    simp only [norm_mul]
    exact mul_le_mul (mul_le_mul (mul_le_mul (hb D δ hD) (hb A α hA)
      (norm_nonneg _) (by positivity)) (hb B β hB) (norm_nonneg _) (by positivity))
      (hb C γ hC) (norm_nonneg _) (by positivity)
  have ht := harmonic_window_truncated_square a b Y R w hP
    (show 0 ≤ M by dsimp [M]; positivity) hPM henergy
  exact ht

end Bounty
end

section

/- The exact harmonic source inherits retained-box Mellin energy estimates. -/

open Finset Filter MeasureTheory
namespace Bounty

noncomputable def commonSourceBoxKernel (Y a v c t : ℝ) (n : ℕ) : ℂ :=
  (harmonicCommonCutoff ((n : ℝ)/Y) : ℂ) / (n : ℂ) *
    (physicalMellinPhase (t-a-v) n * Complex.exp (Complex.I * (2*Real.pi*(c*n) : ℝ)))

theorem eventually_common_source_mellin_of_boxes :
    ∀ᶠ L : ℝ in atTop, ∀ (μ : Measure ℝ) (Y Z a v c : ℝ),
      1 ≤ Y → Real.log Y ≤ 6*L → 0 < Z →
      ∀ (F : ℤ → ℂ) (δ α β γ : ℕ → ℂ),
      (∀ n ∈ (harmonicCommonSupport Y).image Int.natAbs,
        F n = endpointFourConvolution δ α β γ n) →
      ∀ E : ℝ, 0 ≤ E →
      let S := (harmonicCommonSupport Y).image Int.natAbs
      let N := ⌈4*Real.exp 2*Y⌉₊
      (∀ i ∈ dyadicNatIndices (Icc 1 N), ∀ j ∈ dyadicNatIndices (Icc 1 N),
        ∀ k ∈ dyadicNatIndices (Icc 1 N), ∀ l ∈ dyadicNatIndices (Icc 1 N),
        retainedFourDyadicBox S N i j k l →
        Integrable (fun t => ‖fourDyadicBoxSum N δ α β γ
          (commonSourceBoxKernel Y a v c t) i j k l‖ ^ 2) μ) →
      (∀ i ∈ dyadicNatIndices (Icc 1 N), ∀ j ∈ dyadicNatIndices (Icc 1 N),
        ∀ k ∈ dyadicNatIndices (Icc 1 N), ∀ l ∈ dyadicNatIndices (Icc 1 N),
        retainedFourDyadicBox S N i j k l →
        (∫ t, ‖fourDyadicBoxSum N δ α β γ (commonSourceBoxKernel Y a v c t) i j k l‖ ^ 2 ∂μ) ≤ E) →
      (∫ t, ‖localMellinPolynomial S
        (fun n => harmonicCellSource Y Z a v F n * fourier (n : ℤ) (c : AddCircle (1 : ℝ))) t‖ ^ 2 ∂μ)
        ≤ Y ^ 2 * (L ^ 9 * E) := by
  filter_upwards [eventually_harmonic_four_dyadic_energy (Ω := ℝ)] with L hboxes
  intro μ Y Z a v c hY hlog hZ F δ α β γ hF E hE0 S N hf hE
  have hYp : 0 < Y := by linarith
  have hb := hboxes μ Y hY hlog δ α β γ
    (fun t n => physicalMellinPhase (t-a-v) n * Complex.exp (Complex.I * (2*Real.pi*(c*n) : ℝ)))
    E hE0 hf hE
  have heq (t : ℝ) :
      (∑ n ∈ S, F n * ((harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)/(n : ℂ)) *
        physicalMellinPhase (t-a-v) n * Complex.exp (Complex.I * (2*Real.pi*(c*n) : ℝ))) =
      ∑ n ∈ S, endpointFourConvolution δ α β γ n * commonSourceBoxKernel Y a v c t n := by
    apply sum_congr rfl
    intro n hn
    rw [hF n hn]
    unfold commonSourceBoxKernel
    ring
  rw [common_source_mellin_energy μ hYp hZ a v c F]
  change Y ^ 2 * (∫ t, ‖∑ n ∈ S, F n * ((harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)/(n : ℂ)) *
    physicalMellinPhase (t-a-v) n * Complex.exp (Complex.I * (2*Real.pi*(c*n) : ℝ))‖ ^ 2 ∂μ) ≤ _
  simp_rw [heq]
  exact mul_le_mul_of_nonneg_left hb (sq_nonneg Y)

end Bounty
end

section

/- Radius-generalized companion; only the separate R <= exp L assumption is removed.
 The actual ambient prime discrepancy discharges the last analytic low-factor premise. -/

open Finset Filter MeasureTheory

namespace Bounty

theorem exists_ambient_prime_four_factor_integral_decay_log_radius
    (hZ : PrimitiveZeroFreeHalfPlane)
    {a beta c d Bcoeff A As H Et aLong : ℝ}
    (ha : 0 < a) (ha1 : a ≤ 1) (hbeta : beta < 1) (hc : 0 ≤ c) (hd : 0 < d)
    (hBcoeff : 1 ≤ Bcoeff) (hAs0 : 0 ≤ As) (haLong : 0 < aLong)
    (hAs : A+2*Et+21 ≤ 2*As) (hH : A+2*Et+23 ≤ 2*H)
    (Tmod Sshift Cmod Sfreq : ℝ) :
    ∃ B0 : ℝ, 0 < B0 ∧ ∀ Bsave : ℝ, A+B0+2*Et+7 ≤ 2*Bsave →
      ∀ S : ℝ, 0 ≤ S → max (max B0 Sfreq) Cmod+Bsave+5 ≤ S →
      ∀ᶠ L : ℝ in atTop, ∀ (s : Finset ℕ), (∀ p ∈ s, Nat.Prime p) →
      ∀ (coeff : s → ℂ) (Y P R : ℝ),
      1 ≤ Y → d*L ≤ Real.log Y → Real.log Y ≤ c*L →
      Real.exp (L^a)/2 ≤ P → P ≤ Real.exp (L^beta) →
      0 ≤ R → R ≤ Y →
      (∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2*P) →
      (∀ p : s, ‖coeff p‖ ≤ Bcoeff) →
      ∀ (lo hi : ℕ) (F : Finset ℕ) (γT : ℕ → ℂ) (UM UT BT : ℝ),
      0 < UM → 1 ≤ UT → 0 ≤ BT → BT ≤ L^Et →
      (∀ n ∈ F, ‖γT n‖ ≤ BT) →
      (∀ n ∈ Ioc lo hi, UM ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*UM) →
      (∀ n ∈ F, UT ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*UT) →
      ∀ (κM ν : ℝ) (qM : ℕ) [NeZero qM] (χM : DirichletCharacter ℂ qM),
      0 ≤ κM → κM ≤ 1/50 → (qM : ℝ) ≤ L^Cmod → |ν| ≤ L^Sfreq →
      ∀ (UQ Alo Blo σ : ℝ) (q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
      Real.exp (aLong*L) ≤ UQ → UQ ≤ Alo → Alo ≤ Blo → Blo ≤ 2*UQ →
      (q : ℝ) ≤ L^Tmod → |σ| ≤ L^Sshift →
      R ≤ UQ*UM*UT/2 → Y^(3/5 : ℝ) ≤ UM*UT/2 → Real.log (8*(UQ*UM*UT)) ≤ c*L →
      (∫ u in Set.Icc (-R) R,
        ‖primeReciprocalPolynomial s coeff u *
          (∑ n ∈ roughBand Alo Blo (Real.exp (Real.sqrt L)), harmonicMellinWeight (u+σ) n*χ (n : ZMod q))*
          (∑ n ∈ Ioc lo hi, ambientPrimeMellinCoefficient κM L S ν χM n*harmonicMellinWeight u n)*
          (∑ n ∈ F, γT n*harmonicMellinWeight u n)‖^2) ≤ L^(-A) := by
  obtain ⟨B0,hB0,hmain⟩ := exists_literal_four_factor_integral_decay_log_radius
    (E := Et) ha ha1 hbeta hc hd hBcoeff hAs0 haLong hAs hH Tmod Sshift
  refine ⟨B0,hB0,?_⟩
  intro Bsave hsave S hS hprecision
  filter_upwards [hmain Bsave hsave,
    eventually_ambient_prime_mellin_low_factor hZ hS hB0.le hprecision]
    with L hdecay hlow
  intro s hs coeff Y P R hY hYlo hYhi hPlo hPhi hR hRY hsp hcoeff
    lo hi F γT UM UT BT hUM hUT hBT hBTpow hγT hMband hFband
    κM ν qM hqMInst χM hκ hκmax hqM hν UQ Alo Blo σ q hqInst χ hUQ hQA hAB hBQ hq hσ
    hmeanScale hresScale hlog
  have hM := hlow κM hκ hκmax qM χM hqM ν hν
  apply hdecay s hs coeff Y P R hY hYlo hYhi hPlo hPhi hR hRY hsp hcoeff
    (Ioc lo hi) F (ambientPrimeMellinCoefficient κM L S ν χM) γT
    UM UT 1 BT hUM hUT zero_le_one hBT (by simpa only [one_mul] using hBTpow) hBTpow
    (fun n hn => hM.1 n ((Nat.zero_le lo).trans_lt (mem_Ioc.mp hn).1))
    hγT hMband hFband UQ Alo Blo σ q χ hUQ hQA hAB hBQ hq hσ hmeanScale hresScale hlog
  intro u _ hu
  exact hM.2 u hu lo hi

end Bounty
end

