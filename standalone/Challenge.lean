lemma euclideanToHyperbolic_contMDiffAt (p : EuclideanSpatial) (hp : 0<p 2) :
  letI rootPolicy_complexSLTopology := @OAI.CubicEisenstein.complexSLTopology
  let : ChartedSpace SpatialCoordinates HyperbolicSpace := hyperbolicSpatialChartedSpace
  ContMDiffAt 𝓘(ℝ,EuclideanSpatial) 𝓘(ℝ,SpatialCoordinates) ∞ euclideanToHyperbolic p :=
