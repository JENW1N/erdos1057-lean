theorem eventually_physical_root_replacement_of_power_rows
    {a c d C V E γ D q : ℝ}
    (ha : 0 ≤ a) (hc : 0 < c) (hd : 0 < d) (had : a + d < 1)
    (hC : 0 < C) (hV : 0 < V) (hE : 0 ≤ E) (hγ : 0 < γ) (hD : 0 ≤ D)
    (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (J ell : ℕ) :
    ∀ᶠ T : ℝ in atTop, ∀ (G : Type) [Fintype G] [DecidableEq G]
      (P : G → Finset ℕ) [∀ p : PhysicalPrime P, NeZero p.2.val]
      (weights : G → ℝ) (I : Type) (patterns : Finset I)
      (slots : I → G → Finset (Fin J))
      (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
      (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (slots i) → ℂ)
      (r b N : ℕ) (z : ℤ),
      r + 1 = 2 * Nat.ceil (T^a) →
      Pairwise (fun g h => Disjoint (P g) (P h)) →
      (∀ g p, p ∈ P g → p.Prime) →
      (Fintype.card G : ℝ) ≤ C * Real.log T →
      (∀ g, 0 < weights g) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = weights g) →
      (∀ g, weights g ≤ V) →
      (∀ g p, p ∈ P g → Real.exp (T^c) ≤ (p : ℝ)) →
      (∀ g p, p ∈ P g → (p : ℝ) ≤ Real.exp (T^d)) →
      (∀ j < r + 1, physicalOperatorStepBound P J ell patterns slots (k j) ≤ b) →
      0 < N → γ * T ≤ Real.log (N : ℝ) →
      letI : Fintype (PhysicalEdgeLabels P J ell patterns slots) := inferInstance
      (∀ j (x : PhysicalBareResidueState P J ell),
        (∑ y : PhysicalBareResidueState P J ell, ∑ label : PhysicalEdgeLabels P J ell patterns slots,
          ‖physicalResidueLabeledCoeff weights patterns slots q (ζ j) (k j) (K j) label x y‖) ≤ T^D) →
      ‖physicalRootMoment weights patterns slots q ζ k K (Ico z (z + N)) r b -
        physicalRootResidueModel weights patterns slots q ζ k K r‖ ≤
        Real.exp (-E * (r + 1) * Real.log T) := by
  filter_upwards [eventually_physical_finite_vertex_replacement ha hc hd had hC hV
    (add_nonneg hE hD) hγ J ell, eventually_gt_atTop (0 : ℝ)] with T hreplace hT
  intro G _ _ P _ weights I patterns slots ζ k K r b N z hlen hP hprime hs
    hweights hMass hupper hmin hmax hbound hN hNb
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns slots) := inferInstance
  intro hrow
  apply physical_root_exponential_error hP hprime weights hweights hMass patterns slots
    hq0 ζ k K (Ico z (z + N)) r b hbound hT D E hrow
  intro L p
  have hp := hreplace G P I patterns slots k r hlen L p q N z hP hprime hs
    (fun g => (hMass g).trans_le (hupper g)) hmin hmax hq0 hq1 hN hNb
  simpa only [Int.card_Ico, add_sub_cancel_left, Int.toNat_natCast] using hp
end

section
open Filter Finset
theorem eventually_physical_root_replacement
    {a c d C V v E γ B q : ℝ}
    (ha : 0 ≤ a) (hc : 0 < c) (hd : 0 < d) (had : a + d < 1)
    (hC : 0 < C) (hV : 0 < V) (hv : 0 < v) (hE : 0 ≤ E)
    (hγ : 0 < γ) (hB : 0 ≤ B) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (J ell m : ℕ) :
    ∀ᶠ T : ℝ in atTop, ∀ (G : Type) [Fintype G] [DecidableEq G]
      (P : G → Finset ℕ) [∀ p : PhysicalPrime P, NeZero p.2.val]
      (weights : G → ℝ) (I : Type) (patterns : Finset I)
      (slots : I → G → Finset (Fin J)) (bounds : I → ℝ)
      (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
      (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (slots i) → ℂ)
      (r b N : ℕ) (z : ℤ),
      r + 1 = 2 * Nat.ceil (T^a) →
      Pairwise (fun g h => Disjoint (P g) (P h)) →
      (∀ g p, p ∈ P g → p.Prime) →
      (Fintype.card G : ℝ) ≤ C * Real.log T →
      (∀ g, v ≤ weights g) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = weights g) →
      (∀ g, weights g ≤ V) →
      (∀ g p, p ∈ P g → Real.exp (T^c) ≤ (p : ℝ)) →
      (∀ g p, p ∈ P g → (p : ℝ) ≤ Real.exp (T^d)) →
      (∀ i ∈ patterns, ∀ g, (slots i g).card ≤ m) →
      (∀ i ∈ patterns, 0 ≤ bounds i) → (∑ i ∈ patterns, bounds i) ≤ T^B →
      (∀ j i, i ∈ patterns → ∀ L R aux, ‖K j i L R aux‖ ≤ bounds i) →
      (∀ j < r + 1, physicalOperatorStepBound P J ell patterns slots (k j) ≤ b) →
      0 < N → γ * T ≤ Real.log (N : ℝ) →
      ‖physicalRootMoment weights patterns slots q ζ k K (Ico z (z + N)) r b -
        physicalRootResidueModel weights patterns slots q ζ k K r‖ ≤
        Real.exp (-E * (r + 1) * Real.log T) := by
  obtain ⟨D, hD, hrow⟩ := exists_physical_residue_operator_power_row_bound hq0 hq1 hv ell m hC.le hB
  filter_upwards [eventually_physical_root_replacement_of_power_rows ha hc hd had hC hV hE hγ hD
    hq0 hq1.le J ell, eventually_gt_atTop (0 : ℝ)] with T hreplace hT
  intro G _ _ P _ weights I patterns slots bounds ζ k K r b N z hlen hP hprime hs hlow
    hMass hupper hmin hmax hslots hbounds hsum hK hcut hN hNb
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns slots) := inferInstance
  apply hreplace G P weights I patterns slots ζ k K r b N z hlen hP hprime hs
    (fun g => hv.trans_le (hlow g)) hMass hupper hmin hmax hcut hN hNb
  intro j x
  exact hrow T hT G hs P hP hprime J weights hlow hMass I patterns slots bounds
    hslots hbounds hsum (ζ j) (k j) (K j) (hK j) x
