/- Exact active harmonic endpoints after saturation of the original finite pool support. -/

open Finset Filter
open scoped ComplexConjugate
namespace Bounty

theorem eventually_candidate_harmonic_eq_saturated_endpoints {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (hr : 0 < r)
      (hj : jStar ∈ candidateQIndices c L) (X : ℝ)
      (take : Fin ((candidateQIndices c L).card*r) → Bool)
      (hkeep : take ((candidateAllocationOrder c L r).symm
        (candidateRoughSlot c L r jStar hr hj)) = false)
      (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (σ : ℝ),
    (∀ p ∈ candidateRoughBand c L jStar,
      twist (candidateRoughSlot c L r jStar hr hj) p = typeIIPhase σ p) →
    ∀ (Z : ℝ) (k : ℤ) (M : Finset ℕ) (α : ℕ → ℂ) (ν : ℝ)
      (χ : DirichletCharacter ℂ (2*k.natAbs)) (ξ : EuclideanSpace ℝ (Fin 3)),
    |(k : ℝ)| ≤ Z → 3*Z < X →
    (∀ m ∈ M, 0 < m) → (∀ m, m ∉ M → α m = 0) →
    (∀ m ∈ M, α m ≠ 0 → Disjoint m.primeFactors
      ((candidatePIndices c L).biUnion (candidatePBand (c*L)))) →
    let H := candidateRetainedAllocationSupport c L r jStar (candidateSmallPSet c L X) take
    let M₀ := M.filter (fun m => α m ≠ 0)
    let Zs := typeIIActiveCrossZ Z k (Icc 0 (M₀.sup id * H.sup id))
    let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
    let W : ℕ → ℝ := fun n => markedDivisorWeight (candidatePIndices c L)
      (candidatePBand (c*L)) q (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p : ℝ)) (fun _ => 1) (n : ℤ)
    let cr := candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist
    let F₀ := invariantTripleEndpoint P
      (fun m => α m * χ (m : ZMod (2*k.natAbs)) * typeIIPhase ((2*Real.pi*ν)-2*Real.pi*ξ 1) m)
      (fun p => if p ∈ candidateRoughBand c L jStar then typeIIPhase (-σ) p else 0)
      (fun s => conj (cr s))
    let G₀ := invariantTripleEndpoint P
      (fun m => α m * χ (m : ZMod (2*k.natAbs)) * typeIIPhase (2*Real.pi*ξ 0+(2*Real.pi*ν)) m)
      (fun p => if p ∈ candidateRoughBand c L jStar then typeIIPhase (-σ) p else 0)
      (fun s => conj (cr s))
    candidateB0HarmonicCorrelation c L q r jStar (candidateSmallPSet c L X) take twist
      ν Z k M α χ ξ =
      ∑ z ∈ Zs, ((typeIIHarmonicDyadic ((z : ℝ)/Z)/(z : ℝ) : ℝ) : ℂ) *
        (typeIIPhase ((2*Real.pi*ν)+2*Real.pi*ξ 2) z * typeIIPhase (-(2*Real.pi*ν)) ((z : ℤ)+k).toNat *
          conj (F₀ z) * G₀ ((z : ℤ)+k).toNat * (W z : ℂ) * (W ((z : ℤ)+k).toNat : ℂ)) := by
  classical
  filter_upwards [eventually_candidate_cross_pair_eq_saturated_endpoints hc] with L hL
  intro q r jStar hr hj X take hkeep twist σ hphase Z k M α ν χ ξ hk hX hM hα hfree
  dsimp only
  unfold candidateB0HarmonicCorrelation typeIIRetainedHarmonicCorrelation
  dsimp only
  apply sum_congr rfl
  intro z hz
  have hzpos := (mem_filter.mp hz).2.1
  have hwpos := (mem_filter.mp hz).2.2.1
  obtain ⟨hzX, hwX⟩ := active_cross_endpoints_lt_cutoff hz hk hX
  have hsupport : ∀ m, m ∉ M.filter (fun m => α m ≠ 0) → α m = 0 := by
    intro m hm
    by_cases hmM : m ∈ M
    · by_contra hne
      exact hm (mem_filter.mpr ⟨hmM, hne⟩)
    · exact hα m hmM
  rw [hL q r jStar hr hj X take hkeep twist σ hphase
    (M.filter (fun m => α m ≠ 0)) α (2*k.natAbs) χ (2*Real.pi*ν)
    (2*Real.pi*ξ 0) (2*Real.pi*ξ 1) (2*Real.pi*ξ 2) z ((z : ℤ)+k).toNat
    hzpos (Int.pos_iff_toNat_pos.mp hwpos) hzX hwX
    (fun m hm => hM m (mem_filter.mp hm).1)
    (fun m hm => hfree m (mem_filter.mp hm).1 (mem_filter.mp hm).2) hsupport]

end Bounty
