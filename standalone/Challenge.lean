def kernelTestPartitionTerm {ι : Type*} {S : Set KernelQuotient} :
  letI rootPolicy_complexSLTopology := @OAI.CubicEisenstein.complexSLTopology
  ∀ (ρ : let _ : ChartedSpace SpatialCoordinates KernelQuotient := kernelSpatialChartedSpace; SmoothPartitionOfUnity ι 𝓘(ℝ,SpatialCoordinates) KernelQuotient S)
    (f : kernelSmoothTests) (i : ι),
    kernelSmoothTests :=
  letI rootPolicy_complexSLTopology := @OAI.CubicEisenstein.complexSLTopology
  fun (ρ : let _ : ChartedSpace SpatialCoordinates KernelQuotient := kernelSpatialChartedSpace; SmoothPartitionOfUnity ι 𝓘(ℝ,SpatialCoordinates) KernelQuotient S)
    (f : kernelSmoothTests) (i : ι) =>
    let : ChartedSpace SpatialCoordinates KernelQuotient := kernelSpatialChartedSpace
    ⟨fun q => ρ i q • f.1 q,(ρ i).contMDiff.smul f.2.1,
      HasCompactSupport.smul_left (f := fun q => ρ i q) (f' := f.1) f.2.2⟩

lemma kernelTestPartitionTerm_tsupport {ι : Type*} {S : Set KernelQuotient} :
  letI rootPolicy_complexSLTopology := @OAI.CubicEisenstein.complexSLTopology
  ∀ (ρ : let _ : ChartedSpace SpatialCoordinates KernelQuotient := kernelSpatialChartedSpace; SmoothPartitionOfUnity ι 𝓘(ℝ,SpatialCoordinates) KernelQuotient S)
    (f : kernelSmoothTests) (i : ι),
    tsupport (kernelTestPartitionTerm ρ f i).1⊆tsupport (ρ i) :=
  letI rootPolicy_complexSLTopology := @OAI.CubicEisenstein.complexSLTopology
  fun (ρ : let _ : ChartedSpace SpatialCoordinates KernelQuotient := kernelSpatialChartedSpace; SmoothPartitionOfUnity ι 𝓘(ℝ,SpatialCoordinates) KernelQuotient S)
    (f : kernelSmoothTests) (i : ι) =>
    let : ChartedSpace SpatialCoordinates KernelQuotient := kernelSpatialChartedSpace
    tsupport_smul_subset_left _ _

lemma kernelTestPartition_sum {ι : Type*} [Fintype ι]
    (f : kernelSmoothTests) :
  letI rootPolicy_complexSLTopology := @OAI.CubicEisenstein.complexSLTopology
  ∀ (ρ : let _ : ChartedSpace SpatialCoordinates KernelQuotient := kernelSpatialChartedSpace; SmoothPartitionOfUnity ι 𝓘(ℝ,SpatialCoordinates) KernelQuotient (tsupport f.1)),
    ∑i,kernelTestPartitionTerm ρ f i=f :=
  letI rootPolicy_complexSLTopology := @OAI.CubicEisenstein.complexSLTopology
  fun (ρ : let _ : ChartedSpace SpatialCoordinates KernelQuotient := kernelSpatialChartedSpace; SmoothPartitionOfUnity ι 𝓘(ℝ,SpatialCoordinates) KernelQuotient (tsupport f.1)) =>
    by
     let : ChartedSpace SpatialCoordinates KernelQuotient := kernelSpatialChartedSpace
     apply Subtype.ext
     funext q
     simp only [Submodule.coe_sum,Finset.sum_apply,kernelTestPartitionTerm]
     rw [←Finset.sum_smul]
     by_cases hq : q∈tsupport f.1
     · have hs := ρ.sum_eq_one hq
       rw [finsum_eq_sum_of_fintype] at hs
       rw [hs,one_smul]
     · have hz : f.1 q=0 := image_eq_zero_of_notMem_tsupport hq
       rw [hz,smul_zero]




end CubicEisenstein

