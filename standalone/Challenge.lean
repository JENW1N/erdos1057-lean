/- A fresh-or-promoted target cannot reuse a currently active prime. -/

open Finset
open scoped Classical
namespace Bounty

theorem global_birth_target_avoids_active {P : Type*} [DecidableEq P]
    {R : P → Type*} {m t : ℕ} (active H : Finset P)
    (old : Fin m → Σ p, R p) (target : Fin t → P)
    (hborn : active ⊆ H) (hinactive : ∀ j, (old j).1 ∉ active)
    (eligible : Finset (Fin m)) (promotions : Finset (Fin t))
    (e : promotions ↪ eligible) (fresh : UnrestrictedFreshLabels P promotions)
    (hv : unrestrictedEdgeTarget old Sigma.fst promotions e fresh = target ∧
      ∀ s, fresh s ∉ H) :
    ∀ s, target s ∉ active := by
  intro s hs
  have he := congrFun hv.1 s
  by_cases hp : s ∈ promotions
  · have ho : (old (e ⟨s, hp⟩).val).1 = target s := by
      simpa only [unrestrictedEdgeTarget, unrestrictedTargetLabels, dif_pos hp] using he
    exact hinactive _ (ho ▸ hs)
  · have hf : fresh ⟨s, hp⟩ = target s := by
      simpa only [unrestrictedEdgeTarget, unrestrictedTargetLabels, dif_neg hp] using he
    exact hv.2 ⟨s, hp⟩ (hborn (hf ▸ hs))

theorem global_birth_edge_raw_zero_of_active_target {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*} [∀ p, AddGroup (R p)]
    {m t : ℕ} (source target : Fin t ↪ P) (delta : (p : P) → R p)
    (active H : Finset P) (old : Fin m → Σ p, R p)
    (hborn : active ⊆ H) (hinactive : ∀ j, (old j).1 ∉ active)
    (htarget : ∃ s, target s ∈ active)
    (eligible : Finset (Fin m)) (β : P → ℝ) (ρ V : ℝ) (cap : ℕ)
    (G : Finset P → FiniteOrderedTuple (Σ p, R p) → ℂ) :
    globalBirthEdgeRawRow source target delta H old eligible β ρ V cap G = 0 := by
  unfold globalBirthEdgeRawRow unrestrictedEdgeAction
  apply sum_eq_zero
  intro stores _
  apply sum_eq_zero
  intro promotions _
  apply sum_eq_zero
  intro e _
  apply sum_eq_zero
  intro fresh _
  have hn : ¬ (unrestrictedEdgeTarget old Sigma.fst promotions e fresh = target ∧
      ∀ s, fresh s ∉ H) := by
    intro hv
    obtain ⟨s, hs⟩ := htarget
    exact global_birth_target_avoids_active active H old target hborn hinactive
      eligible promotions e fresh hv s hs
  simp only [if_neg hn, mul_zero, zero_mul]

end Bounty
