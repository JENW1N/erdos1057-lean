omit [∀ g, ∀ p : ↥(P g), NeZero p.val] in
theorem physical_observed_selected_edge (j : K) (aux : PhysicalAuxLabels P (C j))
    (R : PhysicalMarkLists P J ell)
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) :
    physicalObservedMarkRow C k ω β retention ρ V hV (some (.inr j))
      (fun o t => if o = .inr (some ⟨j, aux⟩) ∧ t.1 = R then F (physicalMarkRawReadout t) else 0) s =
      (ω j (productActiveMemorySplit (fun g => physicalFullSharedIndices (C j g)) B
        (physicalFullMemoryState (C j) s.1 s.2.2)).1 aux : ℂ) *
        if physicalListAdmissible (C j) aux s.1 R then
          jointRawTensorCutoff B (physicalFullEdgeRawRow (B := B) (C j) (k j) s.1 R β ρ V aux)
            F (physicalMarkRawReadout s) else 0 := by
  unfold physicalObservedMarkRow
  dsimp only
  conv_lhs =>
    arg 2
    ext T
    arg 2
    ext a'
    arg 2
    arg 2
    arg 3
    equals (if (Sum.inr (some ⟨j, a'⟩) : PhysicalMarkObservation P ell C) =
        .inr (some ⟨j, aux⟩) ∧ T = R then
      physicalMarkRawExtension (B := B) (F ∘ physicalMarkRawReadout) T else fun _ => 0) =>
      funext u
      by_cases ho : (Sum.inr (some ⟨j, a'⟩) : PhysicalMarkObservation P ell C) = .inr (some ⟨j, aux⟩) <;>
        by_cases hT : T = R <;>
        simp only [physicalMarkRawExtension, ho, hT, and_self, and_true, and_false,
          if_true, if_false, dite_eq_ite, ite_self, Function.comp_apply]
  refine (sum_eq_single R ?_ (by simp)).trans ?_
  · intro T _ hT
    apply sum_eq_zero
    intro a' _
    have hm : ¬ ((Sum.inr (some ⟨j, a'⟩) : PhysicalMarkObservation P ell C) =
        .inr (some ⟨j, aux⟩) ∧ T = R) := fun h => hT h.2
    rw [if_neg hm]
    by_cases ha : physicalListAdmissible (C j) a' s.1 T
    · rw [if_pos ha, physical_full_edge_tensor_zero, mul_zero]
    · rw [if_neg ha, mul_zero]
  · refine (sum_eq_single aux ?_ (by simp)).trans ?_
    · intro a' _ ha'
      have ho : (Sum.inr (some ⟨j, a'⟩) : PhysicalMarkObservation P ell C) ≠
          .inr (some ⟨j, aux⟩) := by simpa using ha'
      simp only [ho, false_and, if_false]
      by_cases ha : physicalListAdmissible (C j) a' s.1 R
      · rw [if_pos ha, physical_full_edge_tensor_zero, mul_zero]
      · rw [if_neg ha, mul_zero]
    · simp only [eq_self, and_self, if_true]
      by_cases ha : physicalListAdmissible (C j) aux s.1 R
      · simp only [ha, if_true]
        rw [physical_mark_raw_tensor_readout]
        rfl
      · simp only [ha, if_false]

