variable {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
  [∀ g, DecidableEq (P g)] (n : (g : Fin N) → P g → ℕ)
  [∀ g p, NeZero (n g p)] (β : (g : Fin N) → P g → ℝ)
  (η V ρ : Fin N → ℝ) (t : Fin N → ℕ) (B : ℕ)

theorem global_birth_joint_visit_bounded_events (a : (g : Fin N) → P g → Bool)
    (hV : ∀ g, V g ≠ 0)
    (F : GlobalBirthJointState (fun g p => ZMod (n g p)) → ℂ)
    (s : BoundedGhostJointLedgerState n t B) :
    globalBirthJointCutRawRow
      (fun g => GlobalBirthRawStep.visit (a := a g) (fun _ => 0) (β g)
        (η g) (V g) (ρ g) (hV g) B) B B F (boundedGhostJointDecode n t B s) =
      ∑ e : CoupledGhostEvent t B (fun g => (s g).2),
        (coupledGhostJointEventWeight
          (fun g => physicalGhostRetention (n g) (1 - η g) (ρ g))
          (fun g => physicalGhostTermination (n g) (1 - η g) (ρ g))
          (fun g => physicalGhostBirth (n g) (1 - η g) (ρ g) (V g))
          (fun g => unrestrictedResidueWeight (fun p => β g p / V g))
          t B (fun g => (s g).2) e : ℂ) *
        (if boundedGhostJointFresh n t B s e then 1 else 0) *
          F (boundedGhostJointDecode n t B (boundedGhostJointTarget n t B s e)) := by
  have hr := bounded_ghost_joint_row_decode n β η V ρ t B
    (globalBirthJointRawCutoff B F) s
  change boundedGhostJointRow n β η V ρ t B
    (globalBirthJointRawCutoff B F ∘ boundedGhostJointDecode n t B) s =
      globalBirthJointRawRow
        (fun g => GlobalBirthRawStep.visit (a := a g) (fun _ => 0) (β g)
          (η g) (V g) (ρ g) (hV g) B) B F (boundedGhostJointDecode n t B s) at hr
  unfold globalBirthJointCutRawRow
  change (if productTotalMemory (fun g => (s g).2) ≤ B
    then globalBirthJointRawRow _ B F (boundedGhostJointDecode n t B s) else 0) = _
  rw [← hr, bounded_ghost_joint_row_events_factorized]
  have hout (e : CoupledGhostEvent t B (fun g => (s g).2)) :
      globalBirthJointRawCutoff B F
        (boundedGhostJointDecode n t B (boundedGhostJointTarget n t B s e)) =
      if productTotalMemory (coupledGhostJointEventTarget t B (fun g => (s g).2) e) ≤ B
      then F (boundedGhostJointDecode n t B (boundedGhostJointTarget n t B s e)) else 0 := rfl
  simp only [Function.comp_apply, hout]
  unfold coupledGhostJointEventWeight
  by_cases hi : productTotalMemory (fun g => (s g).2) ≤ B
  · rw [if_pos hi]
    apply sum_congr rfl
    intro e _
    by_cases ho : productTotalMemory (coupledGhostJointEventTarget t B (fun g => (s g).2) e) ≤ B
    · have hb : productTotalMemory (fun g => (s g).2) ≤ B ∧
          productTotalMemory (coupledGhostJointEventTarget t B (fun g => (s g).2) e) ≤ B := ⟨hi, ho⟩
      rw [if_pos ho, if_pos hb]
    · have hb : ¬ (productTotalMemory (fun g => (s g).2) ≤ B ∧
          productTotalMemory (coupledGhostJointEventTarget t B (fun g => (s g).2) e) ≤ B) :=
        fun h => ho h.2
      rw [if_neg ho, if_neg hb]
      simp only [mul_zero, Complex.ofReal_zero, zero_mul]
  · rw [if_neg hi]
    symm
    apply sum_eq_zero
    intro e _
    have hb : ¬ (productTotalMemory (fun g => (s g).2) ≤ B ∧
        productTotalMemory (coupledGhostJointEventTarget t B (fun g => (s g).2) e) ≤ B) :=
      fun h => hi h.1
    rw [if_neg hb]
    simp only [Complex.ofReal_zero, zero_mul]

end Joint
