/- A fixed initial forbidden set tests the same actual fresh draws in the
physical and canonical slot orders. Auxiliary labels are not tested. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_clean_initial_fresh_reindex {G : Type*} (P : G → Type*)
    {J ell : ℕ} (F : ∀ g, Finset (P g)) (C : G → Finset (Fin J))
    (fresh : ∀ g, Fin ((physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) → P g) :
    (∀ g i, physicalCleanFreshEquiv P C fresh g i ∉ F g) ↔
      ∀ g i, fresh g i ∉ F g := by
  constructor
  · intro h g i
    have hi := h g (physicalCleanFreshIndex C g i)
    simpa only [physicalCleanFreshEquiv_apply_index] using hi
  · intro h g i
    obtain ⟨j, rfl⟩ := (physicalCleanFreshIndex C g).surjective i
    simpa only [physicalCleanFreshEquiv_apply_index] using h g j

/- Under the clean event mask, canonical target avoidance is literally the
initial-forbidden-set test on the original physical event's fresh draws. -/
theorem physical_clean_initial_event_gate {G : Type*}
    {P : G → Finset ℕ} {J ell B : ℕ}
    (F : ∀ g, Finset (P g)) (C : G → Finset (Fin J)) (Δ D : G → ℤ)
    (s : ProductBoundedOrderedState (fun g => ↥(P g))
      (fun g => UnrestrictedResidueParticle (fun p : P g => p.val))
      (fun g => (physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) B)
    (e : UnrestrictedJointEvent (fun g (p : P g) => p.val) Δ D
      (fun g => (physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) B s)
    (z : ℂ) :
    (if ∀ g, (e g).1 = ∅ ∧ (e g).2.1 = ∅ then
      if ∀ g i, physicalCleanFreshEquiv (fun g => ↥(P g)) C
        (fun g => (unrestrictedJointEventTarget (fun g (p : P g) => p.val) Δ D
          (fun g => (physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) B s e g).1) g i ∉ F g
      then z else 0 else 0) =
    if (∀ g, (e g).1 = ∅ ∧ (e g).2.1 = ∅) ∧
        (∀ g i, (e g).2.2.2 i ∉ F g) then z else 0 := by
  by_cases he : ∀ g, (e g).1 = ∅ ∧ (e g).2.1 = ∅
  · rw [if_pos he, physical_clean_initial_fresh_reindex]
    have hi : (∀ g i, (unrestrictedJointEventTarget (fun g (p : P g) => p.val) Δ D
          (fun g => (physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) B s e g).1 i ∉ F g) ↔
        ∀ g i, (e g).2.2.2 i ∉ F g := by
      exact forall_congr' fun g => unrestricted_clean_fresh_allowed (F g) (fun p : P g => p.val)
        (Δ g) (D g) _ B (s g) (e g) (he g)
    rw [hi]
    simp [he]
  · simp only [he, false_and, ↓reduceIte]

end Bounty
