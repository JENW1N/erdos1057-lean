section

/- The exact common-source Mellin energy is the normalized cutoff energy times Y squared. -/

open Finset MeasureTheory
namespace Bounty

theorem common_source_mellin_polynomial {Y Z : ℝ} (hY : 0 < Y) (hZ : 0 < Z)
    (a v t c : ℝ) (F : ℤ → ℂ) :
    (Y : ℂ)⁻¹ * localMellinPolynomial ((harmonicCommonSupport Y).image Int.natAbs)
      (fun n => harmonicCellSource Y Z a v F n * fourier (n : ℤ) (c : AddCircle (1 : ℝ))) t =
      physicalMellinPhase v Z * ∑ n ∈ (harmonicCommonSupport Y).image Int.natAbs,
        F n * ((harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)/(n : ℂ)) *
          physicalMellinPhase (t-a-v) n *
          Complex.exp (Complex.I * (2*Real.pi*(c*n) : ℝ)) := by
  unfold localMellinPolynomial
  rw [mul_sum, mul_sum]
  apply sum_congr rfl
  intro n hn
  exact normalized_harmonic_source_factor hY hZ a v t c F
    (harmonic_common_natural_support_bound hY hn).1

theorem common_source_mellin_norm_sq {Y Z : ℝ} (hY : 0 < Y) (hZ : 0 < Z)
    (a v t c : ℝ) (F : ℤ → ℂ) :
    ‖localMellinPolynomial ((harmonicCommonSupport Y).image Int.natAbs)
      (fun n => harmonicCellSource Y Z a v F n * fourier (n : ℤ) (c : AddCircle (1 : ℝ))) t‖^2 =
      Y^2 * ‖∑ n ∈ (harmonicCommonSupport Y).image Int.natAbs,
        F n * ((harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)/(n : ℂ)) *
          physicalMellinPhase (t-a-v) n *
          Complex.exp (Complex.I * (2*Real.pi*(c*n) : ℝ))‖^2 := by
  have hYC : (Y : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hY.ne'
  have he := congrArg (fun z : ℂ => ‖(Y : ℂ)*z‖^2)
    (common_source_mellin_polynomial hY hZ a v t c F)
  simpa only [← mul_assoc, mul_inv_cancel₀ hYC, one_mul, norm_mul,
    physical_mellin_phase_norm, mul_one, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos hY, mul_pow] using he

theorem common_source_mellin_energy (μ : Measure ℝ)
    {Y Z : ℝ} (hY : 0 < Y) (hZ : 0 < Z) (a v c : ℝ) (F : ℤ → ℂ) :
    (∫ t, ‖localMellinPolynomial ((harmonicCommonSupport Y).image Int.natAbs)
      (fun n => harmonicCellSource Y Z a v F n * fourier (n : ℤ) (c : AddCircle (1 : ℝ))) t‖^2 ∂μ) =
      Y^2 * ∫ t, ‖∑ n ∈ (harmonicCommonSupport Y).image Int.natAbs,
        F n * ((harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)/(n : ℂ)) *
          physicalMellinPhase (t-a-v) n *
          Complex.exp (Complex.I * (2*Real.pi*(c*n) : ℝ))‖^2 ∂μ := by
  simp_rw [common_source_mellin_norm_sq hY hZ a v _ c F]
  exact integral_const_mul _ _

end Bounty
end

