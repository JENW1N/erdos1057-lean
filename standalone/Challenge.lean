section

/- One rational coefficient family handles arbitrary product kernels and Mellin weights. -/

open Finset
open scoped Classical

namespace Bounty

theorem rational_four_factor_full_gcd_kernel_expansion {r Q : ℕ}
    (hr : 0 < r) (hrQ : r ≤ Q) (u : ℤ)
    (M A P N : Finset ℕ)
    (hM : ∀ m ∈ M, m.Coprime r) (hA : ∀ a ∈ A, a.Coprime r)
    (hP : ∀ p ∈ P, p.Coprime r) :
    ∃ c : (d : ℕ) → AddChar (Additive (ZMod (r/d))ˣ) ℂ → ℂ,
      (∑ d ∈ r.divisors, ∑ ψ, ‖c d ψ‖) ≤ (r.divisors.card : ℝ)*Real.sqrt (Q : ℝ) ∧
      (r.divisors.card : ℝ)*Real.sqrt (Q : ℝ) ≤ (Q : ℝ)*Real.sqrt (Q : ℝ) ∧
      ∀ α δ β γ H : ℕ → ℂ,
      (∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ n ∈ N,
        (α m*δ a*β p*γ n)*H (m*a*p*n)*
          Complex.exp (Complex.I*(2*Real.pi*((u : ℝ)/r*(m*a*p*n)) : ℝ))) =
        ∑ d ∈ r.divisors, ∑ ψ, c d ψ *
          ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ n ∈ N,
            (α m*unitAddCharDirichlet ψ (m : ZMod (r/d)))*
            (δ a*unitAddCharDirichlet ψ (a : ZMod (r/d)))*
            (β p*unitAddCharDirichlet ψ (p : ZMod (r/d)))*
            (γ n*rationalResidualGcdMultiplier r d ψ n)*H (m*a*p*n) := by
  have hex (d : ℕ) : ∃ c : AddChar (Additive (ZMod (r/d))ˣ) ℂ → ℂ,
      (∑ ψ, ‖c ψ‖) ≤ Real.sqrt (Q : ℝ) ∧
      (d ∈ r.divisors →
        ∀ m a p n : ℕ, m.Coprime r → a.Coprime r → p.Coprime r → n.gcd r = d →
          (∑ ψ, c ψ*unitAddCharDirichlet ψ (m : ZMod (r/d))*
            unitAddCharDirichlet ψ (a : ZMod (r/d))*
            unitAddCharDirichlet ψ (p : ZMod (r/d))*
            unitAddCharDirichlet ψ ((n/d : ℕ) : ZMod (r/d))) =
              Complex.exp (Complex.I*(2*Real.pi*((u : ℝ)/r*(m*a*p*n)) : ℝ))) := by
    by_cases hd : d ∈ r.divisors
    · obtain ⟨c, hc, he⟩ := rational_four_factor_gcd_slice_expansion hr hrQ
        (Nat.pos_of_mem_divisors hd) (Nat.dvd_of_mem_divisors hd) u
      exact ⟨c, hc, fun _ => he⟩
    · refine ⟨fun _ => 0, ?_, fun h => (hd h).elim⟩
      simp
  choose c hc using hex
  have hmass : (∑ d ∈ r.divisors, ∑ ψ, ‖c d ψ‖) ≤
      (r.divisors.card : ℝ)*Real.sqrt (Q : ℝ) := by
    calc
      _ ≤ ∑ _d ∈ r.divisors, Real.sqrt (Q : ℝ) := sum_le_sum (fun d _ => (hc d).1)
      _ = _ := by simp
  have hcard : (r.divisors.card : ℝ) ≤ (Q : ℝ) := by
    exact_mod_cast (Nat.card_divisors_le_self r).trans hrQ
  refine ⟨c, hmass, mul_le_mul_of_nonneg_right hcard (Real.sqrt_nonneg _), ?_⟩
  intro α δ β γ H
  calc
    _ = ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P, ∑ d ∈ r.divisors,
        ∑ n ∈ N.filter (fun n => n.gcd r = d),
          (α m*δ a*β p*γ n)*H (m*a*p*n)*
            Complex.exp (Complex.I*(2*Real.pi*((u : ℝ)/r*(m*a*p*n)) : ℝ)) := by
      apply sum_congr rfl
      intro m _
      apply sum_congr rfl
      intro a _
      apply sum_congr rfl
      intro p _
      exact sum_eq_sum_residual_gcd_slices hr N _
    _ = ∑ d ∈ r.divisors, ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P,
        ∑ n ∈ N.filter (fun n => n.gcd r = d),
          (α m*δ a*β p*γ n)*H (m*a*p*n)*
            Complex.exp (Complex.I*(2*Real.pi*((u : ℝ)/r*(m*a*p*n)) : ℝ)) := by
      conv_lhs =>
        arg 2
        ext m
        arg 2
        ext a
        rw [sum_comm]
      conv_lhs =>
        arg 2
        ext m
        rw [sum_comm]
      rw [sum_comm]
    _ = _ := by
      apply sum_congr rfl
      intro d hd
      calc
        _ = ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P,
            ∑ n ∈ N.filter (fun n => n.gcd r = d), ∑ ψ,
            c d ψ * (α m*unitAddCharDirichlet ψ (m : ZMod (r/d))) *
              (δ a*unitAddCharDirichlet ψ (a : ZMod (r/d))) *
              (β p*unitAddCharDirichlet ψ (p : ZMod (r/d))) *
              (γ n*unitAddCharDirichlet ψ ((n/d : ℕ) : ZMod (r/d))) * H (m*a*p*n) := by
          apply sum_congr rfl
          intro m hm
          apply sum_congr rfl
          intro a ha
          apply sum_congr rfl
          intro p hp
          apply sum_congr rfl
          intro n hn
          rw [← (hc d).2 hd m a p n (hM m hm) (hA a ha) (hP p hp) (mem_filter.mp hn).2,
            mul_sum]
          apply sum_congr rfl
          intro ψ _
          ring
        _ = ∑ ψ, ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P,
            ∑ n ∈ N.filter (fun n => n.gcd r = d),
            c d ψ * (α m*unitAddCharDirichlet ψ (m : ZMod (r/d))) *
              (δ a*unitAddCharDirichlet ψ (a : ZMod (r/d))) *
              (β p*unitAddCharDirichlet ψ (p : ZMod (r/d))) *
              (γ n*unitAddCharDirichlet ψ ((n/d : ℕ) : ZMod (r/d))) * H (m*a*p*n) := by
          conv_lhs =>
            arg 2
            ext m
            arg 2
            ext a
            arg 2
            ext p
            rw [sum_comm]
          conv_lhs =>
            arg 2
            ext m
            arg 2
            ext a
            rw [sum_comm]
          conv_lhs =>
            arg 2
            ext m
            rw [sum_comm]
          rw [sum_comm]
        _ = ∑ ψ, c d ψ *
            ∑ m ∈ M, ∑ a ∈ A, ∑ p ∈ P,
            ∑ n ∈ N.filter (fun n => n.gcd r = d),
              (α m*unitAddCharDirichlet ψ (m : ZMod (r/d))) *
              (δ a*unitAddCharDirichlet ψ (a : ZMod (r/d))) *
              (β p*unitAddCharDirichlet ψ (p : ZMod (r/d))) *
              (γ n*unitAddCharDirichlet ψ ((n/d : ℕ) : ZMod (r/d))) * H (m*a*p*n) := by
          simp only [mul_assoc, mul_sum]
        _ = _ := by
          apply sum_congr rfl
          intro ψ _
          congr 1
          apply sum_congr rfl
          intro m _
          apply sum_congr rfl
          intro a _
          apply sum_congr rfl
          intro p _
          simpa only [mul_assoc] using rational_residual_gcd_filtered_sum r d ψ N
            (fun n => (α m*unitAddCharDirichlet ψ (m : ZMod (r/d))) *
              (δ a*unitAddCharDirichlet ψ (a : ZMod (r/d))) *
              (β p*unitAddCharDirichlet ψ (p : ZMod (r/d))) * γ n)
            (fun n => H (m*a*p*n))




end Bounty
end

