structure GoodMaskRowData (m f z:(_root_.OAI.ActualEisensteinCubic.O)) where
  maskUnit:(_root_.OAI.ActualEisensteinCubic.O)ˣ
  maskLambda:ℕ
  maskTwo:ℕ
  maskGood:(_root_.OAI.ActualEisensteinCubic.O)
  maskSupported:Supported (Ideal.span {maskGood})
  maskPrimary:lambda^2∣maskGood-1
  maskFactor:m=maskUnit.val*lambda^maskLambda*(2:(_root_.OAI.ActualEisensteinCubic.O))^maskTwo*maskGood
  numeratorUnit:(_root_.OAI.ActualEisensteinCubic.O)ˣ
  numeratorLambda:ℕ
  numeratorTwo:ℕ
  numeratorGood:(_root_.OAI.ActualEisensteinCubic.O)
  numeratorSupported:Supported (Ideal.span {numeratorGood})
  numeratorPrimary:lambda^2∣numeratorGood-1
  numeratorFactor:f^4*z=numeratorUnit.val*lambda^numeratorLambda*(2:(_root_.OAI.ActualEisensteinCubic.O))^numeratorTwo*numeratorGood

theorem exists_goodMaskRowData (m f z:(_root_.OAI.ActualEisensteinCubic.O)) (hm:m≠0) (hf:f≠0) (hz:z≠0) :
    Nonempty (GoodMaskRowData m f z) := by
  obtain ⟨um,am,bm,g,hg,hpg,hmf⟩:=exists_supported_numerator_factorization m hm
  obtain ⟨u,a,b,r,hr,hpr,hxf⟩:=exists_supported_numerator_factorization (f^4*z)
    (mul_ne_zero (pow_ne_zero _ hf) hz)
  exact ⟨⟨um,am,bm,g,hg,hpg,hmf,u,a,b,r,hr,hpr,hxf⟩⟩

noncomputable def goodMaskRowData (m f z:(_root_.OAI.ActualEisensteinCubic.O)) (hm:m≠0) (hf:f≠0) (hz:z≠0) :
    GoodMaskRowData m f z := Classical.choice (exists_goodMaskRowData m f z hm hf hz)

namespace GoodMaskRowData
variable {m f z:(_root_.OAI.ActualEisensteinCubic.O)} (D:GoodMaskRowData m f z)

def movingIdeal : Ideal (_root_.OAI.ActualEisensteinCubic.O) := goodMaskMovingIdeal D.maskGood D.numeratorGood

lemma movingSupported : Supported D.movingIdeal :=
  goodMaskMovingIdeal_supported D.maskGood D.numeratorGood D.maskSupported D.numeratorSupported

def fixedFactor (Ψ:(_root_.OAI.ActualEisensteinCubic.O)→*ℂ) (Q:Ideal (_root_.OAI.ActualEisensteinCubic.O)) : (_root_.OAI.ActualEisensteinCubic.O)→*ℂ :=
  (Ψ*numeratorBadTwist D.numeratorUnit D.numeratorLambda D.numeratorTwo D.numeratorGood
    D.numeratorSupported)*basePrimeRow D.movingIdeal D.movingSupported (Q*Ideal.span {(72:(_root_.OAI.ActualEisensteinCubic.O))})

lemma numeratorFactor_norm (Ψ:(_root_.OAI.ActualEisensteinCubic.O)→*ℂ) (hΨ:∀n,‖Ψ n‖≤1) (n:(_root_.OAI.ActualEisensteinCubic.O)) :
    ‖(Ψ*numeratorBadTwist D.numeratorUnit D.numeratorLambda D.numeratorTwo D.numeratorGood
      D.numeratorSupported) n‖≤1 := by
  change ‖Ψ n*numeratorBadTwist _ _ _ _ _ n‖≤1
  rw [norm_mul]
  exact (mul_le_of_le_one_left (norm_nonneg _) (hΨ n)).trans (numeratorBadTwist_norm _ _ _ _ _ n)

lemma fixedFactor_periodic (Ψ:(_root_.OAI.ActualEisensteinCubic.O)→*ℂ) (Q:Ideal (_root_.OAI.ActualEisensteinCubic.O))
    (hΨ:CanonicalCoefficientClass.FactorsModulo Q Ψ) :
    CanonicalCoefficientClass.FactorsModulo (Q*Ideal.span {(72:(_root_.OAI.ActualEisensteinCubic.O))}) (D.fixedFactor Ψ Q) := by
  have hn:=fixedNumeratorTwist_periodic Ψ Q hΨ D.numeratorUnit D.numeratorLambda
    D.numeratorTwo D.numeratorGood D.numeratorSupported
  intro x y hxy
  change (Ψ*numeratorBadTwist D.numeratorUnit D.numeratorLambda D.numeratorTwo D.numeratorGood
    D.numeratorSupported) x*basePrimeRow D.movingIdeal D.movingSupported (Q*Ideal.span {(72:(_root_.OAI.ActualEisensteinCubic.O))}) x=
    (Ψ*numeratorBadTwist D.numeratorUnit D.numeratorLambda D.numeratorTwo D.numeratorGood
    D.numeratorSupported) y*basePrimeRow D.movingIdeal D.movingSupported (Q*Ideal.span {(72:(_root_.OAI.ActualEisensteinCubic.O))}) y
  rw [hn x y hxy,basePrimeRow_periodic D.movingIdeal D.movingSupported _ x y hxy]

lemma fixedFactor_norm (Ψ:(_root_.OAI.ActualEisensteinCubic.O)→*ℂ) (Q:Ideal (_root_.OAI.ActualEisensteinCubic.O)) (hΨ:∀n,‖Ψ n‖≤1) (n:(_root_.OAI.ActualEisensteinCubic.O)) :
    ‖D.fixedFactor Ψ Q n‖≤1 := by
