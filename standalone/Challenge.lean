lemma kernelSmoothTestsToL2_norm_sq (f : kernelSmoothTests) :
  letI rootPolicy_hyperbolicMeasurableSpace := @OAI.CubicEisenstein.hyperbolicMeasurableSpace
  ‖kernelSmoothTestsToL2 f‖^2=
    ∫q,‖f.1 q‖^2∂integralQuotientVolume globalKubotaKernel :=
