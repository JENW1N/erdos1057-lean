section

/- The original quantifier order fixes the rough slot before L tends to infinity. -/

open Finset Filter

namespace Bounty

theorem exists_candidate_rough_scale_parameters {c eta : ℝ} (hc : 0 < c) (heta : 0 < eta) :
    ∃ J : ℕ, ∀ j : ℕ, J < j → ∃ aLong : ℝ, 0 < aLong ∧
      aLong < c/2^j ∧ (6/5 : ℝ)*(c/2^j) ≤ eta := by
  obtain ⟨J,hJ⟩ := exists_nat_gt ((6/5 : ℝ)*c/eta)
  refine ⟨J,?_⟩
  intro j hj
  have hJj : (J : ℝ) ≤ (j : ℝ) := by exact_mod_cast hj.le
  have hjpow : (j : ℝ) ≤ (2 : ℝ)^j := by exact_mod_cast j.lt_two_pow_self.le
  have hscale := (div_le_iff₀ heta).mp (hJ.le.trans (hJj.trans hjpow))
  have hcj : 0 < c/(2 : ℝ)^j := by positivity
  refine ⟨(c/2^j)/2,by positivity,by linarith,?_⟩
  rw [← mul_div_assoc]
  apply (div_le_iff₀ (by positivity : (0 : ℝ) < 2^j)).mpr
  nlinarith only [hscale]

theorem exists_candidate_long_rough_dyadic_window {c eta : ℝ}
    (hc : 0 < c) (heta : 0 < eta) :
    ∃ J : ℕ, ∀ j : ℕ, J < j → ∃ aLong : ℝ, 0 < aLong ∧
      ∀ᶠ L : ℝ in atTop, ∀ U : ℝ, 0 < U →
      ((candidateRoughBand c L j).filter (fun n : ℕ => U < (n : ℝ) ∧ (n : ℝ) ≤ 2*U)).Nonempty →
      Real.exp (aLong*L) ≤ U ∧ U ≤ Real.exp (eta*L) ∧
      U ≤ max (Real.exp (c*L/2^j)) U ∧
      max (Real.exp (c*L/2^j)) U ≤ min (Real.exp ((6/5 : ℝ)*c*L/2^j)) (2*U) ∧
      min (Real.exp ((6/5 : ℝ)*c*L/2^j)) (2*U) ≤ 2*U ∧
      (candidateRoughBand c L j).filter (fun n : ℕ => U < (n : ℝ) ∧ (n : ℝ) ≤ 2*U) =
        roughBand (max (Real.exp (c*L/2^j)) U)
          (min (Real.exp ((6/5 : ℝ)*c*L/2^j)) (2*U)) (Real.exp (Real.sqrt L)) := by
  obtain ⟨J,hJ⟩ := exists_candidate_rough_scale_parameters hc heta
  refine ⟨J,?_⟩
  intro j hj
  obtain ⟨aLong,ha,hlo,hhi⟩ := hJ j hj
  refine ⟨aLong,ha,?_⟩
  filter_upwards [eventually_candidate_rough_dyadic_scales hc j j hlo hhi] with L hL
  exact hL j le_rfl le_rfl

end Bounty
