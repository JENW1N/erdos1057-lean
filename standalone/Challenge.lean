  exact full_mixed_common_forest_history_gain_owner n S B A Δ D steps code u s e history

theorem full_mixed_common_none_owner_empty (u : Fin steps.length) (htag : steps.get u = none)
    (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) :
    fullMixedCommonIndexStage M B steps i ≠ u.succ := by
