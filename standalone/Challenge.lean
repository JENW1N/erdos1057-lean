section

/- The original smooth dyadic scale remains exponentially large at every index. -/

open Filter Real
namespace Bounty

theorem eventually_typeII_harmonic_scale_lower {b K : ℝ}
    (hb : 0 < b) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop, ∀ U V : ℝ,
      exp (b*L) ≤ U → exp (b*L) ≤ V → ∀ j : ℕ,
      2*exp (b*L) ≤ typeIISmoothDyadicScale U V (U*L^(-K)) j := by
  filter_upwards [eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (log 32/b)] with L hL hc
  intro U V hUlo hVlo j
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hU : 0 < U := (exp_pos _).trans_le hUlo
  have hV : 0 < V := (exp_pos _).trans_le hVlo
  have hE : 0 < U*L^(-K) := mul_pos hU (rpow_pos_of_pos hL0 _)
  have h32 : (32 : ℝ) ≤ exp (b*L) := by
    have hh : log 32 ≤ b*L := by nlinarith [(div_le_iff₀ hb).mp hc]
    calc
      _ = exp (log 32) := (exp_log (by norm_num)).symm
      _ ≤ _ := exp_le_exp.mpr hh
  have hUV : exp (b*L)*exp (b*L) ≤ U*V :=
    mul_le_mul hUlo hVlo (exp_pos _).le hU.le
  have hpow : 1 ≤ L^K := one_le_rpow hL hK
  have heq : typeIISmoothDyadicScale U V (U*L^(-K)) 0 = U*V*L^K/16 := by
    simp only [typeIISmoothDyadicScale, pow_zero, mul_one]
    rw [rpow_neg hL0.le]
    field_simp
  calc
    _ ≤ U*V/16 := by nlinarith [mul_le_mul_of_nonneg_right h32 (exp_pos (b*L)).le]
    _ ≤ U*V*L^K/16 := by nlinarith [mul_le_mul_of_nonneg_left hpow (mul_pos hU hV).le]
    _ = typeIISmoothDyadicScale U V (U*L^(-K)) 0 := heq.symm
    _ ≤ _ := typeII_smooth_dyadic_scale_mono_zero hU hV hE j

end Bounty
