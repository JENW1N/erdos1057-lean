/- Integrability and explicit frequency tails for the original normalized common-cell pairing. -/

open Finset MeasureTheory

namespace Bounty

section

variable
  {Y Z : ℝ}
  (hY : 0 < Y)
  (hZ : Z ≠ 0)
  {d : ℕ}
  (hd : d ≠ 0)
  (a b : ℝ)
  (δ : ℤ)
  (F G : ℤ → ℂ)

include Y Z hY hZ d hd a b δ F G

theorem harmonic_cell_normalized_integrand_eq  (v : ℝ) :
    (Y : ℂ)⁻¹ * (harmonicLogFourier v * physicalPhase (-(a+b+2*Real.pi*v)) d *
      harmonicCellPairing Y Z a b (2*Real.pi*v) δ F G) =
      harmonicLogFourier v * ∑ n ∈ harmonicCommonSupport Y,
        harmonicCellCoefficient Y a b d δ F G n *
          physicalMellinPhase (2*Real.pi*v) ((n : ℝ)/(Z*(d : ℝ))) := by
  simp only [harmonicCellPairing, mul_sum]
  apply sum_congr rfl
  intro n hn
  have hn0 : n ≠ 0 := (harmonic_common_support_positive hY hn).ne'
  have hp := physical_mellin_phased_edge_normalized Y Z a b (2*Real.pi*v) d n (n+δ)
    (fun m => (harmonicCommonCutoff ((m : ℝ)/Y) : ℂ)*F m)
    (fun m => (harmonicCommonCutoff ((m : ℝ)/Y) : ℂ)*G m)
    hY.ne' hZ hd hn0
  dsimp only [harmonicCellSource, harmonicCellTarget, harmonicCellCoefficient]
  calc
    _ = harmonicLogFourier v *
        ((Y : ℂ)⁻¹ * physicalPhase (-(a+b+2*Real.pi*v)) d *
          star (physicalMellinSource Y Z (2*Real.pi*v)
            (fun m => physicalPhase (-a) m.natAbs *
              ((harmonicCommonCutoff ((m : ℝ)/Y) : ℂ)*F m)) n) *
          (physicalPhase b (n+δ).natAbs *
            ((harmonicCommonCutoff (((n+δ : ℤ) : ℝ)/Y) : ℂ)*G (n+δ)))) := by ring
    _ = _ := by rw [hp]; ring

theorem harmonic_cell_normalized_integrable  :
    Integrable (fun v : ℝ => (Y : ℂ)⁻¹ *
      (harmonicLogFourier v * physicalPhase (-(a+b+2*Real.pi*v)) d *
        harmonicCellPairing Y Z a b (2*Real.pi*v) δ F G)) := by
  have hi := finite_mellin_sum_integrable (harmonicCommonSupport Y) harmonicLogFourier
    (fun v => 2*Real.pi*v) harmonic_log_fourier_integrable (by fun_prop)
    (harmonicCellCoefficient Y a b d δ F G) (fun n => (n : ℝ)/(Z*(d : ℝ)))
  exact hi.congr (Filter.Eventually.of_forall (fun v =>
    (harmonic_cell_normalized_integrand_eq hY hZ hd a b δ F G v).symm))

theorem harmonic_cell_weighted_pairing_integrable  :
    Integrable (fun v : ℝ => harmonicLogFourier v * physicalPhase (-(a+b+2*Real.pi*v)) d *
      harmonicCellPairing Y Z a b (2*Real.pi*v) δ F G) := by
  have hYc : (Y : ℂ) ≠ 0 := by exact_mod_cast hY.ne'
  have hi := (harmonic_cell_normalized_integrable hY hZ hd a b δ F G).const_mul (Y : ℂ)
  simpa only [← mul_assoc, mul_inv_cancel₀ hYc, one_mul] using hi

theorem harmonic_cell_normalized_integrand_norm  (v : ℝ) :
    ‖(Y : ℂ)⁻¹ * (harmonicLogFourier v * physicalPhase (-(a+b+2*Real.pi*v)) d *
      harmonicCellPairing Y Z a b (2*Real.pi*v) δ F G)‖ ≤
      ‖harmonicLogFourier v‖ *
        ∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellCoefficient Y a b d δ F G n‖ := by
  rw [harmonic_cell_normalized_integrand_eq hY hZ hd a b δ F G v, norm_mul]
  apply mul_le_mul_of_nonneg_left _ (norm_nonneg _)
  apply (norm_sum_le _ _).trans
  simp only [norm_mul, physical_mellin_phase_norm, mul_one, le_refl]

end














end Bounty
