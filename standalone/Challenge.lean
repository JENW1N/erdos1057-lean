      (finiteRowGrouped (S := fun _ => X) row visitThreeBlockLength) (2 * n + 1) F =
      finiteRowComposition (S := fun _ => X) row (4 * n + 1) F := by
  have h := finite_row_visit_three_grouping (S := fun _ => X) row n F
  simpa only [cast_eq] using h

