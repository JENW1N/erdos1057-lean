section

/- Fixed count, retention, storage and promotion factors in the original event laws. -/

open Finset Classical

namespace Bounty

noncomputable def boundedGhostSkeletonAbsMass {P Z : Type*} (A D : Z → ℝ)
    (t B : ℕ) (s : BoundedOrderedState P Z t B) (b : Fin (B + 1))
    (retained : Finset (Fin s.2.1.val)) : ℝ :=
  if retained.card + b.val ≤ B then
    |((∏ j ∈ retained, A (s.2.2 j)) * (∏ j ∈ univ \ retained, D (s.2.2 j))) /
      (b.val.factorial : ℝ)| else 0

theorem bounded_ghost_skeleton_abs_mass_nonneg {P Z : Type*} (A D : Z → ℝ)
    (t B : ℕ) (s : BoundedOrderedState P Z t B) (b : Fin (B + 1))
    (retained : Finset (Fin s.2.1.val)) :
    0 ≤ boundedGhostSkeletonAbsMass A D t B s b retained := by
  unfold boundedGhostSkeletonAbsMass
  split_ifs
  · exact abs_nonneg _
  · exact le_rfl

theorem bounded_ghost_event_abs_factor {P Z : Type*} (A D C ν : Z → ℝ)
    (hν : ∀ z, 0 ≤ ν z) (t B : ℕ) (s : BoundedOrderedState P Z t B)
    (b : Fin (B + 1)) (retained : Finset (Fin s.2.1.val)) (births : Fin b.val → Z) :
    |boundedGhostEventWeight A D C ν t B s ⟨b, retained, births⟩| =
      boundedGhostSkeletonAbsMass A D t B s b retained *
        ∏ j, |C (births j)| * ν (births j) := by
  have hp : |∏ j, C (births j) * ν (births j)| =
      ∏ j, |C (births j)| * ν (births j) := by
    rw [abs_prod]
    apply prod_congr rfl
    intro j _
    rw [abs_mul, abs_of_nonneg (hν _)]
  unfold boundedGhostEventWeight boundedGhostSkeletonAbsMass
  dsimp only
  split_ifs
  · rw [abs_div, abs_mul, hp, abs_div]
    ring
  · simp only [abs_zero, zero_mul]

noncomputable def unrestrictedBoundedSkeletonMass {P : Type*} (n : P → ℕ)
    (Δ D : ℤ) (ρ V : ℝ) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (stores promotions : Finset (Fin t))
    (e : promotions ↪ ↥(unrestrictedResidueEligible n Δ D s.2.2)) : ℝ :=
  if unrestrictedResidueStorageAllowed n D s.1 stores ∧
      (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) stores promotions e).1 ≤ B then
    (ρ ^ orderedPredicateCount ⟨s.2.1.val, s.2.2⟩ unrestrictedResidueHit *
      ρ ^ orderedPredicateCount (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) stores promotions e) unrestrictedResidueHit) /
          V ^ promotions.card else 0

theorem unrestricted_bounded_skeleton_mass_nonneg {P : Type*} (n : P → ℕ)
    (Δ D : ℤ) (ρ V : ℝ) (hρ : 0 ≤ ρ) (hV : 0 ≤ V) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (stores promotions : Finset (Fin t))
    (e : promotions ↪ ↥(unrestrictedResidueEligible n Δ D s.2.2)) :
    0 ≤ unrestrictedBoundedSkeletonMass n Δ D ρ V t B s stores promotions e := by
  unfold unrestrictedBoundedSkeletonMass
  split_ifs
  · exact div_nonneg (mul_nonneg (pow_nonneg hρ _) (pow_nonneg hρ _)) (pow_nonneg hV _)
  · exact le_rfl

theorem unrestricted_bounded_event_fresh_factor {P : Type*} (n : P → ℕ)
    (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (stores promotions : Finset (Fin t))
    (e : promotions ↪ ↥(unrestrictedResidueEligible n Δ D s.2.2))
    (fresh : UnrestrictedFreshLabels P promotions) :
    unrestrictedBoundedEventWeight n Δ D μ ρ V t B s ⟨stores, promotions, e, fresh⟩ =
      unrestrictedBoundedSkeletonMass n Δ D ρ V t B s stores promotions e *
        unrestrictedFreshWeight μ promotions fresh := by
  unfold unrestrictedBoundedEventWeight unrestrictedEdgeEventMass unrestrictedBoundedSkeletonMass
  dsimp only
  split_ifs
  · rfl
  · exact (zero_mul _).symm

end Bounty
end

section

/- Separating cumulative ledger avoidance leaves the exact original local edge factor. -/

open Finset
open scoped Classical
namespace Bounty

theorem global_birth_bounded_edge_phase_factor {P : Type*} [DecidableEq P]
    (n : P → ℕ) (Δ D : ℤ) (t B : ℕ) (target : Fin t → P) (H : Finset P)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s) :
    globalBirthBoundedEdgePhase n Δ D t B target H s e.1 e.2.1 e.2.2.1 e.2.2.2 =
      (if ∀ i, e.2.2.2 i ∉ H then 1 else 0) *
        globalBirthBoundedEdgePhase n Δ D t B target ∅ s e.1 e.2.1 e.2.2.1 e.2.2.2 := by
  simp only [globalBirthBoundedEdgePhase, notMem_empty]
  split_ifs <;> simp_all

theorem unrestricted_fresh_injective_of_target {P Z : Type*} {N t : ℕ}
    (old : Fin N → Z) (label : Z → P) (promotions : Finset (Fin t))
    {eligible : Finset (Fin N)} (e : promotions ↪ ↥eligible)
    (fresh : UnrestrictedFreshLabels P promotions) (target : Fin t → P)
    (hinj : Function.Injective target)
    (htarget : unrestrictedEdgeTarget old label promotions e fresh = target) :
    Function.Injective fresh := by
  intro i j hij
  apply Subtype.ext
  apply hinj
  have hi : unrestrictedEdgeTarget old label promotions e fresh i.val = fresh i := by
    simp only [unrestrictedEdgeTarget, unrestrictedTargetLabels, dif_neg i.property]
  have hj : unrestrictedEdgeTarget old label promotions e fresh j.val = fresh j := by
    simp only [unrestrictedEdgeTarget, unrestrictedTargetLabels, dif_neg j.property]
  rw [htarget] at hi hj
  exact hi.trans (hij.trans hj.symm)

section Full
variable {N : ℕ} {P : Fin N → Type*} [∀ g, DecidableEq (P g)]
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : SharedActiveLabels P S → Type*) (Δ D : ∀ c, A c → Fin N → ℤ)
  (target : (g : Fin N) → Fin (S g)ᶜ.card → P g)
  (H : (g : Fin N) → Finset (P g))
  (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (e : FullActiveEdgeEvent n S B A Δ D x)

theorem full_edge_ledger_phase_factor :
    fullEdgeLedgerPhase n S B A Δ D target H x e =
      (if ∀ g i, (e.2 g).2.2.2 i ∉ H g then 1 else 0) *
        fullEdgeLedgerPhase n S B A Δ D target (fun _ => ∅) x e := by
  unfold fullEdgeLedgerPhase
  trans (∏ g, if ∀ i, (e.2 g).2.2.2 i ∉ H g then (1 : ℂ) else 0) *
    (∏ g, globalBirthBoundedEdgePhase (n g)
      (Δ (productActiveMemorySplit S B x).1 e.1 g)
      (D (productActiveMemorySplit S B x).1 e.1 g) (S g)ᶜ.card B (target g) ∅
      ((productActiveMemorySplit S B x).2 g)
      (e.2 g).1 (e.2 g).2.1 (e.2 g).2.2.1 (e.2 g).2.2.2)
  · rw [← prod_mul_distrib]
    apply prod_congr rfl
    intro g _
    exact global_birth_bounded_edge_phase_factor _ _ _ _ _ _ _ _ (e.2 g)
  congr 1
  by_cases h : ∀ g i, (e.2 g).2.2.2 i ∉ H g
  · rw [if_pos h]
    calc
      _ = ∏ _g : Fin N, (1 : ℂ) := prod_congr rfl (fun g _ => if_pos (h g))
      _ = 1 := prod_const_one
  · rw [if_neg h]
    obtain ⟨g, hg⟩ := not_forall.mp h
    exact prod_eq_zero (mem_univ g) (if_neg hg)

theorem full_edge_ledger_phase_target_of_nonzero
    (hphase : fullEdgeLedgerPhase n S B A Δ D target H x e ≠ 0) (g : Fin N) :
    unrestrictedEdgeTarget ((productActiveMemorySplit S B x).2 g).2.2 Sigma.fst
      (e.2 g).2.1 (e.2 g).2.2.1 (e.2 g).2.2.2 = target g := by
  by_contra h
  apply hphase
  apply prod_eq_zero (mem_univ g)
  simp only [globalBirthBoundedEdgePhase, h, false_and, if_false]

theorem full_edge_ledger_phase_fresh_injective
    (hphase : fullEdgeLedgerPhase n S B A Δ D target H x e ≠ 0)
    (htarget : ∀ g, Function.Injective (target g)) (g : Fin N) :
    Function.Injective (e.2 g).2.2.2 :=
  unrestricted_fresh_injective_of_target _ _ _ _ _ _ (htarget g)
    (full_edge_ledger_phase_target_of_nonzero n S B A Δ D target H x e hphase g)

end Full
end Bounty
end

section

/- A finite path action only reads its initial value and the kernels in its prefix. -/

open Finset
namespace Bounty

theorem finite_path_action_prefix_congr {X R : Type*} [Fintype X] [Semiring R]
    (K H : ℕ → X → X → R) (f g : X → R) (n : ℕ)
    (hK : ∀ j < n, ∀ x y, K j x y = H j x y) (hf : ∀ x, f x = g x) (x : X) :
    finitePathAction K f n x = finitePathAction H g n x := by
  induction n generalizing x with
  | zero => exact hf x
  | succ n ih =>
    simp only [finitePathAction]
    apply sum_congr rfl
    intro y hy
    rw [hK n (by omega) x y, ih (fun j hj => hK j (by omega)) y]

end Bounty
end

section

/- Multipliers depending only on active labels preserve the independent
permutation symmetry of every pending memory tuple. -/

namespace Bounty

theorem productMemoryPermuteAt_active {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ}
    (x : ProductBoundedOrderedState P Z t B) (g : G)
    (τ : Equiv.Perm (Fin (x g).2.1.val)) :
    (fun h => (productMemoryPermuteAt x g τ h).1) = (fun h => (x h).1) := by
  funext h
  by_cases hh : h = g
  · subst h
    simp only [productMemoryPermuteAt, Function.update_self]
  · simp only [productMemoryPermuteAt, Function.update_of_ne hh]

theorem productMemorySymmetric_mul_active {G : Type*} [DecidableEq G]
    {P Z : G → Type*} {t : G → ℕ} {B : ℕ} {K : Type*} [Mul K]
    (a : (∀ g, Fin (t g) → P g) → K)
    (f : ProductBoundedOrderedState P Z t B → K) (hf : ProductMemorySymmetric f) :
    ProductMemorySymmetric (fun x => a (fun g => (x g).1) * f x) := by
  intro x g τ
  change a (fun h => (productMemoryPermuteAt x g τ h).1) *
    f (productMemoryPermuteAt x g τ) = a (fun h => (x h).1) * f x
  rw [productMemoryPermuteAt_active, hf x g τ]

end Bounty
end

section

/- Exact clean-event extraction on bounded ordered memory states. The
continuation remains symmetric in memory; target labels may repeat. -/

open Finset
open scoped Classical

namespace Bounty

def unrestrictedBoundedCleanTarget {P : Type*} (n : P → ℕ) (Δ : ℤ) {t B : ℕ}
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) (target : Fin t → P) :
    BoundedOrderedState P (UnrestrictedResidueParticle n) t B :=
  (target, ⟨s.2.1, unrestrictedResidueTransport n Δ ∘ s.2.2⟩)

section

variable
  {P : Type*}
  [sharedInstance1 : Fintype P]
  (n : P → ℕ)
  (Δ D : ℤ)
  (μ : P → ℝ)
  (ρ V : ℝ)
  (t B : ℕ)
  (θ : (Fin t → P) → ℂ)
  (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
  (hf : BoundedOrderedSymmetric f)
  (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)

include P sharedInstance1 n Δ D μ ρ V t B θ f hf s

theorem unrestricted_bounded_operator_clean  :
    unrestrictedBoundedOperator n Δ D μ ρ V t B
      (fun s stores promotions e fresh => if stores = ∅ ∧ promotions = ∅ then
        θ (unrestrictedEdgeTarget s.2.2 Sigma.fst promotions e fresh) else 0) f s =
      ((ρ ^ orderedPredicateCount (boundedOrderedTupleToFinite s.2) unrestrictedResidueHit *
        ρ ^ orderedPredicateCount
          (boundedOrderedTupleToFinite (unrestrictedBoundedCleanTarget n Δ s s.1).2)
            unrestrictedResidueHit : ℝ) : ℂ) *
        ∑ target : Fin t → P, ((∏ j, μ (target j) : ℝ) : ℂ) * θ target *
          f (unrestrictedBoundedCleanTarget n Δ s target) := by
  unfold unrestrictedBoundedOperator unrestrictedBoundedAction
  rw [unrestricted_residue_edge_action_clean n Δ D s.1 s.2.2 μ ρ V B θ
    (boundedOrderedZeroExtension f) ((boundedOrderedZeroExtension_symmetric_iff f).mpr hf)]
  rw [if_pos (Nat.le_of_lt_succ s.2.1.isLt)]
  congr 1
  apply sum_congr rfl
  intro target ht
  congr 1
  exact boundedOrderedZeroExtension_apply f (unrestrictedBoundedCleanTarget n Δ s target)

theorem unrestricted_bounded_clean_event_sum  :
    (∑ e : UnrestrictedBoundedEvent n Δ D t B s,
      (unrestrictedBoundedEventWeight n Δ D μ ρ V t B s e : ℂ) *
        (if e.1 = ∅ ∧ e.2.1 = ∅ then
          θ (unrestrictedEdgeTarget s.2.2 Sigma.fst e.2.1 e.2.2.1 e.2.2.2) else 0) *
        f (unrestrictedBoundedEventTarget n Δ D t B s e)) =
      ((ρ ^ orderedPredicateCount (boundedOrderedTupleToFinite s.2) unrestrictedResidueHit *
        ρ ^ orderedPredicateCount
          (boundedOrderedTupleToFinite (unrestrictedBoundedCleanTarget n Δ s s.1).2)
            unrestrictedResidueHit : ℝ) : ℂ) *
        ∑ target : Fin t → P, ((∏ j, μ (target j) : ℝ) : ℂ) * θ target *
          f (unrestrictedBoundedCleanTarget n Δ s target) := by
  exact (unrestricted_bounded_operator_eq_event_sum n Δ D μ ρ V t B
    (fun s stores promotions e fresh => if stores = ∅ ∧ promotions = ∅ then
      θ (unrestrictedEdgeTarget s.2.2 Sigma.fst promotions e fresh) else 0) f s).symm.trans
    (unrestricted_bounded_operator_clean n Δ D μ ρ V t B θ f hf s)

end


theorem unrestricted_bounded_clean_target_fixed_memory {G : Type*}
    {P : G → Finset ℕ} {t B : ℕ} (N : G → Fin (B + 1))
    (p : FixedOrderedMemoryLabels P (fun g => (N g).val)) (r : FixedOrderedResidues p)
    (g : G) (Δ : ℤ) (source target : Fin t → P g) :
    unrestrictedBoundedCleanTarget (fun q : P g => q.val) (-Δ)
      (source, ⟨N g, fun j => ⟨p g j, r g j⟩⟩) target =
      (target, ⟨N g, fun j => ⟨p g j, fixedOrderedResidueTranslate p r Δ g j⟩⟩) := by
  apply congrArg (fun q : Fin (N g).val → UnrestrictedResidueParticle (fun q : P g => q.val) =>
    (target, (⟨N g, q⟩ : BoundedOrderedTuple _ B)))
  funext j
  exact (fixed_ordered_residue_memory_transport_apply p r Δ g j).symm

end Bounty
