/- A fixed-order pair-sieve upper bound, uniform over all local flags. -/

open Finset

namespace Bounty

theorem exists_finite_pair_sieve_upper :
    ∃ K : ℝ, 0 < K ∧ ∀ (A B C D m : ℕ) [NeZero m]
      (P : Finset ℕ) (rough banned : ℕ → Bool) {z : ℝ},
      A ≤ B → C ≤ D → 1 < z →
      (∀ p ∈ P, p.Prime) → (∀ p ∈ P, 3 ≤ p) →
      (∀ p ∈ P, ¬p ∣ m) → (∀ p ∈ P, (p : ℝ) ≤ z) →
      ((pairSieveAvoidance A B C D m P rough banned).card : ℝ) ≤
        K * (((B : ℝ)-A)*((D : ℝ)-C)/(m : ℝ)) *
          (∏ p ∈ P, (1 - pairSieveDensity p (rough p) (banned p))) +
        ((m : ℝ)*(z^(10 : ℝ))^3 + (((B : ℝ)-A)+((D : ℝ)-C))*(z^(10 : ℝ))^2) := by
  obtain ⟨K, hK, hb⟩ := exists_finite_pair_sieve_estimate
  refine ⟨1+K*Real.exp (-2), by positivity, ?_⟩
  intro A B C D m hm P rough banned z hAB hCD hz hP hP3 hPm hPz
  have h := hb A B C D m P rough banned hAB hCD hz (h := 2)
    (by norm_num) (by decide) hP hP3 hPm hPz
  norm_num only [Nat.cast_ofNat] at h
  let V := ∏ p ∈ P, (1 - pairSieveDensity p (rough p) (banned p))
  have hV : 0 ≤ V := prod_nonneg (fun p hp => by
    have hg := (pair_sieve_density_bounds (hP3 p hp) (rough p) (banned p)).2.1
    linarith)
  have hX : 0 ≤ (B : ℝ)-A := sub_nonneg.mpr (Nat.cast_le.mpr hAB)
  have hY : 0 ≤ (D : ℝ)-C := sub_nonneg.mpr (Nat.cast_le.mpr hCD)
  have hm0 : (0 : ℝ) < m := Nat.cast_pos.mpr (Nat.pos_of_ne_zero (NeZero.ne m))
  have hphi : (m.totient : ℝ) ≤ m := Nat.cast_le.mpr (Nat.totient_le m)
  have hmain : ((B : ℝ)-A)*((D : ℝ)-C)*(m.totient : ℝ)/(m : ℝ)^2 ≤
      ((B : ℝ)-A)*((D : ℝ)-C)/(m : ℝ) := by
    apply (div_le_iff₀ (sq_pos_of_pos hm0)).mpr
    have hid : (((B : ℝ)-A)*((D : ℝ)-C)/(m : ℝ))*(m : ℝ)^2 =
        ((B : ℝ)-A)*((D : ℝ)-C)*(m : ℝ) := by field_simp
    rw [hid]
    exact mul_le_mul_of_nonneg_left hphi (mul_nonneg hX hY)
  have hsmall := (le_abs_self _).trans h
  have hmainV := mul_le_mul_of_nonneg_right hmain hV
  have hcoeff : 0 ≤ 1+K*Real.exp (-2) := by positivity
  have hscaled := mul_le_mul_of_nonneg_left hmainV hcoeff
  dsimp [V] at hscaled
  nlinarith

theorem exists_finite_pair_sieve_product_upper :
    ∃ K : ℝ, 0 < K ∧ ∀ (A B C D m : ℕ) [NeZero m]
      (P : Finset ℕ) (rough banned : ℕ → Bool) {z : ℝ},
      A ≤ B → C ≤ D → 1 < z →
      (∀ p ∈ P, p.Prime) → (∀ p ∈ P, 3 ≤ p) →
      (∀ p ∈ P, ¬p ∣ m) → (∀ p ∈ P, (p : ℝ) ≤ z) →
      ((pairSieveAvoidance A B C D m P rough banned).card : ℝ) ≤
        K * (((B : ℝ)-A)*((D : ℝ)-C)/(m : ℝ)) *
          (∏ p ∈ P.filter (fun p => rough p = true), (1 - 1/(p : ℝ)))^2 *
          (∏ p ∈ P.filter (fun p => banned p = true), (1 - 1/(p : ℝ))) +
        ((m : ℝ)*(z^(10 : ℝ))^3 + (((B : ℝ)-A)+((D : ℝ)-C))*(z^(10 : ℝ))^2) := by
  obtain ⟨K, hK, hb⟩ := exists_finite_pair_sieve_upper
  refine ⟨4*K, by positivity, ?_⟩
  intro A B C D m hm P rough banned z hAB hCD hz hP hP3 hPm hPz
  have h := hb A B C D m P rough banned hAB hCD hz hP hP3 hPm hPz
  have hX : 0 ≤ (B : ℝ)-A := sub_nonneg.mpr (Nat.cast_le.mpr hAB)
  have hY : 0 ≤ (D : ℝ)-C := sub_nonneg.mpr (Nat.cast_le.mpr hCD)
  have hc : 0 ≤ K * (((B : ℝ)-A)*((D : ℝ)-C)/(m : ℝ)) := by positivity
  have he := mul_le_mul_of_nonneg_left (pair_sieve_euler_product_le P hP3 rough banned) hc
  apply h.trans
  exact add_le_add (he.trans_eq (by ring)) le_rfl

end Bounty
end

