     filter_upwards [self_mem_nhdsWithin] with t ht
     change 0<t at ht
     have he:=oppositeFrequency_cross_identity h (show (4/3:ℂ)+(t:ℂ)*Complex.I∈{s:ℂ|1<s.re ∧ 0<s.im} by
