noncomputable def candidatePrefixRestChoices (c L eps : ℝ) (r jStar J : ℕ) (hr : 0 < r)
    (slot : {slot : (candidateQIndices c L) × Fin r // slot ≠ candidateFreeSlot c L r hr}) : Finset ℕ :=
  candidatePrefixChoices c L eps r jStar J slot.val

noncomputable def candidatePrefixRestHarmonicMass (c L eps : ℝ) (r jStar J : ℕ) (hr : 0 < r) : ℝ :=
  ∑' n : ℕ,
    orderedSlotWeight
      (candidatePrefixRestChoices c L eps r jStar J hr)
      ((r.factorial : ℝ)^(candidateQIndices c L).card) n / (n : ℝ)

theorem candidate_free_slot_not_in_prefix (c L : ℝ) (r J : ℕ) (hr : 0 < r) :
    candidateFreeSlot c L r hr ∉ candidatePrefixSlots c L r J := by
  simp [candidateFreeSlot, candidatePrefixSlots]

