theorem supported_weighted_product_rational_bilinear_bound
    {X Y : Type*} [Fintype X] [Fintype Y]
    (π : X → ℕ) (τ : Y → ℕ) (a N : ℕ) (A : ℤ) (V : ℕ)
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (f : X → ℂ) (g : Y → ℂ)
    (hπrange : ∀ x, f x ≠ 0 → a ≤ π x ∧ π x < a + N)
    (hτrange : ∀ y, g y ≠ 0 → A ≤ (τ y : ℤ) ∧ (τ y : ℤ) ≤ A + (V : ℤ))
    {C D P Q : ℝ} (hC : 0 ≤ C) (hD : 0 ≤ D) (hP : 0 < P) (hQ : 0 < Q)
    (hπ : ∀ x, f x ≠ 0 → P ≤ (π x : ℝ))
    (hτ : ∀ y, g y ≠ 0 → Q ≤ (τ y : ℝ))
    (hμatom : ∀ m : ℕ,
      (∑ x ∈ Finset.univ.filter (fun x => π x = m), μ x) ≤ C / (m : ℝ))
    (hνatom : ∀ m : ℕ,
      (∑ y ∈ Finset.univ.filter (fun y => τ y = m), ν y) ≤ D / (m : ℝ))
    {u : ℤ} {r : ℕ} (hr : 0 < r) (hcop : (r : ℤ).gcd u = 1)
    {β : ℝ} (hβ : |β| ≤ 1 / (r : ℝ) ^ 2) :
    ‖∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) *
      (Complex.exp (Complex.I * (2 * Real.pi *
        (((u : ℝ) / r + β) * τ y) : ℝ))) ^ (π x)‖ ^ 2 ≤
      ((1 + 3 * (V : ℝ) / r) *
        (2 * (N : ℝ) + 2 * (r : ℝ) * (1 + Real.log r))) *
          ((C / P) * ∑ x, μ x * ‖f x‖ ^ 2) *
          ((D / Q) * ∑ y, ν y * ‖g y‖ ^ 2) := by
  let SX := {x : X // f x ≠ 0}
  let SY := {y : Y // g y ≠ 0}
  have hμatomS (m : ℕ) :
      (∑ x ∈ Finset.univ.filter (fun x : SX => π x.val = m), μ x.val) ≤ C / (m : ℝ) :=
    (finite_subtype_fiber_mass_le (fun x => f x ≠ 0) π μ hμ m).trans (hμatom m)
  have hνatomS (m : ℕ) :
      (∑ y ∈ Finset.univ.filter (fun y : SY => τ y.val = m), ν y.val) ≤ D / (m : ℝ) :=
    (finite_subtype_fiber_mass_le (fun y => g y ≠ 0) τ ν hν m).trans (hνatom m)
  have hb := weighted_product_rational_bilinear_bound
    (fun x : SX => π x.val) (fun y : SY => τ y.val) a N A V
    (fun x => hπrange x.val x.property) (fun y => hτrange y.val y.property)
    (fun x => μ x.val) (fun y => ν y.val) (fun x => hμ x.val) (fun y => hν y.val)
    (fun x => f x.val) (fun y => g y.val) hC hD hP hQ
    (fun x => hπ x.val x.property) (fun y => hτ y.val y.property)
    hμatomS hνatomS hr hcop hβ
  have he := finite_test_support_bilinear μ ν f g (fun x y =>
    (Complex.exp (Complex.I * (2 * Real.pi *
      (((u : ℝ) / r + β) * τ y) : ℝ))) ^ (π x))
  rw [he] at hb
  simpa only [SX, SY, finite_test_support_energy] using hb
