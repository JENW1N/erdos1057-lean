/- The original nonzero ambient interval factors have unit caps and small-modulus coprimality. -/

open Finset Filter

namespace Bounty

private theorem restricted_interval_rough_properties (L : ℝ) (lo hi : ℕ) (f : ℕ → ℝ)
    {q : ℕ} (hq : 0 < q) (hqW : (q : ℝ) ≤ Real.exp (Real.sqrt L))
    (hf : ∀ n, |f n| ≤ 1)
    (hrough : ∀ n, f n ≠ 0 → ∀ p ∈ n.primeFactors, Real.exp (Real.sqrt L) < (p : ℝ)) :
    (∀ n, ‖(typeIIRestrict (Ioc lo hi) f n : ℂ)‖ ≤ 1) ∧
    ∀ n ∈ (Ioc lo hi).filter (fun n => (typeIIRestrict (Ioc lo hi) f n : ℂ) ≠ 0),
      0 < n ∧ n.Coprime q := by
  constructor
  · intro n
    simpa only [Complex.norm_real,Real.norm_eq_abs] using
      typeIIRestrict_abs_le zero_le_one (fun n _ => hf n) n
  · intro n hn
    obtain ⟨hnI,hnz⟩ := mem_filter.mp hn
    have hn0 : 0 < n := (Nat.zero_le lo).trans_lt (mem_Ioc.mp hnI).1
    have hnR : typeIIRestrict (Ioc lo hi) f n ≠ 0 := by
      intro hz
      exact hnz (by rw [hz]; rfl)
    have hfn := ((typeIIRestrict_ne_zero_iff _ _ _).mp hnR).2
    have hqZ : (q : ℤ) ≠ 0 := by exact_mod_cast hq.ne'
    have hsmall : (((q : ℤ).natAbs) : ℝ) ≤ Real.exp (Real.sqrt L) := by
      simpa only [Int.natAbs_natCast] using hqW
    exact ⟨hn0, by simpa only [Int.natAbs_natCast] using
      typeII_rough_coprime_natAbs hn0 hqZ (hrough n hfn) hsmall⟩

theorem eventually_rational_prime_M_properties (S Rmod : ℝ) (hS : 0 ≤ S) :
    ∀ᶠ L : ℝ in atTop, ∀ κ : ℝ, 0 ≤ κ → κ ≤ 1/50 → ∀ lo hi qRat : ℕ,
      0 < qRat → (qRat : ℝ) ≤ L^Rmod →
      (∀ n, ‖(typeIIRestrict (Ioc lo hi) (ambientPrimeTypeIIAlpha κ L S) n : ℂ)‖ ≤ 1) ∧
      ∀ n ∈ (Ioc lo hi).filter (fun n =>
        (typeIIRestrict (Ioc lo hi) (ambientPrimeTypeIIAlpha κ L S) n : ℂ) ≠ 0),
        0 < n ∧ n.Coprime qRat := by
  filter_upwards [eventually_balanced_typeII_coefficient_properties S hS,
    eventually_rpow_le_exp_sqrt Rmod] with L hL hmod
  intro κ hκ hκmax lo hi qRat hq hqR
  exact restricted_interval_rough_properties L lo hi _ hq (hqR.trans hmod)
    (fun n => (hL κ hκ hκmax n).1)
    (fun n hn => ((hL κ hκ hκmax n).2.2.2 hn).2)

theorem eventually_rational_rough_M_properties {γ : ℝ} (hγ : 0 < γ) (Rmod : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ S a v : ℝ, ∀ lo hi qRat : ℕ,
      0 < qRat → (qRat : ℝ) ≤ L^Rmod →
      (∀ n, ‖(typeIIRestrict (Ioc lo hi) (ambientRoughIntervalTypeIIAlpha γ L S a v) n : ℂ)‖ ≤ 1) ∧
      ∀ n ∈ (Ioc lo hi).filter (fun n =>
        (typeIIRestrict (Ioc lo hi) (ambientRoughIntervalTypeIIAlpha γ L S a v) n : ℂ) ≠ 0),
        0 < n ∧ n.Coprime qRat := by
  filter_upwards [eventually_ambient_rough_interval_typeII_properties hγ,
    eventually_rpow_le_exp_sqrt Rmod] with L hL hmod
  intro S a v lo hi qRat hq hqR
  exact restricted_interval_rough_properties L lo hi _ hq (hqR.trans hmod)
    (fun n => (hL S a v n).1) (fun n hn => ((hL S a v n).2 hn).2)

end Bounty
