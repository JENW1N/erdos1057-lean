section

/- Elementary side conditions for the exact prime-kernel parameter chain and
its two disjoint collections of mapped probe slots. -/

open Finset Filter

namespace Bounty

/- All six parameters in the actual prime-kernel construction are nonnegative.
The fiber factor is at least one for every `v` and `m`. -/
theorem repeated_big_prime_kernel_exponents_nonneg
    (s z a v D ε : ℝ) (m : ℕ)
    (hs : 0 ≤ s) (hz : 0 ≤ z) (ha : 0 ≤ a) (hD : 0 ≤ D) (hε : 0 ≤ ε) :
    let κ := a * Real.log (primeFiberFactorBound v m)
    let s' := s + ε
    let A₀ := D + 2 * (s' + 1)
    let q := 2 * κ + (s' + 1) + 2 * A₀ + 3
    let w := 4 * q + max z q + A₀ + 2
    let x := (s' + w + 2) + 2 * A₀ + 2
    0 ≤ κ ∧ 0 ≤ s' ∧ 0 ≤ A₀ ∧ 0 ≤ q ∧ 0 ≤ w ∧ 0 ≤ x := by
  intro κ s' A₀ q w x
  have hk : 0 ≤ κ := mul_nonneg ha (Real.log_nonneg (one_le_primeFiberFactorBound v m))
  have hs' : 0 ≤ s' := add_nonneg hs hε
  have hA : 0 ≤ A₀ := by dsimp [A₀]; positivity
  have hq : 0 ≤ q := by dsimp [q]; positivity
  have hmz : 0 ≤ max z q := hz.trans (le_max_left _ _)
  have hw : 0 ≤ w := add_nonneg (add_nonneg (add_nonneg
    (mul_nonneg (by norm_num) hq) hmz) hA) (by norm_num)
  have hx : 0 ≤ x := by dsimp [x]; positivity
  exact ⟨hk, hs', hA, hq, hw, hx⟩

/- Disjoint blocks use at most `m` mapped probes per group in total. -/
theorem repeated_big_prime_mapped_probe_card_le {G : Type*}
    [Fintype G] [DecidableEq G] {J ell m : ℕ}
    (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    (hp : ∀ g, (probes g).card ≤ m) :
    (r.sigma (fun g => (probes g).map (Function.Embedding.inl (β := Fin ell)))).card +
      (t.sigma (fun g => (probes g).map (Function.Embedding.inl (β := Fin ell)))).card ≤
        m * Fintype.card G := by
  have hcard : r.card + t.card ≤ Fintype.card G := by
    rw [← card_union_of_disjoint hrt]
    exact card_le_univ _
  calc
    _ ≤ m * r.card + m * t.card := Nat.add_le_add
      (repeated_big_prime_probe_sigma_card_le (ell := ell) probes r hp)
      (repeated_big_prime_probe_sigma_card_le (ell := ell) probes t hp)
    _ = m * (r.card + t.card) := by ring
    _ ≤ _ := Nat.mul_le_mul_left m hcard

/- Polynomially many visits leave a positive baseline at every prime above
the exponential lower cutoff. The threshold is uniform in both cutoffs. -/
theorem eventually_repeated_big_baseline_pos {c tau : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ T P : ℝ,
      0 ≤ T → T ≤ L ^ tau → Real.exp (L ^ c) ≤ P →
      T / P ≤ 1 / 2 ∧ ∀ p : ℝ, P ≤ p → 0 < 1 - T / p := by
  filter_upwards [eventually_exp_neg_rpow_mul_rpow_le hc
    (show (0 : ℝ) < 1 by norm_num) tau 1, eventually_ge_atTop (2 : ℝ)]
    with L hsmall hL
  intro T P hT0 hT hP
  have hP0 : 0 < P := lt_of_lt_of_le (Real.exp_pos _) hP
  have hratio : T / P ≤ 1 / 2 := by
    calc
      _ ≤ L ^ tau / Real.exp (L ^ c) := div_le_div₀
        (Real.rpow_nonneg (by linarith) tau) hT (Real.exp_pos _) hP
      _ = Real.exp (-1 * L ^ c) * L ^ tau := by
        simp only [neg_mul, one_mul, Real.exp_neg]
        ring
      _ ≤ L ^ (-(1 : ℝ)) := hsmall
      _ ≤ 1 / 2 := by
        rw [Real.rpow_neg_one, inv_eq_one_div]
        exact one_div_le_one_div_of_le (by norm_num) hL
  refine ⟨hratio, ?_⟩
  intro p hp
  have hratio' : T / p ≤ 1 / 2 :=
    (div_le_div_of_nonneg_left hT0 hP0 hp).trans hratio
  linarith

end Bounty
end

section

/- The mask average equals the actual power weight on shifted prime divisibility. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem odd_masked_pair_box_filter (a b c d m : ℕ) (W z : ℝ) (P S : Finset ℕ)
    (hP : P ⊆ primeBand 0 z) (hPm : ∀ p ∈ P, ¬p ∣ m) (hP2 : 2 ∉ P) (hS : S ⊆ P) :
    oddMaskedPairBox a b c d m W z S =
      (oddMaskedPairBox a b c d m W z P).filter (fun v => pairShiftedPrimeSet P v ⊆ S) := by
  classical
  apply Finset.ext
  intro v
  rw [mem_filter]
  simp only [oddMaskedPairBox, mem_filter]
  change _ ↔ _ ∧ P.filter (fun p => (v.1*v.2) % p = 1 % p) ⊆ S
  constructor
  · rintro ⟨hbase, hrough, hban⟩
    refine ⟨⟨hbase, hrough, ?_⟩, ?_⟩
    · intro p hp hp2 hpm hpP
      exact hban p hp hp2 hpm (fun hpS => hpP (hS hpS))
    · intro p hp
      obtain ⟨hpP, hpone⟩ := mem_filter.mp hp
      by_contra hpS
      exact hban p (hP hpP) (fun he => hP2 (he ▸ hpP)) (hPm p hpP) hpS hpone
  · rintro ⟨⟨hbase, hrough, hban⟩, hforced⟩
    refine ⟨hbase, hrough, ?_⟩
    intro p hp hp2 hpm hpS hpone
    by_cases hpP : p ∈ P
    · exact hpS (hforced (mem_filter.mpr ⟨hpP, hpone⟩))
    · exact hban p hp hp2 hpm hpP hpone

theorem odd_masked_pair_average_eq_power_weight (a b c d m : ℕ) (W z q : ℝ)
    (P : Finset ℕ) (hP : P ⊆ primeBand 0 z) (hPm : ∀ p ∈ P, ¬p ∣ m) (hP2 : 2 ∉ P) :
    (∑ S ∈ P.powerset, bernoulliSubsetWeight q P S *
      ((oddMaskedPairBox a b c d m W z S).card : ℝ)) =
      ∑ v ∈ oddMaskedPairBox a b c d m W z P, q^(pairShiftedPrimeSet P v).card := by
  classical
  calc
    _ = ∑ S ∈ P.powerset, ∑ v ∈ oddMaskedPairBox a b c d m W z P,
        if pairShiftedPrimeSet P v ⊆ S then bernoulliSubsetWeight q P S else 0 := by
      apply sum_congr rfl
      intro S hS
      rw [odd_masked_pair_box_filter a b c d m W z P S hP hPm hP2 (mem_powerset.mp hS)]
      have hc : (((oddMaskedPairBox a b c d m W z P).filter
          (fun v => pairShiftedPrimeSet P v ⊆ S)).card : ℝ) =
          ∑ v ∈ oddMaskedPairBox a b c d m W z P,
            if pairShiftedPrimeSet P v ⊆ S then (1 : ℝ) else 0 := by simp
      rw [hc, mul_sum]
      apply sum_congr rfl
      intro v _
      split_ifs <;> simp
    _ = ∑ v ∈ oddMaskedPairBox a b c d m W z P,
        ∑ S ∈ P.powerset, if pairShiftedPrimeSet P v ⊆ S then bernoulliSubsetWeight q P S else 0 :=
      sum_comm
    _ = _ := by
      apply sum_congr rfl
      intro v _
      exact bernoulli_mask_contains P (pairShiftedPrimeSet P v) (filter_subset _ _) q

theorem odd_masked_pair_average_eq_divisor_weight (a b c d m : ℕ) (W z q : ℝ)
    (P : Finset ℕ) (hP : P ⊆ primeBand 0 z) (hPm : ∀ p ∈ P, ¬p ∣ m) (hP2 : 2 ∉ P) :
    (∑ S ∈ P.powerset, bernoulliSubsetWeight q P S *
      ((oddMaskedPairBox a b c d m W z S).card : ℝ)) =
      ∑ v ∈ oddMaskedPairBox a b c d m W z P, q^((P.filter (fun p => p ∣ v.1*v.2-1)).card) := by
  rw [odd_masked_pair_average_eq_power_weight a b c d m W z q P hP hPm hP2]
  apply sum_congr rfl
  intro v hv
  have hbase := (mem_filter.mp hv).1
  simp only [pairSieveBaseBox, Finset.product_eq_sprod, mem_filter, mem_product, mem_Ioc] at hbase
  have hx : 0 < v.1 := lt_of_le_of_lt (Nat.zero_le a) hbase.1.1.1
  have hy : 0 < v.2 := lt_of_le_of_lt (Nat.zero_le c) hbase.1.2.1
  rw [pair_shifted_prime_set_eq_divisors P v (Nat.succ_le_of_lt (mul_pos hx hy))]

theorem exists_candidate_odd_shifted_divisor_pair_bound :
    ∃ K : ℝ, 0 < K ∧ ∀ (γ q : ℝ), 0 < γ → 0 ≤ q → q ≤ 1 →
      ∀ᶠ L : ℝ in atTop, ∀ (a b c d m : ℕ) [NeZero m] (W z : ℝ) (P : Finset ℕ),
        (m : ℝ) ≤ Real.exp L → (∀ p ∈ m.primeFactors, L^2 ≤ (p : ℝ)) →
        a ≤ b → c ≤ d → 0 ≤ W → W ≤ z → 1 < z →
        P ⊆ (candidatePIndices γ L).biUnion (candidatePBand (γ*L)) →
        P ⊆ primeBand 0 z → (∀ p ∈ P, ¬p ∣ m) → 2 ∉ P →
        (∑ v ∈ oddMaskedPairBox a b c d m W z P,
          q^((P.filter (fun p => p ∣ v.1*v.2-1)).card)) ≤
          K * (((b : ℝ)-a)*((d : ℝ)-c)/(m : ℝ)) *
            (∏ p ∈ primeBand 0 W, (1 - 1/(p : ℝ)))^2 *
            (∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ))) *
            candidateOneMarkedHarmonicMass γ L q +
          ((m : ℝ)*(z^(10 : ℝ))^3 + (((b : ℝ)-a)+((d : ℝ)-c))*(z^(10 : ℝ))^2) := by
  obtain ⟨K, hK, hb⟩ := exists_candidate_odd_masked_pair_bound
  refine ⟨K, hK, ?_⟩
  intro γ q hγ hq0 hq1
  filter_upwards [hb γ q hγ hq0 hq1] with L h
  intro a b c d m hm W z P hmL hmin hab hcd hW hWz hz hP hPz hPm hP2
  rw [← odd_masked_pair_average_eq_divisor_weight a b c d m W z q P hPz hPm hP2]
  exact h a b c d m W z P hmL hmin hab hcd hW hWz hz hP

end Bounty
end

