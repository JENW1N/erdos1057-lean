open Finset
abbrev GhostFiniteState (R : Type*) := Option (Option R)

/- Initial mass is concentrated at the unborn state. -/
def ghostFiniteInitial {R : Type*} : GhostFiniteState R → ℝ
  | none => 1
  | some _ => 0

/- The first state argument is the output, the second is the input.
This orientation makes `finitePathAction` propagate distributions forward. -/
noncomputable def ghostFiniteKernel {R : Type*} [DecidableEq R]
    (hit : R) (η β : ℝ) : GhostFiniteState R → GhostFiniteState R → ℝ
  | none, none => 1
  | none, some _ => 0
  | some none, none => 0
  | some none, some none => 1
  | some none, some (some r) => if r = hit then -η else 0
  | some (some r), none => if r = hit then -β * η else 0
  | some (some _), some none => 0
  | some (some r), some (some s) =>
      if s = r then 1 - η * (if r = hit then 1 else 0) else 0

/- Embed the scalar ghost recurrence into a finite vector. -/
def ghostFiniteVector {R : Type*} (s : GhostLifespanState R) : GhostFiniteState R → ℝ
  | none => 1
  | some none => s.completed
  | some (some r) => s.pending r









end

