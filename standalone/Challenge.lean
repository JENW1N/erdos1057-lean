section

variable {J : Type uJ} {K : Type uK} {G : Type uG} {P : G → Type uP}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type uA)
  (Δ D : ∀ k c, A k c → G → ℤ)

def FullPermutationMixedEvent : Option (J ⊕ K) →
    ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → Type _
  | none, _ => ULift.{max uA uP} (FullActiveSlotPermutations M)
  | some k, s => FullMixedMemoryEvent n S B A Δ D k s

noncomputable abbrev fullPermutationMixedEventFintype [Fintype G] [DecidableEq G]
    [∀ g, Fintype (P g)] [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)]
    (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    Fintype (FullPermutationMixedEvent n S B A Δ D k s) := by
  cases k with
  | none => dsimp [FullPermutationMixedEvent]; infer_instance
  | some k => exact fullMixedMemoryEventFintype n S B A Δ D k s

noncomputable def fullPermutationMixedEventTarget (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullPermutationMixedEvent n S B A Δ D k s →
      ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B :=
  match k with
  | none => fun e => fullActivePermutation e.down s
  | some k => fullMixedMemoryEventTarget n S B A Δ D k s

noncomputable def fullPermutationMixedEventWeight [Fintype G] [DecidableEq G]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (k : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullPermutationMixedEvent n S B A Δ D k s → ℝ :=
  match k with
  | none => fun e => fullActivePermutationWeight M e.down
  | some k => fullMixedMemoryEventWeight n S B A Δ D ω μ q ρ V k s







end
