section

/- Uniform length-weighted rows for the original joint and full auxiliary edge events. -/

open Finset Classical

namespace Bounty

theorem unrestricted_edge_row_bound_nonneg {ρ v vmin : ℝ} (hρ : ρ < 1)
    (hv : 0 ≤ v) (T : ℕ) : 0 ≤ unrestrictedEdgeRowBound ρ v vmin T := by
  unfold unrestrictedEdgeRowBound unrestrictedEdgeChoiceBound
  exact mul_nonneg (by positivity)
    (mul_nonneg (mul_nonneg (unrestrictedEdgeDampingBound_nonneg hρ T) (pow_nonneg hv _))
      (by positivity))

theorem unrestricted_joint_length_row_le {G : Type*} [Fintype G]
    {P : G → Type*} [∀ g, Fintype (P g)] (n : ∀ g, P g → ℕ)
    (Δ D : G → ℤ) (μ : ∀ g, P g → ℝ) {ρ v vmin : ℝ} (V : G → ℝ)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g) (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (t : G → ℕ) (B T : ℕ) (ht : ∀ g, t g ≤ T)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    (∑ e : UnrestrictedJointEvent n Δ D t B s,
      |unrestrictedJointCutoffEventWeight n Δ D μ ρ V t B s e| *
        productLengthLyapunov v (unrestrictedJointEventTarget n Δ D t B s e)) ≤
      productLengthLyapunov v s * unrestrictedEdgeRowBound ρ v vmin T ^ Fintype.card G := by
  have h := finite_product_gated_row_le
    (fun g => unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B (s g))
    (fun g e => v ^ (unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B (s g) e).2.1.val)
    (fun _ _ => pow_nonneg (zero_lt_one.trans hv).le _)
    (fun g => v ^ (s g).2.1.val * unrestrictedEdgeRowBound ρ v vmin T)
    (fun g => unrestricted_bounded_length_row_le (n g) (Δ g) (D g) (μ g)
      hρ0 hρ1 hv hvmin (hV g) (hμ g) (hmass g) (t g) B T (ht g) (s g))
    (fun e => productTotalMemory s ≤ B ∧
      productTotalMemory (unrestrictedJointEventTarget n Δ D t B s e) ≤ B)
  simpa only [unrestrictedJointCutoffEventWeight, unrestrictedJointEventTarget,
    productLengthLyapunov, prod_mul_distrib, prod_const, card_univ] using h

theorem full_active_edge_length_row_le {G : Type*} [Fintype G]
    {P : G → Type*} [∀ g, Fintype (P g)] (n : ∀ g, P g → ℕ)
    {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : SharedActiveLabels P S → Type*) [∀ c, Fintype (A c)]
    (Δ D : ∀ c, A c → G → ℤ) (ω : ∀ c, A c → ℝ)
    (μ : ∀ g, P g → ℝ) {ρ v vmin : ℝ} (V : G → ℝ)
    (hω : ∀ c a, 0 ≤ ω c a) (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g) (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (S g)ᶜ.card ≤ T)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    (∑ e : FullActiveEdgeEvent n S B A Δ D s, |fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V s e| *
      productLengthLyapunov v (fullActiveEdgeEventTarget n S B A Δ D s e)) ≤
      productLengthLyapunov v s * unrestrictedEdgeRowBound ρ v vmin T ^ Fintype.card G := by
  let c := (productActiveMemorySplit S B s).1
  let r := (productActiveMemorySplit S B s).2
  have hL : 0 ≤ productLengthLyapunov v s * unrestrictedEdgeRowBound ρ v vmin T ^ Fintype.card G :=
    mul_nonneg (productLengthLyapunov_nonneg (zero_lt_one.trans hv).le s)
      (pow_nonneg (unrestricted_edge_row_bound_nonneg hρ1 (zero_lt_one.trans hv).le T) _)
  rw [Fintype.sum_sigma]
  simp only [fullActiveEdgeEventWeight, abs_mul, fullActiveEdgeEventTarget,
    productLengthLyapunov_reassemble, abs_of_nonneg (hω _ _), mul_assoc, ← mul_sum]
  calc
    _ ≤ ∑ a : A c, ω c a *
        (productLengthLyapunov v r * unrestrictedEdgeRowBound ρ v vmin T ^ Fintype.card G) := by
      apply sum_le_sum
      intro a _
      exact mul_le_mul_of_nonneg_left
        (unrestricted_joint_length_row_le n (Δ c a) (D c a) μ V hρ0 hρ1 hv hvmin hV hμ hmass
          (fun g => (S g)ᶜ.card) B T ht r) (hω c a)
    _ = (∑ a : A c, ω c a) *
        (productLengthLyapunov v s * unrestrictedEdgeRowBound ρ v vmin T ^ Fintype.card G) := by
      rw [← sum_mul, productLengthLyapunov_split]
    _ ≤ _ := by simpa only [one_mul] using mul_le_mul_of_nonneg_right (hωmass c) hL

end Bounty
