  else 0

section

variable
  (c L q : ℝ)
  (r jStar : ℕ)
  (S : Finset ℕ)
  (take : Fin ((candidateQIndices c L).card*r) → Bool)
  (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ)

include c L q r jStar S take twist

theorem candidate_retained_cutoff_coefficient_eq_weight  (h : ℕ) :
    candidateRetainedCutoffCoefficient c L q r jStar S take twist h =
      (candidateRetainedCutoffWeight c L q S h : ℂ) *
        candidateRemainingComplexCoefficient c L r jStar take twist
          (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) h) := by
  unfold candidateRetainedCutoffCoefficient candidateRetainedCutoffWeight
    candidateRetainedComplexCoefficient
  split_ifs <;> simp

theorem candidate_retained_cutoff_coefficient_eq_zero_of_not_mem
     {h : ℕ}
    (hh : h ∉ candidateRetainedAllocationSupport c L r jStar S take) :
    candidateRetainedCutoffCoefficient c L q r jStar S take twist h = 0 := by
  classical
  let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
  by_cases hp : primePoolPart P h ∈ S
  · have hn : primePoolFreePart P h ∉ orderedSlotProductSupport
        (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val) := by
      intro hn
      apply hh
      exact mem_image.mpr ⟨(primePoolPart P h, primePoolFreePart P h),
        mem_product.mpr ⟨hp, hn⟩, primePoolPart_mul_primePoolFreePart P h⟩
    have hzero : candidateRemainingComplexCoefficient c L r jStar take twist
        (primePoolFreePart P h) = 0 := by
      unfold candidateRemainingComplexCoefficient
      rw [ordered_slot_complex_weight_support _ _ hn, zero_div]
    rw [candidateRetainedCutoffCoefficient, if_pos hp, candidateRetainedComplexCoefficient,
      hzero, mul_zero]
  · exact if_neg hp

end


theorem eventually_candidate_retained_cutoff_support {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (S : Finset ℕ),
      (∀ p ∈ S, p ∈ Nat.factoredNumbers
        ((candidatePIndices c L).biUnion (candidatePBand (c*L)))) →
      ∀ (take : Fin ((candidateQIndices c L).card*r) → Bool)
        (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (h : ℕ),
      candidateRetainedCutoffCoefficient c L q r jStar S take twist h =
        if h ∈ candidateRetainedAllocationSupport c L r jStar S take then
          candidateRetainedComplexCoefficient c L q r jStar take twist h else 0 := by
  classical
  filter_upwards [eventually_candidate_remaining_support_free hc] with L hfree
  intro q r jStar S hS take twist h
  by_cases hh : h ∈ candidateRetainedAllocationSupport c L r jStar S take
  · rw [if_pos hh]
    obtain ⟨⟨p,n⟩, hpn, rfl⟩ := mem_image.mp hh
    obtain ⟨hp, hn⟩ := mem_product.mp hpn
    obtain ⟨hn0, hnfree⟩ := hfree r jStar take n hn
    unfold candidateRetainedCutoffCoefficient
    rw [primePoolPart_mul_of_free (hS p hp) hn0 hnfree, if_pos hp]
  · rw [if_neg hh]
    exact candidate_retained_cutoff_coefficient_eq_zero_of_not_mem c L q r jStar S take twist hh

theorem candidate_retained_cutoff_weight_mul_free_left (c L q : ℝ) (S : Finset ℕ)
    {m h : ℕ} (hm : m ≠ 0) (hh : h ≠ 0)
    (hfree : Disjoint m.primeFactors
      ((candidatePIndices c L).biUnion (candidatePBand (c*L)))) :
    candidateRetainedCutoffWeight c L q S (m*h) = candidateRetainedCutoffWeight c L q S h := by
  unfold candidateRetainedCutoffWeight
  rw [prime_pool_part_mul_free_left hm hh hfree]
  split_ifs
  · simpa only [Nat.mul_comm] using candidate_marked_weight_mul_of_free c L q hm hfree h
  · rfl


end Bounty
end

section

/- The actual prime exceptional set has a uniform residual energy bound.
The interval cardinality input is discharged by the proved growing moments. -/

open Filter Finset MeasureTheory

namespace Bounty

theorem eventually_prime_exceptional_residual_energy
    {a beta c A B d C : ℝ}
    (ha : 0 < a) (ha1 : a ≤ 1) (hbeta : beta < 1) (hc : 0 ≤ c) (hA : 0 ≤ A)
    (hB : 1 ≤ B) (hd : 0 < d) :
    ∀ᶠ L : ℝ in atTop, ∀ (s : Finset ℕ), (∀ p ∈ s, Nat.Prime p) →
      ∀ (coeff : s → ℂ) (Y P R U : ℝ),
      1 ≤ Y → d * L ≤ Real.log Y → Real.log Y ≤ c * L →
      Real.exp (L ^ a) / 2 ≤ P → P ≤ Real.exp (L ^ beta) →
      0 ≤ R → R ≤ Y →
      (∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P) →
      (∀ p : s, ‖coeff p‖ ≤ B) → Y ^ (3 / 5 : ℝ) ≤ U →
      ∀ (lo hi : ℕ) (w : ℕ → ℂ), U ≤ (lo : ℝ) → (hi : ℝ) ≤ 2 * U →
      (∑ n ∈ Finset.Icc lo hi, ‖w n‖ ^ 2) ≤ L ^ C / U →
      (∫ t in primeExceptionalTimes s coeff (L ^ (-A)) R,
        ‖∑ n ∈ Finset.Icc lo hi, w n *
          Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)‖ ^ 2) ≤ L ^ (C + 2) := by
  filter_upwards [eventually_prime_exceptional_sparse_absorption ha ha1 hbeta hc hA hB hd,
    eventually_sparse_logarithmic_prefactor_le_square hc,
    eventually_constant_le_rpow_of_log_lower hd zero_lt_one (by norm_num : (0 : ℝ) < 2),
    eventually_gt_atTop (0 : ℝ)] with L habs hbudget htwo hL
  intro s hs coeff Y P R U hY hlo hhi hPlo hPhi hR hRY hband hcoeff hU
    lo hi w hlow hhigh henergy
  have hY0 : 0 < Y := zero_lt_one.trans_le hY
  have hY2 : 2 ≤ Y := by simpa only [Real.rpow_one] using htwo Y hY0 hlo
  have hU1 : 1 ≤ U := (Real.one_le_rpow hY (by norm_num : (0 : ℝ) ≤ 3 / 5)).trans hU
  have hcard := habs s hs coeff Y P R U hY hlo hhi hPlo hPhi hR hRY hband hcoeff hU
  have hraw := prime_exceptional_integral_logarithmic_bound s coeff (L ^ (-A)) R
    lo hi (2 * ⌈R⌉₊ + 2) w hU1 hlow hhigh (by push_cast; rfl) hcard henergy
  have hpref := hbudget Y (2 * ⌈R⌉₊ + 2) hY0 (by omega)
    (prime_exceptional_time_span_le hR hRY hY2) hhi
  calc
    _ ≤ (72 * Real.pi * (1 + 2 * (1 + Real.log (2 * ⌈R⌉₊ + 2 : ℕ))) + 1) * L ^ C := hraw
    _ ≤ L ^ (2 : ℕ) * L ^ C := mul_le_mul_of_nonneg_right hpref (Real.rpow_nonneg hL.le C)
    _ = L ^ (C + 2) := by rw [← Real.rpow_two, ← Real.rpow_add hL]; congr 1; ring

end Bounty
end

section

/- The progression bound controls each divisor term for every Dirichlet character. -/

open Finset

namespace Bounty

theorem exists_divisor_character_logarithmic_bound (τ : ℝ) (hτ : 0 < τ) :
    ∃ δ D N0 : ℝ, 0 < δ ∧ 0 < D ∧ 1 ≤ N0 ∧
      ∀ (Y x u : ℝ) (a b d q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
      0 < d → Y ≤ (a : ℝ)+1 → (b : ℝ) ≤ 2*Y →
      N0 ≤ Y/((d : ℝ)*(q : ℝ)) →
      1 ≤ x → x^(τ/2) ≤ Y/((d : ℝ)*(q : ℝ)) → u ≠ 0 → |u| ≤ x^2 →
      ‖∑ n ∈ (Ioc a b).filter (fun n => d ∣ n),
        χ (n : ZMod q)*Complex.exp (((u*Real.log (n : ℝ) : ℝ) : ℂ)*Complex.I)‖ ≤
        D*(Y/(d : ℝ))*(1/|u|+(Y/((d : ℝ)*(q : ℝ)))^(-δ)) := by
  obtain ⟨δ,D,N0,hδ,hD,hN0,hres⟩ := exists_divisor_residue_logarithmic_bound τ hτ
  refine ⟨δ,D,N0,hδ,hD,hN0,?_⟩
  intro Y x u a b d q hqInst χ hd hYa hbY hN hx hxN hu hux
  have hdR : 0 < (d : ℝ) := by exact_mod_cast hd
  have hqR : 0 < (q : ℝ) := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne q)
  let E : ℝ := D*(Y/((d : ℝ)*(q : ℝ)))*(1/|u|+(Y/((d : ℝ)*(q : ℝ)))^(-δ))
  have hNr : 0 < Y/((d : ℝ)*(q : ℝ)) := lt_of_lt_of_le (by linarith) hN
  have hE : 0 ≤ E := by dsimp [E]; positivity
  let F : ℕ → ℂ := fun m => Complex.exp (((u*Real.log ((m : ℝ)*(d : ℝ)) : ℝ) : ℂ)*Complex.I)
  have hc : ‖∑ m ∈ Ioc (a/d) (b/d), χ (m : ZMod q)*F m‖ ≤ (q : ℝ)*E := by
    apply character_sum_le_residue_phase_bounds _ χ F hE
    intro r hr
    exact hres Y x u a b d q r hd hYa hbY hN hx hxN hu hux
  rw [sum_interval_multiples a b d hd]
  have he : (∑ m ∈ Ioc (a/d) (b/d),
      χ ((m*d : ℕ) : ZMod q)*Complex.exp (((u*Real.log ((m*d : ℕ) : ℝ) : ℝ) : ℂ)*Complex.I)) =
      χ (d : ZMod q)*(∑ m ∈ Ioc (a/d) (b/d), χ (m : ZMod q)*F m) := by
    rw [mul_sum]
    apply sum_congr rfl
    intro m hm
    simp only [Nat.cast_mul,map_mul,F]
    ring
  rw [he,norm_mul]
  calc
    _ ≤ 1*‖∑ m ∈ Ioc (a/d) (b/d), χ (m : ZMod q)*F m‖ :=
      mul_le_mul_of_nonneg_right (χ.norm_le_one _) (norm_nonneg _)
    _ ≤ (q : ℝ)*E := by simpa only [one_mul] using hc
    _ = _ := by
      dsimp [E]
      field_simp

end Bounty
end

section

/- The original compatible pair sum, after stripping shared vertex factors,
becomes two marked-list averages with its exact shared-draw guard retained. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_stripped_pair_sum_eq_marked_averages {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (V : G → ℝ) (q : ℝ) (w z : ℤ)
    (b : GroupMarkedLists P (fun g => ell + (C g).card) →
      GroupMarkedLists P (fun g => ell + (C g).card) →
      PhysicalAuxLabels P (fun g => univ \ C g) → ℂ) :
    (∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
      if physicalSharedCompatible C L R then
        ((physicalStateMass V J ell * physicalCompletionMass V C ell /
          (physicalSharedFactor C L : ℝ) : ℝ) : ℂ) *
        ((physicalUnsharedVertex C L q w : ℂ) * (physicalUnsharedVertex C R q z : ℂ) *
          b (physicalGroupUnsharedEmbedding C L) (physicalGroupUnsharedEmbedding C R)
            (physicalSharedAux C L)) else 0) =
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) w : ℂ) *
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) z : ℂ) *
      groupMarkedAverage P (fun g => ell + (C g).card) w (fun u =>
        groupMarkedAverage P (fun g => ell + (C g).card) z (fun v =>
          ∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
            if physicalRawCutGood C u v s then
              (physicalAuxMass V (fun g => univ \ C g) s : ℂ) * b u v s else 0)) := by
  simp only [physical_unshared_vertex_eq_group_weight]
  rw [physical_normalized_cut_sum_eq_raw_draws P C V
    (fun u v s => (groupMarkedVertexWeight P q (fun g => ell + (C g).card) w u : ℂ) *
      (groupMarkedVertexWeight P q (fun g => ell + (C g).card) z v : ℂ) * b u v s)]
  rw [← completion_marked_pair_sum_eq_average]
  simp only [mul_sum]
  apply sum_congr rfl
  intro u _
  apply sum_congr rfl
  intro v _
  apply sum_congr rfl
  intro s _
  by_cases hs : physicalRawCutGood C u v s
  · simp only [if_pos hs, Complex.ofReal_mul, Complex.ofReal_pow]
    ring
  · simp only [if_neg hs, mul_zero]

end Bounty
end

section

/- The literal asymmetric prime kernels factor through the two original
unshared endpoint embeddings and the unchanged auxiliary draw. -/

open Finset Classical
namespace Bounty

noncomputable def physicalUnsharedPrimeCoefficient
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (Q : ℕ) (h : ℝ) (keptA keptB : Finset ℤ)
    (u v : GroupMarkedLists P (fun g => ell + (repeatedBigAuxCut A B g).card))
    (aux : PhysicalAuxLabels P (repeatedBigAuxCut A B)) : ℂ :=
  primeProductIdealKernel (fun i : A => P i.val.1) (fun i => V i.val.1)
      Q h keptA (repeatedBigAuxSplitEquiv P A B hU hAB aux).1
      (physicalPrimeUnsharedRestriction A B A subset_union_left v) *
    primeProductIdealKernel (fun i : B => P i.val.1) (fun i => V i.val.1)
      Q h keptB (repeatedBigAuxSplitEquiv P A B hU hAB aux).2
      (physicalPrimeUnsharedRestriction A B B subset_union_right u)

theorem physical_prime_coefficient_factors_unshared
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (Q : ℕ) (h : ℝ) (keptA keptB : Finset ℤ)
    (L R : PhysicalMarkLists P J ell)
    (aux : PhysicalAuxLabels P (repeatedBigAuxCut A B)) :
    repeatedBigPrimeCoefficient P V A B hU hAB Q h keptA keptB
      (fun g s => L g s) (fun g s => R g s) aux =
      physicalUnsharedPrimeCoefficient P V A B hU hAB Q h keptA keptB
        (physicalGroupUnsharedEmbedding (repeatedBigAuxCut A B) L)
        (physicalGroupUnsharedEmbedding (repeatedBigAuxCut A B) R) aux := by
  unfold physicalUnsharedPrimeCoefficient
  rw [physical_prime_unshared_restriction_embedding, physical_prime_unshared_restriction_embedding]
  rfl

noncomputable def physicalUnsharedPrimePatternKernel
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h : ℝ)
    (kept : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ) :
    ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      GroupMarkedLists P (fun g => ell + (repeatedBigPrimePatternCut probes r t i g).card) →
      GroupMarkedLists P (fun g => ell + (repeatedBigPrimePatternCut probes r t i g).card) →
      PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i) → ℂ
  | .inl _ => fun _ _ _ => 1
  | .inr ab =>
      let hv := repeated_big_prime_pattern_pair_valid probes r t hrt ab
      physicalUnsharedPrimeCoefficient P V ab.1.val ab.2.val
        (repeated_big_active_pair_avoids_tail hv.1 hv.2.1) hv.2.2
        Q h (kept ab.1.val) (kept ab.2.val)

theorem physical_prime_pattern_kernel_factors_unshared
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h : ℝ)
    (kept : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (L R : PhysicalMarkLists P J ell)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i)) :
    repeatedBigPrimePatternKernel P V probes r t hrt Q h kept i
      (fun g s => L g s) (fun g s => R g s) aux =
      physicalUnsharedPrimePatternKernel P V probes r t hrt Q h kept i
        (physicalGroupUnsharedEmbedding (repeatedBigPrimePatternCut probes r t i) L)
        (physicalGroupUnsharedEmbedding (repeatedBigPrimePatternCut probes r t i) R) aux := by
  cases i with
  | inl u => rfl
  | inr ab =>
    exact physical_prime_coefficient_factors_unshared P V ab.1.val ab.2.val
      _ _ Q h (kept ab.1.val) (kept ab.2.val) L R aux




end Bounty
end

