open MeasureTheory Filter

namespace Bounty

theorem eventually_local_fourier_of_mellin {b c : ℝ} (hb : 0 < b) (hc : 0 ≤ c)
    (A B : ℝ) :
    ∃ D : ℝ, A < D ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (Y H : ℝ) (S : Finset ℕ) (a : ℕ → ℂ) (N : ℕ),
      Real.exp (b*L) ≤ Y → 1 ≤ H → H ≤ Real.exp ((b/2)*L) →
      (∀ n ∈ S, Y/8 ≤ (n:ℝ) ∧ (n:ℝ) ≤ 64*Y) →
      (∀ n ∈ S, n ≤ N) → (N:ℝ) ≤ c*Y → Real.log N ≤ c*L →
      (∑ n ∈ S, ‖a n‖^2) ≤ Y*L^B →
      (∫ t in {t : ℝ | |t| ≤ L*Y/H}, ‖localMellinPolynomial S a t‖^2) ≤ Y^2*L^(-D) →
      (∫ β in {β : ℝ | |β| ≤ 1/H}, ‖localAdditivePolynomial S a β‖^2) ≤ Y*L^(-A) := by
  obtain ⟨j,hj,htail⟩ := eventually_local_mellin_geometric_truncation hc B (A+1)
  obtain ⟨Cj,Cerr,hCj,hCerr,hwide⟩ := exists_wide_local_fourier_mellin_energy_constants hj
  refine ⟨A+1,by linarith,?_⟩
  filter_upwards [htail, eventually_local_scale_error hb hCerr.le A B,
    eventually_ge_atTop (1:ℝ), eventually_ge_atTop (4*Cj)] with L htail hscale hL hLC
  intro Y H S a N hY hH hHu hS hNS hN hlog hE hlow
  have hYp : 0 < Y := (Real.exp_pos _).trans_le hY
  have hHp : 0 < H := lt_of_lt_of_le zero_lt_one hH
  have hLp : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hh : 0 < H/Y := div_pos hHp hYp
  have hinv : (H/Y)⁻¹ ≤ Y := by
    rw [inv_div]
    exact div_le_self hYp.le hH
  have hSN : ∀ n ∈ S, 1 ≤ n ∧ n ≤ N := by
    intro n hn
    have hnpos : 0 < (n:ℝ) := (by positivity : 0 < Y/8).trans_le (hS n hn).1
    exact ⟨by exact_mod_cast hnpos,hNS n hn⟩
  obtain ⟨hsmall,herror⟩ := hscale Y H (∑ n ∈ S, ‖a n‖^2) hY hH hHu hE
  have ht := htail Y (H/Y) S a N hYp hh hinv hSN hN hlog hE
  have hcut : L/(H/Y) = L*Y/H := by field_simp
  rw [hcut] at ht
  have hI : (∫ t : ℝ, (1+|(H/Y)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) ≤
      2*Y^2*L^(-(A+1)) := by linarith
  have hcoef : 2*Cj*L^(-(A+1)) ≤ L^(-A)/2 := by
    rw [show -(A+1) = -A-1 by ring, Real.rpow_sub hLp, Real.rpow_one]
    have hp := mul_le_mul_of_nonneg_right hLC (Real.rpow_pos_of_pos hLp (-A)).le
    calc
      2*Cj*(L^(-A)/L) = (2*Cj*L^(-A))/L := by ring
      _ ≤ L^(-A)/2 := (div_le_iff₀ hLp).2 (by nlinarith)

  calc
    _ ≤ (Cj/Y)*(∫ t : ℝ, (1+|(H/Y)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) +
        Cerr*(H/Y)^2*(∑ n ∈ S, ‖a n‖^2) := hwide S a Y H hYp hH hsmall hS
    _ ≤ (Cj/Y)*(2*Y^2*L^(-(A+1)))+Y*L^(-A)/2 := by
      exact _root_.add_le_add (mul_le_mul_of_nonneg_left hI (by positivity)) herror
    _ = Y*(2*Cj*L^(-(A+1)))+Y*L^(-A)/2 := by field_simp
    _ ≤ Y*(L^(-A)/2)+Y*L^(-A)/2 := by
      exact _root_.add_le_add (mul_le_mul_of_nonneg_left hcoef hYp.le) le_rfl
    _ = _ := by ring

end Bounty
end

