theorem exists_candidate_marked_error_inputs {c : ℝ} (hc : 0 < c) (T : ℕ) :
    ∃ v E : ℝ, 0 < v ∧ 0 ≤ E ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
        (markedDivisorBound (1/2) v T) ^ Fintype.card S ≤ L^E ∧
        ∀ (g : S), v ≤ ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ) := by
  obtain ⟨v, A, hv, hA, hinputs⟩ := exists_candidate_shared_error_inputs hc 1
  let B := markedDivisorBound (1/2) v T
  have hB : 1 ≤ B := one_le_markedDivisorBound (1/2) v T
  refine ⟨v, A * Real.log B, hv, mul_nonneg hA (Real.log_nonneg hB), ?_⟩
  filter_upwards [hinputs, eventually_gt_atTop (0 : ℝ)] with L hinputs hL
  intro S hS
  obtain ⟨hcount, hdata⟩ := hinputs S hS
  refine ⟨?_, fun g => (hdata g).1⟩
  have hcard : ((univ : Finset S).card : ℝ) ≤ A * Real.log L := by
    simpa only [one_mul, card_univ, Fintype.card_coe] using hcount
  have hb := group_product_bound_of_log_card (univ : Finset S) (fun _ => B)
    hB hL (fun _ _ => zero_le_one.trans hB) (fun _ _ => le_rfl) hcard
  simpa only [prod_const, card_univ] using hb

end Bounty
