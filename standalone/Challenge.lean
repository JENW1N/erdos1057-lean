open Finset Classical
abbrev SharedActiveLabels {G : Type*} (P : G → Type*) {M : G → ℕ}
    (S : ∀ g, Finset (Fin (M g))) := ∀ g, Fin (S g).card → P g

noncomputable def productActiveMemorySplit {G : Type*} {P Z : G → Type*} {M : G → ℕ}
    (S : ∀ g, Finset (Fin (M g))) (B : ℕ) :
    ProductBoundedOrderedState P Z M B ≃
      SharedActiveLabels P S × ProductBoundedOrderedState P Z (fun g => (S g)ᶜ.card) B where
  toFun x := (fun g => (activeMemorySplit (S g) B (x g)).1,
    fun g => (activeMemorySplit (S g) B (x g)).2)
  invFun y := fun g => (activeMemorySplit (S g) B).symm (y.1 g, y.2 g)
  left_inv x := by
    funext g
    exact (activeMemorySplit (S g) B).symm_apply_apply (x g)
  right_inv y := by
    apply Prod.ext
    · funext g
      exact congrArg Prod.fst ((activeMemorySplit (S g) B).apply_symm_apply (y.1 g, y.2 g))
    · funext g
      exact congrArg Prod.snd ((activeMemorySplit (S g) B).apply_symm_apply (y.1 g, y.2 g))

noncomputable def sharedActiveWeight {G : Type*} [Fintype G] {P : G → Type*} {M : G → ℕ}
    (S : ∀ g, Finset (Fin (M g))) (μ : ∀ g, P g → ℝ) (c : SharedActiveLabels P S) : ℝ :=
  ∏ g, ∏ i, μ g (c g i)

theorem sharedActiveWeight_nonneg {G : Type*} [Fintype G] {P : G → Type*} {M : G → ℕ}
    (S : ∀ g, Finset (Fin (M g))) (μ : ∀ g, P g → ℝ) (hμ : ∀ g p, 0 ≤ μ g p)
    (c : SharedActiveLabels P S) : 0 ≤ sharedActiveWeight S μ c :=
  prod_nonneg fun g _ => prod_nonneg fun _i _ => hμ g _

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  {P Z : G → Type*}
  {M : G → ℕ}
  (S : ∀ g, Finset (Fin (M g)))
  (B : ℕ)

include G sharedInstance1 P Z M S B

theorem productActiveMemorySplit_weight 
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ)
    (x : ProductBoundedOrderedState P Z M B) :
    productMemoryWeight μ ν x =
      sharedActiveWeight S μ (productActiveMemorySplit S B x).1 *
        productMemoryWeight μ ν (productActiveMemorySplit S B x).2 := by
  unfold productMemoryWeight sharedActiveWeight
  simp_rw [activeMemorySplit_weight (S _) B]
  exact prod_mul_distrib

theorem productActiveMemorySplit_weight_symm 
    (μ : ∀ g, P g → ℝ) (ν : ∀ g, Z g → ℝ) (c : SharedActiveLabels P S)
    (y : ProductBoundedOrderedState P Z (fun g => (S g)ᶜ.card) B) :
    productMemoryWeight μ ν ((productActiveMemorySplit S B).symm (c, y)) =
      sharedActiveWeight S μ c * productMemoryWeight μ ν y := by
  rw [productActiveMemorySplit_weight S B μ ν, Equiv.apply_symm_apply]

theorem productActiveMemorySplit_total_memory 
    (x : ProductBoundedOrderedState P Z M B) :
    productTotalMemory (productActiveMemorySplit S B x).2 = productTotalMemory x := by
  apply sum_congr rfl
  intro g _
  rfl

theorem productActiveMemorySplit_total_memory_symm 
    (c : SharedActiveLabels P S)
    (y : ProductBoundedOrderedState P Z (fun g => (S g)ᶜ.card) B) :
    productTotalMemory ((productActiveMemorySplit S B).symm (c, y)) = productTotalMemory y := by
  have h := productActiveMemorySplit_total_memory S B ((productActiveMemorySplit S B).symm (c, y))
  simpa only [Equiv.apply_symm_apply] using h.symm

end


