/- Forest ties in a fixed original full-edge skeleton, retaining its actual auxiliary draw and target continuation. -/

open Finset Classical

namespace Bounty

theorem full_edge_forest_continuation_le
    {G : Type*} [Fintype G] [DecidableEq G] {P : G → Type*}
    [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : SharedActiveLabels P S → Type*) (Δ D : ∀ c, A c → G → ℤ)
    (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (sk : FullActiveEdgeSkeleton n S B A Δ D s) {m : ℕ}
    (ord : Fin m ≃ FullActiveEdgeSampleIndex n S B A Δ D s sk)
    (code : BirthForestCode m) (anchor : Fin m → Option (Sigma P))
    (η : G → ℝ) (hη : ∀ g, 0 ≤ η g) (hμ : ∀ g p, 0 ≤ μ g p)
    (hμatom : ∀ g p, μ g p ≤ η g)
    (v L : ℝ) (hv : 0 ≤ v) (hL : 0 ≤ L)
    (F : FullActiveEdgeSamples n S B A Δ D s sk → ℝ)
    (hF : ∀ fresh, F fresh ≤ L * productLengthLyapunov v
      (fullActiveEdgeEventTarget n S B A Δ D s
        ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩))) :
    (∑ fresh : FullActiveEdgeSamples n S B A Δ D s sk,
      if birthForestEqualValues code (fun j => (⟨(ord j).1, fresh (ord j)⟩ : Sigma P)) ∧
          birthLabelsAnchored anchor (fun j => (⟨(ord j).1, fresh (ord j)⟩ : Sigma P)) then
        |fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V s
          ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩)| * F fresh
      else 0) ≤
    fullActiveEdgeSkeletonAbsMass n S B A Δ D ω ρ V s sk *
      (L * v ^ (∑ g, unrestrictedSkeletonOutputCount (n g)
        (Δ (productActiveMemorySplit S B s).1 sk.1 g)
        (D (productActiveMemorySplit S B s).1 sk.1 g)
        (S g)ᶜ.card B ((productActiveMemorySplit S B s).2 g) (sk.2 g))) *
      ∏ j, match code j with
        | some _ => η (ord j).1
        | none => match anchor j with
          | none => ∑ p, μ (ord j).1 p
          | some _ => η (ord j).1 := by
  have hb := labeled_anchored_forest_continuation_le
    (fun i : FullActiveEdgeSampleIndex n S B A Δ D s sk => P i.1) ord
    (fun i p => (⟨i.1, p⟩ : Sigma P)) (fun i => μ i.1) code anchor
    (fun i => ∑ p, μ i.1 p) (fun i => η i.1)
    (fun i => sum_nonneg fun p _ => hμ i.1 p) (fun i => hη i.1)
    (fun i => hμ i.1) (fun _ => le_rfl)
    (fun i => finiteLabelMass_tagged_prime_le i.1 (μ i.1) (hη i.1) (hμatom i.1))
    F (fullActiveEdgeSkeletonAbsMass n S B A Δ D ω ρ V s sk)
    (L * v ^ (∑ g, unrestrictedSkeletonOutputCount (n g)
      (Δ (productActiveMemorySplit S B s).1 sk.1 g)
      (D (productActiveMemorySplit S B s).1 sk.1 g)
      (S g)ᶜ.card B ((productActiveMemorySplit S B s).2 g) (sk.2 g)))
    (full_active_edge_skeleton_abs_mass_nonneg _ _ _ _ _ _ _ _ _ _ _)
    (mul_nonneg hL (pow_nonneg hv _))
    (fun fresh => by simpa only [productLengthLyapunov_edge_skeleton] using hF fresh)
  refine le_trans ?_ (le_trans hb ?_)
  · apply le_of_eq
    apply sum_congr rfl
    intro fresh _
    split_ifs
    · rw [full_active_edge_skeleton_weight_factor _ _ _ _ _ _ _ _ _ _ _ μ hμ]
    · rfl
  · apply le_of_eq
    congr 1
    apply prod_congr rfl
    intro j _
    cases code j <;> cases anchor j <;> rfl

end Bounty
end

