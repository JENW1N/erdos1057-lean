section
open Filter Finset
open scoped Topology
theorem eventually_log_times_rpow_lt {a b : ℝ} (hab : a < b) (D : ℝ) :
    ∀ᶠ L : ℝ in atTop, D * L ^ a * Real.log L < L ^ b := by
  have h := ((isLittleO_log_rpow_atTop (sub_pos.mpr hab)).const_mul_left D).bound
    (show (0 : ℝ) < 1 / 2 by norm_num)
  filter_upwards [h, eventually_gt_atTop (0 : ℝ)] with L hL hpos
  have hp : 0 < L ^ (b - a) := Real.rpow_pos_of_pos hpos _
  have ht : D * Real.log L < L ^ (b - a) := by
    have hn : D * Real.log L ≤ ‖D * Real.log L‖ := le_abs_self _
    simp only [Real.norm_eq_abs, abs_of_pos hp] at hL hn
    linarith
  have hm := mul_lt_mul_of_pos_left ht (Real.rpow_pos_of_pos hpos a)
  have he : L ^ a * L ^ (b - a) = L ^ b := by
    rw [← Real.rpow_add hpos]
    congr 1
    ring
  rw [he] at hm
  nlinarith

/- Products with ell factors from each of logarithmically many small
groups are eventually below the lower endpoint of a separated big group. -/
theorem eventually_small_omission_power_lt {a b : ℝ} (hab : a < b)
    (ell : ℕ) (C : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ s : ℕ, (s : ℝ) ≤ C * Real.log L →
      (Real.exp (L ^ a)) ^ (ell * s) < Real.exp (L ^ b) := by
  filter_upwards [eventually_log_times_rpow_lt hab ((ell : ℝ) * C),
    eventually_gt_atTop (0 : ℝ)] with L hL hpos
  intro s hs
  rw [← Real.exp_nat_mul]
  apply Real.exp_lt_exp.mpr
  have hmul := mul_le_mul_of_nonneg_left hs
    (mul_nonneg (Nat.cast_nonneg ell) (Real.rpow_pos_of_pos hpos a).le)
  push_cast
  calc
    (ell : ℝ) * s * L ^ a ≤ (ell : ℝ) * C * L ^ a * Real.log L := by nlinarith
    _ < L ^ b := hL

/- A real bound for all source labels bounds their omission product. -/
theorem prime_omission_product_real_le_pow {G : Type*} [Fintype G]
    (S : G → Finset ℕ) (ell : ℕ) {H : ℝ}
    (hlabels : ∀ g p, p ∈ S g → (p : ℝ) ≤ H)
    (A : PrimeOmissionChoices S ell) :
    (primeOmissionProduct S ell A : ℝ) ≤ H ^ (ell * Fintype.card G) := by
  classical
  unfold primeOmissionProduct
  push_cast
  calc
    (∏ g, ∏ p ∈ (A g).val, (p : ℝ)) ≤ ∏ _g : G, H ^ ell := by
      apply Finset.prod_le_prod₀
      · intro g _
        positivity
      · intro g _
        calc
          (∏ p ∈ (A g).val, (p : ℝ)) ≤ ∏ _p ∈ (A g).val, H := by
            apply Finset.prod_le_prod₀
            · intro p _
              exact Nat.cast_nonneg p
            · intro p hp
              exact hlabels g p ((mem_powersetCard.mp (A g).property).1 hp)
          _ = H ^ ell := by rw [prod_const, (mem_powersetCard.mp (A g).property).2]
    _ = H ^ (ell * Fintype.card G) := by
      rw [prod_const, card_univ, ← pow_mul]
end

section
open Finset
open scoped Classical



/- A real lower endpoint for the big-prime range supplies the nonzero
short-step congruence condition. -/
theorem physical_pending_step_not_dvd_of_bounds {p : ℕ} {k : ℤ} {P₀ : ℝ}
    (hkpos : 0 < k.natAbs) (hstep : (k.natAbs : ℝ) < P₀)
    (hp : P₀ ≤ (p : ℝ)) : ¬ (p : ℤ) ∣ k := by
  apply nat_not_dvd_int_of_natAbs_lt hkpos
  exact_mod_cast hstep.trans_le hp
