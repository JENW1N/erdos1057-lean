section

/- Elementary bounds for repeated prime factors in a rough interval. -/

open Finset Filter

namespace Bounty

theorem large_square_divisor_card_le {N : ℕ} {z : ℝ} (hz : 0 < z)
    (F : Finset ℕ) (hF : F ⊆ Ioc 0 N)
    (hsquare : ∀ n ∈ F, ∃ p : ℕ, z < (p : ℝ) ∧ p ^ 2 ∣ n) :
    (F.card : ℝ) ≤ 2 * (N : ℝ) / z := by
  classical
  let P := Ioo ⌊z⌋₊ (N + 1)
  let M := fun p : ℕ => (Ioc 0 N).filter (fun n => p ^ 2 ∣ n)
  have hsub : F ⊆ P.biUnion M := by
    intro n hn
    obtain ⟨p, hpz, hpn⟩ := hsquare n hn
    have hnI := mem_Ioc.mp (hF hn)
    have hpN : p ≤ N := (Nat.le_self_pow (by norm_num) p).trans
      ((Nat.le_of_dvd hnI.1 hpn).trans hnI.2)
    exact mem_biUnion.mpr ⟨p,
      mem_Ioo.mpr ⟨(Nat.floor_lt hz.le).mpr hpz, by omega⟩,
      mem_filter.mpr ⟨hF hn, hpn⟩⟩
  calc
    (F.card : ℝ) ≤ ((P.biUnion M).card : ℝ) := by exact_mod_cast card_le_card hsub
    _ ≤ ∑ p ∈ P, ((M p).card : ℝ) := by exact_mod_cast card_biUnion_le
    _ ≤ ∑ p ∈ P, (N : ℝ) / (p : ℝ) ^ 2 := by
      apply sum_le_sum
      intro p hp
      dsimp only [M]
      rw [Nat.Ioc_filter_dvd_card_eq_div]
      simpa only [Nat.cast_pow] using (Nat.cast_div_le (m := N) (n := p ^ 2) :
        ((N / p ^ 2 : ℕ) : ℝ) ≤ (N : ℝ) / (p ^ 2 : ℕ))
    _ = (N : ℝ) * ∑ p ∈ P, ((p : ℝ) ^ 2)⁻¹ := by
      simp only [div_eq_mul_inv, mul_sum]
    _ ≤ (N : ℝ) * (2 / ((⌊z⌋₊ : ℝ) + 1)) := by
      exact mul_le_mul_of_nonneg_left (sum_Ioo_inv_sq_le ⌊z⌋₊ (N + 1)) (Nat.cast_nonneg _)
    _ ≤ 2 * (N : ℝ) / z := by
      have hdiv : 2 / ((⌊z⌋₊ : ℝ) + 1) ≤ 2 / z :=
        div_le_div_of_nonneg_left (by norm_num) hz (Nat.lt_floor_add_one z).le
      have hmul := mul_le_mul_of_nonneg_left hdiv (Nat.cast_nonneg N)
      calc
        _ ≤ (N : ℝ) * (2 / z) := hmul
        _ = 2 * (N : ℝ) / z := by ring

theorem rough_band_nonsquarefree_card_le {A B z : ℝ} (hB : 0 ≤ B) (hz : 0 < z) :
    (((roughBand A B z).filter (fun n => ¬ Squarefree n)).card : ℝ) ≤ 2 * B / z := by
  classical
  let F := (roughBand A B z).filter (fun n => ¬ Squarefree n)
  have hF : F ⊆ Ioc 0 ⌊B⌋₊ := by
    intro n hn
    have hnR := (mem_filter.mp hn).1
    have hnI := mem_Icc.mp (roughBand_subset_Icc A B z hnR)
    exact mem_Ioc.mpr ⟨hnI.1, hnI.2⟩
  have hsquare : ∀ n ∈ F, ∃ p : ℕ, z < (p : ℝ) ∧ p ^ 2 ∣ n := by
    intro n hn
    obtain ⟨hnR, hnsq⟩ := mem_filter.mp hn
    rw [Nat.squarefree_iff_prime_squarefree] at hnsq
    push Not at hnsq
    obtain ⟨p, hp, hpn⟩ := hnsq
    have hpn' : p ∣ n := dvd_trans (dvd_mul_right p p) hpn
    have hpF := hp.mem_primeFactors hpn' (roughBand_pos hnR).ne'
    have hpz := (mem_filter.mp hnR).2 p hpF
    exact ⟨p, hpz, by simpa only [pow_two] using hpn⟩
  apply (large_square_divisor_card_le hz F hF hsquare).trans
  exact div_le_div_of_nonneg_right
    (mul_le_mul_of_nonneg_left (Nat.floor_le hB) (by norm_num)) hz.le

theorem rough_logarithmic_cell_nonsquarefree_card_le {γ L S Y : ℝ}
    (hL : 1 ≤ L) (hS : 0 ≤ S) (hY : 0 ≤ Y) :
    (((roughBand Y (Real.exp (L ^ (-S)) * Y) (Real.exp (γ * L))).filter
      (fun n => ¬ Squarefree n)).card : ℝ) ≤
        6 * Y * Real.exp (-γ * L) := by
  have hδ : L ^ (-S) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hL (neg_nonpos.mpr hS)
  have he : Real.exp (L ^ (-S)) ≤ 3 :=
    (Real.exp_le_exp.mpr hδ).trans (by linarith [Real.exp_one_lt_d9])
  have hb := rough_band_nonsquarefree_card_le (A := Y) (B := Real.exp (L ^ (-S)) * Y)
    (mul_nonneg (Real.exp_nonneg _) hY) (Real.exp_pos (γ * L))
  apply hb.trans
  have hb' : 2 * (Real.exp (L ^ (-S)) * Y) ≤ 6 * Y := by nlinarith
  have hdiv := div_le_div_of_nonneg_right hb' (Real.exp_nonneg (γ * L))
  simpa only [neg_mul, Real.exp_neg, div_eq_mul_inv] using hdiv

theorem eventually_rough_logarithmic_cell_nonsquarefree_power_bound
    {γ₀ : ℝ} (hγ₀ : 0 < γ₀) (Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ γ : ℝ, γ₀ ≤ γ → ∀ S : ℝ, 0 ≤ S →
      ∀ Y : ℝ, 0 ≤ Y →
      (((roughBand Y (Real.exp (L ^ (-S)) * Y) (Real.exp (γ * L))).filter
        (fun n => ¬ Squarefree n)).card : ℝ) ≤ L ^ (-Bsave) * Y := by
  filter_upwards [eventually_linear_exponential_profile_le_rpow hγ₀ hγ₀ 6 0 Bsave,
    eventually_ge_atTop (1 : ℝ)] with L hdecay hL
  intro γ hγ S hS Y hY
  have hmono : Real.exp (-γ * L) ≤ Real.exp (-γ₀ * L) := by
    apply Real.exp_le_exp.mpr
    nlinarith
  calc
    _ ≤ 6 * Y * Real.exp (-γ * L) :=
      rough_logarithmic_cell_nonsquarefree_card_le hL hS hY
    _ ≤ 6 * Y * Real.exp (-γ₀ * L) :=
      mul_le_mul_of_nonneg_left hmono (by positivity)
    _ = (6 * Real.exp (-γ₀ * L)) * Y := by ring
    _ ≤ L ^ (-Bsave) * Y := by
      apply mul_le_mul_of_nonneg_right _ hY
      simpa only [zero_mul, zero_add, add_zero] using hdecay

theorem rough_band_squarefree_count_error (A B z : ℝ) :
    |((roughBand A B z).card : ℝ) -
      (((roughBand A B z).filter Squarefree).card : ℝ)| =
        (((roughBand A B z).filter (fun n => ¬ Squarefree n)).card : ℝ) := by
  classical
  have hcard : (((roughBand A B z).filter Squarefree).card : ℝ) +
      (((roughBand A B z).filter (fun n => ¬ Squarefree n)).card : ℝ) =
        ((roughBand A B z).card : ℝ) := by
    exact_mod_cast (card_filter_add_card_filter_not (s := roughBand A B z) Squarefree)
  rw [← hcard, add_sub_cancel_left, abs_of_nonneg (Nat.cast_nonneg _)]

theorem eventually_rough_logarithmic_cell_squarefree_count_error
    {γ₀ S : ℝ} (hγ₀ : 0 < γ₀) (hS : 0 ≤ S) (Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ γ : ℝ, γ₀ ≤ γ → ∀ Y : ℝ, 0 ≤ Y →
      |((roughBand Y (Real.exp (L ^ (-S)) * Y) (Real.exp (γ * L))).card : ℝ) -
        (((roughBand Y (Real.exp (L ^ (-S)) * Y) (Real.exp (γ * L))).filter
          Squarefree).card : ℝ)| ≤
        L ^ (-Bsave) * ((Real.exp (L ^ (-S)) * Y - Y) / L) := by
  filter_upwards [eventually_rough_logarithmic_cell_nonsquarefree_power_bound
    hγ₀ (Bsave + S + 1), eventually_gt_atTop (0 : ℝ)] with L hcount hL
  intro γ hγ Y hY
  rw [rough_band_squarefree_count_error]
  calc
    _ ≤ L ^ (-(Bsave + S + 1)) * Y := hcount γ hγ S hS Y hY
    _ = L ^ (-Bsave) * (L ^ (-S) * Y / L) := by
      rw [show -(Bsave + S + 1) = (-Bsave + -S) - 1 by ring,
        Real.rpow_sub hL, Real.rpow_add hL, Real.rpow_one]
      ring
    _ ≤ L ^ (-Bsave) * ((Real.exp (L ^ (-S)) * Y - Y) / L) := by
      apply mul_le_mul_of_nonneg_left _ (Real.rpow_nonneg hL.le _)
      apply div_le_div_of_nonneg_right _ hL.le
      have he := Real.add_one_le_exp (L ^ (-S))
      nlinarith

end Bounty



