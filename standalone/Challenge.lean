    ring
  have he : M*T=(G:SL(2,ActualEisensteinCubic.O))*cuspRepresentative j*(S*T) := by rw [hM]; group
  rw [sourceCuspConstant_decomposition (M*T) G j (S*T) hST he,
    sourceCuspConstant_decomposition M G j S hS hM]

