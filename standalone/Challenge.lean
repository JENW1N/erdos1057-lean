/- The exact prime-pattern family has a uniform initial-ledger error
budget. Pattern signs remain inside their coefficient norms, and the
fresh-target exclusion probability is the only additional loss. -/

open Finset Filter
open scoped Classical

namespace Bounty

theorem repeated_big_prime_initial_pattern_error_le {G : Type*}
    [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell m : ℕ}
    (V : G → ℝ) (probes : G → Finset (Fin J)) (r t : Finset G)
    (hrt : Disjoint r t) (hp : ∀ g, (probes g).card ≤ m)
    (F : ∀ g, Finset (P g)) (hF : ∀ g, (F g).card ≤ J + ell)
    (Q : ℕ) (xi : ℝ) {v Pmin : ℝ}
    (hv : 0 < v) (hV : ∀ g, v ≤ V g) (hPmin : 0 < Pmin) :
    (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ‖repeatedBigPrimePatternWeight probes r t i‖ *
        (repeatedBigPrimePatternBound probes r t Q xi i * Real.sqrt
          (repeatedBigInitialForbiddenProbability (ell := ell) V
            (repeatedBigPrimePatternCut probes r t i) F Pmin))) ≤
      repeatedBigInitialError (Fintype.card G) m J ell Q xi Pmin v := by
  let delta := (Fintype.card G : ℝ) *
    (((ell + m : ℕ) : ℝ) * ((J + ell : ℕ) : ℝ)) / (v * Pmin)
  have hprob (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t) :
      repeatedBigInitialForbiddenProbability (ell := ell) V (repeatedBigPrimePatternCut probes r t i)
        F Pmin ≤ delta := by
    simpa only [delta, mul_assoc] using
      repeated_big_initial_forbidden_probability_le V (repeatedBigPrimePatternCut probes r t i)
        F hv hPmin hV (repeated_big_prime_pattern_cut_card_le probes r t hp i) hF
  have hcard : r.card + t.card ≤ Fintype.card G := by
    rw [← card_union_of_disjoint hrt]
    exact card_le_univ _
  simp only [repeated_big_prime_pattern_weight_norm, one_mul]
  calc
    _ ≤ ∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
        repeatedBigPrimePatternBound probes r t Q xi i * Real.sqrt delta := by
      apply sum_le_sum
      intro i _
      exact mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt (hprob i))
        (repeated_big_prime_pattern_bound_nonneg probes r t Q xi i)
    _ = (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
        repeatedBigPrimePatternBound probes r t Q xi i) * Real.sqrt delta := by
      rw [sum_mul]
    _ ≤ (1 + (2 : ℝ) ^ (m * (r.card + t.card)) * (((Q * Q : ℕ) : ℝ) / xi) ^ 2) *
        Real.sqrt delta :=
      mul_le_mul_of_nonneg_right
        (repeated_big_prime_pattern_bound_sum_le (ell := ell) probes r t hp Q xi)
        (Real.sqrt_nonneg _)
    _ ≤ (1 + (2 : ℝ) ^ (m * Fintype.card G) * (((Q * Q : ℕ) : ℝ) / xi) ^ 2) *
        Real.sqrt delta := by
      apply mul_le_mul_of_nonneg_right _ (Real.sqrt_nonneg _)
      apply add_le_add le_rfl
      apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
      exact pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) (Nat.mul_le_mul_left m hcard)
    _ = _ := rfl




end Bounty
end

