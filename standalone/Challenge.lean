/- The complete balanced rough-pair sum, with a constant independent of the balance width. -/

open Finset Filter
open scoped Topology

namespace Bounty

def balancedPairWindow (κ L : ℝ) (v : ℕ × ℕ) : Prop :=
  Real.exp (((1/2 : ℝ)-2*κ)*L) ≤ (v.1 : ℝ) ∧
  (v.1 : ℝ) ≤ Real.exp (((1/2 : ℝ)+2*κ)*L) ∧
  Real.exp (((1/2 : ℝ)-2*κ)*L) ≤ (v.2 : ℝ) ∧
  (v.2 : ℝ) ≤ Real.exp (((1/2 : ℝ)+2*κ)*L) ∧
  Real.exp L ≤ ((v.1*v.2 : ℕ) : ℝ) ∧ ((v.1*v.2 : ℕ) : ℝ) ≤ 33*Real.exp L

theorem exists_candidate_balanced_rough_pair_bound {c q θ : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ)*(r : ℝ)*c = 1) (hθ : 0 < θ) (J : ℕ)
    (hcut : θ < 2*c/(2 : ℝ)^J)
    (hsize : (12/5 : ℝ)*(r : ℝ)*c/(2 : ℝ)^J ≤ 1/25) (hθsmall : 10*θ ≤ 1/20) :
    ∃ C : ℝ, 0 < C ∧ ∃ J0 : ℕ, J ≤ J0 ∧
      ∀ᶠ L : ℝ in atTop, ∀ (κ : ℝ), 0 ≤ κ → κ ≤ 1/50 →
      ∀ jStar : ℕ, J0 < jStar → ∀ (W : ℝ) (S : Finset (ℕ × ℕ)) (u : ℕ × ℕ → ℕ),
        1 ≤ W → W ≤ Real.exp (θ*L) →
        (∀ v ∈ S, balancedPairWindow κ L v) →
        (∀ v ∈ S, v.1*v.2 = 2*u v+1) →
        (∀ v ∈ S, ∀ p ∈ primeBand 0 W, ¬p ∣ v.1*v.2) →
        (∑ v ∈ S, candidateCoefficient c L q r jStar (u v)) ≤
          C*(κ*L+1)*candidateCoefficientWindowMass c L q r jStar *
            (∏ p ∈ primeBand 0 W, (1-1/(p : ℝ)))^2 := by
  classical
  obtain ⟨Cp, hCp, J0, hJJ0, hp⟩ := exists_candidate_pair_mass_bound hc hr hq0 hq1 hcenter hθ
    (by norm_num : (0 : ℝ) < 33) J hcut hsize hθsmall
  let Cd := 36/Real.log 2+18
  have hCd : 0 < Cd := by dsimp [Cd]; positivity [Real.log_pos (by norm_num : (1 : ℝ) < 2)]
  refine ⟨Cd*(Cp+1), by positivity, J0, hJJ0, ?_⟩
  filter_upwards [hp 4, eventually_power_four_le_avoidance_square hθ,
    eventually_gt_atTop (0 : ℝ)] with L hpair havoid hL
  intro κ hκ hκup jStar hj W S u hW hWup hS hv hrough
  let XA := candidateCoefficientWindowMass c L q r jStar
  let V := ∏ p ∈ primeBand 0 W, (1-1/(p : ℝ))
  have hXA : 0 ≤ XA := sum_nonneg (fun n _ => candidate_coefficient_nonneg c L hq0 r jStar n)
  have hpos : ∀ v ∈ S, 0 < v.1 ∧ 0 < v.2 := by
    intro v hvs
    exact ⟨Nat.cast_pos.mp ((Real.exp_pos _).trans_le (hS v hvs).1),
      Nat.cast_pos.mp ((Real.exp_pos _).trans_le (hS v hvs).2.2.1)⟩
  have hupper : ((1/2 : ℝ)+2*κ)*L ≤ (27/50 : ℝ)*L :=
    mul_le_mul_of_nonneg_right (by linarith) hL.le
  have hlocal (k : ℕ × ℕ) (hk : k ∈ dyadicPairIndices S) :
      (∑ v ∈ dyadicPairBucket S k, candidateCoefficient c L q r jStar (u v)) ≤ (Cp+1)*XA*V^2 := by
    obtain ⟨v, hvs, hkm, hkn, hkprod⟩ := dyadic_pair_bucket_scales S hpos hk
    have hm : (2 : ℝ)^k.1 ≤ Real.exp ((27/50 : ℝ)*L) :=
      hkm.trans ((hS v hvs).2.1.trans (Real.exp_le_exp.mpr hupper))
    have hn : (2 : ℝ)^k.2 ≤ Real.exp ((27/50 : ℝ)*L) :=
      hkn.trans ((hS v hvs).2.2.2.1.trans (Real.exp_le_exp.mpr hupper))
    have harea : (2 : ℝ)^k.1 * (2 : ℝ)^k.2 ≤ 33*Real.exp L :=
      hkprod.trans (hS v hvs).2.2.2.2.2
    have hend (i : ℕ) : 2^i-1 ≤ 2^(i+1)-1 := by
      have hpow : (2 : ℕ)^i ≤ 2^(i+1) := Nat.pow_le_pow_right (by omega) (by omega)
      omega
    have ht := hpair jStar hj (2^k.1-1) (2^(k.1+1)-1) (2^k.2-1) (2^(k.2+1)-1)
      W (dyadicPairBucket S k) u (hend _) (hend _) (zero_le_one.trans hW) hWup
      (by simpa only [dyadic_index_side_length] using hm)
      (by simpa only [dyadic_index_side_length] using hn)
      (by simpa only [dyadic_index_side_length] using harea)
      (fun v hvk => hv v (mem_filter.mp hvk).1)
      (fun v hvk => dyadic_pair_bucket_rectangle S hpos k hvk)
      (fun v hvk => hrough v (mem_filter.mp hvk).1)
    have he := mul_le_mul_of_nonneg_left (havoid W hW hWup) hXA
    calc
      _ ≤ Cp*XA*V^2 + XA*L^(-(4 : ℝ)) := ht
      _ ≤ Cp*XA*V^2 + XA*V^2 := add_le_add le_rfl he
      _ = _ := by ring
  have hcount := dyadic_balanced_pair_count S hκ hL.le (fun v hvs =>
    ⟨(hpos v hvs).1, (hpos v hvs).2, (hS v hvs).1, (hS v hvs).2.1, (hS v hvs).2.2.2.2⟩)
  calc
    _ = ∑ k ∈ dyadicPairIndices S, ∑ v ∈ dyadicPairBucket S k,
        candidateCoefficient c L q r jStar (u v) := (sum_dyadic_pair_buckets S _).symm
    _ ≤ ∑ _k ∈ dyadicPairIndices S, (Cp+1)*XA*V^2 := sum_le_sum hlocal
    _ = ((dyadicPairIndices S).card : ℝ)*((Cp+1)*XA*V^2) := by simp only [sum_const, nsmul_eq_mul]
    _ ≤ (Cd*(κ*L+1))*((Cp+1)*XA*V^2) := mul_le_mul_of_nonneg_right hcount (by positivity)
    _ = _ := by dsimp [Cd, XA, V]; ring

end Bounty
end

