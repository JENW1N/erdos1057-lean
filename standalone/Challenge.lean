section

/- Exact character expansion with the full signed determinant modulus. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

theorem typeII_congruence_character_indicator {q : ℕ} [NeZero q]
    (m m' : ℕ) (hm' : m'.Coprime q) :
    (if Nat.ModEq q m m' then (1 : ℂ) else 0) =
      (1 / (q.totient : ℂ)) *
        ∑ χ : DirichletCharacter ℂ q, χ (m : ZMod q) * conj (χ (m' : ZMod q)) := by
  classical
  have hu : IsUnit (m' : ZMod q) := (ZMod.isUnit_iff_coprime m' q).mpr hm'
  have hs := DirichletCharacter.sum_char_inv_mul_char_eq ℂ hu (m : ZMod q)
  have hsum : (∑ χ : DirichletCharacter ℂ q,
      χ (m : ZMod q) * conj (χ (m' : ZMod q))) =
      if Nat.ModEq q m m' then (q.totient : ℂ) else 0 := by
    calc
      _ = ∑ χ : DirichletCharacter ℂ q, χ (m' : ZMod q)⁻¹ * χ (m : ZMod q) := by
        apply sum_congr rfl
        intro χ hχ
        rw [character_conj_apply_unit χ hu, mul_comm]
      _ = _ := by
        rw [hs]
        congr 1
        rw [ZMod.natCast_eq_natCast_iff]
        exact propext Nat.ModEq.comm
  rw [hsum]
  have hφ : (q.totient : ℂ) ≠ 0 := by
    exact_mod_cast (Nat.totient_pos.mpr (NeZero.pos q)).ne'
  split_ifs <;> simp [hφ]

theorem typeII_congruence_character_sum {q : ℕ} [NeZero q]
    {ι : Type*} (S : Finset ι) (m m' : ι → ℕ) (f : ι → ℂ)
    (hm' : ∀ x ∈ S, (m' x).Coprime q) :
    (∑ x ∈ S with Nat.ModEq q (m x) (m' x), f x) =
      (1 / (q.totient : ℂ)) * ∑ χ : DirichletCharacter ℂ q,
        ∑ x ∈ S, f x * χ (m x : ZMod q) * conj (χ (m' x : ZMod q)) := by
  classical
  rw [sum_filter]
  simp only [mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro x hx
  calc
    (if Nat.ModEq q (m x) (m' x) then f x else 0) =
        f x * (if Nat.ModEq q (m x) (m' x) then (1 : ℂ) else 0) := by
      split_ifs <;> simp
    _ = _ := by
      rw [typeII_congruence_character_indicator (m x) (m' x) (hm' x hx)]
      simp only [mul_sum]
      apply sum_congr rfl
      intro χ hχ
      ring

theorem typeII_signed_congruence_iff {k : ℤ} {m m' : ℕ} :
    Int.ModEq (2 * |k|) (m : ℤ) (m' : ℤ) ↔ Nat.ModEq (2 * k.natAbs) m m' := by
  have hq : ((2 * k.natAbs : ℕ) : ℤ) = 2 * |k| := by
    simp only [Nat.cast_mul, Nat.cast_ofNat, Int.natCast_natAbs]
  rw [← hq, Int.natCast_modEq_iff]

theorem typeII_rough_coprime_twice_natAbs {m : ℕ} {k : ℤ} {W : ℝ}
    (hm : 0 < m) (hk : k ≠ 0) (hW : 2 ≤ W)
    (hrough : ∀ p ∈ m.primeFactors, W < (p : ℝ))
    (hsmall : (k.natAbs : ℝ) ≤ W) : Nat.Coprime m (2 * k.natAbs) := by
  have htwo : m.Coprime 2 := by
    apply Nat.coprime_of_dvd
    intro p hp hpm hptwo
    have hlarge := hrough p (Nat.mem_primeFactors.mpr ⟨hp, hpm, hm.ne'⟩)
    have hp2 : p ≤ 2 := Nat.le_of_dvd (by decide) hptwo
    have hp2' : (p : ℝ) ≤ 2 := by exact_mod_cast hp2
    linarith
  exact htwo.mul_right (typeII_rough_coprime_natAbs hm hk hrough hsmall)

end Bounty

end

section

/- Uniform removal of the large P-part for bounded complex tests on rough shifted divisors. -/

open Finset Filter Real

namespace Bounty

theorem norm_weighted_finite_fibers_le (T : Finset ℕ) (fibers : ℕ → Finset ℕ)
    (a : ℕ → ℝ) (F : ℕ → ℕ → ℂ) (M : ℝ)
    (ha : ∀ u ∈ T, 0 ≤ a u) (hF : ∀ u ∈ T, ∀ m ∈ fibers u, ‖F u m‖ ≤ M) :
    ‖∑ u ∈ T, (a u : ℂ)*∑ m ∈ fibers u, F u m‖ ≤
      M*(∑ u ∈ T, a u*((fibers u).card : ℝ)) := by
  calc
    _ ≤ ∑ u ∈ T, ‖(a u : ℂ)*∑ m ∈ fibers u, F u m‖ := norm_sum_le _ _
    _ ≤ ∑ u ∈ T, a u*(((fibers u).card : ℝ)*M) := by
      apply sum_le_sum
      intro u hu
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (ha u hu)]
      apply mul_le_mul_of_nonneg_left _ (ha u hu)
      calc
        _ ≤ ∑ m ∈ fibers u, ‖F u m‖ := norm_sum_le _ _
        _ ≤ ∑ _m ∈ fibers u, M := sum_le_sum (fun m hm => hF u hu m hm)
        _ = _ := by simp
    _ = _ := by
      rw [mul_sum]
      apply sum_congr rfl
      intro u hu
      ring




end Bounty
end

section

/- Polynomial separated-coefficient bounds uniform over allocation patterns and unit-bounded twists. -/

open Finset Filter

namespace Bounty

theorem norm_candidate_remaining_coefficient_le_divisors {c L : ℝ} {r jStar : ℕ}
    (hcL : 0 ≤ c*L) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm (candidateRoughSlot c L r jStar hr hj)) = false)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ)
    (htwist : ∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot → ‖twist slot p‖ ≤ 1)
    (h : ℕ) (hh : h ≠ 0) :
    ‖candidateRemainingComplexCoefficient c L r jStar take twist h‖ ≤ (h.divisors.card : ℝ) := by
  apply (norm_candidate_remaining_coefficient_le_rough_divisors hcL hr hj take hkeep twist htwist h).trans
  apply Nat.cast_le.mpr
  apply card_le_card
  intro p hp
  exact Nat.mem_divisors.mpr ⟨(mem_filter.mp hp).2, hh⟩

theorem exists_candidate_separated_coefficients_polynomial_bound
    {c : ℝ} (hc : 0 < c) {r : ℕ} (hr : 0 < r) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ,
      ∀ hj : jStar ∈ candidateQIndices c L,
      ∀ take : Fin ((candidateQIndices c L).card*r) → Bool,
      ∀ hkeep : take ((candidateAllocationOrder c L r).symm
        (candidateRoughSlot c L r jStar hr hj)) = false,
      ∀ twist : (candidateQIndices c L) × Fin r → ℕ → ℂ,
      (∀ slot p, p ∈ candidateQSlotChoices c L r jStar slot → ‖twist slot p‖ ≤ 1) →
      (∀ e : ℕ, ‖candidateTakenComplexCoefficient c L r jStar take twist e‖ ≤ L^C) ∧
      (∀ q : ℕ, ‖candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep twist q‖ ≤ 1) ∧
      (∀ h : ℕ, ‖candidateRemainingComplexCoefficient c L r jStar take twist h‖ ≤
        (((candidateRoughBand c L jStar).filter (fun p => p ∣ h)).card : ℝ)) := by
  obtain ⟨C, hC, hpoly⟩ := exists_candidate_factorial_normalization_polynomial_bound hc r
  refine ⟨C, hC, ?_⟩
  filter_upwards [hpoly, eventually_ge_atTop (0 : ℝ)] with L hpoly hL
  intro jStar hj take hkeep twist htwist
  have hcL : 0 ≤ c*L := mul_nonneg hc.le hL
  refine ⟨?_, ?_, ?_⟩
  · intro e
    exact (norm_candidate_taken_coefficient_le_factorial_pow hcL hr hj take hkeep twist htwist e).trans hpoly
  · intro q
    exact norm_candidate_residual_prime_coefficient_le_one hcL hr hj take hkeep twist htwist q
  · intro h
    exact norm_candidate_remaining_coefficient_le_rough_divisors hcL hr hj take hkeep twist htwist h


end Bounty
end

section

/- Explicit exponent budgets for the low-rank forest contribution. -/

open Finset Classical

namespace Bounty

theorem birthForest_low_rank_power_saving {m : ℕ} (F : BirthForestCode m → ℂ)
    (r₀ N : ℕ) {L H G Cv Ca M Ch E : ℝ}
    (hL : 2 ≤ L) (hH : 0 ≤ H) (hM : 0 ≤ M) (hD : 0 ≤ G + Ca + M)
    (hm : (m : ℝ) ≤ L ^ M) (hHb : H ≤ L ^ Ch)
    (hfixed : Cv + Ch + M + 1 ≤ (N : ℝ) / 2)
    (haffected : 2 * r₀ * (G + Ca + M) ≤ (N : ℝ) / 2)
    (hgain : E + Cv + 1 ≤ G)
    (hF : ∀ code, birthForestRank code < r₀ →
      ‖F code‖ ≤ H * L ^ ((-G + Cv) * N + Cv +
        2 * birthForestRank code * (G + Ca))) :
    ‖∑ code ∈ (univ : Finset (BirthForestCode m)).filter
        (fun code => birthForestRank code < r₀),
      (-1 : ℂ) ^ birthForestRank code * F code‖ ≤ L ^ (-(E * N)) := by
  have hL1 : 1 ≤ L := by linarith
  have hL0 : 0 < L := by linarith
  have hM1 : 1 ≤ L ^ M := Real.one_le_rpow hL1 hM
  have hm1 : (m : ℝ) + 1 ≤ L ^ (M + 1) := by
    calc
      (m : ℝ) + 1 ≤ L ^ M + L ^ M := add_le_add hm hM1
      _ ≤ L ^ M * L := by nlinarith [Real.rpow_pos_of_pos hL0 M]
      _ = L ^ (M + 1) := by rw [Real.rpow_add hL0, Real.rpow_one]
  apply (birthForest_low_rank_power_bound F r₀ hL1 hH hD hm hF).trans
  calc
    _ ≤ L ^ (M + 1) * L ^ Ch *
        L ^ ((-G + Cv) * N + Cv + 2 * r₀ * (G + Ca + M)) := by
      apply mul_le_mul_of_nonneg_right _ (Real.rpow_pos_of_pos hL0 _).le
      exact mul_le_mul hm1 hHb hH (Real.rpow_pos_of_pos hL0 _).le
    _ = L ^ ((-G + Cv) * N + Cv + Ch + M + 1 +
        2 * r₀ * (G + Ca + M)) := by
      rw [← Real.rpow_add hL0, ← Real.rpow_add hL0]
      congr 1
      ring
    _ ≤ L ^ (-(E * N)) := by
      apply Real.rpow_le_rpow_of_exponent_le hL1
      have hg := mul_le_mul_of_nonneg_right hgain (Nat.cast_nonneg N : (0 : ℝ) ≤ N)
      nlinarith

end Bounty
end

section

/- Encoding prime labels preserves every forest constraint on performed births. -/

open scoped Classical
namespace Bounty

theorem optional_forest_encoding_iff {m : ℕ} {α : Type*}
    (performed : Fin m → Prop) (label : Fin m → Option α)
    (hp : ∀ i, performed i → (label i).isSome = true)
    (encode : α → ℤ) (hinj : Function.Injective encode) (code : BirthForestCode m) :
    birthForestCompatible performed (fun i => ((label i).map encode).getD 0) code ↔
      birthForestCompatible performed label code := by
  apply forall_congr'
  intro j
  cases code j with
  | none => rfl
  | some i =>
    change (_ ∧ _ ∧ _) ↔ (_ ∧ _ ∧ _)
    constructor <;> rintro ⟨hi, hj, he⟩
    · exact ⟨hi, hj, (optional_encoded_eq_iff encode hinj _ _ (hp _ hi) (hp _ hj)).mp he⟩
    · exact ⟨hi, hj, (optional_encoded_eq_iff encode hinj _ _ (hp _ hi) (hp _ hj)).mpr he⟩




end Bounty
