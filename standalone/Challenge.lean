  (Δ D : ∀ c, A c → Fin N → ℤ)
  (target : (g : Fin N) → Fin (S g)ᶜ.card → P g)
  (H : (g : Fin N) → Finset (P g))
  (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)

theorem full_edge_ledger_observed_rows
    (β : (g : Fin N) → P g → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (ω : ∀ c, A c → ℝ)
    (m : A (productActiveMemorySplit S B x).1 → Prop)
    (row : A (productActiveMemorySplit S B x).1 → (g : Fin N) →
      (GlobalBirthHistoryState (fun p => ZMod (n g p)) → ℂ) →
      GlobalBirthHistoryState (fun p => ZMod (n g p)) → ℂ)
    (hrows : ∀ a, m a → ∀ g (K : GlobalBirthHistoryState (fun p => ZMod (n g p)) → ℂ),
      row a g K (H g, boundedOrderedTupleToFinite (x g).2) =
      ∑ e : UnrestrictedBoundedEvent (n g)
        (Δ (productActiveMemorySplit S B x).1 a g)
        (D (productActiveMemorySplit S B x).1 a g) (S g)ᶜ.card B
        ((productActiveMemorySplit S B x).2 g),
        (unrestrictedBoundedEventWeight (n g)
          (Δ (productActiveMemorySplit S B x).1 a g)
          (D (productActiveMemorySplit S B x).1 a g)
          (fun p => β g p / V g) ρ (V g) (S g)ᶜ.card B
          ((productActiveMemorySplit S B x).2 g) e : ℂ) *
        globalBirthBoundedEdgePhase (n g)
          (Δ (productActiveMemorySplit S B x).1 a g)
          (D (productActiveMemorySplit S B x).1 a g) (S g)ᶜ.card B (target g) (H g)
          ((productActiveMemorySplit S B x).2 g) e.1 e.2.1 e.2.2.1 e.2.2.2 *
        K (H g ∪ univ.image (unrestrictedBoundedEventTarget (n g)
          (Δ (productActiveMemorySplit S B x).1 a g)
          (D (productActiveMemorySplit S B x).1 a g) (S g)ᶜ.card B
          ((productActiveMemorySplit S B x).2 g) e).1,
          boundedOrderedTupleToFinite (unrestrictedBoundedEventTarget (n g)
          (Δ (productActiveMemorySplit S B x).1 a g)
          (D (productActiveMemorySplit S B x).1 a g) (S g)ᶜ.card B
          ((productActiveMemorySplit S B x).2 g) e).2))
    (F : A (productActiveMemorySplit S B x).1 →
      GlobalBirthJointState (fun g p => ZMod (n g p)) → ℂ) :
    (∑ a : A (productActiveMemorySplit S B x).1,
      (ω (productActiveMemorySplit S B x).1 a : ℂ) *
      if m a then jointRawTensorCutoff B (row a) (F a)
        (fun g => (H g, boundedOrderedTupleToFinite (x g).2)) else 0) =
      ∑ e : FullActiveEdgeEvent n S B A Δ D x,
        (fullActiveEdgeEventWeight n S B A Δ D ω (fun g p => β g p / V g) ρ V x e : ℂ) *
        (if m e.1 then fullEdgeLedgerPhase n S B A Δ D target H x e else 0) *
        F e.1 (fullEdgeLedgerRawTarget n S B A Δ D H x e) := by
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro a _
  by_cases ha : m a
  · simp only [ha, if_true]
    rw [joint_raw_tensor_cutoff_edge_events n
      (Δ (productActiveMemorySplit S B x).1 a)
      (D (productActiveMemorySplit S B x).1 a) (fun g => (S g)ᶜ.card) B
      (fun g => ((productActiveMemorySplit S B x).2 g).1) target H
      (fun g => (x g).2) β ρ V (row a) (hrows a ha)]
    rw [mul_sum]
    apply sum_congr rfl
    intro e _
    rw [full_edge_ledger_raw_target_eq]
    simp only [fullActiveEdgeEventWeight, Complex.ofReal_mul, fullEdgeLedgerPhase,
      jointStateEdgePhase, mul_assoc]
    rfl
  · simp only [ha, if_false, mul_zero, zero_mul, sum_const_zero]

end Full
