section

/- The actual long rough factor has a global constant bound at all frequencies. -/

open Finset Filter

namespace Bounty

theorem finite_dyadic_mellin_bounded_norm (S : Finset ℕ) (f : ℕ → ℂ)
    (u U B : ℝ) (hU : 1 ≤ U) (hB : 0 ≤ B)
    (hS : ∀ n ∈ S, U ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*U)
    (hf : ∀ n ∈ S, ‖f n‖ ≤ B) :
    ‖∑ n ∈ S, harmonicMellinWeight u n*f n‖ ≤ 2*B := by
  have hh := finite_dyadic_mellin_zeta_norm S f u U B 0 hU hB hS (by
    intro n hn
    have hnpos : 0 < n := by exact_mod_cast (zero_lt_one.trans_le hU).trans_le (hS n hn).1
    simpa only [zero_add, pow_one, ArithmeticFunction.zeta_apply_ne hnpos.ne', Nat.cast_one, mul_one]
      using hf n hn)
  simpa only [pow_zero, mul_one] using hh

theorem roughBand_mellin_global_norm (U A B W u : ℝ) (hU : 1 ≤ U)
    (hUA : U ≤ A) (hAB : A ≤ B) (hBU : B ≤ 2*U)
    (q : ℕ) (χ : DirichletCharacter ℂ q) :
    ‖∑ n ∈ roughBand A B W, harmonicMellinWeight u n*χ (n : ZMod q)‖ ≤ 2 := by
  have hA : 0 ≤ A := le_trans (by linarith) hUA
  have hB : 0 ≤ B := hA.trans hAB
  have hh := finite_dyadic_mellin_bounded_norm (roughBand A B W)
    (fun n => χ (n : ZMod q)) u U 1 hU zero_le_one (by
      intro n hn
      have hi := mem_Ioc.mp (mem_filter.mp hn).1
      exact ⟨hUA.trans ((Nat.floor_lt hA).mp hi.1).le,
        ((Nat.le_floor_iff hB).mp hi.2).trans hBU⟩)
    (fun n _ => χ.norm_le_one (n : ZMod q))
  simpa only [mul_one] using hh




end Bounty
end

