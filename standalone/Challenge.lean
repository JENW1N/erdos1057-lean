section

/- Actual mixed capped edge actions with arbitrary dependence on both small
endpoints. Positive domination precedes small-prefix conditioning, so the
coefficient is not required to be a spectator of either small completion. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {S G : Type*} [Fintype S] [Fintype G] [dG : DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (kbig : SharedActiveLabels P shared → ℤ)

noncomputable def physicalSmallBigFullWeight (_r : PhysicalResidues Ps)
    (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : PhysicalSmallBigFullEvent n shared B Δ D d x) : ℝ :=
  fullActiveEdgeEventWeight n shared B (fun _ => Unit) (fun c _ => Δ d c)
    (fun c _ => D d c) (fun _ _ => 1) μ ρ V x e

noncomputable def physicalSmallBigFullPhasedAction (Vs : S → ℝ) (q : ℝ)
    (Φ : ∀ s : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
      PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s → ℂ)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ) :=
  physicalSmallBigPhasedAction Vs q (PhysicalSmallBigFullEvent n shared B Δ D)
    (physicalSmallBigFullTarget n shared B Δ D)
    (physicalSmallBigFullWeight n shared B Δ D μ ρ V)
    (fun x => kbig (productActiveMemorySplit shared B x).1) Φ F

omit [Fintype S] [DecidableEq G] [∀ g, Fintype (P g)] in
theorem physical_small_big_full_weight_nonneg
    (hμ : ∀ g p, 0 ≤ μ g p) (hρ : 0 ≤ ρ) (hV : ∀ g, 0 ≤ V g)
    (r : PhysicalResidues Ps) (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : PhysicalSmallBigFullEvent n shared B Δ D d x) :
    0 ≤ physicalSmallBigFullWeight n shared B Δ D μ ρ V r d x e := by
  exact fullActiveEdgeEventWeight_nonneg n shared B (fun _ => Unit) _ _ _ μ ρ V
    (fun _ _ => zero_le_one) hμ hρ hV x e

theorem physical_small_big_full_positive_eq (Vs : S → ℝ) (q : ℝ)
    (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ) :
    physicalSmallBigAction Vs q 0 aux (fun _ => 1)
      (PhysicalSmallBigFullEvent n shared B Δ D)
      (physicalSmallBigFullTarget n shared B Δ D)
      (physicalSmallBigFullCoefficient n shared B Δ D μ ρ V (fun _ _ _ _ => 1))
      (fun x => kbig (productActiveMemorySplit shared B x).1) F =
    physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q (fun _ _ => 1) F := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  funext s
  unfold physicalSmallBigAction physicalSmallBigFullPhasedAction physicalSmallBigPhasedAction
  apply sum_congr rfl
  intro e _
  change physicalSmallBigEventWeight Vs q 0 aux (fun _ => 1)
    (PhysicalSmallBigFullEvent n shared B Δ D)
    (fun r d x e => (physicalSmallBigFullWeight n shared B Δ D μ ρ V r d x e : ℂ) * 1)
    (fun x => kbig (productActiveMemorySplit shared B x).1) s e * _ = _
  rw [physical_small_big_event_weight_phase]
  simp only [physicalPhase, zero_mul, Complex.ofReal_zero, Complex.exp_zero, mul_one]

end

theorem exists_physical_small_big_phased_energy_bound
    {q vs : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (S G : Type) [Fintype S] [DecidableEq S]
      [Fintype G] [DecidableEq G]
      (Ps : S → Finset ℕ) [∀ p : PhysicalPrime Ps, NeZero p.2.val]
      (P : G → Type) [∀ g, Fintype (P g)] (n : ∀ g, P g → ℕ)
      [∀ g p, NeZero (n g p)] (J : ℕ) (M : G → ℕ)
      (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
      (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
      (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
      (kbig : SharedActiveLabels P shared → ℤ)
      (Vs : S → ℝ), (∀ s, vs ≤ Vs s) →
      ∀ (_aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
        (v vmin vmax : ℝ), 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g p, 0 ≤ μ g p) → (∀ g, ∑ p, μ g p ≤ 2) →
      ∀ (T : ℕ), (∀ g, (shared g)ᶜ.card ≤ T) →
      ∀ (Φ : ∀ s : PhysicalSmallBigState Ps J ell
        (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B),
        PhysicalSmallBigEvent (PhysicalSmallBigFullEvent n shared B Δ D) s → ℂ)
        (H : ℝ), 0 ≤ H → (∀ s e, ‖Φ s e‖ ≤ H) →
      ∀ (F : PhysicalSmallBigState Ps J ell
        (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ),
      (∀ s, ProductMemorySymmetric (fun x => F (s, x))) →
      physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
        (physicalSmallBigFullPhasedAction n shared B Δ D μ ρ V kbig Vs q Φ F) ≤
        H ^ 2 * (A ^ (2 * Fintype.card S) *
          unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G) *
          physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_small_big_full_energy_bound hq0 hq1 hvs ell
  refine ⟨A, hA, ?_⟩
  intro S G _ dS _ dG
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro Ps _ P _ n _ J M shared B Δ D μ ρ V kbig Vs hVs aux
    v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht Φ H hH hΦ F hF
  let W : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → ℝ :=
    productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))
  have hW : ∀ x, 0 ≤ W x := productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)
  have hVs' : ∀ s, 0 < Vs s := fun s => hvs.trans_le (hVs s)
  have hFn : ∀ s, ProductMemorySymmetric (fun x => complexNormEnvelope F (s, x)) := by
    intro s x g τ
    exact congrArg (fun z : ℂ => (‖z‖ : ℂ)) (hF s x g τ)
  have hp := hbound S G Ps P n J M shared B Δ D μ ρ V kbig Vs hVs
    0 aux (fun _ => 1) 1 zero_le_one (by intro; simp only [norm_one, le_refl])
    v vmin vmax hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht
    (fun _ _ _ _ => 1) 1 zero_le_one (by intros; simp only [norm_one, le_refl])
    (complexNormEnvelope F) hFn
  rw [physical_small_big_full_positive_eq] at hp
  simp only [one_pow, mul_one, one_mul] at hp
  rw [← physical_small_big_energy_eq, ← physical_small_big_energy_eq,
    complexNormEnvelope_energy] at hp
  rw [← physical_small_big_energy_eq, ← physical_small_big_energy_eq]
  apply finite_weighted_energy_of_scaled_norm (physicalSmallBigMeasure Vs W)
    (physical_small_big_measure_nonneg Vs hVs' W hW) H hH
    (A ^ (2 * Fintype.card S) * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G)
    F _ _ _ hp
  intro s
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hH]
  change ‖physicalSmallBigPhasedAction _ _ _ _ _ _ Φ F s‖ ≤
    H * ‖physicalSmallBigPhasedAction _ _ _ _ _ _ (fun _ _ => 1)
      (fun y => (‖F y‖ : ℂ)) s‖
  rw [physical_small_big_positive_norm Vs hVs' q _ _ _
    (physical_small_big_full_weight_nonneg n shared B Δ D μ ρ V hμ hρ0.le
      (fun g => (hvmin.trans_le (hVlo g)).le))]
  exact physical_small_big_phase_norm_le Vs hVs' q _ _ _
    (physical_small_big_full_weight_nonneg n shared B Δ D μ ρ V hμ hρ0.le
      (fun g => (hvmin.trans_le (hVlo g)).le)) _ Φ H hΦ F s

end Bounty
end

