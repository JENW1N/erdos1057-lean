variable
  {I J : Type*}
  [sharedInstance1 : DecidableEq I]
  [sharedInstance2 : DecidableEq J]
  (U : Finset I)
  (V : Finset J)
  (r : Finset I → Finset J → ℂ)
  (q : Finset I → Finset J → Finset I → Finset J → ℂ)
  (hzero : ∀ S ∈ U.powerset, ∀ T ∈ V.powerset,
      ∀ A ∈ cleanNonemptySubsets U, ∀ B ∈ cleanNonemptySubsets V,
        ¬(A ⊆ U \ S ∧ B ⊆ V \ T) → q S T A B = 0)

include I J sharedInstance1 sharedInstance2 U V r q hzero

theorem clean_pattern_block_eq_component_block  :
    cleanSignedPatternBlock U V r q = cleanSignedComponentBlock U V r q := by
  unfold cleanSignedPatternBlock cleanSignedComponentBlock
  simp only [mul_sum, sum_sub_distrib]
  rw [clean_pattern_component_sum_comm]
  apply congrArg (fun z : ℂ => (∑ S ∈ U.powerset, ∑ T ∈ V.powerset, r S T) - z)
  apply sum_congr rfl
  intro S hS
  apply sum_congr rfl
  intro T hT
  exact clean_comparison_sum_restrict U V (q S T) S T (hzero S hS T hT)

theorem clean_signed_pattern_block_bound 
    (ε : ℝ) (hε : 0 ≤ ε)
    (herr : ∀ S ∈ U.powerset, ∀ T ∈ V.powerset,
      ∀ A ∈ cleanNonemptySubsets (U \ S), ∀ B ∈ cleanNonemptySubsets (V \ T),
        ‖q S T A B - r S T‖ ≤ ε) :
    ‖cleanSignedPatternBlock U V r q‖ ≤
      ‖(∑ T ∈ V.powerset, r U T) + ∑ S ∈ U.powerset.erase U, r S V‖ +
        (3 : ℝ) ^ (U.card + V.card) * ε := by
  rw [clean_pattern_block_eq_component_block U V r q hzero, clean_signed_block_cancellation]
  exact (norm_sub_le _ _).trans (add_le_add le_rfl (clean_signed_component_error_bound U V r q ε hε herr))

end

