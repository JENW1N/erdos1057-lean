section

/- The precise remaining ambient weighted replacement statement and its prime-mass consequence. -/

open Finset Filter
namespace Bounty




theorem candidate_shifted_prime_fraction_of_fixed_slot_error_bound
    (hZ : PrimitiveZeroFreeHalfPlane)
    {c q : ℝ} {r : ℕ} (hc : 0<c) (hr : 0<r) (hq0 : 0≤q) (hq1 : q<1)
    (hcenter : (11/5:ℝ)*(r:ℝ)*c=1)
    (hR : ∀ (κ b : ℝ) (N : ℕ), 0<κ → κ≤1/50 → 0<b → b<1/2-κ → 0<N →
      ∃ J : ℕ, ∀ jStar : ℕ, J<jStar → ∃ S : ℝ, 0≤S ∧ ∀ᶠ L : ℝ in atTop,
        |ambientBuchstabMeshError (arithmeticProductWindow 1 (Real.exp L))
          (candidateCoefficient c L q r jStar) b (1/2-κ) κ L S N| ≤
            ((N:ℝ)+1)*candidateCoefficientWindowMass c L q r jStar*L^(-2:ℝ)) :
    ∃ J : ℕ, ∀ jStar : ℕ, J<jStar → ∀ᶠ L : ℝ in atTop,
      (shiftedSieveRatioConstant/4)*candidateCoefficientWindowMass c L q r jStar/L ≤
        ∑ u ∈ (arithmeticProductWindow 1 (Real.exp L)).filter (fun u => (2*u+1).Prime),
          candidateCoefficient c L q r jStar u := by
  classical
  obtain ⟨κ,qCut,b,h,N,M,hκ,hκmax,hqCut,hqCut0,hqCuthalf,hb,hbq,hh,heven,hlevel,hN,hbins,hmesh,hgap⟩ :=
    exists_candidate_positive_proxy_gap_uniform_precision hZ hc hr hq0 hq1 hcenter
  subst qCut
  obtain ⟨Jerr,herr⟩ := hR κ b N hκ hκmax hb hbq hN
  obtain ⟨Jgap,hgapAll⟩ := hgap
  refine ⟨max Jerr Jgap,?_⟩
  intro jStar hj
  have hjerr := lt_of_le_of_lt (le_max_left Jerr Jgap) hj
  have hjgap := lt_of_le_of_lt (le_max_right Jerr Jgap) hj
  obtain ⟨S,hS,herrS⟩ := herr jStar hjerr
  have hratio : 0<shiftedSieveRatioConstant :=
    lt_of_lt_of_le zero_lt_one shifted_sieve_ratio_constant_bounds.1
  filter_upwards [herrS,hgapAll S hS jStar hjgap,
    eventually_shifted_ambient_mesh_prime_lower hκ hκmax hbq.le hN,
    eventually_gt_atTop (0:ℝ),eventually_ge_atTop (12*((N:ℝ)+1)/shiftedSieveRatioConstant)]
    with L herror hpositive hlower hL hLbig
  let T := arithmeticProductWindow 1 (Real.exp L)
  let μ := candidateCoefficient c L q r jStar
  let X := candidateCoefficientWindowMass c L q r jStar
  let F : Fin N → Finset (ℕ×ℕ) := fun i => shiftedPrimeBandPairs T
    (Real.exp (reciprocalGrid b (1/2-κ) N (i:ℕ)*L))
    (Real.exp (reciprocalGrid b (1/2-κ) N ((i:ℕ)+1)*L))
  let B := shiftedBalancedPairs T κ L
  have hμ : ∀u∈T,0≤μ u := fun u _ => candidate_coefficient_nonneg c L hq0 r jStar u
  have hX : 0≤X := sum_nonneg hμ
  have hpos := hpositive F (fun _ => shiftedPairIndex) B shiftedPairIndex
    (fun i v hv => shifted_prime_band_pair_data T _ _ hv)
    (fun v hv => by
      have hd := shifted_balanced_pair_data T κ L hv
      exact ⟨hd.2.1,hd.1,hd.2.2⟩)
  have hlo := hlower μ S hμ
  let E := ambientBuchstabMeshError T μ b (1/2-κ) κ L S N
  let U := ambientBuchstabUnbalancedProxy T μ b (1/2-κ) L S N
  let BP := ambientBuchstabBalancedProxy T μ κ L S
  let R := candidateShiftedRoughMass c L q r jStar (Real.exp (b*L))
  change (shiftedSieveRatioConstant/3)*X/L ≤ R-U-BP at hpos
  change R-U-BP-E ≤ ∑ u∈(shiftedRoughSet T (Real.exp (b*L))).filter
    (fun u=>(2*u+1).Prime),μ u at hlo
  have hscalar : ((N:ℝ)+1)*L^(-2:ℝ) ≤ (shiftedSieveRatioConstant/12)/L := by
    rw [Real.rpow_neg hL.le,Real.rpow_two,← div_eq_mul_inv]
    have hbig := (div_le_iff₀ hratio).mp hLbig
    apply (div_le_iff₀ (sq_pos_of_pos hL)).mpr
    have heq : ((shiftedSieveRatioConstant/12)/L)*L^2=shiftedSieveRatioConstant*L/12 := by
      field_simp
    rw [heq]
    linarith
  have hE : E ≤ (shiftedSieveRatioConstant/12)*X/L := by
    have he := (le_abs_self E).trans herror
    have hh := mul_le_mul_of_nonneg_left hscalar hX
    calc
      E ≤ ((N:ℝ)+1)*X*L^(-2:ℝ) := he
      _ = X*(((N:ℝ)+1)*L^(-2:ℝ)) := by ring
      _ ≤ X*((shiftedSieveRatioConstant/12)/L) := hh
      _ = _ := by ring
  have hprime : (shiftedSieveRatioConstant/4)*X/L ≤
      ∑ u∈(shiftedRoughSet T (Real.exp (b*L))).filter (fun u=>(2*u+1).Prime),μ u := by
    have heq : (shiftedSieveRatioConstant/4)*X/L=
      (shiftedSieveRatioConstant/3)*X/L-(shiftedSieveRatioConstant/12)*X/L := by ring
    rw [heq]
    linarith
  apply hprime.trans
  apply sum_le_sum_of_subset_of_nonneg
  · intro u hu
    exact mem_filter.mpr ⟨(mem_shifted_rough_set_iff T _ u).mp (mem_filter.mp hu).1 |>.1,
      (mem_filter.mp hu).2⟩
  · intro u hu hnot
    exact hμ u (mem_filter.mp hu).1









end Bounty
end

section

/- Summing the original dyadic blocks preserves any prescribed logarithmic saving. -/

open Finset Filter
namespace Bounty

theorem eventually_original_bilinear_block_assembly (D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ μ α β : ℕ → ℝ,
      (∀ i ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        ∀ j ∈ dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊),
        let B := shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) i) α)
          (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) j) β)
        B ≠ 0 → |B| ≤ Real.exp L * L^(-(D+4))) →
      |shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ α β| ≤
        Real.exp L * L^(-D) := by
  filter_upwards [eventually_original_dyadic_count,eventually_gt_atTop (0 : ℝ)]
    with L hcount hL
  intro μ α β hblocks
  rw [shifted_typeII_bilinear_eq_dyadic_restrictions _ _ _ _ _
    (fun _ hu => shifted_wide_window_nat_factor_bound hL.le hu)]
  have hsum := abs_double_sum_le_card_sq (dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊))
    (fun i j => shiftedTypeIIBilinear (arithmeticProductWindow 1 (Real.exp L)) μ
      (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) i) α)
      (typeIIRestrict (dyadicNatBucket (Icc 1 ⌊33*Real.exp L⌋₊) j) β))
    (by positivity : 0 ≤ Real.exp L * L^(-(D+4))) hblocks
  have hsq : (((dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊)).card : ℝ))^2 ≤ L^4 := by
    nlinarith [Nat.cast_nonneg (α := ℝ) (dyadicNatIndices (Icc 1 ⌊33*Real.exp L⌋₊)).card]
  apply hsum.trans
  calc
    _ ≤ L^4 * (Real.exp L * L^(-(D+4))) :=
      mul_le_mul_of_nonneg_right hsq (by positivity)
    _ = Real.exp L * (L^(4 : ℝ) * L^(-(D+4))) := by rw [Real.rpow_ofNat]; ring
    _ = Real.exp L * L^(-D) := by rw [← Real.rpow_add hL]; congr 2; ring

end Bounty
end

section

/- The path-dependent small factor is a deterministic residue ledger on the
original planned big path, with the original local small edge weights. -/

open scoped Classical
namespace Bounty
section Ledger
variable {S G I V K : Type} [Fintype S]
  {Ps : S → Finset ℕ} {P : G → Type}
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : I → ∀ g, Finset (Fin (M g))) (B : ℕ) (A : I → Type)
  (Δ D : ∀ _k : K, ∀ i, PhysicalSharedLists Ps J → SharedActiveLabels P (shared i) → A i → G → ℤ)

abbrev PhysicalPlannedResidueEvent :=
  FullPermutationMixedEvent (J := V) n
    (fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K) => shared key.2.1) B
    (fun key _ => A key.2.1)
    (fun key c a => Δ key.1 key.2.1 (physicalSharedPrefix key.2.2.1) c a)
    (fun key c a => D key.1 key.2.1 (physicalSharedPrefix key.2.2.1) c a)

noncomputable abbrev physicalPlannedResidueTarget :=
  fullPermutationMixedEventTarget (J := V) n
    (fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K) => shared key.2.1) B
    (fun key _ => A key.2.1)
    (fun key c a => Δ key.1 key.2.1 (physicalSharedPrefix key.2.2.1) c a)
    (fun key c a => D key.1 key.2.1 (physicalSharedPrefix key.2.2.1) c a)

variable (kbig : ∀ _k : K, ∀ i, SharedActiveLabels P (shared i) → A i → ℤ)

noncomputable def physicalPlannedSmallUpdate
    (tag : Option (V ⊕ PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K)))
    (r : PhysicalResidues Ps)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    PhysicalPlannedResidueEvent n shared B A Δ D tag x → PhysicalResidues Ps :=
  match tag with
  | none => fun _ => r
  | some (.inl _) => fun _ => r
  | some (.inr key) => fun e => physicalTranslateResidues r
      (kbig key.1 key.2.1 (productActiveMemorySplit (shared key.2.1) B x).1 e.1 *
        (physicalSharedProduct (physicalSharedPrefix key.2.2.1) : ℕ))

variable (Vs : S → ℝ) (qedge : K → ℝ)

noncomputable def physicalPlannedSmallPhase
    (tag : Option (V ⊕ PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K)))
    (r : PhysicalResidues Ps)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    PhysicalPlannedResidueEvent n shared B A Δ D tag x → ℂ :=
  match tag with
  | none => fun _ => ((Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹ : ℂ)
  | some (.inl _) => fun _ => 1
  | some (.inr key) => fun e =>
      if physicalSharedPrefix key.2.2.1 = physicalSharedPrefix key.2.2.2 then
        ((physicalCompletionMass Vs (fun _ => (∅ : Finset (Fin J))) ell *
          (physicalResidueVertexWeight key.2.2.1 (Real.sqrt (qedge key.1)) r *
            physicalResidueVertexWeight key.2.2.2 (Real.sqrt (qedge key.1))
              (physicalPlannedSmallUpdate n shared B A Δ D kbig (some (.inr key)) r x e)) : ℝ) : ℂ)
      else 0

theorem physical_mixed_plan_small_factor_eq_ledger
    (ks : List (Option (V ⊕ K))) (r : PhysicalResidues Ps) (L : PhysicalMarkLists Ps J ell)
    (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : PhysicalMixedPlannedBigPath n shared B A Δ D ks L pl x) :
    (physicalMixedPlanSmallFactor n shared B A Δ D kbig Vs qedge ks r L pl x p : ℂ) =
      deterministicLedgerPhase (PhysicalPlannedResidueEvent n shared B A Δ D)
        (physicalPlannedResidueTarget n shared B A Δ D)
        (physicalPlannedSmallUpdate n shared B A Δ D kbig)
        (physicalPlannedSmallPhase n shared B A Δ D kbig Vs qedge)
        (physicalMixedBigSteps ks L pl) r x p := by
  induction ks generalizing r L x with
  | nil => rfl
  | cons tag ks ih =>
    cases tag with
    | none =>
      rcases pl with ⟨σ, pl⟩
      rcases p with ⟨⟨τ⟩, p⟩
      simp only [physicalMixedPlanSmallFactor, physicalMixedPathPack, finiteEventPathWeight,
        physicalMixedSmallWeight, physicalMixedBigSteps, deterministicLedgerPhase,
        physicalPlannedSmallUpdate, physicalPlannedSmallPhase, Complex.ofReal_mul] at ih ⊢
      simpa only [Complex.ofReal_inv, physicalMixedWordTarget, physicalPlannedResidueTarget,
        fullPermutationMixedEventTarget] using
        congrArg (((Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹ : ℂ) * ·)
          (ih r (physicalPermuteLabels σ L) pl (fullActivePermutation τ x) p)
    | some tag =>
      cases tag with
      | inl j =>
        rcases p with ⟨⟨e⟩, p⟩
        simp only [physicalMixedPlanSmallFactor, physicalMixedPathPack, finiteEventPathWeight,
          physicalMixedSmallWeight, physicalMixedBigSteps, deterministicLedgerPhase,
          physicalPlannedSmallUpdate, physicalPlannedSmallPhase, one_mul] at ih ⊢
        exact ih r L pl (coupledGhostJointEventTarget M B x e) p
      | inr k =>
        rcases pl with ⟨⟨i, R⟩, pl⟩
        rcases p with ⟨⟨a, e⟩, p⟩
        simp only [physicalMixedPlanSmallFactor, physicalMixedPathPack, finiteEventPathWeight,
          physicalMixedSmallWeight, physicalMixedBigSteps, deterministicLedgerPhase,
          physicalPlannedSmallUpdate, physicalPlannedSmallPhase, Complex.ofReal_mul] at ih ⊢
        erw [ih]
        split_ifs <;> simp only [Complex.ofReal_mul, Complex.ofReal_zero, zero_mul]
        rfl

end Ledger
end Bounty
end

section

/- Both replacement errors decay on the actual original candidate harmonic support. -/

open Filter Finset Real
open scoped Classical
namespace Bounty

theorem eventually_candidate_harmonic_replacement_decay {c b K : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hK : 0 ≤ K) (J ell : ℕ) (Cenv E D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (groups : Finset ℕ), groups ⊆ candidatePIndices c L →
      ∀ (probes : groups → Finset (Fin J)) (r t : Finset groups) (hrt : Disjoint r t)
        (Q : ℕ) (h ξ : ℝ), 0 < ξ →
      ∀ (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
        (aux : PhysicalAuxLabels (fun g : groups => candidatePBand (c*L) g.val)
          (repeatedBigPrimePatternCut probes r t i)),
      repeatedBigPrimePatternBound probes r t Q ξ i ≤ L^E →
      ∀ (a a' : ℝ) (pool : Finset ℕ), (∀ g : groups, candidatePBand (c*L) g.val ⊆ pool) →
      ∀ (α β γ α' β' γ' : ℕ → ℂ),
      (∀ n, ‖α n‖ ≤ L^Cenv) → (∀ n, ‖β n‖ ≤ L^Cenv) → (∀ n, ‖γ n‖ ≤ L^Cenv) →
      (∀ n, ‖α' n‖ ≤ L^Cenv) → (∀ n, ‖β' n‖ ≤ L^Cenv) → (∀ n, ‖γ' n‖ ≤ L^Cenv) →
      ∀ U V : ℝ, exp (b*L) ≤ U → U ≤ exp L → exp (b*L) ≤ V → V ≤ exp L →
      ∀ k ∈ Icc (-(typeIIAdmissibleDeterminantBound L K : ℤ)) (typeIIAdmissibleDeterminantBound L K : ℤ),
      ∀ j ∈ range (typeIISmoothDyadicCount L),
      ‖physicalPositiveHarmonicDifference (fun g : groups => candidatePBand (c*L) g.val)
        (fun g => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ)) probes r t hrt Q h ξ i aux
        a a' (typeIISmoothDyadicScale U V (U*L^(-K)) j) k pool α β γ α' β' γ'‖ ≤ L^(-D) := by
  obtain ⟨v, m, hv, hm, hmarked⟩ := exists_candidate_marked_error_inputs hc (ell+J)
  obtain ⟨v', Aslot, _, hAslot, hslots⟩ := exists_candidate_shared_error_inputs hc J
  obtain ⟨v'', vmax, _, _, hpoolData⟩ := exists_candidate_P_pool_bounds hc
  let T : ℝ := 2*m+6*Cenv+31
  filter_upwards [hmarked, hslots, hpoolData,
    eventually_actual_candidate_harmonic_parameters hc hb hK hAslot (by norm_num : (0 : ℝ) < 1),
    eventually_candidate_shared_polynomial_error hc (by norm_num : (0 : ℝ) ≤ 2) J E (D+T+1),
    eventually_candidate_free_error_decay hc J (T+E+1) (D+1),
    eventually_ge_atTop (5 : ℝ)] with L hmL hslotL hpL hparam hsharedL hfreeL hL
  intro groups hgroups probes r t hrt Q h ξ hξ i aux hHbound a a' pool hpool
    α β γ α' β' γ' hα hβ hγ hα' hβ' hγ' U V hUlo hUhi hVlo hVhi k hk j hj
  let P := fun g : groups => candidatePBand (c*L) g.val
  let mass := fun g : groups => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ)
  let cut := repeatedBigPrimePatternCut probes r t i
  let d := physicalFreeFactor cut aux
  let Z := typeIISmoothDyadicScale U V (U*L^(-K)) j
  let Y := Z*(d : ℝ)/2
  let N := ⌈3*Z*(d : ℝ)⌉₊
  let energy := 2*((N : ℝ)/Y)*(1+log N)^15
  let M := (markedDivisorBound (1/2) v (ell+J))^Fintype.card groups
  let H := repeatedBigPrimePatternBound probes r t Q ξ i
  let common := M*M*(L^Cenv*L^Cenv*L^Cenv)^2*energy
  have hL0 : 0 < L := by linarith
  have hL2 : 2 ≤ L := by linarith
  have hcnt : (J*Fintype.card groups : ℕ) ≤ Aslot*log L := by
    simpa only [Fintype.card_coe] using (hslotL groups hgroups).1
  have hh := hparam groups (fun g => ⟨g.val, hgroups g.property⟩) J cut aux hcnt
    U V hUlo hUhi hVlo hVhi k hk j hj
  obtain ⟨hZ, hkZ, hprod, hcut, hY, hYlo, _, _, _, he, hNlog, hs⟩ := hh
  have hprime : ∀ g p, p ∈ P g → p.Prime := by
    intro g p hpg
    exact ((hpL.2.2.2.2.2 g.val (hgroups g.property)).2.2 p hpg).1
  have hdis : Pairwise (fun g g' => Disjoint (P g) (P g')) := by
    intro g g' hne
    exact hpL.2.2.2.2.1 (by intro heq; exact hne (Subtype.ext heq))
  have hmass : ∀ g, v ≤ mass g := (hmL groups hgroups).2
  have hM : M ≤ L^m := (hmL groups hgroups).1
  have hM0 : 0 ≤ M := pow_nonneg (zero_le_one.trans (one_le_markedDivisorBound (1/2) v (ell+J))) _
  have hH0 : 0 ≤ H := repeated_big_prime_pattern_bound_nonneg probes r t Q ξ i
  have henergy0 : 0 ≤ energy := by
    have hlog0 : 0 ≤ log (N : ℝ) := Real.log_natCast_nonneg N
    dsimp only [energy]
    positivity
  have hc0 : 0 ≤ common := mul_nonneg (mul_nonneg (mul_nonneg hM0 hM0) (sq_nonneg _)) henergy0
  have hcBound : common ≤ L^T := harmonic_error_power_envelope hL0 hM0 hM henergy0 he
  have hfreeBound := hfreeL groups hgroups cut aux (2*common*H)
    (mul_nonneg (mul_nonneg (by norm_num) hc0) hH0)
    (harmonic_free_error_power_envelope hL2 hc0 hcBound hH0 hHbound)
  have hNpower : log (N : ℝ) ≤ L^(2 : ℝ) := by
    calc
      _ ≤ 5*L := by simpa only [show (4 : ℝ)+1=5 by norm_num] using hNlog
      _ ≤ L*L := mul_le_mul_of_nonneg_right hL hL0.le
      _ = _ := by norm_num [pow_two]
  have hsmall : ∀ n ∈ harmonicPositiveSupport Z k d,
      (∑ g : groups, (J-(cut g).card : ℕ) *
        (log n.natAbs/log 2 + log (n+k*(d : ℤ)).natAbs/log 2 + J) /
          (mass g*exp (L^(1/10 : ℝ)))) *
        (H+H/(1/2 : ℝ)^(2*∑ g : groups, (J-(cut g).card))) ≤ L^(-(D+T+1)) := by
    intro n hn
    have hn0 : 0 < n := (mem_harmonic_positive_support hn).1
    have hn' := hs n hn
    have hwInterval : 0 ≤ n ∧ n ≤ (N : ℤ) := hn'.1
    have hzInterval : 0 < n+k*(d : ℤ) ∧ n+k*(d : ℤ) ≤ (N : ℤ) := hn'.2.1
    have hw : 0 < n.natAbs := Int.natAbs_pos.mpr hn0.ne'
    have hz : 0 < (n+k*(d : ℤ)).natAbs := Int.natAbs_pos.mpr hn'.2.1.1.ne'
    have hwN : n.natAbs ≤ N := by omega
    have hzN : (n+k*(d : ℤ)).natAbs ≤ N := by omega
    have hlogw : log (n.natAbs : ℝ) ≤ L^(2 : ℝ) := by
      exact (log_le_log (show (0 : ℝ) < n.natAbs by exact_mod_cast hw)
        (show (n.natAbs : ℝ) ≤ (N : ℝ) by exact_mod_cast hwN)).trans hNpower
    have hlogz : log ((n+k*(d : ℤ)).natAbs : ℝ) ≤ L^(2 : ℝ) := by
      exact (log_le_log (show (0 : ℝ) < (n+k*(d : ℤ)).natAbs by exact_mod_cast hz)
        (show ((n+k*(d : ℤ)).natAbs : ℝ) ≤ (N : ℝ) by exact_mod_cast hzN)).trans hNpower
    exact hsharedL groups hgroups cut _ _ H hw hz hlogw hlogz hH0 hHbound
  have hbound := physical_positive_harmonic_replacement_error P mass probes hprime hdis hv hmass
    (fun _ => rfl) r t hrt Q h ξ hξ i aux a a' hZ k hkZ (exp_pos _)
    (rpow_nonneg hL0.le (-(D+T+1)))
    (fun g p => ((hpL.2.2.2.2.2 g.val (hgroups g.property)).2.2 p.val p.property).2.1.le)
    pool hpool α β γ α' β' γ' (rpow_nonneg hL0.le Cenv) (rpow_nonneg hL0.le Cenv)
    (rpow_nonneg hL0.le Cenv) hα hβ hγ hα' hβ' hγ' hsmall
  apply hbound.trans
  have hsharedBound := harmonic_error_decay_absorb (D := D) hL0 hcBound
  have hsum := add_le_add hsharedBound hfreeBound
  have heq : -(D+1) = -D-1 := by ring
  rw [heq] at hsum
  apply (le_trans ?_ (hsum.trans (harmonic_two_errors_absorb (D := D) hL2)))
  dsimp only [common, energy, M, H, N, Y, Z, d, cut]
  ring_nf
  exact le_refl _

end Bounty
end

section

/- Selected endpoint peeling has arbitrary power saving on the original candidate harmonic ranges. -/

open Filter Finset Real
open scoped Classical
namespace Bounty

theorem eventually_candidate_selected_harmonic_peel_decay {c b K : ℝ}
    (hc : 0 < c) (hb : 0 < b) (hK : 0 ≤ K) (J ell : ℕ) (Cb Ce D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (groups : Finset ℕ), groups ⊆ candidatePIndices c L →
      ∀ (cut : groups → Finset (Fin J))
        (aux : PhysicalAuxLabels (fun g : groups => candidatePBand (c*L) g.val) cut)
        (big : Finset groups) (g : groups) (κ : ℕ),
      ell+(cut g).card = κ+1 → g ∉ big →
      ∀ (b₀ b₁ : GroupMarkedLists (fun j : big => candidatePBand (c*L) j.val.val)
          (fun j : big => ell+(cut j.val).card) → ℂ),
      (∀ l, ‖b₀ l‖ ≤ L^Cb) → (∀ l, ‖b₁ l‖ ≤ L^Cb) →
      ∀ (pool : Finset ℕ), (∀ j : groups, candidatePBand (c*L) j.val ⊆ pool) →
      ∀ (α₀ β₀ γ₀ α₁ β₁ γ₁ : ℕ → ℂ),
      (∀ n, ¬ Disjoint n.primeFactors pool → α₀ n = 0) →
      (∀ n, ¬ Disjoint n.primeFactors pool → β₀ n = 0) →
      (∀ n, ¬ Disjoint n.primeFactors pool → α₁ n = 0) →
      (∀ n, ¬ Disjoint n.primeFactors pool → β₁ n = 0) →
      (∀ n, ‖α₀ n‖ ≤ L^Ce) → (∀ n, ‖β₀ n‖ ≤ L^Ce) → (∀ n, ‖γ₀ n‖ ≤ L^Ce) →
      (∀ n, ‖α₁ n‖ ≤ L^Ce) → (∀ n, ‖β₁ n‖ ≤ L^Ce) → (∀ n, ‖γ₁ n‖ ≤ L^Ce) →
      ∀ U V : ℝ, exp (b*L) ≤ U → U ≤ exp L → exp (b*L) ≤ V → V ≤ exp L →
      ∀ k ∈ Icc (-(typeIIAdmissibleDeterminantBound L K : ℤ)) (typeIIAdmissibleDeterminantBound L K : ℤ),
      ∀ j ∈ range (typeIISmoothDyadicCount L),
      let P := fun g : groups => candidatePBand (c*L) g.val
      let mass := fun g : groups => ∑ p ∈ P g, 1/(p : ℝ)
      let marks := fun g : groups => ell+(cut g).card
      let Z := typeIISmoothDyadicScale U V (U*L^(-K)) j
      let d := physicalFreeFactor cut aux
      let S := harmonicPositiveSupport Z k d
      let δ : ℤ := k*(d : ℤ)
      ∀ θ : ℤ → ℂ, (∀ n ∈ S, ‖θ n‖ ≤ 2) →
      ‖(∑ n ∈ S, (θ n/(n : ℂ)) *
          star (selectedMarkedEndpoint P (1/2) mass marks big b₀ pool α₀ β₀ γ₀ n.natAbs) *
          selectedMarkedEndpoint P (1/2) mass marks big b₁ pool α₁ β₁ γ₁ (n+δ).natAbs) -
        (∑ n ∈ S, (θ n/(n : ℂ)) *
          star (selectedPeeledEndpoint P (1/2) mass marks g κ big b₀ pool α₀ β₀ γ₀ n.natAbs) *
          selectedPeeledEndpoint P (1/2) mass marks g κ big b₁ pool α₁ β₁ γ₁ (n+δ).natAbs)‖ ≤ L^(-D) := by
  obtain ⟨v, m, hv, _, hmarked⟩ := exists_candidate_marked_error_inputs hc (ell+J)
  obtain ⟨_, Aslot, _, hAslot, hslots⟩ := exists_candidate_shared_error_inputs hc J
  obtain ⟨_, vmax, _, _, hpoolData⟩ := exists_candidate_P_pool_bounds hc
  let T := 2*m+2*Cb+6*Ce+32
  let B := max 0 (D+T)
