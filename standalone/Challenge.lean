    (C : Fin N → Finset (Fin J)) (L : PhysicalMarkLists P J ell)
    (q : (g : Fin N) → BoundedOrderedTuple
      (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
    (aux : PhysicalAuxLabels P C) (g : Fin N) :
    physicalFullEdgeD C (productActiveMemorySplit
      (fun g => physicalFullSharedIndices (C g)) B (physicalFullMemoryState C L q)).1 aux g =
      (physicalD C L aux : ℤ) := by
  unfold physicalFullEdgeD
  rw [physical_full_shared_D_eq]

theorem physical_full_edge_delta_at_state {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (C : Fin N → Finset (Fin J)) (k : ℤ) (L : PhysicalMarkLists P J ell)
    (q : (g : Fin N) → BoundedOrderedTuple
      (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
    (aux : PhysicalAuxLabels P C) (g : Fin N) :
    physicalFullEdgeDelta C k (productActiveMemorySplit
      (fun g => physicalFullSharedIndices (C g)) B (physicalFullMemoryState C L q)).1 aux g =
      -k * (physicalD C L aux : ℤ) := by
  unfold physicalFullEdgeDelta
  rw [physical_full_edge_D_at_state]
