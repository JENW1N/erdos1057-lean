     kernelCuspFourier_residue_eq_zero_of_not_horizontal h hh,zero_div]

theorem kernelSourceProjection_height_residue (a b:ℝ) (ha:0<a) (ρ:BoundedContinuousFunction ℝ ℂ) (h:Eis) :
