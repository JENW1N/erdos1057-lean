/- Envelope bounds retain the norms of the original symmetric tests after
additional averaging has changed the vectors used in the raw pairing. -/
theorem finite_exceptional_pairing_envelope {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ y, μ i y = 1)
    (U V : Finset I) (k : (∀ i, X i) → ℂ) (hk : ∀ x, ‖k x‖ ≤ 1)
    (f g : (∀ i, X i) → ℂ) (a b θA θB : ℝ)
    (hf : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) ≤ a)
    (hg : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) ≤ b)
    (hA : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ U U.toList f)) ≤ θA * a)
    (hB : Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ V V.toList g)) ≤ θB * b) :
    ‖cleanRawPairing (finiteProductWeight μ) k (finiteCoordinateComponent μ U U.toList f) g +
      cleanRawPairing (finiteProductWeight μ) k
        (f - finiteCoordinateComponent μ U U.toList f) (finiteCoordinateComponent μ V V.toList g)‖ ≤
      (θA + θB) * a * b := by
  have hw : ∀ x, 0 ≤ finiteProductWeight μ x := fun x => prod_nonneg (fun i _ => hμ i (x i))
  have ha : 0 ≤ a := (Real.sqrt_nonneg _).trans hf
  have hθa : 0 ≤ θA * a := (Real.sqrt_nonneg _).trans hA
  calc
    _ ≤ ‖cleanRawPairing (finiteProductWeight μ) k (finiteCoordinateComponent μ U U.toList f) g‖ +
        ‖cleanRawPairing (finiteProductWeight μ) k
          (f - finiteCoordinateComponent μ U U.toList f) (finiteCoordinateComponent μ V V.toList g)‖ := norm_add_le _ _
    _ ≤ Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ U U.toList f)) *
          Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) +
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (f - finiteCoordinateComponent μ U U.toList f)) *
          Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ V V.toList g)) :=
      add_le_add (clean_raw_pairing_norm_le _ hw k hk _ _) (clean_raw_pairing_norm_le _ hw k hk _ _)
    _ ≤ (θA * a) * b + a * (θB * b) := by
      apply add_le_add
      · exact mul_le_mul hA hg (Real.sqrt_nonneg _) hθa
      · exact mul_le_mul ((finite_probe_complement_norm_le μ hμ hmass U f).trans hf) hB
          (Real.sqrt_nonneg _) ha
    _ = _ := by ring
end

