/- The selected ordered-list average preserves the polynomial marked-weight bound. -/

open Finset

namespace Bounty

theorem selected_marked_weight_norm_le_rpow {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (Q : Finset ℕ) {q v L K B : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (hL : 0 < L)
    (V : G → ℝ) (t u : G → ℕ) (T : ℕ) (big : Finset G)
    (hV : ∀ g, v ≤ V g) (ht : ∀ g, t g ≤ T)
    (hcard : (Fintype.card G : ℝ) ≤ K*Real.log L)
    (b : GroupMarkedLists (fun g : big => P g.val) (fun g : big => u g.val) → ℂ)
    (hb : ∀ l, ‖b l‖ ≤ L^B) (κ : ℕ → ℂ) (hκ : ∀ d, ‖κ d‖ ≤ 1) (n : ℕ) :
    ‖selectedMarkedWeight P Q q V t u big b κ n‖ ≤
      L^(K*Real.log (markedDivisorBound q v T)+B) := by
  have hw := marked_divisor_weight_le_rpow univ P hq0 hq1 hv hL V t T
    (fun g _ => hV g) (fun g _ => ht g) (by simpa only [card_univ] using hcard) (n : ℤ)
  have hw0 := marked_divisor_weight_nonneg univ P hq0 V t
    (fun g _ => hv.le.trans (hV g)) (n : ℤ)
  have hb' := group_marked_average_norm_le (fun g : big => P g.val)
    (fun g : big => u g.val) (n : ℤ) b (Real.rpow_nonneg hL.le B) (fun l => hb l.val)
  rw [selectedMarkedWeight,norm_mul,norm_mul,Complex.norm_real,Real.norm_eq_abs,
    abs_of_nonneg hw0]
  calc
    _ ≤ (1*L^(K*Real.log (markedDivisorBound q v T)))*L^B :=
      mul_le_mul (mul_le_mul (hκ _) hw hw0 (by norm_num)) hb'
        (norm_nonneg _) (by positivity)
    _ = _ := by rw [one_mul,← Real.rpow_add hL]

end Bounty
