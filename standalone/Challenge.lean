open scoped BigOperators Classical
theorem prime_tuple_cell_norm_le {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (V : I → ℝ) (i : I)
    (hV : ∀ j, 0 < V j) (hp : ∀ j p, p ∈ P j → 0 < p)
    (hmass : ∀ j, ∑ p ∈ P j, 1 / (p : ℝ) = V j)
    {q : ℕ} (χ : DirichletCharacter ℂ q) (U W : ℝ) {B : ℝ} (hB : 0 ≤ B)
    (hinner : ∀ c : ℕ, 0 < c →
      ‖∑ p ∈ (P i).filter (fun p : ℕ => U < ((c * p : ℕ) : ℝ) ∧ ((c * p : ℕ) : ℝ) ≤ W),
        (1 / (p : ℝ)) • χ (p : ZMod q)‖ ≤ B) :
    ‖∑ x : (∀ j, P j), (finiteProductWeight (physicalLabelLaw V) x : ℂ) *
        (if U < ((∏ j, (x j).val : ℕ) : ℝ) ∧ ((∏ j, (x j).val : ℕ) : ℝ) ≤ W
        then χ ((∏ j, (x j).val : ℕ) : ZMod q) else 0)‖ ≤ B / V i := by
  let μ : ∀ j, P j → ℝ := physicalLabelLaw V
  let F : ℕ → ℂ := fun n => if U < (n : ℝ) ∧ (n : ℝ) ≤ W then χ (n : ZMod q) else 0
  let R := ∀ j : {j : I // j ≠ i}, P j.val
  let c : R → ℕ := fun z => ∏ j, (z j).val
  let ν : R → ℝ := fun z => ∏ j, μ j.val (z j)
  let S : R → Finset ℕ := fun z => (P i).filter (fun p : ℕ =>
    U < ((c z * p : ℕ) : ℝ) ∧ ((c z * p : ℕ) : ℝ) ≤ W)
  have hsplit := finite_product_value_expectation_split μ (fun j (p : P j) => p.val) i F
  change ‖∑ x, (finiteProductWeight μ x : ℂ) * F (∏ j, (x j).val)‖ ≤ B / V i
  rw [hsplit]
  have hrow (z : R) : (∑ y : P i, (μ i y : ℂ) * F (y.val * c z)) =
      ∑ p ∈ S z, (1 / (V i * (p : ℝ))) • χ ((c z * p : ℕ) : ZMod q) := by
    unfold S
    rw [Finset.sum_filter]
    rw [← Finset.sum_coe_sort (P i)]
    apply Finset.sum_congr rfl
    intro y _
    dsimp only [μ, physicalLabelLaw]
    rw [Nat.mul_comm y.val]
    dsimp only [F]
    split_ifs <;> simp only [mul_zero, Complex.real_smul]
  have heq : (∑ z : R, (ν z : ℂ) * ∑ y : P i, (μ i y : ℂ) * F (y.val * c z)) =
      ∑ z : R, (ν z : ℂ) * ∑ p ∈ S z,
        (1 / (V i * (p : ℝ))) • χ ((c z * p : ℕ) : ZMod q) := by
    apply Finset.sum_congr rfl
    intro z _
    rw [hrow]
  change ‖∑ z : R, (ν z : ℂ) * ∑ y : P i, (μ i y : ℂ) * F (y.val * c z)‖ ≤ _
  rw [heq]
  refine prime_band_product_mixture_bound χ S c ν ?_ ?_ (hV i) hB ?_
  · intro z
    exact Finset.prod_nonneg (fun j _ =>
      physical_label_law_nonneg V (fun j => (hV j).le) j.val (z j))
  · have hn := finite_product_weight_sum_one (fun (j : {j : I // j ≠ i}) (p : P j.val) => μ j.val p)
      (fun j => physical_label_law_sum V j.val (hV j.val) (hmass j.val))
    exact le_of_eq hn
  · intro z
    apply hinner
    exact Finset.prod_pos (fun j _ => hp j.val (z j).val (z j).property)

theorem prime_tuple_cell_bound_of_zero_free (hZ : PrimitiveZeroFreeHalfPlane) :
    ∃ C : ℝ, 0 < C ∧ ∀ (q : ℕ), 0 < q →
      ∀ χ : DirichletCharacter ℂ q, χ ≠ 1 →
      ∀ {I : Type*} [Fintype I] [DecidableEq I],
      ∀ (P : I → Finset ℕ) (V : I → ℝ) (i : I),
      (∀ j, 0 < V j) → (∀ j p, p ∈ P j → 0 < p) →
      (∀ j, ∑ p ∈ P j, 1 / (p : ℝ) = V j) →
      ∀ a b : ℝ, P i = primeBand a b → 2 ≤ a → 0 ≤ b →
      ∀ U W : ℝ, 0 ≤ U → 0 ≤ W →
        ‖∑ x : (∀ j, P j), (finiteProductWeight (physicalLabelLaw V) x : ℂ) *
          (if U < ((∏ j, (x j).val : ℕ) : ℝ) ∧ ((∏ j, (x j).val : ℕ) : ℝ) ≤ W
          then χ ((∏ j, (x j).val : ℕ) : ZMod q) else 0)‖ ≤
            (C / V i) * a ^ (-(1 : ℝ) / 32) * (1 + Real.log q / Real.log a) := by
  obtain ⟨C, hC, hbound⟩ := reciprocal_prime_band_product_interval_bound hZ
  refine ⟨C, hC, ?_⟩
  intro q hq χ hχ I _ _ P V i hV hp hmass a b hPi ha hb U W hU hW
  have hqR : (1 : ℝ) ≤ q := by exact_mod_cast hq
  have hlq : 0 ≤ Real.log (q : ℝ) := Real.log_nonneg hqR
  have hla : 0 < Real.log a := Real.log_pos (by linarith)
  have hB : 0 ≤ C * a ^ (-(1 : ℝ) / 32) * (1 + Real.log q / Real.log a) := by positivity
  have h := prime_tuple_cell_norm_le P V i hV hp hmass χ U W hB (fun c hc => by
    rw [hPi]
    simpa only [Nat.cast_mul] using
      hbound q hq χ hχ a b (c : ℝ) U W ha hb (by exact_mod_cast hc) hU hW)
  calc
    _ ≤ (C * a ^ (-(1 : ℝ) / 32) * (1 + Real.log q / Real.log a)) / V i := h
    _ = _ := by ring
end

section
open scoped Classical
/- Arbitrary tuple tests may be compressed by their integer products; only
an upper bound for each product atom is needed. -/
theorem weighted_indexed_rational_bilinear_bound
    {X Y I : Type*} [Fintype X] [Fintype Y] [Fintype I]
    (a N : ℕ) (π : X → Fin N) (τ : Y → I) (t : I → ℕ)
    (hinj : Function.Injective t) (A : ℤ) (V : ℕ)
    (ht : ∀ i, A ≤ (t i : ℤ) ∧ (t i : ℤ) ≤ A + (V : ℤ))
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (f : X → ℂ) (g : Y → ℂ)
    {C D P Q : ℝ} (hC : 0 ≤ C) (hD : 0 ≤ D) (hP : 0 < P) (hQ : 0 < Q)
    (hπ : ∀ x, P ≤ (a + (π x).val : ℕ)) (hτ : ∀ y, Q ≤ (t (τ y) : ℝ))
    (hμatom : ∀ m : ℕ,
      (∑ x ∈ Finset.univ.filter (fun x => a + (π x).val = m), μ x) ≤ C / (m : ℝ))
    (hνatom : ∀ m : ℕ,
      (∑ y ∈ Finset.univ.filter (fun y => t (τ y) = m), ν y) ≤ D / (m : ℝ))
    {u : ℤ} {r : ℕ} (hr : 0 < r) (hcop : (r : ℤ).gcd u = 1)
    {β : ℝ} (hβ : |β| ≤ 1 / (r : ℝ) ^ 2) :
    ‖∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) *
      (Complex.exp (Complex.I * (2 * Real.pi *
        (((u : ℝ) / r + β) * t (τ y)) : ℝ))) ^ (a + (π x).val)‖ ^ 2 ≤
      ((1 + 3 * (V : ℝ) / r) *
        (2 * (N : ℝ) + 2 * (r : ℝ) * (1 + Real.log r))) *
          ((C / P) * ∑ x, μ x * ‖f x‖ ^ 2) *
          ((D / Q) * ∑ y, ν y * ‖g y‖ ^ 2) := by
  classical
  let : DecidableEq (Fin N) := Classical.decEq _
  let c : Fin N → ℂ := fun k =>
    ∑ x ∈ Finset.univ.filter (fun x => π x = k), (μ x : ℂ) * f x
  let d : I → ℂ := fun i =>
    ∑ y ∈ Finset.univ.filter (fun y => τ y = i), (ν y : ℂ) * g y
  let K : Fin N → I → ℂ := fun k i =>
    (Complex.exp (Complex.I * (2 * Real.pi * (((u : ℝ) / r + β) * t i) : ℝ))) ^
      (a + k.val)
  let R : ℝ := (1 + 3 * (V : ℝ) / r) *
    (2 * (N : ℝ) + 2 * (r : ℝ) * (1 + Real.log r))
  have hR : 0 ≤ R := by
    have hl : 0 ≤ Real.log (r : ℝ) := Real.log_nonneg (by exact_mod_cast hr)
    dsimp [R]
    positivity
  have hc : (∑ k, ‖c k‖ ^ 2) ≤ (C / P) * ∑ x, μ x * ‖f x‖ ^ 2 := by
    simpa only [c] using
      weighted_fiber_energy_le_of_atom_bound Finset.univ π (fun k => a + k.val)
        μ hμ f hC hP hπ hμatom
  have hd : (∑ i, ‖d i‖ ^ 2) ≤ (D / Q) * ∑ y, ν y * ‖g y‖ ^ 2 :=
    weighted_fiber_energy_le_of_atom_bound Finset.univ τ t ν hν g hD hQ hτ hνatom
  have htinj : Function.Injective (fun i => (t i : ℤ)) := by
    intro i j he
    apply hinj
    change (t i : ℤ) = (t j : ℤ) at he
    exact_mod_cast he
  have hb : ‖∑ k, ∑ i, c k * d i * K k i‖ ^ 2 ≤
      R * (∑ k, ‖c k‖ ^ 2) * ∑ i, ‖d i‖ ^ 2 :=
    rational_phase_integer_interval_bilinear_norm_sq_le (fun i => (t i : ℤ))
      htinj A V ht hr hcop hβ a N c d
  have he : (∑ k, ∑ i, c k * d i * K k i) =
      ∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) * K (π x) (τ y) := by
    simpa only [c, d] using finite_fiber_pushforward_bilinear π τ
      (fun x => (μ x : ℂ) * f x) (fun y => (ν y : ℂ) * g y) K
  change ‖∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) * K (π x) (τ y)‖ ^ 2 ≤ _
  rw [← he]
  apply hb.trans
  exact mul_le_mul (mul_le_mul_of_nonneg_left hc hR) hd
    (Finset.sum_nonneg (fun i _ => sq_nonneg ‖d i‖))
    (mul_nonneg hR (mul_nonneg (div_nonneg hC hP.le)
      (Finset.sum_nonneg (fun x _ => mul_nonneg (hμ x) (sq_nonneg _)))))
end

