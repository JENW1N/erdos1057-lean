section

/- Repeated physical labels agree with the canonical source extraction and
with reassembly from any reduced target. These identities do not require
clean or supported events and therefore include invalid-target fallbacks. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {G : Type} {P : G → Finset ℕ} {J ell B : ℕ}

theorem physical_mixed_repeated_labels_canonical
    (C : G → Finset (Fin J)) (x : CleanFullMemoryState P J ell B) :
    (cleanFullMemoryEquiv P J ell B
      ((fullActivePermutation (cleanPhysicalSlotChange C)).symm x)).2.2.1 =
      physicalMixedRepeatedLabels C x := by
  funext g j
  change (x g).1 ((physicalFullSlotIndex (C g)).symm
    (finSumFinEquiv.symm (finSumFinEquiv j))) = _
  rw [Equiv.symm_apply_apply]
  rfl

theorem physical_mixed_repeated_labels_reassemble
    (C : G → Finset (Fin J)) (x : CleanFullMemoryState P J ell B)
    (y : ProductBoundedOrderedState (fun g => ↥(P g))
      (fun g => UnrestrictedResidueParticle (fun p : P g => p.val))
      (fun g => (physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) B) :
    physicalMixedRepeatedLabels C
      ((productActiveMemorySplit (fun g => physicalFullSharedIndices (ell := ell) (C g)) B).symm
        ((productActiveMemorySplit (fun g => physicalFullSharedIndices (ell := ell) (C g)) B x).1, y)) =
      repeatedBigFill C (physicalMixedRepeatedLabels C x)
        (cleanFullFreshEquiv P C (physicalCleanFreshEquiv (fun g => ↥(P g)) C
          (fun g => (y g).1))) := by
  let z := (fullActivePermutation (cleanPhysicalSlotChange C)).symm x
  let N := fun g => (y g).2.1
  let p := fun g j => ((y g).2.2 j).1
  let r := fun g j => ((y g).2.2 j).2
  let source := (cleanFullMemoryEquiv P J ell B z).2.2.1
  let fresh := physicalCleanFreshEquiv (fun g => ↥(P g)) C (fun g => (y g).1)
  have hs : (productActiveMemorySplit (cleanFullSharedSlots C) B
      (cleanFullMemoryState N p source r)).1 =
      (productActiveMemorySplit (cleanFullSharedSlots C) B z).1 := by
    funext g i
    change (z g).1 (finSumFinEquiv (finSumFinEquiv.symm _)) = _
    rw [Equiv.apply_symm_apply]
    rfl
  have hc := cleanFullMemoryState_reassemble_fill C N p source r fresh
  rw [hs] at hc
