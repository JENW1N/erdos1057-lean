/- Joint continuity of finite-depth and stable Buchstab densities. -/

open Filter
open scoped Topology

namespace Bounty

theorem buchstab_depth_density_continuous (n : ℕ) :
    ContinuousOn (fun p : ℝ × ℝ => buchstabDepthDensity n p.1 p.2)
      {p | 0 < p.1 ∧ 0 < p.2} := by
  let P := {p : ℝ × ℝ // 0 < p.1 ∧ 0 < p.2}
  suffices h : Continuous (fun p : P => buchstabDepthDensity n p.val.1 p.val.2) from
    continuousOn_iff_continuous_domRestrict.mpr h
  induction n with
  | zero =>
    exact continuous_const.div (continuous_subtype_val.snd) (fun p => p.property.2.ne')
  | succ n ih =>
    let f : P → ℝ → ℝ := fun p t =>
      buchstabDepthDensity n (max p.val.1 t) (max (p.val.2/2) (p.val.2-t)) / max p.val.1 t
    let g : P × ℝ → P := fun q => ⟨(max q.1.val.1 q.2, max (q.1.val.2/2) (q.1.val.2-q.2)),
      lt_of_lt_of_le q.1.property.1 (le_max_left _ _),
      lt_of_lt_of_le (half_pos q.1.property.2) (le_max_left _ _)⟩
    have hg : Continuous g := by dsimp only [g, P]; fun_prop
    have hnum := ih.comp hg
    have hf : Continuous f.uncurry := by
      exact hnum.div (by dsimp only [P]; fun_prop) (fun q =>
        (lt_of_lt_of_le q.1.property.1 (le_max_left _ _)).ne')
    have hhi : Continuous (fun p : P => ∫ t in (0 : ℝ)..max p.val.1 (p.val.2/2), f p t) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous hf (by fun_prop)
    have hlo : Continuous (fun p : P => ∫ t in (0 : ℝ)..p.val.1, f p t) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous hf (by fun_prop)
    have hrecip : Continuous (fun p : P => 1/p.val.2) :=
      continuous_const.div (continuous_subtype_val.snd) (fun p : P => p.property.2.ne')
    have hall := hrecip.add (hhi.sub hlo)
    apply hall.congr
    intro p
    dsimp only [Pi.add_apply, Pi.sub_apply]
    rw [intervalIntegral.integral_interval_sub_left
      ((hf.uncurry_left p).intervalIntegrable _ _)
      ((hf.uncurry_left p).intervalIntegrable _ _)]
    change 1/p.val.2 + (∫ t in p.val.1..max p.val.1 (p.val.2/2), f p t) =
      1/p.val.2 + (∫ t in p.val.1..max p.val.1 (p.val.2/2),
        buchstabDepthDensity n t (p.val.2-t)/t)
    congr 1
    by_cases hhalf : p.val.2/2 ≤ p.val.1
    · simp only [max_eq_left hhalf, intervalIntegral.integral_same]
    · have hhalf' : p.val.1 ≤ p.val.2/2 := (lt_of_not_ge hhalf).le
      rw [max_eq_right hhalf']
      apply intervalIntegral.integral_congr
      intro t ht
      have htb := Set.mem_Icc.mp (by simpa only [Set.uIcc_of_le hhalf'] using ht)
      have htlast : p.val.2/2 ≤ p.val.2-t := by linarith [htb.2]
      simp only [f, max_eq_right htb.1, max_eq_right htlast]

theorem buchstab_density_continuous :
    ContinuousOn (fun p : ℝ × ℝ => buchstabDensity p.1 p.2)
      {p | 0 < p.1 ∧ 0 < p.2} := by
  have hU : IsOpen {p : ℝ × ℝ | 0 < p.1 ∧ 0 < p.2} :=
    (isOpen_lt continuous_const continuous_fst).inter (isOpen_lt continuous_const continuous_snd)
  apply hU.continuousOn_iff.mpr
  intro p hp
  let n := ⌊p.2/p.1⌋₊+1
  have hn : p.2 < ((n : ℝ)+2)*p.1 := by
    have hb := buchstab_density_depth_bound (w := p.2) hp.1
    dsimp [n]
    push_cast
    nlinarith [hp.1]
  have hV : IsOpen {q : ℝ × ℝ | 0 < q.1 ∧ q.2 < ((n : ℝ)+2)*q.1} :=
    (isOpen_lt continuous_const continuous_fst).inter
      (isOpen_lt continuous_snd (continuous_const.mul continuous_fst))
  have hloc : ∀ᶠ q : ℝ × ℝ in 𝓝 p, 0 < q.1 ∧ q.2 < ((n : ℝ)+2)*q.1 :=
    hV.mem_nhds ⟨hp.1, hn⟩
  have hc := (buchstab_depth_density_continuous n).continuousAt (hU.mem_nhds hp)
  apply hc.congr
  filter_upwards [hloc] with q hq
  exact buchstab_depth_density_eq_density hq.1 n hq.2.le

end Bounty
end

section

/- Pointwise domination keeps an arbitrary event mask while removing a
bounded complex coefficient. Nonnegative event weights are retained. -/

open Finset
open scoped Classical

namespace Bounty

theorem finite_masked_event_norm_le_positive_re {E : Type*} [Fintype E]
    (w : E → ℝ) (hw : ∀ e, 0 ≤ w e) (mask : E → Prop)
    (phase f : E → ℂ) (hphase : ∀ e, ‖phase e‖ ≤ 1) :
    ‖∑ e, (w e : ℂ) * (if mask e then phase e else 0) * f e‖ ≤
      (∑ e, (w e : ℂ) * (if mask e then 1 else 0) * (‖f e‖ : ℂ)).re := by
  have he : (∑ e, (w e : ℂ) * (if mask e then 1 else 0) * (‖f e‖ : ℂ)).re =
      ∑ e, if mask e then w e * ‖f e‖ else 0 := by
    rw [Complex.re_sum]
    apply sum_congr rfl
    intro e _
    split_ifs <;> simp
  rw [he]
  apply (norm_sum_le _ _).trans
  apply sum_le_sum
  intro e _
  by_cases hm : mask e
  · simp only [if_pos hm, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hw e)]
    exact (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (hphase e) (hw e))
      (norm_nonneg (f e))).trans_eq (by rw [mul_one])
  · simp only [if_neg hm, mul_zero, zero_mul, norm_zero, le_refl]

theorem finite_weighted_energy_add_le_two {X : Type*} [Fintype X]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (f g : X → ℂ) :
    finiteWeightedEnergy w (fun x => f x + g x) ≤
      2 * (finiteWeightedEnergy w f + finiteWeightedEnergy w g) := by
  calc
    _ ≤ ∑ x, w x * (2 * (‖f x‖ ^ 2 + ‖g x‖ ^ 2)) := by
      apply sum_le_sum
      intro x _
      apply mul_le_mul_of_nonneg_left _ (hw x)
      have hnorm := (sq_le_sq₀ (norm_nonneg (f x + g x))
        (add_nonneg (norm_nonneg (f x)) (norm_nonneg (g x)))).mpr (norm_add_le (f x) (g x))
      nlinarith [sq_nonneg (‖f x‖ - ‖g x‖)]
    _ = _ := by
      simp only [finiteWeightedEnergy, mul_add, mul_sum]
      rw [← sum_add_distrib]
      apply sum_congr rfl
      intro x _
      ring




end Bounty
end

section

/- Read-only history observables on the existing dependent paths, without enlarging their state space. -/

namespace Bounty

universe u v w z

section History
variable {K : Type u} {X : Type v} {H : Type z} (E : K → X → Type w)
    (target : ∀ k x, E k x → X)
    (update : ∀ (_t : ℕ) k x, E k x → H → H)

def finiteEventPathHistoryAt : ∀ (_t : ℕ) (steps : List K) (x : X),
    FiniteEventPath E target steps x → H → ℕ → H
  | _, _, _, _, h, 0 => h
  | _, [], _, _, h, _ + 1 => h
  | t, k :: ks, x, ⟨e, p⟩, h, i + 1 =>
      finiteEventPathHistoryAt (t + 1) ks (target k x e) p (update t k x e h) i

theorem finite_event_path_history_at_zero (t : ℕ) (steps : List K) (x : X)
    (p : FiniteEventPath E target steps x) (h : H) :
    finiteEventPathHistoryAt E target update t steps x p h 0 = h := rfl

theorem finite_event_path_history_at_succ (t : ℕ) (steps : List K) (x : X)
    (p : FiniteEventPath E target steps x) (h : H) (i : Fin steps.length) :
    finiteEventPathHistoryAt E target update t steps x p h (i.val + 1) =
      let e := finiteEventPathOccurrence E target steps x p i
      update (t + i.val) (steps.get i) e.1 e.2
        (finiteEventPathHistoryAt E target update t steps x p h i.val) := by
  induction steps generalizing t x h with
  | nil => exact Fin.elim0 i
  | cons k ks ih =>
    rcases p with ⟨e, p⟩
    refine Fin.cases ?_ (fun j => ?_) i
    · rfl
    · change finiteEventPathHistoryAt E target update (t + 1) ks (target k x e) p
        (update t k x e h) (j.val + 1) =
        update (t + (j.val + 1)) (ks.get j)
          (finiteEventPathOccurrence E target ks (target k x e) p j).1
          (finiteEventPathOccurrence E target ks (target k x e) p j).2
          (finiteEventPathHistoryAt E target update (t + 1) ks (target k x e) p
            (update t k x e h) j.val)
      simpa only [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]
        using ih (t + 1) (target k x e) p (update t k x e h) j

end History
end Bounty
end

section

/- Cartesian selected data split by physical groups; the cut sequence stays fixed. -/

open scoped Classical
namespace Bounty

abbrev PhysicalGroupSelectedData {G : Type*} {J n : ℕ} (P : G → Finset ℕ) (ell : ℕ)
    (C : Fin n → G → Finset (Fin J)) :=
  (∀ j, PhysicalAuxLabels P (C j)) × (Fin (n + 1) → PhysicalMarkLists P J ell) ×
    (Fin n → PhysicalPermutations G J ell) × (Fin n → PhysicalPermutations G J ell)

def pairedSequenceEquiv {A : Type*} {B C : A → Type*} :
    (∀ a, B a × C a) ≃ (∀ a, B a) × (∀ a, C a) where
  toFun f := (fun a => (f a).1, fun a => (f a).2)
  invFun f a := (f.1 a, f.2 a)
  left_inv f := by funext a; exact Prod.eta (f a)
  right_inv f := rfl

noncomputable def physicalGroupSelectedSplit
    {G : Type*} {P : G → Finset ℕ} {J ell n : ℕ}
    (small : G → Prop) (C : Fin n → G → Finset (Fin J)) :
    PhysicalGroupSelectedData P ell C ≃
      PhysicalGroupSelectedData (fun g : {g // small g} => P g.val) ell
        (fun j g => C j g.val) ×
      PhysicalGroupSelectedData (fun g : {g // ¬small g} => P g.val) ell
        (fun j g => C j g.val) :=
  (Equiv.prodCongr
    ((Equiv.piCongrRight fun j => physicalAuxGroupSplit small P J (C j)).trans pairedSequenceEquiv)
    (Equiv.prodCongr
      ((Equiv.piCongrRight fun _ : Fin (n + 1) => physicalMarkGroupSplit small P J ell).trans pairedSequenceEquiv)
      (Equiv.prodCongr
        ((Equiv.piCongrRight fun _ : Fin n => physicalPermutationGroupSplit small J ell).trans pairedSequenceEquiv)
        ((Equiv.piCongrRight fun _ : Fin n => physicalPermutationGroupSplit small J ell).trans pairedSequenceEquiv)))).trans
  { toFun := fun x =>
      ((x.1.1, x.2.1.1, x.2.2.1.1, x.2.2.2.1),
        (x.1.2, x.2.1.2, x.2.2.1.2, x.2.2.2.2))
    invFun := fun x =>
      ((x.1.1, x.2.1), (x.1.2.1, x.2.2.1),
        (x.1.2.2.1, x.2.2.2.1), (x.1.2.2.2, x.2.2.2.2))
    left_inv := by rintro ⟨⟨_, _⟩, ⟨_, _⟩, ⟨_, _⟩, ⟨_, _⟩⟩; rfl
    right_inv := by rintro ⟨⟨_, _, _, _⟩, ⟨_, _, _, _⟩⟩; rfl }

section

variable
  {G : Type*}
  {P : G → Finset ℕ}
  {J ell n : ℕ}
  (small : G → Prop)
  (C : Fin n → G → Finset (Fin J))
  (d : PhysicalGroupSelectedData P ell C)

include G P J ell n small C d

theorem physical_group_selected_split_small
     :
    (physicalGroupSelectedSplit small C d).1 =
      ((fun j (g : {g : G // small g}) => d.1 j g.val), (fun j (g : {g : G // small g}) => d.2.1 j g.val),
        (fun j (g : {g : G // small g}) => d.2.2.1 j g.val), (fun j (g : {g : G // small g}) => d.2.2.2 j g.val)) := rfl

theorem physical_group_selected_split_big
     :
    (physicalGroupSelectedSplit small C d).2 =
      ((fun j (g : {g : G // ¬small g}) => d.1 j g.val), (fun j (g : {g : G // ¬small g}) => d.2.1 j g.val),
        (fun j (g : {g : G // ¬small g}) => d.2.2.1 j g.val), (fun j (g : {g : G // ¬small g}) => d.2.2.2 j g.val)) := rfl

end


end Bounty
end

section

/- Exact endpoint energy in the original physical counting measure. -/

open scoped BigOperators InnerProductSpace

namespace Bounty

theorem physical_damping_square {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (J ell : ℕ) {q : ℝ} (hq : 0 ≤ q) (n : ℤ) :
    physicalDamping P J ell q n ^ 2 =
      ∏ g, q ^ (physicalOmega P g n - (J + ell)) := by
  unfold physicalDamping
  rw [← Finset.prod_pow]
  apply Finset.prod_congr rfl
  intro g _
  rw [← Real.rpow_natCast q (physicalOmega P g n - (J + ell)),
    ← Real.rpow_natCast _ 2, ← Real.rpow_mul hq]
  congr 1
  norm_num




noncomputable def physicalEndpointVector {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (V : G → ℝ) (J ell : ℕ) (q : ℝ)
    (positions : Finset ℤ) (f : ℤ → ℂ) :
    EuclideanSpace ℂ (physicalCutoff P J ell positions) :=
  finitePositionVector (fun x : physicalCutoff P J ell positions => x.val.1)
    (physicalStateMass V J ell) (fun n => f n * (physicalDamping P J ell q n : ℂ))







end Bounty
end

section

/- Mark-independent endpoint tests remove the two slot averages exactly. -/

open scoped BigOperators InnerProductSpace

namespace Bounty

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  (P : G → Finset ℕ)

include G sharedInstance1 sharedInstance2 P

theorem physical_symmetrize_position_sum  (J ell : ℕ) (positions : Finset ℤ)
    (f : ℤ → ℂ) (h : PhysicalState P J ell → ℂ) :
    (∑ x ∈ physicalCutoff P J ell positions, f x.1 * physicalSymmetrize h x) =
      ∑ x ∈ physicalCutoff P J ell positions, f x.1 * h x := by
  classical
  let N : ℂ := Fintype.card (PhysicalPermutations G J ell)
  have hN : N ≠ 0 := by dsimp [N]; exact_mod_cast Fintype.card_ne_zero
  calc
    _ = N⁻¹ * ∑ σ : PhysicalPermutations G J ell,
        ∑ x ∈ physicalCutoff P J ell positions, f x.1 * h (physicalPermutationEquiv σ x) := by
      unfold physicalSymmetrize
      change (∑ x ∈ physicalCutoff P J ell positions, f x.1 *
        (N⁻¹ * ∑ σ : PhysicalPermutations G J ell, h (physicalPermutationEquiv σ x))) = _
      simp only [Finset.mul_sum]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro σ _
      apply Finset.sum_congr rfl
      intro x _
      ring
    _ = N⁻¹ * ∑ _σ : PhysicalPermutations G J ell,
        ∑ x ∈ physicalCutoff P J ell positions, f x.1 * h x := by
      congr 1
      apply Finset.sum_congr rfl
      intro σ _
      exact physical_permutation_sum P J ell positions σ (fun x => f x.1 * h x)
    _ = _ := by
      simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      change N⁻¹ * (N * _) = _
      rw [← mul_assoc, inv_mul_cancel₀ hN, one_mul]

theorem physical_position_symmetric_pairing  (J ell : ℕ) (positions : Finset ℤ)
    (K : PhysicalState P J ell → PhysicalState P J ell → ℂ) (f g : ℤ → ℂ) :
    (∑ x ∈ physicalCutoff P J ell positions, ∑ y ∈ physicalCutoff P J ell positions,
      f x.1 * physicalSymmetricKernel K x y * g y.1) =
      ∑ x ∈ physicalCutoff P J ell positions, ∑ y ∈ physicalCutoff P J ell positions,
        f x.1 * K x y * g y.1 := by
  classical
  rw [Finset.sum_comm]
  calc
    _ = ∑ y ∈ physicalCutoff P J ell positions,
        (∑ x ∈ physicalCutoff P J ell positions, f x.1 * physicalSymmetrize (K x) y) * g y.1 := by
      apply Finset.sum_congr rfl
      intro y _
      rw [← Finset.sum_mul]
      congr 1
      exact physical_symmetrize_position_sum P J ell positions f
        (fun x => physicalSymmetrize (K x) y)
    _ = ∑ x ∈ physicalCutoff P J ell positions,
        f x.1 * ∑ y ∈ physicalCutoff P J ell positions, g y.1 * physicalSymmetrize (K x) y := by
      simp only [Finset.sum_mul, Finset.mul_sum]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro x _
      apply Finset.sum_congr rfl
      intro y _
      ring
    _ = ∑ x ∈ physicalCutoff P J ell positions,
        f x.1 * ∑ y ∈ physicalCutoff P J ell positions, g y.1 * K x y := by
      simp only [physical_symmetrize_position_sum]
    _ = _ := by
      simp only [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro x _
      apply Finset.sum_congr rfl
      intro y _
      ring

theorem physical_position_kernel_pairing  (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (J ell : ℕ) (positions : Finset ℤ)
    (K : PhysicalState P J ell → PhysicalState P J ell → ℂ) (f g : ℤ → ℂ) :
    inner ℂ
      (finitePositionVector (fun x : physicalCutoff P J ell positions => x.val.1)
        (physicalStateMass V J ell) f)
      (finiteKernelOperator (fun x y : physicalCutoff P J ell positions =>
        physicalSymmetricKernel K x.val y.val)
        (finitePositionVector (fun x : physicalCutoff P J ell positions => x.val.1)
          (physicalStateMass V J ell) g)) =
      (physicalStateMass V J ell : ℂ) *
        ∑ x ∈ physicalCutoff P J ell positions, ∑ y ∈ physicalCutoff P J ell positions,
          (starRingEnd ℂ) (f x.1) * K x y * g y.1 := by
  rw [finite_position_vector_kernel_pairing _ (physical_state_mass_pos V hV J ell).le]
  congr 1
  calc
    _ = ∑ x : physicalCutoff P J ell positions,
        ∑ y ∈ physicalCutoff P J ell positions,
          (starRingEnd ℂ) (f x.val.1) * physicalSymmetricKernel K x.val y * g y.1 := by
      apply Finset.sum_congr rfl
      intro x _
      exact Finset.sum_coe_sort (physicalCutoff P J ell positions)
        (fun y : PhysicalState P J ell =>
          (starRingEnd ℂ) (f x.val.1) * physicalSymmetricKernel K x.val y * g y.1)
    _ = ∑ x ∈ physicalCutoff P J ell positions,
        ∑ y ∈ physicalCutoff P J ell positions,
          (starRingEnd ℂ) (f x.1) * physicalSymmetricKernel K x y * g y.1 :=
      Finset.sum_coe_sort (physicalCutoff P J ell positions)
        (fun x : PhysicalState P J ell => ∑ y ∈ physicalCutoff P J ell positions,
          (starRingEnd ℂ) (f x.1) * physicalSymmetricKernel K x y * g y.1)
    _ = _ := physical_position_symmetric_pairing P J ell positions K
      (fun n => (starRingEnd ℂ) (f n)) g

end


end Bounty
end

section

/- Congruence, signed quotient reconstruction, and uniqueness of both variables. -/

namespace Bounty

theorem typeII_signed_modulus_dvd (k a : ℤ) : 2 * |k| ∣ a ↔ 2 * k ∣ a := by
  have habs : |2 * k| = 2 * |k| := by rw [abs_mul]; norm_num
  rw [← habs, abs_dvd]

theorem typeII_determinant_congruence {m m' e k : ℤ}
    (he : m' - m = 2 * e * k) :
    Int.ModEq (2 * |k|) m m' := by
  apply Int.modEq_iff_dvd.mpr
  apply (typeII_signed_modulus_dvd k _).mpr
  exact ⟨e, by linear_combination he⟩

theorem typeII_determinant_e_quotient {m m' e k : ℤ} (hk : k ≠ 0)
    (he : m' - m = 2 * e * k) : (m' - m) / (2 * k) = e := by
  rw [he, show 2 * e * k = e * (2 * k) by ring]
  exact Int.mul_ediv_cancel e (mul_ne_zero (by norm_num) hk)

theorem typeII_determinant_n_quotient {m e h n : ℤ} (hm : m ≠ 0)
    (hn : m * n = 2 * e * h + 1) : (2 * e * h + 1) / m = n := by
  rw [← hn]
  exact Int.mul_ediv_cancel_left n hm

theorem typeII_determinant_from_congruence {m m' h h' k : ℤ}
    (hm : 0 < m) (hh : 0 ≤ h) (hk : k ≠ 0) (hc : IsCoprime m k)
    (hd : m * h' - m' * h = k) (hmod : Int.ModEq (2 * |k|) m m')
    (hpos : 0 < (m' - m) / (2 * k)) :
    ∃! en : ℤ × ℤ, 0 < en.1 ∧ 0 < en.2 ∧
      m * en.2 = 2 * en.1 * h + 1 ∧ m' * en.2 = 2 * en.1 * h' + 1 ∧
      m' - m = 2 * en.1 * k ∧ h' - h = k * en.2 := by
  let e := (m' - m) / (2 * k)
  have hdiv : 2 * k ∣ m' - m :=
    (typeII_signed_modulus_dvd k _).mp (Int.modEq_iff_dvd.mp hmod)
  have he : m' - m = 2 * e * k := by
    have heq := Int.ediv_mul_cancel hdiv
    dsimp only [e]
    linear_combination -heq
  obtain ⟨n, hn, huniq⟩ :=
    typeII_determinant_reconstruct_positive hm hpos hh hc hd he
  refine ⟨(e, n), ⟨hpos, hn.1, hn.2.1, hn.2.2.1, he, hn.2.2.2⟩, ?_⟩
  rintro ⟨e', n'⟩ hp
  have he' : e' = e := (typeII_determinant_e_quotient hk hp.2.2.2.2.1).symm
  have hn' : n' = n := by
    apply huniq
    simpa only [he'] using
      And.intro hp.2.1 (And.intro hp.2.2.1 (And.intro hp.2.2.2.1 hp.2.2.2.2.2))
  exact Prod.ext he' hn'




end Bounty
end

section

/- Multiplying by group-prime factors preserves the literal invariant endpoint. -/

namespace Bounty

theorem prime_pool_free_part_mul_supported {P : Finset ℕ} {a : ℕ}
    (ha : a ∈ Nat.factoredNumbers P) (n : ℕ) :
    primePoolFreePart P (a * n) = primePoolFreePart P n := by
  by_cases hn : n = 0
  · subst n
    simp only [mul_zero]
  · have he : a * n = (a * primePoolPart P n) * primePoolFreePart P n := by
      rw [mul_assoc, primePoolPart_mul_primePoolFreePart]
    rw [he, primePoolFreePart_mul_of_free
      (Nat.mul_mem_factoredNumbers ha (primePoolPart_mem_factoredNumbers P n))
      (primePoolFreePart_ne_zero P hn) (primePoolFreePart_primeFactors_disjoint P n)]

theorem invariant_triple_endpoint_mul_supported {P : Finset ℕ} {a : ℕ}
    (ha : a ∈ Nat.factoredNumbers P) (α β γ : ℕ → ℂ) (n : ℕ) :
    invariantTripleEndpoint P α β γ (a * n) = invariantTripleEndpoint P α β γ n := by
  unfold invariantTripleEndpoint
  rw [prime_pool_free_part_mul_supported ha]

end Bounty
end

section

/- Rough support gives a subexponential pointwise bound even for an unrestricted residual factor. -/

open Finset

namespace Bounty

theorem endpoint_triple_convolution_rough_sum (W : ℝ) (α β γ : ℕ → ℂ)
    (hα : ∀ m, ¬ (∀ p : ℕ, p ∈ m.primeFactors → W ≤ (p : ℝ)) → α m = 0)
    (hβ : ∀ m, ¬ (∀ p : ℕ, p ∈ m.primeFactors → W ≤ (p : ℝ)) → β m = 0)
    (n : ℕ) :
    endpointTripleConvolution α β γ n =
      ∑ m ∈ roughDivisors W n, ∑ p ∈ roughDivisors W (n / m),
        α m * β p * γ (n / m / p) := by
  classical
  unfold endpointTripleConvolution roughDivisors
  rw [sum_filter]
  apply sum_congr rfl
  intro m _
  by_cases hm : ∀ p : ℕ, p ∈ m.primeFactors → W ≤ (p : ℝ)
  · rw [if_pos hm, sum_filter]
    apply sum_congr rfl
    intro p _
    by_cases hp : ∀ r : ℕ, r ∈ p.primeFactors → W ≤ (r : ℝ)
    · rw [if_pos hp]
    · rw [if_neg hp, hβ p hp, mul_zero, zero_mul]
  · rw [if_neg hm, hα m hm]
    simp only [zero_mul, sum_const_zero]

theorem endpoint_triple_convolution_rough_norm (W : ℝ) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (hαrough : ∀ m, ¬ (∀ p : ℕ, p ∈ m.primeFactors → W ≤ (p : ℝ)) → α m = 0)
    (hβrough : ∀ m, ¬ (∀ p : ℕ, p ∈ m.primeFactors → W ≤ (p : ℝ)) → β m = 0)
    (n : ℕ) :
    ‖endpointTripleConvolution α β γ n‖ ≤ A * B * C * ((roughDivisors W n).card : ℝ) ^ 2 := by
  classical
  rw [endpoint_triple_convolution_rough_sum W α β γ hαrough hβrough]
  have hABC : 0 ≤ A * B * C := mul_nonneg (mul_nonneg hA hB) hC
  calc
    _ ≤ ∑ m ∈ roughDivisors W n, ∑ p ∈ roughDivisors W (n / m),
        ‖α m * β p * γ (n / m / p)‖ :=
      (norm_sum_le _ _).trans (sum_le_sum (fun m _ => norm_sum_le _ _))
    _ ≤ ∑ m ∈ roughDivisors W n, ∑ _p ∈ roughDivisors W (n / m), A * B * C := by
      apply sum_le_sum
      intro m _
      apply sum_le_sum
      intro p _
      rw [norm_mul, norm_mul]
      exact mul_le_mul (mul_le_mul (hα m) (hβ p) (norm_nonneg _) hA)
        (hγ _) (norm_nonneg _) (mul_nonneg hA hB)
    _ ≤ ∑ _m ∈ roughDivisors W n, ((roughDivisors W n).card : ℝ) * (A * B * C) := by
      apply sum_le_sum
      intro m hm
      simp only [sum_const, nsmul_eq_mul]
      apply mul_le_mul_of_nonneg_right _ hABC
      have hm' := (mem_filter.mp hm).1
      have hsub : roughDivisors W (n / m) ⊆ roughDivisors W n := by
        intro p hp
        exact mem_filter.mpr ⟨Nat.divisors_subset_of_dvd (Nat.ne_zero_of_mem_divisors hm')
          (Nat.div_dvd_of_dvd (Nat.dvd_of_mem_divisors hm')) (mem_filter.mp hp).1,
          (mem_filter.mp hp).2⟩
      exact_mod_cast card_le_card hsub
    _ = _ := by simp only [sum_const, nsmul_eq_mul]; ring

theorem endpoint_triple_convolution_rough_exp {W : ℝ} (hW : 1 < W)
    (α β γ : ℕ → ℂ) {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (hαrough : ∀ m, ¬ (∀ p : ℕ, p ∈ m.primeFactors → W ≤ (p : ℝ)) → α m = 0)
    (hβrough : ∀ m, ¬ (∀ p : ℕ, p ∈ m.primeFactors → W ≤ (p : ℝ)) → β m = 0)
    {n : ℕ} (hn : n ≠ 0) :
    ‖endpointTripleConvolution α β γ n‖ ≤
      A * B * C * Real.exp (2 * (Real.log 2 * Real.log n / Real.log W)) := by
  have hb := endpoint_triple_convolution_rough_norm W α β γ hA hB hC hα hβ hγ hαrough hβrough n
  have hc := roughDivisors_card_le_exp_log hW hn
  calc
    _ ≤ A * B * C * ((roughDivisors W n).card : ℝ) ^ 2 := hb
    _ ≤ A * B * C * (Real.exp (Real.log 2 * Real.log n / Real.log W)) ^ 2 := by gcongr
    _ = _ := by rw [← Real.exp_nat_mul]; norm_num

end Bounty
end

section

/- Elementary harmonic bounds for fixed Dirichlet powers of the zeta sequence. -/

open Finset ArithmeticFunction

namespace Bounty

noncomputable def divisorHarmonic (N : ℕ) : ℝ := ∑ n ∈ Ioc 0 N, (n : ℝ)⁻¹

theorem divisor_harmonic_nonneg (N : ℕ) : 0 ≤ divisorHarmonic N := by
  unfold divisorHarmonic
  positivity

theorem divisor_harmonic_mono {M N : ℕ} (hMN : M ≤ N) :
    divisorHarmonic M ≤ divisorHarmonic N := by
  unfold divisorHarmonic
  apply sum_le_sum_of_subset_of_nonneg
  · exact Ioc_subset_Ioc le_rfl hMN
  · intro n _ _
    positivity

theorem divisor_harmonic_log_bound (N : ℕ) : divisorHarmonic N ≤ 1 + Real.log N := by
  have hs : Ioc 0 N = Icc 1 N := by ext n; simp only [mem_Ioc, mem_Icc]; omega
  have heq : divisorHarmonic N = (harmonic N : ℝ) := by
    simp only [divisorHarmonic, harmonic_eq_sum_Icc, Rat.cast_sum, Rat.cast_inv,
      Rat.cast_natCast, hs]
  rw [heq]
  exact harmonic_le_one_add_log N

theorem divisor_zeta_sum_step (r N : ℕ) :
    (∑ n ∈ Ioc 0 N, ((ArithmeticFunction.zeta ^ (r + 2)) n : ℝ)) =
      ∑ d ∈ Ioc 0 N, ∑ n ∈ Ioc 0 (N / d),
        ((ArithmeticFunction.zeta ^ (r + 1)) n : ℝ) := by
  have heq := ArithmeticFunction.sum_Ioc_mul_eq_sum_sum
    ArithmeticFunction.zeta (ArithmeticFunction.zeta ^ (r + 1)) N
  rw [← pow_succ'] at heq
  have heq' := congrArg (fun n : ℕ => (n : ℝ)) heq
  simp only [Nat.cast_sum, Nat.cast_mul] at heq'
  rw [heq']
  apply sum_congr rfl
  intro d hd
  rw [ArithmeticFunction.zeta_apply_ne (Nat.ne_of_gt (mem_Ioc.mp hd).1), Nat.cast_one,
    one_mul]

theorem divisor_zeta_summatory_bound (r N : ℕ) :
    (∑ n ∈ Ioc 0 N, ((ArithmeticFunction.zeta ^ (r + 1)) n : ℝ)) ≤
      (N : ℝ) * divisorHarmonic N ^ r := by
  induction r generalizing N with
  | zero =>
    simp only [zero_add, pow_one, pow_zero, mul_one, ← Nat.cast_sum,
      ArithmeticFunction.sum_Ioc_zeta, le_refl]
  | succ r ih =>
    rw [show r + 1 + 1 = r + 2 by omega, divisor_zeta_sum_step]
    calc
      _ ≤ ∑ d ∈ Ioc 0 N, (N / d : ℕ) * divisorHarmonic (N / d) ^ r :=
        sum_le_sum (fun d _ => ih (N / d))
      _ ≤ ∑ d ∈ Ioc 0 N, ((N : ℝ) / d) * divisorHarmonic N ^ r := by
        apply sum_le_sum
        intro d hd
        apply mul_le_mul
        · exact Nat.cast_div_le
        · exact pow_le_pow_left₀ (divisor_harmonic_nonneg _) (divisor_harmonic_mono (Nat.div_le_self _ _)) _
        · exact pow_nonneg (divisor_harmonic_nonneg _) _
        · positivity
      _ = (N : ℝ) * divisorHarmonic N ^ (r + 1) := by
        simp only [div_eq_mul_inv, ← sum_mul, ← mul_sum, divisorHarmonic, pow_succ]
        ring

end Bounty
end

section

/- Actual candidate Q-slot allocation in increasing band order, preserving its factorial normalization. -/

open Finset Real

namespace Bounty

noncomputable def candidateAllocationOrder (c L : ℝ) (r : ℕ) :
    Fin ((candidateQIndices c L).card*r) ≃ (candidateQIndices c L) × Fin r :=
  finProdFinEquiv.symm.trans (Equiv.prodCongr
    ((candidateQIndices c L).orderIsoOfFin rfl).toEquiv (Equiv.refl _))

noncomputable def candidateAllocationValue (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
    (i : Fin ((candidateQIndices c L).card*r)) : ℕ :=
  (x (candidateAllocationOrder c L r i)).val

noncomputable def candidateAllocationActive (c L : ℝ) (r jStar : ℕ)
    (i : Fin ((candidateQIndices c L).card*r)) : Bool :=
  decide (¬((candidateAllocationOrder c L r i).1.val=jStar ∧
    (candidateAllocationOrder c L r i).2.val=0))

noncomputable def candidateAllocationWeight (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (R : ℝ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) : ℝ :=
  smoothAllocationWeight _ (fun i => log (candidateAllocationValue c L r jStar x i))
    (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
    (candidateAllocationActive c L r jStar) R take

noncomputable def candidateAllocatedFactor (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) : ℕ :=
  ∏ i, if take i then candidateAllocationValue c L r jStar x i else 1

noncomputable def candidateRetainedFactor (c L : ℝ) (r jStar P : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) : ℕ :=
  P * ∏ i, if take i then 1 else candidateAllocationValue c L r jStar x i

section

variable
  (c L : ℝ)
  (r jStar : ℕ)
  (x : ∀ slot, candidateQSlotChoices c L r jStar slot)

include c L r jStar x

theorem candidate_allocation_total_mass  (R : ℝ) :
    (∑ take, candidateAllocationWeight c L r jStar x R take) = 1 :=
  smooth_allocation_total_mass _ _ _ _ _

theorem candidate_allocation_weight_nonneg  (R : ℝ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) :
    0 ≤ candidateAllocationWeight c L r jStar x R take :=
  smooth_allocation_weight_nonneg _ _ _ _ _ _

theorem candidate_allocation_value_pos 
    (i : Fin ((candidateQIndices c L).card*r)) : 0 < candidateAllocationValue c L r jStar x i :=
  Nat.pos_of_ne_zero (candidate_Q_slot_nonzero c L r jStar _ (x _).property)

theorem candidate_allocation_product  :
    (∏ i, candidateAllocationValue c L r jStar x i) =
      orderedSlotProduct (candidateQSlotChoices c L r jStar) x := by
  exact Fintype.prod_equiv (candidateAllocationOrder c L r) _ _ (fun _ => rfl)

end


theorem candidate_allocation_factorization (c L : ℝ) (r jStar P : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) :
    candidateAllocatedFactor c L r jStar x take*candidateRetainedFactor c L r jStar P x take =
      P*orderedSlotProduct (candidateQSlotChoices c L r jStar) x := by
  unfold candidateAllocatedFactor candidateRetainedFactor
  rw [mul_left_comm, ← prod_mul_distrib]
  congr 1
  rw [← candidate_allocation_product c L r jStar x]
  apply prod_congr rfl
  intro i hi
  cases take i <;> simp










end Bounty
end

section

/- Deterministic residual bounds on positive smooth allocation branches. -/

open Finset Real

namespace Bounty

noncomputable def smoothAllocationInventory (n : ℕ) (v : Fin n → ℝ) (active : Fin n → Bool) : ℝ :=
  ∑ i, if active i then v i else 0

noncomputable def smoothAllocationResidual (n : ℕ) (v : Fin n → ℝ)
    (R : ℝ) (take : Fin n → Bool) : ℝ := R-∑ i, if take i then v i else 0

def SmoothAllocationRoom : (n : ℕ) → (Fin n → ℝ) → (Fin n → ℝ) → (Fin n → Bool) → ℝ → Prop
  | 0, _, _, _, _ => True
  | n+1, v, s, active, A =>
    (active 0 = true → v 0+s 0 ≤ smoothAllocationInventory n (Fin.tail v) (Fin.tail active)+A) ∧
    SmoothAllocationRoom n (Fin.tail v) (Fin.tail s) (Fin.tail active) A

theorem smooth_allocation_residual_step (n : ℕ) (v : Fin (n+1) → ℝ)
    (R : ℝ) (take : Fin (n+1) → Bool) :
    smoothAllocationResidual (n+1) v R take =
      smoothAllocationResidual n (Fin.tail v) (R-if take 0 then v 0 else 0) (Fin.tail take) := by
  rw [Fin.tail_def, Fin.tail_def]
  unfold smoothAllocationResidual
  rw [Fin.sum_univ_succ, sub_sub]

theorem smooth_allocation_terminal_residual (n : ℕ) (v s : Fin n → ℝ)
    (active : Fin n → Bool) (R A : ℝ) (take : Fin n → Bool)
    (hs : ∀ i, 0 < s i) (hR : 0 ≤ R)
    (hcap : R ≤ smoothAllocationInventory n v active+A)
    (hroom : SmoothAllocationRoom n v s active A)
    (hweight : 0 < smoothAllocationWeight n v s active R take) :
    0 ≤ smoothAllocationResidual n v R take ∧ smoothAllocationResidual n v R take ≤ A := by
  induction n generalizing R with
  | zero => simpa [smoothAllocationResidual,smoothAllocationInventory] using And.intro hR hcap
  | succ n ih =>
    obtain ⟨hhead,htail⟩ := smooth_allocation_positive_factors hweight
    have hnext : 0 ≤ R-(if take 0 then v 0 else 0) ∧
        R-(if take 0 then v 0 else 0) ≤ smoothAllocationInventory n (Fin.tail v) (Fin.tail active)+A := by
      cases ha : active 0 <;> cases ht : take 0
      · have hh : R ≤ smoothAllocationInventory n (Fin.tail v) (Fin.tail active)+A := by
          rw [Fin.tail_def, Fin.tail_def]
          unfold smoothAllocationInventory at *
          simpa only [Fin.sum_univ_succ, ha, Bool.false_eq_true, if_false, zero_add] using hcap
        simpa only [ht, Bool.false_eq_true, if_false, sub_zero] using And.intro hR hh
      · simp only [smoothSlotTransition, smoothSlotTakeProbability, ha, ht,
          Bool.false_eq_true, if_false, if_true] at hhead
        linarith
      · have hh := smooth_slot_skip_requires_room (hs 0) (by simpa only [ha,ht] using hhead)
        have hr := hroom.1 ha
        simp only [Bool.false_eq_true, if_false, sub_zero]
        exact ⟨hR, (le_of_lt hh).trans hr⟩
      · have hh := smooth_slot_take_requires_room (hs 0) (by simpa only [ht] using hhead)
        have hc : R ≤ v 0+smoothAllocationInventory n (Fin.tail v) (Fin.tail active)+A := by
          rw [Fin.tail_def, Fin.tail_def]
          unfold smoothAllocationInventory at *
          simpa only [Fin.sum_univ_succ, ha, if_true] using hcap
        simp only [if_true]
        constructor <;> linarith
    rw [smooth_allocation_residual_step]
    exact ih (Fin.tail v) (Fin.tail s) (Fin.tail active) _ (Fin.tail take)
      (fun i => hs i.succ) hnext.1 hnext.2 hroom.2 htail

noncomputable def allocationNaturalProduct {n : ℕ} (p : Fin n → ℕ) (take : Fin n → Bool) : ℕ :=
  ∏ i, if take i then p i else 1

theorem allocation_natural_product_exp_log {n : ℕ} (p : Fin n → ℕ)
    (hp : ∀ i, 0 < p i) (take : Fin n → Bool) :
    exp (∑ i, if take i then log (p i : ℝ) else 0) = (allocationNaturalProduct p take : ℝ) := by
  rw [exp_sum]
  unfold allocationNaturalProduct
  push_cast
  apply prod_congr rfl
  intro i hi
  cases take i <;> simp [exp_log (Nat.cast_pos.mpr (hp i))]

theorem smooth_allocation_product_range {n : ℕ} (p : Fin n → ℕ) (hp : ∀ i, 0 < p i)
    (s : Fin n → ℝ) (active : Fin n → Bool) (R A : ℝ) (take : Fin n → Bool)
    (hs : ∀ i, 0 < s i) (hR : 0 ≤ R)
    (hcap : R ≤ smoothAllocationInventory n (fun i => log (p i : ℝ)) active+A)
    (hroom : SmoothAllocationRoom n (fun i => log (p i : ℝ)) s active A)
    (hweight : 0 < smoothAllocationWeight n (fun i => log (p i : ℝ)) s active R take) :
    exp (R-A) ≤ (allocationNaturalProduct p take : ℝ) ∧
      (allocationNaturalProduct p take : ℝ) ≤ exp R := by
  obtain ⟨hlo,hhi⟩ := smooth_allocation_terminal_residual n (fun i => log (p i : ℝ))
    s active R A take hs hR hcap hroom hweight
  unfold smoothAllocationResidual at hlo hhi
  rw [← allocation_natural_product_exp_log p hp take]
  constructor <;> apply exp_le_exp.mpr <;> linarith

end Bounty
end

section

/- Exact decomposition and overlap energy for position-dependent vectors. -/

open scoped BigOperators InnerProductSpace

namespace Bounty

theorem position_block_vector_sum {X : Type*} [Fintype X]
    (position : X → ℤ) (mass : ℝ) (S : Finset ℤ) (H : ℤ) (f : ℤ → ℂ)
    (hf : ∀ x, position x ∉ S → f (position x) = 0) :
    (∑ j ∈ S.image (fun n => n / H),
      finitePositionVector position mass (integerBlockMask id H j f)) =
      finitePositionVector position mass f := by
  classical
  ext x
  simp only [WithLp.ofLp_sum, Finset.sum_apply]
  change (∑ j ∈ S.image (fun n => n / H),
    (Real.sqrt mass : ℂ) * integerBlockMask id H j f (position x)) =
    (Real.sqrt mass : ℂ) * f (position x)
  rw [← Finset.mul_sum]
  by_cases hx : position x ∈ S
  · congr 1
    simpa only [id_eq] using sum_integerBlockMask_eq S id H f hx
  · simp [integerBlockMask, hf x hx]

theorem position_block_energy_sum {X : Type*} [Fintype X]
    (position : X → ℤ) {mass : ℝ} (hmass : 0 ≤ mass)
    (S : Finset ℤ) (H : ℤ) (f : ℤ → ℂ)
    (hf : ∀ x, position x ∉ S → f (position x) = 0) :
    (∑ j ∈ S.image (fun n => n / H),
      ‖finitePositionVector position mass (integerBlockMask id H j f)‖ ^ 2) =
      ‖finitePositionVector position mass f‖ ^ 2 := by
  classical
  simp only [finite_position_vector_norm_sq position hmass, ← Finset.mul_sum]
  congr 1
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro x _
  by_cases hx : position x ∈ S
  · have ht := sum_integerBlockMask_eq S id H (fun n => ‖f n‖ ^ 2) hx
    convert ht using 1
    apply Finset.sum_congr rfl
    intro j _
    by_cases hj : position x / H = j <;> simp [integerBlockMask, hj]
  · simp [integerBlockMask, hf x hx]

theorem position_near_block_energy_sum {X : Type*} [Fintype X]
    (position : X → ℤ) {mass : ℝ} (hmass : 0 ≤ mass)
    (J : Finset ℤ) (H : ℤ) (g : ℤ → ℂ) :
    (∑ j ∈ J, ‖finitePositionVector position mass (integerBlockNearMask id H j g)‖ ^ 2) ≤
      3 * ‖finitePositionVector position mass g‖ ^ 2 := by
  classical
  simp only [finite_position_vector_norm_sq position hmass]
  have h := sum_integerBlockNear_sq_norm_le Finset.univ J position H
    (fun _ => mass) (fun x => g (position x)) (fun _ _ => hmass)
  simpa only [Finset.mul_sum, integerBlockNearMask, id_eq] using h

end Bounty
end

section

/- The same cutoff consumes a vanishing fraction of a polynomially long path. -/

open Filter

namespace Bounty

theorem forest_rank_cutoff_ratio_le {K L b : ℝ} (hK : 0 ≤ K) (hL : 1 ≤ L)
    (hb : 0 < b) (N : ℕ) (hN : 0 < N) :
    (Nat.ceil (K * N * Real.log L / b) : ℝ) / N ≤
      K * Real.log L / b + 1 / N := by
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  have hlog : 0 ≤ Real.log L := Real.log_nonneg hL
  have hceil := (Nat.ceil_lt_add_one (show 0 ≤ K * N * Real.log L / b by positivity)).le
  calc
    _ ≤ (K * N * Real.log L / b + 1) / N := div_le_div_of_nonneg_right hceil hNr.le
    _ = _ := by field_simp

theorem eventually_forest_rank_cutoff_small {a c ε K : ℝ}
    (ha : 0 < a) (hc : 0 < c) (hε : 0 < ε) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop, ∀ N : ℕ, L ^ a ≤ (N : ℝ) →
      ∀ b : ℝ, L ^ c ≤ b →
        (Nat.ceil (K * N * Real.log L / b) : ℝ) / N ≤ ε := by
  filter_upwards [eventually_ge_atTop (1 : ℝ),
    eventually_mul_rpow_log_add_le_rpow (a := 0) hc hc (half_pos hε) K 0,
    eventually_mul_rpow_log_add_le_rpow (a := 0) ha ha (half_pos hε) 0 1] with L hL hlog hunit
  simp only [Real.rpow_zero, mul_one, add_zero, zero_mul, zero_add] at hlog hunit
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL
  intro N hN b hb
  have hNr : (0 : ℝ) < N := (Real.rpow_pos_of_pos hL0 a).trans_le hN
  have hb0 : 0 < b := (Real.rpow_pos_of_pos hL0 c).trans_le hb
  have hr := forest_rank_cutoff_ratio_le hK hL hb0 N (by exact_mod_cast hNr)
  have hp : K * Real.log L / b ≤ ε / 2 := by
    apply (div_le_iff₀ hb0).mpr
    exact hlog.trans (mul_le_mul_of_nonneg_left hb (half_pos hε).le)
  have hn : 1 / (N : ℝ) ≤ ε / 2 := by
    apply (div_le_iff₀ hNr).mpr
    exact hunit.trans (mul_le_mul_of_nonneg_left hN (half_pos hε).le)
  linarith

end Bounty
end

section

/- L1 bounds and uniform rapid Fourier truncation for the explicit cutoff pair. -/

open MeasureTheory

namespace Bounty

theorem typeII_cutoff_fourier_l1_bound (A : ℝ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ active : Bool,
      (∫ ξ : ℝ, ‖typeIICutoffFourier A active ξ‖) ≤ C := by
  let I₀ : ℝ := ∫ ξ : ℝ, ‖typeIICutoffFourier A false ξ‖
  let I₁ : ℝ := ∫ ξ : ℝ, ‖typeIICutoffFourier A true ξ‖
  have h₀ : 0 ≤ I₀ := integral_nonneg (fun _ => norm_nonneg _)
  have h₁ : 0 ≤ I₁ := integral_nonneg (fun _ => norm_nonneg _)
  refine ⟨1 + I₀ + I₁, by linarith, ?_⟩
  intro active
  cases active
  · change I₀ ≤ 1 + I₀ + I₁
    linarith
  · change I₁ ≤ 1 + I₀ + I₁
    linarith

theorem typeII_cutoff_fourier_rapid_tail (A : ℝ) (M : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ active : Bool, ∀ R : ℝ, 1 ≤ R →
      (∫ ξ in {ξ : ℝ | R < ‖ξ‖}, ‖typeIICutoffFourier A active ξ‖) ≤
        C * R ^ (-(M : ℝ)) := by
  obtain ⟨C₀, h₀, hb₀⟩ := schwartz_norm_rapid_tail (typeIICutoffFourier A false) M
  obtain ⟨C₁, h₁, hb₁⟩ := schwartz_norm_rapid_tail (typeIICutoffFourier A true) M
  refine ⟨C₀ + C₁, add_pos h₀ h₁, ?_⟩
  intro active R hR
  have hp : 0 ≤ R ^ (-(M : ℝ)) := Real.rpow_nonneg (by linarith) _
  cases active
  · exact (hb₀ R hR).trans (mul_le_mul_of_nonneg_right (by linarith) hp)
  · exact (hb₁ R hR).trans (mul_le_mul_of_nonneg_right (by linarith) hp)

noncomputable def typeIICutoffFourierIntegrand (A : ℝ) (active : Bool) (t ξ : ℝ) : ℂ :=
  Complex.exp ((2 * Real.pi * ξ * t : ℝ) * Complex.I) * typeIICutoffFourier A active ξ

theorem typeII_cutoff_fourier_integrand_norm (A t ξ : ℝ) (active : Bool) :
    ‖typeIICutoffFourierIntegrand A active t ξ‖ = ‖typeIICutoffFourier A active ξ‖ := by
  rw [typeIICutoffFourierIntegrand, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]

theorem typeII_cutoff_fourier_integrand_integrable (A t : ℝ) (active : Bool) :
    Integrable (typeIICutoffFourierIntegrand A active t) := by
  have hc : Continuous (typeIICutoffFourierIntegrand A active t) := by
    unfold typeIICutoffFourierIntegrand
    apply Continuous.mul
    · fun_prop
    · exact (typeIICutoffFourier A active).continuous
  apply (typeII_cutoff_fourier_integrable A active).norm.mono' hc.aestronglyMeasurable
  exact Filter.Eventually.of_forall (fun ξ => (typeII_cutoff_fourier_integrand_norm A t ξ active).le)

theorem typeII_cutoff_fourier_truncation_le_tail (A t R : ℝ) (active : Bool) :
    ‖(typeIISmoothCutoff A active t : ℂ) -
        ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R}, typeIICutoffFourierIntegrand A active t ξ‖ ≤
      ∫ ξ in {ξ : ℝ | R < ‖ξ‖}, ‖typeIICutoffFourier A active ξ‖ := by
  have hs : MeasurableSet {ξ : ℝ | ‖ξ‖ ≤ R} :=
    (isClosed_le continuous_norm continuous_const).measurableSet
  have heq : {ξ : ℝ | ‖ξ‖ ≤ R}ᶜ = {ξ : ℝ | R < ‖ξ‖} := by
    ext ξ
    simp
  rw [typeII_cutoff_fourier_inversion]
  change ‖(∫ ξ : ℝ, typeIICutoffFourierIntegrand A active t ξ) - _‖ ≤ _
  rw [← setIntegral_compl hs (typeII_cutoff_fourier_integrand_integrable A t active), heq]
  apply (norm_integral_le_integral_norm _).trans
  apply le_of_eq
  exact integral_congr_ae (Filter.Eventually.of_forall (fun ξ =>
    typeII_cutoff_fourier_integrand_norm A t ξ active))

theorem typeII_cutoff_fourier_rapid_truncation (A : ℝ) (M : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ active : Bool, ∀ R : ℝ, 1 ≤ R → ∀ t : ℝ,
      ‖(typeIISmoothCutoff A active t : ℂ) -
          ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R}, typeIICutoffFourierIntegrand A active t ξ‖ ≤
        C * R ^ (-(M : ℝ)) := by
  obtain ⟨C, hC, hb⟩ := typeII_cutoff_fourier_rapid_tail A M
  exact ⟨C, hC, fun active R hR t =>
    (typeII_cutoff_fourier_truncation_le_tail A t R active).trans (hb active R hR)⟩




end Bounty
end

section

/- Exact separation of labelled, independently twisted slots. -/

open Finset

namespace Bounty

noncomputable def orderedSlotComplexWeight {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (twist : I → ℕ → ℂ) (n : ℕ) : ℂ :=
  ∑ x : ∀ i, choices i, if orderedSlotProduct choices x = n
    then ∏ i, twist i (x i).val else 0

noncomputable def orderedSlotProductSupport {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) : Finset ℕ :=
  univ.image (orderedSlotProduct choices)

theorem ordered_slot_complex_weight_support {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (twist : I → ℕ → ℂ) {n : ℕ}
    (hn : n ∉ orderedSlotProductSupport choices) : orderedSlotComplexWeight choices twist n = 0 := by
  classical
  apply sum_eq_zero
  intro x _
  exact if_neg (fun h => hn (mem_image.mpr ⟨x, mem_univ _, h⟩))

theorem ordered_slot_complex_fiber_test {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (twist : I → ℕ → ℂ) (F : ℕ → ℂ) :
    (∑ n ∈ orderedSlotProductSupport choices, orderedSlotComplexWeight choices twist n * F n) =
      ∑ x : ∀ i, choices i, (∏ i, twist i (x i).val) * F (orderedSlotProduct choices x) := by
  classical
  simp only [orderedSlotComplexWeight, sum_mul]
  rw [sum_comm]
  apply sum_congr rfl
  intro x _
  have hx : orderedSlotProduct choices x ∈ orderedSlotProductSupport choices :=
    mem_image.mpr ⟨x, mem_univ _, rfl⟩
  simp only [ite_mul, zero_mul]
  simp [hx]







theorem ordered_slot_twisted_single_split {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (twist : I → ℕ → ℂ) (i : I) (F : ℕ → ℂ) :
    (∑ x : ∀ j, choices j, (∏ j, twist j (x j).val) * F (orderedSlotProduct choices x)) =
      ∑ p : choices i,
      ∑ q ∈ orderedSlotProductSupport (fun j : {j : I // j ≠ i} => choices j.val),
        twist i p.val *
          orderedSlotComplexWeight (fun j : {j : I // j ≠ i} => choices j.val)
            (fun j => twist j.val) q * F (p.val*q) := by
  classical
  let f : choices i × (∀ j : {j : I // j ≠ i}, choices j.val) → ℂ := fun z =>
    twist i z.1.val * (∏ j, twist j.val (z.2 j).val) *
      F (z.1.val * orderedSlotProduct _ z.2)
  calc
    _ = ∑ z, f z := by
      apply Fintype.sum_equiv (Equiv.piSplitAt i (fun j => choices j))
      intro x
      simp only [f, Equiv.piSplitAt_apply]
      rw [ordered_slot_product_split choices i x,
        Fintype.prod_eq_mul_prod_subtype_ne (fun j => twist j (x j).val) i]
    _ = ∑ p : choices i, ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
        twist i p.val * (∏ j, twist j.val (y j).val) *
          F (p.val * orderedSlotProduct _ y) := Fintype.sum_prod_type f
    _ = _ := by
      apply sum_congr rfl
      intro p _
      simp_rw [mul_assoc]
      rw [← mul_sum, ← mul_sum, ordered_slot_complex_fiber_test]

theorem ordered_slot_complex_single_convolution {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (twist : I → ℕ → ℂ) (i : I) (n : ℕ) :
    orderedSlotComplexWeight choices twist n =
      ∑ p : choices i,
      ∑ q ∈ orderedSlotProductSupport (fun j : {j : I // j ≠ i} => choices j.val),
        if p.val*q=n then twist i p.val *
          orderedSlotComplexWeight (fun j : {j : I // j ≠ i} => choices j.val)
            (fun j => twist j.val) q else 0 := by
  have h := ordered_slot_twisted_single_split choices twist i (fun t => if t=n then 1 else 0)
  simpa only [orderedSlotComplexWeight, mul_ite, mul_one, mul_zero] using h


end Bounty
end

section

/- Pure candidate Q-slot subsets retain the original factorial normalization. -/

open Finset

namespace Bounty

theorem candidate_Q_subset_group_card_le {I : Type*} [Fintype I]
    {c L : ℝ} {r : ℕ}
    (emb : I → (candidateQIndices c L) × Fin r) (hemb : Function.Injective emb)
    (j : candidateQIndices c L) :
    Fintype.card {i : I // (emb i).1 = j} ≤ r := by
  let f : {i : I // (emb i).1 = j} → Fin r := fun i => (emb i.val).2
  have hf : Function.Injective f := by
    intro i k hik
    apply Subtype.ext
    apply hemb
    exact Prod.ext (i.property.trans k.property.symm) hik
  simpa only [Fintype.card_fin] using Fintype.card_le_of_injective f hf

theorem candidate_Q_subset_factorial_product_le {I : Type*} [Fintype I]
    {c L : ℝ} {r : ℕ}
    (emb : I → (candidateQIndices c L) × Fin r) (hemb : Function.Injective emb) :
    (∏ j : candidateQIndices c L, ((Fintype.card {i : I // (emb i).1 = j}).factorial : ℝ)) ≤
      (r.factorial : ℝ) ^ (candidateQIndices c L).card := by
  calc
    _ ≤ ∏ _j : candidateQIndices c L, (r.factorial : ℝ) := by
      apply prod_le_prod₀
      · intro j _
        positivity
      · intro j _
        exact_mod_cast Nat.factorial_le (candidate_Q_subset_group_card_le emb hemb j)
    _ = _ := by simp

section

variable
  {I : Type*}
  [sharedInstance1 : Fintype I]
  [sharedInstance2 : DecidableEq I]
  {c L : ℝ}
  {r jStar : ℕ}
  (hcL : 0 ≤ c * L)
  (hr : 0 < r)
  (hj : jStar ∈ candidateQIndices c L)
  (emb : I → (candidateQIndices c L) × Fin r)

include I sharedInstance1 sharedInstance2 c L r jStar hcL hr hj emb

theorem norm_candidate_Q_pure_subset_fiber_le 
    (hpure : ∀ i, emb i ≠ candidateRoughSlot c L r jStar hr hj)
    (twist : I → ℕ → ℂ)
    (htwist : ∀ i p, p ∈ candidateQSlotChoices c L r jStar (emb i) → ‖twist i p‖ ≤ 1)
    (n : ℕ) :
    ‖∑ a : ∀ i, candidateQSlotChoices c L r jStar (emb i),
      if orderedSlotProduct (fun i => candidateQSlotChoices c L r jStar (emb i)) a = n
      then ∏ i, twist i (a i).val else 0‖ ≤
      ∏ j : candidateQIndices c L, ((Fintype.card {i : I // (emb i).1 = j}).factorial : ℝ) := by
  classical
  let choices := fun i => candidateQSlotChoices c L r jStar (emb i)
  let x (a : ∀ i, choices i) (i : I) : ℕ := (a i).val
  have hxinj : Function.Injective x := by
    intro a b hab
    funext i
    exact Subtype.ext (congrFun hab i)
  have hx : ∀ (a : ∀ i, choices i) i, x a i ∈ candidateQBand (c * L) (emb i).1.val := by
    intro a i
    have ha : x a i ∈ choices i := (a i).property
    dsimp only [choices] at ha
    rw [candidate_Q_choices_eq_single_rough c L r jStar hr hj] at ha
    simpa only [if_neg (hpure i)] using ha
  have hw : ∀ a : ∀ i, choices i, ‖∏ i, twist i (a i).val‖ ≤ 1 := by
    intro a
    rw [norm_prod]
    exact prod_le_one₀ (fun i _ => norm_nonneg _) (fun i _ => htwist i _ (a i).property)
  exact norm_labelled_prime_product_fiber_sum_le
    (fun i => (emb i).1) (fun j => candidateQBand (c * L) j.val)
    (fun _ _ hp => (mem_filter.mp hp).2) (candidate_Q_group_disjoint hcL)
    x hxinj hx (fun a => ∏ i, twist i (a i).val) hw n

theorem norm_candidate_Q_pure_subset_fiber_le_factorial_pow  (hemb : Function.Injective emb)
    (hpure : ∀ i, emb i ≠ candidateRoughSlot c L r jStar hr hj)
    (twist : I → ℕ → ℂ)
    (htwist : ∀ i p, p ∈ candidateQSlotChoices c L r jStar (emb i) → ‖twist i p‖ ≤ 1)
    (n : ℕ) :
    ‖∑ a : ∀ i, candidateQSlotChoices c L r jStar (emb i),
      if orderedSlotProduct (fun i => candidateQSlotChoices c L r jStar (emb i)) a = n
      then ∏ i, twist i (a i).val else 0‖ ≤
      (r.factorial : ℝ) ^ (candidateQIndices c L).card :=
  (norm_candidate_Q_pure_subset_fiber_le hcL hr hj emb hpure twist htwist n).trans
    (candidate_Q_subset_factorial_product_le emb hemb)

theorem norm_candidate_Q_pure_subset_fiber_normalized_le_one  (hemb : Function.Injective emb)
    (hpure : ∀ i, emb i ≠ candidateRoughSlot c L r jStar hr hj)
    (twist : I → ℕ → ℂ)
    (htwist : ∀ i p, p ∈ candidateQSlotChoices c L r jStar (emb i) → ‖twist i p‖ ≤ 1)
    (n : ℕ) :
    ‖(∑ a : ∀ i, candidateQSlotChoices c L r jStar (emb i),
      if orderedSlotProduct (fun i => candidateQSlotChoices c L r jStar (emb i)) a = n
      then ∏ i, twist i (a i).val else 0) /
      (((r.factorial : ℝ) ^ (candidateQIndices c L).card : ℝ) : ℂ)‖ ≤ 1 := by
  have hpos : 0 < (r.factorial : ℝ) ^ (candidateQIndices c L).card := by positivity
  rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hpos]
  exact (div_le_one hpos).mpr
    (norm_candidate_Q_pure_subset_fiber_le_factorial_pow hcL hr hj emb hemb hpure twist htwist n)

end



end Bounty
end

section

/- Polynomial Schwartz bounds transfer to polynomial Fourier L1 moments. -/

open Finset MeasureTheory
open scoped FourierTransform

namespace Bounty

theorem fourier_seminorm_polynomial {I : Type*}
    (f : I → SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p)
    (hsemi : ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (f p) ≤ C*(w p)^d) :
    ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (𝓕 (f p)) ≤ C*(w p)^d := by
  intro k n
  let T := FourierTransform.fourierCLM ℂ (SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ)
  let q := (SchwartzMap.seminorm ℂ k n).comp T.toLinearMap
  have hq : Continuous q :=
    ((schwartz_withSeminorms ℂ (EuclideanSpace ℝ (Fin 3)) ℂ).continuous_seminorm (k,n)).comp T.continuous
  exact continuous_schwartz_seminorm_polynomial f w hw hsemi q hq

theorem fourier_moment_polynomial_of_seminorm_bounds {I : Type*}
    (f : I → SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p)
    (hsemi : ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (f p) ≤ C*(w p)^d)
    (M : ℕ) :
    ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ p,
      (∫ ξ : EuclideanSpace ℝ (Fin 3), ‖ξ‖^M*‖𝓕 (f p) ξ‖) ≤ C*(w p)^d := by
  let N := (volume : Measure (EuclideanSpace ℝ (Fin 3))).integrablePower
  let B : ℝ := 2^N*(∫ ξ : EuclideanSpace ℝ (Fin 3), (1+‖ξ‖)^(-(N : ℝ)))
  have hB : 0 ≤ B := by
    apply mul_nonneg (by positivity)
    exact integral_nonneg (fun ξ => Real.rpow_nonneg (by positivity) _)
  obtain ⟨d0,C0,hC0,h0⟩ := fourier_seminorm_polynomial f w hw hsemi 0 0
  obtain ⟨d1,C1,hC1,h1⟩ := fourier_seminorm_polynomial f w hw hsemi (M+N) 0
  refine ⟨d0+d1,B*(C0+C1),mul_nonneg hB (add_nonneg hC0 hC1),?_⟩
  intro p
  have h0' : SchwartzMap.seminorm ℂ 0 0 (𝓕 (f p)) ≤ C0*(w p)^(d0+d1) :=
    (h0 p).trans (mul_le_mul_of_nonneg_left
      (pow_le_pow_right₀ (hw p) (Nat.le_add_right d0 d1)) hC0)
  have h1' : SchwartzMap.seminorm ℂ (M+N) 0 (𝓕 (f p)) ≤ C1*(w p)^(d0+d1) :=
    (h1 p).trans (mul_le_mul_of_nonneg_left
      (pow_le_pow_right₀ (hw p) (Nat.le_add_left d1 d0)) hC1)
  have hi := (𝓕 (f p)).integral_pow_mul_iteratedFDeriv_le ℂ volume M 0
  simp only [norm_iteratedFDeriv_zero] at hi
  calc
    _ ≤ B*(SchwartzMap.seminorm ℂ 0 0 (𝓕 (f p)) +
        SchwartzMap.seminorm ℂ (M+N) 0 (𝓕 (f p))) := hi
    _ ≤ B*(C0*(w p)^(d0+d1)+C1*(w p)^(d0+d1)) :=
      mul_le_mul_of_nonneg_left (add_le_add h0' h1') hB
    _ = _ := by ring

theorem fourier_moment_polynomial_of_fixed_support {I : Type*}
    (f : I → SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p) (R : ℝ) (hR : 0 ≤ R)
    (hsupport : ∀ p, tsupport (f p) ⊆ Metric.closedBall 0 R)
    (hderiv : ∀ n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p x, ‖iteratedFDeriv ℝ n (f p) x‖ ≤ C*(w p)^d)
    (M : ℕ) :
    ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ p,
      (∫ ξ : EuclideanSpace ℝ (Fin 3), ‖ξ‖^M*‖𝓕 (f p) ξ‖) ≤ C*(w p)^d :=
  fourier_moment_polynomial_of_seminorm_bounds f w hw
    (schwartz_seminorm_polynomial_of_fixed_support f w hw R hR hsupport hderiv) M




end Bounty
end

section

/- Unit Mellin phases and exact separation at the two product endpoints. -/

open scoped ComplexConjugate

namespace Bounty

noncomputable def typeIIPhase (t : ℝ) (n : ℕ) : ℂ :=
  Complex.exp (Complex.I * ((t * Real.log (n : ℝ) : ℝ) : ℂ))

theorem typeIIPhase_zero (n : ℕ) : typeIIPhase 0 n = 1 := by
  simp [typeIIPhase]




theorem typeIIPhase_add (s t : ℝ) (n : ℕ) :
    typeIIPhase (s + t) n = typeIIPhase s n * typeIIPhase t n := by
  unfold typeIIPhase
  rw [← Complex.exp_add]
  congr 1
  push_cast
  ring




theorem typeIIPhase_conj (t : ℝ) (n : ℕ) :
    conj (typeIIPhase t n) = typeIIPhase (-t) n := by
  unfold typeIIPhase
  rw [← Complex.exp_conj, map_mul, Complex.conj_I, Complex.conj_ofReal]
  congr 1
  push_cast
  ring

theorem typeIIPhase_norm (t : ℝ) (n : ℕ) : ‖typeIIPhase t n‖ = 1 :=
  Complex.norm_exp_I_mul_ofReal _




theorem typeIIPhase_eq_cpow (t : ℝ) {n : ℕ} (hn : 0 < n) :
    typeIIPhase t n = (n : ℂ) ^ ((t : ℂ) * Complex.I) := by
  have hnC : (n : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hn.ne'
  rw [Complex.cpow_def_of_ne_zero hnC]
  have hlog : Complex.log (n : ℂ) = (Real.log (n : ℝ) : ℂ) := by
    exact (Complex.ofReal_log (Nat.cast_nonneg n)).symm
  rw [hlog]
  unfold typeIIPhase
  congr 1
  push_cast
  ring




/- With endpoints `m' * h` and `m * h'`, the residual phase separates exactly. -/
theorem typeIIPhase_endpoint_factorization (ξ₁ ξ₂ ξ₃ ρ : ℝ)
    {m m' h h' : ℕ} (hm : 0 < m) (hm' : 0 < m') (hh : 0 < h) (hh' : 0 < h') :
    typeIIPhase ξ₁ m * typeIIPhase ξ₂ m' * typeIIPhase ξ₃ (m' * h) *
        typeIIPhase ρ h * conj (typeIIPhase ρ h') =
      typeIIPhase (ρ + ξ₃) (m' * h) * typeIIPhase (-ρ) (m * h') *
        conj (typeIIPhase (ρ - ξ₂) m') * typeIIPhase (ξ₁ + ρ) m := by
  rw [typeIIPhase_conj, typeIIPhase_conj]
  simp only [typeIIPhase, Nat.cast_mul,
    Real.log_mul (Nat.cast_ne_zero.mpr hm'.ne') (Nat.cast_ne_zero.mpr hh.ne'),
    Real.log_mul (Nat.cast_ne_zero.mpr hm.ne') (Nat.cast_ne_zero.mpr hh'.ne'),
    ← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem typeIIPhase_endpoint_factorization_of_eq (ξ₁ ξ₂ ξ₃ ρ : ℝ)
    {m m' h h' z w : ℕ} (hm : 0 < m) (hm' : 0 < m') (hh : 0 < h) (hh' : 0 < h')
    (hz : z = m' * h) (hw : w = m * h') :
    typeIIPhase ξ₁ m * typeIIPhase ξ₂ m' * typeIIPhase ξ₃ z *
        typeIIPhase ρ h * conj (typeIIPhase ρ h') =
      typeIIPhase (ρ + ξ₃) z * typeIIPhase (-ρ) w *
        conj (typeIIPhase (ρ - ξ₂) m') * typeIIPhase (ξ₁ + ρ) m := by
  subst z w
  exact typeIIPhase_endpoint_factorization ξ₁ ξ₂ ξ₃ ρ hm hm' hh hh'


end Bounty
end

section

/- Exact finite support masks for the divisor-based three-factor endpoint. -/

open Finset

namespace Bounty

theorem finite_triple_sum_eq_endpointTripleConvolution
    (M R C : Finset ℕ) (f g c : ℕ → ℂ) {n : ℕ} (hn : 0 < n) :
    (∑ m ∈ M, ∑ p ∈ R, ∑ r ∈ C,
      if m * p * r = n then f m * g p * c r else 0) =
      endpointTripleConvolution
        (fun m => if m ∈ M then f m else 0)
        (fun p => if p ∈ R then g p else 0)
        (fun r => if r ∈ C then c r else 0) n := by
  classical
  unfold endpointTripleConvolution
  apply sum_congr_of_eq_on_inter
  · intro m _ hm
    apply sum_eq_zero
    intro p _
    apply sum_eq_zero
    intro r _
    apply if_neg
    intro heq
    apply hm
    exact Nat.mem_divisors.mpr ⟨⟨p * r, by simpa only [mul_assoc] using heq.symm⟩, hn.ne'⟩
  · intro m _ hm
    simp only [if_neg hm, zero_mul, sum_const_zero]
  · intro m hmM hmD
    have hmpos : 0 < m := Nat.pos_of_mem_divisors hmD
    have hmdvd : m ∣ n := Nat.dvd_of_mem_divisors hmD
    have hmprod : m * (n / m) = n := Nat.mul_div_cancel' hmdvd
    have hnmpos : 0 < n / m := by
      apply Nat.pos_of_ne_zero
      intro hz
      rw [hz, mul_zero] at hmprod
      exact hn.ne' hmprod.symm
    simp only [if_pos hmM]
    apply sum_congr_of_eq_on_inter
    · intro p _ hp
      apply sum_eq_zero
      intro r _
      apply if_neg
      intro heq
      apply hp
      have hquot : n / m = p * r :=
        Nat.div_eq_of_eq_mul_right hmpos (by simpa only [mul_assoc] using heq.symm)
      exact Nat.mem_divisors.mpr ⟨⟨r, hquot⟩, hnmpos.ne'⟩
    · intro p _ hp
      simp only [if_neg hp, mul_zero, zero_mul]
    · intro p hpR hpD
      have hppos : 0 < p := Nat.pos_of_mem_divisors hpD
      have hpdvd : p ∣ n / m := Nat.dvd_of_mem_divisors hpD
      have hpprod : p * (n / m / p) = n / m := Nat.mul_div_cancel' hpdvd
      have heq (r : ℕ) : m * p * r = n ↔ r = n / m / p := by
        constructor
        · intro h
          have hquot : n / m = p * r :=
            Nat.div_eq_of_eq_mul_right hmpos (by simpa only [mul_assoc] using h.symm)
          exact (Nat.div_eq_of_eq_mul_right hppos hquot).symm
        · intro h
          rw [h, mul_assoc, hpprod, hmprod]
      simp only [heq, if_pos hpR]
      rw [sum_ite_eq']
      split_ifs <;> simp





end Bounty
end

section

/- A common forest expansion absorbs root-dependent initial avoidance into initial birth addresses. -/

open Finset Classical

namespace Bounty

def initialBirthIndexedPerformed {I J α : Type*} {m : ℕ} (e : Fin m ≃ I ⊕ J)
    (initial : I → α) (birth : J → Option α) (i : Fin m) : Prop :=
  (initialAndBirthLabels initial birth (e i)).isSome = true

def initialBirthIndexedValue {I J α : Type*} {m : ℕ} (e : Fin m ≃ I ⊕ J)
    (encode : α → ℤ) (initial : I → α) (birth : J → Option α) (i : Fin m) : ℤ :=
  ((initialAndBirthLabels initial birth (e i)).map encode).getD 0

theorem initial_birth_indexed_distinct_iff {I J α : Type*} {m : ℕ}
    (e : Fin m ≃ I ⊕ J) (encode : α → ℤ) (hencode : Function.Injective encode)
    (initial : I → α) (birth : J → Option α) :
    birthValuesDistinct (initialBirthIndexedPerformed e initial birth)
      (initialBirthIndexedValue e encode initial birth) ↔
      Function.Injective initial ∧
        (∀ a b z, birth a = some z → birth b = some z → a = b) ∧
        (∀ i j, birth j ≠ some (initial i)) := by
  change birthValuesDistinct
    (fun i => (initialAndBirthLabels initial birth (e i)).isSome = true)
    (fun i => ((initialAndBirthLabels initial birth (e i)).map encode).getD 0) ↔ _
  rw [birth_values_distinct_option_equiv_iff e _ _ (fun _ => Iff.rfl) encode hencode,
    optional_label_injOn_iff_same_some _ _ (fun _ => Iff.rfl)]
  exact initial_birth_distinctness_iff initial birth

theorem initial_birth_path_forest_expansion {Ω I J α : Type*} {m : ℕ}
    (paths : Finset Ω) (e : Fin m ≃ I ⊕ J) (encode : α → ℤ)
    (hencode : Function.Injective encode) (initial : Ω → I → α)
    (birth : Ω → J → Option α) (w : Ω → ℂ)
    (hinitial : ∀ ω ∈ paths, Function.Injective (initial ω)) :
    (∑ ω ∈ paths,
      (if ∀ i j, birth ω j ≠ some (initial ω i) then (1 : ℂ) else 0) *
      (if ∀ a b z, birth ω a = some z → birth ω b = some z → a = b then (1 : ℂ) else 0) * w ω) =
      ∑ code : BirthForestCode m, (-1 : ℂ) ^ birthForestRank code *
        birthForestPathSum paths w
          (fun ω => initialBirthIndexedPerformed e (initial ω) (birth ω))
          (fun ω => initialBirthIndexedValue e encode (initial ω) (birth ω)) code := by
  rw [← distinct_birth_path_expansion]
  unfold distinctBirthPathSum
  apply sum_congr rfl
  intro ω hω
  rw [initial_birth_indexed_distinct_iff e encode hencode]
  by_cases hd : ∀ a b z, birth ω a = some z → birth ω b = some z → a = b <;>
    by_cases ha : ∀ i j, birth ω j ≠ some (initial ω i) <;>
    simp [hinitial ω hω, hd, ha]

end Bounty
end

section

/- Joint and full-state dilation congruence preserves both joint caps. -/

open Finset
namespace Bounty
section Joint
variable {G : Type*} {P : G → Type*}
  (n : ∀ g, P g → ℕ) (Δ D D' : G → ℤ)
  (hD : ∀ g p, ((n g p : ℤ) ∣ D g ↔ (n g p : ℤ) ∣ D' g))
  (t : G → ℕ) (B : ℕ)

def unrestrictedJointDilationEventEquiv
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B) :
    UnrestrictedJointEvent n Δ D t B s ≃ UnrestrictedJointEvent n Δ D' t B s :=
  Equiv.piCongrRight (fun g => unrestrictedDilationEventEquiv (n g) (Δ g) (D g) (D' g) (hD g) (s g))

theorem unrestricted_joint_dilation_target
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (e : UnrestrictedJointEvent n Δ D t B s) :
    unrestrictedJointEventTarget n Δ D' t B s (unrestrictedJointDilationEventEquiv n Δ D D' hD t B s e) =
      unrestrictedJointEventTarget n Δ D t B s e := by
  funext g
  exact unrestricted_dilation_event_target (n g) (Δ g) (D g) (D' g) (hD g) (s g) (e g)

theorem unrestricted_joint_dilation_weight [Fintype G]
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (e : UnrestrictedJointEvent n Δ D t B s) :
    unrestrictedJointCutoffEventWeight n Δ D' μ ρ V t B s
      (unrestrictedJointDilationEventEquiv n Δ D D' hD t B s e) =
    unrestrictedJointCutoffEventWeight n Δ D μ ρ V t B s e := by
  unfold unrestrictedJointCutoffEventWeight
  rw [unrestricted_joint_dilation_target]
  split_ifs
  · apply prod_congr rfl
    intro g _
    exact unrestricted_dilation_event_weight (n g) (Δ g) (D g) (D' g) (hD g) (μ g) ρ (V g) (s g) (e g)
  · rfl

end Joint
end Bounty
end

section

/- Polynomial Schwartz bounds transfer to polynomial Fourier L1 moments. -/

open Finset MeasureTheory
open scoped FourierTransform

namespace Bounty

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
  [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E]

theorem fourier_domain_seminorm_polynomial {I : Type*}
    (f : I → SchwartzMap E ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p)
    (hsemi : ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (f p) ≤ C*(w p)^d) :
    ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (𝓕 (f p)) ≤ C*(w p)^d := by
  intro k n
  let T := FourierTransform.fourierCLM ℂ (SchwartzMap E ℂ)
  let q := (SchwartzMap.seminorm ℂ k n).comp T.toLinearMap
  have hq : Continuous q :=
    ((schwartz_withSeminorms ℂ E ℂ).continuous_seminorm (k,n)).comp T.continuous
  exact continuous_schwartz_domain_seminorm_polynomial f w hw hsemi q hq

theorem fourier_domain_moment_polynomial_of_seminorm_bounds {I : Type*}
    (f : I → SchwartzMap E ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p)
    (hsemi : ∀ k n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p, SchwartzMap.seminorm ℂ k n (f p) ≤ C*(w p)^d)
    (M : ℕ) :
    ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ p,
      (∫ ξ : E, ‖ξ‖^M*‖𝓕 (f p) ξ‖) ≤ C*(w p)^d := by
  let N := (volume : Measure E).integrablePower
  let B : ℝ := 2^N*(∫ ξ : E, (1+‖ξ‖)^(-(N : ℝ)))
  have hB : 0 ≤ B := by
    apply mul_nonneg (by positivity)
    exact integral_nonneg (fun ξ => Real.rpow_nonneg (by positivity) _)
  obtain ⟨d0,C0,hC0,h0⟩ := fourier_domain_seminorm_polynomial f w hw hsemi 0 0
  obtain ⟨d1,C1,hC1,h1⟩ := fourier_domain_seminorm_polynomial f w hw hsemi (M+N) 0
  refine ⟨d0+d1,B*(C0+C1),mul_nonneg hB (add_nonneg hC0 hC1),?_⟩
  intro p
  have h0' : SchwartzMap.seminorm ℂ 0 0 (𝓕 (f p)) ≤ C0*(w p)^(d0+d1) :=
    (h0 p).trans (mul_le_mul_of_nonneg_left
      (pow_le_pow_right₀ (hw p) (Nat.le_add_right d0 d1)) hC0)
  have h1' : SchwartzMap.seminorm ℂ (M+N) 0 (𝓕 (f p)) ≤ C1*(w p)^(d0+d1) :=
    (h1 p).trans (mul_le_mul_of_nonneg_left
      (pow_le_pow_right₀ (hw p) (Nat.le_add_left d1 d0)) hC1)
  have hi := (𝓕 (f p)).integral_pow_mul_iteratedFDeriv_le ℂ volume M 0
  simp only [norm_iteratedFDeriv_zero] at hi
  calc
    _ ≤ B*(SchwartzMap.seminorm ℂ 0 0 (𝓕 (f p)) +
        SchwartzMap.seminorm ℂ (M+N) 0 (𝓕 (f p))) := hi
    _ ≤ B*(C0*(w p)^(d0+d1)+C1*(w p)^(d0+d1)) :=
      mul_le_mul_of_nonneg_left (add_le_add h0' h1') hB
    _ = _ := by ring

theorem fourier_domain_moment_polynomial_of_fixed_support {I : Type*}
    (f : I → SchwartzMap E ℂ) (w : I → ℝ)
    (hw : ∀ p, 1 ≤ w p) (R : ℝ) (hR : 0 ≤ R)
    (hsupport : ∀ p, tsupport (f p) ⊆ Metric.closedBall 0 R)
    (hderiv : ∀ n : ℕ, ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧
      ∀ p x, ‖iteratedFDeriv ℝ n (f p) x‖ ≤ C*(w p)^d)
    (M : ℕ) :
    ∃ d : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ p,
      (∫ ξ : E, ‖ξ‖^M*‖𝓕 (f p) ξ‖) ≤ C*(w p)^d :=
  fourier_domain_moment_polynomial_of_seminorm_bounds f w hw
    (schwartz_domain_seminorm_polynomial_of_fixed_support f w hw R hR hsupport hderiv) M




end Bounty
end

section

/- Exact removal of a designated ordered mark, with no additional factorial or damping factor. -/

open Finset

namespace Bounty

theorem marked_divisor_factor_peel (q V : ℝ) (omega t : ℕ) :
    markedDivisorFactor q V omega (t + 1) =
      (omega : ℝ) / V * markedDivisorFactor q V (omega - 1) t := by
  cases omega with
  | zero => simp [markedDivisorFactor]
  | succ omega =>
    simp only [markedDivisorFactor, Nat.succ_descFactorial_succ,
      Nat.add_sub_add_right, Nat.add_sub_cancel_right, Nat.cast_mul, pow_succ,
      div_eq_mul_inv, mul_inv_rev]
    ring

theorem marked_divisor_factor_remove_prime {G : Type*}
    (P : G → Finset ℕ) (g : G) (hP : ∀ p ∈ P g, p.Prime)
    (q V : ℝ) (n t : ℕ) (hsq : ∀ p ∈ P g, ¬ p ^ 2 ∣ n) :
    markedDivisorFactor q V (physicalOmega P g (n : ℤ)) (t + 1) =
      (1 / V) * ∑ p ∈ P g, if p ∣ n then
        markedDivisorFactor q V (physicalOmega P g ((n / p : ℕ) : ℤ)) t else 0 := by
  classical
  rw [← sum_filter]
  have heq : ∑ p ∈ (P g).filter (fun p => p ∣ n),
      markedDivisorFactor q V (physicalOmega P g ((n / p : ℕ) : ℤ)) t =
      (physicalOmega P g (n : ℤ) : ℝ) *
        markedDivisorFactor q V (physicalOmega P g (n : ℤ) - 1) t := by
    calc
      _ = ∑ _p ∈ (P g).filter (fun p => p ∣ n),
          markedDivisorFactor q V (physicalOmega P g (n : ℤ) - 1) t := by
        apply sum_congr rfl
        intro p hp
        rw [physical_omega_div_simple_prime P g hP (mem_filter.mp hp).1
          (mem_filter.mp hp).2 (hsq p (mem_filter.mp hp).1)]
      _ = _ := by simp [physicalOmega, physicalDivisorPool, Int.natCast_dvd_natCast]
  rw [heq, marked_divisor_factor_peel]
  ring




end Bounty
end

section

/- A common initial-and-event birth allocation independent of every shared-slot pattern. -/

namespace Bounty
section Common
variable {J K : Type*} {N : ℕ} (M : Fin N → ℕ) (B : ℕ)

def fullMixedCommonCapacity : Option (J ⊕ K) → Fin N → ℕ
  | none, _ => 0
  | some (.inl _), _ => B
  | some (.inr _), g => M g

abbrev FullMixedCommonInitialAddress := (g : Fin N) × Fin (M g)

abbrev FullMixedCommonLocalAddress (tag : Option (J ⊕ K)) :=
  (g : Fin N) × Fin (fullMixedCommonCapacity M B tag g)

abbrev FullMixedCommonStepAddress (steps : List (Option (J ⊕ K))) :=
  (i : Fin steps.length) × FullMixedCommonLocalAddress M B (steps.get i)

abbrev FullMixedCommonBirthAddress (steps : List (Option (J ⊕ K))) :=
  FullMixedCommonInitialAddress M ⊕ FullMixedCommonStepAddress M B steps

def fullMixedCommonOwner (steps : List (Option (J ⊕ K))) :
    FullMixedCommonBirthAddress M B steps → Option (Fin steps.length)
  | .inl _ => none
  | .inr a => some a.1

theorem full_mixed_common_birth_card (steps : List (Option (J ⊕ K))) :
    Fintype.card (FullMixedCommonBirthAddress M B steps) =
      (∑ g, M g) + ∑ i : Fin steps.length, ∑ g, fullMixedCommonCapacity M B (steps.get i) g := by
  simp only [FullMixedCommonBirthAddress, FullMixedCommonInitialAddress, FullMixedCommonStepAddress,
    FullMixedCommonLocalAddress, Fintype.card_sum, Fintype.card_sigma, Fintype.card_fin]

theorem full_mixed_common_capacity_le (T : ℕ) (hM : ∀ g, M g ≤ T)
    (tag : Option (J ⊕ K)) (g : Fin N) : fullMixedCommonCapacity M B tag g ≤ max B T := by
  cases tag with
  | none => exact Nat.zero_le _
  | some tag =>
    cases tag with
    | inl j => exact le_max_left _ _
    | inr k => exact (hM g).trans (le_max_right _ _)

theorem full_mixed_common_birth_card_le (T : ℕ) (hM : ∀ g, M g ≤ T)
    (steps : List (Option (J ⊕ K))) :
    Fintype.card (FullMixedCommonBirthAddress M B steps) ≤
      N * T + steps.length * (N * max B T) := by
  rw [full_mixed_common_birth_card]
  apply add_le_add
  · calc
      (∑ g, M g) ≤ ∑ _g : Fin N, T := Finset.sum_le_sum (fun g _ => hM g)
      _ = N * T := by simp
  · calc
      (∑ i : Fin steps.length, ∑ g, fullMixedCommonCapacity M B (steps.get i) g) ≤
          ∑ _i : Fin steps.length, ∑ _g : Fin N, max B T := by
        exact Finset.sum_le_sum (fun i _ => Finset.sum_le_sum
          (fun g _ => full_mixed_common_capacity_le M B T hM (steps.get i) g))
      _ = steps.length * (N * max B T) := by simp

end Common
end Bounty
end

section

/- Optional-label extension commutes with owner-indexed sums and preserves performed status. -/

open Classical
namespace Bounty

theorem optional_birth_extension_performed_iff {A B Z : Type*} (e : A ↪ B)
    (label : A → Option Z) (b : B) :
    (optionalBirthExtension e label b).isSome = true ↔
      ∃ a, e a = b ∧ (label a).isSome = true := by
  constructor
  · intro h
    by_cases hb : ∃ a, e a = b
    · obtain ⟨a, rfl⟩ := hb
      exact ⟨a, rfl, by simpa only [optional_birth_extension_apply] using h⟩
    · rw [optional_birth_extension_none e label b hb] at h
      cases h
  · rintro ⟨a, rfl, ha⟩
    simpa only [optional_birth_extension_apply] using ha

theorem optional_birth_extension_sigma {I Z : Type*} {A B : I → Type*}
    (e : ∀ i, A i ↪ B i) (label : (i : I) × A i → Option Z) (i : I) (b : B i) :
    optionalBirthExtension (Function.Embedding.sigmaMap (Function.Embedding.refl I) e) label ⟨i, b⟩ =
      optionalBirthExtension (e i) (fun a => label ⟨i, a⟩) b := by
  by_cases hb : ∃ a, e i a = b
  · obtain ⟨a, rfl⟩ := hb
    exact (optional_birth_extension_apply
      (Function.Embedding.sigmaMap (Function.Embedding.refl I) e) label ⟨i, a⟩).trans
      (optional_birth_extension_apply (e i) (fun a => label ⟨i, a⟩) a).symm
  · have hg : ¬∃ a, Function.Embedding.sigmaMap (Function.Embedding.refl I) e a = ⟨i, b⟩ := by
      rintro ⟨⟨j, a⟩, ha⟩
      have hj : j = i := congrArg Sigma.fst ha
      subst j
      change (⟨i, e i a⟩ : (j : I) × B j) = ⟨i, b⟩ at ha
      apply hb
      exact ⟨a, by simpa using ha⟩
    rw [optional_birth_extension_none _ _ _ hg, optional_birth_extension_none _ _ _ hb]

end Bounty
end

section

/- An actual nonnegative normalized smooth kernel for local Fourier energy. -/

open MeasureTheory Set
open scoped ContDiff FourierTransform NNReal

namespace Bounty

noncomputable def localMellinKernelBase (x : ℝ) : ℝ :=
  typeIISmoothRho 1 ((16 * Real.pi + 1) * x)

theorem local_mellin_kernel_base_contDiff : ContDiff ℝ ∞ localMellinKernelBase := by
  have h := typeII_smooth_rho_contDiff 1
  unfold localMellinKernelBase
  fun_prop

theorem local_mellin_kernel_base_support {x : ℝ}
    (hx : 2 / (16 * Real.pi + 1) < |x|) : localMellinKernelBase x = 0 := by
  apply typeII_smooth_rho_eq_zero
  intro hx'
  have ha : |(16 * Real.pi + 1) * x| ≤ 2 := by
    exact abs_le.mpr ⟨by linarith [hx'.1], by linarith [hx'.2]⟩
  rw [abs_mul, abs_of_pos (by positivity : 0 < 16 * Real.pi + 1)] at ha
  have hb := (div_lt_iff₀ (by positivity : 0 < 16 * Real.pi + 1)).mp hx
  nlinarith

theorem local_mellin_kernel_base_compact : HasCompactSupport localMellinKernelBase := by
  apply HasCompactSupport.intro (isCompact_Icc : IsCompact
    (Icc (-(2 / (16 * Real.pi + 1))) (2 / (16 * Real.pi + 1))))
  intro x hx
  apply local_mellin_kernel_base_support
  exact lt_of_not_ge (fun h => hx (abs_le.mp h))

theorem local_mellin_kernel_base_nonneg (x : ℝ) : 0 ≤ localMellinKernelBase x :=
  (typeII_smooth_rho_bounds _ _).1

theorem local_mellin_kernel_base_zero : localMellinKernelBase 0 = 1 := by
  apply typeII_smooth_rho_eq_one
  simp

theorem local_mellin_kernel_base_integral_pos : 0 < ∫ x, localMellinKernelBase x :=
  local_mellin_kernel_base_contDiff.continuous.integral_pos_of_hasCompactSupport_nonneg_nonzero
    local_mellin_kernel_base_compact local_mellin_kernel_base_nonneg
    (by rw [local_mellin_kernel_base_zero]; norm_num)

noncomputable def localMellinKernel (x : ℝ) : ℝ :=
  localMellinKernelBase x / ∫ y, localMellinKernelBase y

theorem local_mellin_kernel_contDiff : ContDiff ℝ ∞ localMellinKernel :=
  local_mellin_kernel_base_contDiff.div_const _

theorem local_mellin_kernel_compact : HasCompactSupport localMellinKernel := by
  unfold localMellinKernel
  simp only [div_eq_mul_inv]
  exact local_mellin_kernel_base_compact.mul_right

theorem local_mellin_kernel_nonneg (x : ℝ) : 0 ≤ localMellinKernel x :=
  div_nonneg (local_mellin_kernel_base_nonneg x) local_mellin_kernel_base_integral_pos.le

theorem local_mellin_kernel_integral : (∫ x, localMellinKernel x) = 1 := by
  unfold localMellinKernel
  simp only [div_eq_mul_inv]
  rw [integral_mul_const, mul_inv_cancel₀ local_mellin_kernel_base_integral_pos.ne']

theorem local_mellin_kernel_support {x : ℝ}
    (hx : 2 / (16 * Real.pi + 1) < |x|) : localMellinKernel x = 0 := by
  rw [localMellinKernel, local_mellin_kernel_base_support hx, zero_div]

noncomputable def localMellinKernelSchwartz : SchwartzMap ℝ ℂ :=
  (local_mellin_kernel_compact.comp_left (g := fun x : ℝ => (x : ℂ)) (by simp)).toSchwartzMap
    (Complex.ofRealCLM.contDiff.comp local_mellin_kernel_contDiff)

theorem local_mellin_kernel_lipschitz : ∃ C : ℝ≥0, LipschitzWith C localMellinKernelSchwartz :=
  ContDiff.lipschitzWith_of_hasCompactSupport
    (local_mellin_kernel_compact.comp_left (g := fun x : ℝ => (x : ℂ)) (by simp))
    (Complex.ofRealCLM.contDiff.comp local_mellin_kernel_contDiff) (by simp)

end Bounty
end

section

/- Weighted marked sums are exactly the unweighted mass times their conditional list average. -/

open Finset

namespace Bounty

noncomputable def groupMarkedAverage {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ) (b : GroupMarkedLists P t → ℂ) : ℂ := by
  classical
  exact (Fintype.card (GroupMarkedListsAt P t n) : ℂ)⁻¹ *
    ∑ L : GroupMarkedListsAt P t n, b L.val

noncomputable def weightedGroupMarkedSum {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ) (n : ℤ)
    (b : GroupMarkedLists P t → ℂ) : ℂ := by
  classical
  exact ((∏ g, q ^ (physicalOmega P g n - t g) / V g ^ t g : ℝ) : ℂ) *
    ∑ L : GroupMarkedListsAt P t n, b L.val

theorem weighted_group_marked_sum_eq_average {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ) (n : ℤ)
    (b : GroupMarkedLists P t → ℂ) :
    weightedGroupMarkedSum P q V t n b =
      (markedDivisorWeight univ P q V t n : ℂ) * groupMarkedAverage P t n b := by
  classical
  rw [marked_divisor_weight_eq_fiber_mass, Nat.card_eq_fintype_card]
  unfold weightedGroupMarkedSum groupMarkedAverage
  by_cases hzero : Fintype.card (GroupMarkedListsAt P t n) = 0
  · let : IsEmpty (GroupMarkedListsAt P t n) := Fintype.card_eq_zero_iff.mp hzero
    simp only [Fintype.sum_empty, mul_zero]
  · have hne : (Fintype.card (GroupMarkedListsAt P t n) : ℂ) ≠ 0 := by exact_mod_cast hzero
    push_cast
    field_simp

theorem group_marked_average_norm_le {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ) (b : GroupMarkedLists P t → ℂ)
    {H : ℝ} (hH : 0 ≤ H) (hb : ∀ L : GroupMarkedListsAt P t n, ‖b L.val‖ ≤ H) :
    ‖groupMarkedAverage P t n b‖ ≤ H := by
  classical
  by_cases hz : Fintype.card (GroupMarkedListsAt P t n) = 0
  · simp only [groupMarkedAverage, hz, Nat.cast_zero, inv_zero, zero_mul, norm_zero]
    exact hH
  · have hne : (Fintype.card (GroupMarkedListsAt P t n) : ℝ) ≠ 0 := by exact_mod_cast hz
    unfold groupMarkedAverage
    rw [norm_mul, norm_inv, Complex.norm_natCast]
    calc
      _ ≤ (Fintype.card (GroupMarkedListsAt P t n) : ℝ)⁻¹ *
          ∑ _L : GroupMarkedListsAt P t n, H := by
        apply mul_le_mul_of_nonneg_left _ (by positivity)
        exact (norm_sum_le _ _).trans (sum_le_sum (fun L _ => hb L))
      _ = H := by rw [sum_const, card_univ, nsmul_eq_mul, ← mul_assoc, inv_mul_cancel₀ hne, one_mul]




end Bounty
end

section

/- Uniform weighted bounds through two derivatives on a fixed logarithmic interval. -/

open Real

namespace Bounty

theorem exponential_profile_weighted_bounds (g f : SchwartzMap ℝ ℂ) (j : ℕ) (R : ℝ) :
    ∃ C₀ C₁ C₂ : ℝ, 0 ≤ C₀ ∧ 0 ≤ C₁ ∧ 0 ≤ C₂ ∧
      ∀ v u : ℝ, u ∈ Set.Icc (-R) R →
        (1+v^2)^((j : ℝ)/4)*‖exponentialProfile g f v u‖ ≤ C₀ ∧
        (1+v^2)^((j : ℝ)/4)*‖exponentialProfileFirst g f v u‖ ≤ C₁ ∧
        (1+v^2)^((j : ℝ)/4)*‖exponentialProfileSecond g f v u‖ ≤ C₂ := by
  let a := exp (-R)/(2*Real.pi)
  have ha : 0 < a := by dsimp [a]; positivity
  obtain ⟨B₀,hB₀,hf₀⟩ := schwartz_scaled_polynomial_weight_bound f j 0 ha
  obtain ⟨B₁,hB₁,hf₁⟩ := schwartz_scaled_polynomial_weight_bound (SchwartzMap.derivCLM ℂ ℂ f) j 1 ha
  obtain ⟨B₂,hB₂,hf₂⟩ := schwartz_scaled_polynomial_weight_bound
    (SchwartzMap.derivCLM ℂ ℂ (SchwartzMap.derivCLM ℂ ℂ f)) j 2 ha
  let G₀ := SchwartzMap.seminorm ℂ 0 0 g
  let G₁ := SchwartzMap.seminorm ℂ 0 0 (SchwartzMap.derivCLM ℂ ℂ g)
  let G₂ := SchwartzMap.seminorm ℂ 0 0 (SchwartzMap.derivCLM ℂ ℂ (SchwartzMap.derivCLM ℂ ℂ g))
  have hG₀ : 0 ≤ G₀ := by dsimp [G₀]; positivity
  have hG₁ : 0 ≤ G₁ := by dsimp [G₁]; positivity
  have hG₂ : 0 ≤ G₂ := by dsimp [G₂]; positivity
  refine ⟨G₀*B₀,G₁*B₀+G₀*B₁,G₂*B₀+(G₀+2*G₁)*B₁+G₀*B₂,
    by positivity,by positivity,by positivity,?_⟩
  intro v u hu
  let W := (1+v^2)^((j : ℝ)/4)
  let x := exponentialProfileArgument v u
  have hW : 0 ≤ W := by dsimp [W]; positivity
  have ht : a ≤ exp (-u)/(2*Real.pi) :=
    div_le_div_of_nonneg_right (exp_le_exp.mpr (neg_le_neg hu.2)) (by positivity)
  have hx : exp (-u)/(2*Real.pi)*v = x := by dsimp [x,exponentialProfileArgument]; ring
  have hb₀ : W*‖f x‖ ≤ B₀ := by simpa only [hx,pow_zero,mul_one] using hf₀ _ ht v
  have hb₁ : W* |x| *‖deriv f x‖ ≤ B₁ := by
    simpa only [hx,pow_one,SchwartzMap.derivCLM_apply] using hf₁ _ ht v
  have hb₂ : W* |x|^2*‖deriv (deriv f) x‖ ≤ B₂ := by
    have hh := hf₂ _ ht v
    rw [hx] at hh
    exact hh
  have hg₀ : ‖g u‖ ≤ G₀ := SchwartzMap.norm_le_seminorm ℂ g u
  have hg₁ : ‖deriv g u‖ ≤ G₁ := SchwartzMap.norm_le_seminorm ℂ (SchwartzMap.derivCLM ℂ ℂ g) u
  have hg₂ : ‖deriv (deriv g) u‖ ≤ G₂ :=
    SchwartzMap.norm_le_seminorm ℂ (SchwartzMap.derivCLM ℂ ℂ (SchwartzMap.derivCLM ℂ ℂ g)) u
  have hgc : ‖g u-2*deriv g u‖ ≤ G₀+2*G₁ := by
    calc
      _ ≤ ‖g u‖+‖(2 : ℂ)*deriv g u‖ := norm_sub_le _ _
      _ ≤ _ := by rw [norm_mul]; norm_num only [Complex.norm_ofNat]; gcongr
  refine ⟨?_,?_,?_⟩
  · change W*‖g u*f x‖ ≤ _
    rw [norm_mul]
    calc
      _ = ‖g u‖*(W*‖f x‖) := by ring
      _ ≤ _ := mul_le_mul hg₀ hb₀ (by positivity) hG₀
  · change W*‖deriv g u*f x-g u*(x : ℂ)*deriv f x‖ ≤ _
    calc
      _ ≤ W*(‖deriv g u*f x‖+‖g u*(x : ℂ)*deriv f x‖) :=
        mul_le_mul_of_nonneg_left (norm_sub_le _ _) hW
      _ = ‖deriv g u‖*(W*‖f x‖)+‖g u‖*(W* |x| *‖deriv f x‖) := by
        simp only [norm_mul,Complex.norm_real,Real.norm_eq_abs]; ring
      _ ≤ _ := add_le_add (mul_le_mul hg₁ hb₀ (by positivity) hG₁)
        (mul_le_mul hg₀ hb₁ (by positivity) hG₀)
  · change W*‖deriv (deriv g) u*f x+(g u-2*deriv g u)*(x : ℂ)*deriv f x+
      g u*(x : ℂ)^2*deriv (deriv f) x‖ ≤ _
    calc
      _ ≤ W*(‖deriv (deriv g) u*f x‖+‖(g u-2*deriv g u)*(x : ℂ)*deriv f x‖+
          ‖g u*(x : ℂ)^2*deriv (deriv f) x‖) :=
        mul_le_mul_of_nonneg_left ((norm_add_le _ _).trans
          (add_le_add (norm_add_le _ _) le_rfl)) hW
      _ = ‖deriv (deriv g) u‖*(W*‖f x‖)+‖g u-2*deriv g u‖*(W* |x| *‖deriv f x‖)+
          ‖g u‖*(W* |x|^2*‖deriv (deriv f) x‖) := by
        simp only [norm_mul,norm_pow,Complex.norm_real,Real.norm_eq_abs]; ring
      _ ≤ _ := add_le_add (add_le_add (mul_le_mul hg₂ hb₀ (by positivity) hG₂)
        (mul_le_mul hgc hb₁ (by positivity) (by positivity)))
        (mul_le_mul hg₀ hb₂ (by positivity) hG₀)

end Bounty
end

