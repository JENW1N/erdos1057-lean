open scoped BigOperators Classical ComplexConjugate
noncomputable def finiteCharacterCoefficient {G : Type*} [AddCommGroup G] [Fintype G]
    (f : G → ℂ) (χ : AddChar G ℂ) : ℂ :=
  (Fintype.card G : ℂ)⁻¹ * ∑ x, (starRingEnd ℂ) (χ x) * f x

theorem finite_character_dual_pair_sum {G : Type*} [AddCommGroup G] [Fintype G]
    [DecidableEq G] (x y : G) :
    (∑ χ : AddChar G ℂ, (starRingEnd ℂ) (χ x) * χ y) =
      if x = y then (Fintype.card G : ℂ) else 0 := by
  have ht (χ : AddChar G ℂ) : (starRingEnd ℂ) (χ x) * χ y = χ (y - x) := by
    rw [χ.map_sub_eq_div, div_eq_mul_inv, mul_comm]
    rw [← χ.inv_apply_eq_conj]
  simp_rw [ht]
  rw [AddChar.sum_apply_eq_ite]
  simp only [sub_eq_zero, eq_comm]

theorem finite_character_expansion {G : Type*} [AddCommGroup G] [Fintype G]
    [DecidableEq G] (f : G → ℂ) (y : G) :
    (∑ χ : AddChar G ℂ, finiteCharacterCoefficient f χ * χ y) = f y := by
  have hN : (Fintype.card G : ℂ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  calc
    _ = (Fintype.card G : ℂ)⁻¹ *
        ∑ x, f x * ∑ χ : AddChar G ℂ, (starRingEnd ℂ) (χ x) * χ y := by
      simp only [finiteCharacterCoefficient, Finset.mul_sum, Finset.sum_mul]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro x _
      apply Finset.sum_congr rfl
      intro χ _
      ring
    _ = f y := by
      simp_rw [finite_character_dual_pair_sum]
      simp [hN, mul_ite, mul_left_comm]

theorem finite_character_coefficient_as_inner {G : Type*} [AddCommGroup G] [Fintype G]
    (f : G → ℂ) (χ : AddChar G ℂ) :
    finiteCharacterCoefficient f χ =
      inner ℂ (finiteMeasureVector (fun _ : G => (Fintype.card G : ℝ)⁻¹) χ)
        (finiteMeasureVector (fun _ : G => (Fintype.card G : ℝ)⁻¹) f) := by
  rw [finite_measure_vector_inner _ (fun _ => by positivity)]
  simp only [finiteCharacterCoefficient, Complex.ofReal_inv, Complex.ofReal_natCast,
    Finset.mul_sum, mul_assoc]

theorem finite_character_weighted_inner {G : Type*} [AddCommGroup G] [Fintype G]
    (χ ψ : AddChar G ℂ) :
    inner ℂ (finiteMeasureVector (fun _ : G => (Fintype.card G : ℝ)⁻¹) χ)
      (finiteMeasureVector (fun _ : G => (Fintype.card G : ℝ)⁻¹) ψ) =
      if χ = ψ then 1 else 0 := by
  rw [finite_measure_vector_inner _ (fun _ => by positivity)]
  have h := AddChar.wInner_cWeight_eq_boole χ ψ
  simpa only [RCLike.wInner_cWeight_eq_expect, Fintype.expect_eq_sum_div_card,
    RCLike.inner_apply, div_eq_mul_inv, Finset.sum_mul, Finset.mul_sum, mul_comm, mul_left_comm,
    mul_assoc, Complex.ofReal_inv, Complex.ofReal_natCast] using h

theorem finite_character_coefficient_energy {G : Type*} [AddCommGroup G] [Fintype G]
    (f : G → ℂ) :
    (∑ χ : AddChar G ℂ, ‖finiteCharacterCoefficient f χ‖ ^ 2) ≤
      (Fintype.card G : ℝ)⁻¹ * ∑ x, ‖f x‖ ^ 2 := by
  have hrow (χ : AddChar G ℂ) :
      (∑ ψ : AddChar G ℂ,
        ‖inner ℂ (finiteMeasureVector (fun _ : G => (Fintype.card G : ℝ)⁻¹) χ)
          (finiteMeasureVector (fun _ : G => (Fintype.card G : ℝ)⁻¹) ψ)‖) ≤ 1 := by
    simp only [finite_character_weighted_inner, apply_ite, norm_one, norm_zero]
    simp
  have he := finite_gram_row_analysis_sq _ (by norm_num : (0 : ℝ) ≤ 1) hrow
    (finiteMeasureVector (fun _ : G => (Fintype.card G : ℝ)⁻¹) f)
  have hμ : ∀ _x : G, 0 ≤ (Fintype.card G : ℝ)⁻¹ := fun _ => by positivity
  rw [finite_measure_vector_norm_sq _ hμ] at he
  simpa only [← finite_character_coefficient_as_inner, one_mul, Finset.mul_sum] using he

theorem finite_character_coefficient_l1 {G : Type*} [AddCommGroup G] [Fintype G]
    (f : G → ℂ) (hf : ∀ x, ‖f x‖ ≤ 1) :
    (∑ χ : AddChar G ℂ, ‖finiteCharacterCoefficient f χ‖) ≤
      Real.sqrt (Fintype.card G : ℝ) := by
  have hN : (Fintype.card G : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have he : (∑ χ : AddChar G ℂ, ‖finiteCharacterCoefficient f χ‖ ^ 2) ≤ 1 := by
    apply (finite_character_coefficient_energy f).trans
    calc
      _ ≤ (Fintype.card G : ℝ)⁻¹ * ∑ _x : G, (1 : ℝ) := by
        gcongr with x
        exact (pow_le_pow_left₀ (norm_nonneg _) (hf x) 2).trans_eq (one_pow 2)
      _ = 1 := by simp [hN]
  have hcs := Finset.sum_mul_sq_le_sq_mul_sq Finset.univ
    (fun χ : AddChar G ℂ => ‖finiteCharacterCoefficient f χ‖) (fun _ => (1 : ℝ))
  simp only [mul_one, one_pow, Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
    mul_one, AddChar.card_eq] at hcs
  have hb : (∑ χ : AddChar G ℂ, ‖finiteCharacterCoefficient f χ‖) ^ 2 ≤
      (Fintype.card G : ℝ) := hcs.trans (by simpa only [one_mul] using mul_le_mul_of_nonneg_right he (Nat.cast_nonneg (Fintype.card G) : (0 : ℝ) ≤ _))
  exact (Real.le_sqrt (Finset.sum_nonneg (fun _ _ => norm_nonneg _)) (Nat.cast_nonneg _)).mpr hb
end

