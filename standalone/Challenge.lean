section

/- Arbitrary logarithmic error bounds for the ordinary prime-number theorem. -/

open Filter Asymptotics

section

open Complex MeasureTheory Set Filter
open scoped Topology

namespace Bounty.OrdinaryZetaBounds

theorem lower_re_two (s : ℂ) (hs : s.re = 2) : 1 / 3 ≤ ‖riemannZeta s‖ := by
  let f : ℕ → ℂ := fun n => ArithmeticFunction.moebius n
  have hb := OAI.Ostmann.lSeries_norm_bound_re_two f
    (fun n _ => by dsimp [f]; norm_cast; exact ArithmeticFunction.abs_moebius_le_one) s hs
  have he : riemannZeta s * LSeries f s = 1 := by
    have hsr : 1 < s.re := by rw [hs]; norm_num
    rw [← LSeries_one_eq_riemannZeta hsr]
    exact LSeries_one_mul_Lseries_moebius hsr
  have hn := congrArg norm he
  rw [norm_mul, norm_one] at hn
  have hpi : Real.pi ^ 2 / 6 ≤ 3 := by nlinarith [Real.pi_lt_four, Real.pi_pos]
  have hm := mul_le_mul_of_nonneg_left (hb.trans hpi) (norm_nonneg (riemannZeta s))
  rw [hn] at hm
  linarith

theorem upper (s : ℂ) (hre : 1 / 2 ≤ s.re) (him : 1 ≤ |s.im|) :
    ‖riemannZeta s‖ ≤ 3 + 2 * ‖s‖ := by
  have hs0 : s ≠ 0 := by intro h; norm_num [h] at hre
  have hs1 : s ≠ 1 := by intro h; norm_num [h] at him
  have hsrepr : (s.re : ℂ) + s.im * I = s := by apply Complex.ext <;> simp
  have hint := ZetaBnd_aux1b 1 (by norm_num) (σ := s.re) (t := s.im)
    (show 0 < s.re by linarith)
  simp only [Nat.cast_one, Real.one_rpow, hsrepr] at hint
  have hden : 1 ≤ ‖1 - s‖ := by
    have h := Complex.abs_im_le_norm (1 - s)
    simp only [sub_im, one_im, zero_sub, abs_neg] at h
    exact him.trans h
  have hnorm : ‖(-1 : ℂ) / (1 - s)‖ ≤ 1 := by
    rw [norm_div, norm_neg, norm_one]
    exact (div_le_one (by linarith)).mpr hden
  rw [← Zeta0EqZeta (N := 1) (by norm_num) (by linarith) hs1, riemannZeta0]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, zero_add, Nat.cast_zero,
    Nat.cast_one, Complex.zero_cpow hs0, div_zero, Complex.one_cpow,
    div_one, zero_add]
  have h := norm_add_le ((1 : ℂ) + -1 / (1 - s) + -1 / 2)
    (s * ∫ x in Ioi (1 : ℝ), (⌊x⌋ + 1 / 2 - x) / (x : ℂ) ^ (s + 1))
  have h1 := norm_add_le ((1 : ℂ) + -1 / (1 - s)) (-1 / 2)
  have h2 := norm_add_le (1 : ℂ) (-1 / (1 - s))
  have hmul := mul_le_mul_of_nonneg_left hint (norm_nonneg s)
  have hinv : 1 / s.re ≤ 2 := (div_le_iff₀ (by linarith)).mpr (by linarith)
  have hmul2 := mul_le_mul_of_nonneg_left hinv (norm_nonneg s)
  norm_num [norm_mul] at h h1 h2 hnorm ⊢
  nlinarith

theorem logDeriv_bound (s : ℂ) (hre : (47 / 48 : ℝ) ≤ s.re)
    (hre2 : s.re ≤ 2) (him : 3 < |s.im|) :
    ‖logDeriv riemannZeta s‖ ≤ 19200 * Real.log (24 * (|s.im| + 2)) := by
  let c : ℂ := 2 + s.im * I
  let g : ℂ → ℂ := fun z => riemannZeta (z + c)
  let A : ℝ := Real.log (24 * (|s.im| + 2))
  have hc : c.re = 2 := by simp [c]
  have hci : c.im = s.im := by simp [c]
  have hne1 (z : ℂ) (hz : z ∈ Metric.ball 0 (25 / 24 : ℝ)) : z + c ≠ 1 := by
    have hn : ‖z‖ < 25 / 24 := by simpa only [Metric.mem_ball, dist_zero_right] using hz
    have hi := Complex.abs_im_le_norm z
    intro h
    have hi0 := congrArg Complex.im h
    simp only [add_im, hci, one_im] at hi0
    have : |s.im| = |z.im| := by rw [show s.im = -z.im by linarith, abs_neg]
    linarith
  have hrez (z : ℂ) (hz : z ∈ Metric.ball 0 (25 / 24 : ℝ)) :
      (23 / 24 : ℝ) < (z + c).re := by
    have hn : ‖z‖ < 25 / 24 := by simpa only [Metric.mem_ball, dist_zero_right] using hz
    have hl := (abs_le.mp (Complex.abs_re_le_norm z)).1
    simp only [add_re, hc]
    linarith
  have hne (z : ℂ) (hz : z ∈ Metric.ball 0 (25 / 24 : ℝ)) : g z ≠ 0 :=
    OAI.ShortDraft.riemannZeta_ne_zero_of_re_gt (z + c) (hrez z hz) (hne1 z hz)
  have hg : AnalyticOnNhd ℂ g (Metric.ball 0 (25 / 24 : ℝ)) := by
    intro z hz
    exact (analyticAt_riemannZeta (hne1 z hz)).comp (f := fun w : ℂ => w + c) (by fun_prop)
  have hnorm (z : ℂ) (hz : z ∈ Metric.ball 0 (25 / 24 : ℝ)) :
      ‖g z‖ ≤ 8 * (|s.im| + 2) := by
    have hn : ‖z‖ < 25 / 24 := by simpa only [Metric.mem_ball, dist_zero_right] using hz
    have hcN : ‖c‖ ≤ 2 + |s.im| := by
      simpa [c] using norm_add_le (2 : ℂ) ((s.im : ℂ) * I)
    have himz : 1 ≤ |(z + c).im| := by
      have hi := abs_add_le (z.im + s.im) (-z.im)
      have hid : z.im + s.im + -z.im = s.im := by ring
      rw [hid, abs_neg] at hi
      have hi2 := Complex.abs_im_le_norm z
      simp only [add_im, hci]
      linarith
    have hu := upper (z + c) (by linarith [hrez z hz]) himz
    have ha := norm_add_le z c
    dsimp only [g]
    linarith
  have hA : 0 < A := by apply Real.log_pos; linarith [abs_nonneg s.im]
  have hlog (z : ℂ) (hz : z ∈ Metric.ball 0 (25 / 24 : ℝ)) :
      Real.log ‖g z‖ - Real.log ‖g 0‖ ≤ A := by
    have h0 : 1 / 3 ≤ ‖g 0‖ := by simpa [g] using lower_re_two c hc
    have h0p : 0 < ‖g 0‖ := by linarith
    have hzp : 0 < ‖g z‖ := norm_pos_iff.mpr (hne z hz)
    rw [← Real.log_div (ne_of_gt hzp) (ne_of_gt h0p)]
    apply Real.log_le_log (div_pos hzp h0p)
    apply (div_le_iff₀ h0p).mpr
    have hm := mul_le_mul_of_nonneg_left h0
      (show 0 ≤ 24 * (|s.im| + 2) by positivity)
    nlinarith [hnorm z hz]
  have hw : ‖s - c‖ ≤ (25 / 24 : ℝ) - 1 / 48 := by
    have he : s - c = ((s.re - 2 : ℝ) : ℂ) := by apply Complex.ext <;> simp [c]
    rw [he, norm_real, Real.norm_eq_abs, abs_of_nonpos (by linarith)]
    linarith
  have hb := Bounty.logDeriv_norm_le_margin_disk g (25 / 24) A (1 / 48)
    (by norm_num) hA (by norm_num) hg hne hlog (s - c) hw
  have hcomp : logDeriv g (s - c) = logDeriv riemannZeta s := by
    have hd := logDeriv_comp (f := riemannZeta) (g := fun z : ℂ => z + c)
      (x := s - c) (differentiableAt_riemannZeta (by
        simpa using hne1 (s-c) (by
          rw [Metric.mem_ball, dist_zero_right]
          linarith))) (by fun_prop)
    simpa [g, Function.comp_def] using hd
  rw [hcomp] at hb
  convert hb using 1 <;> dsimp [A] <;> ring

end Bounty.OrdinaryZetaBounds

end

section

/- A coefficient-level Riesz inversion shared by the principal and character cases. -/

open Complex MeasureTheory OAI.Ostmann
open scoped Topology

namespace Bounty

theorem riesz_mean_eq_vertical_lseries (a : ℕ → ℂ) (ha0 : a 0 = 0)
    (X σ : ℝ) (hX : 0 < X) (hσ : 1 ≤ σ) (ha : LSeriesSummable a (σ : ℂ)) :
    (∑' n : ℕ, a n * rieszPrimeTest (n / X)) =
      ((1 / (2 * Real.pi) : ℝ) : ℂ) * ∫ t : ℝ,
        LSeries a (rieszMellinLine σ t) * rieszVerticalWeight X σ t := by
  let F : ℕ → ℝ → ℂ := fun n t =>
    LSeries.term a (rieszMellinLine σ t) n * rieszVerticalWeight X σ t
  have hnorm (n : ℕ) (t : ℝ) :
      ‖F n t‖ = ‖LSeries.term a (σ : ℂ) n‖ * ‖rieszVerticalWeight X σ t‖ := by
    simp [F, norm_mul, LSeries.norm_term_eq, rieszMellinLine]
  have hcont (n : ℕ) : Continuous (fun t => LSeries.term a (rieszMellinLine σ t) n) := by
    by_cases hn : n = 0
    · subst n
      simp only [LSeries.term_zero]
      exact continuous_const
    · simp only [LSeries.term_of_ne_zero hn]
      exact continuous_const.div ((rieszMellinLine_continuous σ).const_cpow
        (.inl (by exact_mod_cast hn))) (fun _ => Complex.cpow_ne_zero_iff.mpr
          (.inl (by exact_mod_cast hn)))
  have hint (n : ℕ) : Integrable (F n) := by
    apply ((rieszVerticalWeight_integrable X σ hX hσ).norm.const_mul
      ‖LSeries.term a (σ : ℂ) n‖).mono'
    · exact ((hcont n).mul (rieszVerticalWeight_continuous X σ hX (by linarith))).aestronglyMeasurable
    · exact Filter.Eventually.of_forall (fun t => (hnorm n t).le)
  have hsum : Summable (fun n => ∫ t : ℝ, ‖F n t‖) := by
    apply (ha.norm.mul_right (∫ t : ℝ, ‖rieszVerticalWeight X σ t‖)).congr
    intro n
    simp only [hnorm, integral_const_mul]
  have hinv (n : ℕ) : ((1 / (2 * Real.pi) : ℝ) : ℂ) *
      (∫ t : ℝ, F n t) = a n * rieszPrimeTest (n / X) := by
    by_cases hn : n = 0
    · subst n
      simp [F, ha0]
    have hnR : 0 < (n : ℝ) := by exact_mod_cast Nat.pos_of_ne_zero hn
    have hkernel (t : ℝ) : F n t = a n *
        (((n : ℝ) / X : ℝ) : ℂ) ^ (-rieszMellinLine σ t) *
          rieszMellinKernel (rieszMellinLine σ t) := by
      dsimp only [F]
      rw [LSeries.term_of_ne_zero hn, rieszVerticalWeight,
        Complex.cpow_neg, Complex.ofReal_div,
        Complex.div_cpow_ofReal_nonneg hnR.le hX.le, inv_div]
      push_cast
      ring
    simp_rw [hkernel, mul_assoc]
    rw [integral_const_mul]
    have h := rieszPrimeTest_mellin_inversion σ ((n : ℝ) / X) hσ (div_pos hnR hX)
    change ((1 / (2 * Real.pi) : ℝ) : ℂ) * (∫ t : ℝ,
      (((n : ℝ) / X : ℝ) : ℂ) ^ (-rieszMellinLine σ t) *
        rieszMellinKernel (rieszMellinLine σ t)) = _ at h
    rw [← h]
    ring
  calc
    _ = ∑' n : ℕ, ((1 / (2 * Real.pi) : ℝ) : ℂ) * ∫ t : ℝ, F n t :=
      tsum_congr (fun n => (hinv n).symm)
    _ = ((1 / (2 * Real.pi) : ℝ) : ℂ) * ∑' n : ℕ, ∫ t : ℝ, F n t := tsum_mul_left
    _ = ((1 / (2 * Real.pi) : ℝ) : ℂ) * ∫ t : ℝ, ∑' n : ℕ, F n t := by
      rw [integral_tsum_of_summable_integral_norm hint hsum]
    _ = _ := by
      congr 1
      apply integral_congr_ae
      filter_upwards with t
      exact tsum_mul_right

noncomputable def ordinaryRieszMean (X : ℝ) : ℂ :=
  ∑' n : ℕ, (ArithmeticFunction.vonMangoldt n : ℂ) * rieszPrimeTest (n / X)

theorem ordinaryRieszMean_eq_vertical_logDerivative (X σ : ℝ)
    (hX : 0 < X) (hσ : 1 < σ) :
    ordinaryRieszMean X = ((1 / (2 * Real.pi) : ℝ) : ℂ) * ∫ t : ℝ,
      (-logDeriv riemannZeta (rieszMellinLine σ t)) * rieszVerticalWeight X σ t := by
  rw [ordinaryRieszMean, riesz_mean_eq_vertical_lseries _ (by simp) X σ hX hσ.le
    (ArithmeticFunction.LSeriesSummable_vonMangoldt (by simpa using hσ))]
  congr 1
  apply integral_congr_ae
  filter_upwards with t
  rw [ArithmeticFunction.LSeries_vonMangoldt_eq_deriv_riemannZeta_div
    (by simpa [rieszMellinLine] using hσ)]
  simp only [logDeriv_apply, neg_div]

end Bounty

end

section

/- Pole cancellation and Riesz contour estimates for the principal zeta function.
The final bound has the explicit large-height zeta estimate as an argument;
it is supplied by the separately checked fixed-region probe. -/

open Complex Set Filter MeasureTheory DirichletCharacter
open scoped Topology

namespace ThirdZetaContour

noncomputable def regularizedZeta : ℂ → ℂ := LFunctionTrivChar₁ 1

theorem regularizedZeta_apply {s : ℂ} (hs : s ≠ 1) :
    regularizedZeta s = (s - 1) * riemannZeta s := by
  simp only [regularizedZeta, LFunctionTrivChar₁, Function.update_of_ne hs,
    LFunctionTrivChar, LFunction_modOne_eq]

theorem regularizedZeta_ne_zero (s : ℂ) (hs : (23 / 24 : ℝ) < s.re) :
    regularizedZeta s ≠ 0 := by
  by_cases h : s = 1
  · subst s
    exact LFunctionTrivChar₁_apply_one_ne_zero 1
  · rw [regularizedZeta_apply h]
    exact mul_ne_zero (sub_ne_zero.mpr h)
      (OAI.ShortDraft.riemannZeta_ne_zero_of_re_gt s hs h)

noncomputable def centeredLogDerivative (s : ℂ) : ℂ := -logDeriv regularizedZeta s

theorem centeredLogDerivative_analytic :
    AnalyticOnNhd ℂ centeredLogDerivative {s : ℂ | (23 / 24 : ℝ) < s.re} := by
  intro s hs
  have hF : AnalyticAt ℂ regularizedZeta s :=
    (differentiable_LFunctionTrivChar₁ 1).analyticAt s
  exact (hF.deriv.div hF (regularizedZeta_ne_zero s hs)).neg

theorem centeredLogDerivative_eq {s : ℂ} (hs : s ≠ 1)
    (hre : (23 / 24 : ℝ) < s.re) :
    centeredLogDerivative s = -logDeriv riemannZeta s - 1 / (s - 1) := by
  have hn := OAI.ShortDraft.riemannZeta_ne_zero_of_re_gt s hre hs
  have hd : deriv regularizedZeta s =
      (s - 1) * deriv riemannZeta s + riemannZeta s := by
    simpa only [regularizedZeta, LFunctionTrivChar, LFunction_modOne_eq] using
      deriv_LFunctionTrivChar₁_apply_of_ne_one 1 hs
  simp only [centeredLogDerivative, logDeriv_apply, hd, regularizedZeta_apply hs]
  field_simp
  <;> ring

theorem centeredRiesz_rectangle_zero (X : ℝ) (hX : 0 < X)
    (a b c d : ℝ) (ha : (23 / 24 : ℝ) < a) (hab : a ≤ b) :
    OAI.Ostmann.rectangleBoundaryIntegral
      (fun s => centeredLogDerivative s * OAI.Ostmann.rieszContourWeight X s)
      a b c d = 0 := by
  apply OAI.Ostmann.rectangleBoundaryIntegral_eq_zero
  intro s hs
  have hsa : a ≤ s.re := ((uIcc_of_le hab) ▸ hs.1).1
  exact (centeredLogDerivative_analytic s (ha.trans_le hsa)).mul
    (OAI.Ostmann.rieszContourWeight_analyticAt X hX s (by linarith))


open OAI.Ostmann
open scoped Interval

theorem riesz_horizontal_bound (f : ℂ → ℂ)
    (X a b t M : ℝ) (hX : 1 ≤ X) (hab : a ≤ b) (ht : 0 < |t|) (hM : 0 ≤ M)
    (hb : ∀ σ ∈ Icc a b, ‖f ((σ : ℂ) + (t : ℂ) * I)‖ ≤ M) :
    ‖∫ σ in a..b, f ((σ : ℂ) + (t : ℂ) * I) *
        rieszContourWeight X ((σ : ℂ) + (t : ℂ) * I)‖ ≤
      (M * X ^ b / t ^ 2) * (b - a) := by
  have hXp : 0 < X := by linarith
  have hpoint : ∀ σ ∈ Ι a b,
      ‖f ((σ : ℂ) + (t : ℂ) * I) *
        rieszContourWeight X ((σ : ℂ) + (t : ℂ) * I)‖ ≤ M * X ^ b / t ^ 2 := by
    intro σ hσ
    have hσ' : σ ∈ Icc a b := by
      have hh := uIoc_subset_uIcc hσ
      rwa [uIcc_of_le hab] at hh
    have hk := rieszMellinKernel_im_bound ((σ : ℂ) + (t : ℂ) * I) (by simpa using ht)
    simp only [Complex.add_im, Complex.ofReal_im, Complex.mul_im, Complex.ofReal_re,
      Complex.I_im, mul_one, Complex.I_re, mul_zero, add_zero, zero_add, sq_abs] at hk
    have hx : X ^ σ ≤ X ^ b := Real.rpow_le_rpow_of_exponent_le hX hσ'.2
    rw [norm_mul, rieszContourWeight, norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos hXp]
    simp only [Complex.add_re, Complex.ofReal_re, Complex.mul_re, Complex.I_re,
      mul_zero, Complex.ofReal_im, Complex.I_im, zero_mul, sub_zero, add_zero]
    have hh := mul_le_mul (hb σ hσ') (mul_le_mul hx hk (norm_nonneg _) (Real.rpow_nonneg hXp.le _))
      (by positivity) hM
    exact hh.trans_eq (by ring)
  have hi := intervalIntegral.norm_integral_le_of_norm_le_const hpoint
  simpa only [abs_of_nonneg (sub_nonneg.mpr hab)] using hi

theorem riesz_left_bound : ∃ K : ℝ, 0 < K ∧
    ∀ (f : ℂ → ℂ) (X a T M : ℝ), 0 < X → 1 / 2 ≤ a → 0 ≤ M →
      (∀ t ∈ Icc (-T) T, ‖f (rieszMellinLine a t)‖ ≤ M) →
      ‖∫ t in Icc (-T) T, f (rieszMellinLine a t) * rieszVerticalWeight X a t‖ ≤
        K * M * X ^ a := by
  let J := ∫ t : ℝ, rieszLineMajorant t
  have hJ : 0 ≤ J := integral_nonneg rieszLineMajorant_nonneg
  refine ⟨J + 1, by linarith, ?_⟩
  intro f X a T M hX ha hM hb
  have hg : Integrable (fun t : ℝ => (M * X ^ a) * rieszLineMajorant t) :=
    rieszLineMajorant_integrable.const_mul _
  have hnorm : ‖∫ t in Icc (-T) T, f (rieszMellinLine a t) * rieszVerticalWeight X a t‖ ≤
      ∫ t in Icc (-T) T, (M * X ^ a) * rieszLineMajorant t := by
    apply norm_integral_le_of_norm_le hg.integrableOn
    filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
    have hk := rieszMellinKernel_half_strip (rieszMellinLine a t) (by simpa [rieszMellinLine] using ha)
    simp only [rieszMellinLine, Complex.add_im, Complex.ofReal_im, Complex.mul_im,
      Complex.ofReal_re, Complex.I_im, mul_one, Complex.I_re, mul_zero, add_zero,
      zero_add] at hk
    rw [norm_mul, rieszVerticalWeight_norm X a t hX]
    have hh := mul_le_mul (hb t ht) (mul_le_mul_of_nonneg_left hk (Real.rpow_nonneg hX.le a))
      (by positivity) hM
    exact hh.trans_eq (by ring)
  have hfull := setIntegral_le_integral hg
    (Filter.Eventually.of_forall (fun t => mul_nonneg (by positivity) (rieszLineMajorant_nonneg t)))
    (s := Icc (-T) T)
  simp only [integral_const_mul] at hnorm hfull
  apply (hnorm.trans hfull).trans
  dsimp only [J] at hJ ⊢
  nlinarith [mul_nonneg hM (Real.rpow_nonneg hX.le a)]

theorem centeredRiesz_rectangle_bound : ∃ K : ℝ, 0 < K ∧
    ∀ (X a b T M : ℝ), 1 ≤ X → (23 / 24 : ℝ) < a → a ≤ b →
      0 < T → 0 ≤ M →
      (∀ z ∈ uIcc a b ×ℂ uIcc (-T) T, ‖centeredLogDerivative z‖ ≤ M) →
      ‖∫ t in -T..T, centeredLogDerivative (rieszMellinLine b t) * rieszVerticalWeight X b t‖ ≤
        K * M * X ^ a + 2 * (M * X ^ b / T ^ 2) * (b - a) := by
  obtain ⟨K,hK,hleft⟩ := riesz_left_bound
  refine ⟨K,hK,?_⟩
  intro X a b T M hX ha hab hT hM hb
  have hXp : 0 < X := by linarith
  have hpoint (σ t : ℝ) (hσ : σ ∈ Icc a b) (ht : t ∈ Icc (-T) T) :
      ‖centeredLogDerivative ((σ : ℂ) + (t : ℂ) * I)‖ ≤ M := by
    apply hb _ ⟨?_,?_⟩
    · simpa [uIcc_of_le hab] using hσ
    · simpa [uIcc_of_le (by linarith : -T ≤ T)] using ht
  have hl := hleft centeredLogDerivative X a T M hXp (by linarith) hM
    (fun t ht => hpoint a t ⟨le_rfl,hab⟩ ht)
  have hl' :
      ‖∫ t in -T..T, centeredLogDerivative (rieszMellinLine a t) * rieszVerticalWeight X a t‖ ≤
        K * M * X ^ a := by
    simpa only [intervalIntegral.integral_of_le (by linarith : -T ≤ T),
      integral_Icc_eq_integral_Ioc] using hl
  have hu := riesz_horizontal_bound centeredLogDerivative X a b T M hX hab
    (by rwa [abs_of_pos hT]) hM (fun σ hσ => hpoint σ T hσ ⟨by linarith,le_rfl⟩)
  have hd := riesz_horizontal_bound centeredLogDerivative X a b (-T) M hX hab
    (by rwa [abs_neg,abs_of_pos hT]) hM (fun σ hσ => hpoint σ (-T) hσ ⟨le_rfl,by linarith⟩)
  rw [neg_sq] at hd
  have hz := centeredRiesz_rectangle_zero X hXp a b (-T) T ha hab
  have hv := rectangle_vertical_shift_norm_bound _ a b (-T) T hz
  change ‖∫ t in -T..T, centeredLogDerivative (rieszMellinLine b t) * rieszVerticalWeight X b t‖ ≤
    ‖∫ t in -T..T, centeredLogDerivative (rieszMellinLine a t) * rieszVerticalWeight X a t‖ + _ + _ at hv
  linarith


theorem scalar_vertical_inversion (X σ : ℝ) (hX : 0 < X) (hσ : 1 ≤ σ) :
    ((1 / (2 * Real.pi) : ℝ) : ℂ) * (∫ t : ℝ, rieszVerticalWeight X σ t) =
      rieszPrimeTest (1 / X) := by
  have hi := rieszPrimeTest_mellin_inversion σ (1 / X) hσ (by positivity)
  change ((1 / (2 * Real.pi) : ℝ) : ℂ) * (∫ t : ℝ,
    ((1 / X : ℝ) : ℂ) ^ (-rieszMellinLine σ t) *
      rieszMellinKernel (rieszMellinLine σ t)) = _ at hi
  simpa only [one_div, Complex.ofReal_inv, Complex.inv_cpow_ofReal_nonneg hX.le,
    Complex.cpow_neg, inv_inv, rieszVerticalWeight] using hi

noncomputable def poleVerticalIntegrand (X t : ℝ) : ℂ :=
  (1 / (rieszMellinLine 2 t - 1)) * rieszVerticalWeight X 2 t

theorem poleVerticalIntegrand_eq (X t : ℝ) (hX : 0 < X) :
    poleVerticalIntegrand X t =
      ((X : ℂ) * rieszVerticalWeight X 1 t - rieszVerticalWeight X 2 t) / 2 := by
  have he : rieszMellinLine 2 t = rieszMellinLine 1 t + 1 := by
    unfold rieszMellinLine
    push_cast
    ring
  have hn0 : rieszMellinLine 1 t ≠ 0 := by
    intro h
    have := congrArg Complex.re h
    norm_num [rieszMellinLine] at this
  have hn1 : rieszMellinLine 1 t + 1 ≠ 0 := by
    intro h
    have := congrArg Complex.re h
    norm_num [rieszMellinLine] at this
  have hn2 : rieszMellinLine 1 t + 1 + 1 ≠ 0 := by
    intro h
    have := congrArg Complex.re h
    norm_num [rieszMellinLine] at this
  simp only [poleVerticalIntegrand, rieszVerticalWeight, he, add_sub_cancel_right,
    Complex.cpow_add _ _ (by exact_mod_cast hX.ne' : (X : ℂ) ≠ 0),
    Complex.cpow_one, rieszMellinKernel]
  field_simp
  <;> ring

theorem poleVerticalIntegrand_integrable (X : ℝ) (hX : 0 < X) :
    Integrable (poleVerticalIntegrand X) := by
  have h := ((rieszVerticalWeight_integrable X 1 hX le_rfl).const_mul (X : ℂ)).sub
    (rieszVerticalWeight_integrable X 2 hX (by norm_num))
  convert h.div_const (2 : ℂ) using 1
  funext t
  exact poleVerticalIntegrand_eq X t hX

theorem pole_vertical_integral (X : ℝ) (hX : 1 ≤ X) :
    ((1 / (2 * Real.pi) : ℝ) : ℂ) * (∫ t : ℝ, poleVerticalIntegrand X t) =
      (X : ℂ) / 2 - 1 + 1 / (2 * X) := by
  have hXp : 0 < X := by linarith
  have hi1 := scalar_vertical_inversion X 1 hXp le_rfl
  have hi2 := scalar_vertical_inversion X 2 hXp (by norm_num)
  have hfun : poleVerticalIntegrand X =
      fun t => ((X : ℂ) * rieszVerticalWeight X 1 t - rieszVerticalWeight X 2 t) / 2 :=
    funext (fun t => poleVerticalIntegrand_eq X t hXp)
  rw [hfun, integral_div, integral_sub
    ((rieszVerticalWeight_integrable X 1 hXp le_rfl).const_mul (X : ℂ))
    (rieszVerticalWeight_integrable X 2 hXp (by norm_num)), integral_const_mul]
  have ht0 : 0 ≤ 1 - 1 / X := sub_nonneg.mpr ((div_le_one hXp).mpr hX)
  have ht : rieszPrimeTest (1 / X) = (1 : ℂ) - 1 / X := by
    unfold rieszPrimeTest
    simp only [max_eq_left ht0, Complex.ofReal_sub,
      Complex.ofReal_one, Complex.ofReal_div]
  rw [ht] at hi1 hi2
  calc
    _ = ((X : ℂ) * (((1 / (2 * Real.pi) : ℝ) : ℂ) * ∫ t : ℝ, rieszVerticalWeight X 1 t) -
      (((1 / (2 * Real.pi) : ℝ) : ℂ) * ∫ t : ℝ, rieszVerticalWeight X 2 t)) / 2 := by ring
    _ = _ := by
      rw [hi1,hi2]
      field_simp [show (X : ℂ) ≠ 0 by exact_mod_cast hXp.ne']
      <;> ring


theorem centered_right_bound : ∃ N : ℝ, 0 < N ∧
    ∀ t : ℝ, ‖centeredLogDerivative (rieszMellinLine 2 t)‖ ≤ N := by
  let D : ℝ := ‖deriv riemannZeta 2 / riemannZeta 2‖
  refine ⟨D + 1, by dsimp [D]; positivity, ?_⟩
  intro t
  have hs : rieszMellinLine 2 t ≠ 1 := by
    intro h
    have := congrArg Complex.re h
    norm_num [rieszMellinLine] at this
  rw [centeredLogDerivative_eq hs (by norm_num [rieszMellinLine])]
  have hb := dlog_riemannZeta_bdd_on_vertical_lines_generalized 2 2 t (by norm_num) le_rfl
  rw [neg_div,norm_neg] at hb
  change ‖logDeriv riemannZeta (rieszMellinLine 2 t)‖ ≤ D at hb
  have hden : 1 ≤ ‖rieszMellinLine 2 t - 1‖ := by
    have h := Complex.re_le_norm (rieszMellinLine 2 t - 1)
    norm_num [rieszMellinLine] at h
    change 1 ≤ ‖(2 : ℂ) + (t : ℂ) * I - 1‖
    exact h
  have hp : ‖(1 : ℂ) / (rieszMellinLine 2 t - 1)‖ ≤ 1 := by
    rw [norm_div,norm_one]
    exact (div_le_one (by linarith)).mpr hden
  calc
    _ ≤ ‖-logDeriv riemannZeta (rieszMellinLine 2 t)‖ +
      ‖(1 : ℂ) / (rieszMellinLine 2 t - 1)‖ := norm_sub_le _ _
    _ ≤ D + 1 := by rw [norm_neg]; linarith

theorem centered_growth_of_zeta_bound
    (hlarge : ∀ s : ℂ, (47 / 48 : ℝ) ≤ s.re → s.re ≤ 2 → 3 < |s.im| →
      ‖logDeriv riemannZeta s‖ ≤ 19200 * Real.log (24 * (|s.im| + 2))) :
    ∃ C : ℝ, 0 < C ∧ ∀ s : ℂ, (47 / 48 : ℝ) ≤ s.re → s.re ≤ 2 →
      ‖centeredLogDerivative s‖ ≤ C * (1 + Real.log (24 * (|s.im| + 2))) := by
  let K : Set ℂ := Icc (47 / 48 : ℝ) 2 ×ℂ Icc (-3 : ℝ) 3
  have hK : IsCompact K := isCompact_Icc.reProdIm isCompact_Icc
  have hc : ContinuousOn centeredLogDerivative K :=
    centeredLogDerivative_analytic.continuousOn.mono (by
      intro s hs
      change s.re ∈ Icc (47 / 48 : ℝ) 2 ∧ s.im ∈ Icc (-3 : ℝ) 3 at hs
      change (23 / 24 : ℝ) < s.re
      linarith [hs.1.1])
  obtain ⟨C0,hC0⟩ := hK.exists_bound_of_continuousOn hc
  let C : ℝ := |C0| + 19201
  have hC : 0 < C := by dsimp [C]; positivity
  refine ⟨C,hC,?_⟩
  intro s hlo hhi
  have hlog : 0 ≤ Real.log (24 * (|s.im| + 2)) :=
    Real.log_nonneg (by linarith [abs_nonneg s.im])
  have hCbig : 19201 ≤ C := by dsimp [C]; linarith [abs_nonneg C0]
  by_cases ht : 3 < |s.im|
  · have hs : s ≠ 1 := by intro h; norm_num [h] at ht
    rw [centeredLogDerivative_eq hs (by linarith)]
    have hb := hlarge s hlo hhi ht
    have hden : 1 ≤ ‖s - 1‖ := by
      have h := Complex.abs_im_le_norm (s - 1)
      simp only [sub_im, one_im, sub_zero] at h
      linarith
    have hp : ‖(1 : ℂ) / (s - 1)‖ ≤ 1 := by
      rw [norm_div,norm_one]
      exact (div_le_one (by linarith)).mpr hden
    have hh := norm_sub_le (-logDeriv riemannZeta s) (1 / (s - 1))
    rw [norm_neg] at hh
    nlinarith [mul_nonneg (sub_nonneg.mpr hCbig) hlog]
  · have hmem : s ∈ K := by
      change s.re ∈ Icc (47 / 48 : ℝ) 2 ∧ s.im ∈ Icc (-3 : ℝ) 3
      exact ⟨⟨hlo,hhi⟩,abs_le.mp (le_of_not_gt ht)⟩
    have hb := hC0 s hmem
    have hab := le_abs_self C0
    nlinarith [mul_nonneg hC.le hlog]


theorem tail_bound_inv_sq (g : ℝ → ℂ) (C T : ℝ) (hT : 0 < T)
    (hbound : ∀ t : ℝ, T < t → ‖g t‖ ≤ C / t ^ 2) :
    ‖∫ t in Ioi T, g t‖ ≤ C / T := by
  have hg : IntegrableOn (fun t : ℝ => C * t ^ (-(2 : ℝ))) (Ioi T) :=
    (integrableOn_Ioi_rpow_of_lt (by norm_num) hT).const_mul C
  have hn : ‖∫ t in Ioi T, g t‖ ≤ ∫ t in Ioi T, C * t ^ (-(2 : ℝ)) := by
    apply norm_integral_le_of_norm_le hg
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    have hb := hbound t ht
    simpa only [Real.rpow_neg (hT.trans ht).le, Real.rpow_two, div_eq_mul_inv] using hb
  apply hn.trans_eq
  rw [integral_const_mul, integral_Ioi_rpow_of_lt (by norm_num : -(2 : ℝ) < -1) hT]
  norm_num only [neg_add_cancel_left, neg_div_neg_eq, div_one, Real.rpow_neg_one]
  ring

theorem riesz_right_integrable (f : ℂ → ℂ) (X N : ℝ) (hX : 0 < X)
    (hcont : Continuous (fun t : ℝ => f (rieszMellinLine 2 t)))
    (hbound : ∀ t : ℝ, ‖f (rieszMellinLine 2 t)‖ ≤ N) :
    Integrable (fun t => f (rieszMellinLine 2 t) * rieszVerticalWeight X 2 t) := by
  apply ((rieszVerticalWeight_integrable X 2 hX (by norm_num)).norm.const_mul N).mono'
    (hcont.mul (rieszVerticalWeight_continuous X 2 hX (by norm_num))).aestronglyMeasurable
  filter_upwards with t
  rw [Pi.mul_apply,norm_mul]
  exact mul_le_mul_of_nonneg_right (hbound t) (norm_nonneg _)

theorem riesz_right_truncation (f : ℂ → ℂ) (X T N : ℝ) (hX : 0 < X)
    (hT : 0 < T) (hN : 0 ≤ N)
    (hcont : Continuous (fun t : ℝ => f (rieszMellinLine 2 t)))
    (hbound : ∀ t : ℝ, ‖f (rieszMellinLine 2 t)‖ ≤ N) :
    ‖∫ t : ℝ, f (rieszMellinLine 2 t) * rieszVerticalWeight X 2 t‖ ≤
      ‖∫ t in -T..T, f (rieszMellinLine 2 t) * rieszVerticalWeight X 2 t‖ +
        2 * N * X ^ (2 : ℕ) / T := by
  let g := fun t => f (rieszMellinLine 2 t) * rieszVerticalWeight X 2 t
  have hpoint (t : ℝ) (ht : 0 < |t|) : ‖g t‖ ≤ N * X ^ (2 : ℕ) / t ^ 2 := by
    have hk := rieszMellinKernel_im_bound (rieszMellinLine 2 t) (by simpa [rieszMellinLine] using ht)
    simp only [rieszMellinLine, Complex.add_im, Complex.ofReal_im, Complex.mul_im,
      Complex.ofReal_re, Complex.I_im, mul_one, Complex.I_re, mul_zero, add_zero,
      zero_add, sq_abs] at hk
    dsimp only [g]
    rw [norm_mul, rieszVerticalWeight_norm X 2 t hX, Real.rpow_two]
    have h := mul_le_mul (hbound t) (mul_le_mul_of_nonneg_left hk (sq_nonneg X))
      (by positivity) hN
    exact h.trans_eq (by ring)
  have hp := tail_bound_inv_sq g (N * X ^ (2 : ℕ)) T hT
    (fun t ht => hpoint t (by rw [abs_of_pos (hT.trans ht)]; exact hT.trans ht))
  have hn := tail_bound_inv_sq (fun t => g (-t)) (N * X ^ (2 : ℕ)) T hT (by
    intro t ht
    simpa only [neg_sq] using hpoint (-t) (by rw [abs_neg,abs_of_pos (hT.trans ht)]; exact hT.trans ht))
  rw [integral_comp_neg_Ioi T g] at hn
  have hi := riesz_right_integrable f X N hX hcont hbound
  have hsum : ‖∫ t : ℝ, g t‖ ≤ ‖∫ t in Iic (-T), g t‖ +
      ‖∫ t in -T..T, g t‖ + ‖∫ t in Ioi T, g t‖ := by
    rw [integral_three_parts g hi T]
    exact (norm_add_le _ _).trans (add_le_add (norm_add_le _ _) le_rfl)
  change ‖∫ t : ℝ, g t‖ ≤ ‖∫ t in -T..T, g t‖ + _
  rw [show 2 * N * X ^ (2 : ℕ) / T = 2 * (N * X ^ (2 : ℕ) / T) by ring]
  linarith

theorem centered_right_continuous :
    Continuous (fun t : ℝ => centeredLogDerivative (rieszMellinLine 2 t)) := by
  apply continuous_iff_continuousAt.mpr
  intro t
  exact (centeredLogDerivative_analytic _ (by norm_num [rieszMellinLine])).continuousAt.comp
    (rieszMellinLine_continuous 2).continuousAt


theorem ordinaryRieszMean_centered (X : ℝ) (hX : 1 ≤ X) :
    Bounty.ordinaryRieszMean X =
      ((1 / (2 * Real.pi) : ℝ) : ℂ) *
        (∫ t : ℝ, centeredLogDerivative (rieszMellinLine 2 t) * rieszVerticalWeight X 2 t) +
      ((X : ℂ) / 2 - 1 + 1 / (2 * X)) := by
  have hXp : 0 < X := by linarith
  obtain ⟨N,hN,hb⟩ := centered_right_bound
  have hi := riesz_right_integrable centeredLogDerivative X N hXp centered_right_continuous hb
  have hp := poleVerticalIntegrand_integrable X hXp
  have he : (fun t : ℝ => (-logDeriv riemannZeta (rieszMellinLine 2 t)) * rieszVerticalWeight X 2 t) =
      fun t => centeredLogDerivative (rieszMellinLine 2 t) * rieszVerticalWeight X 2 t +
        poleVerticalIntegrand X t := by
    funext t
    have hs : rieszMellinLine 2 t ≠ 1 := by
      intro h
      have := congrArg Complex.re h
      norm_num [rieszMellinLine] at this
    rw [centeredLogDerivative_eq hs (by norm_num [rieszMellinLine])]
    unfold poleVerticalIntegrand
    ring
  rw [Bounty.ordinaryRieszMean_eq_vertical_logDerivative X 2 hXp (by norm_num),
    he, integral_add hi hp, mul_add, pole_vertical_integral X hX]

theorem ordinaryRieszMean_error_le_centered (X : ℝ) (hX : 1 ≤ X) :
    ‖Bounty.ordinaryRieszMean X - (X : ℂ) / 2‖ ≤
      ‖∫ t : ℝ, centeredLogDerivative (rieszMellinLine 2 t) * rieszVerticalWeight X 2 t‖ + 2 := by
  have hXp : 0 < X := by linarith
  have hc : ‖((1 / (2 * Real.pi) : ℝ) : ℂ)‖ ≤ 1 := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
    exact (div_le_one (by positivity : 0 < 2 * Real.pi)).mpr (by linarith [Real.pi_gt_three])
  have hr0 : 0 ≤ (1 : ℝ) / (2 * X) := by positivity
  have hr1 : (1 : ℝ) / (2 * X) ≤ 1 := (div_le_one (by positivity)).mpr (by linarith)
  have hp : ‖(1 : ℂ) / (2 * X)‖ ≤ 1 := by
    have he : (1 : ℂ) / (2 * X) = (((1 : ℝ) / (2 * X) : ℝ) : ℂ) := by push_cast; rfl
    rw [he,Complex.norm_real,Real.norm_eq_abs,abs_of_nonneg hr0]
    exact hr1
  rw [ordinaryRieszMean_centered X hX]
  have he : ((1 / (2 * Real.pi) : ℝ) : ℂ) *
      (∫ t : ℝ, centeredLogDerivative (rieszMellinLine 2 t) * rieszVerticalWeight X 2 t) +
      ((X : ℂ) / 2 - 1 + 1 / (2 * X)) - (X : ℂ) / 2 =
      ((1 / (2 * Real.pi) : ℝ) : ℂ) *
      (∫ t : ℝ, centeredLogDerivative (rieszMellinLine 2 t) * rieszVerticalWeight X 2 t) +
      (-1 + 1 / (2 * X)) := by ring
  rw [he]
  have hn := norm_add_le
    (((1 / (2 * Real.pi) : ℝ) : ℂ) * ∫ t : ℝ, centeredLogDerivative (rieszMellinLine 2 t) * rieszVerticalWeight X 2 t)
    (-1 + 1 / (2 * X))
  have hsmall := norm_add_le (-1 : ℂ) (1 / (2 * X))
  rw [norm_mul] at hn
  norm_num only [norm_neg,norm_one] at hsmall
  have hm := mul_le_of_le_one_left
    (norm_nonneg (∫ t : ℝ, centeredLogDerivative (rieszMellinLine 2 t) * rieszVerticalWeight X 2 t)) hc
  linarith

theorem ordinaryRieszMean_log_bound
    (hlarge : ∀ s : ℂ, (47 / 48 : ℝ) ≤ s.re → s.re ≤ 2 → 3 < |s.im| →
      ‖logDeriv riemannZeta s‖ ≤ 19200 * Real.log (24 * (|s.im| + 2))) :
    ∃ D : ℝ, 0 < D ∧ ∀ X : ℝ, 2 ≤ X →
      ‖Bounty.ordinaryRieszMean X - (X : ℂ) / 2‖ ≤
        D * X ^ (47 / 48 : ℝ) * (1 + Real.log (24 * (X ^ (2 : ℕ) + 2))) := by
  obtain ⟨C,hC,hgrowth⟩ := centered_growth_of_zeta_bound hlarge
  obtain ⟨N,hN,hright⟩ := centered_right_bound
  obtain ⟨K,hK,hrect⟩ := centeredRiesz_rectangle_bound
  let D := (K + 3) * C + 2 * N + 2
  refine ⟨D, by dsimp [D]; positivity, ?_⟩
  intro X hX
  let L := 1 + Real.log (24 * (X ^ (2 : ℕ) + 2))
  let M := C * L
  have hXp : 0 < X := by linarith
  have hX1 : 1 ≤ X := by linarith
  have hXX : 1 ≤ X ^ (2 : ℕ) := by nlinarith
  have hL : 1 ≤ L := by
    have hh : 0 ≤ Real.log (24 * (X ^ (2 : ℕ) + 2)) := Real.log_nonneg (by nlinarith)
    dsimp [L]
    linarith
  have hM : 0 ≤ M := mul_nonneg hC.le (by linarith)
  have hpow : 1 ≤ X ^ (47 / 48 : ℝ) := Real.one_le_rpow hX1 (by norm_num)
  have hbound : ∀ z ∈ uIcc (47 / 48 : ℝ) 2 ×ℂ uIcc (-(X ^ (2 : ℕ))) (X ^ (2 : ℕ)),
      ‖centeredLogDerivative z‖ ≤ M := by
    intro z hz
    have hz' : z.re ∈ Icc (47 / 48 : ℝ) 2 ∧ z.im ∈ Icc (-(X ^ (2 : ℕ))) (X ^ (2 : ℕ)) := by
      simpa only [mem_reProdIm,uIcc_of_le (by norm_num : (47 / 48 : ℝ) ≤ 2),
        uIcc_of_le (by nlinarith : -(X ^ (2 : ℕ)) ≤ X ^ (2 : ℕ))] using hz
    have hh := hgrowth z hz'.1.1 hz'.1.2
    have hl : Real.log (24 * (|z.im| + 2)) ≤ Real.log (24 * (X ^ (2 : ℕ) + 2)) := by
      apply Real.log_le_log (by positivity)
      have hi := abs_le.mpr hz'.2
      linarith
    exact hh.trans (mul_le_mul_of_nonneg_left (by dsimp [L]; linarith) hC.le)
  have hr := hrect X (47 / 48) 2 (X ^ (2 : ℕ)) M hX1 (by norm_num) (by norm_num)
    (by positivity) hM hbound
  have ht := riesz_right_truncation centeredLogDerivative X (X ^ (2 : ℕ)) N hXp
    (by positivity) hN.le centered_right_continuous hright
  have htail : 2 * N * X ^ (2 : ℕ) / X ^ (2 : ℕ) = 2 * N := by field_simp
  rw [htail] at ht
  rw [Real.rpow_two] at hr
  have hquot : M * X ^ (2 : ℕ) / (X ^ (2 : ℕ)) ^ 2 ≤ M := by
    apply (div_le_iff₀ (by positivity)).mpr
    exact mul_le_mul_of_nonneg_left (by nlinarith : X ^ (2 : ℕ) ≤ (X ^ (2 : ℕ)) ^ 2) hM
  have hmPow : M ≤ M * X ^ (47 / 48 : ℝ) := by nlinarith
  have hb := ordinaryRieszMean_error_le_centered X hX1
  have hbase : ‖Bounty.ordinaryRieszMean X - (X : ℂ) / 2‖ ≤
      (K + 3) * M * X ^ (47 / 48 : ℝ) + 2 * N + 2 := by
    nlinarith
  have hLP : 1 ≤ X ^ (47 / 48 : ℝ) * L := one_le_mul_of_one_le_of_one_le hpow hL
  apply hbase.trans
  change (K + 3) * M * X ^ (47 / 48 : ℝ) + 2 * N + 2 ≤ D * X ^ (47 / 48 : ℝ) * L
  dsimp only [D,M]
  nlinarith [mul_nonneg (show 0 ≤ 2 * N + 2 by linarith) (sub_nonneg.mpr hLP)]

theorem ordinaryRieszMean_logarithmic_bound
    (hlarge : ∀ s : ℂ, (47 / 48 : ℝ) ≤ s.re → s.re ≤ 2 → 3 < |s.im| →
      ‖logDeriv riemannZeta s‖ ≤ 19200 * Real.log (24 * (|s.im| + 2))) :
    ∃ C : ℝ, 0 < C ∧ ∀ X : ℝ, 2 ≤ X →
      ‖Bounty.ordinaryRieszMean X - (X : ℂ) / 2‖ ≤ C * X ^ (47 / 48 : ℝ) * Real.log X := by
  obtain ⟨D,hD,hbound⟩ := ordinaryRieszMean_log_bound hlarge
  refine ⟨12 * D, by positivity, ?_⟩
  intro X hX
  have hl := Bounty.riesz_conductor_log_bound (q := 1) (by norm_num) hX
  simp only [mul_one,one_mul] at hl
  calc
    _ ≤ D * X ^ (47 / 48 : ℝ) * (1 + Real.log (24 * (X ^ (2 : ℕ) + 2))) := hbound X hX
    _ ≤ D * X ^ (47 / 48 : ℝ) * (12 * Real.log X) :=
      mul_le_mul_of_nonneg_left hl (by positivity)
    _ = _ := by ring

end ThirdZetaContour

