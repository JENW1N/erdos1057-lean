section

/- Uniform errors preserve the full labelled-slot normalization. -/

open Finset

namespace Bounty

theorem ordered_slot_complex_error_bound {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) {Z : ℝ} (hZ : 0 < Z) (n : ℕ)
    (f g : (∀ i, choices i) → ℂ) {err : ℝ}
    (hfg : ∀ x, ‖f x-g x‖ ≤ err) :
    ‖(∑ x : ∀ i, choices i, if orderedSlotProduct choices x=n then f x/(Z : ℂ) else 0) -
        ∑ x : ∀ i, choices i, if orderedSlotProduct choices x=n then g x/(Z : ℂ) else 0‖ ≤
      err*orderedSlotWeight choices Z n := by
  classical
  have sum_compare (s t : Finset (∀ i, choices i)) (a b : (∀ i, choices i) → ℝ)
      (hst : s=t) (hab : ∀ x ∈ s, a x ≤ b x) : (∑ x ∈ s, a x) ≤ ∑ x ∈ t, b x := by
    rw [← hst]
    exact sum_le_sum hab
  rw [← sum_sub_distrib]
  apply (norm_sum_le _ _).trans
  unfold orderedSlotWeight
  rw [mul_sum]
  apply sum_compare
  · ext x; simp only [mem_univ]
  intro x hx
  by_cases h : orderedSlotProduct choices x=n
  · simp only [h, if_true, ← sub_div, norm_div, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hZ]
    simpa only [mul_one_div] using div_le_div_of_nonneg_right (hfg x) hZ.le
  · simp only [h, if_false, sub_self, norm_zero, mul_zero, le_refl]

end Bounty
