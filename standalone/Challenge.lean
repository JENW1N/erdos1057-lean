open Finset Classical

namespace Bounty

theorem physical_small_big_reverse_prefix_energy_le
    {S G : Type*} [Fintype S] [dS : DecidableEq S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} [∀ p : PhysicalPrime Ps, NeZero p.2.val]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    {J ell : ℕ} {M : G → ℕ} (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (kbig : SharedActiveLabels P shared → ℤ) (Vs : S → ℝ) (q : ℝ)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (shared g)ᶜ.card ≤ T)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    physicalSmallBigConditionEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (physicalSmallBigPrefixAction (PhysicalSmallBigFullEvent n shared B (fun d c g => -Δ d c g) D)
        (physicalSmallBigFullTarget n shared B (fun d c g => -Δ d c g) D)
        (physicalSmallBigFullCoefficient n shared B (fun d c g => -Δ d c g) D μ ρ V
          (physicalSmallBigReversePhase n shared B Δ D V))
        (fun x => -kbig (productActiveMemorySplit shared B x).1) (physicalSmallBigCondition Vs q F)) ≤
      unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        physicalSmallBigConditionEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
          (physicalSmallBigCondition Vs q F) := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  unfold physicalSmallBigConditionEnergy
  rw [mul_sum]
  apply sum_le_sum
  intro d hd
  simp_rw [physical_small_big_reverse_prefix_eq]
  exact full_active_reverse_promotion_external_energy_le n shared B
    (fun c (_ : Unit) => Δ d c) (fun c (_ : Unit) => D d c) (fun _ _ => 1) μ ρ V
    (fun c _ => physicalResidueTranslationEquiv (P := Ps) (kbig c * (physicalSharedProduct d : ℕ)))
    (by intros; exact zero_le_one) (by intro c; simp only [Fintype.sum_unique, le_refl])
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht (physicalSmallBigCondition Vs q F d)
    (fun r => physical_small_big_condition_memory_symmetric Vs q F hF d r)

/- All per-choice operator and conditioning bounds are discharged; A is
uniform in J and the event data. -/
theorem exists_physical_small_big_reverse_energy_bound
    {q vs : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hvs : 0 < vs) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (S G : Type) [Fintype S] [DecidableEq S]
      [Fintype G] [DecidableEq G]
      (Ps : S → Finset ℕ) [∀ p : PhysicalPrime Ps, NeZero p.2.val]
      (P : G → Type) [∀ g, Fintype (P g)] (n : ∀ g, P g → ℕ)
      [∀ g p, NeZero (n g p)] (J : ℕ) (M : G → ℕ)
      (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
      (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
      (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
      (kbig : SharedActiveLabels P shared → ℤ)
      (Vs : S → ℝ), (∀ s, vs ≤ Vs s) →
      ∀ (aux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))))
        (v vmin vmax : ℝ), 0 < ρ → ρ < 1 → 1 < v → 0 < vmin →
      (∀ g, vmin ≤ V g) → (∀ g, V g ≤ vmax) →
      (∀ g p, 0 ≤ μ g p) → (∀ g, ∑ p, μ g p ≤ 2) →
      ∀ (T : ℕ), (∀ g, (shared g)ᶜ.card ≤ T) →
      ∀ (F : PhysicalSmallBigState Ps J ell
        (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ),
      (∀ s, ProductMemorySymmetric (fun x => F (s, x))) →
      physicalSmallBigEnergy Vs (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
