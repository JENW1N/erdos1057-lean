noncomputable def globalBirthGhostParticleRow {P : Type*} [Fintype P] [DecidableEq P]
    (n : P → ℕ) [∀ p, NeZero (n p)] {N : ℕ}
    (β : P → ℝ) (η V ρ : ℝ) (cap : ℕ) (H : Finset P)
    (old : Fin N → UnrestrictedResidueParticle n)
    (G : Finset P → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) : ℂ :=
  ∑ b ∈ range (cap + 1), ∑ S : Finset (Fin N),
    (((∏ j ∈ S, physicalGhostRetention n (1 - η) ρ (old j)) *
      ∏ j ∈ univ \ S, physicalGhostTermination n (1 - η) ρ (old j) : ℝ) : ℂ) *
      (∑ z : Fin b → UnrestrictedResidueParticle n,
        ((∏ j, physicalGhostBirth n (1 - η) ρ V (z j) *
          unrestrictedResidueWeight (fun p => β p / V) (z j) : ℝ) : ℂ) *
        (if Function.Injective (fun j => (z j).1) ∧ (∀ j, (z j).1 ∉ H) ∧ S.card + b ≤ cap
        then G (H ∪ univ.image (fun j => (z j).1)) (retainedBirthTuple old S z) else 0)) /
      (b.factorial : ℂ)

theorem global_birth_ghost_visit_eq_particle_row {P : Type*} [Fintype P] [DecidableEq P]
    (n : P → ℕ) [∀ p, NeZero (n p)] {N : ℕ}
    (β : P → ℝ) (η V ρ : ℝ) (cap : ℕ) (H : Finset P)
    (old : Fin N → UnrestrictedResidueParticle n)
    (G : Finset P → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    globalBirthGhostVisitRawRow (fun _ => 0) β η V ρ cap H old G =
      globalBirthGhostParticleRow n β η V ρ cap H old G := by
  rw [global_birth_ghost_visit_cap_range]
  unfold globalBirthGhostVisitCapRow globalBirthGhostParticleRow
  rw [sum_comm]
  apply sum_congr rfl
  intro b _
  let F : Finset (Fin N) → ℂ := fun S =>
    ∑ f : Fin b → P, (((-η * V / ρ) ^ b * (∏ j, β (f j) / V) : ℝ) : ℂ) *
      (if Function.Injective f ∧ (∀ j, f j ∉ H) ∧ S.card + b ≤ cap
        then G (H ∪ univ.image f) (retainedBirthTuple old S (fun j => ⟨f j, 0⟩)) else 0)
  calc
    _ = (∑ T ∈ (globalBirthVisitZeroIndices (fun _ => 0) old).powerset,
        (((-η / ρ) ^ T.card * ((1 - η) / ρ ^ 2) ^
          (globalBirthVisitZeroIndices (fun _ => 0) old \ T).card : ℝ) : ℂ) * F (univ \ T)) /
        (b.factorial : ℂ) := by
      rw [sum_div]
      apply sum_congr rfl
      intro T _
      dsimp only [F]
      rw [mul_sum, sum_div]
      apply sum_congr rfl
      intro f _
      split_ifs
      · push_cast
        ring
      · simp only [mul_zero, zero_div]
    _ = (∑ S : Finset (Fin N),
        (((∏ j ∈ S, physicalGhostRetention n (1 - η) ρ (old j)) *
          ∏ j ∈ univ \ S, physicalGhostTermination n (1 - η) ρ (old j) : ℝ) : ℂ) * F S) /
        (b.factorial : ℂ) := by
      rw [physical_ghost_old_event_sum]
    _ = _ := by
      rw [sum_div]
      apply sum_congr rfl
      intro S _
      apply congrArg (fun z : ℂ =>
        (((∏ j ∈ S, physicalGhostRetention n (1 - η) ρ (old j)) *
          ∏ j ∈ univ \ S, physicalGhostTermination n (1 - η) ρ (old j) : ℝ) : ℂ) * z /
          (b.factorial : ℂ))
      exact physical_ghost_birth_tuple_sum n β η V ρ b
        (fun z => if Function.Injective (fun j => (z j).1) ∧
          (∀ j, (z j).1 ∉ H) ∧ S.card + b ≤ cap
          then G (H ∪ univ.image (fun j => (z j).1)) (retainedBirthTuple old S z) else 0)
end

