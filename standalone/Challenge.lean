section

/- The full original prime-kernel pair, including its three phases and all
auxiliary exclusions, is approximated by the two marked endpoint averages. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_prime_pair_comparison {G : Type*} [Fintype G] [dG : DecidableEq G]
    (P : G → Finset ℕ) {J ell : ℕ} (probes : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    {q : ℝ} (hq0 : 0 < q) (hq1 : q ≤ 1)
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ) (hξ : 0 < ξ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b : ℝ) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ)) :
    let C := repeatedBigPrimePatternCut probes r t i
    let W0 := markedDivisorWeight univ P q V (fun g => ell + (C g).card) (w : ℤ)
    let W1 := markedDivisorWeight univ P q V (fun g => ell + (C g).card) (z : ℤ)
    let H := repeatedBigPrimePatternBound probes r t Q ξ i
    ‖physicalFullPairCorrelation P C V q w z
        (physicalOriginalPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z) -
      (W0 : ℂ) * (W1 : ℂ) *
        groupMarkedAverage P (fun g => ell + (C g).card) (w : ℤ) (fun u =>
          groupMarkedAverage P (fun g => ell + (C g).card) (z : ℤ)
            (physicalUnsharedPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z u))‖ ≤
      (W0 * W1) *
        ((∑ g, (J - (C g).card : ℕ) *
            (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)) *
          (H + H / q ^ (2 * ∑ g : G, (J - (C g).card)))) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  dsimp only
  apply physical_whole_pair_comparison P _ hprime hdis V hV hMass hq0 hq1 aux hw hz
    hPmin hp _ _ (repeated_big_prime_pattern_bound_nonneg probes r t Q ξ i)
  · intro L R _
