variable
  {X 𝕜 : Type*}
  [sharedInstance1 : CommMonoidWithZero 𝕜]
  (C : Nat → X → Prop)
  (K : Nat → X → X → 𝕜)
  (initial : X → 𝕜)
  (hK : ∀ i z w, ¬ C (i + 1) z → K i z w = 0)
  (hinit : ∀ z, ¬ C 0 z → initial z = 0)
  (n : Nat)
  (x : Fin (n + 1) → X)

include X 𝕜 sharedInstance1 C K initial hK hinit n x

theorem finite_chronological_prefix_zero_of_cut  (j : Fin (n + 1))
    (hj : ¬ C j.val (x j)) : finiteChronologicalPrefix K initial n x = 0 := by
  classical
  by_cases hzero : j.val = 0
  · have he : j = 0 := Fin.ext hzero
    subst j
    simp only [finiteChronologicalPrefix, hinit (x 0) hj, zero_mul]
  · let i : Fin n := ⟨j.val - 1, by omega⟩
    have hi : i.succ = j := by
      apply Fin.ext
      dsimp [i]
      omega
    have hk : K i.val (x i.succ) (x i.castSucc) = 0 := by
      apply hK
      simpa only [← hi, Fin.val_succ] using hj
    unfold finiteChronologicalPrefix
    rw [prod_eq_zero (mem_univ i) hk, mul_zero]

/- No sum or cancellation is required: duplicate cut projectors collapse
on each individual chronological state trace. -/
theorem finite_chronological_input_masks_collapse  :
    finiteChronologicalPrefix (finiteInputMaskedKernel C K) initial n x =
      finiteChronologicalPrefix K initial n x := by
  classical
  by_cases hcut : ∀ j : Fin (n + 1), C j.val (x j)
  · unfold finiteChronologicalPrefix
    congr 1
    apply prod_congr rfl
    intro j _
    exact if_pos (hcut j.castSucc)
  · obtain ⟨j, hj⟩ := not_forall.mp hcut
    have hmasked : ∀ i z w, ¬ C (i + 1) z → finiteInputMaskedKernel C K i z w = 0 := by
      intro i z w hz
      unfold finiteInputMaskedKernel
      rw [hK i z w hz]
      split_ifs <;> rfl
    rw [finite_chronological_prefix_zero_of_cut C _ initial hmasked hinit n x j hj,
      finite_chronological_prefix_zero_of_cut C K initial hK hinit n x j hj]

end

