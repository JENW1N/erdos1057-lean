section

/- The actual normalized retained allocation integrand is a Type II sum on explicit finite supports. -/

open Finset

namespace Bounty

noncomputable def candidateB0TakenSupport (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) (X : ℝ) : Finset ℕ :=
  (orderedSlotProductSupport
    (fun slot : CandidateTakenSlot c L r take => candidateQSlotChoices c L r jStar slot.val)).filter
      (fun e : ℕ => X/L^88 ≤ (e : ℝ) ∧ (e : ℝ) ≤ X)

noncomputable def candidateB0TakenCoefficient (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (ν : ℝ) (e : ℕ) : ℂ :=
  candidateTakenComplexCoefficient c L r jStar take twist e*typeIIMellinPhase ν e

noncomputable def candidateB0RetainedCoefficient (c L q : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (ν : ℝ) (h : ℕ) : ℂ :=
  candidateRetainedComplexCoefficient c L q r jStar take twist h*typeIIMellinPhase ν h

theorem candidate_taken_product_support_pos (c L : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) {e : ℕ}
    (he : e ∈ orderedSlotProductSupport
      (fun slot : CandidateTakenSlot c L r take => candidateQSlotChoices c L r jStar slot.val)) : 0 < e := by
  classical
  obtain ⟨x,hx,rfl⟩ := mem_image.mp he
  apply Nat.pos_of_ne_zero
  exact prod_ne_zero_iff.mpr (fun slot _ => candidate_Q_slot_nonzero c L r jStar slot.val (x slot).property)

theorem candidate_retained_allocation_support_pos (c L : ℝ) (r jStar : ℕ) (P : Finset ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool) (hP : ∀ p ∈ P, 0 < p) {h : ℕ}
    (hh : h ∈ candidateRetainedAllocationSupport c L r jStar P take) : 0 < h := by
  classical
  obtain ⟨⟨p,n⟩,hpn,rfl⟩ := mem_image.mp hh
  obtain ⟨hp,hn⟩ := mem_product.mp hpn
  apply Nat.mul_pos (hP p hp)
  obtain ⟨x,hx,rfl⟩ := mem_image.mp hn
  apply Nat.pos_of_ne_zero
  exact prod_ne_zero_iff.mpr (fun slot _ => candidate_Q_slot_nonzero c L r jStar slot.val (x slot).property)

theorem candidate_B0_coefficient_norms (c L q : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (ν : ℝ) {n : ℕ} (hn : 0 < n) :
    ‖candidateB0TakenCoefficient c L r jStar take twist ν n‖ =
      ‖candidateTakenComplexCoefficient c L r jStar take twist n‖ ∧
    ‖candidateB0RetainedCoefficient c L q r jStar take twist ν n‖ =
      ‖candidateRetainedComplexCoefficient c L q r jStar take twist n‖ := by
  simp only [candidateB0TakenCoefficient,candidateB0RetainedCoefficient,norm_mul,
    typeII_mellin_phase_norm ν hn,mul_one,and_self]

theorem candidate_retained_box_typeII (c L q : ℝ) (r jStar : ℕ)
    (P M N : Finset ℕ) (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
    (X ν R U V : ℝ) (α β : ℕ → ℂ)
    (hP : ∀ p ∈ P, 0 < p) (hU : 0 ≤ U) (hV : 0 ≤ V)
    (hM : ∀ m ∈ M, (m : ℝ) ≤ 2*U) (hN : ∀ n ∈ N, (n : ℝ) ≤ 2*V)
    (hR : 2*U*V ≤ R*Real.exp L)
    (hα : ∀ m, m ∉ M → α m = 0) (hβ : ∀ n, n ∉ N → β n = 0) :
    candidateRetainedAllocationIntegrand c L q r jStar (Real.log X) P take
      (candidateBoxFiniteTest L X (Icc 1 ⌊R*Real.exp L⌋₊)
        (fun u => typeIIMellinPhase ν u*∑ m ∈ (2*u+1).divisors, α m*β ((2*u+1)/m))) ξ =
      candidateAllocationFourierScalar c L r jStar (Real.log X) ξ *
        (∑ e ∈ candidateB0TakenSupport c L r jStar take X, ∑ n ∈ N,
          candidateB0TakenCoefficient c L r jStar take
            (candidateAllocationFourierTwist c L r jStar take ξ) ν e * β n *
          typeIIInnerSum M (candidateRetainedAllocationSupport c L r jStar P take) α
            (candidateB0RetainedCoefficient c L q r jStar take
              (candidateAllocationFourierTwist c L r jStar take ξ) ν) e n) *
      activeAllocationFourierWeight (candidateAllocationRadius r)
        (candidateAllocationActive c L r jStar) take ξ := by
  unfold candidateRetainedAllocationIntegrand candidateB0TakenSupport
    candidateB0TakenCoefficient candidateB0RetainedCoefficient
  apply congrArg (fun z : ℂ =>
    candidateAllocationFourierScalar c L r jStar (Real.log X) ξ * z *
      activeAllocationFourierWeight (candidateAllocationRadius r)
        (candidateAllocationActive c L r jStar) take ξ)
  apply finite_mellin_divisor_typeII_compatible _ M N _ _ _ α β _ L X ν hα hβ
  intro e he hr n hn m hm h hh heq
  exact typeII_equation_coarse_bounds (candidate_taken_product_support_pos c L r jStar take he)
    (candidate_retained_allocation_support_pos c L r jStar P take hP hh)
    hU hV (hM m hm) (hN n hn) hR heq

end Bounty
