      (fun H' q => boundedOrderedZeroExtension (F H') s.1 q) =
      ∑ e : BoundedGhostEvent t B s,
        (boundedGhostEventWeight (physicalGhostRetention n (1 - η) ρ)
          (physicalGhostTermination n (1 - η) ρ) (physicalGhostBirth n (1 - η) ρ V)
          (unrestrictedResidueWeight (fun p => β p / V)) t B s e : ℂ) *
        (if globalBirthGhostEventFresh n H t B s e then 1 else 0) *
