/- Any subset retaining the stated polynomial weighted mass already
contains exponentially many distinct elements. -/
theorem eventually_candidate_subset_card_lower {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (C : ℝ) {eps : ℝ} (heps : 0 < eps) :
    ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ) (S : Finset ℕ),
      S ⊆ arithmeticProductWindow 1 (Real.exp L) →
      Real.exp L * L^(-C) ≤ (∑ u ∈ S, candidateCoefficient c L q r jStar u) →
      Real.exp ((1 - eps) * L) ≤ (S.card : ℝ) := by
  filter_upwards [eventually_candidate_coefficient_le_exp_sqrt hc hr hq0 hq1,
    eventually_weighted_mass_card_lower C (2 * Real.log 2 + 1) heps] with L hpoint hcard
  intro jStar S hS hmass
  apply hcard ℕ S (candidateCoefficient c L q r jStar) hmass
  intro u hu
  have hwindow := (mem_arithmeticProductWindow_iff one_ne_zero (Real.exp L)).mp (hS hu)
  exact hpoint jStar u (by simpa only [one_mul] using hwindow.2)



end

