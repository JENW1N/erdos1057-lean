theorem eventually_candidate_rest_free_prime_count {c eps : ℝ} {r J : ℕ}
    (hc : 0 < c) (hr : 0 < r) (heps0 : 0 ≤ eps) (heps1 : eps ≤ 1/10)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1)
    (hepsr : eps * (r : ℝ) ≤ 1/400) (hJ : 1000 * (r : ℝ) ≤ 2^J) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J < jStar →
      ∀ p ∈ candidateSmallPSet c L (Real.exp ((c / 100) * L)),
      ∀ y : ∀ slot, candidatePrefixRestChoices c L eps r jStar J hr slot,
      (Real.exp L /
        ((p * orderedSlotProduct (candidatePrefixRestChoices c L eps r jStar J hr) y : ℕ) : ℝ)) *
        ((((2 * Real.log 2 - 1) / 16) / ((6/5 : ℝ) * c)) / L) ≤
      ((primeProductWindow (candidateQBand (c * L) 0)
        ((p * orderedSlotProduct (candidatePrefixRestChoices c L eps r jStar J hr) y : ℕ) : ℝ)
        (Real.exp L)).card : ℝ) := by
  have hcc : c ≤ (6/5 : ℝ) * c := by linarith
  filter_upwards [eventually_candidate_rest_tuple_log_window hc hr heps0 heps1 hcenter hepsr hJ,
    eventually_primeProductWindow_card_lower hc hcc, eventually_ge_atTop (0 : ℝ)] with L hw hcCount hL
  intro jStar hJstar p hp y
  have hrest := candidate_rest_tuple_nonzero hr (mul_nonneg hc.le hL) heps1 hJstar y
  have hn0 : (0 : ℝ) < (p * orderedSlotProduct (candidatePrefixRestChoices c L eps r jStar J hr) y : ℕ) := by
    exact_mod_cast Nat.pos_of_ne_zero (mul_ne_zero (candidate_small_P_set_nonzero hp) hrest)
  have hwindow := hw jStar hJstar y p hp
  refine hcCount _ _ _ (fun _ ha => (mem_filter.mp ha).2) hn0 (Real.exp_pos L)
    (wide_prime_window_subset_candidateQBand hn0 (Real.exp_pos L) hwindow.1 hwindow.2) hwindow.1 ?_
  have hlog16 : 0 ≤ Real.log 16 := Real.log_nonneg (by norm_num)
  nlinarith [hwindow.2]
