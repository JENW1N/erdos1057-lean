/- The clean part of the literal full coefficient row is exactly the
gated clean row. The initial mask tests new births only; the residual phase
uses the actual physical source and target labels for every event. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {S G : Type} [Fintype S] [Fintype G] [DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}

noncomputable def physicalMixedFullResidualPhase
    (C : G → Finset (Fin J)) (ζ θ : ℝ) (k : ℤ)
    (sourceGate targetGate : PhysicalSmallBigState Ps J ell
      (CleanFullMemoryState P J ell B) → ℂ)
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (e : PhysicalMixedCoefficientEvent C k a s) : ℂ :=
  let source := physicalMixedRepeatedLabels C s.2
  let targetState := physicalMixedCoefficientTarget C k a s e
  let target := physicalMixedRepeatedLabels C targetState.2
  let d := physicalSharedPrefix s.1.2
  let cp := (productActiveMemorySplit (fun g => physicalFullSharedIndices (ell := ell) (C g)) B s.2).1
  if repeatedBigAuxAvoids C a source ∧ repeatedBigAuxAvoids C a target then
    (starRingEnd ℂ) (sourceGate s) *
      physicalPhase ζ (physicalMixedSharedD C d cp a) *
      physicalReturnPhase θ (physicalMixedBigStep C k cp a * (physicalSharedProduct d : ℕ)) *
      targetGate targetState
  else 0

theorem physical_mixed_clean_coefficient_action_eq_gated
    (initial : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ θ ρ : ℝ) (k : ℤ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (Vs : S → ℝ) (q : ℝ)
    (sourceGate targetGate f : PhysicalSmallBigState Ps J ell
      (CleanFullMemoryState P J ell B) → ℂ)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)) :
    physicalMixedCoefficientAction C k V b ρ Vs q initial
      (fun a y e => if ∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅ then
        K (physicalMixedRepeatedLabels C y.2)
          (physicalMixedRepeatedLabels C (physicalMixedCoefficientTarget C k a y e).2) a *
          physicalMixedFullResidualPhase C ζ θ k sourceGate targetGate a y e else 0) f s =
      physicalMixedGatedCleanAction initial V b C ζ θ ρ k K Vs q sourceGate targetGate f s := by
  unfold physicalMixedCoefficientAction physicalMixedGatedCleanAction
  apply sum_congr rfl
  intro a _
  congr 1
  apply congrArg (fun phase => physicalSmallBigFullPhasedAction
    (fun g (p : P g) => p.val) (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
    (fun d c => physicalMixedEdgeDelta C k d c a)
    (fun d c => physicalMixedEdgeD C d c a)
    (fun g => tiltedPhysicalBirthLaw V g (b g)) ρ V
    (fun c => physicalMixedBigStep C k c a) Vs q phase f s)
  funext y e
  unfold physicalSmallBigEndpointPhase physicalSmallBigCleanInitialPhase
  dsimp only
  rw [physical_mixed_clean_prefix_phase_eq_labels]
  unfold physicalMixedFullResidualPhase physicalMixedCoefficientTarget physicalSmallBigTarget
  dsimp only
  by_cases hi : ∀ g i, (e.2.2 g).2.2.2 i ∉ initial g
  · by_cases hc : ∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅
    · rw [if_pos hi, if_pos hc, if_pos (And.intro hc hi)]
      split_ifs <;> ring
    · rw [if_pos hi, if_neg hc, if_neg (fun h => hc h.1)]
      simp only [mul_zero, zero_mul]
  · rw [if_neg hi, if_neg (fun h => hi h.2)]
    simp only [mul_zero, zero_mul]

end

end Bounty
