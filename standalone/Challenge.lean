        (((u : ℝ) / r + β) * τ y) : ℝ))) ^ (π x)‖ ^ 2 ≤
      6 * C * D * (1 + Real.log r) *
        (1 / (r : ℝ) + 1 / (U : ℝ) + 1 / (V : ℝ) + (r : ℝ) / ((U : ℝ) * V)) *
