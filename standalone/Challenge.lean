theorem finite_weighted_energy_of_scaled_norm {X : Type*} [Fintype X]
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x) (H : ℝ) (hH : 0 ≤ H) (K : ℝ)
    (f output majorant : X → ℂ)
    (hdom : ∀ x, ‖output x‖ ≤ ‖(H : ℂ) * majorant x‖)
    (hbase : finiteWeightedEnergy w majorant ≤ K * finiteWeightedEnergy w f) :
    finiteWeightedEnergy w output ≤ H ^ 2 * K * finiteWeightedEnergy w f := by
  calc
    _ ≤ finiteWeightedEnergy w (fun x => (H : ℂ) * majorant x) :=
      finiteWeightedEnergy_le_of_norm_le w hw _ _ hdom
    _ = H ^ 2 * finiteWeightedEnergy w majorant := by
      rw [finiteWeightedEnergy_const_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hH]
    _ ≤ _ := (mul_le_mul_of_nonneg_left hbase (sq_nonneg H)).trans_eq (by ring)

