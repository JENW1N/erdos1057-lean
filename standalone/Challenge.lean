/- A nonnegative real majorant for a finite complex weighted sum. -/

open Finset
open scoped Classical
namespace Bounty

section

variable
  {S : Type*}
  [sharedInstance1 : Fintype S]
  (μ : S → ℝ)
  (hμ : ∀ s, 0 ≤ μ s)
  (F : S → ℂ)
  (B : S → ℝ)
  (hB : ∀ s, ‖F s‖ ≤ B s)

include S sharedInstance1 μ hμ F B hB

theorem finite_weighted_norm_le_real_majorant  :
    ‖∑ s, (μ s : ℂ) * F s‖ ≤ (∑ s, (μ s : ℂ) * (B s : ℂ)).re := by
  calc
    _ ≤ ∑ s, ‖(μ s : ℂ) * F s‖ := norm_sum_le _ _
    _ ≤ ∑ s, μ s * B s := by
      apply sum_le_sum
      intro s _
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hμ s)]
      exact mul_le_mul_of_nonneg_left (hB s) (hμ s)
    _ = _ := by
      simp only [Complex.re_sum, Complex.mul_re, Complex.ofReal_re,
        Complex.ofReal_im, zero_mul, sub_zero]

theorem finite_weighted_norm_le_majorant_norm  :
    ‖∑ s, (μ s : ℂ) * F s‖ ≤ ‖∑ s, (μ s : ℂ) * (B s : ℂ)‖ :=
  (finite_weighted_norm_le_real_majorant μ hμ F B hB).trans (Complex.re_le_norm _)

end


end Bounty
end

section

/- The exact normalized full-vertex compatible pair functional. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalFullPairCorrelation {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (V : G → ℝ) (q : ℝ) (w z : ℕ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → ℂ) : ℂ :=
  ∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
    if physicalSharedCompatible C L R then
      ((physicalStateMass V J ell * physicalCompletionMass V C ell /
        (physicalSharedFactor C L : ℝ) : ℝ) : ℂ) *
      (((physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * (w : ℤ)) *
        physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) * (z : ℤ)) : ℝ) : ℂ) * K L R)
    else 0

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  (P : G → Finset ℕ)
  {J ell : ℕ}
  (C : G → Finset (Fin J))
  (V : G → ℝ)
  (q : ℝ)
  (w z : ℕ)
  (F K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → ℂ)

include G sharedInstance1 P J ell C V q w z F K

theorem physical_full_pair_congr 
    (h : ∀ L R, physicalSharedCompatible C L R → F L R = K L R) :
    physicalFullPairCorrelation P C V q w z F = physicalFullPairCorrelation P C V q w z K := by
  unfold physicalFullPairCorrelation
  apply sum_congr rfl
  intro L _
  apply sum_congr rfl
  intro R _
  by_cases hc : physicalSharedCompatible C L R
  · rw [if_pos hc, if_pos hc, h L R hc]
  · rw [if_neg hc, if_neg hc]

theorem physical_full_pair_add  :
    physicalFullPairCorrelation P C V q w z (fun L R => F L R + K L R) =
      physicalFullPairCorrelation P C V q w z F + physicalFullPairCorrelation P C V q w z K := by
  unfold physicalFullPairCorrelation
  rw [← sum_add_distrib]
  apply sum_congr rfl
  intro L _
  rw [← sum_add_distrib]
  apply sum_congr rfl
  intro R _
  by_cases hc : physicalSharedCompatible C L R
  · simp only [if_pos hc, mul_add]
  · simp only [if_neg hc, zero_add]

end


end Bounty
