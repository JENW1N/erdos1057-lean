  intro B
  let X := max 0 ((A+2*(C+B)+23)/2)
  have hAs0 : 0 ≤ X := le_max_left _ _
  have hX : (A+2*(C+B)+23)/2 ≤ X := le_max_right _ _
  have hAs : A+2*(C+B)+21 ≤ 2*X := by linarith
