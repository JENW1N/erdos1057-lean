  )

theorem lowRamifiedTransform_cube_difference (p:_root_.OAI.ActualEisensteinCubic.O) (hp:Prime p) (hpp:lambda^2∣p-1)
    (a r:Fin 3) (n:_root_.OAI.ActualEisensteinCubic.O) (hn:lambda^2∣n-1) :
    lowRamifiedTransform (fun x=>unramifiedGaussResidue (x*p^3)-unramifiedGaussResidue x)
