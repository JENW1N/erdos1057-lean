theorem unrestricted_promoting_event_eligible {P : Type*}
    (n : P → ℕ) (Δ D : ℤ) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s) (hp : e.2.1 ≠ ∅) :
    (unrestrictedResidueEligible n Δ D s.2.2).Nonempty := by
  obtain ⟨i, hi⟩ := Finset.nonempty_iff_ne_empty.mpr hp
  exact ⟨(e.2.2.1 ⟨i, hi⟩).val, (e.2.2.1 ⟨i, hi⟩).property⟩













/- Match the minus-displacement convention to the congruence in the
physical small-omission counting theorem. Repeated indices remain distinct. -/
theorem unrestricted_eligible_physical_congruence {P : Type*} {N : ℕ}
    (n : P → ℕ) (k : ℤ) (D : ℕ) (old : Fin N → UnrestrictedResidueParticle n) :
    (unrestrictedResidueEligible n (-(k * (D : ℤ))) D old).Nonempty ↔
      ∃ j : Fin N, ¬ n (old j).1 ∣ D ∧
        (old j).2 + (k : ZMod (n (old j).1)) * (D : ZMod (n (old j).1)) = 0 := by
  simp only [Finset.Nonempty, mem_unrestrictedResidueEligible, Int.cast_neg, Int.cast_mul,
    Int.cast_natCast, Int.natCast_dvd_natCast, eq_neg_iff_add_eq_zero]
  exact exists_congr fun _ => and_comm

