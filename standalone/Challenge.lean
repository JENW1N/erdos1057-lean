section

/- Arbitrary power saving for the explicit rough-cell sieve error profile. -/

open Filter

namespace Bounty

theorem eventually_rough_cell_error_profile_le {a K : ℝ}
    (ha : 0 < a) (hK : 0 ≤ K) (S B : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      K*(Real.exp (-L^(1/8 : ℝ)) + L^(S+1)*Real.exp (-(a/2)*L)) ≤ L^(-B) := by
  have hfirst := eventually_exp_neg_rpow_mul_rpow_le
    (by norm_num : (0 : ℝ) < 1/8) (by norm_num : (0 : ℝ) < 1) 0 (B+1)
  have hsecond := eventually_exp_neg_rpow_mul_rpow_le
    (by norm_num : (0 : ℝ) < 1) (half_pos ha) (S+1) (B+1)
  filter_upwards [hfirst, hsecond, eventually_ge_atTop (2*K),
    eventually_gt_atTop (0 : ℝ)] with L hfirstL hsecondL hconst hL
  simp only [neg_one_mul, Real.rpow_zero, mul_one] at hfirstL
  simp only [Real.rpow_one] at hsecondL
  calc
    _ ≤ K*(L^(-(B+1)) + L^(-(B+1))) := by
      apply mul_le_mul_of_nonneg_left _ hK
      exact add_le_add hfirstL (by simpa only [mul_comm] using hsecondL)
    _ = (2*K)*L^(-(B+1)) := by ring
    _ ≤ L*L^(-(B+1)) :=
      mul_le_mul_of_nonneg_right hconst (Real.rpow_nonneg hL.le _)
    _ = L^(-B) := by
      nth_rw 1 [← Real.rpow_one L]
      rw [← Real.rpow_add hL]
      congr 1
      ring

theorem eventually_rough_cell_order_error_le {a K : ℝ}
    (ha : 0 < a) (hK : 0 ≤ K) (S B : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      K*(Real.exp (-(roughCellSieveOrder L : ℝ)) +
        L^(S+1)*Real.exp (-(a/2)*L)) ≤ L^(-B) := by
  filter_upwards [eventually_rough_cell_error_profile_le ha hK S B,
    eventually_ge_atTop (1 : ℝ)] with L hprofile hL
  apply le_trans _ hprofile
  apply mul_le_mul_of_nonneg_left _ hK
  exact add_le_add (rough_cell_sieve_order_exponential_le hL) le_rfl

end Bounty

end

section

/- A quantitative positive main term in a short logarithmic rough-integer cell. -/

open Finset

namespace Bounty

theorem rough_sqrt_avoidance_product_lower {L : ℝ} (hL : 1 ≤ L)
    (hlog : Real.log 2 ≤ L) :
    1 / ((4 * primeEulerProductUpperConstant) * L) ≤
      ∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1 - 1 / (p : ℝ)) := by
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hC := primeEulerProductUpperConstant_pos
  have hsqrt : Real.sqrt L ≤ L := Real.sqrt_le_self_iff.mpr (Or.inr hL)
  have hbound := finite_prime_avoidance_product_lower
    (primeBand 0 (Real.exp (Real.sqrt L))) (fun _ hp => small_prime_pool_prime hp)
    (Real.one_le_exp_iff.mpr (Real.sqrt_nonneg L))
    (fun _ hp => small_prime_pool_le (Real.exp_nonneg _) hp)
  rw [Real.log_mul (by norm_num) (Real.exp_ne_zero _), Real.log_exp] at hbound
  apply le_trans _ hbound
  apply one_div_le_one_div_of_le
  · have hlog0 : 0 < Real.log 2 := Real.log_pos (by norm_num)
    positivity
  · nlinarith

theorem logarithmic_cell_length_lower {L Y : ℝ} (hY : 0 ≤ Y) (S : ℝ) :
    Y * L^(-S) ≤ Real.exp (L^(-S)) * Y - Y := by
  have h := mul_le_mul_of_nonneg_right (Real.add_one_le_exp (L^(-S))) hY
  nlinarith

theorem rough_logarithmic_cell_main_term_lower {L Y : ℝ} (hL : 1 ≤ L)
    (hlog : Real.log 2 ≤ L) (hY : 0 ≤ Y) (S : ℝ) :
    Y / ((4 * primeEulerProductUpperConstant) * L^(S + 1)) ≤
      (Real.exp (L^(-S)) * Y - Y) *
        (∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1 - 1 / (p : ℝ))) := by
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hC := primeEulerProductUpperConstant_pos
  have hlen := logarithmic_cell_length_lower (L := L) hY S
  have hV := rough_sqrt_avoidance_product_lower hL hlog
  have hV0 := (finite_prime_avoidance_product_pos
    (primeBand 0 (Real.exp (Real.sqrt L))) (fun _ hp => small_prime_pool_prime hp)).le
  have hlen0 : 0 ≤ Real.exp (L^(-S)) * Y - Y :=
    (mul_nonneg hY (Real.rpow_nonneg hL0.le _)).trans hlen
  have hmain := mul_le_mul hlen hV (by positivity) hlen0
  apply le_trans _ hmain
  apply le_of_eq
  rw [Real.rpow_add hL0, Real.rpow_one, Real.rpow_neg hL0.le]
  field_simp

end Bounty
end

section

/- Exact prime-divisibility moments within a residue class and their aggregate error. -/

open Finset

namespace Bounty

noncomputable def intervalResidueDivisibilityRemainder (A B r u d : ℕ) : ℝ :=
  (((Ioc A B).filter (fun n => n % r = u % r ∧ d ∣ n)).card : ℝ) -
    ((B : ℝ) - A) / (r * d : ℕ)

theorem coprime_prime_pool_product (P : Finset ℕ) (r : ℕ)
    (hP : ∀ p ∈ P, p.Prime) (hPr : ∀ p ∈ P, ¬p ∣ r) :
    r.Coprime (∏ p ∈ P, p) := by
  apply Nat.Coprime.prod_right
  intro p hp
  exact ((hP p hp).coprime_iff_not_dvd.mpr (hPr p hp)).symm

theorem interval_residue_prime_intersection_moment (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (A B r u : ℕ) (S : Finset ℕ) (hS : S ⊆ P) :
    (∑ _n ∈ ((Ioc A B).filter (fun n => n % r = u % r)).filter
        (fun n => ∀ p ∈ S, p ∣ n), (1 : ℝ)) =
      (((B : ℝ) - A) / r) * (∏ p ∈ S, 1 / (p : ℝ)) +
        intervalResidueDivisibilityRemainder A B r u (∏ p ∈ S, p) := by
  have hfilter : ((Ioc A B).filter (fun n => n % r = u % r)).filter
        (fun n => ∀ p ∈ S, p ∣ n) =
      (Ioc A B).filter (fun n => n % r = u % r ∧ (∏ p ∈ S, p) ∣ n) := by
    rw [filter_filter]
    apply filter_congr
    intro n _
    rw [prime_subset_product_dvd_iff S (fun p hp => hP p (hS hp)) n]
  have hrecip : (∏ p ∈ S, 1 / (p : ℝ)) = 1 / ((∏ p ∈ S, p : ℕ) : ℝ) := by
    simp only [one_div, prod_inv_distrib, Nat.cast_prod]
  rw [hfilter, hrecip]
  simp only [sum_const, nsmul_eq_mul, mul_one, intervalResidueDivisibilityRemainder,
    Nat.cast_mul, div_mul_eq_div_mul_one_div]
  ring

theorem interval_residue_divisibility_remainder_abs_le_one (A B r u d : ℕ)
    (hAB : A ≤ B) (hr : 0 < r) (hd : 0 < d) (hcop : r.Coprime d) :
    |intervalResidueDivisibilityRemainder A B r u d| ≤ 1 :=
  interval_residue_divisibility_error_le_one A B r u d hAB hr hd hcop

theorem interval_residue_divisibility_remainder_sum_le (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (r : ℕ) (hPr : ∀ p ∈ P, ¬p ∣ r)
    (A B u : ℕ) (hAB : A ≤ B) (hr : 0 < r) (D : ℝ) (hD : 0 ≤ D) :
    (∑ d ∈ blockSieveModuli P D, |intervalResidueDivisibilityRemainder A B r u d|) ≤ D := by
  have hcop := coprime_prime_pool_product P r hP hPr
  calc
    _ ≤ ∑ _d ∈ blockSieveModuli P D, (1 : ℝ) := by
      apply sum_le_sum
      intro d hd
      have hprop := block_sieve_modulus_properties P hP D hd
      exact interval_residue_divisibility_remainder_abs_le_one A B r u d hAB hr hprop.1
        (hcop.of_dvd_right hprop.2.2.2)
    _ = ((blockSieveModuli P D).card : ℝ) := by simp
    _ ≤ ((Icc 1 ⌊D⌋₊).card : ℝ) := by
      exact_mod_cast card_le_card (filter_subset (fun d => d ∣ ∏ p ∈ P, p) (Icc 1 ⌊D⌋₊))
    _ = (⌊D⌋₊ : ℝ) := by simp
    _ ≤ D := Nat.floor_le hD

end Bounty

end

section

/- Rescaling the wide candidate interval to the Carmichael counting scale. -/

open Filter

namespace Bounty

/- The prime supply produced by the product window `(X,16X]` after the
shift `u ↦ 2u+1`. This is an input contract until the construction is closed. -/
def WideSmoothShiftedPrimeSupply : Prop :=
  ∀ δ : ℝ, 0 < δ → δ < 1 / 4 → ∀ σ : ℝ, 0 < σ →
    ∀ᶠ x : ℝ in atTop, ∃ P : Finset ℕ,
      P ⊆ primeBand (2 * x) (33 * x) ∧ x ^ (1 - σ) ≤ (P.card : ℝ) ∧
      ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → (q : ℝ) ≤ x ^ δ

theorem eventually_rescaled_rpow_lower {k σ : ℝ} (hk : 0 < k)
    (hσ : 0 < σ) (a : ℝ) :
    ∀ᶠ y : ℝ in atTop, y ^ (a - σ) ≤ (y / k) ^ (a - σ / 2) := by
  filter_upwards [eventually_const_le_mul_rpow (by linarith : 0 < σ / 2)
    (by norm_num : (0 : ℝ) < 1) (k ^ (a - σ / 2)),
    eventually_gt_atTop (0 : ℝ)] with y hy hy0
  have hmul := mul_le_mul_of_nonneg_left hy (Real.rpow_nonneg hy0.le (a - σ))
  rw [one_mul] at hmul
  have heq : y ^ (a - σ) * y ^ (σ / 2) = y ^ (a - σ / 2) := by
    rw [← Real.rpow_add hy0]
    congr 1
    ring
  rw [heq] at hmul
  rw [Real.div_rpow hy0.le hk.le]
  exact (le_div_iff₀ (Real.rpow_pos_of_pos hk _)).mpr hmul

theorem eventually_rpow_le_quarter {δ : ℝ} (hδ : δ < 1) :
    ∀ᶠ y : ℝ in atTop, y ^ δ ≤ y / 4 := by
  filter_upwards [eventually_const_le_mul_rpow (by linarith : 0 < 1 - δ)
    (by norm_num : (0 : ℝ) < 1) 4,
    eventually_gt_atTop (0 : ℝ)] with y hy hy0
  have hmul := mul_le_mul_of_nonneg_left hy (Real.rpow_nonneg hy0.le δ)
  rw [one_mul] at hmul
  have heq : y ^ δ * y ^ (1 - δ) = y := by
    rw [← Real.rpow_add hy0]
    have hexp : δ + (1 - δ) = 1 := by ring
    rw [hexp, Real.rpow_one]
  rw [heq] at hmul
  linarith

/- The loss from rescaling is absorbed by half the freely chosen power loss. -/
theorem wide_smooth_supply_rescaled (hS : WideSmoothShiftedPrimeSupply)
    {δ σ : ℝ} (hδ : 0 < δ) (hδsmall : δ < 1 / 4) (hσ : 0 < σ) :
    ∀ᶠ y : ℝ in atTop, ∃ P : Finset ℕ,
      P ⊆ primeBand (y / 4) (5 * y) ∧ y ^ (1 - σ) ≤ (P.card : ℝ) ∧
      ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → (q : ℝ) ≤ y ^ δ := by
  have ht : Tendsto (fun y : ℝ => y / 8) atTop atTop :=
    Filter.Tendsto.atTop_div_const (by norm_num) tendsto_id
  filter_upwards [ht.eventually (hS δ hδ hδsmall (σ / 2) (by linarith)),
    eventually_rescaled_rpow_lower (by norm_num : (0 : ℝ) < 8) hσ 1,
    eventually_ge_atTop (1 : ℝ)] with y hSy hcard hy
  obtain ⟨P, hP, hN, hsmooth⟩ := hSy
  have hy0 : 0 ≤ y := by linarith
  refine ⟨P, ?_, hcard.trans hN, ?_⟩
  · intro p hp
    obtain ⟨hpp, hlo, hhi⟩ := (mem_primeBand_iff (by positivity) (by positivity) p).mp (hP hp)
    exact (mem_primeBand_iff (by positivity) (by positivity) p).mpr
      ⟨hpp, by linarith, by linarith⟩
  · intro p hp q hq hdiv
    exact (hsmooth p hp q hq hdiv).trans
      (Real.rpow_le_rpow (by positivity) (by linarith : y / 8 ≤ y) hδ.le)

/- Ambient cancellation on the wide interval used after rescaling. -/
def WideAmbientPrimeCancellationAt (β : ℝ) : Prop :=
  ∀ δ : ℝ, 0 < δ → δ < 1 / 16 → ∀ σ : ℝ, 0 < σ →
    ∀ᶠ y : ℝ in atTop, ∀ L : ℕ, 0 < L →
      Real.log (L : ℝ) ≤ y ^ δ * Real.log (5 * y) →
      ∀ χ : DirichletCharacter ℂ L, χ ≠ 1 →
        ‖∑ p ∈ primeBand (y / 4) (5 * y), χ (p : ZMod L)‖ ≤
          y ^ (β + 2 * δ + σ)

/- A wide smooth supply gives the same reservoir contract as the original
narrow supply. The final counting theorem therefore needs no modification. -/
theorem powerPrimeReservoir_of_wide_analytic_inputs_at {β : ℝ}
    (hS : WideSmoothShiftedPrimeSupply) (hC : WideAmbientPrimeCancellationAt β)
    {δ σ : ℝ} (hδ : 0 < δ) (hδsmall : δ < 1 / 16) (hσ : 0 < σ) :
    ∀ᶠ y : ℝ in atTop, PowerPrimeReservoirAt β δ σ y := by
  filter_upwards [wide_smooth_supply_rescaled hS hδ (by linarith) hσ,
    hC δ hδ hδsmall σ hσ,
    eventually_unitGroup_log_natLog_le_rpow δ hσ,
    eventually_rpow_le_quarter (by linarith : δ < 1),
    eventually_ge_atTop (1 : ℝ)] with y hSy hCy hGy hquarter hy
  obtain ⟨P, hPS, hPcard, hPsmooth⟩ := hSy
  have hy0 : 0 ≤ y := by linarith
  have hprime : ∀ p ∈ primeBand (y / 4) (5 * y), p.Prime := by
    intro p hp
    exact ((mem_primeBand_iff (by positivity) (by positivity) p).mp hp).1
  have hinterval : ∀ p ∈ primeBand (y / 4) (5 * y),
      y / 4 < (p : ℝ) ∧ (p : ℝ) ≤ 5 * y := by
    intro p hp
    exact ((mem_primeBand_iff (by positivity) (by positivity) p).mp hp).2
  obtain ⟨L, g, hL, hdiv, _, hlog, _, hcompat⟩ :=
    exists_real_smooth_prime_modulus_above_smoothness hy P (primeBand (y / 4) (5 * y))
      hPS hprime (fun p hp => (hinterval p hp).2)
      (fun p hp => hquarter.trans_lt (hinterval p hp).1) hPsmooth
  obtain ⟨hGlog, hGnatlog⟩ := hGy L hL hlog
  refine ⟨L, primeBand (y / 4) (5 * y), P, g, hL, hPS, hprime,
    (fun p hp => (hinterval p hp).2), hdiv,
    (fun p hp => hcompat p (hPS hp)), hPcard, hGlog, hGnatlog, ?_⟩
  intro ξ hξ
  exact unitCharacter_sum_bound_of_dirichlet (primeBand (y / 4) (5 * y)) g hcompat
    (hCy L hL hlog) ξ hξ

theorem target_of_wide_smooth_supply_and_cancellation {β : ℝ} (hβ : β < 1)
    (hS : WideSmoothShiftedPrimeSupply) (hC : WideAmbientPrimeCancellationAt β) :
    fcTypeOfName% "Erdos1057.erdos_1057" := by
