/- Actual candidate omission counts suppress every fixed polynomial cost
at the manuscript cap ceil(L^2), after choosing J once and before L grows. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem binomial_omission_power_lower (J ell n : ℕ) (c L : ℝ)
    (hL : 0 < L) (hn : c * Real.log L ≤ (n : ℝ)) :
    L ^ (c * Real.log (((J + ell).choose ell : ℕ) : ℝ)) ≤
      (((J + ell).choose ell : ℕ) : ℝ) ^ n := by
  have hq : 0 < (J + ell).choose ell := Nat.choose_pos (by omega)
  have hqR : 0 < (((J + ell).choose ell : ℕ) : ℝ) := by exact_mod_cast hq
  have hq1 : 1 ≤ (((J + ell).choose ell : ℕ) : ℝ) := by exact_mod_cast hq
  calc
    _ = (((J + ell).choose ell : ℕ) : ℝ) ^ (c * Real.log L) := by
      rw [Real.rpow_def_of_pos hL, Real.rpow_def_of_pos hqR]
      congr 1
      ring
    _ ≤ (((J + ell).choose ell : ℕ) : ℝ) ^ (n : ℝ) :=
      Real.rpow_le_rpow_of_exponent_le hq1 hn
    _ = _ := Real.rpow_natCast _ _

theorem ceil_square_omission_sqrt_le (J ell n : ℕ) (c L : ℝ)
    (hL : 1 ≤ L) (hn : c * Real.log L ≤ (n : ℝ)) :
    Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) / (((J + ell).choose ell) ^ n : ℕ)) ≤
      2 * L ^ (1 - (c / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ)) := by
  have hL0 : 0 < L := by linarith
  have hB : (⌈L ^ 2⌉₊ : ℝ) ≤ 4 * L ^ 2 := by
    have hceil := Nat.ceil_lt_add_one (sq_nonneg L)
    nlinarith
  have hden := binomial_omission_power_lower J ell n c L hL0 hn
  have hq : 0 < (((J + ell).choose ell : ℕ) : ℝ) := by
    exact_mod_cast (Nat.choose_pos (show ell ≤ J + ell by omega))
  have hsquare :
      (2 * L ^ (1 - (c / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ))) ^ 2 =
        4 * L ^ 2 / L ^ (c * Real.log (((J + ell).choose ell : ℕ) : ℝ)) := by
    calc
      _ = 4 * (L ^ (1 - (c / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ)) *
        L ^ (1 - (c / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ))) := by ring
      _ = 4 * L ^ ((2 : ℝ) - c * Real.log (((J + ell).choose ell : ℕ) : ℝ)) := by
        rw [← Real.rpow_add hL0]
        congr 1
        congr 1
        ring
      _ = _ := by rw [Real.rpow_sub hL0, Real.rpow_two]; ring
  apply Real.sqrt_le_iff.mpr
  refine ⟨by positivity, ?_⟩
  rw [hsquare, Nat.cast_pow]
  calc
    _ ≤ (4 * L ^ 2) / ((((J + ell).choose ell : ℕ) : ℝ) ^ n) :=
      div_le_div_of_nonneg_right hB (pow_nonneg hq.le _)
    _ ≤ _ := div_le_div_of_nonneg_left (by positivity)
      (Real.rpow_pos_of_pos hL0 _) hden

theorem four_mul_rpow_le_half_of_gap (a b L : ℝ)
    (hgap : a + 2 ≤ b) (hL : 4 ≤ L) :
    4 * L ^ a ≤ (1 / 2 : ℝ) * L ^ b := by
  have hL0 : 0 < L := by linarith
  have hcoeff : (4 : ℝ) ≤ L ^ 2 / 2 := by nlinarith
  calc
    _ ≤ (L ^ 2 / 2) * L ^ a :=
      mul_le_mul_of_nonneg_right hcoeff (Real.rpow_nonneg hL0.le _)
    _ = (1 / 2 : ℝ) * L ^ (a + 2) := by
      rw [Real.rpow_add hL0, Real.rpow_two]
      ring
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (Real.rpow_le_rpow_of_exponent_le (by linarith) hgap) (by norm_num)

theorem eventually_candidate_rare_transfer_decay {s : ℝ} (hs : 0 < s) (ell : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ (J : ℕ) (A E : ℝ),
      ((1 / (20 * Real.log 2)) / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ) > A + E + 3 →
      2 * L ^ A * Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) /
        (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ)) ≤
          (1 / 2 : ℝ) * L ^ (-E) := by
  obtain ⟨v, V, _, _, hpool⟩ := exists_candidate_P_pool_bounds hs
  filter_upwards [hpool, eventually_ge_atTop (4 : ℝ)] with L hp hL
  intro J A E hgain
  have hL0 : 0 < L := by linarith
  have hr := ceil_square_omission_sqrt_le J ell (candidateSmallPIndices s L).card
    (1 / (20 * Real.log 2)) L (by linarith) hp.2.1
  calc
    _ ≤ 2 * L ^ A * (2 * L ^ (1 - ((1 / (20 * Real.log 2)) / 2) *
        Real.log (((J + ell).choose ell : ℕ) : ℝ))) :=
      mul_le_mul_of_nonneg_left hr (by positivity)
    _ = 4 * L ^ (A + 1 - ((1 / (20 * Real.log 2)) / 2) *
        Real.log (((J + ell).choose ell : ℕ) : ℝ)) := by
      rw [show A + 1 - ((1 / (20 * Real.log 2)) / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ) =
        A + (1 - ((1 / (20 * Real.log 2)) / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ)) by ring,
        Real.rpow_add hL0]
      ring
    _ ≤ _ := four_mul_rpow_le_half_of_gap _ _ L (by linarith) hL

theorem exists_candidate_rare_transfer_parameter {s : ℝ} (hs : 0 < s)
    (ell : ℕ) (hell : 0 < ell) (J₀ : ℕ) (A E : ℝ) :
    ∃ J : ℕ, J₀ ≤ J ∧
      ((1 / (20 * Real.log 2)) / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ) > A + E + 3 ∧
      ∀ᶠ L : ℝ in atTop,
        2 * L ^ A * Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) /
          (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ)) ≤
            (1 / 2 : ℝ) * L ^ (-E) := by
  have hc : 0 < (1 / (20 * Real.log 2) : ℝ) / 2 := by
    have hlog : 0 < Real.log (2 : ℝ) := Real.log_pos (by norm_num)
    positivity
  obtain ⟨J, hJ, hlog⟩ := exists_log_choose_add_gt_ge ell hell
    ((A + E + 3) / ((1 / (20 * Real.log 2)) / 2)) J₀
  have hgain : ((1 / (20 * Real.log 2)) / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ) > A + E + 3 := by
    simpa only [mul_comm] using (div_lt_iff₀ hc).mp hlog
  refine ⟨J, hJ, hgain, ?_⟩
  filter_upwards [eventually_candidate_rare_transfer_decay hs ell] with L hL
  exact hL J A E hgain

end Bounty
end

section

/- Forest compatibility split by original owners, using exact optional prime-label presence. -/

open Finset Classical

namespace Bounty

def birthForestStageCondition {N L : ℕ} {α : Type*}
    (owner : Fin N → Fin L) (u : Fin L) (values : Fin N → Option α) (code : BirthForestCode N) : Prop :=
  ∀ i, owner i = u → match code i with
    | none => True
    | some p => (values (birthForestParentEmbedding i p)).isSome = true ∧
        (values i).isSome = true ∧ values (birthForestParentEmbedding i p) = values i

theorem birth_forest_compatible_iff_stages {N L : ℕ} {α : Type*}
    (owner : Fin N → Fin L) (values : Fin N → Option α) (code : BirthForestCode N) :
    birthForestCompatible (fun i => (values i).isSome = true) values code ↔
      ∀ u, birthForestStageCondition owner u values code := by
  constructor
  · intro h u i _
    exact h i
  · intro h i
    exact h (owner i) i rfl

theorem birth_forest_stage_congr {N L : ℕ} {α : Type*}
    (owner : Fin N → Fin L) (hmono : Monotone owner) (u : Fin L)
    (values other : Fin N → Option α) (code : BirthForestCode N)
    (hvalues : ∀ i, owner i ≤ u → values i = other i) :
    birthForestStageCondition owner u values code ↔ birthForestStageCondition owner u other code := by
  have hi : ∀ i (_hu : owner i = u),
      (match code i with
        | none => True
        | some p => (values (birthForestParentEmbedding i p)).isSome = true ∧
            (values i).isSome = true ∧ values (birthForestParentEmbedding i p) = values i) ↔
      (match code i with
        | none => True
        | some p => (other (birthForestParentEmbedding i p)).isSome = true ∧
            (other i).isSome = true ∧ other (birthForestParentEmbedding i p) = other i) := by
    intro i hu
    cases hc : code i with
    | none => exact Iff.rfl
    | some p =>
      have hp : owner (birthForestParentEmbedding i p) ≤ u :=
        (hmono (show birthForestParentEmbedding i p ≤ i from Nat.le_of_lt p.isLt)).trans hu.le
      dsimp only
      rw [hvalues i hu.le, hvalues _ hp]
  constructor <;> intro h i hu
  · exact (hi i hu).mp (h i hu)
  · exact (hi i hu).mpr (h i hu)

theorem prod_condition_indicators {I : Type*} [Fintype I]
    (C : I → Prop) [DecidablePred C] :
    (∏ i, if C i then (1 : ℝ) else 0) = if ∀ i, C i then 1 else 0 := by
  by_cases h : ∀ i, C i
  · simp only [if_pos h, if_pos (h _), prod_const_one]
  · rw [if_neg h]
    obtain ⟨i, hi⟩ := not_forall.mp h
    exact prod_eq_zero (mem_univ i) (if_neg hi)

end Bounty
end

section

/- Converting ordinary theta increments to prime counts in finite intervals. -/

open Finset

namespace Bounty

theorem ordinary_prime_band_log_sum {A B : ℝ} (hAB : A ≤ B) :
    (∑ p ∈ primeBand A B, Real.log (p : ℝ)) = Chebyshev.theta B - Chebyshev.theta A := by
  have hfloor := Nat.floor_le_floor hAB
  have hset : Ioc ⌊A⌋₊ ⌊B⌋₊ = Ico (⌊A⌋₊ + 1) (⌊B⌋₊ + 1) := by
    ext n
    simp only [mem_Ioc, mem_Ico]
    omega
  have hsum := sum_Ico_eq_sub (fun n : ℕ => if n.Prime then Real.log (n : ℝ) else 0)
    (Nat.add_le_add_right hfloor 1)
  rw [← hset] at hsum
  simpa only [primeBand, Chebyshev.theta_eq_sum_Icc, sum_filter,
    Nat.range_succ_eq_Icc_zero] using hsum

theorem ordinary_prime_band_card_log_bounds {A B : ℝ} (hA : 1 < A) (hAB : A ≤ B) :
    (primeBand A B).card * Real.log A ≤ Chebyshev.theta B - Chebyshev.theta A ∧
    Chebyshev.theta B - Chebyshev.theta A ≤ (primeBand A B).card * Real.log B := by
  rw [← ordinary_prime_band_log_sum hAB]
  constructor
  · calc
      _ = ∑ p ∈ primeBand A B, Real.log A := by simp
      _ ≤ _ := sum_le_sum fun p hp => by
        have hm := (mem_primeBand_iff (by linarith) (by linarith) p).mp hp
        exact Real.log_le_log (by linarith) hm.2.1.le
  · calc
      _ ≤ ∑ p ∈ primeBand A B, Real.log B := sum_le_sum fun p hp => by
        have hm := (mem_primeBand_iff (by linarith) (by linarith) p).mp hp
        exact Real.log_le_log (by linarith) hm.2.2
      _ = _ := by simp

theorem ordinary_prime_band_relative_error {A B ε : ℝ}
    (hA : 1 < A) (hAB : A ≤ B) (hε : 0 ≤ ε)
    (hθ : |(Chebyshev.theta B - Chebyshev.theta A) - (B-A)| ≤ ε*(B-A))
    (hlog : Real.log B ≤ (1+ε)*Real.log A) :
    |(primeBand A B).card - (B-A)/Real.log A| ≤ 2*ε*((B-A)/Real.log A) := by
  have hL : 0 < Real.log A := Real.log_pos hA
  have hH : 0 ≤ B-A := sub_nonneg.mpr hAB
  have hN : (0 : ℝ) ≤ (primeBand A B).card := Nat.cast_nonneg _
  have hb := ordinary_prime_band_card_log_bounds hA hAB
  have he := abs_le.mp hθ
  have hupper : (primeBand A B).card * Real.log A ≤ (1+ε)*(B-A) := by linarith
  have hfactor : (1-ε)*(B-A) ≤ (1+ε)*((primeBand A B).card * Real.log A) := by
    have hh := mul_le_mul_of_nonneg_left hlog hN
    nlinarith
  have hden : 0 < 1+ε := by linarith
  have hlo : (1-2*ε)*(B-A) ≤ (primeBand A B).card * Real.log A := by
    calc
      _ ≤ (1-ε)*(B-A)/(1+ε) := (le_div_iff₀ hden).mpr (by
        nlinarith [mul_nonneg (sq_nonneg ε) hH])
      _ ≤ _ := (div_le_iff₀ hden).mpr (by nlinarith [hfactor])
  have hlo' : (1-2*ε)*((B-A)/Real.log A) ≤ (primeBand A B).card := by
    rw [← mul_div_assoc]
    exact (div_le_iff₀ hL).mpr hlo
  have hup' : (primeBand A B).card ≤ (1+ε)*((B-A)/Real.log A) := by
    rw [← mul_div_assoc]
    exact (le_div_iff₀ hL).mpr hupper
  have hM : 0 ≤ (B-A)/Real.log A := div_nonneg hH hL.le
  apply abs_le.mpr
  constructor <;> nlinarith [mul_nonneg hε hM]

end Bounty
end

section

open Finset

namespace Bounty

theorem separated_odd_prime_sieve_remainders_le (P Q : Finset ℕ) (D : ℝ) (N : ℕ)
    (r : ℕ → ℝ) (hP : ∀ p ∈ P, p.Prime) (hQ : ∀ p ∈ Q, p.Prime)
    (hPodd : ∀ p ∈ P, p ≠ 2) (hQodd : ∀ p ∈ Q, p ≠ 2)
    (hout : ∀ p ∈ Q, p ∉ P)
    (hlevel : ∀ p ∈ Q, ∀ d ∈ blockSieveModuli P D, p * d ≤ N) :
    (∑ p ∈ Q, ∑ d ∈ blockSieveModuli P D, |r (p * d)|) ≤
      ∑ m ∈ oddSquarefreeModuli N, |r m| := by
  classical
  let f : ℕ × ℕ → ℕ := fun x => x.1 * x.2
  have hsubset : (Q ×ˢ blockSieveModuli P D).image f ⊆ oddSquarefreeModuli N := by
    intro m hm
    obtain ⟨⟨p, d⟩, hpd, rfl⟩ := mem_image.mp hm
    obtain ⟨hp, hd⟩ := mem_product.mp hpd
    have hdprop := block_sieve_modulus_properties P hP D hd
    apply mem_filter.mpr
    refine ⟨mem_Icc.mpr ⟨Nat.mul_pos (hQ p hp).pos hdprop.1, hlevel p hp d hd⟩, ?_⟩
    refine ⟨Nat.squarefree_mul_iff.mpr
      ⟨external_prime_coprime_sieve_modulus P hP (hQ p hp) (hout p hp) hd,
        (hQ p hp).squarefree, hdprop.2.2.1⟩, ?_⟩
    have hprod : Odd (∏ q ∈ P, q) := by
      apply prod_induction (fun q : ℕ => q) Odd
      · intro a b ha hb
        exact ha.mul hb
      · decide
      · intro q hq
        exact (hP q hq).odd_of_ne_two (hPodd q hq)
    exact ((hQ p hp).odd_of_ne_two (hQodd p hp)).mul
      (hprod.of_dvd_nat hdprop.2.2.2)
  calc
    _ = ∑ x ∈ Q ×ˢ blockSieveModuli P D, |r (f x)| := (sum_product _ _ _).symm
    _ = ∑ m ∈ (Q ×ˢ blockSieveModuli P D).image f, |r m| :=
      (sum_image (f := fun m => |r m|)
        (separated_prime_sieve_product_injective P Q D hP hQ hout)).symm
    _ ≤ _ := sum_le_sum_of_subset_of_nonneg hsubset (fun m _ _ => abs_nonneg (r m))


theorem exists_summed_external_odd_prime_shifted_sieve :
    ∃ K : ℝ, 0 < K ∧ ∀ (P Q T : Finset ℕ) (μ : ℕ → ℝ) (N : ℕ)
      {z : ℝ} {h : ℕ},
      1 < z → 1 ≤ h → Even h →
      (∀ q ∈ P, q.Prime) → (∀ q ∈ P, q ≠ 2) →
      (∀ q ∈ P, (q : ℝ) ≤ z) → (∀ p ∈ Q, p.Prime) →
      (∀ p ∈ Q, p ≠ 2) → (∀ p ∈ Q, p ∉ P) → (∀ u ∈ T, 0 ≤ μ u) →
      (∀ p ∈ Q, ∀ d ∈ blockSieveModuli P (z^(4 * (h : ℝ) + 2)), p*d ≤ N) →
      |(∑ p ∈ Q, ∑ u ∈ T.filter
          (fun u => p ∣ 2*u + 1 ∧ ∀ q ∈ P, ¬q ∣ 2*u + 1), μ u) -
          (∑ u ∈ T, μ u) * (∏ q ∈ P, (1 - 1 / ((q : ℝ) - 1))) *
            (∑ p ∈ Q, 1 / ((p : ℝ) - 1))| ≤
        (∑ u ∈ T, μ u) * (∏ q ∈ P, (1 - 1 / ((q : ℝ) - 1))) *
          (∑ p ∈ Q, 1 / ((p : ℝ) - 1)) * K * Real.exp (-(h : ℝ)) +
          ∑ m ∈ oddSquarefreeModuli N, |shiftedTotientSieveRemainder T μ m| := by
  obtain ⟨K, hK, hsieve⟩ := exists_fixed_prime_shifted_sieve
  refine ⟨K, hK, ?_⟩
  intro P Q T μ N z h hz hh heven hP hodd hPz hQ hQodd hout hμ hlevel
  let X : ℝ := ∑ u ∈ T, μ u
  let A : ℝ := ∏ q ∈ P, (1 - 1 / ((q : ℝ) - 1))
  let H : ℝ := ∑ p ∈ Q, 1 / ((p : ℝ) - 1)
  let D : ℝ := z^(4 * (h : ℝ) + 2)
  let r : ℕ → ℝ := shiftedTotientSieveRemainder T μ
  let F : ℕ → ℝ := fun p => ∑ u ∈ T.filter
    (fun u => p ∣ 2*u + 1 ∧ ∀ q ∈ P, ¬q ∣ 2*u + 1), μ u
  have hfixed : ∀ p ∈ Q,
      |F p - (X / ((p : ℝ) - 1)) * A| ≤
        (X / ((p : ℝ) - 1)) * A * K * Real.exp (-(h : ℝ)) +
          ∑ d ∈ blockSieveModuli P D, |r (p*d)| := by
    intro p hp
    exact hsieve P T μ p hz hh heven (hQ p hp) (hout p hp) hP hodd hPz hμ
  have hmain : (∑ p ∈ Q, (X / ((p : ℝ) - 1)) * A) = X*A*H := by
    dsimp only [H]
    rw [mul_sum]
    apply sum_congr rfl
    intro p _
    ring
  change |(∑ p ∈ Q, F p) - X*A*H| ≤
    X*A*H*K*Real.exp (-(h : ℝ)) + ∑ m ∈ oddSquarefreeModuli N, |r m|
  calc
    _ = |∑ p ∈ Q, (F p - (X / ((p : ℝ) - 1)) * A)| := by
      rw [sum_sub_distrib, hmain]
    _ ≤ ∑ p ∈ Q, |F p - (X / ((p : ℝ) - 1)) * A| := abs_sum_le_sum_abs _ _
    _ ≤ ∑ p ∈ Q, ((X / ((p : ℝ) - 1)) * A * K * Real.exp (-(h : ℝ)) +
        ∑ d ∈ blockSieveModuli P D, |r (p*d)|) := sum_le_sum hfixed
    _ = X*A*H*K*Real.exp (-(h : ℝ)) +
        ∑ p ∈ Q, ∑ d ∈ blockSieveModuli P D, |r (p*d)| := by
      rw [sum_add_distrib, ← sum_mul, ← sum_mul, hmain]
    _ ≤ _ := add_le_add le_rfl
      (separated_odd_prime_sieve_remainders_le P Q D N r hP hQ hodd hQodd hout hlevel)


end Bounty
end

