section

/- Exact complementary event masks for the actual mixed coefficient and
signed prime family; the fixed initial exclusion remains inside the row. -/

open Finset
open scoped Classical
namespace Bounty
section
variable {S G : Type} [Fintype S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}

noncomputable def physicalMixedCleanPhase (C : G → Finset (Fin J)) (k : ℤ)
    (Ψ : ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
      PhysicalMixedCoefficientEvent C k a s → ℂ)
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (e : PhysicalMixedCoefficientEvent C k a s) : ℂ :=
  if ∀ g, (e.2.2 g).1 = ∅ ∧ (e.2.2 g).2.1 = ∅ then Ψ a s e else 0

theorem physical_mixed_coefficient_clean_dirty
    (C : G → Finset (Fin J)) (k : ℤ)
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (initial : ∀ g, Finset (P g))
    (Ψ : ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
      PhysicalMixedCoefficientEvent C k a s → ℂ)
    (f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ) :
    physicalMixedCoefficientAction C k V b ρ Vs q initial Ψ f =
      physicalMixedCoefficientAction C k V b ρ Vs q initial (physicalMixedCleanPhase C k Ψ) f +
      physicalMixedCoefficientAction C k V b ρ Vs q initial (physicalMixedDirtyPhase C k Ψ) f := by
  funext s
  simp only [physicalMixedCoefficientAction, physicalSmallBigFullPhasedAction,
    physicalSmallBigPhasedAction, Pi.add_apply, mul_sum, ← sum_add_distrib]
  apply sum_congr rfl
  intro a _
  apply sum_congr rfl
  intro e _
  unfold physicalMixedCleanPhase physicalMixedDirtyPhase
  split_ifs <;> ring

theorem physical_mixed_prime_family_clean_dirty
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    (Q : ℕ) (h ξ : ℝ) (k : ℤ) (initial : ∀ g, Finset (P g))
    (φ : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
        PhysicalMixedCoefficientEvent (repeatedBigPrimePatternCut probes r t i) k a s → ℂ)
    (f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ) :
    physicalMixedPrimePatternAction V b ρ Vs q probes r t hrt Q h ξ k initial φ f =
      physicalMixedPrimePatternAction V b ρ Vs q probes r t hrt Q h ξ k initial
        (fun i => physicalMixedCleanPhase (repeatedBigPrimePatternCut probes r t i) k (φ i)) f +
      physicalMixedPrimePatternAction V b ρ Vs q probes r t hrt Q h ξ k initial
        (fun i => physicalMixedDirtyPhase (repeatedBigPrimePatternCut probes r t i) k (φ i)) f := by
  unfold physicalMixedPrimePatternAction
  rw [← sum_add_distrib]
  apply sum_congr rfl
  intro i _
  refine (physical_mixed_coefficient_clean_dirty
    (repeatedBigPrimePatternCut probes r t i) k V b ρ Vs q initial _ f).trans ?_
  apply congrArg₂ (fun x y : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ => x + y)
  all_goals
    apply congrArg (fun Ψ => physicalMixedCoefficientAction
      (repeatedBigPrimePatternCut probes r t i) k V b ρ Vs q initial Ψ f)
    funext a y e
  · unfold physicalMixedCleanPhase
    split_ifs <;> simp_all
  · unfold physicalMixedDirtyPhase
    split_ifs <;> simp_all

theorem physical_small_big_joint_average_add [DecidableEq S]
    (f g : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ) :
    physicalSmallBigJointAverage (f + g) = physicalSmallBigJointAverage f + physicalSmallBigJointAverage g := by
  funext s
  simp only [physical_small_big_joint_average_eq_sum, Pi.add_apply, mul_add, sum_add_distrib]

end
end Bounty
