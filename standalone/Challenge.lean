/- The modulus imposed by the predecessors of a prime reservoir. -/
def primePredecessorLCM (P : Finset ℕ) : ℕ := P.lcm (fun p => p - 1)

theorem primePredecessorLCM_pos {P : Finset ℕ} (hP : ∀ p ∈ P, Nat.Prime p) :
    0 < primePredecessorLCM P := by
  apply Nat.pos_of_ne_zero
  apply Finset.lcm_ne_zero_iff.mpr
  intro p hp
  have := (hP p hp).two_le
  omega

theorem predecessor_dvd_primePredecessorLCM {P : Finset ℕ} {p : ℕ} (hp : p ∈ P) :
    p - 1 ∣ primePredecessorLCM P := Finset.dvd_lcm hp

theorem primePredecessorLCM_smooth {P : Finset ℕ} (hP : ∀ p ∈ P, Nat.Prime p)
    {K : ℕ} (hsmooth : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → q ≤ K)
    {q : ℕ} (hq : q ∈ (primePredecessorLCM P).primeFactors) : q ≤ K := by
  apply primeFactors_lcm_le P (fun p => p - 1) _ hsmooth hq
  intro p hp
  have := (hP p hp).two_le
  omega

theorem log_primePredecessorLCM_le {P : Finset ℕ} (hP : ∀ p ∈ P, Nat.Prime p)
    {B K : ℕ} (hB : 1 ≤ B) (hbound : ∀ p ∈ P, p - 1 ≤ B)
    (hsmooth : ∀ p ∈ P, ∀ q : ℕ, q.Prime → q ∣ p - 1 → q ≤ K) :
    Real.log (primePredecessorLCM P : ℝ) ≤ (K : ℝ) * Real.log (B : ℝ) := by
  apply log_smooth_lcm_le P (fun p => p - 1) _ hB hbound hsmooth
  intro p hp
  have := (hP p hp).two_le
  omega

/- Any prime larger than every prime factor of a positive modulus is coprime to it. -/
theorem prime_coprime_of_primeFactors_lt {p L : ℕ} (hp : p.Prime) (hL : 0 < L)
    (hsmall : ∀ q ∈ L.primeFactors, q < p) : p.Coprime L := by
  apply hp.coprime_iff_not_dvd.mpr
  intro hdiv
  have hmem : p ∈ L.primeFactors :=
    (Nat.mem_primeFactors_of_ne_zero (ne_of_gt hL)).mpr ⟨hp, hdiv⟩
  exact (Nat.lt_irrefl p) (hsmall p hmem)
















/- There are at most `L` unit residues modulo a positive integer `L`. -/
theorem card_zmod_units_le {L : ℕ} (hL : 0 < L) : Nat.card (ZMod L)ˣ ≤ L := by
  let : NeZero L := ⟨ne_of_gt hL⟩
  have h := Nat.card_le_card_of_injective (fun u : (ZMod L)ˣ => (u : ZMod L))
    Units.val_injective
  simpa only [Nat.card_zmod] using h






end

