/- Summing a uniquely selected source evaluates its initial weight exactly. -/

open Finset
open scoped Classical
namespace Bounty

theorem finite_selected_source_pairing {D M : Type*} [Fintype M]
    (S : Finset D) (a : M → ℂ) (w H : D → ℂ) (source : D → M)
    (F : D → M → ℂ)
    (hF : ∀ d ∈ S, ∀ m, F d m = if m = source d then H d else 0) :
    (∑ m, a m * ∑ d ∈ S, w d * F d m) =
      ∑ d ∈ S, a (source d) * (w d * H d) := by
  simp only [mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro d hd
  simp_rw [hF d hd]
  simp only [mul_ite, mul_zero]
  simp

