open Finset
theorem ordered_slot_product_sum_mono {I : Type*} [Fintype I] [DecidableEq I]
    (A B : I → Finset ℕ) (hAB : ∀ i, A i ⊆ B i) (F : ℕ → ℝ)
    (hF : ∀ n, 0 ≤ F n) :
    (∑ x : ∀ i, A i, F (orderedSlotProduct A x)) ≤
      ∑ y : ∀ i, B i, F (orderedSlotProduct B y) := by
  classical
  let f : (∀ i, A i) → (∀ i, B i) := fun x i => ⟨(x i).val, hAB i (x i).property⟩
  have hf : Function.Injective f := by
    intro x y hxy
    funext i
    exact Subtype.ext (congrArg (fun z => (z i).val) hxy)
  calc
    _ = ∑ y ∈ univ.image f, F (orderedSlotProduct B y) := by
      rw [sum_image]
      · rfl
      · intro x hx y hy hxy
        exact hf hxy
    _ ≤ _ := sum_le_sum_of_subset_of_nonneg (subset_univ _)
      (fun y _ _ => hF (orderedSlotProduct B y))

theorem ordered_slot_weight_mono {I : Type*} [Fintype I]
    (A B : I → Finset ℕ) (hAB : ∀ i, A i ⊆ B i)
    {N : ℝ} (hN : 0 ≤ N) (n : ℕ) :
    orderedSlotWeight A N n ≤ orderedSlotWeight B N n := by
  classical
  exact ordered_slot_product_sum_mono A B hAB
    (fun k => if k = n then 1 / N else 0) (fun k => by split_ifs <;> positivity)
end

