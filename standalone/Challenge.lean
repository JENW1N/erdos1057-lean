theorem positive_log_distance_le_factor_two {p q : ℝ} (hp : 0 < p) (hq : 0 < q)
    (hlog : |Real.log p - Real.log q| ≤ Real.log 2) :
    q / 2 ≤ p ∧ p ≤ 2 * q := by
  have hh := abs_le.mp hlog
  have hq2 : 0 < 2 * q := mul_pos (by norm_num) hq
  have hp2 : 0 < 2 * p := mul_pos (by norm_num) hp
  have hupper : Real.log p ≤ Real.log (2 * q) := by
    rw [Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) hq.ne']
    linarith
  have hlower : Real.log q ≤ Real.log (2 * p) := by
    rw [Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) hp.ne']
    linarith
  have hu := (Real.log_le_log_iff hp hq2).mp hupper
  have hl := (Real.log_le_log_iff hq hp2).mp hlower
  constructor <;> linarith



end

section
open Finset
open scoped Classical
theorem finite_coordinate_component_append {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (A : Finset I) (is js : List I) (f : (∀ i, X i) → ℂ) :
    finiteCoordinateComponent μ A (is ++ js) f =
      finiteCoordinateComponent μ A is (finiteCoordinateComponent μ A js f) := by
  induction is with
  | nil => rfl
  | cons i is ih => simp only [List.cons_append, finiteCoordinateComponent, ih]

/- Probing all slots in A after averaging disjoint tail slots B is exactly the
single component used by the quantitative probe bound. -/
theorem finite_probe_after_tail_component {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (A B : Finset I) (hAB : Disjoint A B) (f : (∀ i, X i) → ℂ) :
    finiteCoordinateComponent μ A A.toList (finiteCoordinateComponent μ ∅ B.toList f) =
      finiteCoordinateComponent μ A (A ∪ B).toList f := by
  have hinner : finiteCoordinateComponent μ A B.toList f =
      finiteCoordinateComponent μ ∅ B.toList f := by
    apply finite_coordinate_component_congr
    intro i hi
    have hiB : i ∈ B := mem_toList.mp hi
    have hiA : i ∉ A := fun hiA => disjoint_left.mp hAB hiA hiB
    simp [hiA]
  rw [← hinner, ← finite_coordinate_component_append]
  apply finite_coordinate_component_perm
  have hdis : List.Disjoint A.toList B.toList := by
    intro i hiA hiB
    exact disjoint_left.mp hAB (mem_toList.mp hiA) (mem_toList.mp hiB)
  have hn : (A.toList ++ B.toList).Nodup := A.nodup_toList.append B.nodup_toList hdis
  apply List.perm_of_nodup_nodup_toFinset_eq hn (A ∪ B).nodup_toList
  simp

theorem finite_symmetric_probe_tensor_tail_energy {G : Type*} [Fintype G] [DecidableEq G]
    {I X : G → Type*} [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)] [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (hμ : ∀ g x, 0 ≤ μ g x) (hmass : ∀ g, ∑ x, μ g x = 1)
    (A B : ∀ g, Finset (I g)) (hAB : ∀ g, Disjoint (A g) (B g))
    (m ell : ℕ) (hm : 0 < m) (hA : ∀ g, (A g).card = m) (hB : ∀ g, (B g).card = ell)
    (s t : Finset G) (f : (∀ g, I g → X g) → ℂ) (hf : ∀ g, finiteGroupSlotSymmetric g f) :
    finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g)))
      (finiteCoordinateFinsetAction (fun g v => finiteCoordinateComponent (fun _ : I g => μ g)
        ∅ (B g).toList v) t
        (finiteCoordinateFinsetAction (fun g v => finiteCoordinateComponent (fun _ : I g => μ g)
          (A g) (A g ∪ B g).toList v) s f)) ≤
      (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ s.card) *
        finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))) f := by
  exact (finite_tensor_averaging_energy_le μ hμ hmass B t _).trans
    (finite_symmetric_probe_tensor_uniform μ hμ hmass A B hAB m ell hm hA hB s f hf)



end

section
open Finset
theorem dvd_twice_add_one_iff_zmod (d u : ℕ) :
    d ∣ 2 * u + 1 ↔ (-2 : ZMod d) * (u : ZMod d) = 1 := by
  rw [← ZMod.natCast_eq_zero_iff]
  push_cast
  constructor <;> intro h <;> linear_combination -h

noncomputable def typeICharacterSum {Ω : Type*} (T : Finset Ω)
    (μ : Ω → ℂ) (value : Ω → ℕ) {d : ℕ} (χ : DirichletCharacter ℂ d) : ℂ :=
  ∑ t ∈ T, μ t * χ (value t : ZMod d)

noncomputable def typeINonprincipalRemainder {Ω : Type*} (d : ℕ) (T : Finset Ω)
    (μ : Ω → ℂ) (value : Ω → ℕ) : ℂ := by
  classical
  exact ∑ χ ∈ (univ : Finset (DirichletCharacter ℂ d)).erase 1,
    χ (-2 : ZMod d) * typeICharacterSum T μ value χ

noncomputable def typeINonprincipalNormSum {Ω : Type*} (d : ℕ) (T : Finset Ω)
    (μ : Ω → ℂ) (value : Ω → ℕ) : ℝ := by
  classical
  exact ∑ χ ∈ (univ : Finset (DirichletCharacter ℂ d)).erase 1,
    ‖typeICharacterSum T μ value χ‖

theorem typeI_character_expansion {Ω : Type*} (d : ℕ) [NeZero d]
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    (d.totient : ℂ) * (∑ t ∈ T.filter (fun t => d ∣ 2 * value t + 1), μ t) =
      ∑ χ : DirichletCharacter ℂ d,
        χ (-2 : ZMod d) * typeICharacterSum T μ value χ := by
  classical
  symm
  calc
    _ = ∑ t ∈ T, μ t * ∑ χ : DirichletCharacter ℂ d,
        χ ((-2 : ZMod d) * (value t : ZMod d)) := by
      simp only [typeICharacterSum, mul_sum, map_mul]
      rw [sum_comm]
      apply sum_congr rfl
      intro t _
      apply sum_congr rfl
      intro χ _
      ring
    _ = ∑ t ∈ T, μ t * (if d ∣ 2 * value t + 1 then (d.totient : ℂ) else 0) := by
      apply sum_congr rfl
      intro t _
      rw [DirichletCharacter.sum_characters_eq]
      simp only [← dvd_twice_add_one_iff_zmod]
    _ = _ := by rw [sum_filter, mul_sum]; apply sum_congr rfl; intro t _; split_ifs <;> ring

theorem typeI_principal_character_sum {Ω : Type*} (d : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    typeICharacterSum T μ value (1 : DirichletCharacter ℂ d) =
      ∑ t ∈ T.filter (fun t => (value t).Coprime d), μ t := by
  classical
  rw [typeICharacterSum, sum_filter]
  apply sum_congr rfl
  intro t _
  by_cases hcop : (value t).Coprime d
  · rw [if_pos hcop, MulChar.one_apply ((ZMod.isUnit_iff_coprime _ _).mpr hcop), mul_one]
  · rw [if_neg hcop, MulChar.map_nonunit _ (by simpa only [ZMod.isUnit_iff_coprime] using hcop), mul_zero]

theorem typeI_principal_factor (d : ℕ) (hd : Odd d) :
    (1 : DirichletCharacter ℂ d) (-2 : ZMod d) = 1 := by
  apply MulChar.one_apply
  exact (show IsUnit (2 : ZMod d) from
    (ZMod.isUnit_iff_coprime 2 d).mpr hd.coprime_two_left).neg

theorem typeI_character_decomposition {Ω : Type*} (d : ℕ) [NeZero d] (hd : Odd d)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    (d.totient : ℂ) * (∑ t ∈ T.filter (fun t => d ∣ 2 * value t + 1), μ t) =
      (∑ t ∈ T.filter (fun t => (value t).Coprime d), μ t) +
        typeINonprincipalRemainder d T μ value := by
  classical
  have hsum := sum_erase_add univ
    (fun χ : DirichletCharacter ℂ d => χ (-2 : ZMod d) * typeICharacterSum T μ value χ)
    (mem_univ (1 : DirichletCharacter ℂ d))
  have hrem : (∑ χ ∈ (univ : Finset (DirichletCharacter ℂ d)).erase 1,
      χ (-2 : ZMod d) * typeICharacterSum T μ value χ) =
      typeINonprincipalRemainder d T μ value := by
    unfold typeINonprincipalRemainder
    apply sum_congr
    · ext χ
      simp only [mem_erase, mem_univ, and_true]
    · intro χ _
      rfl
  rw [typeI_character_expansion, ← hsum,
    typeI_principal_factor d hd, one_mul, typeI_principal_character_sum, hrem]
  exact add_comm (typeINonprincipalRemainder d T μ value)
    (∑ t ∈ T.filter (fun t => (value t).Coprime d), μ t)

theorem typeI_nonprincipal_remainder_norm_le {Ω : Type*} (d : ℕ)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    ‖typeINonprincipalRemainder d T μ value‖ ≤ typeINonprincipalNormSum d T μ value := by
  classical
  apply (norm_sum_le _ _).trans
  apply sum_le_sum
  intro χ _
  rw [norm_mul]
  exact mul_le_of_le_one_left (norm_nonneg _) (χ.norm_le_one _)

theorem typeI_deviation_le {Ω : Type*} (d : ℕ) [NeZero d] (hd : Odd d)
    (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    ‖(∑ t ∈ T.filter (fun t => d ∣ 2 * value t + 1), μ t) -
        (∑ t ∈ T.filter (fun t => (value t).Coprime d), μ t) / (d.totient : ℂ)‖ ≤
      typeINonprincipalNormSum d T μ value / (d.totient : ℝ) := by
  have hφ : (d.totient : ℂ) ≠ 0 := by
    exact_mod_cast (Nat.totient_pos.mpr (Nat.pos_of_ne_zero (NeZero.ne d))).ne'
  have heq : (∑ t ∈ T.filter (fun t => d ∣ 2 * value t + 1), μ t) -
      (∑ t ∈ T.filter (fun t => (value t).Coprime d), μ t) / (d.totient : ℂ) =
        typeINonprincipalRemainder d T μ value / (d.totient : ℂ) := by
    apply (eq_div_iff hφ).mpr
    have h := typeI_character_decomposition d hd T μ value
    field_simp
    linear_combination h
  rw [heq, norm_div, Complex.norm_natCast]
  exact div_le_div_of_nonneg_right (typeI_nonprincipal_remainder_norm_le d T μ value)
    (Nat.cast_nonneg _)

theorem typeI_real_deviation_le {Ω : Type*} (d : ℕ) [NeZero d] (hd : Odd d)
    (T : Finset Ω) (μ : Ω → ℝ) (value : Ω → ℕ) :
    |(∑ t ∈ T.filter (fun t => d ∣ 2 * value t + 1), μ t) -
        (∑ t ∈ T.filter (fun t => (value t).Coprime d), μ t) / (d.totient : ℝ)| ≤
      typeINonprincipalNormSum d T (fun t => (μ t : ℂ)) value / (d.totient : ℝ) := by
  have h := typeI_deviation_le d hd T (fun t => (μ t : ℂ)) value
  have hcast :
      (((∑ t ∈ T.filter (fun t => d ∣ 2 * value t + 1), μ t) -
        (∑ t ∈ T.filter (fun t => (value t).Coprime d), μ t) / (d.totient : ℝ) : ℝ) : ℂ) =
      (∑ t ∈ T.filter (fun t => d ∣ 2 * value t + 1), (μ t : ℂ)) -
        (∑ t ∈ T.filter (fun t => (value t).Coprime d), (μ t : ℂ)) / (d.totient : ℂ) := by
    push_cast
    rfl
  rw [← hcast] at h
  simpa only [Complex.norm_real, Real.norm_eq_abs] using h
end

section
open Finset
theorem nonprincipal_conductor_one_lt {d : ℕ} [NeZero d]
    (χ : DirichletCharacter ℂ d) (hχ : χ ≠ 1) : 1 < χ.conductor := by
  have h0 := χ.conductor_ne_zero
  have h1 : χ.conductor ≠ 1 := fun h => hχ (χ.eq_one_iff_conductor_eq_one.mpr h)
  omega

theorem nonprincipal_primitiveCharacter_ne_one {d : ℕ}
    (χ : DirichletCharacter ℂ d) (hχ : χ ≠ 1) : χ.primitiveCharacter ≠ 1 := by
  intro h
  apply hχ
  rw [← χ.changeLevel_primitiveCharacter, h, map_one]

theorem character_conductor_mul_complement {d : ℕ} (χ : DirichletCharacter ℂ d) :
    χ.conductor * (d / χ.conductor) = d :=
  Nat.mul_div_cancel' χ.conductor_dvd_level







theorem character_apply_eq_primitive_mul_coprime {d : ℕ}
    (χ : DirichletCharacter ℂ d) (n : ℕ) :
    χ (n : ZMod d) = χ.primitiveCharacter (n : ZMod χ.conductor) *
      (if n.Coprime (d / χ.conductor) then (1 : ℂ) else 0) := by
  by_cases hnd : n.Coprime d
  · have hnh := hnd.of_dvd_right (Nat.div_dvd_of_dvd χ.conductor_dvd_level)
    rw [if_pos hnh, mul_one]
    have h := χ.primitiveCharacter_apply_of_isCoprime
      (Nat.isCoprime_iff_coprime.mpr hnd)
    simpa only [Int.cast_natCast] using h.symm
  · have hzero : χ (n : ZMod d) = 0 := by
      have h := (χ.apply_eq_zero_iff (n : ℤ)).mpr
        (by simpa only [Nat.isCoprime_iff_coprime] using hnd)
      simpa only [Int.cast_natCast] using h
    rw [hzero]
    by_cases hnh : n.Coprime (d / χ.conductor)
    · have hnf : ¬ n.Coprime χ.conductor := by
        intro hnf
        apply hnd
        have h := hnf.mul_right hnh
        rwa [character_conductor_mul_complement] at h
      have hz : χ.primitiveCharacter (n : ZMod χ.conductor) = 0 := by
        have h := (χ.primitiveCharacter.apply_eq_zero_iff (n : ℤ)).mpr
          (by simpa only [Nat.isCoprime_iff_coprime] using hnf)
        simpa only [Int.cast_natCast] using h
      rw [hz, zero_mul]
    · rw [if_neg hnh, mul_zero]

theorem character_weighted_sum_eq_primitive_filtered {Ω : Type*} {d : ℕ}
    (χ : DirichletCharacter ℂ d) (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ) :
    (∑ t ∈ T, μ t * χ (value t : ZMod d)) =
      ∑ t ∈ T.filter (fun t => (value t).Coprime (d / χ.conductor)),
        μ t * χ.primitiveCharacter (value t : ZMod χ.conductor) := by
  rw [sum_filter]
  apply sum_congr rfl
  intro t _
  rw [character_apply_eq_primitive_mul_coprime]
  split_ifs <;> simp



end

section
open Finset
theorem finite_euler_correction_product_lower (S : Finset ℕ)
    (hS : ∀ n ∈ S, 2 ≤ n) :
    (1 / 2 : ℝ) ≤ ∏ n ∈ S, (1 - 1 / (n : ℝ)^2) := by
  have hnonneg : 0 ≤ ∏ n ∈ S, (1 - 1 / (n : ℝ)^2) := by
    apply prod_nonneg
    intro n hn
    have hn2 : (2 : ℝ) ≤ n := by exact_mod_cast hS n hn
    apply sub_nonneg.mpr
    apply (div_le_one (by nlinarith : (0 : ℝ) < (n : ℝ)^2)).mpr
    nlinarith
  have hid : (∏ n ∈ S, (1 - 1 / (n : ℝ)^2)) *
      (∏ n ∈ S, (1 + 1 / ((n : ℝ)^2 - 1))) = 1 := by
    rw [← prod_mul_distrib]
    apply prod_eq_one
    intro n hn
    have hn2 : (2 : ℝ) ≤ n := by exact_mod_cast hS n hn
    have h0 : (n : ℝ)^2 ≠ 0 := by nlinarith
    have h1 : (n : ℝ)^2 - 1 ≠ 0 := by nlinarith
    field_simp
    ring
  have hmul := mul_le_mul_of_nonneg_left (euler_correction_product_le_two S hS) hnonneg
  rw [hid] at hmul
  linarith

section

variable
  (P : Finset ℕ)
  (hP : ∀ p ∈ P, p.Prime)

include P hP

theorem finite_prime_avoidance_product_pos  : 0 < ∏ p ∈ P, (1 - 1 / (p : ℝ)) := by
  apply prod_pos
  intro p hp
  have hp1 : (1 : ℝ) < p := by exact_mod_cast (hP p hp).one_lt
  apply sub_pos.mpr
  exact (div_lt_one (by linarith)).mpr hp1

theorem finite_prime_avoidance_product_lower  {z : ℝ} (hz : 1 ≤ z)
    (hbound : ∀ p ∈ P, (p : ℝ) ≤ z) :
    1 / ((2 * primeEulerProductUpperConstant) * Real.log (2 * z)) ≤
      ∏ p ∈ P, (1 - 1 / (p : ℝ)) := by
  have hpos := finite_prime_avoidance_product_pos P hP
  have hden : 0 < (2 * primeEulerProductUpperConstant) * Real.log (2 * z) := by
    apply mul_pos (mul_pos (by norm_num) primeEulerProductUpperConstant_pos)
    exact Real.log_pos (by linarith)
  have hid : (∏ p ∈ P, (1 - 1 / (p : ℝ))) *
      (∏ p ∈ P, (1 + 1 / ((p : ℝ) - 1))) = 1 := by
    rw [← prod_mul_distrib]
    apply prod_eq_one
    intro p hp
    have hp1 : (1 : ℝ) < p := by exact_mod_cast (hP p hp).one_lt
    have h0 : (p : ℝ) ≠ 0 := by linarith
    have h1 : (p : ℝ) - 1 ≠ 0 := by linarith
    field_simp
    ring
  have hm := mul_le_mul_of_nonneg_left
    (finite_inverse_prime_euler_product_le_log P hP hz hbound) hpos.le
  rw [hid] at hm
  exact (div_le_iff₀ hden).mpr hm

theorem finite_odd_prime_correction_product_lower  (hodd : ∀ p ∈ P, p ≠ 2) :
    (1 / 2 : ℝ) ≤ ∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1)^2) := by
  have hp3 : ∀ p ∈ P, 3 ≤ p := by
    intro p hp
    have := (hP p hp).two_le
    have := hodd p hp
    omega
  have hpred : ∀ n ∈ P.image (fun p : ℕ => (p - 1 : ℕ)), 2 ≤ n := by
    intro n hn
    obtain ⟨p, hp, rfl⟩ := mem_image.mp hn
    have := hp3 p hp
    omega
  have hinj : Set.InjOn (fun p : ℕ => (p - 1 : ℕ)) P := by
    intro p hp q hq heq
    change p - 1 = q - 1 at heq
    have := hp3 p hp
    have := hp3 q hq
    omega
  have heq : (∏ n ∈ P.image (fun p : ℕ => (p - 1 : ℕ)), (1 - 1 / (n : ℝ)^2)) =
      ∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1)^2) := by
    rw [prod_image hinj]
    apply prod_congr rfl
    intro p hp
    rw [Nat.cast_sub (hP p hp).one_le, Nat.cast_one]
  rw [← heq]
  exact finite_euler_correction_product_lower _ hpred

theorem finite_odd_prime_predecessor_avoidance_product_lower  (hodd : ∀ p ∈ P, p ≠ 2)
    {z : ℝ} (hz : 1 ≤ z) (hbound : ∀ p ∈ P, (p : ℝ) ≤ z) :
    1 / ((4 * primeEulerProductUpperConstant) * Real.log (2 * z)) ≤
      ∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1)) := by
  have hfactor : (∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1))) =
      (∏ p ∈ P, (1 - 1 / (p : ℝ))) *
        (∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1)^2)) := by
    rw [← prod_mul_distrib]
    apply prod_congr rfl
    intro p hp
    have hp1 : (1 : ℝ) < p := by exact_mod_cast (hP p hp).one_lt
    have h0 : (p : ℝ) ≠ 0 := by linarith
    have h1 : (p : ℝ) - 1 ≠ 0 := by linarith
    field_simp
    ring
  have hlog : 0 < Real.log (2 * z) := Real.log_pos (by linarith)
  calc
    _ = (1 / ((2 * primeEulerProductUpperConstant) * Real.log (2 * z))) * (1/2) := by ring
    _ ≤ (∏ p ∈ P, (1 - 1 / (p : ℝ))) *
        (∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1)^2)) :=
      mul_le_mul (finite_prime_avoidance_product_lower P hP hz hbound)
        (finite_odd_prime_correction_product_lower P hP hodd) (by norm_num)
        (finite_prime_avoidance_product_pos P hP).le
    _ = _ := hfactor.symm

theorem finite_odd_prime_predecessor_avoidance_product_pos  (hodd : ∀ p ∈ P, p ≠ 2) :
    0 < ∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1)) := by
  apply prod_pos
  intro p hp
  have hp3 : 3 ≤ p := by
    have := (hP p hp).two_le
    have := hodd p hp
    omega
  have hp3R : (3 : ℝ) ≤ p := by exact_mod_cast hp3
  apply sub_pos.mpr
  exact (div_lt_one (by linarith)).mpr (by linarith)

end

end

section
open Finset
noncomputable def shiftedTotientSieveRemainder (T : Finset ℕ) (μ : ℕ → ℝ) (d : ℕ) : ℝ :=
  (∑ u ∈ T.filter (fun u => d ∣ 2*u + 1), μ u) -
    (∑ u ∈ T, μ u) / (Nat.totient d : ℝ)

theorem shifted_totient_intersection_moment (T S : Finset ℕ) (μ : ℕ → ℝ)
    (hS : ∀ p ∈ S, p.Prime) :
    (∑ u ∈ T.filter (fun u => ∀ p ∈ S, p ∣ 2*u + 1), μ u) =
      (∑ u ∈ T, μ u) * (∏ p ∈ S, 1 / ((p : ℝ) - 1)) +
        shiftedTotientSieveRemainder T μ (∏ p ∈ S, p) := by
  have hf : T.filter (fun u => ∀ p ∈ S, p ∣ 2*u + 1) =
      T.filter (fun u => (∏ p ∈ S, p) ∣ 2*u + 1) := by
    apply filter_congr
    intro u _
    exact (prime_subset_product_dvd_iff S hS (2*u + 1)).symm
  rw [hf, ← totient_sieve_prime_product_reciprocal S hS]
  unfold shiftedTotientSieveRemainder
  ring

theorem exists_shifted_totient_prime_sieve :
    ∃ K : ℝ, 0 < K ∧ ∀ (P T : Finset ℕ) (μ : ℕ → ℝ) {z : ℝ} {h : ℕ},
      1 < z → 1 ≤ h → Even h →
      (∀ p ∈ P, p.Prime) → (∀ p ∈ P, p ≠ 2) →
      (∀ p ∈ P, (p : ℝ) ≤ z) → (∀ u ∈ T, 0 ≤ μ u) →
      |(∑ u ∈ T.filter (fun u => ∀ p ∈ P, ¬p ∣ 2*u + 1), μ u) -
          (∑ u ∈ T, μ u) * (∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1)))| ≤
        (∑ u ∈ T, μ u) * (∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1))) *
          K * Real.exp (-(h : ℝ)) +
          ∑ d ∈ blockSieveModuli P (z^(4 * (h : ℝ) + 2)),
            |shiftedTotientSieveRemainder T μ d| := by
  obtain ⟨K, hK, hsieve⟩ := exists_odd_prime_reciprocal_sieve_events
  refine ⟨K, hK, ?_⟩
  intro P T μ z h hz hh heven hP hodd hPz hμ
  apply hsieve P T μ (fun u p => p ∣ 2*u + 1) (shiftedTotientSieveRemainder T μ)
    hz (sum_nonneg hμ) hh heven hP hodd hPz hμ
  intro S hS
  exact shifted_totient_intersection_moment T S μ
    (fun p hp => hP p ((mem_powerset.mp hS) hp))

noncomputable def shiftedRoughSet (T : Finset ℕ) (z : ℝ) : Finset ℕ := by
  classical
  exact T.filter (fun u : ℕ => ∀ p : ℕ, p ∈ (2*u + 1).primeFactors → z < (p : ℝ))

theorem mem_shifted_rough_set_iff (T : Finset ℕ) (z : ℝ) (u : ℕ) :
    u ∈ shiftedRoughSet T z ↔ u ∈ T ∧
      ∀ p ∈ (2*u + 1).primeFactors, z < (p : ℝ) := by
  classical
  simp only [shiftedRoughSet, mem_filter]

theorem exists_shifted_totient_rough_sieve :
    ∃ K : ℝ, 0 < K ∧ ∀ (T : Finset ℕ) (μ : ℕ → ℝ) {z : ℝ} {h : ℕ},
      1 < z → 1 ≤ h → Even h → (∀ u ∈ T, 0 ≤ μ u) →
      |(∑ u ∈ shiftedRoughSet T z, μ u) -
          (∑ u ∈ T, μ u) *
            (∏ p ∈ (primeBand 0 z).erase 2, (1 - 1 / ((p : ℝ) - 1)))| ≤
        (∑ u ∈ T, μ u) *
          (∏ p ∈ (primeBand 0 z).erase 2, (1 - 1 / ((p : ℝ) - 1))) *
          K * Real.exp (-(h : ℝ)) +
          ∑ d ∈ blockSieveModuli ((primeBand 0 z).erase 2) (z^(4 * (h : ℝ) + 2)),
            |shiftedTotientSieveRemainder T μ d| := by
  classical
  obtain ⟨K, hK, hsieve⟩ := exists_shifted_totient_prime_sieve
  refine ⟨K, hK, ?_⟩
  intro T μ z h hz hh heven hμ
  have hz0 : 0 ≤ z := le_trans (by norm_num) hz.le
  have hb := hsieve ((primeBand 0 z).erase 2) T μ hz hh heven
    (fun p hp => small_prime_pool_prime (mem_of_mem_erase hp))
    (fun p hp => (mem_erase.mp hp).1)
    (fun p hp => small_prime_pool_le hz0 (mem_of_mem_erase hp)) hμ
  have hf : T.filter (fun u => ∀ p ∈ (primeBand 0 z).erase 2, ¬p ∣ 2*u + 1) =
      shiftedRoughSet T z := by
    ext u
    simp only [mem_filter, mem_shifted_rough_set_iff]
    exact and_congr_right (fun _ => two_mul_add_one_odd_prime_avoidance_iff_rough u hz0)
  rw [hf] at hb
  exact hb
end

section
open Finset
theorem sieve_modulus_mem_factoredNumbers (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime)
    {D : ℝ} {d : ℕ} (hd : d ∈ blockSieveModuli P D) : d ∈ Nat.factoredNumbers P := by
  exact Nat.mem_factoredNumbers_of_primeFactors_subset
    (Nat.ne_of_gt (block_sieve_modulus_properties P hP D hd).1)
    (block_sieve_modulus_primeFactors_subset P hP D hd)

theorem external_prime_coprime_sieve_modulus (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime)
    {p d : ℕ} {D : ℝ} (hp : p.Prime) (hout : p ∉ P)
    (hd : d ∈ blockSieveModuli P D) : Nat.Coprime p d := by
  apply hp.coprime_iff_not_dvd.mpr
  intro hdiv
  apply hout
  apply block_sieve_modulus_primeFactors_subset P hP D hd
  exact hp.mem_primeFactors hdiv (Nat.ne_of_gt (block_sieve_modulus_properties P hP D hd).1)

theorem separated_prime_sieve_product_injective (P Q : Finset ℕ) (D : ℝ)
    (hP : ∀ p ∈ P, p.Prime) (hQ : ∀ p ∈ Q, p.Prime)
    (hout : ∀ p ∈ Q, p ∉ P) :
    Set.InjOn (fun x : ℕ × ℕ => x.1 * x.2) (Q.product (blockSieveModuli P D)) := by
  intro x hx y hy hxy
  obtain ⟨hxp, hxd⟩ := mem_product.mp hx
  obtain ⟨hyp, hyd⟩ := mem_product.mp hy
  have hxfree : Disjoint x.1.primeFactors P := by
    rw [(hQ x.1 hxp).primeFactors]
    exact disjoint_singleton_left.mpr (hout x.1 hxp)
  have hyfree : Disjoint y.1.primeFactors P := by
    rw [(hQ y.1 hyp).primeFactors]
    exact disjoint_singleton_left.mpr (hout y.1 hyp)
  obtain ⟨hd, hp⟩ := supported_free_product_unique
    (sieve_modulus_mem_factoredNumbers P hP hxd) (hQ x.1 hxp).ne_zero hxfree
    (sieve_modulus_mem_factoredNumbers P hP hyd) (hQ y.1 hyp).ne_zero hyfree
    (by simpa only [mul_comm] using hxy)
  exact Prod.ext hp hd



end

section
open scoped BigOperators Classical
theorem finite_probability_pairing_bound {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (hμmass : ∑ x, μ x = 1) (hνmass : ∑ y, ν y = 1)
    (K : X → Y → ℂ) {M : ℝ} (hM : 0 ≤ M) (hK : ∀ x y, ‖K x y‖ ≤ M)
    (f : X → ℂ) (g : Y → ℂ) :
    ‖∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) * (K x y * f x * g y)‖ ≤
      M * Real.sqrt ((∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2) := by
  rcases eq_or_lt_of_le hM with hM0 | hMp
  · have hz (x : X) (y : Y) : K x y = 0 := norm_le_zero_iff.mp (by simpa [← hM0] using hK x y)
    simp [hz, ← hM0]
  have hMc : (M : ℂ) ≠ 0 := by exact_mod_cast hMp.ne'
  let K' := fun x y => K x y / (M : ℂ)
  have hK' (x : X) (y : Y) : ‖K' x y‖ ≤ 1 := by
    dsimp only [K']
    rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hMp]
    exact (div_le_one hMp).mpr (hK x y)
  have h := finite_pair_event_pairing_le μ ν hμ hν (fun _ _ => True) K' hK' f g
  have hmass : finitePairEventMass μ ν (fun _ _ => True) = 1 := by
    simp only [finitePairEventMass, if_true, ← Finset.mul_sum, hνmass, mul_one, hμmass]
  rw [hmass, Real.sqrt_one, one_mul] at h
  simp only [if_true] at h
  have he : (∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) * (K x y * f x * g y)) =
      (M : ℂ) * ∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) * (K' x y * f x * g y) := by
    simp only [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro x _
    apply Finset.sum_congr rfl
    intro y _
    dsimp only [K']
    field_simp
  rw [he, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hMp]
  exact mul_le_mul_of_nonneg_left h hM

theorem finite_retained_comparison_pairing {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (hμmass : ∑ x, μ x = 1) (hνmass : ∑ y, ν y = 1)
    (E : X → Y → Prop) (raw comparison : X → Y → ℂ)
    (hraw : ∀ x y, ‖raw x y‖ ≤ 1) (hzero : ∀ x y, E x y → comparison x y = 0)
    {ε : ℝ} (hε : 0 ≤ ε) (hclose : ∀ x y, ¬E x y → ‖raw x y - comparison x y‖ ≤ ε)
    (f : X → ℂ) (g : Y → ℂ) :
    ‖∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) * ((raw x y - comparison x y) * f x * g y)‖ ≤
      (Real.sqrt (finitePairEventMass μ ν E) + ε) *
        Real.sqrt ((∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2) := by
  let keep := fun x y => if E x y then (0 : ℂ) else raw x y - comparison x y
  have hk (x : X) (y : Y) : ‖keep x y‖ ≤ ε := by
    dsimp only [keep]
    split_ifs with h
    · simpa only [norm_zero] using hε
    · exact hclose x y h
  have hr := finite_pair_event_pairing_le μ ν hμ hν E raw hraw f g
  have hc := finite_probability_pairing_bound μ ν hμ hν hμmass hνmass keep hε hk f g
  have he : (∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) * ((raw x y - comparison x y) * f x * g y)) =
      (∑ x, ∑ y, if E x y then ((μ x * ν y : ℝ) : ℂ) * (raw x y * f x * g y) else 0) +
      ∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) * (keep x y * f x * g y) := by
    simp only [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro x _
    apply Finset.sum_congr rfl
    intro y _
    by_cases h : E x y <;> simp [keep, h, hzero x y]
  rw [he]
  exact (norm_add_le _ _).trans ((add_le_add hr hc).trans_eq (by ring))

theorem finite_retained_comparison_pairing_supported {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hν : ∀ y, 0 ≤ ν y)
    (hμmass : ∑ x, μ x = 1) (hνmass : ∑ y, ν y = 1)
    (E : X → Y → Prop) (raw comparison : X → Y → ℂ)
    (hraw : ∀ x y, ‖raw x y‖ ≤ 1) (hzero : ∀ x y, E x y → comparison x y = 0)
    (f : X → ℂ) (g : Y → ℂ) {ε : ℝ} (hε : 0 ≤ ε)
    (hclose : ∀ x y, f x ≠ 0 → g y ≠ 0 → ¬E x y → ‖raw x y - comparison x y‖ ≤ ε) :
    ‖∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) * ((raw x y - comparison x y) * f x * g y)‖ ≤
      (Real.sqrt (finitePairEventMass μ ν E) + ε) *
        Real.sqrt ((∑ x, μ x * ‖f x‖ ^ 2) * ∑ y, ν y * ‖g y‖ ^ 2) := by
  let cut := fun x y => f x ≠ 0 ∧ g y ≠ 0
  let raw' := fun x y => if cut x y then raw x y else 0
  let comparison' := fun x y => if cut x y then comparison x y else 0
  have hr (x : X) (y : Y) : ‖raw' x y‖ ≤ 1 := by
    dsimp only [raw']
    split_ifs
    · exact hraw x y
    · simp
  have hz (x : X) (y : Y) (he : E x y) : comparison' x y = 0 := by
    simp only [comparison', hzero x y he, ite_self]
  have hc (x : X) (y : Y) (he : ¬E x y) : ‖raw' x y - comparison' x y‖ ≤ ε := by
    dsimp only [raw', comparison']
    split_ifs with hcut
    · exact hclose x y hcut.1 hcut.2 he
    · simpa only [sub_self, norm_zero] using hε
  have he (x : X) (y : Y) :
      (raw' x y - comparison' x y) * f x * g y =
        (raw x y - comparison x y) * f x * g y := by
    by_cases hx : f x = 0
    · simp [hx]
    by_cases hy : g y = 0
    · simp [hy]
    simp [raw', comparison', cut, hx, hy]
  simpa only [he] using finite_retained_comparison_pairing μ ν hμ hν hμmass hνmass E
    raw' comparison' hr hz hε hc f g
end

