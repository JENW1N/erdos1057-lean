section

/- Uniformly bounded factor multiplicity and the prime-only base case for rough integers. -/

open Finset

namespace Bounty













theorem rough_band_prime_of_upper_le_cutoff_sq {A B z : ℝ}
    (hA : 1 ≤ A) (hB : 0 ≤ B) (hz : 0 ≤ z) (hBz : B ≤ z ^ 2)
    {n : ℕ} (hn : n ∈ roughBand A B z) : n.Prime := by
  classical
  have hn0 := roughBand_pos hn
  have hAn : A < (n : ℝ) := Nat.lt_of_floor_lt (mem_Ioc.mp (mem_filter.mp hn).1).1
  have hn1 : n ≠ 1 := by
    intro he
    subst n
    norm_num at hAn
    linarith
  have hnB : (n : ℝ) ≤ B :=
    (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hn).1).2).trans (Nat.floor_le hB)
  have hmin : z < (n.minFac : ℝ) :=
    (mem_filter.mp hn).2 n.minFac
      (Nat.mem_primeFactors.mpr ⟨Nat.minFac_prime hn1, Nat.minFac_dvd n, hn0.ne'⟩)
  by_contra hprime
  have hsq : (n.minFac : ℝ) ^ 2 ≤ n := by
    exact_mod_cast Nat.minFac_sq_le_self hn0 hprime
  nlinarith

theorem rough_band_eq_prime_band_of_upper_le_cutoff_sq {A B z : ℝ}
    (hA : 1 ≤ A) (hz : 0 ≤ z) (hBz : B ≤ z ^ 2) :
    roughBand A B z = primeBand (max A z) B := by
  classical
  by_cases hB : 0 ≤ B
  · rw [← prime_part_of_rough_band (by linarith : 0 ≤ A) hB]
    exact (filter_true_of_mem (fun n hn =>
      rough_band_prime_of_upper_le_cutoff_sq hA hB hz hBz hn)).symm
  · have hB0 : ⌊B⌋₊ = 0 := Nat.floor_of_nonpos (le_of_not_ge hB)
    have hzero (m : ℕ) : Ioc m 0 = ∅ := Ioc_eq_empty_of_le (Nat.zero_le m)
    simp only [roughBand, primeBand, hB0, hzero, filter_empty]

end Bounty

