section
open Finset
def finiteChronologicalPrefix {X 𝕜 : Type*} [CommMonoid 𝕜]
    (K : ℕ → X → X → 𝕜) (f : X → 𝕜) (n : ℕ) (x : Fin (n + 1) → X) : 𝕜 :=
  f (x 0) * ∏ j : Fin n, K j.val (x j.succ) (x j.castSucc)

theorem finite_chronological_prefix_snoc {X 𝕜 : Type*} [CommMonoid 𝕜]
    (K : ℕ → X → X → 𝕜) (f : X → 𝕜) (n : ℕ)
    (x : Fin (n + 1) → X) (z : X) :
    finiteChronologicalPrefix K f (n + 1) (Fin.snoc x z) =
      K n z (x (Fin.last n)) * finiteChronologicalPrefix K f n x := by
  unfold finiteChronologicalPrefix
  rw [Fin.prod_univ_castSucc]
  simp only [Fin.val_castSucc, Fin.succ_castSucc, Fin.snoc_castSucc,
    Fin.val_last, Fin.succ_last, Fin.snoc_last]
  have hzero : (Fin.snoc (α := fun _ : Fin (n + 2) => X) x z) 0 = x 0 := by
    exact Fin.snoc_castSucc (α := fun _ : Fin (n + 2) => X) z x 0
  rw [hzero]
  ac_rfl

/- Sum over all chronological states, with both boundary tests, is exactly
the finite matrix pairing. Every intermediate cut is retained explicitly. -/
theorem finite_chronological_trace_expansion {X 𝕜 : Type*}
    [Fintype X] [CommSemiring 𝕜]
    (K : ℕ → X → X → 𝕜) (f q : X → 𝕜) (n : ℕ) :
    (∑ x : Fin (n + 1) → X, q (x (Fin.last n)) * finiteChronologicalPrefix K f n x) =
      ∑ z, q z * finitePathAction K f n z := by
  classical
  induction n generalizing q with
  | zero =>
    rw [← (Fin.snocEquiv (fun _ : Fin 1 => X)).sum_comp]
    simp [finiteChronologicalPrefix, finitePathAction, Fin.snocEquiv,
      Fin.snoc_zero, Fintype.sum_prod_type]
  | succ n ih =>
    rw [← (Fin.snocEquiv (fun _ : Fin (n + 2) => X)).sum_comp]
    simp only [Fintype.sum_prod_type, Fin.snocEquiv, Equiv.coe_fn_mk,
      Fin.snoc_last, finite_chronological_prefix_snoc]
    simp_rw [← mul_assoc, mul_assoc (q _) (K n _ _) _, ← mul_sum, ih]
    rfl

/- Interleave visits G_0,G_1,... and edges E_0,E_1,... in chronological order. -/
noncomputable def finiteAlternatingKernel {X 𝕜 : Type*}
    (G E : ℕ → X → X → 𝕜) (j : ℕ) : X → X → 𝕜 :=
  if j % 2 = 0 then G (j / 2) else E (j / 2)

theorem finite_alternating_kernel_even {X 𝕜 : Type*}
    (G E : ℕ → X → X → 𝕜) (j : ℕ) :
    finiteAlternatingKernel G E (2 * j) = G j := by
  simp [finiteAlternatingKernel]

theorem finite_alternating_kernel_odd {X 𝕜 : Type*}
    (G E : ℕ → X → X → 𝕜) (j : ℕ) :
    finiteAlternatingKernel G E (2 * j + 1) = E j := by
  simp [finiteAlternatingKernel, Nat.add_div]

theorem finite_alternating_action {X 𝕜 : Type*} [Fintype X] [CommSemiring 𝕜]
    (G E : ℕ → X → X → 𝕜) (f : X → 𝕜) (n : ℕ) (x : X) :
    finitePathAction (finiteAlternatingKernel G E) f (2 * n + 1) x =
      finitePathAction (fun j x y => ∑ z, G (j + 1) x z * E j z y)
        (fun x => ∑ y, G 0 x y * f y) n x := by
  induction n generalizing x with
  | zero => simp [finitePathAction, finiteAlternatingKernel]
  | succ n ih =>
    have hstep (y : X) :
        finitePathAction (finiteAlternatingKernel G E) f (2 * n + 1 + 1) y =
          ∑ z, E n y z * finitePathAction
            (fun j x y => ∑ z, G (j + 1) x z * E j z y)
            (fun x => ∑ y, G 0 x y * f y) n z := by
      rw [finitePathAction, finite_alternating_kernel_odd]
      simp only [ih]
    have hn : 2 * (n + 1) + 1 = (2 * n + 1) + 1 + 1 := by omega
    rw [hn, finitePathAction]
    have he : 2 * n + 1 + 1 = 2 * (n + 1) := by omega
    rw [show finiteAlternatingKernel G E (2 * n + 1 + 1) = G (n + 1) by
      rw [he, finite_alternating_kernel_even]]
    simp_rw [hstep]
    rw [finitePathAction]
    simp only [sum_mul, mul_sum, mul_assoc]
    rw [sum_comm]
end

