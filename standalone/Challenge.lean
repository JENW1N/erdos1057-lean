open Finset


end

section
open scoped BigOperators InnerProductSpace
theorem finite_gram_row_norm_sq {X E : Type*} [Fintype X]
    [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (u : X → E) (c : X → ℂ) {B : ℝ}
    (hrow : ∀ i, (∑ j, ‖inner ℂ (u i) (u j)‖) ≤ B) :
    ‖∑ i, c i • u i‖ ^ 2 ≤ B * ∑ i, ‖c i‖ ^ 2 := by
  classical
  have he : ‖∑ i, c i • u i‖ ^ 2 =
      ∑ i, ∑ j, (inner ℂ (c i • u i) (c j • u j)).re := by
    rw [norm_sq_eq_re_inner (𝕜 := ℂ)]
    change (inner ℂ (∑ i, c i • u i) (∑ i, c i • u i)).re = _
    simp only [sum_inner, inner_sum, Complex.re_sum]
    exact Finset.sum_comm
  have hp (i j : X) : 2 * (inner ℂ (c i • u i) (c j • u j)).re ≤
      ‖c i‖ ^ 2 * ‖inner ℂ (u i) (u j)‖ + ‖c j‖ ^ 2 * ‖inner ℂ (u i) (u j)‖ := by
    have h := Complex.re_le_norm (inner ℂ (c i • u i) (c j • u j))
    have hn : ‖inner ℂ (c i • u i) (c j • u j)‖ =
        ‖c i‖ * ‖c j‖ * ‖inner ℂ (u i) (u j)‖ := by
      rw [inner_smul_left, inner_smul_right]
      simp only [norm_mul, Complex.norm_conj, mul_assoc]
    rw [hn] at h
    nlinarith [mul_nonneg (sq_nonneg (‖c i‖ - ‖c j‖))
      (norm_nonneg (inner ℂ (u i) (u j)))]
  have hs := Finset.sum_le_sum (fun i (_ : i ∈ (Finset.univ : Finset X)) =>
    Finset.sum_le_sum (fun j (_ : j ∈ (Finset.univ : Finset X)) => hp i j))
  have hswap : (∑ i, ∑ j, ‖c j‖ ^ 2 * ‖inner ℂ (u i) (u j)‖) =
      ∑ i, ‖c i‖ ^ 2 * ∑ j, ‖inner ℂ (u i) (u j)‖ := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    rw [norm_inner_symm (𝕜 := ℂ) (u j) (u i)]
  simp only [Finset.sum_add_distrib] at hs
  simp_rw [← Finset.mul_sum] at hs
  rw [hswap] at hs
  have hmid : ‖∑ i, c i • u i‖ ^ 2 ≤
      ∑ i, ‖c i‖ ^ 2 * ∑ j, ‖inner ℂ (u i) (u j)‖ := by
    rw [he]
    linarith
  calc
    _ ≤ ∑ i, ‖c i‖ ^ 2 * ∑ j, ‖inner ℂ (u i) (u j)‖ := hmid
    _ ≤ ∑ i, ‖c i‖ ^ 2 * B := Finset.sum_le_sum (fun i _ =>
      mul_le_mul_of_nonneg_left (hrow i) (sq_nonneg _))
    _ = _ := by rw [← Finset.sum_mul, mul_comm]

theorem finite_near_orthogonal_norm_sq {X E : Type*} [Fintype X]
    [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (u : X → E) (c : X → ℂ) {ε : ℝ} (_hε : 0 ≤ ε)
    (hdiag : ∀ i, ‖u i‖ ^ 2 ≤ 1)
    (hoff : ∀ i j, i ≠ j → ‖inner ℂ (u i) (u j)‖ ≤ ε) :
    ‖∑ i, c i • u i‖ ^ 2 ≤
      (1 + (Fintype.card X - 1 : ℕ) * ε) * ∑ i, ‖c i‖ ^ 2 := by
  classical
  apply finite_gram_row_norm_sq u c
  intro i
  have hrow : (∑ j, ‖inner ℂ (u i) (u j)‖) ≤
      ∑ j : X, if j = i then 1 else ε := by
    apply Finset.sum_le_sum
    intro j _
    by_cases h : j = i
    · subst j
      have hn : inner ℂ (u i) (u i) = (‖u i‖ : ℂ) ^ 2 :=
        inner_self_eq_norm_sq_to_K (𝕜 := ℂ) (u i)
      rw [hn, norm_pow, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (norm_nonneg _), if_pos rfl]
      exact hdiag i
    · simpa only [if_neg h] using hoff i j (Ne.symm h)
  refine hrow.trans_eq ?_
  rw [← Finset.sum_erase_add _ _ (Finset.mem_univ i)]
  simp only [if_true]
  rw [Finset.sum_congr rfl (fun j hj => if_neg (Finset.ne_of_mem_erase hj))]
  simp [Finset.card_erase_of_mem (Finset.mem_univ i), add_comm]


theorem finite_gram_row_analysis_sq {X E : Type*} [Fintype X]
    [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (u : X → E) {B : ℝ} (hB : 0 ≤ B)
    (hrow : ∀ i, (∑ j, ‖inner ℂ (u i) (u j)‖) ≤ B) (f : E) :
    (∑ i, ‖inner ℂ (u i) f‖ ^ 2) ≤ B * ‖f‖ ^ 2 := by
  let energy : ℝ := ∑ i, ‖inner ℂ (u i) f‖ ^ 2
  let v : E := ∑ i, inner ℂ (u i) f • u i
  have he0 : 0 ≤ energy := Finset.sum_nonneg (fun _ _ => sq_nonneg _)
  have he : (inner ℂ v f).re = energy := by
    dsimp [v, energy]
    rw [sum_inner]
    simp only [Complex.re_sum, inner_smul_left, Complex.conj_mul', ← Complex.ofReal_pow,
      Complex.ofReal_re]
  have hn := finite_gram_row_norm_sq u (fun i => inner ℂ (u i) f) hrow
  change ‖v‖ ^ 2 ≤ B * energy at hn
  have he_le : energy ≤ ‖v‖ * ‖f‖ := by
    rw [← he]
    exact (Complex.re_le_norm _).trans (norm_inner_le_norm _ _)
  have hs : energy ^ 2 ≤ (B * energy) * ‖f‖ ^ 2 := by
    calc
      _ ≤ (‖v‖ * ‖f‖) ^ 2 := (sq_le_sq₀ he0 (by positivity)).mpr he_le
      _ = ‖v‖ ^ 2 * ‖f‖ ^ 2 := mul_pow _ _ _
      _ ≤ _ := mul_le_mul_of_nonneg_right hn (sq_nonneg _)
  change energy ≤ B * ‖f‖ ^ 2
  rcases eq_or_lt_of_le he0 with heq | hpos
  · rw [← heq]
    positivity
  · nlinarith

theorem finite_near_orthogonal_frame_sq {X E : Type*} [Fintype X]
    [NormedAddCommGroup E] [InnerProductSpace ℂ E]
    (u : X → E) {ε : ℝ} (hε : 0 ≤ ε)
    (hdiag : ∀ i, ‖u i‖ ^ 2 ≤ 1)
    (hoff : ∀ i j, i ≠ j → ‖inner ℂ (u i) (u j)‖ ≤ ε) (f : E) :
    ‖∑ i, inner ℂ (u i) f • u i‖ ^ 2 ≤
      (1 + (Fintype.card X - 1 : ℕ) * ε) ^ 2 * ‖f‖ ^ 2 := by
  let B : ℝ := 1 + (Fintype.card X - 1 : ℕ) * ε
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hs (c : X → ℂ) : ‖∑ i, c i • u i‖ ^ 2 ≤ B * ∑ i, ‖c i‖ ^ 2 :=
    finite_near_orthogonal_norm_sq u c hε hdiag hoff
  let energy : ℝ := ∑ i, ‖inner ℂ (u i) f‖ ^ 2
  let v : E := ∑ i, inner ℂ (u i) f • u i
  have he0 : 0 ≤ energy := Finset.sum_nonneg (fun _ _ => sq_nonneg _)
  have he : (inner ℂ v f).re = energy := by
    dsimp [v, energy]
    rw [sum_inner]
    simp only [Complex.re_sum, inner_smul_left, Complex.conj_mul', ← Complex.ofReal_pow,
      Complex.ofReal_re]
  have hn : ‖v‖ ^ 2 ≤ B * energy := hs _
  have he_le : energy ≤ ‖v‖ * ‖f‖ := by
    rw [← he]
    exact (Complex.re_le_norm _).trans (norm_inner_le_norm _ _)
  have hsquare : energy ^ 2 ≤ (B * energy) * ‖f‖ ^ 2 := by
    calc
      _ ≤ (‖v‖ * ‖f‖) ^ 2 := (sq_le_sq₀ he0 (by positivity)).mpr he_le
      _ = ‖v‖ ^ 2 * ‖f‖ ^ 2 := mul_pow _ _ _
      _ ≤ _ := mul_le_mul_of_nonneg_right hn (sq_nonneg _)
  have henergy : energy ≤ B * ‖f‖ ^ 2 := by
    rcases eq_or_lt_of_le he0 with heq | hpos
    · rw [← heq]; positivity
    · nlinarith
  change ‖v‖ ^ 2 ≤ B ^ 2 * ‖f‖ ^ 2
  calc
    _ ≤ B * energy := hn
    _ ≤ B * (B * ‖f‖ ^ 2) := mul_le_mul_of_nonneg_left henergy hB
    _ = _ := by ring




end

section
open Finset Classical
theorem finite_gated_weighted_cauchy {I : Type*} [Fintype I]
    (a gate w : I → ℝ) (phase f : I → ℂ)
    (ha : ∀ i, 0 ≤ a i) (hgate0 : ∀ i, 0 ≤ gate i) (hgate1 : ∀ i, gate i ≤ 1)
    (hw : ∀ i, 0 < w i) (hphase : ∀ i, ‖phase i‖ ≤ 1) :
    ‖∑ i, (a i : ℂ) * ((gate i : ℂ) * phase i) * f i‖ ^ 2 ≤
      (∑ i, a i * w i) * ∑ i, (a i * gate i) * ‖f i‖ ^ 2 / w i := by
  have hag (i : I) : 0 ≤ a i * gate i := mul_nonneg (ha i) (hgate0 i)
  have hnorm (i : I) : ‖((a i * gate i : ℝ) : ℂ)‖ = a i * gate i := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hag i)]
  have hc := complex_row_weighted_cauchy (univ : Finset I)
    (fun i => ((a i * gate i : ℝ) : ℂ)) (fun i => phase i * f i) w (fun i _ => hw i)
  simp_rw [hnorm] at hc
  have hrow : (∑ i, (a i * gate i) * w i) ≤ ∑ i, a i * w i := by
    apply sum_le_sum
    intro i hi
    exact mul_le_mul_of_nonneg_right
      (by simpa only [mul_one] using mul_le_mul_of_nonneg_left (hgate1 i) (ha i)) (hw i).le
  have hsquare : (∑ i, (a i * gate i) * ‖phase i * f i‖ ^ 2 / w i) ≤
      ∑ i, (a i * gate i) * ‖f i‖ ^ 2 / w i := by
    apply sum_le_sum
    intro i hi
    apply div_le_div_of_nonneg_right _ (hw i).le
    apply mul_le_mul_of_nonneg_left _ (hag i)
    apply (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).mpr
    rw [norm_mul]
    simpa only [one_mul] using mul_le_mul_of_nonneg_right (hphase i) (norm_nonneg (f i))
  have hbound := hc.trans (mul_le_mul hrow hsquare
    (sum_nonneg fun i _ => div_nonneg (mul_nonneg (hag i) (sq_nonneg _)) (hw i).le)
    (sum_nonneg fun i _ => mul_nonneg (ha i) (hw i).le))
  simpa only [Complex.ofReal_mul, mul_assoc] using hbound

noncomputable def unrestrictedEdgeGatedSquareMass {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V v : ℝ) (eligible : Finset (Fin N)) (B : ℕ)
    (gate : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥eligible) → UnrestrictedFreshLabels P promotions → ℝ)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) : ℝ :=
  ∑ stores : Finset (Fin t), ∑ promotions : Finset (Fin t),
    ∑ e : promotions ↪ ↥eligible, ∑ fresh : UnrestrictedFreshLabels P promotions,
      (unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores promotions e fresh *
        gate stores promotions e fresh) *
        (if (unrestrictedEdgeOutput source old seed transport stores promotions e).1 ≤ B then
          ‖F (unrestrictedEdgeTarget old label promotions e fresh)
              (unrestrictedEdgeOutput source old seed transport stores promotions e)‖ ^ 2 /
            v ^ (unrestrictedEdgeOutput source old seed transport stores promotions e).1
        else 0)

section

variable
  {P Z : Type*}
  [sharedInstance1 : Fintype P]
  {t N : ℕ}
  (source : Fin t → P)
  (old : Fin N → Z)
  (label : Z → P)
  (seed : P → Z)
  (transport : Z → Z)
  (hit : Z → Prop)
  (μ : P → ℝ)
  {ρ V v : ℝ}
  (hρ : 0 ≤ ρ)
  (hV : 0 ≤ V)

include P Z sharedInstance1 t N source old label seed transport hit μ ρ V v hρ hV

theorem unrestricted_edge_gated_square_mass_nonneg  (hv : 0 ≤ v)
    (hμ : ∀ p, 0 ≤ μ p) (eligible : Finset (Fin N)) (B : ℕ)
    (gate : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥eligible) → UnrestrictedFreshLabels P promotions → ℝ)
    (hgate0 : ∀ stores promotions e fresh, 0 ≤ gate stores promotions e fresh)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) :
    0 ≤ unrestrictedEdgeGatedSquareMass source old label seed transport hit μ
      ρ V v eligible B gate F := by
  apply sum_nonneg
  intro stores hs
  apply sum_nonneg
  intro promotions hp
  apply sum_nonneg
  intro e he
  apply sum_nonneg
  intro fresh hf
  apply mul_nonneg (mul_nonneg (unrestrictedEdgeEventMass_nonneg source old seed transport hit μ
    hρ hV hμ stores promotions e fresh) (hgate0 stores promotions e fresh))
  split_ifs
  · exact div_nonneg (sq_nonneg _) (pow_nonneg hv _)
  · exact le_rfl

theorem unrestricted_edge_action_gated_cauchy  (hv : 0 < v)
    (hμ : ∀ p, 0 ≤ μ p) (eligible : Finset (Fin N)) (B : ℕ)
    (gate : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥eligible) → UnrestrictedFreshLabels P promotions → ℝ)
    (hgate0 : ∀ stores promotions e fresh, 0 ≤ gate stores promotions e fresh)
    (hgate1 : ∀ stores promotions e fresh, gate stores promotions e fresh ≤ 1)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (hphase : ∀ stores promotions e fresh, ‖phase stores promotions e fresh‖ ≤ 1)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) :
    ‖unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B
        (fun stores promotions e fresh =>
          (gate stores promotions e fresh : ℂ) * phase stores promotions e fresh) F‖ ^ 2 ≤
      unrestrictedEdgeRowMass source old seed transport hit μ ρ V v eligible *
        unrestrictedEdgeGatedSquareMass source old label seed transport hit μ ρ V v eligible B gate F := by
  let Q := Σ stores : Finset (Fin t), Σ promotions : Finset (Fin t),
    (promotions ↪ ↥eligible) × UnrestrictedFreshLabels P promotions
  let mass : Q → ℝ := fun q =>
    unrestrictedEdgeEventMass source old seed transport hit μ ρ V q.1 q.2.1 q.2.2.1 q.2.2.2
  let gateQ : Q → ℝ := fun q => gate q.1 q.2.1 q.2.2.1 q.2.2.2
  let weight : Q → ℝ := fun q =>
    v ^ (unrestrictedEdgeOutput source old seed transport q.1 q.2.1 q.2.2.1).1
  let phaseQ : Q → ℂ := fun q => phase q.1 q.2.1 q.2.2.1 q.2.2.2
  let value : Q → ℂ := fun q =>
    if (unrestrictedEdgeOutput source old seed transport q.1 q.2.1 q.2.2.1).1 ≤ B then
      F (unrestrictedEdgeTarget old label q.2.1 q.2.2.1 q.2.2.2)
        (unrestrictedEdgeOutput source old seed transport q.1 q.2.1 q.2.2.1) else 0
  have hc := finite_gated_weighted_cauchy mass gateQ weight phaseQ value
    (fun q => unrestrictedEdgeEventMass_nonneg source old seed transport hit μ hρ hV hμ
      q.1 q.2.1 q.2.2.1 q.2.2.2)
    (fun q => hgate0 q.1 q.2.1 q.2.2.1 q.2.2.2)
    (fun q => hgate1 q.1 q.2.1 q.2.2.1 q.2.2.2) (fun _ => pow_pos hv _)
    (fun q => hphase q.1 q.2.1 q.2.2.1 q.2.2.2)
  have hsquare : (∑ q : Q, (mass q * gateQ q) * ‖value q‖ ^ 2 / weight q) =
      unrestrictedEdgeGatedSquareMass source old label seed transport hit μ ρ V v eligible B gate F := by
    simp only [Q, Fintype.sum_sigma, Fintype.sum_prod_type, mass, gateQ, value, weight,
      unrestrictedEdgeGatedSquareMass]
    apply sum_congr rfl
    intro stores hs
    apply sum_congr rfl
    intro promotions hp
    apply sum_congr rfl
    intro e he
    apply sum_congr rfl
    intro fresh hf
    split_ifs <;> simp [mul_div_assoc]
  rw [hsquare] at hc
  simpa only [Q, Fintype.sum_sigma, Fintype.sum_prod_type, mass, gateQ, weight, phaseQ, value,
    unrestrictedEdgeAction, unrestrictedEdgeRowMass, unrestrictedEdgeChoiceRowMass] using hc

end


noncomputable def unrestrictedResidueEdgeSquareMass {P : Type*} [Fintype P] {t N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (source : Fin t → P)
    (old : Fin N → UnrestrictedResidueParticle n) (μ : P → ℝ)
    (ρ V v : ℝ) (B : ℕ)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) : ℝ :=
  unrestrictedEdgeGatedSquareMass source old Sigma.fst (unrestrictedResidueSeed n)
    (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ ρ V v
    (unrestrictedResidueEligible n Δ D old) B
    (fun stores _ _ _ => if unrestrictedResidueStorageAllowed n D source stores then 1 else 0) F

