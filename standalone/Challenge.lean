/- The original root coefficient is a function of the actual decorated edge key,
with both original local Fourier phases and the original auxiliary coefficient retained. -/

open scoped Classical
namespace Bounty
section Key
variable {I : Type} {N M J ell n : ℕ} {P : Fin N → Finset ℕ}
  (groups : Finset (Fin N)) (e : {g // g ∉ groupsᶜ} ≃ Fin M)
  (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
  (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
  (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
  (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
    PhysicalAuxLabels P (C i) → ℂ) (θ : ℝ)

noncomputable def physicalRootKeyCoefficient
    (key : PhysicalMixedBigKey (Ps := fun g : ↥groupsᶜ => P g.val)
      (J := J) (ell := ell) (I := patterns) (K := Fin (n + 1))) :=
  physicalGroupReindexedCoefficient e
    (fun g => C key.2.1.val g.val)
    (physicalCoupledBigCoefficient (fun g => g ∈ groupsᶜ) (C key.2.1.val)
      (ζ (n - key.1.val) key.2.1.val)
      (physicalLocalFourierCoefficient C k K θ (n - key.1.val) key.2.1.val)
      key.2.2.1 key.2.2.2
      (physicalEmptyAuxLabels (fun g : ↥groupsᶜ => C key.2.1.val g.val) (hC key.2.1)))

theorem physical_root_key_coefficient
    (pl : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns)
    (j : Fin (n + 1)) :
    physicalRootKeyCoefficient groups e patterns C hC ζ k K θ
      (physicalSelectedPlannedKey (physicalRootSmallPlanPattern groups patterns C hC pl)
        (physicalRootSmallPlanSmallData groups patterns C hC pl) j) =
    physicalGroupReindexedCoefficient e
      (fun g => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val g.val)
      (physicalRootPlanBigCoefficient groups patterns C hC ζ k K θ pl j) := by
  have ha : physicalEmptyAuxLabels
      (fun g : ↥groupsᶜ => C (physicalRootSmallPlanPattern groups patterns C hC pl j).val g.val)
      (hC (physicalRootSmallPlanPattern groups patterns C hC pl j)) =
      (physicalRootSmallPlanSmallData groups patterns C hC pl).1 j := by
    funext g a
    exact False.elim (by
      simpa only [hC (physicalRootSmallPlanPattern groups patterns C hC pl j) g,
        Finset.notMem_empty] using a.property)
  dsimp only [physicalRootKeyCoefficient, physicalRootPlanBigCoefficient, physicalSelectedPlannedKey]
  rw [ha]
  rfl

end Key
end Bounty
