section
open Finset Classical
/- The literal ordered output after old-index extraction: translated
survivors followed by translated stored source labels. -/
def unrestrictedRetrievedOutput {P : Type*} {b : ℕ} (n : P → ℕ) (Δ : ℤ)
    (s : Fin b → P) (u : FiniteOrderedTuple (UnrestrictedResidueParticle n)) :
    FiniteOrderedTuple (UnrestrictedResidueParticle n) :=
  unrestrictedJointOutput n Δ u.2 s

theorem unrestricted_edge_memory_eq_retrieved {P : Type*} {N a b : ℕ}
    (n : P → ℕ) (Δ : ℤ) (q : Fin N → UnrestrictedResidueParticle n)
    (s : Fin b → P) {eligible : Finset (Fin N)} (e : Fin a ↪ ↥eligible) :
    unrestrictedEdgeMemory q (unrestrictedResidueTransport n Δ)
        (unrestrictedResidueSeed n ∘ s) e =
      unrestrictedRetrievedOutput n Δ s
        ⟨(unrestrictedEdgeSurvivors e).card,
          retainedOrderedTuple q (unrestrictedEdgeSurvivors e)⟩ := by
  unfold unrestrictedEdgeMemory retainedBirthTuple unrestrictedRetrievedOutput
    unrestrictedJointOutput unrestrictedJointInput
  congr 1
  funext j
  refine Fin.addCases (fun i => ?_) (fun i => ?_) j
  · simp only [Fin.addCases_left]
    rfl
  · simp only [Fin.addCases_right, Function.comp_apply,
      unrestrictedResidueTransport_seed, Int.cast_neg]

/- Selected residues collapse to one old residue per promoted label. This
is the exact counting-measure identity after factorial retrieval, and permits
arbitrary complex functions of both endpoint memories. -/
theorem unrestricted_extracted_selection_to_joint {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ : ℤ)
    (ban : P → Prop) (k a b : ℕ)
    (F : (Fin a → P) → (Fin b → P) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    (∑ u : Fin k → UnrestrictedResidueParticle n,
      ((∏ j, unrestrictedResidueWeight μ (u j)) / (k.factorial : ℝ)) •
        ∑ x : Fin a → UnrestrictedResidueParticle n,
          if ∀ i, unrestrictedResidueHit (unrestrictedResidueTransport n Δ (x i)) ∧
              ban (x i).1
          then (∏ i, unrestrictedResidueWeight μ (x i)) •
            ∑ s : Fin b → P, (∏ i, μ (s i)) •
              F (fun i => (x i).1) s (retrievalSourceTuple x ⟨k, u⟩)
                (unrestrictedRetrievedOutput n Δ s ⟨k, u⟩)
          else 0) =
      unrestrictedJointIntegral n μ Δ k a b
        (fun p s X Y => if ∀ i, ban (p i) then F p s X Y else 0) := by
  unfold unrestrictedJointIntegral
  apply sum_congr rfl
  intro u hu
  rw [unrestricted_residue_tuple_selection_sum n μ Δ ban a]
  rw [smul_sum]
  apply sum_congr rfl
  intro p hp
  by_cases hban : ∀ i, ban (p i)
  · simp only [if_pos hban, smul_sum, Complex.real_smul]
    apply sum_congr rfl
    intro s hs
    change _ * (_ * (_ * F p s _ _)) = _ * F p s _ _
    rw [← mul_assoc, ← mul_assoc]
    congr 1
    push_cast
    ring
  · simp [hban]


/- Reindex eligible promotions as all old-index injections with an explicit
translated-hit and dilation indicator. This retains multiplicities of equal
old particles. -/
theorem unrestricted_residue_retrieval_sum {P : Type*} {N a : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (q : Fin N → UnrestrictedResidueParticle n)
    (F : (Fin a → UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    (∑ e : Fin a ↪ ↥(unrestrictedResidueEligible n Δ D q),
      F (fun i => q (e i).val)
        ⟨(unrestrictedEdgeSurvivors e).card,
          retainedOrderedTuple q (unrestrictedEdgeSurvivors e)⟩) =
      ∑ e : Fin a ↪ Fin N,
        if ∀ i, unrestrictedResidueHit (unrestrictedResidueTransport n Δ (q (e i))) ∧
            ¬ (n (q (e i)).1 : ℤ) ∣ D
        then F (fun i => q (e i))
          ⟨(retrievalSurvivorIndices e).card,
            retainedOrderedTuple q (retrievalSurvivorIndices e)⟩ else 0 := by
  have h := promotionChoice_sum_ambient (unrestrictedResidueEligible n Δ D q)
    (fun e : Fin a ↪ Fin N => F (fun i => q (e i))
      ⟨(retrievalSurvivorIndices e).card,
        retainedOrderedTuple q (retrievalSurvivorIndices e)⟩)
  simpa only [unrestrictedEdgeSurvivors, retrievalSurvivorIndices,
    promotionSelectedIndices, unrestrictedResidueEligible_iff_hit,
    Function.Embedding.trans_apply, Function.Embedding.coeFn_mk] using h

/- Factorial-normalized extraction from the literal eligible-index sum. The
integrand can inspect both endpoint memories, provided the source dependence
is symmetric. -/
theorem unrestricted_residue_retrieval_normalized {P : Type*} [Fintype P]
    {N a : ℕ} (ha : a ≤ N) (n : P → ℕ) [∀ p, NeZero (n p)]
    (μ : P → ℝ) (Δ D : ℤ)
    (F : (Fin a → UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hF : ∀ x u, OrderedTupleSymmetric (fun X => F x X u)) :
    (∑ q : Fin N → UnrestrictedResidueParticle n,
      ((∏ j, unrestrictedResidueWeight μ (q j) : ℝ) : ℂ) *
        ∑ e : Fin a ↪ ↥(unrestrictedResidueEligible n Δ D q),
          F (fun i => q (e i).val) ⟨N, q⟩
            ⟨(unrestrictedEdgeSurvivors e).card,
              retainedOrderedTuple q (unrestrictedEdgeSurvivors e)⟩) /
        ((N.factorial : ℝ) : ℂ) =
      ((1 / ((N - a).factorial : ℝ) : ℝ) : ℂ) *
        ∑ x : Fin a → UnrestrictedResidueParticle n,
          ∑ u : Fin (N - a) → UnrestrictedResidueParticle n,
            (((∏ i, unrestrictedResidueWeight μ (x i)) *
              ∏ j, unrestrictedResidueWeight μ (u j) : ℝ) : ℂ) *
              if ∀ i, unrestrictedResidueHit (unrestrictedResidueTransport n Δ (x i)) ∧
                  ¬ (n (x i).1 : ℤ) ∣ D
              then F x (retrievalSourceTuple x ⟨N - a, u⟩) ⟨N - a, u⟩ else 0 := by
  let G : (Fin a → UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ := fun x X u =>
    if ∀ i, unrestrictedResidueHit (unrestrictedResidueTransport n Δ (x i)) ∧
        ¬ (n (x i).1 : ℤ) ∣ D then F x X u else 0
  have hG : ∀ x u, OrderedTupleSymmetric (fun X => G x X u) := by
    intro x u m q e
    dsimp only [G]
    split_ifs
    · exact hF x u m q e
    · rfl
  have hnormalize := ordered_retrieval_symmetric_normalized_sum_complex ha
    (unrestrictedResidueWeight μ) G hG
  change _ = _ at hnormalize
  rw [← hnormalize]
  congr 1
  rw [sum_comm]
  apply sum_congr rfl
  intro q hq
  have hs := unrestricted_residue_retrieval_sum n Δ D q (fun x u => F x ⟨N, q⟩ u)
  rw [hs, mul_sum]

/- The finite ordered transfer block with `a` old promotions and `b`
source labels stored. This is integrated against the full old-memory
factorial measure and the stored active-label product measure. -/
noncomputable def unrestrictedOrderedTransferBlock {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ)
    (N a b : ℕ)
    (F : (Fin a → P) → (Fin b → P) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) : ℂ :=
  (∑ q : Fin N → UnrestrictedResidueParticle n,
    ((∏ j, unrestrictedResidueWeight μ (q j) : ℝ) : ℂ) *
      ∑ e : Fin a ↪ ↥(unrestrictedResidueEligible n Δ D q),
        ∑ s : Fin b → P, ((∏ i, μ (s i) : ℝ) : ℂ) *
          F (fun i => (q (e i).val).1) s ⟨N, q⟩
            (unrestrictedEdgeMemory q (unrestrictedResidueTransport n Δ)
              (unrestrictedResidueSeed n ∘ s) e)) / ((N.factorial : ℝ) : ℂ)

/- Concrete factorial-weighted ordered promotion/storage events equal the
common-variable integral. The only source hypothesis is permutation symmetry;
target symmetry is not needed for this one-way identification. -/
theorem unrestricted_ordered_transfer_eq_joint {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ)
    {N a : ℕ} (ha : a ≤ N) (b : ℕ)
    (F : (Fin a → P) → (Fin b → P) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hF : ∀ p s Y, OrderedTupleSymmetric (fun X => F p s X Y)) :
    unrestrictedOrderedTransferBlock n μ Δ D N a b F =
      unrestrictedJointIntegral n μ Δ (N - a) a b
        (fun p s X Y => if ∀ i, ¬ (n (p i) : ℤ) ∣ D then F p s X Y else 0) := by
  let G : (Fin a → UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ := fun x X u =>
    ∑ s : Fin b → P, ((∏ i, μ (s i) : ℝ) : ℂ) *
      F (fun i => (x i).1) s X (unrestrictedRetrievedOutput n Δ s u)
  have hG : ∀ x u, OrderedTupleSymmetric (fun X => G x X u) := by
    intro x u m q e
    apply sum_congr rfl
    intro s hs
    congr 1
    exact hF (fun i => (x i).1) s (unrestrictedRetrievedOutput n Δ s u) m q e
  have hn := unrestricted_residue_retrieval_normalized ha
    n μ Δ D G hG
  unfold unrestrictedOrderedTransferBlock
  simp_rw [unrestricted_edge_memory_eq_retrieved]
  dsimp only [G] at hn
  rw [hn]
  have hsel := unrestricted_extracted_selection_to_joint n μ Δ
    (fun p => ¬ (n p : ℤ) ∣ D) (N - a) a b F
  convert hsel using 1
  rw [sum_comm]
  simp_rw [Complex.real_smul, mul_sum]
  apply sum_congr rfl
  intro u hu
  apply sum_congr rfl
  intro x hx
  by_cases he : ∀ i, unrestrictedResidueHit (unrestrictedResidueTransport n Δ (x i)) ∧
      ¬ (n (x i).1 : ℤ) ∣ D
  · simp only [if_pos he, mul_sum]
    apply sum_congr rfl
    intro s hs
    push_cast
    ring
  · simp only [if_neg he, mul_zero]
  all_goals
    congr 1
    funext p s X Y
    split_ifs <;> rfl

/- On functions symmetric in both endpoint memories, the actual ordered
transfer block reverses by exchanging promoted/stored counts and negating
displacement. Both directions enforce the same dilation ban. -/
theorem unrestricted_ordered_transfer_reverse {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ D : ℤ)
    (k a b : ℕ)
    (F : (Fin a → P) → (Fin b → P) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hX : ∀ p s Y, OrderedTupleSymmetric (fun X => F p s X Y))
    (hY : ∀ p s X, OrderedTupleSymmetric (fun Y => F p s X Y)) :
    unrestrictedOrderedTransferBlock n μ Δ D (k + a) a b
      (fun p s X Y => if ∀ i, ¬ (n (s i) : ℤ) ∣ D then F p s X Y else 0) =
    unrestrictedOrderedTransferBlock n μ (-Δ) D (k + b) b a
      (fun s p Y X => if ∀ i, ¬ (n (p i) : ℤ) ∣ D then F p s X Y else 0) := by
  have hforward := unrestricted_ordered_transfer_eq_joint n μ Δ D
    (Nat.le_add_left a k) b
    (fun p s X Y => if ∀ i, ¬ (n (s i) : ℤ) ∣ D then F p s X Y else 0)
    (by
      intro p s Y m q e
      split_ifs
      · exact hX p s Y m q e
      · rfl)
  have hback := unrestricted_ordered_transfer_eq_joint n μ (-Δ) D
    (Nat.le_add_left b k) a
    (fun s p Y X => if ∀ i, ¬ (n (p i) : ℤ) ∣ D then F p s X Y else 0)
    (by
      intro s p X m q e
      split_ifs
      · exact hY p s X m q e
      · rfl)
  simp only [Nat.add_sub_cancel_right] at hforward hback
  rw [hforward, hback, unrestricted_joint_integral_reverse]
  congr 1
  funext s p Y X
  by_cases hp : ∀ i, ¬ (n (p i) : ℤ) ∣ D
  · by_cases hs : ∀ i, ¬ (n (s i) : ℤ) ∣ D
    · simp only [if_pos hp, if_pos hs]
    · simp only [if_pos hp, if_neg hs]
  · by_cases hs : ∀ i, ¬ (n (s i) : ℤ) ∣ D
    · simp only [if_neg hp, if_pos hs]
    · simp only [if_neg hp, if_neg hs]



end

section
open Finset Classical
theorem unrestricted_edge_action_bounded_phase_norm_le_row_mass
    {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    {ρ V v C H : ℝ} (hρ : 0 ≤ ρ) (hV : 0 ≤ V) (hv : 0 ≤ v)
    (hC : 0 ≤ C) (hH : 0 ≤ H) (hμ : ∀ p, 0 ≤ μ p)
    (eligible : Finset (Fin N)) (B : ℕ)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (hphase : ∀ stores promotions e fresh, ‖phase stores promotions e fresh‖ ≤ H)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ)
    (hF : ∀ target memory, memory.1 ≤ B → ‖F target memory‖ ≤ C * v ^ memory.1) :
    ‖unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B phase F‖ ≤
      (H * C) * unrestrictedEdgeRowMass source old seed transport hit μ ρ V v eligible := by
  unfold unrestrictedEdgeAction unrestrictedEdgeRowMass unrestrictedEdgeChoiceRowMass
  simp_rw [mul_sum]
  refine (norm_sum_le _ _).trans (sum_le_sum fun stores _ => ?_)
  refine (norm_sum_le _ _).trans (sum_le_sum fun promotions _ => ?_)
  refine (norm_sum_le _ _).trans (sum_le_sum fun e _ => ?_)
  refine (norm_sum_le _ _).trans (sum_le_sum fun fresh _ => ?_)
  have hm := unrestrictedEdgeEventMass_nonneg source old seed transport hit μ hρ hV hμ
    stores promotions e fresh
  have hf : ‖(if (unrestrictedEdgeOutput source old seed transport stores promotions e).1 ≤ B then
        F (unrestrictedEdgeTarget old label promotions e fresh)
          (unrestrictedEdgeOutput source old seed transport stores promotions e) else 0 : ℂ)‖ ≤
      C * v ^ (unrestrictedEdgeOutput source old seed transport stores promotions e).1 := by
    split_ifs with hout
    · exact hF _ _ hout
    · simpa only [norm_zero] using mul_nonneg hC (pow_nonneg hv _)
  rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hm]
  calc
    _ ≤ (unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores promotions e fresh * H) *
        (C * v ^ (unrestrictedEdgeOutput source old seed transport stores promotions e).1) :=
      mul_le_mul (mul_le_mul_of_nonneg_left (hphase stores promotions e fresh) hm) hf
        (norm_nonneg _) (mul_nonneg hm hH)
    _ = _ := by ring

/- Reversing a block interchanges promotion and storage counts. The retained
forward coefficient is implemented by the explicit ratio V^promotions/V^stores. -/
theorem unrestricted_reverse_residue_edge_action_norm_le
    {P : Type*} [Fintype P] {t N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (source : Fin t → P)
    (old : Fin N → UnrestrictedResidueParticle n) (μ : P → ℝ)
    {ρ V v vmin vmax C : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : vmin ≤ V) (hVhi : V ≤ vmax)
    (hC : 0 ≤ C) (hμ : ∀ p, 0 ≤ μ p) (hmass : ∑ p, μ p ≤ 2)
    (B T : ℕ) (ht : t ≤ T)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥(unrestrictedResidueEligible n Δ D old)) →
        UnrestrictedFreshLabels P promotions → ℂ)
    (hphase : ∀ stores promotions e fresh, ‖phase stores promotions e fresh‖ ≤ 1)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hF : ∀ target memory, memory.1 ≤ B → ‖F target memory‖ ≤ C * v ^ memory.1) :
    ‖unrestrictedResidueEdgeAction n Δ D source old μ ρ V B
        (fun stores promotions e fresh =>
          ((V ^ promotions.card / V ^ stores.card : ℝ) : ℂ) * phase stores promotions e fresh) F‖ ≤
      C * v ^ N * unrestrictedEdgeRowBound ρ v vmin T *
        unrestrictedEdgeReversalBound vmin vmax T := by
  let H := unrestrictedEdgeReversalBound vmin vmax T
  have hH : 0 ≤ H := by
    unfold H unrestrictedEdgeReversalBound
    exact mul_nonneg (pow_nonneg (zero_le_one.trans (le_max_left _ _)) _)
      (pow_nonneg (zero_le_one.trans (le_max_left _ _)) _)
  have hV : 0 ≤ V := (hvmin.trans_le hVlo).le
  have hv0 : 0 ≤ v := (zero_lt_one.trans hv).le
  have hp : ∀ (stores promotions : Finset (Fin t))
      (e : promotions ↪ ↥(unrestrictedResidueEligible n Δ D old))
      (fresh : UnrestrictedFreshLabels P promotions),
      ‖(if unrestrictedResidueStorageAllowed n D source stores then
        ((V ^ promotions.card / V ^ stores.card : ℝ) : ℂ) * phase stores promotions e fresh else 0)‖ ≤ H := by
    intro stores promotions e fresh
    split_ifs
    · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (div_nonneg (pow_nonneg hV _) (pow_nonneg hV _))]
      calc
        _ ≤ (V ^ promotions.card / V ^ stores.card) * 1 :=
          mul_le_mul_of_nonneg_left (hphase stores promotions e fresh)
            (div_nonneg (pow_nonneg hV _) (pow_nonneg hV _))
        _ ≤ H := by
          rw [mul_one]
          apply unrestricted_edge_reversal_ratio_le hvmin hVlo hVhi T
          · exact ((by simpa using card_le_card (subset_univ stores)) : stores.card ≤ t).trans ht
          · exact ((by simpa using card_le_card (subset_univ promotions)) : promotions.card ≤ t).trans ht
    · simpa only [norm_zero] using hH
  calc
    _ ≤ (H * C) * unrestrictedEdgeRowMass source old (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ ρ V v
          (unrestrictedResidueEligible n Δ D old) :=
      unrestricted_edge_action_bounded_phase_norm_le_row_mass source old Sigma.fst
        (unrestrictedResidueSeed n) (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ
        hρ0.le hV hv0 hC hH hμ (unrestrictedResidueEligible n Δ D old) B _ hp F hF
    _ ≤ (H * C) * (v ^ N * unrestrictedEdgeRowBound ρ v vmin T) :=
      mul_le_mul_of_nonneg_left
        (unrestricted_edge_row_mass_le source old (unrestrictedResidueSeed n)
          (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ hρ0 hρ1 hv hvmin hVlo hμ
          hmass (unrestrictedResidueEligible n Δ D old)
          (unrestrictedResidueEligible_translated_hit n Δ D old) T ht) (mul_nonneg hH hC)
    _ = _ := by dsimp [H]; ring
end

section
open Finset Classical
/- Eligibility for the old tuple `old ∘ τ` is the inverse image under `τ`. -/
def unrestrictedPermutedEligible {N : ℕ} (τ : Equiv.Perm (Fin N))
    (eligible : Finset (Fin N)) : Finset (Fin N) :=
  eligible.map τ.symm.toEmbedding

theorem mem_unrestrictedPermutedEligible {N : ℕ} (τ : Equiv.Perm (Fin N))
    (eligible : Finset (Fin N)) (j : Fin N) :
    j ∈ unrestrictedPermutedEligible τ eligible ↔ τ j ∈ eligible := by
  simp [unrestrictedPermutedEligible]

def unrestrictedEligiblePermEquiv {N : ℕ} (τ : Equiv.Perm (Fin N))
    (eligible : Finset (Fin N)) : eligible ≃ unrestrictedPermutedEligible τ eligible where
  toFun j := ⟨τ.symm j, (mem_unrestrictedPermutedEligible τ eligible _).mpr (by simp)⟩
  invFun j := ⟨τ j, (mem_unrestrictedPermutedEligible τ eligible _).mp j.property⟩
  left_inv j := by ext; simp
  right_inv j := by ext; simp

def unrestrictedPromotionPermEquiv {A : Type*} {N : ℕ} (τ : Equiv.Perm (Fin N))
    (eligible : Finset (Fin N)) :
    (A ↪ ↥eligible) ≃ (A ↪ ↥(unrestrictedPermutedEligible τ eligible)) where
  toFun e := e.trans (unrestrictedEligiblePermEquiv τ eligible).toEmbedding
  invFun e := e.trans (unrestrictedEligiblePermEquiv τ eligible).symm.toEmbedding
  left_inv e := by ext; simp
  right_inv e := by ext; simp

theorem unrestrictedPromotionPermEquiv_val {A : Type*} {N : ℕ}
    (τ : Equiv.Perm (Fin N)) (eligible : Finset (Fin N))
    (e : A ↪ ↥eligible) (a : A) :
    (unrestrictedPromotionPermEquiv τ eligible e a).val = τ.symm (e a).val := rfl

theorem unrestrictedPromotionPermEquiv_selected {A : Type*} [Fintype A] {N : ℕ}
    (τ : Equiv.Perm (Fin N)) (eligible : Finset (Fin N)) (e : A ↪ ↥eligible) :
    promotionSelectedIndices (unrestrictedPromotionPermEquiv τ eligible e) =
      (promotionSelectedIndices e).map τ.symm.toEmbedding := by
  simp only [promotionSelectedIndices, Finset.map_map]
  rfl

theorem unrestrictedPromotionPermEquiv_survivors {A : Type*} [Fintype A] {N : ℕ}
    (τ : Equiv.Perm (Fin N)) (eligible : Finset (Fin N)) (e : A ↪ ↥eligible) :
    unrestrictedEdgeSurvivors (unrestrictedPromotionPermEquiv τ eligible e) =
      (unrestrictedEdgeSurvivors e).map τ.symm.toEmbedding := by
  rw [unrestrictedEdgeSurvivors, unrestrictedPromotionPermEquiv_selected]
  simp [unrestrictedEdgeSurvivors, Finset.map_sdiff]

theorem unrestricted_edge_target_perm {P Z : Type*} {t N : ℕ}
    (old : Fin N → Z) (label : Z → P) (τ : Equiv.Perm (Fin N))
    (promotions : Finset (Fin t)) (eligible : Finset (Fin N))
    (e : promotions ↪ ↥eligible) (fresh : UnrestrictedFreshLabels P promotions) :
    unrestrictedEdgeTarget (old ∘ τ) label promotions
        (unrestrictedPromotionPermEquiv τ eligible e) fresh =
      unrestrictedEdgeTarget old label promotions e fresh := by
  unfold unrestrictedEdgeTarget
  congr 1
  funext i
  simp [Function.comp_apply, unrestrictedPromotionPermEquiv_val]

theorem unrestricted_edge_memory_perm_occupancy {A Z : Type*} [Fintype A]
    [DecidableEq Z] {N b : ℕ} (old : Fin N → Z) (transport : Z → Z)
    (stored : Fin b → Z) (τ : Equiv.Perm (Fin N))
    (eligible : Finset (Fin N)) (e : A ↪ ↥eligible) :
    orderedTupleOccupancy (unrestrictedEdgeMemory (old ∘ τ) transport stored
        (unrestrictedPromotionPermEquiv τ eligible e)) =
      orderedTupleOccupancy (unrestrictedEdgeMemory old transport stored e) := by
  simp only [unrestrictedEdgeMemory, retained_birth_tuple_occupancy]
  rw [unrestrictedPromotionPermEquiv_survivors]
  congr 1
  simp [retainedTupleOccupancy, Finset.sum_map, Function.comp_apply]

theorem unrestricted_edge_memory_perm_symmetric {A Z K : Type*} [Fintype A]
    [Fintype Z] [DecidableEq Z] {N b : ℕ} (old : Fin N → Z) (transport : Z → Z)
    (stored : Fin b → Z) (τ : Equiv.Perm (Fin N))
    (eligible : Finset (Fin N)) (e : A ↪ ↥eligible)
    (F : FiniteOrderedTuple Z → K) (hF : OrderedTupleSymmetric F) :
    F (unrestrictedEdgeMemory (old ∘ τ) transport stored
        (unrestrictedPromotionPermEquiv τ eligible e)) =
      F (unrestrictedEdgeMemory old transport stored e) :=
  symmetric_tuple_equal_on_occupancy F hF _ _
    (unrestricted_edge_memory_perm_occupancy old transport stored τ eligible e)

theorem unrestricted_edge_event_mass_perm {P Z : Type*} [Fintype Z] [DecidableEq Z]
    {t N : ℕ} (source : Fin t → P) (old : Fin N → Z) (seed : P → Z)
    (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ) (ρ V : ℝ)
    (τ : Equiv.Perm (Fin N)) (stores promotions : Finset (Fin t))
    (eligible : Finset (Fin N)) (e : promotions ↪ ↥eligible)
    (fresh : UnrestrictedFreshLabels P promotions) :
    unrestrictedEdgeEventMass source (old ∘ τ) seed transport hit μ ρ V stores promotions
        (unrestrictedPromotionPermEquiv τ eligible e) fresh =
      unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores promotions e fresh := by
  have hc : orderedPredicateCount
        (unrestrictedEdgeMemory (old ∘ τ) transport (unrestrictedStoredTuple source seed stores)
          (unrestrictedPromotionPermEquiv τ eligible e)) hit =
      orderedPredicateCount
        (unrestrictedEdgeMemory old transport (unrestrictedStoredTuple source seed stores) e) hit :=
    unrestricted_edge_memory_perm_symmetric old transport
      (unrestrictedStoredTuple source seed stores) τ eligible e
      (fun q => orderedPredicateCount q hit)
      (fun _ q e' => orderedPredicateCount_permutation q hit e')
  unfold unrestrictedEdgeEventMass unrestrictedEdgeOutput
  rw [orderedPredicateCount_permutation, hc]

/- The whole finite edge action respects old-index permutation whenever the
phase respects the explicit event correspondence and the output test is symmetric. -/
theorem unrestricted_edge_action_perm {P Z : Type*} [Fintype P] [Fintype Z] [DecidableEq Z]
    {t N : ℕ} (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V : ℝ) (τ : Equiv.Perm (Fin N)) (eligible : Finset (Fin N)) (B : ℕ)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (phase' : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥(unrestrictedPermutedEligible τ eligible)) →
        UnrestrictedFreshLabels P promotions → ℂ)
    (hphase : ∀ stores promotions e fresh,
      phase' stores promotions (unrestrictedPromotionPermEquiv τ eligible e) fresh =
        phase stores promotions e fresh)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ)
    (hF : ∀ target, OrderedTupleSymmetric (F target)) :
    unrestrictedEdgeAction source (old ∘ τ) label seed transport hit μ ρ V
        (unrestrictedPermutedEligible τ eligible) B phase' F =
      unrestrictedEdgeAction source old label seed transport hit μ ρ V eligible B phase F := by
  unfold unrestrictedEdgeAction
  apply Finset.sum_congr rfl
  intro stores hs
  apply Finset.sum_congr rfl
  intro promotions hp
  rw [← (unrestrictedPromotionPermEquiv (A := ↥promotions) τ eligible).sum_comp]
  apply Finset.sum_congr rfl
  intro e he
  apply Finset.sum_congr rfl
  intro fresh hf
  rw [unrestricted_edge_event_mass_perm, hphase, unrestricted_edge_target_perm]
  have hlength :
      (unrestrictedEdgeOutput source (old ∘ τ) seed transport stores promotions
        (unrestrictedPromotionPermEquiv τ eligible e)).1 =
      (unrestrictedEdgeOutput source old seed transport stores promotions e).1 := by
    simp only [unrestrictedEdgeOutput, unrestrictedEdgeMemory_length]
  rw [hlength]
  congr 2
  exact unrestricted_edge_memory_perm_symmetric old transport
    (unrestrictedStoredTuple source seed stores) τ eligible e _ (hF _)

theorem unrestricted_residue_eligible_perm {P : Type*} {N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (old : Fin N → UnrestrictedResidueParticle n)
    (τ : Equiv.Perm (Fin N)) :
    unrestrictedResidueEligible n Δ D (old ∘ τ) =
      unrestrictedPermutedEligible τ (unrestrictedResidueEligible n Δ D old) := by
  ext j
  rw [mem_unrestrictedResidueEligible, mem_unrestrictedPermutedEligible,
    mem_unrestrictedResidueEligible]
  rfl

/- The actual residue edge with phase one sends symmetric memory tests to
symmetric source-memory tests. Storage bans and the total-memory cutoff remain. -/
theorem unrestricted_residue_edge_one_symmetric {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] {t : ℕ} (Δ D : ℤ) (source : Fin t → P)
    (μ : P → ℝ) (ρ V : ℝ) (B : ℕ)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
    (hF : ∀ target, OrderedTupleSymmetric (F target)) :
    OrderedTupleSymmetric (fun old : FiniteOrderedTuple (UnrestrictedResidueParticle n) =>
      unrestrictedResidueEdgeAction n Δ D source old.2 μ ρ V B (fun _ _ _ _ => 1) F) := by
  intro N old τ
  dsimp only
  unfold unrestrictedResidueEdgeAction
  rw [unrestricted_residue_eligible_perm]
  apply unrestricted_edge_action_perm
  · intro stores promotions e fresh
    rfl
  · exact hF
end

section
open Finset
section

variable
  {I : Type*}
  [sharedInstance1 : Fintype I]
  [sharedInstance2 : DecidableEq I]
  (choices : I → Finset ℕ)
  (i : I)

include I sharedInstance1 sharedInstance2 choices i

theorem ordered_slot_product_split  (x : ∀ j, choices j) :
    orderedSlotProduct choices x = (x i).val *
      orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) (fun j => x j.val) :=
  Fintype.prod_eq_mul_prod_subtype_ne (fun j => (x j).val) i

theorem ordered_slot_sum_test_split  (F : ℕ → ℝ) :
    (∑ x : ∀ j, choices j, F (orderedSlotProduct choices x)) =
      ∑ p : choices i, ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
        F (p.val * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y) := by
  classical
  let f : choices i × (∀ j : {j : I // j ≠ i}, choices j.val) → ℝ := fun z =>
    F (z.1.val * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) z.2)
  calc
    _ = ∑ z, f z := by
      apply Fintype.sum_equiv (Equiv.piSplitAt i (fun j => choices j))
      intro x
      simp only [f, Equiv.piSplitAt_apply]
      rw [ordered_slot_product_split choices i x]
    _ = _ := Fintype.sum_prod_type f

theorem ordered_slot_weight_split  (normalization : ℝ) (n : ℕ) :
    orderedSlotWeight choices normalization n =
      ∑ p : choices i, ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
        if p.val * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y = n
        then 1 / normalization else 0 := by
  classical
  unfold orderedSlotWeight
  have h := ordered_slot_sum_test_split choices i (fun m => if m = n then 1 / normalization else 0)
  convert h using 1
  apply Finset.sum_congr
  · ext x
    simp
  · intro x _
    rfl


theorem ordered_slot_harmonic_split  (normalization : ℝ) :
    (∑' n : ℕ, orderedSlotWeight choices normalization n / (n : ℝ)) =
      (∑ p ∈ choices i, 1 / (p : ℝ)) *
        (∑' n : ℕ,
          orderedSlotWeight (fun j : {j : I // j ≠ i} => choices j.val) normalization n / (n : ℝ)) := by
  rw [ordered_slot_harmonic_sum, ordered_slot_harmonic_sum,
    Fintype.prod_eq_mul_prod_subtype_ne (fun j => ∑ p ∈ choices j, 1 / (p : ℝ)) i]
  ring

end

end

section
open Finset
noncomputable def restrictedSlotChoices {I : Type*} [DecidableEq I]
    (choices restricted : I → Finset ℕ) (E : Finset I) (i : I) : Finset ℕ :=
  if i ∈ E then restricted i else choices i

theorem restricted_slot_harmonic_lower {I : Type*} [Fintype I] [DecidableEq I]
    (choices restricted : I → Finset ℕ) (E : Finset I) {eta normalization : ℝ}
    (heta : 0 ≤ eta) (hnorm : 0 ≤ normalization)
    (hmass : ∀ i ∈ E, eta * (∑ p ∈ choices i, 1 / (p : ℝ)) ≤
      ∑ p ∈ restricted i, 1 / (p : ℝ)) :
    eta^E.card * (∑' n : ℕ, orderedSlotWeight choices normalization n / (n : ℝ)) ≤
      ∑' n : ℕ,
        orderedSlotWeight (restrictedSlotChoices choices restricted E) normalization n / (n : ℝ) := by
  classical
  rw [ordered_slot_harmonic_sum, ordered_slot_harmonic_sum]
  have hprod : eta^E.card * (∏ i, ∑ p ∈ choices i, 1 / (p : ℝ)) ≤
      ∏ i, ∑ p ∈ restrictedSlotChoices choices restricted E i, 1 / (p : ℝ) := by
    have hid : eta^E.card * (∏ i, ∑ p ∈ choices i, 1 / (p : ℝ)) =
        ∏ i, (if i ∈ E then eta else 1) * (∑ p ∈ choices i, 1 / (p : ℝ)) := by
      rw [prod_mul_distrib, prod_ite_mem]
      simp
    rw [hid]
    apply prod_le_prod₀
    · intro i _
      exact mul_nonneg (by split_ifs <;> positivity) (sum_nonneg (fun _ _ => by positivity))
    · intro i _
      by_cases hi : i ∈ E
      · simpa only [restrictedSlotChoices, if_pos hi] using hmass i hi
      · simp only [restrictedSlotChoices, if_neg hi, one_mul, le_refl]
  have h := div_le_div_of_nonneg_right hprod hnorm
  simpa only [mul_div_assoc] using h
end

section
open Finset Filter
open scoped Topology
noncomputable def narrowQBand (s eps : ℝ) (j : ℕ) : Finset ℕ :=
  dyadicPrimeBand s ((11/10 : ℝ) - eps) ((11/10 : ℝ) + eps) j

theorem narrowQBand_subset_candidateQBand {s eps : ℝ} (hs : 0 ≤ s)
    (heps : eps ≤ 1/10) (j : ℕ) : narrowQBand s eps j ⊆ candidateQBand s j := by
  exact dyadicPrimeBand_subset_of_bounds j hs (by linarith) (by linarith)

theorem exists_narrowQBand_harmonic_lower {c eps : ℝ} (hc : 0 < c)
    (heps0 : 0 < eps) (heps1 : eps ≤ 1/10) :
    ∃ v : ℝ, 0 < v ∧ ∀ᶠ L : ℝ in atTop, ∀ j ∈ candidateQIndices c L,
      v ≤ ∑ p ∈ narrowQBand (c * L) eps j, 1 / (p : ℝ) := by
  have ha : 0 < (11/10 : ℝ) - eps := by linarith
  have hab : (11/10 : ℝ) - eps < (11/10 : ℝ) + eps := by linarith
  obtain ⟨v, V, t0, hv, _, _, ht0⟩ :=
    exists_primeBandHarmonic_threshold ((one_lt_div ha).mpr hab)
  refine ⟨v, hv, ?_⟩
  filter_upwards [eventually_candidateQIndices_geometry hc, eventually_gt_atTop (0 : ℝ),
    Real.tendsto_log_atTop.eventually (eventually_ge_atTop (t0 / 20))] with L hg hL ht
  intro j hj
  have hlo := (hg.2 j hj).1
  have hscale : t0 ≤ ((11/10 : ℝ) - eps) * (c * L) / 2^j := by
    have hbase : 0 ≤ c * L / 2^j := by positivity
    have hh : 1 ≤ (11/10 : ℝ) - eps := by linarith
    have hmul := le_mul_of_one_le_left hbase hh
    rw [← mul_div_assoc] at hmul
    linarith
  have h := (ht0 (((11/10 : ℝ) - eps) * (c * L) / 2^j) hscale).1
  rw [← dyadicPrimeBand_harmonic_eq_log_ratio (c * L) ((11/10 : ℝ) - eps)
    ((11/10 : ℝ) + eps) j ha.ne'] at h
  exact h

theorem exists_narrowQBand_harmonic_ratio {c eps : ℝ} (hc : 0 < c)
    (heps0 : 0 < eps) (heps1 : eps ≤ 1/10) :
    ∃ eta : ℝ, 0 < eta ∧ eta ≤ 1 ∧ ∀ᶠ L : ℝ in atTop, ∀ j ∈ candidateQIndices c L,
      eta * (∑ p ∈ candidateQBand (c * L) j, 1 / (p : ℝ)) ≤
        ∑ p ∈ narrowQBand (c * L) eps j, 1 / (p : ℝ) := by
  obtain ⟨v, hv, hnarrow⟩ := exists_narrowQBand_harmonic_lower hc heps0 heps1
  obtain ⟨vl, V, _, hV, hwide⟩ := exists_candidateQBands_bounds hc
  let eta : ℝ := min 1 (v / V)
  have heta : 0 < eta := lt_min zero_lt_one (div_pos hv hV)
  refine ⟨eta, heta, min_le_left _ _, ?_⟩
  filter_upwards [hnarrow, hwide] with L hn hw
  intro j hj
  calc
    eta * (∑ p ∈ candidateQBand (c * L) j, 1 / (p : ℝ)) ≤ eta * V :=
      mul_le_mul_of_nonneg_left ((hw.2.2 j hj).2.2.2) heta.le
    _ ≤ v := (le_div_iff₀ hV).mp (min_le_right _ _)
    _ ≤ _ := hn j hj
end

section
open Finset Filter
open scoped Topology
noncomputable def candidatePrefixSlots (c L : ℝ) (r J : ℕ) :
    Finset ((candidateQIndices c L) × Fin r) := by
  classical
  exact univ.filter (fun slot => slot.1.val ≤ J ∧ ¬(slot.1.val = 0 ∧ slot.2.val = 0))

noncomputable def candidatePrefixChoices (c L eps : ℝ) (r jStar J : ℕ) :
    (candidateQIndices c L) × Fin r → Finset ℕ :=
  restrictedSlotChoices (candidateQSlotChoices c L r jStar)
    (fun slot => narrowQBand (c * L) eps slot.1.val) (candidatePrefixSlots c L r J)

noncomputable def candidatePrefixHarmonicMass (c L eps : ℝ) (r jStar J : ℕ) : ℝ :=
  ∑' n : ℕ,
    orderedSlotWeight (candidatePrefixChoices c L eps r jStar J)
      ((r.factorial : ℝ)^(candidateQIndices c L).card) n / (n : ℝ)

theorem candidatePrefixSlots_card_le (c L : ℝ) (r J : ℕ) :
    (candidatePrefixSlots c L r J).card ≤ (J + 1) * r := by
  classical
  have h := card_le_card_of_injOn (s := candidatePrefixSlots c L r J)
    (t := Icc 0 J ×ˢ (univ : Finset (Fin r)))
    (fun slot => (slot.1.val, slot.2)) (by
      intro slot hslot
      have hJ := (mem_filter.mp hslot).2.1
      exact mem_product.mpr ⟨mem_Icc.mpr ⟨Nat.zero_le _, hJ⟩, mem_univ _⟩) (by
      intro x _ y _ hxy
      exact Prod.ext (Subtype.ext (congrArg (fun z : ℕ × Fin r => z.1) hxy))
        (congrArg (fun z : ℕ × Fin r => z.2) hxy))
  simpa only [card_product, Nat.card_Icc, Nat.sub_zero, card_univ, Fintype.card_fin] using h

theorem candidatePrefixChoices_subset {c L eps : ℝ} (hcL : 0 ≤ c * L)
    (heps : eps ≤ 1/10) {r jStar J : ℕ} (hJ : J < jStar)
    (slot : (candidateQIndices c L) × Fin r) :
    candidatePrefixChoices c L eps r jStar J slot ⊆ candidateQSlotChoices c L r jStar slot := by
  classical
  unfold candidatePrefixChoices restrictedSlotChoices
  split_ifs with hslot
  · have hidx : slot.1.val ≤ J := (mem_filter.mp hslot).2.1
    have hneq : ¬(slot.1.val = jStar ∧ slot.2.val = 0) := by omega
    rw [candidateQSlotChoices, if_neg hneq]
    exact narrowQBand_subset_candidateQBand hcL heps slot.1.val
  · exact subset_rfl

theorem exists_candidate_prefix_harmonic_fraction {c eps : ℝ} (hc : 0 < c)
    (heps0 : 0 < eps) (heps1 : eps ≤ 1/10) (r J : ℕ) :
    ∃ rho : ℝ, 0 < rho ∧ ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J < jStar →
      rho * candidateQHarmonicMass c L r jStar ≤
        candidatePrefixHarmonicMass c L eps r jStar J := by
  obtain ⟨eta, heta, heta1, hratio⟩ := exists_narrowQBand_harmonic_ratio hc heps0 heps1
  refine ⟨eta^((J + 1) * r), pow_pos heta _, ?_⟩
  filter_upwards [hratio] with L hL
  intro jStar hJ
  have hmass : ∀ slot ∈ candidatePrefixSlots c L r J,
      eta * (∑ p ∈ candidateQSlotChoices c L r jStar slot, 1 / (p : ℝ)) ≤
        ∑ p ∈ narrowQBand (c * L) eps slot.1.val, 1 / (p : ℝ) := by
    intro slot hslot
    have hidx : slot.1.val ≤ J := (mem_filter.mp hslot).2.1
    have hneq : ¬(slot.1.val = jStar ∧ slot.2.val = 0) := by omega
    rw [candidateQSlotChoices, if_neg hneq]
    exact hL slot.1.val slot.1.property
  have h := restricted_slot_harmonic_lower (candidateQSlotChoices c L r jStar)
    (fun slot => narrowQBand (c * L) eps slot.1.val) (candidatePrefixSlots c L r J)
    heta.le (by positivity : 0 ≤ (r.factorial : ℝ)^(candidateQIndices c L).card) hmass
  have hnonneg : 0 ≤ candidateQHarmonicMass c L r jStar := by
    exact tsum_nonneg (fun n => div_nonneg (candidate_Q_weight_nonneg c L r jStar n) (Nat.cast_nonneg n))
  exact (mul_le_mul_of_nonneg_right
    (pow_le_pow_of_le_one heta.le heta1 (candidatePrefixSlots_card_le c L r J)) hnonneg).trans h
end

