open Finset
open scoped Classical
/- The unique promotion map from the empty selected target-slot set. -/
def unrestrictedCleanPromotion (t : ℕ) {N : ℕ} (eligible : Finset (Fin N)) :
    (∅ : Finset (Fin t)) ↪ eligible := Function.Embedding.ofIsEmpty

theorem unrestricted_clean_promotion_unique {t N : ℕ} (eligible : Finset (Fin N))
    (e : (∅ : Finset (Fin t)) ↪ eligible) : e = unrestrictedCleanPromotion t eligible := by
  ext s
  exact (notMem_empty s.val s.property).elim

theorem unrestricted_clean_selected_indices {t N : ℕ} (eligible : Finset (Fin N)) :
    promotionSelectedIndices (unrestrictedCleanPromotion t eligible) = ∅ := by
  apply card_eq_zero.mp
  rw [promotionSelectedIndices_card]
  simp

theorem unrestricted_clean_survivors {t N : ℕ} (eligible : Finset (Fin N)) :
    unrestrictedEdgeSurvivors (unrestrictedCleanPromotion t eligible) = univ := by
  rw [unrestrictedEdgeSurvivors, unrestricted_clean_selected_indices, sdiff_empty]

/- No promotion removes an old slot, irrespective of numerical label repetitions. -/
noncomputable def unrestrictedCleanSurvivorEquiv (t : ℕ) {N : ℕ}
    (eligible : Finset (Fin N)) :
    unrestrictedEdgeSurvivors (unrestrictedCleanPromotion t eligible) ≃ Fin N where
  toFun j := j.val
  invFun j := ⟨j, by rw [unrestricted_clean_survivors]; exact mem_univ j⟩
  left_inv _ := rfl
  right_inv _ := rfl

/- The actual retained-and-appended output index, with an empty appended block,
identified with an old slot. It does not assume the retained enumeration is identity. -/
noncomputable def unrestrictedCleanIndexEquiv (t : ℕ) {N : ℕ}
    (eligible : Finset (Fin N)) :
    Fin ((unrestrictedEdgeSurvivors (unrestrictedCleanPromotion t eligible)).card + 0) ≃ Fin N :=
  (retainedBirthIndexEquiv _ 0).trans
    ((Equiv.sumEmpty _ (Fin 0)).trans (unrestrictedCleanSurvivorEquiv t eligible))

section

variable
  {P Z : Type*}
  {t N : ℕ}
  (source : Fin t → P)
  (old : Fin N → Z)
  (seed : P → Z)
  (transport : Z → Z)
  (eligible : Finset (Fin N))

include P Z t N source old seed transport eligible

/- Pointwise evaluation of the actual clean output under its index equivalence. -/
theorem unrestricted_clean_output_apply 
    (j : Fin (unrestrictedEdgeOutput source old seed transport ∅ ∅
      (unrestrictedCleanPromotion t eligible)).1) :
    (unrestrictedEdgeOutput source old seed transport ∅ ∅
      (unrestrictedCleanPromotion t eligible)).2 j =
      transport (old (unrestrictedCleanIndexEquiv t eligible j)) := by
  change Fin ((unrestrictedEdgeSurvivors (unrestrictedCleanPromotion t eligible)).card + 0) at j
  change (retainedBirthTuple (transport ∘ old)
    (unrestrictedEdgeSurvivors (unrestrictedCleanPromotion t eligible))
    (transport ∘ unrestrictedStoredTuple source seed ∅)).2 j = _
  refine Eq.trans (retained_birth_tuple_apply_index_equiv (b := 0) (transport ∘ old)
    (unrestrictedEdgeSurvivors (unrestrictedCleanPromotion t eligible))
    (transport ∘ unrestrictedStoredTuple source seed ∅) j) ?_
  have hi : unrestrictedCleanIndexEquiv t eligible j =
      unrestrictedCleanSurvivorEquiv t eligible
        (Equiv.sumEmpty _ (Fin 0)
          (retainedBirthIndexEquiv
            (unrestrictedEdgeSurvivors (unrestrictedCleanPromotion t eligible)) 0 j)) := rfl
  rw [hi]
  generalize hk : retainedBirthIndexEquiv
    (unrestrictedEdgeSurvivors (unrestrictedCleanPromotion t eligible)) 0 j = k
  cases k with
  | inl k => rfl
  | inr k => exact Fin.elim0 k

theorem unrestricted_clean_output_length  :
    (unrestrictedEdgeOutput source old seed transport ∅ ∅
      (unrestrictedCleanPromotion t eligible)).1 = N := by
  change (unrestrictedEdgeMemory old transport (unrestrictedStoredTuple source seed ∅)
    (unrestrictedCleanPromotion t eligible)).1 = N
  rw [unrestrictedEdgeMemory_length]
  simp

end


/- A symmetric tuple test is unchanged by any explicit index equivalence. -/
theorem ordered_tuple_symmetric_of_index_equiv {Z K : Type*}
    (F : FiniteOrderedTuple Z → K) (hF : OrderedTupleSymmetric F)
    (q : FiniteOrderedTuple Z) {N : ℕ} (p : Fin N → Z)
    (e : Fin q.1 ≃ Fin N) (hv : ∀ j, q.2 j = p (e j)) : F q = F ⟨N, p⟩ := by
  rcases q with ⟨n, q⟩
  have hn : n = N := by simpa only [Fintype.card_fin] using Fintype.card_congr e
  subst n
  have hq : q = p ∘ e := funext hv
  change F ⟨N, q⟩ = _
  rw [hq]
  exact hF N p e

/- A symmetric tuple test only sees the transported old memory. -/
theorem unrestricted_clean_output_symmetric {P Z K : Type*} {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (eligible : Finset (Fin N)) (F : FiniteOrderedTuple Z → K)
    (hF : OrderedTupleSymmetric F) :
    F (unrestrictedEdgeOutput source old seed transport ∅ ∅
      (unrestrictedCleanPromotion t eligible)) = F ⟨N, transport ∘ old⟩ :=
  ordered_tuple_symmetric_of_index_equiv F hF _ (transport ∘ old)
    (unrestrictedCleanIndexEquiv t eligible)
    (unrestricted_clean_output_apply source old seed transport eligible)

section

variable
  {P Z : Type*}
  {t N : ℕ}
  (source : Fin t → P)
  (old : Fin N → Z)
  (seed : P → Z)
  (transport : Z → Z)

include P Z t N source old seed transport

/- Output hit counts include all transported old occurrences, even repeated ones. -/
theorem unrestricted_clean_output_count 
    (eligible : Finset (Fin N)) (hit : Z → Prop) :
    orderedPredicateCount (unrestrictedEdgeOutput source old seed transport ∅ ∅
      (unrestrictedCleanPromotion t eligible)) hit =
      orderedPredicateCount ⟨N, transport ∘ old⟩ hit := by
  unfold orderedPredicateCount
  calc
    _ = ∑ j, if hit (transport (old (unrestrictedCleanIndexEquiv t eligible j))) then 1 else 0 := by
      apply sum_congr rfl
      intro j _
      rw [unrestricted_clean_output_apply]
    _ = _ := (unrestrictedCleanIndexEquiv t eligible).sum_comp
      (fun j => if hit (transport (old j)) then (1 : ℕ) else 0)

/- Empty promotions remove the V denominator entirely. Both actual endpoint
rho counts remain, with no factorial or per-old-particle measure inserted. -/
theorem unrestricted_clean_event_mass 
    (hit : Z → Prop) (μ : P → ℝ) (ρ V : ℝ) (eligible : Finset (Fin N))
    (fresh : UnrestrictedFreshLabels P (∅ : Finset (Fin t))) :
    unrestrictedEdgeEventMass source old seed transport hit μ ρ V ∅ ∅
      (unrestrictedCleanPromotion t eligible) fresh =
      (ρ ^ orderedPredicateCount ⟨N, old⟩ hit *
        ρ ^ orderedPredicateCount ⟨N, transport ∘ old⟩ hit) *
        unrestrictedFreshWeight μ ∅ fresh := by
  unfold unrestrictedEdgeEventMass
  rw [unrestricted_clean_output_count]
  simp only [card_empty, pow_zero, div_one]

end


/- With no promotions, the fresh slots are every target slot. -/
def unrestrictedCleanFreshSlotEquiv (t : ℕ) :
    {j : Fin t // j ∉ (∅ : Finset (Fin t))} ≃ Fin t where
  toFun j := j.val
  invFun j := ⟨j, notMem_empty j⟩
  left_inv _ := rfl
  right_inv _ := rfl

def unrestrictedCleanFreshEquiv (P : Type*) (t : ℕ) :
    UnrestrictedFreshLabels P (∅ : Finset (Fin t)) ≃ (Fin t → P) where
  toFun fresh j := fresh ((unrestrictedCleanFreshSlotEquiv t).symm j)
  invFun target j := target j.val
  left_inv _ := rfl
  right_inv _ := rfl

theorem unrestricted_clean_target {P Z : Type*} {t N : ℕ}
    (old : Fin N → Z) (label : Z → P) (eligible : Finset (Fin N))
    (fresh : UnrestrictedFreshLabels P (∅ : Finset (Fin t))) :
    unrestrictedEdgeTarget old label ∅ (unrestrictedCleanPromotion t eligible) fresh =
      unrestrictedCleanFreshEquiv P t fresh := by
  funext j
  simp only [unrestrictedEdgeTarget, unrestrictedTargetLabels, notMem_empty]
  rfl

theorem unrestricted_clean_fresh_weight {P : Type*} {t : ℕ} (μ : P → ℝ)
    (fresh : UnrestrictedFreshLabels P (∅ : Finset (Fin t))) :
    unrestrictedFreshWeight μ ∅ fresh =
      ∏ j, μ (unrestrictedCleanFreshEquiv P t fresh j) := by
  exact (unrestrictedCleanFreshSlotEquiv t).prod_comp
    (fun j => μ (unrestrictedCleanFreshEquiv P t fresh j))







/- Complex tests have the same unrestricted product fresh-label integral. -/
theorem unrestricted_clean_fresh_complex_sum {P : Type*} [Fintype P] {t : ℕ}
    (μ : P → ℝ) (G : (Fin t → P) → ℂ) :
    (∑ fresh : UnrestrictedFreshLabels P (∅ : Finset (Fin t)),
      (unrestrictedFreshWeight μ ∅ fresh : ℂ) * G (unrestrictedCleanFreshEquiv P t fresh)) =
      ∑ target : Fin t → P, ((∏ j, μ (target j) : ℝ) : ℂ) * G target := by
  simp_rw [unrestricted_clean_fresh_weight]
  exact (unrestrictedCleanFreshEquiv P t).sum_comp
    (fun target => ((∏ j, μ (target j) : ℝ) : ℂ) * G target)

section

variable
  {P Z : Type*}
  [sharedInstance1 : Fintype P]
  {t N : ℕ}
  (source : Fin t → P)
  (old : Fin N → Z)
  (label : Z → P)
  (seed : P → Z)
  (transport : Z → Z)
  (hit : Z → Prop)
  (μ : P → ℝ)
  (ρ V : ℝ)
  (eligible : Finset (Fin N))

include P Z sharedInstance1 t N source old label seed transport hit μ ρ V eligible

/- Exact complex event integral with both real rho factors retained. -/
theorem unrestricted_clean_event_complex_sum  (G : (Fin t → P) → ℂ) :
    (∑ fresh : UnrestrictedFreshLabels P (∅ : Finset (Fin t)),
      (unrestrictedEdgeEventMass source old seed transport hit μ ρ V ∅ ∅
        (unrestrictedCleanPromotion t eligible) fresh : ℂ) *
        G (unrestrictedEdgeTarget old label ∅ (unrestrictedCleanPromotion t eligible) fresh)) =
      ((ρ ^ orderedPredicateCount ⟨N, old⟩ hit *
        ρ ^ orderedPredicateCount ⟨N, transport ∘ old⟩ hit : ℝ) : ℂ) *
        ∑ target : Fin t → P, ((∏ j, μ (target j) : ℝ) : ℂ) * G target := by
  simp_rw [unrestricted_clean_event_mass, unrestricted_clean_target,
    Complex.ofReal_mul, mul_assoc]
  rw [← mul_sum, ← mul_sum, unrestricted_clean_fresh_complex_sum]

/- A coupled complex continuation symmetric in memory is evaluated on the
transported old tuple inside the full unrestricted target integral. -/
theorem unrestricted_clean_symmetric_continuation 
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ)
    (hF : ∀ target, OrderedTupleSymmetric (F target)) :
    (∑ fresh : UnrestrictedFreshLabels P (∅ : Finset (Fin t)),
      (unrestrictedEdgeEventMass source old seed transport hit μ ρ V ∅ ∅
        (unrestrictedCleanPromotion t eligible) fresh : ℂ) *
        F (unrestrictedEdgeTarget old label ∅ (unrestrictedCleanPromotion t eligible) fresh)
          (unrestrictedEdgeOutput source old seed transport ∅ ∅
            (unrestrictedCleanPromotion t eligible))) =
      ((ρ ^ orderedPredicateCount ⟨N, old⟩ hit *
        ρ ^ orderedPredicateCount ⟨N, transport ∘ old⟩ hit : ℝ) : ℂ) *
        ∑ target : Fin t → P, ((∏ j, μ (target j) : ℝ) : ℂ) * F target ⟨N, transport ∘ old⟩ := by
  simp_rw [unrestricted_clean_output_symmetric source old seed transport eligible _ (hF _)]
  exact unrestricted_clean_event_complex_sum source old label seed transport hit μ ρ V eligible
    (fun target => F target ⟨N, transport ∘ old⟩)

end

end

