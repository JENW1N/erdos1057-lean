    (z : Y → ℂ) (hz : ∀ y, ‖z y‖ = 1) (a N : ℕ)
    (c : Fin N → ℂ) (b : Y → ℂ) {B : ℝ}
    (hrow : ∀ y, (∑ w, geometricChordBound N ((starRingEnd ℂ) (z y) * z w)) ≤ B) :
    ‖∑ n : Fin N, ∑ y, c n * b y * (z y) ^ (a + n.val)‖ ^ 2 ≤
      B * (∑ n : Fin N, ‖c n‖ ^ 2) * ∑ y, ‖b y‖ ^ 2 := by
  apply finite_bilinear_gram_norm_sq_le
  intro y
  exact (Finset.sum_le_sum (fun w _ =>
    unit_geometric_column_gram_bound _ _ (hz y) (hz w) a N)).trans (hrow y)
