/- Power-saving centered Fourier reduction on the exact common integer support. -/

open Finset MeasureTheory Filter

namespace Bounty

theorem eventually_common_centered_fourier_of_mellin {b : ℝ} (hb : 0 < b)
    (A B : ℝ) :
    ∃ D : ℝ, A < D ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (Y H c : ℝ) (f : ℤ → ℂ),
      Real.exp (b*L) ≤ Y → Real.log Y ≤ 6*L →
      1 ≤ H → H ≤ Real.exp ((b/2)*L) →
      (∑ n ∈ harmonicCommonSupport Y, ‖f n‖^2) ≤ Y*L^B →
      (∫ t in {t : ℝ | |t| ≤ L*Y/H},
        ‖localMellinPolynomial ((harmonicCommonSupport Y).image Int.natAbs)
          (fun n => f n*fourier (n:ℤ) (c:AddCircle (1:ℝ))) t‖^2) ≤ Y^2*L^(-D) →
      (∫ x in Set.Icc (c-1/H) (c+1/H),
        ‖finiteFourierSum (harmonicCommonSupport Y) f x‖^2) ≤ Y*L^(-A) := by
  obtain ⟨D,hD,hred⟩ := eventually_local_fourier_of_mellin hb (by norm_num : (0:ℝ)≤64) A B
  refine ⟨D,hD,?_⟩
  filter_upwards [hred,eventually_harmonic_common_cutoff_geometry,
    eventually_ge_atTop (1:ℝ)] with L hred hcut hL
  intro Y H c f hY hlog hH hHu hE hM
  have hYp : 0 < Y := (Real.exp_pos _).trans_le hY
  have hY1 : 1 ≤ Y := (Real.one_le_exp (by positivity : 0 ≤ b*L)).trans hY
  have hHp : 0 < H := lt_of_lt_of_le zero_lt_one hH
  have hpos : ∀ n ∈ harmonicCommonSupport Y, 0 ≤ n :=
    fun n hn => (harmonic_common_support_positive hYp hn).le
  obtain ⟨hN,hlogN⟩ := hcut Y hY1 hlog
  have hSN : ∀ n ∈ (harmonicCommonSupport Y).image Int.natAbs,
      n ≤ ⌈4*Real.exp 2*Y⌉₊ :=
    fun n hn => (harmonic_common_natural_support_bound hYp hn).2
  have hS : ∀ n ∈ (harmonicCommonSupport Y).image Int.natAbs,
      Y/8 ≤ (n:ℝ) ∧ (n:ℝ) ≤ 64*Y := by
    intro n hn
    exact ⟨((mem_harmonic_common_natural_support hYp).mp hn).1,
      (Nat.cast_le.mpr (hSN n hn)).trans hN⟩
  rw [finite_fourier_centered_energy (harmonicCommonSupport Y) f hpos c H hHp]
  apply hred Y H ((harmonicCommonSupport Y).image Int.natAbs)
    (fun n => f n*fourier (n:ℤ) (c:AddCircle (1:ℝ))) ⌈4*Real.exp 2*Y⌉₊
    hY hH hHu hS hSN hN hlogN _ hM
  rw [finite_fourier_modulated_energy (harmonicCommonSupport Y) f hpos c]
  exact hE

end Bounty
