section

/- A source-dependent sparse support improves an average of already
bounded operations. The support restriction is used before the energy
integral; no row-independent exceptional set is assumed. -/

open Finset
open scoped Classical

namespace Bounty

theorem finite_sparse_average_sq_le {A : Type*} [Fintype A]
    (π : A → ℝ) (hπ : ∀ a, 0 ≤ π a) (bad : A → Prop)
    (F : A → ℂ) (hzero : ∀ a, ¬ bad a → F a = 0)
    {δ : ℝ} (hδ : 0 ≤ δ) (hmass : (∑ a, if bad a then π a else 0) ≤ δ) :
    ‖∑ a, (π a : ℂ) * F a‖ ^ 2 ≤ δ * ∑ a, π a * ‖F a‖ ^ 2 := by
  let q : A → ℝ := fun a => if bad a then π a else 0
  have hq : ∀ a, 0 ≤ q a := by
    intro a
    dsimp only [q]
    split_ifs
    · exact hπ a
    · exact le_rfl
  have he : (∑ a, (π a : ℂ) * F a) = ∑ a, (q a : ℂ) * F a := by
    apply sum_congr rfl
    intro a _
    by_cases ha : bad a
    · simp only [q, if_pos ha]
    · simp only [q, if_neg ha, hzero a ha, mul_zero]
  rw [he]
  apply (finite_weighted_sum_cauchy univ q (fun a _ => hq a) F).trans
  apply mul_le_mul hmass _ _ hδ
  · apply sum_le_sum
    intro a _
    apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
    dsimp only [q]
    split_ifs
    · exact le_rfl
    · exact hπ a
  · exact sum_nonneg fun a _ => mul_nonneg (hq a) (sq_nonneg _)

theorem finite_sparse_average_energy_le {A X : Type*} [Fintype A] [Fintype X]
    (π : A → ℝ) (hπ : ∀ a, 0 ≤ π a) (hπmass : ∑ a, π a ≤ 1)
    (w : X → ℝ) (hw : ∀ x, 0 ≤ w x)
    (bad : A → X → Prop) (F : A → X → ℂ)
    (hzero : ∀ a x, ¬ bad a x → F a x = 0)
    {δ K : ℝ} (hδ : 0 ≤ δ) (hK : 0 ≤ K)
    (hmass : ∀ x, (∑ a, if bad a x then π a else 0) ≤ δ)
    (f : X → ℂ) (hF : ∀ a, finiteWeightedEnergy w (F a) ≤ K * finiteWeightedEnergy w f) :
    finiteWeightedEnergy w (fun x => ∑ a, (π a : ℂ) * F a x) ≤
      δ * K * finiteWeightedEnergy w f := by
  have hE : 0 ≤ finiteWeightedEnergy w f :=
    sum_nonneg fun x _ => mul_nonneg (hw x) (sq_nonneg _)
  calc
    _ ≤ ∑ x, w x * (δ * ∑ a, π a * ‖F a x‖ ^ 2) :=
      sum_le_sum fun x _ => mul_le_mul_of_nonneg_left
        (finite_sparse_average_sq_le π hπ (fun a => bad a x) (fun a => F a x)
          (fun a => hzero a x) hδ (hmass x)) (hw x)
    _ = δ * ∑ a, π a * finiteWeightedEnergy w (F a) := by
      simp only [finiteWeightedEnergy, mul_sum]
      rw [sum_comm]
      apply sum_congr rfl
      intro a _
      apply sum_congr rfl
      intro x _
      ring
    _ ≤ δ * ∑ a, π a * (K * finiteWeightedEnergy w f) :=
      mul_le_mul_of_nonneg_left (sum_le_sum fun a _ =>
        mul_le_mul_of_nonneg_left (hF a) (hπ a)) hδ
    _ = δ * ((∑ a, π a) * (K * finiteWeightedEnergy w f)) := by rw [sum_mul]
    _ ≤ δ * (1 * (K * finiteWeightedEnergy w f)) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_right hπmass (mul_nonneg hK hE)) hδ
    _ = _ := by ring

end Bounty
end

section

/- Exact transfer masks in the factorial-measure adjoint. A storage mask
becomes a promotion mask after reversal. Both endpoint caps are retained,
and the reverse promotion/storage normalization is explicit. -/

open Finset Classical

namespace Bounty

section

variable
  {P : Type*}
  [sharedInstance1 : Fintype P]
  (n : P → ℕ)
  [sharedInstance3 : ∀ p, NeZero (n p)]
  (μ : P → ℝ)
  (Δ D : ℤ)
  (ρ : ℝ)
  {V : ℝ}
  (hV : V ≠ 0)
  (t Bsrc Btgt : ℕ)
  (w : Finset (Fin t) → Finset (Fin t) → ℂ)
  (F H : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ)
  (hF : ∀ source, OrderedTupleSymmetric (F source))
  (hH : ∀ target, OrderedTupleSymmetric (H target))

include P sharedInstance1 n sharedInstance3 μ Δ D ρ V hV t Bsrc Btgt w F H hF hH

/- Arbitrary coefficients depending only on the two active slot subsets
are transported by interchanging the subsets. -/
theorem unrestricted_weighted_bounded_action_pairing_reverse  :
    (∑ N ∈ range (Bsrc + 1),
      unrestrictedWeightedActionLevelPairing n μ Δ D ρ V t N Btgt w F H) =
    ∑ M ∈ range (Btgt + 1),
      unrestrictedWeightedActionLevelPairing n μ (-Δ) D ρ V t M Bsrc
        (fun S T => ((V ^ T.card / V ^ S.card : ℝ) : ℂ) * w T S) H F := by
  simp_rw [unrestricted_weighted_action_level_pairing_slots]
  rw [unrestricted_three_sum_rotate, unrestricted_three_sum_rotate]
  conv_rhs => rw [sum_comm]
  apply sum_congr rfl
  intro S hS
  apply sum_congr rfl
  intro T hT
  conv_lhs => rw [← mul_sum]
  conv_rhs => rw [← mul_sum]
  have hc : (((V ^ S.card / V ^ T.card : ℝ) : ℂ) * w S T) *
      ((1 / V ^ S.card : ℝ) : ℂ) = w S T * ((1 / V ^ T.card : ℝ) : ℂ) := by
    have hr : ((V ^ S.card / V ^ T.card : ℝ) : ℂ) *
        ((1 / V ^ S.card : ℝ) : ℂ) = ((1 / V ^ T.card : ℝ) : ℂ) := by
      rw [← Complex.ofReal_mul]
      congr 1
      field_simp
    calc
      _ = w S T * (((V ^ S.card / V ^ T.card : ℝ) : ℂ) *
          ((1 / V ^ S.card : ℝ) : ℂ)) := by ring
      _ = _ := by rw [hr]
  conv_rhs => rw [hc]
  apply congrArg (fun z : ℂ => (w S T * ((1 / V ^ T.card : ℝ) : ℂ)) * z)
  have hr := unrestricted_fixed_slot_bounded_reverse n μ Δ D t Bsrc Btgt S T
    (unrestrictedDampedPair n ρ F H)
    (unrestricted_damped_pair_source_symmetric n ρ F H hF)
    (unrestricted_damped_pair_target_symmetric n ρ F H hH)
  refine hr.trans ?_
  apply sum_congr rfl
  intro M hM
  apply congrArg (unrestrictedFixedSlotPairing n μ (-Δ) D t M T S)
  funext target source Y X
  split_ifs
  · unfold unrestrictedDampedPair
    push_cast
    ring
  · rfl

/- Literal bounded-state masked adjoint, with independently chosen source
and target caps. No positivity or normalization of the label law is needed. -/
theorem unrestricted_bounded_masked_pairing_reverse  :
    (∑ s : BoundedOrderedState P (UnrestrictedResidueParticle n) t Bsrc,
      (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
        F s.1 (boundedOrderedTupleToFinite s.2) *
        unrestrictedResidueEdgeAction n Δ D s.1 s.2.2 μ ρ V Btgt
          (fun S T _ _ => w S T) H) =
    ∑ s : BoundedOrderedState P (UnrestrictedResidueParticle n) t Btgt,
      (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
        unrestrictedResidueEdgeAction n (-Δ) D s.1 s.2.2 μ ρ V Bsrc
          (fun S T _ _ => ((V ^ T.card / V ^ S.card : ℝ) : ℂ) * w T S) F *
        H s.1 (boundedOrderedTupleToFinite s.2) := by
  let A (source : Fin t → P) (q : FiniteOrderedTuple (UnrestrictedResidueParticle n)) : ℂ :=
    unrestrictedResidueEdgeAction n Δ D source q.2 μ ρ V Btgt (fun S T _ _ => w S T) H
  let R (source : Fin t → P) (q : FiniteOrderedTuple (UnrestrictedResidueParticle n)) : ℂ :=
    unrestrictedResidueEdgeAction n (-Δ) D source q.2 μ ρ V Bsrc
      (fun S T _ _ => ((V ^ T.card / V ^ S.card : ℝ) : ℂ) * w T S) F
  have hl := bounded_ordered_pairing_levels μ (unrestrictedResidueWeight μ) t Bsrc F A
  have hr := bounded_ordered_pairing_levels μ (unrestrictedResidueWeight μ) t Btgt H R
  calc
    _ = ∑ N ∈ range (Bsrc + 1),
        unrestrictedWeightedActionLevelPairing n μ Δ D ρ V t N Btgt w F H := hl
    _ = ∑ M ∈ range (Btgt + 1),
        unrestrictedWeightedActionLevelPairing n μ (-Δ) D ρ V t M Bsrc
          (fun S T => ((V ^ T.card / V ^ S.card : ℝ) : ℂ) * w T S) H F :=
      unrestricted_weighted_bounded_action_pairing_reverse n μ Δ D ρ hV t Bsrc Btgt w F H hF hH
    _ = ∑ s : BoundedOrderedState P (UnrestrictedResidueParticle n) t Btgt,
        (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
          H s.1 (boundedOrderedTupleToFinite s.2) * R s.1 (boundedOrderedTupleToFinite s.2) := hr.symm
    _ = _ := by
      apply sum_congr rfl
      intro s hs
      change (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
          H s.1 (boundedOrderedTupleToFinite s.2) * R s.1 (boundedOrderedTupleToFinite s.2) =
        (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
          R s.1 (boundedOrderedTupleToFinite s.2) * H s.1 (boundedOrderedTupleToFinite s.2)
      ring

end





/- The finite operator with a source-independent active-subset coefficient. -/
noncomputable def unrestrictedSlotOperator {P : Type*} [Fintype P]
    (n : P → ℕ) (Δ D : ℤ) (μ : P → ℝ) (ρ V : ℝ) (t B : ℕ)
    (w : Finset (Fin t) → Finset (Fin t) → ℂ) :=
  unrestrictedBoundedOperator n Δ D μ ρ V t B (fun _ S T _ _ => w S T)

theorem unrestricted_slot_operator_symmetric {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (Δ D : ℤ) (μ : P → ℝ)
    (ρ V : ℝ) (t B : ℕ) (w : Finset (Fin t) → Finset (Fin t) → ℂ)
    (f : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hf : BoundedOrderedSymmetric f) :
    BoundedOrderedSymmetric (unrestrictedSlotOperator n Δ D μ ρ V t B w f) := by
  intro active N old τ
  unfold unrestrictedSlotOperator unrestrictedBoundedOperator unrestrictedBoundedAction
    unrestrictedResidueEdgeAction
  dsimp only
  rw [unrestricted_residue_eligible_perm]
  apply unrestricted_edge_action_perm
  · intros; rfl
  · exact (boundedOrderedZeroExtension_symmetric_iff f).mpr hf

/- The finite operator version of masked duality. The tests need only be
symmetric on the bounded state space. -/
theorem unrestricted_slot_operator_pairing_reverse {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (Δ D : ℤ) (μ : P → ℝ) (ρ : ℝ)
    {V : ℝ} (hV : V ≠ 0) (t B : ℕ)
    (w : Finset (Fin t) → Finset (Fin t) → ℂ)
    (f g : BoundedOrderedState P (UnrestrictedResidueParticle n) t B → ℂ)
    (hf : BoundedOrderedSymmetric f) (hg : BoundedOrderedSymmetric g) :
    (∑ s, (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) * f s *
      unrestrictedSlotOperator n Δ D μ ρ V t B w g s) =
    ∑ s, (boundedOrderedStateWeight μ (unrestrictedResidueWeight μ) s : ℂ) *
      unrestrictedSlotOperator n (-Δ) D μ ρ V t B
        (fun S T => ((V ^ T.card / V ^ S.card : ℝ) : ℂ) * w T S) f s * g s := by
  have h := unrestricted_bounded_masked_pairing_reverse n μ Δ D ρ hV t B B w
    (boundedOrderedZeroExtension f) (boundedOrderedZeroExtension g)
    ((boundedOrderedZeroExtension_symmetric_iff f).mpr hf)
    ((boundedOrderedZeroExtension_symmetric_iff g).mpr hg)
  simpa only [boundedOrderedZeroExtension_apply, unrestrictedSlotOperator,
    unrestrictedBoundedOperator, unrestrictedBoundedAction] using h










end Bounty
