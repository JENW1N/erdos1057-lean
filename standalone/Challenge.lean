/- Tilting each independent slot multiplies the product law by the product density. -/
theorem physical_tilted_birth_product_eq {I G : Type*} [Fintype I]
    {P : G → Finset ℕ} (V : G → ℝ) (γ : I → G)
    (b : ∀ g, P g → ℝ) (labels : ∀ i, P (γ i)) :
    (∏ i, tiltedPhysicalBirthLaw V (γ i) (b (γ i)) (labels i)) =
      (∏ i, physicalLabelLaw V (γ i) (labels i)) *
        ∏ i, 1 / b (γ i) (labels i) := by
  simp only [tiltedPhysicalBirthLaw, div_eq_mul_inv, one_mul,
    Finset.prod_mul_distrib]





















end

