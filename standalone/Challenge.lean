/- The common spectral bound after using a logarithmic pruning budget. -/
theorem pruning_energy_lower_bound {N D r : ℝ} (hN : 0 ≤ N) (hD : 1 ≤ D)
    (hr : 0 < r) :
    N / (100 * D * r ^ 2) ≤
      min (2 * (N / (2 * D)) / r ^ 2) (3 * N / (4 * Real.pi ^ 2 * r ^ 2)) := by
  have hD0 : 0 < D := lt_of_lt_of_le zero_lt_one hD
  have hr2 : 0 < r ^ 2 := sq_pos_of_pos hr
  have hpi2 : 0 < Real.pi ^ 2 := sq_pos_of_pos Real.pi_pos
  have hpi : Real.pi ^ 2 < 16 := by nlinarith [Real.pi_lt_four, Real.pi_pos]
  apply le_min
  · have heq : 2 * (N / (2 * D)) / r ^ 2 = N / (D * r ^ 2) := by
      field_simp
    rw [heq]
    apply div_le_div_of_nonneg_left hN (by positivity)
    nlinarith [mul_pos hD0 hr2]
  · apply (div_le_div_iff₀ (by positivity) (by positivity)).mpr
    have hc : 4 * Real.pi ^ 2 ≤ 300 * D := by nlinarith
    have hm := mul_le_mul_of_nonneg_right hc (mul_nonneg hN hr2.le)
    nlinarith

/- A sample with expected size `t` inherits an explicit Fourier exponent. -/
theorem sampling_energy_lower_bound {N n D r t E : ℝ}
    (hN : 0 ≤ N) (hn : 0 < n) (hnN : n ≤ N) (hD : 1 ≤ D) (hr : 0 < r)
    (ht : 0 < t) (htn : t / n ≤ 1 / 2)
    (hE : N / (100 * D * r ^ 2) ≤ E) :
    t / (200 * D * r ^ 2) ≤ (t / n) * (1 - t / n) * E := by
  have hD0 : 0 < D := lt_of_lt_of_le zero_lt_one hD
  have he0 : 0 ≤ E := le_trans (by positivity) hE
  have hρ : 0 < t / n := div_pos ht hn
  have hρN : t ≤ (t / n) * N := by
    have hh := mul_le_mul_of_nonneg_left hnN hρ.le
    simpa only [div_mul_cancel₀ _ hn.ne'] using hh
  calc
    t / (200 * D * r ^ 2) = (t / (100 * D * r ^ 2)) / 2 := by ring
    _ ≤ ((t / n) * N / (100 * D * r ^ 2)) / 2 := by gcongr
    _ = (t / n) * (N / (100 * D * r ^ 2)) / 2 := by ring
    _ ≤ (t / n) * E / 2 := by gcongr
    _ ≤ (t / n) * (1 - t / n) * E := by
      nlinarith [mul_nonneg (by linarith : 0 ≤ 1 / 2 - t / n)
        (mul_nonneg hρ.le he0)]

/- A logarithmic separation makes an exponential error a prescribed fraction
of the inverse ambient group-size bound. -/
theorem exp_error_le_inv_group {U a c : ℝ} (hc : 0 < c)
    (hgap : U + Real.log c ≤ a) :
    Real.exp (-a) ≤ Real.exp (-U) / c := by
  calc
    Real.exp (-a) ≤ Real.exp (-U - Real.log c) := Real.exp_le_exp.mpr (by linarith)
    _ = Real.exp (-U) / c := by rw [Real.exp_sub, Real.exp_log hc]

/- Quantitative Carmichael production with the pruning and Fourier errors
absorbed into explicit logarithmic inequalities. The retained size is between
half and all of the original prime reservoir. -/
theorem finite_carmichael_counting_bound {L : ℕ} [NeZero L]
    (S P : Finset ℕ) (hPS : P ⊆ S) (g : ℕ → (ZMod L)ˣ)
    (hprime : ∀ p ∈ P, p.Prime) (hL : ∀ p ∈ P, p - 1 ∣ L)
    (hcompat : ∀ p ∈ P, (g p : ZMod L) = (p : ZMod L))
    {B D U A : ℝ} (hB : 1 ≤ B) (hbound : ∀ p ∈ P, (p : ℝ) ≤ B)
    (hD : 1 ≤ D) (hlogD : (Nat.log 2 (Nat.card ((ZMod L)ˣ)) : ℝ) ≤ D)
    (hU : Real.log (Nat.card ((ZMod L)ˣ) : ℝ) ≤ U)
    {R : ℕ} (hR : 0 < R)
    (hRlarge : 64 * (S.card : ℝ) ≤ (P.card : ℝ) * R)
    (hsmall : (R - 1 : ℝ) * A ≤ S.card)
    (hamb : ∀ ξ : (ZMod L)ˣ →* ℂ, ξ ≠ 1 → ‖∑ p ∈ S, ξ (g p)‖ ≤ A) :
    ∃ n : ℕ, (P.card : ℝ) / 2 ≤ n ∧ n ≤ P.card ∧
      ∀ (t ν : ℝ) (k : ℕ),
        0 < t → 2 * t ≤ n → 0 ≤ ν → ν ≤ 1 →
        2 ≤ (1 - ν) * t → (k : ℝ) ≤ (1 - ν) * t →
        U + Real.log 4 ≤ t / (200 * D * (R : ℝ) ^ 2) →
        U + Real.log 8 ≤ ν ^ 2 * t / 4 →
        Real.exp (-U) / 2 * ((n : ℝ) / t) ^ k ≤
          Erdos1057.carmichaelCounting (B ^ ((1 + ν) * t)) := by
  have hD0 : 0 < D := lt_of_lt_of_le zero_lt_one hD
  have hM : 0 ≤ (P.card : ℝ) / (2 * D) := by positivity
  have hbudget : (P.card : ℝ) / (2 * D) *
      Nat.log 2 (Nat.card ((ZMod L)ˣ)) ≤ (P.card : ℝ) / 2 := by
    calc
      _ ≤ (P.card : ℝ) / (2 * D) * D := mul_le_mul_of_nonneg_left hlogD hM
      _ = (P.card : ℝ) / 2 := by field_simp
  obtain ⟨H, T, h, _, hTP, hhalf, _, hcount⟩ :=
    finite_carmichael_transfer S P hPS g hprime hL hcompat hB hbound hM hbudget
      hR hRlarge hsmall hamb
  have hcard : T.card ≤ P.card := Finset.card_le_card hTP
  refine ⟨T.card, hhalf, hcard, ?_⟩
  intro t ν k ht htn hν0 hν1 hsize hk hfourier htail
  have hn : 0 < (T.card : ℝ) := by linarith
  have hρ0 : 0 < t / T.card := div_pos ht hn
  have hρhalf : t / T.card ≤ 1 / 2 := (div_le_iff₀ hn).mpr (by linarith)
  have hρ1 : t / T.card ≤ 1 := hρhalf.trans (by norm_num)
  have heq : t / (T.card : ℝ) * T.card = t := div_mul_cancel₀ _ hn.ne'
  have hresult := hcount (t / T.card) ν k hρ0 hρ1 hν0 hν1
    (by rwa [heq]) (by rwa [heq])
  rw [heq] at hresult
  have hr : 0 < (R : ℝ) := by exact_mod_cast hR
  have hE := pruning_energy_lower_bound (N := (P.card : ℝ))
    (Nat.cast_nonneg _) hD hr
  have hsample := sampling_energy_lower_bound (Nat.cast_nonneg P.card) hn
    (by exact_mod_cast hcard) hD hr ht hρhalf hE
  have herr1 : Real.exp (-(t / T.card) * (1 - t / T.card) *
      min (2 * ((P.card : ℝ) / (2 * D)) / (R : ℝ) ^ 2)
        (3 * (P.card : ℝ) / (4 * Real.pi ^ 2 * (R : ℝ) ^ 2))) ≤
      Real.exp (-U) / 4 := by
    refine (Real.exp_le_exp.mpr ?_).trans (exp_error_le_inv_group (by norm_num) hfourier)
    linarith
  have herr2 : 2 * Real.exp (-ν ^ 2 * t / 4) ≤ Real.exp (-U) / 4 := by
    have h := exp_error_le_inv_group (by norm_num : (0 : ℝ) < 8) htail
    have he : -ν ^ 2 * t / 4 = -(ν ^ 2 * t / 4) := by ring
    rw [he]
    linarith
  have hHpos : 0 < (Nat.card H : ℝ) := by exact_mod_cast (Nat.card_pos (α := H))
  have hHlog : Real.log (Nat.card H : ℝ) ≤ U :=
    (Real.log_le_log hHpos (by exact_mod_cast H.card_le_card_group)).trans hU
  have hinv : Real.exp (-U) ≤ 1 / (Nat.card H : ℝ) := by
    calc
      _ ≤ Real.exp (-Real.log (Nat.card H : ℝ)) := Real.exp_le_exp.mpr (by linarith)
      _ = 1 / (Nat.card H : ℝ) := by rw [Real.exp_neg, Real.exp_log hHpos, one_div]
  have hnum : Real.exp (-U) / 2 ≤ 1 / (Nat.card H : ℝ) -
      Real.exp (-(t / T.card) * (1 - t / T.card) *
        min (2 * ((P.card : ℝ) / (2 * D)) / (R : ℝ) ^ 2)
          (3 * (P.card : ℝ) / (4 * Real.pi ^ 2 * (R : ℝ) ^ 2))) -
      2 * Real.exp (-ν ^ 2 * t / 4) := by linarith
  calc
    Real.exp (-U) / 2 * ((T.card : ℝ) / t) ^ k =
        (Real.exp (-U) / 2) / (t / T.card) ^ k := by
      rw [div_pow, div_pow]
      field_simp
    _ ≤ _ := (div_le_div_of_nonneg_right hnum (pow_nonneg hρ0.le _)).trans hresult
end

