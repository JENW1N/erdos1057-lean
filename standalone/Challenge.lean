/- Literal candidate cell-character auxiliary harmonic sums. The only
analytic inputs left are the two endpoint energies and rational local source
energy; empty cell tests give exactly zero. -/

open Finset Filter MeasureTheory
open scoped Classical
namespace Bounty

theorem exists_candidate_cell_local_energy_decay {c : ℝ}
    (hc : 0 < c) (J : ℕ) (D E K : ℝ) (hK : 0 ≤ K) :
    ∃ q : ℝ, 0 ≤ q ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
      let P := fun g : S => candidatePBand (c*L) g.val
      let V := fun g : S => ∑ p ∈ P g, 1/(p : ℝ)
      ∀ (ell : ℕ) (probes : S → Finset (Fin J)) (r t : Finset S)
        (A B : Finset (RepeatedBigFlatIndex S J ell)),
        A ⊆ r.sigma (repeatedBigPrimeProbeSlots probes) → A.Nonempty →
        B ⊆ t.sigma (repeatedBigPrimeProbeSlots probes) → B.Nonempty →
      ∀ (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex S J ell) ∉ A ∪ B)
        (hAB : Disjoint A B) (k : ℤ), k ≠ 0 → (k.natAbs : ℝ) ≤ L^K →
      ∀ (Q : ℕ) (h : ℝ), 0 < h → h ≤ 1 →
      ∀ (d e : ℤ) (χ ψ : BoundedPrimitiveCharacter Q) (a b v Y Z : ℝ)
        (F₀ G₀ : ℤ → ℂ), 0 < Y →
      let HA := Real.exp (((d : ℝ)-1)*h)
      let HB := Real.exp (((e : ℝ)-1)*h)
      (∑ n ∈ harmonicCommonSupport Y,
        ‖harmonicCellSource Y Z a (2*Real.pi*v) F₀ n‖^2) ≤ Y*L^E →
      (∑ n ∈ harmonicCommonSupport Y,
        ‖harmonicCellTarget Y b G₀ n‖^2) ≤ Y*L^E →
      ((∃ x : (∀ i : A, P i.val.1),
          (starRingEnd ℂ) (primeProductCellCharacter (fun i : A => P i.val.1) h d χ x) *
            physicalPhase (-(a+b+2*Real.pi*v)) (∏ i, (x i).val) ≠ 0) →
        (∃ y : (∀ i : B, P i.val.1),
          (starRingEnd ℂ) (primeProductCellCharacter (fun i : B => P i.val.1) h e ψ y) *
            physicalPhase (-(a+b+2*Real.pi*v)) (∏ i, (y i).val) ≠ 0) →
        ∀ (s : ℕ), 0 < s → (s : ℝ) ≤ L^(K+q) → ∀ u : ℤ,
        (∫ x in Set.Icc
          ((u : ℝ)/s-1/(|(k : ℝ)| *(HA*HB)/L^q))
          ((u : ℝ)/s+1/(|(k : ℝ)| *(HA*HB)/L^q)),
          ‖finiteFourierSum (harmonicCommonSupport Y)
            (harmonicCellSource Y Z a (2*Real.pi*v) F₀) x‖^2)
        ≤ Y*L^(-((2*D+E+2)+2*q+K+1))) →
      ‖∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
        (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ) *
          ((starRingEnd ℂ) (primeProductCellCharacter (fun i : A => P i.val.1) h d χ
              (repeatedBigAuxSplitEquiv P A B hU hAB aux).1) *
            (starRingEnd ℂ) (primeProductCellCharacter (fun i : B => P i.val.1) h e ψ
              (repeatedBigAuxSplitEquiv P A B hU hAB aux).2)) *
          physicalPhase (-(a+b+2*Real.pi*v)) (physicalFreeFactor (repeatedBigAuxCut A B) aux) *
          harmonicCellPairing Y Z a b (2*Real.pi*v)
            (k*(physicalFreeFactor (repeatedBigAuxCut A B) aux : ℤ)) F₀ G₀‖
        ≤ Y*L^(-D) := by
  obtain ⟨q, hq, hminor⟩ := exists_candidate_actual_cell_mellin_minor hc J (D+E+1)
  obtain ⟨_, _, hatom⟩ := exists_candidate_subset_atom_inputs hc J
  refine ⟨q, hq, ?_⟩
  filter_upwards [hminor, hatom,
    eventually_candidate_subset_product_range hc (ε := 1) (by norm_num) J,
    eventually_candidate_occupied_cell_scale hc (ε := 1) (by norm_num) J q,
    eventually_ge_atTop (5 : ℝ)] with L hm hmass hrange hcell hL
  intro S hS P V ell probes r t A B hA hAne hB hBne hU hAB k hk hkB Q h hh hh1
    d e χ ψ a b v Y Z F₀ G₀ hY HA HB hf hg hlocal
  let ζ := -(a+b+2*Real.pi*v)
  let f := fun x => (starRingEnd ℂ) (primeProductCellCharacter (fun i : A => P i.val.1) h d χ x)
  let g := fun y => (starRingEnd ℂ) (primeProductCellCharacter (fun i : B => P i.val.1) h e ψ y)
  let bA := fun x => f x * physicalPhase ζ (∏ i, (x i).val)
  let bB := fun y => g y * physicalPhase ζ (∏ i, (y i).val)
  have hposA (x : ∀ i : A, P i.val.1) : 0 < ∏ i, (x i).val := by
    have hp := (Real.exp_pos _).trans_le (hrange S hS ell probes r A hA hAne x).1
    exact_mod_cast hp
  have hposB (y : ∀ i : B, P i.val.1) : 0 < ∏ i, (y i).val := by
    have hp := (Real.exp_pos _).trans_le (hrange S hS ell probes t B hB hBne y).1
    exact_mod_cast hp
  have htest (aux : PhysicalAuxLabels P (repeatedBigAuxCut A B)) :
      bA (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
        bB (repeatedBigAuxSplitEquiv P A B hU hAB aux).2 =
      (f (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
        g (repeatedBigAuxSplitEquiv P A B hU hAB aux).2) *
        physicalPhase ζ (physicalFreeFactor (repeatedBigAuxCut A B) aux) :=
    physical_aux_mellin_test_split P A B hU hAB f g hposA hposB ζ aux
  change ‖∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
    (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ) *
      (f (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
        g (repeatedBigAuxSplitEquiv P A B hU hAB aux).2) *
      physicalPhase ζ (physicalFreeFactor (repeatedBigAuxCut A B) aux) *
      harmonicCellPairing Y Z a b (2*Real.pi*v)
        (k*(physicalFreeFactor (repeatedBigAuxCut A B) aux : ℤ)) F₀ G₀‖ ≤ Y*L^(-D)
  have heq :
      (∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
        (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ) *
          bA (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
          bB (repeatedBigAuxSplitEquiv P A B hU hAB aux).2 *
          harmonicCellPairing Y Z a b (2*Real.pi*v)
            (k*(physicalFreeFactor (repeatedBigAuxCut A B) aux : ℤ)) F₀ G₀) =
      (∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
        (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ) *
          (f (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
            g (repeatedBigAuxSplitEquiv P A B hU hAB aux).2) *
          physicalPhase ζ (physicalFreeFactor (repeatedBigAuxCut A B) aux) *
          harmonicCellPairing Y Z a b (2*Real.pi*v)
            (k*(physicalFreeFactor (repeatedBigAuxCut A B) aux : ℤ)) F₀ G₀) := by
    apply sum_congr rfl
    intro aux _
    rw [mul_assoc (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ), htest]
    ring
  rw [← heq]
  have hnonneg : 0 ≤ Y*L^(-D) := mul_nonneg hY.le (Real.rpow_nonneg (by linarith) _)
  by_cases hx : ∃ x, bA x ≠ 0
  · by_cases hy : ∃ y, bB y ≠ 0
    · have hHA : L^q ≤ HA := (hcell S hS ell probes r A hA hAne Q h hh hh1 d χ ζ hx).1
      have hHB : L^q ≤ HB := (hcell S hS ell probes t B hB hBne Q h hh hh1 e ψ ζ hy).1
      have hq1 : 1 ≤ L^q := Real.one_le_rpow (by linarith) hq
      have hscale : L^q ≤ HA*HB := by
        calc L^q ≤ HA := hHA
             _ = HA*1 := by ring
             _ ≤ HA*HB := mul_le_mul_of_nonneg_left (hq1.trans hHB) (Real.exp_pos _).le
      have hminor' : ∀ θ, θ ∉ productMajorArcSet k L q HA HB →
          ‖physicalAuxFourierMultiplier P V A B hU hAB k bA bB θ‖ ≤ L^(-(D+E+1)) := by
        intro θ hθ
        rw [physical_aux_mellin_multiplier_split P V A B hU hAB k f g hposA hposB ζ θ]
        exact hm S hS ell probes r t A B hA hAne hB hBne hU hAB k Q h hh d e χ ψ a b v θ hθ
      simpa only [physicalFreeFactor] using
        harmonic_cell_aux_local_energy_decay P V A B hU hAB k bA bB
          (hmass S hS).1 (fun _ => rfl)
          (prime_cell_phased_conjugate_norm _ h d χ ζ)
          (prime_cell_phased_conjugate_norm _ h e ψ ζ)
          Z a b (2*Real.pi*v) F₀ G₀ hk hL hq hK hkB
          (Real.exp_pos _) (Real.exp_pos _) hY hscale hf hg hminor' (hlocal hx hy)
    · push Not at hy
      simpa only [hy, mul_zero, zero_mul, sum_const_zero, norm_zero] using hnonneg
  · push Not at hx
    simpa only [hx, mul_zero, zero_mul, sum_const_zero, norm_zero] using hnonneg

end Bounty
end

