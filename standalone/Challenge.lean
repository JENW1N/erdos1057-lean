          (ActualEisensteinCoordinates.eval (ZMod.cast p.1) (ZMod.cast p.2)) := by
    calc
      (∑ r : O ⧸ Ideal.span {(2 : O)}, P r) =
          ∑ p : ZMod 2 × ZMod 2, P (e p) := (e.sum_comp P).symm
      _ = _ := by
        apply Finset.sum_congr rfl
