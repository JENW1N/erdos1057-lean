  obtain ⟨Cp,hCp,hpowers⟩ := globalDiagonalPowers ε hε
  refine ⟨Cd*(Real.exp 1)^3*Cp,by positivity,?_⟩
  intro ι _ p hp _ hinj s w Γ K ell B F U side hΓ hK hell hB hF hU hw hs hC ht hb1 hb2
