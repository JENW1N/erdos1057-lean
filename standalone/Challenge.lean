theorem unit_add_char_dirichlet_apply {r : ℕ}
    (ψ : AddChar (Additive (ZMod r)ˣ) ℂ) (v : (ZMod r)ˣ) :
    unitAddCharDirichlet ψ (v : ZMod r) = ψ (Additive.ofMul v) := by
  exact dirichletOfUnitCharacter_apply _ v

theorem finite_unit_character_expansion {r Q : ℕ} (hr : 0 < r) (hrQ : r ≤ Q)
    (F : ZMod r → ℂ) (hF : ∀ v : (ZMod r)ˣ, ‖F v‖ ≤ 1) :
    ∃ c : AddChar (Additive (ZMod r)ˣ) ℂ → ℂ,
      (∑ ψ, ‖c ψ‖) ≤ Real.sqrt (Q : ℝ) ∧
      ∀ n : ℕ, n.Coprime r →
        (∑ ψ, c ψ * unitAddCharDirichlet ψ (n : ZMod r)) = F (n : ZMod r) := by
  let : NeZero r := ⟨Nat.ne_of_gt hr⟩
  let f : Additive (ZMod r)ˣ → ℂ := fun v => F (v.toMul : ZMod r)
  refine ⟨finiteCharacterCoefficient f, ?_, ?_⟩
  · apply (finite_character_coefficient_l1 f (fun v => hF v.toMul)).trans
    apply Real.sqrt_le_sqrt
    have hc : Fintype.card (Additive (ZMod r)ˣ) = r.totient := by
      rw [Fintype.card_additive, ZMod.card_units_eq_totient]
    rw [hc]
    exact_mod_cast (Nat.totient_le r).trans hrQ
  · intro n hn
    have he := finite_character_expansion f (Additive.ofMul (ZMod.unitOfCoprime n hn))
    simpa only [← unit_add_char_dirichlet_apply, ZMod.coe_unitOfCoprime, f,
      toMul_ofMul] using he
