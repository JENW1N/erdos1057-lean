section

/- Dyadic conductor ranges above an exponential cutoff. -/

open Finset Filter

namespace Bounty

theorem dyadicConductorRange_scale_bounds (c L : ℝ) (N h k : ℕ)
    (hk : k ∈ dyadicNatIndices
      (Icc (max 2 (⌊Real.exp (c * L / 512)⌋₊ + 1)) (N / h))) :
    Real.exp (c * L / 512) < (2 : ℝ) ^ (k + 1) ∧
      (2 : ℝ) ^ (k + 1) ≤ 2 * (N : ℝ) ∧
      1 ≤ (2 : ℝ) ^ (k + 1) := by
  obtain ⟨f, hf⟩ := (dyadicNatBucket_nonempty_iff _ k).mpr hk
  have hfmem := (mem_dyadicNatBucket _ k f).mp hf
  have hfI := mem_Icc.mp hfmem.1
  have hf2 : 2 ≤ f := (le_max_left _ _).trans hfI.1
  have hfloor : ⌊Real.exp (c * L / 512)⌋₊ < f := by
    have := (le_max_right _ _).trans hfI.1
    omega
  have hexpf : Real.exp (c * L / 512) < (f : ℝ) :=
    (Nat.floor_lt (Real.exp_pos _).le).mp hfloor
  have hsc := dyadicNatBucket_upper_scale_real _
    (fun n hn => by have := (le_max_left _ _).trans (mem_Icc.mp hn).1; omega) hf
  have hfN : f ≤ N := hfI.2.trans (Nat.div_le_self _ _)
  have hfNreal : (f : ℝ) ≤ N := by exact_mod_cast hfN
  have hf2real : (2 : ℝ) ≤ f := by exact_mod_cast hf2
  exact ⟨hexpf.trans_le hsc.1, hsc.2.trans (by linarith), by linarith [hsc.1]⟩

theorem eventually_two_mul_exp_le_exp {a b : ℝ} (hab : a < b) :
    ∀ᶠ L : ℝ in atTop, 2 * Real.exp (a * L) ≤ Real.exp (b * L) := by
  filter_upwards [eventually_ge_atTop (Real.log 2 / (b - a))] with L hL
  have hlog : Real.log 2 ≤ L * (b - a) :=
    (div_le_iff₀ (sub_pos.mpr hab)).mp hL
  calc
    2 * Real.exp (a * L) = Real.exp (Real.log 2 + a * L) := by
      rw [Real.exp_add, Real.exp_log (by norm_num : (0 : ℝ) < 2)]
    _ ≤ Real.exp (b * L) := Real.exp_le_exp.mpr (by nlinarith)

theorem eventually_dyadicConductorRange_scale_bounds (c : ℝ) {θ : ℝ}
    (hθ : θ < 1 / 2) :
    ∀ᶠ L : ℝ in atTop, ∀ (N h k : ℕ), (N : ℝ) ≤ Real.exp (θ * L) →
      k ∈ dyadicNatIndices
        (Icc (max 2 (⌊Real.exp (c * L / 512)⌋₊ + 1)) (N / h)) →
      Real.exp (c * L / 512) ≤ (2 : ℝ) ^ (k + 1) ∧
        (2 : ℝ) ^ (k + 1) ≤ Real.exp (((θ + 1 / 2) / 2) * L) ∧
        1 ≤ (2 : ℝ) ^ (k + 1) := by
  have hmid : θ < (θ + 1 / 2) / 2 := by linarith
  filter_upwards [eventually_two_mul_exp_le_exp hmid] with L hL
  intro N h k hN hk
  obtain ⟨hlow, hupp, hone⟩ := dyadicConductorRange_scale_bounds c L N h k hk
  exact ⟨hlow.le, hupp.trans ((mul_le_mul_of_nonneg_left hN (by norm_num)).trans hL),
    hone⟩

theorem eventually_dyadicConductorRange_card_le_linear (c : ℝ) {θ : ℝ}
    (hθ : θ < 1 / 2) :
    ∀ᶠ L : ℝ in atTop, ∀ (N h : ℕ), (N : ℝ) ≤ Real.exp (θ * L) →
      ((dyadicNatIndices
        (Icc (max 2 (⌊Real.exp (c * L / 512)⌋₊ + 1)) (N / h))).card : ℝ) ≤
        (2 / Real.log 2 + 1) * L := by
  filter_upwards [eventually_dyadicNatIndices_card_le_linear,
    eventually_ge_atTop (0 : ℝ)] with L hcount hL
  intro N h hN
  apply hcount N
  · calc
      (N : ℝ) ≤ Real.exp (θ * L) := hN
      _ ≤ Real.exp L := Real.exp_le_exp.mpr (by nlinarith)
      _ ≤ 16 * Real.exp L := by nlinarith [Real.exp_pos L]
  · intro n hn
    exact (mem_Icc.mp hn).2.trans (Nat.div_le_self _ _)

theorem three_dyadic_counts_totient_factor_le_pow_five {L x y z : ℝ}
    (hL : 1 ≤ L) (hlog : Real.log 2 ≤ L)
    (hlarge : 4 * primeEulerProductUpperConstant * (2 / Real.log 2 + 1) ^ 3 ≤ L)
    (hx0 : 0 ≤ x) (hy0 : 0 ≤ y) (hz0 : 0 ≤ z)
    (hx : x ≤ (2 / Real.log 2 + 1) * L)
    (hy : y ≤ (2 / Real.log 2 + 1) * L)
    (hz : z ≤ (2 / Real.log 2 + 1) * L) :
    (2 * primeEulerProductUpperConstant * Real.log (2 * Real.exp L)) * x * y * z ≤
      L ^ 5 := by
  have hL0 : 0 ≤ L := by linarith
  have hC := primeEulerProductUpperConstant_pos
  have htwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hxyz : x * y * z ≤
      ((2 / Real.log 2 + 1) * L) * ((2 / Real.log 2 + 1) * L) *
        ((2 / Real.log 2 + 1) * L) := by
    gcongr
  have hfactor : 2 * primeEulerProductUpperConstant * Real.log (2 * Real.exp L) ≤
      4 * primeEulerProductUpperConstant * L := by
    rw [Real.log_mul (by norm_num) (Real.exp_pos L).ne', Real.log_exp]
    nlinarith
  calc
    _ = (2 * primeEulerProductUpperConstant * Real.log (2 * Real.exp L)) *
        (x * y * z) := by ring
    _ ≤ (4 * primeEulerProductUpperConstant * L) *
        (((2 / Real.log 2 + 1) * L) * ((2 / Real.log 2 + 1) * L) *
          ((2 / Real.log 2 + 1) * L)) :=
      mul_le_mul hfactor hxyz (mul_nonneg (mul_nonneg hx0 hy0) hz0) (by positivity)
    _ = (4 * primeEulerProductUpperConstant * (2 / Real.log 2 + 1) ^ 3) *
        L ^ 4 := by ring
    _ ≤ L * L ^ 4 := mul_le_mul_of_nonneg_right hlarge (pow_nonneg hL0 _)
    _ = L ^ 5 := by ring

theorem eventually_three_dyadic_counts_totient_factor_le_pow_five :
    ∀ᶠ L : ℝ in atTop, 0 < L ∧ ∀ x y z : ℝ,
      0 ≤ x → 0 ≤ y → 0 ≤ z →
      x ≤ (2 / Real.log 2 + 1) * L →
      y ≤ (2 / Real.log 2 + 1) * L →
      z ≤ (2 / Real.log 2 + 1) * L →
      (2 * primeEulerProductUpperConstant * Real.log (2 * Real.exp L)) * x * y * z ≤
        L ^ 5 := by
  filter_upwards [eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (Real.log 2),
    eventually_ge_atTop (4 * primeEulerProductUpperConstant *
      (2 / Real.log 2 + 1) ^ 3)] with L hL hlog hlarge
  exact ⟨by linarith, fun _ _ _ hx0 hy0 hz0 hx hy hz =>
    three_dyadic_counts_totient_factor_le_pow_five hL hlog hlarge hx0 hy0 hz0 hx hy hz⟩


end Bounty
end

section

/- A power saving for the triangular Mangoldt sum from the zero-free input. -/

namespace Bounty

open OAI.Ostmann Complex Set

/- The finite contour argument gives a uniform smoothed estimate, with only
logarithmic dependence on the conductor. It assumes only the zero-free input. -/
theorem character_riesz_bound_right_of (b σ : ℝ) (hb : 7 / 8 ≤ b)
    (hbσ : b < σ) (hσ1 : σ < 1) (hZ : PrimitiveZeroFreeRightOf b) :
    ∃ D : ℝ, 0 < D ∧ ∀ (χ : PrimitiveComplexCharacter) (x : ℝ), 2 ≤ x →
      ‖characterRieszMean χ x‖ ≤ D * x ^ σ *
        (1 + Real.log (24 * (χ.modulus : ℝ) * (x ^ 2 + 2))) := by
  obtain ⟨K, C, hK, hC, hrect⟩ := characterRieszMean_rectangle_bound
  refine ⟨(K + 5 + 2 * C) * (36 / (σ - b) ^ 2), by positivity, ?_⟩
  intro χ x hx
  let L : ℝ := 1 + Real.log (24 * (χ.modulus : ℝ) * (x ^ 2 + 2))
  let M : ℝ := (36 / (σ - b) ^ 2) * L
  have hx0 : 0 < x := by linarith
  have hq : (1 : ℝ) ≤ χ.modulus := by exact_mod_cast χ.positive
  have hq0 : (0 : ℝ) < χ.modulus := by linarith
  have hx2 : 1 ≤ x ^ 2 := by nlinarith
  have hL : 1 ≤ L := by
    have hh : 1 ≤ 24 * (χ.modulus : ℝ) * (x ^ 2 + 2) := by nlinarith
    have hl := Real.log_nonneg hh
    dsimp [L]
    linarith
  have hmargin : 0 < σ - b := sub_pos.mpr hbσ
  have hmargin1 : σ - b ≤ 1 := by linarith
  have hfactor : 1 ≤ 36 / (σ - b) ^ 2 := by
    apply (le_div_iff₀ (sq_pos_of_pos hmargin)).mpr
    nlinarith
  have hM : 1 ≤ M := by dsimp [M]; nlinarith
  have hzre (z : ℂ) (hz : z ∈ uIcc σ 2 ×ℂ uIcc (-x ^ 2) (x ^ 2)) :
      σ ≤ z.re ∧ z.re ≤ 2 ∧ |z.im| ≤ x ^ 2 := by
    have hz' : z.re ∈ Icc σ 2 ∧ z.im ∈ Icc (-x ^ 2) (x ^ 2) := by
      simpa only [mem_reProdIm, uIcc_of_le (by linarith : σ ≤ 2),
        uIcc_of_le (by nlinarith : -x ^ 2 ≤ x ^ 2)] using hz
    exact ⟨hz'.1.1, hz'.1.2, abs_le.mpr hz'.2⟩
  have hne : ∀ z ∈ uIcc σ 2 ×ℂ uIcc (-x ^ 2) (x ^ 2), χ.L z ≠ 0 := by
    intro z hz
    apply hZ χ z
    linarith [(hzre z hz).1]
  have hbound : ∀ z ∈ uIcc σ 2 ×ℂ uIcc (-x ^ 2) (x ^ 2),
      ‖logDeriv χ.L z‖ ≤ M := by
    intro z hz
    obtain ⟨hzlo, hzhi, hzim⟩ := hzre z hz
    have hh := character_logDeriv_bound_right_of b hb (by linarith) hZ χ
      (ε := σ - b) hmargin hmargin1 z (by linarith) hzhi
    have hl : Real.log (24 * (χ.modulus : ℝ) * (|z.im| + 2)) ≤ L := by
      have hhlog : Real.log (24 * (χ.modulus : ℝ) * (|z.im| + 2)) ≤
          Real.log (24 * (χ.modulus : ℝ) * (x ^ 2 + 2)) := by
        apply Real.log_le_log (by positivity)
        gcongr
      dsimp [L]
      linarith
    dsimp [M]
    exact hh.trans (mul_le_mul_of_nonneg_left hl (by positivity))
  have hraw := hrect χ x σ 2 (x ^ 2) M (by linarith) (by linarith)
    (by linarith) (by norm_num) le_rfl (by positivity) (by linarith) hne hbound
  rw [Real.rpow_two] at hraw
  have hx24 : x ^ 2 ≤ (x ^ 2) ^ 2 := by nlinarith [sq_nonneg (x ^ 2 - 1)]
  have hquot : M * x ^ 2 / (x ^ 2) ^ 2 ≤ M := by
    apply (div_le_iff₀ (by positivity : 0 < (x ^ 2) ^ 2)).mpr
    exact mul_le_mul_of_nonneg_left hx24 (by linarith)
  have hquot0 : 0 ≤ M * x ^ 2 / (x ^ 2) ^ 2 := by positivity
  have herr : 2 * (M * x ^ 2 / (x ^ 2) ^ 2) * (2 - σ) ≤ 3 * M := by
    nlinarith
  have htail : 2 * (1 / (2 - 1) + C) * x ^ 2 / x ^ 2 = 2 * (1 + C) := by
    field_simp
    ring
  rw [htail] at hraw
  have hp : 1 ≤ x ^ σ := Real.one_le_rpow (by linarith) (by linarith)
  have hscale : M ≤ M * x ^ σ := by nlinarith
  have hone : 1 ≤ M * x ^ σ := by nlinarith
  calc
    _ ≤ K * M * x ^ σ + 3 * M + 2 * (1 + C) := by linarith
    _ ≤ K * M * x ^ σ + 3 * (M * x ^ σ) +
        2 * (1 + C) * (M * x ^ σ) := by
      apply add_le_add
      · exact add_le_add le_rfl (mul_le_mul_of_nonneg_left hscale (show (0 : ℝ) ≤ 3 by norm_num))
      · simpa only [mul_one] using
          mul_le_mul_of_nonneg_left hone (show 0 ≤ 2 * (1 + C) by positivity)
    _ = _ := by dsimp [M, L]; ring


end Bounty
end

