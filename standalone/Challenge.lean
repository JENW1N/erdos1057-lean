section

/- Exact normalized product marginals and finite forbidden-label union bounds. -/

open Finset
open scoped Classical

namespace Bounty

theorem finite_forbidden_hits_mass_le {A P : Type*}
    [Fintype A] [DecidableEq A] [Fintype P]
    (μ : P → ℝ) (hμ0 : ∀ p, 0 ≤ μ p) (hμ : ∑ p, μ p = 1)
    (F : Finset P) (a0 : ℝ) (hatom : ∀ p, μ p ≤ a0) :
    (∑ f : A → P, cleanAuxiliaryWeight μ f * (if ∃ a, f a ∈ F then 1 else 0)) ≤
      (Fintype.card A : ℝ) * F.card * a0 := by
  classical
  have he (f : A → P) : (∃ a, f a ∈ F) ↔ ∃ a, ∃ p : F, f a = p.val := by
    constructor
    · rintro ⟨a, ha⟩
      exact ⟨a, ⟨f a, ha⟩, rfl⟩
    · rintro ⟨a, p, hp⟩
      exact ⟨a, hp ▸ p.property⟩
  simp_rw [he]
  simpa only [Fintype.card_coe] using
    clean_auxiliary_hits_mass_le (A := A) μ hμ0 hμ (fun p : F => p.val) a0 hatom

theorem finite_normalized_product_marginal {G : Type*} [Fintype G] [DecidableEq G]
    {X : G → Type*} [∀ g, Fintype (X g)]
    (w : ∀ g, X g → ℝ) (hw : ∀ g, ∑ x, w g x = 1) (g : G) (F : X g → ℝ) :
    (∑ x : ∀ g, X g, (∏ i, w i (x i)) * F (x g)) = ∑ x : X g, w g x * F x := by
  let factors (i : G) (x : X i) : ℝ := w i x * (if h : i = g then F (h ▸ x) else 1)
  have hprod (x : ∀ g, X g) : (∏ i, w i (x i)) * F (x g) = ∏ i, factors i (x i) := by
    simp only [factors, prod_mul_distrib]
    congr 1
    rw [prod_eq_single g]
    · simp
    · intro i _ hig
      simp only [dif_neg hig]
    · simp
  simp_rw [hprod]
  rw [← Fintype.prod_sum factors, prod_eq_single g]
  · simp only [factors, ↓reduceDIte]
  · intro i _ hig
    simpa only [factors, dif_neg hig, mul_one] using hw i
  · simp

theorem finite_product_forbidden_hits_mass_le {G : Type*} [Fintype G] [DecidableEq G]
    {A P : G → Type*} [∀ g, Fintype (A g)] [∀ g, DecidableEq (A g)]
    [∀ g, Fintype (P g)]
    (μ : ∀ g, P g → ℝ) (hμ0 : ∀ g p, 0 ≤ μ g p) (hμ : ∀ g, ∑ p, μ g p = 1)
    (F : ∀ g, Finset (P g)) (a0 : G → ℝ) (hatom : ∀ g p, μ g p ≤ a0 g) :
    (∑ f : ∀ g, A g → P g, (∏ g, ∏ a, μ g (f g a)) *
      (if ∃ g a, f g a ∈ F g then 1 else 0)) ≤
      ∑ g, (Fintype.card (A g) : ℝ) * (F g).card * a0 g := by
  classical
  have hgroup (g : G) : (∑ f : A g → P g, ∏ a, μ g (f a)) = 1 := by
    rw [← Fintype.prod_sum]
    simp only [hμ, prod_const_one]
  calc
    _ ≤ ∑ g, ∑ f : ∀ g, A g → P g, (∏ g, ∏ a, μ g (f g a)) *
        (if ∃ a, f g a ∈ F g then 1 else 0) :=
by
      rw [sum_comm]
      apply sum_le_sum
      intro f _
      have hn : 0 ≤ ∏ g, ∏ a, μ g (f g a) :=
        prod_nonneg (fun g _ => prod_nonneg (fun a _ => hμ0 g (f g a)))
      have hnn : ∀ i ∈ (univ : Finset G),
          0 ≤ (∏ g, ∏ a, μ g (f g a)) * (if ∃ a, f i a ∈ F i then 1 else 0) := by
        intro i _
        exact mul_nonneg hn (by split_ifs <;> norm_num)
      by_cases he : ∃ g a, f g a ∈ F g
      · obtain ⟨g, a, ha⟩ := he
        rw [if_pos ⟨g, a, ha⟩, mul_one]
        have hs := single_le_sum hnn (mem_univ g)
        rw [if_pos ⟨a, ha⟩, mul_one] at hs
        exact hs
      · rw [if_neg he, mul_zero]
        exact sum_nonneg hnn
    _ = ∑ g, ∑ f : A g → P g, (∏ a, μ g (f a)) *
        (if ∃ a, f a ∈ F g then 1 else 0) := by
      apply sum_congr rfl
      intro g _
      have hm := finite_normalized_product_marginal (X := fun g => A g → P g) (fun g f => ∏ a, μ g (f a)) hgroup g
        (fun f => if ∃ a, f a ∈ F g then 1 else 0)
      convert hm using 1
    _ ≤ _ := by
      apply sum_le_sum
      intro g _
      have hh := finite_forbidden_hits_mass_le (A := A g)
        (μ g) (hμ0 g) (hμ g) (F g) (a0 g) (hatom g)
      convert hh using 1 <;> rfl

end Bounty
end

section

/- One-sided rare target events give a square-root Schur gain. All rows
keep their shared fiber. The banned-kernel estimates preserve the original
auxiliary endpoint collision bans; no auxiliary initial-ledger mask is added. -/

open Finset
open scoped Classical

namespace Bounty










theorem repeated_big_compatible_mass_balance {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (x y : RepeatedBigLists P J ell) :
    repeatedBigActiveMass V (fun _ _ => 1) x *
      (if repeatedBigSharedCompatible C x y then repeatedBigTargetMass V (fun _ _ => 1) C y else 0) =
    repeatedBigActiveMass V (fun _ _ => 1) y *
      (if repeatedBigSharedCompatible C y x then repeatedBigTargetMass V (fun _ _ => 1) C x else 0) := by
  by_cases h : repeatedBigSharedCompatible C x y
  · rw [if_pos h, if_pos (repeated_big_shared_compatible_symm C h)]
    exact repeated_big_active_target_mass_balance V (fun _ _ => 1) C h
  · have hr : ¬repeatedBigSharedCompatible C y x := fun hh => h (repeated_big_shared_compatible_symm C hh)
    simp only [if_neg h, if_neg hr, mul_zero]

theorem repeated_big_rare_transition_norm {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (E : RepeatedBigLists P J ell → RepeatedBigLists P J ell → ℂ)
    (B : ℝ) (hB : 0 ≤ B)
    (hE : ∀ x y, ‖E x y‖ ≤ B * (if repeatedBigSharedCompatible C x y then
      repeatedBigTargetMass V (fun _ _ => 1) C y else 0))
    (Q : RepeatedBigLists P J ell → Prop) (δ : ℝ) (hδ : 0 ≤ δ)
    (hQ : ∀ x, (∑ y, (if repeatedBigSharedCompatible C x y then
      repeatedBigTargetMass V (fun _ _ => 1) C y else 0) * (if Q y then 1 else 0)) ≤ δ)
    (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (fun x => ∑ y, (if Q y then E x y else 0) * f y) ≤
      (B * Real.sqrt δ) * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  let m := fun x y : RepeatedBigLists P J ell => if repeatedBigSharedCompatible C x y then
    repeatedBigTargetMass V (fun _ _ => 1) C y else 0
  let w : RepeatedBigLists P J ell → ℝ := repeatedBigActiveMass V (fun _ _ => 1)
  have hw (x) : 0 ≤ w x := repeated_big_untilted_active_mass_nonneg V (fun g => (hV g).le) x
  have hm (x y) : 0 ≤ m x y := by
    dsimp only [m]
    split_ifs
    · exact repeated_big_untilted_target_mass_nonneg V (fun g => (hV g).le) C y
    · exact le_rfl
  have hb (x y) : ‖if Q y then E x y else 0‖ ≤ B * m x y := by
    split_ifs
    · exact hE x y
    · simpa only [norm_zero] using mul_nonneg hB (hm x y)
  have hr (x) : ∑ y, ‖if Q y then E x y else 0‖ ≤ B * δ := by
    calc
      _ ≤ ∑ y, B * (m x y * (if Q y then 1 else 0)) := by
        apply sum_le_sum
        intro y _
        by_cases h : Q y
        · simpa only [if_pos h, mul_one] using hE x y
        · simp only [if_neg h, norm_zero, mul_zero, le_refl]
      _ = B * ∑ y, m x y * (if Q y then 1 else 0) := (mul_sum _ _ _).symm
      _ ≤ B * δ := mul_le_mul_of_nonneg_left (hQ x) hB
  have hc (y) : ∑ x, w x * ‖if Q y then E x y else 0‖ ≤ B * w y := by
    calc
      _ ≤ ∑ x, w x * (B * m x y) := sum_le_sum fun x _ => mul_le_mul_of_nonneg_left (hb x y) (hw x)
      _ = ∑ x, B * (w y * m y x) := by
        apply sum_congr rfl
        intro x _
        calc
          _ = B * (w x * m x y) := by ring
          _ = _ := congrArg (fun z : ℝ => B * z) (repeated_big_compatible_mass_balance V C x y)
      _ = B * w y := by
        simp only [← mul_assoc, ← mul_sum, m,
          repeated_big_untilted_compatible_target_mass_sum V C hV hMass y, mul_one]
  have h := finite_weighted_schur_transition_norm univ w (fun _ => 1)
    (fun x y => if Q y then E x y else 0) (fun x _ => hw x) (fun _ _ => zero_lt_one)
    (mul_nonneg hB hδ) hB
    (fun x _ => by simpa only [mul_one] using hr x)
    (fun y _ => by simpa only [mul_one] using hc y) f
  have hs : Real.sqrt (B * δ * B) = B * Real.sqrt δ := by
    rw [show B * δ * B = B ^ 2 * δ by ring, Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq hB]
  simpa only [hs, cleanActiveNorm, w] using h

theorem repeated_big_unbanned_transition_norm_le {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (_hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    (x y : RepeatedBigLists P J ell) :
    ‖∑ a, repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K a x y‖ ≤
      B * (if repeatedBigSharedCompatible C x y then
        repeatedBigTargetMass V (fun _ _ => 1) C y else 0) := by
  by_cases h : repeatedBigSharedCompatible C x y
  · rw [if_pos h]
    calc
      _ ≤ ∑ a, ‖repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K a x y‖ := norm_sum_le _ _
      _ ≤ ∑ a, physicalAuxMass V C a * B * repeatedBigTargetMass V (fun _ _ => 1) C y := by
        apply sum_le_sum
        intro a _
        have ha := physical_aux_mass_nonneg V C (fun g => (hV g).le) a
        have ht := repeated_big_untilted_target_mass_nonneg V (fun g => (hV g).le) C y
        simp only [repeatedBigUnbannedKernel, if_pos h, norm_mul, physical_phase_norm,
          mul_one, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg ha, abs_of_nonneg ht]
        calc
          _ ≤ (physicalAuxMass V C a * repeatedBigTargetMass V (fun _ _ => 1) C y) * B :=
            mul_le_mul_of_nonneg_left (hK x y a) (mul_nonneg ha ht)
          _ = _ := by ring
      _ = _ := by rw [← sum_mul, ← sum_mul, physical_aux_mass_sum V C hV hMass, one_mul]
  · simp only [repeatedBigUnbannedKernel, if_neg h, sum_const_zero, norm_zero, mul_zero, le_refl]

theorem repeated_big_unbanned_target_mask_norm {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    (Q : RepeatedBigLists P J ell → Prop) (δ : ℝ) (hδ : 0 ≤ δ)
    (hQ : ∀ x, (∑ y, (if repeatedBigSharedCompatible C x y then
      repeatedBigTargetMass V (fun _ _ => 1) C y else 0) * (if Q y then 1 else 0)) ≤ δ)
    (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigUnbannedRowAction V C ζ (fun x y a => if Q y then K x y a else 0) f) ≤
      (B * Real.sqrt δ) * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  have h := repeated_big_rare_transition_norm V C hV hMass
    (fun x y => ∑ a, repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K a x y)
    B hB (repeated_big_unbanned_transition_norm_le V C hV hMass ζ K B hB hK) Q δ hδ hQ f
  have he : repeatedBigUnbannedRowAction V C ζ (fun x y a => if Q y then K x y a else 0) f =
      (fun x => ∑ y, (if Q y then ∑ a, repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K a x y else 0) * f y) := by
    funext x
    apply sum_congr rfl
    intro y _
    by_cases hy : Q y <;> simp [repeatedBigUnbannedKernel, hy]
  rw [he]
  exact h

end Bounty
end

section

/- Positive group masses make the bare and memory path coefficients vanish together. -/

open Finset
namespace Bounty

theorem physical_memory_walk_scalar_zero_iff {G I : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (patterns : Finset I) (C : I → G → Finset (Fin J)) (ζ : ℕ → I → ℝ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (a : ℕ → PhysicalEdgeLabels P J ell patterns C)
    (L : ℕ → PhysicalMarkLists P J ell) (edges : ℕ) :
    physicalMemoryWalkScalar V patterns C ζ K a L edges = 0 ↔
      physicalBareWalkScalar V patterns C ζ K a L edges = 0 := by
  rw [physical_memory_walk_scalar_factor]
  have hn : (∏ j ∈ range edges, physicalCompletionMass V (C (a j).2.2.1.val) ell : ℝ) ≠ 0 :=
    ne_of_gt (prod_pos (fun j _ => physical_completion_mass_pos V _ ell hV))
  have hn' : ((∏ j ∈ range edges, physicalCompletionMass V (C (a j).2.2.1.val) ell : ℝ) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr hn
  exact (mul_eq_zero_iff_left hn').symm

end Bounty
end

section

/- Finite complex summation by parts with interval prefix sums. -/

open Finset

namespace Bounty

theorem complex_sum_Ioc_interval_by_parts (f g : ℕ → ℂ) {m n : ℕ} (hmn : m < n) :
    (∑ i ∈ Ioc m n, f i*g i) =
      f n*(∑ j ∈ Ioc m n, g j)-
      ∑ i ∈ Ioc m (n-1), (f (i+1)-f i)*(∑ j ∈ Ioc m i, g j) := by
  let h := fun j => if m < j then g j else 0
  have hpref (k : ℕ) : (∑ j ∈ range (k+1), h j) = ∑ j ∈ Ioc m k, g j := by
    dsimp only [h]
    rw [← sum_filter]
    apply sum_congr
    · ext j
      simp only [mem_filter, mem_range, Nat.lt_succ_iff, mem_Ioc, and_comm]
    · intro j _
      rfl
  have hh := sum_Ioc_by_parts f h hmn
  simp only [smul_eq_mul, hpref, Ioc_self, sum_empty, mul_zero, sub_zero] at hh
  convert hh using 1
  apply sum_congr rfl
  intro i hi
  simp only [h, if_pos (mem_Ioc.mp hi).1]

theorem norm_complex_sum_Ioc_le_of_interval_prefix (f g : ℕ → ℂ) {m n : ℕ}
    (hmn : m < n) {B : ℝ}
    (hprefix : ∀ i ∈ Icc m n, ‖∑ j ∈ Ioc m i, g j‖ ≤ B) :
    ‖∑ i ∈ Ioc m n, f i*g i‖ ≤
      (‖f n‖+∑ i ∈ Ioc m (n-1), ‖f (i+1)-f i‖)*B := by
  rw [complex_sum_Ioc_interval_by_parts f g hmn]
  calc
    _ ≤ ‖f n*(∑ j ∈ Ioc m n, g j)‖+
        ‖∑ i ∈ Ioc m (n-1), (f (i+1)-f i)*(∑ j ∈ Ioc m i, g j)‖ := norm_sub_le _ _
    _ ≤ ‖f n‖*B+∑ i ∈ Ioc m (n-1), ‖f (i+1)-f i‖*B := by
      apply add_le_add
      · rw [norm_mul]
        exact mul_le_mul_of_nonneg_left (hprefix n (mem_Icc.mpr ⟨hmn.le, le_rfl⟩)) (norm_nonneg _)
      · apply (norm_sum_le _ _).trans
        apply sum_le_sum
        intro i hi
        rw [norm_mul]
        exact mul_le_mul_of_nonneg_left
          (hprefix i (mem_Icc.mpr ⟨(mem_Ioc.mp hi).1.le, (mem_Ioc.mp hi).2.trans (Nat.sub_le _ _)⟩))
          (norm_nonneg _)
    _ = _ := by rw [← sum_mul, add_mul]

end Bounty
end

section

/- Elementary norm and variation estimates for the harmonic Mellin weight. -/

namespace Bounty

noncomputable def harmonicMellinWeight (v t : ℝ) : ℂ :=
  Complex.exp (Complex.I * ((v*Real.log t : ℝ) : ℂ)) / (t : ℂ)




theorem norm_exp_imaginary_difference (x y : ℝ) :
    ‖Complex.exp (Complex.I*(x : ℂ))-Complex.exp (Complex.I*(y : ℂ))‖ ≤ |x-y| := by
  have heq : Complex.exp (Complex.I*(x : ℂ))-Complex.exp (Complex.I*(y : ℂ)) =
      Complex.exp (Complex.I*(y : ℂ))*(Complex.exp (Complex.I*((x-y : ℝ) : ℂ))-1) := by
    rw [mul_sub, mul_one, ← Complex.exp_add]
    congr 2
    push_cast
    ring
  rw [heq, norm_mul, Complex.norm_exp_I_mul_ofReal, one_mul]
  exact Real.norm_exp_I_mul_ofReal_sub_one_le

theorem norm_harmonic_mellin_weight (v : ℝ) {t : ℝ} (ht : 0 < t) :
    ‖harmonicMellinWeight v t‖ = 1/t := by
  simp only [harmonicMellinWeight, norm_div, Complex.norm_exp_I_mul_ofReal,
    Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht]

theorem harmonic_mellin_weight_variation {v s t : ℝ} (hs : 0 < s) (hst : s ≤ t) :
    ‖harmonicMellinWeight v t-harmonicMellinWeight v s‖ ≤
      (1+|v|)*(t-s)/(s*t) := by
  have ht : 0 < t := hs.trans_le hst
  have hlog0 : 0 ≤ Real.log t-Real.log s := sub_nonneg.mpr (Real.log_le_log hs hst)
  have hlog : Real.log t-Real.log s ≤ (t-s)/s := by
    have h := Real.log_le_sub_one_of_pos (div_pos ht hs)
    rw [Real.log_div ht.ne' hs.ne'] at h
    convert h using 1
    field_simp
  let et := Complex.exp (Complex.I*((v*Real.log t : ℝ) : ℂ))
  let es := Complex.exp (Complex.I*((v*Real.log s : ℝ) : ℂ))
  have hphase : ‖et-es‖ ≤ |v| *(Real.log t-Real.log s) := by
    have h := norm_exp_imaginary_difference (v*Real.log t) (v*Real.log s)
    rw [← mul_sub, abs_mul, abs_of_nonneg hlog0] at h
    exact h
  have heq : harmonicMellinWeight v t-harmonicMellinWeight v s =
      (et-es)/(t : ℂ)+es*((1/t-1/s : ℝ) : ℂ) := by
    dsimp [harmonicMellinWeight, et, es]
    push_cast
    ring
  have hinv : |1/t-1/s| = (t-s)/(s*t) := by
    rw [abs_of_nonpos (sub_nonpos.mpr (one_div_le_one_div_of_le hs hst))]
    field_simp
    ring
  calc
    _ ≤ ‖(et-es)/(t : ℂ)‖+‖es*((1/t-1/s : ℝ) : ℂ)‖ := by
      rw [heq]
      exact norm_add_le _ _
    _ = ‖et-es‖/t+(t-s)/(s*t) := by
      rw [norm_div, norm_mul]
      simp only [es, Complex.norm_exp_I_mul_ofReal, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos ht, one_mul, hinv]
    _ ≤ (|v| *((t-s)/s))/t+(t-s)/(s*t) := by
      exact add_le_add (div_le_div_of_nonneg_right
        (hphase.trans (mul_le_mul_of_nonneg_left hlog (abs_nonneg v))) ht.le) le_rfl
    _ = _ := by ring

theorem harmonic_mellin_weight_variation_lower_scale {v s t Y : ℝ}
    (hY : 0 < Y) (hYs : Y ≤ s) (hst : s ≤ t) :
    ‖harmonicMellinWeight v t-harmonicMellinWeight v s‖ ≤
      (1+|v|)*(t-s)/Y^2 := by
  have hs : 0 < s := hY.trans_le hYs
  apply (harmonic_mellin_weight_variation hs hst).trans
  apply div_le_div_of_nonneg_left (by positivity) (by positivity)
  calc
    Y^2 = Y*Y := pow_two Y
    _ ≤ s*t := mul_le_mul hYs (hYs.trans hst) hY.le hs.le

end Bounty
end

