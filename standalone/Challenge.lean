section

/- Minor cancellation for the literal auxiliary cell/character summand with
the exact Mellin frequency -(a+b+2*pi*v) from harmonic cutoff separation. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem exists_candidate_actual_cell_mellin_minor {c : ℝ}
    (hc : 0 < c) (J : ℕ) (Rsave : ℝ) :
    ∃ q : ℝ, 0 ≤ q ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
      let P := fun g : S => candidatePBand (c*L) g.val
      let V := fun g : S => ∑ p ∈ P g, 1/(p : ℝ)
      ∀ (ell : ℕ) (probes : S → Finset (Fin J)) (r t : Finset S)
        (A B : Finset (RepeatedBigFlatIndex S J ell)),
        A ⊆ r.sigma (repeatedBigPrimeProbeSlots probes) → A.Nonempty →
        B ⊆ t.sigma (repeatedBigPrimeProbeSlots probes) → B.Nonempty →
      ∀ (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex S J ell) ∉ A ∪ B)
        (hAB : Disjoint A B) (k : ℤ) (Q : ℕ) (h : ℝ), 0 < h →
      ∀ (d e : ℤ) (χ ψ : BoundedPrimitiveCharacter Q) (a b v θ : ℝ),
        θ ∉ productMajorArcSet k L q (Real.exp (((d : ℝ)-1)*h))
          (Real.exp (((e : ℝ)-1)*h)) →
        ‖∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
          (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ) *
            ((starRingEnd ℂ) (primeProductCellCharacter (fun i : A => P i.val.1) h d χ
                (repeatedBigAuxSplitEquiv P A B hU hAB aux).1) *
              (starRingEnd ℂ) (primeProductCellCharacter (fun i : B => P i.val.1) h e ψ
                (repeatedBigAuxSplitEquiv P A B hU hAB aux).2)) *
            physicalPhase (-(a+b+2*Real.pi*v)) (physicalFreeFactor (repeatedBigAuxCut A B) aux) *
            fourier (-(k * (physicalFreeFactor (repeatedBigAuxCut A B) aux : ℤ)))
              (θ : AddCircle (1 : ℝ))‖ ≤ L^(-Rsave) := by
  obtain ⟨q, hq, hminor⟩ := exists_candidate_cell_minor_bound hc J Rsave
  refine ⟨q, hq, ?_⟩
  filter_upwards [hminor,
    eventually_candidate_subset_product_range hc (ε := 1) (by norm_num) J]
    with L hm hrange
  intro S hS P V ell probes r t A B hA hAne hB hBne hU hAB k Q h hh d e χ ψ a b v θ hθ
  let ζ := -(a+b+2*Real.pi*v)
  have hposA (x : ∀ i : A, P i.val.1) : 0 < ∏ i, (x i).val := by
    have hb := (hrange S hS ell probes r A hA hAne x).1
    have hp := (Real.exp_pos _).trans_le hb
    exact_mod_cast hp
  have hposB (y : ∀ i : B, P i.val.1) : 0 < ∏ i, (y i).val := by
    have hb := (hrange S hS ell probes t B hB hBne y).1
    have hp := (Real.exp_pos _).trans_le hb
    exact_mod_cast hp
  rw [← physical_aux_mellin_multiplier_split P V A B hU hAB k
    (fun x => (starRingEnd ℂ) (primeProductCellCharacter (fun i : A => P i.val.1) h d χ x))
    (fun y => (starRingEnd ℂ) (primeProductCellCharacter (fun i : B => P i.val.1) h e ψ y))
    hposA hposB ζ θ]
  exact hm S hS ell probes r t A B hA hAne hB hBne hU hAB k _ _
    (prime_cell_phased_conjugate_norm _ h d χ ζ)
    (prime_cell_phased_conjugate_norm _ h e ψ ζ)
    (Real.exp (((d : ℝ)-1)*h)) (Real.exp (((e : ℝ)-1)*h))
    (Real.exp_pos _).le (Real.exp_pos _).le
    (fun x hx => (prime_cell_phased_conjugate_range _ hh d χ ζ x (hposA x) hx).1.le)
    (fun y hy => (prime_cell_phased_conjugate_range _ hh e ψ ζ y (hposB y) hy).1.le)
    θ hθ

end Bounty
