variable
  {I J : Type*}
  [sharedInstance1 : Fintype I]
  [sharedInstance2 : Fintype J]
  [sharedInstance3 : DecidableEq I]
  [sharedInstance4 : DecidableEq J]
  (S : Finset I)
  (T : Finset J)
  (left : S ≃ T)
  (right : ↥(Sᶜ) ≃ ↥(Tᶜ))

include I J sharedInstance1 sharedInstance2 sharedInstance3 sharedInstance4 S T left right

theorem finite_partition_equiv_left  (i : S) :
    finitePartitionEquiv S T left right i.val = (left i).val := by
  simp only [finitePartitionEquiv, Equiv.coe_fn_mk, dif_pos i.property]

theorem finite_partition_equiv_right  (i : ↥(Sᶜ)) :
    finitePartitionEquiv S T left right i.val = (right i).val := by
  simp only [finitePartitionEquiv, Equiv.coe_fn_mk, dif_neg (mem_compl.mp i.property)]

theorem finite_partition_equiv_mem_iff  (x : I) :
    finitePartitionEquiv S T left right x ∈ T ↔ x ∈ S := by
  by_cases hx : x ∈ S
  · have he := finite_partition_equiv_left S T left right ⟨x, hx⟩
    rw [he]
    exact iff_of_true (left ⟨x, hx⟩).property hx
  · have he := finite_partition_equiv_right S T left right ⟨x, mem_compl.mpr hx⟩
    rw [he]
    exact iff_of_false (mem_compl.mp (right ⟨x, mem_compl.mpr hx⟩).property) hx

end

end

