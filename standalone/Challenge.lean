theorem active_cross_endpoints_lt_cutoff {Z X : ℝ} {k : ℤ} {Zs : Finset ℕ}
    {z : ℕ} (hz : z ∈ typeIIActiveCrossZ Z k Zs)
    (hk : |(k : ℝ)| ≤ Z) (hX : 3*Z < X) :
    (z : ℝ) < X ∧ (((z : ℤ)+k).toNat : ℝ) < X := by
  obtain ⟨_, hz0, hw0, hzZ⟩ := mem_filter.mp hz
  have hZ : 0 < Z := by
    have : (0 : ℝ) < z := by exact_mod_cast hz0
    linarith
  have hw : (((z : ℤ)+k).toNat : ℝ) = (z : ℝ)+(k : ℝ) := by
    exact_mod_cast Int.toNat_of_nonneg hw0.le
  rw [hw]
  constructor
  · linarith
  · have := le_abs_self (k : ℝ)
    linarith

end Bounty
