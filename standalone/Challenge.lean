lemma mem_reflectionActivePool (I Q Q0:Ideal (_root_.OAI.ActualEisensteinCubic.O)) (e:pool I Q Q0→Fin 6)
    (P:pool I Q Q0) :
    P.val∈reflectionActivePool I Q Q0 e ↔ reflectionSixActive (e P) := by
