theorem finite_sigma_disjoint_of_fiber_disjoint {G : Type*} [DecidableEq G]
    {I : G → Type*} [∀ g, DecidableEq (I g)]
    (s t : Finset G) (A B : ∀ g, Finset (I g)) (hAB : ∀ g, Disjoint (A g) (B g)) :
    Disjoint (s.sigma A) (t.sigma B) := by
  apply disjoint_left.mpr
  intro a ha hb
  exact disjoint_left.mp (hAB a.1) (mem_sigma.mp ha).2 (mem_sigma.mp hb).2

