open Finset
open scoped Classical
noncomputable def globalBirthCoherentSupport {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (A H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent A H q) :
    DistinctOrderedSupport (Fin q.1) (ghostPhasePendingSupport (globalBirthMemoryReadout A H q)) :=
  ⟨⟨fun j => (q.2 j).1, hq.label_injective⟩, by
    intro p
    rw [global_birth_coherent_readout_pending_support A H q hq]
    simp only [mem_image, mem_univ, true_and]
    rfl⟩

theorem global_birth_coherent_readout_mask {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (a : P → Bool) (H : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent (ghostPhaseActivitySupport a) H q) :
    ghostPhaseMask a (globalBirthMemoryReadout (ghostPhaseActivitySupport a) H q) := by
  have he := global_birth_coherent_readout_active_support (ghostPhaseActivitySupport a) H q hq
  intro p
  have hp : globalBirthMemoryReadout (ghostPhaseActivitySupport a) H q p = none ↔ a p = true := by
    rw [← ghost_phase_mem_state_active_support, he]
    simp [ghostPhaseActivitySupport]
  cases ha : a p <;>
    cases hz : globalBirthMemoryReadout (ghostPhaseActivitySupport a) H q p <;>
    simp_all



end

section
open Finset
open scoped Classical
theorem distinct_unrestricted_complete_global_birth_phase_row {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    {N t : ℕ} (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hshared : ∀ p, atgt p = true ∧ asrc p = true → delta p = 0)
    (source target : Fin t ↪ P)
    (hsource : univ.image source = ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt)
    (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (old : (j : Fin N) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (eligible : Finset (Fin N))
    (heligible : ∀ j, j ∈ eligible ↔ old j = delta (f.val j))
    (β : P → ℝ) (ρ V : ℝ) (B : ℕ)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    unrestrictedEdgeAction source (fun j => (⟨f.val j, old j⟩ : Σ p, R p)) Sigma.fst
      (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) (fun z => z.2 = 0)
      (fun p => β p / V) ρ V eligible B
      (fun _stores promotions g fresh =>
        if GlobalBirthEdgeEventValid (ghostPhaseBornSupport w) f.val target
          ⟨promotions, g, fresh⟩ then 1 else 0)
      (fun target q => symmetricPhaseReadout
        (globalBirthMemoryBase (ghostPhaseActivitySupport atgt)
          (ghostPhaseBornSupport w ∪ univ.image target)) F q) =
      ∑ z, ((∏ p, (if atgt p && !(asrc p) then V⁻¹ else 1) *
        ghostPhaseDampedMovingEdge (atgt p) (asrc p) (delta p) (β p) ρ ρ (z p) (w p) : ℝ) : ℂ) *
        (if (ghostPhasePendingSupport z).card ≤ B then F z else 0) := by
  by_cases hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true
  · obtain ⟨e, he⟩ := global_birth_matching_promotion_exists atgt asrc delta w f old hold
      target htarget eligible heligible hc
    exact distinct_unrestricted_global_birth_phase_row atgt asrc delta w hw source target
      hsource htarget f old hold eligible e he hc β ρ V B F
  · have hvalid : ∀ event : FixedTargetEdgeEvent (Fin t) (Fin N) P eligible,
        ¬GlobalBirthEdgeEventValid (ghostPhaseBornSupport w) f.val target event := by
      intro event hv
      apply hc
      exact global_birth_event_implies_compatible atgt asrc delta w hw hshared f old hold
        target htarget eligible (fun j hj => (heligible j).mp hj) event hv
    have hout : ∀ z : (p : P) → GhostPhaseState (R p),
        (∏ p, (if atgt p && !(asrc p) then V⁻¹ else 1) *
          ghostPhaseDampedMovingEdge (atgt p) (asrc p) (delta p) (β p) ρ ρ (z p) (w p) : ℝ) = 0 := by
      intro z
      obtain ⟨p, hp⟩ := not_forall.mp hc
      apply prod_eq_zero (mem_univ p)
      rw [ghost_phase_damped_moving_edge_eq_zero_of_incompatible
        (atgt p) (asrc p) (delta p) (β p) ρ ρ (z p) (w p) (hw p) hp, mul_zero]
    simp only [unrestrictedEdgeAction, hvalid, if_false, mul_zero, zero_mul, sum_const_zero,
      hout, Complex.ofReal_zero]
end

section
open Finset
open scoped Classical
/- Actual old positions eligible to terminate at the current hit. -/
noncomputable def globalBirthVisitZeroIndices {P : Type*} {R : P → Type*}
    [∀ p, DecidableEq (R p)] {N : ℕ} (h : (p : P) → R p)
    (old : Fin N → Σ p, R p) : Finset (Fin N) :=
  univ.filter (fun j => (old j).2 = h (old j).1)

theorem global_birth_visit_zero_labels {P : Type*} [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (old : Fin N → Σ p, R p) :
    globalBirthVisitZeros h old =
      (globalBirthVisitZeroIndices h old).image (fun j => (old j).1) := rfl




theorem global_visit_death_subset_sum {J P M : Type*}
    [DecidableEq J] [DecidableEq P] [AddCommMonoid M]
    (Z : Finset J) (label : J → P) (hi : Function.Injective label)
    (F : Finset P → M) :
    (∑ T ∈ Z.powerset, F (T.image label)) = ∑ D ∈ (Z.image label).powerset, F D := by
  rw [powerset_image, sum_image]
  intro T _ U _ hTU
  exact (image_injective hi) hTU

/- The number of deaths and of retained old hits are unchanged by the label map. -/
theorem global_visit_death_counts {J P : Type*} [DecidableEq J] [DecidableEq P]
    (Z T : Finset J) (label : J → P) (hi : Function.Injective label) :
    (T.image label).card = T.card ∧
      (Z.image label \ T.image label).card = (Z \ T).card := by
  constructor
  · exact card_image_of_injective _ hi
  · rw [← image_sdiff Z T hi, card_image_of_injective _ hi]

/- Deleting labels of the chosen indices removes exactly those indices. -/
theorem global_birth_visit_surviving_indices {P : Type*} [DecidableEq P]
    {R : P → Type*} {N : ℕ} (old : Fin N → Σ p, R p)
    (hi : Function.Injective (Sigma.fst ∘ old)) (T : Finset (Fin N)) :
    ghostVisitSurvivingIndices old (T.image (fun j => (old j).1)) = univ \ T := by
  ext j
  have heq : ∀ k, (old k).1 = (old j).1 ↔ k = j := fun k => hi.eq_iff
  simp [ghostVisitSurvivingIndices, mem_image, heq]

/- The output is the same literal retained tuple, not just a permutation. -/
theorem global_birth_visit_index_output {P : Type*} [DecidableEq P]
    {R : P → Type*} {N b : ℕ} (h : (p : P) → R p) (old : Fin N → Σ p, R p)
    (hi : Function.Injective (Sigma.fst ∘ old)) (T : Finset (Fin N))
    (birth : Fin b → P) :
    globalBirthVisitOutput h old (T.image (fun j => (old j).1)) birth =
      retainedBirthTuple old (univ \ T) (fun j => ⟨birth j, h (birth j)⟩) := by
  rw [globalBirthVisitOutput, global_birth_visit_surviving_indices old hi T]

/- The actual-index global ghost row: select old hit indices to terminate,
retain all other old entries, and append the globally new ordered birth batch. -/
noncomputable def globalBirthGhostVisitIndexRow {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (β : P → ℝ) (η V ρ : ℝ) (cap : ℕ)
    (active H : Finset P) (old : Fin N → Σ p, R p)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) : ℂ :=
  ∑ T ∈ (globalBirthVisitZeroIndices h old).powerset,
    ∑ b ∈ range ((univ \ H).card + 1), ∑ f : Fin b ↪ ↥((univ : Finset P) \ H),
      ((((-η / ρ) ^ T.card * ((1 - η) / ρ ^ 2) ^ (globalBirthVisitZeroIndices h old \ T).card) *
        ((-η * V / ρ) ^ b * (∏ j, β (f j).val / V)) / (b.factorial : ℝ) : ℝ) : ℂ) *
      (if (retainedBirthTuple old (univ \ T) (fun j => ⟨(f j).val, h (f j).val⟩)).1 ≤ cap then
        symmetricPhaseReadout (globalBirthMemoryBase active
          (H ∪ globalVisitBirthRange (univ \ H) f)) F
          (retainedBirthTuple old (univ \ T) (fun j => ⟨(f j).val, h (f j).val⟩)) else 0)

/- Exact index-to-label reindexing of the full complex visit row. -/
theorem global_birth_ghost_visit_index_row_eq_label {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (β : P → ℝ) (η V ρ : ℝ) (cap : ℕ)
    (active H : Finset P) (old : Fin N → Σ p, R p)
    (hi : Function.Injective (Sigma.fst ∘ old))
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    globalBirthGhostVisitIndexRow h β η V ρ cap active H old F =
      globalBirthGhostVisitRow h β η V ρ cap active H old F := by
  unfold globalBirthGhostVisitRow globalBirthGhostVisitIndexRow
  rw [global_birth_visit_zero_labels, ← global_visit_death_subset_sum
    (globalBirthVisitZeroIndices h old) (fun j => (old j).1) hi]
  apply sum_congr rfl
  intro T _
  have hc := global_visit_death_counts (globalBirthVisitZeroIndices h old) T
    (fun j => (old j).1) hi
  simp only [hc.1, hc.2, global_birth_visit_index_output h old hi T]

/- The globally filtered actual-index row equals the damped phase tensor row. -/
theorem global_birth_ghost_visit_index_row_eq {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)] {N : ℕ}
    (a : P → Bool) (h : (p : P) → R p) (β : P → ℝ)
    (η V ρ : ℝ) (hV : V ≠ 0) (cap : ℕ)
    (y : (p : P) → GhostPhaseState (R p)) (hy : ghostPhaseMask a y)
    (old : Fin N → Σ p, R p) (hi : Function.Injective (Sigma.fst ∘ old))
    (hsupport : univ.image (fun j => (old j).1) = ghostPhasePendingSupport y)
    (hold : ∀ j, y (old j).1 = some (some (some (old j).2)))
    (H : Finset P) (hH : H = ghostPhaseBornSupport y)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    globalBirthGhostVisitIndexRow h β η V ρ cap (ghostPhaseActivitySupport a) H old F =
      ∑ x, ((∏ p, ghostPhaseDampedVisit (a p) (h p) η (β p) ρ (x p) (y p) : ℝ) : ℂ) *
        (if (ghostPhasePendingSupport x).card ≤ cap then F x else 0) := by
  rw [global_birth_ghost_visit_index_row_eq_label h β η V ρ cap _ H old hi F]
  exact global_birth_ghost_visit_row_eq a h β η V ρ hV cap y hy old hi hsupport hold H hH F
end

