    intro v z _
    exact finiteCrossNumerator_fixed_sector N a0 c0 ramifiedTraceLambda p (lift v)
      p (lift z) hcN (hlift v) (hlift z) (by simp)
  have hcompletes:∃(b d:(∀i,(_root_.OAI.ActualEisensteinCubic.O⧸Ideal.span {p i})ˣ)→_root_.OAI.ActualEisensteinCubic.O)
      (C:Matrix (Fin 2) (Fin 2) (_root_.OAI.ActualEisensteinCubic.O⧸Ideal.span {N})),
      (∀v,a v*d v-b v*(c0*r)=1) ∧
      (∀v,if mode then (9:_root_.OAI.ActualEisensteinCubic.O)∣b v ∧ (3:_root_.OAI.ActualEisensteinCubic.O)∣d v-1 else (3:_root_.OAI.ActualEisensteinCubic.O)∣b v+1 ∧ (9:_root_.OAI.ActualEisensteinCubic.O)∣d v) ∧
      ∀v,(!![a v,b v;c0*r,d v]:Matrix (Fin 2) (Fin 2) _root_.OAI.ActualEisensteinCubic.O).map (Ideal.Quotient.mk (Ideal.span {N}))=C := by
    cases mode
    · obtain ⟨b,d,C,hd,hb,hz,hm⟩:=exists_primary_denominator_sector_completions N c0 h9N hbase
        (fun (_:∀i,(_root_.OAI.ActualEisensteinCubic.O⧸Ideal.span {p i})ˣ)=>()) a (fun _=>r)
        (fun _=>hr) hacop (fun _=>hrNc) (fun v z _=>hfixed v z rfl) (fun _ _ _=>by simp)
      exact ⟨b,d,C (),hd,fun v=>⟨hb v,hz v⟩,hm⟩
    · obtain ⟨b,d,C,hd,hb,hz,hm⟩:=exists_primary_numerator_sector_completions N c0 hc0 h9N
        (fun (_:∀i,(_root_.OAI.ActualEisensteinCubic.O⧸Ideal.span {p i})ˣ)=>()) a (fun _=>r)
        (hap hbase) (fun _=>hr) hacop (fun _=>hrNc)
        (fun v z _=>hfixed v z rfl) (fun _ _ _=>by simp)
      exact ⟨b,d,C (),hd,fun v=>⟨hb v,hz v⟩,hm⟩
  obtain ⟨b,d,C,hdet,hconditions,hmat⟩:=hcompletes
