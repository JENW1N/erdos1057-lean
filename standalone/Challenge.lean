/- The selected small endpoints decorate the original fine edge keys.
The effective planned phase retains the original raw small residue update. -/

open scoped Classical
namespace Bounty
section Keys
variable {S I : Type} [Fintype S] {Ps : S → Finset ℕ}
  {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : I → Fin N → Finset (Fin J)) (k : Fin n → I → ℤ)
  (i : Fin n → I) {Cs : Fin n → S → Finset (Fin J)}
  (ds : PhysicalGroupSelectedData Ps ell Cs)

def physicalSelectedPlannedKey (j : Fin n) :
    PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := Fin n) :=
  (j, i j, physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc),
    physicalPermuteLabels (ds.2.2.2 j) (ds.2.1 j.succ))

noncomputable def physicalSelectedPlannedMultiplier (j : Fin n) : ℤ :=
  k j (i j) * (physicalSharedProduct (physicalSharedPrefix
    (physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc))) : ℕ)

noncomputable def physicalSelectedPlannedEventEquiv (tag : Option (Fin (n + 1) ⊕ Fin n))
    (x : PhysicalFullBoundedState P J ell B) :=
  fullPermutationKeyEventEquiv (fun g (p : P g) => p.val)
    (fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := Fin n) =>
      fun g => physicalFullSharedIndices (ell := ell) (C key.2.1 g)) B
    (fun key _ => PhysicalAuxLabels P (C key.2.1))
    (fun key => physicalFullEdgeDelta (C key.2.1)
      (k key.1 key.2.1 * (physicalSharedProduct (physicalSharedPrefix key.2.2.1) : ℕ)))
    (fun key => physicalFullEdgeD (C key.2.1))
    (physicalSelectedPlannedKey i ds) tag x

theorem physical_selected_planned_update
    (tag : Option (Fin (n + 1) ⊕ Fin n)) (r : PhysicalResidues Ps)
    (x : PhysicalFullBoundedState P J ell B)
    (e : PhysicalFullLedgerEvent (fun j => C (i j)) (physicalSelectedPlannedMultiplier k i ds)
      tag (fullActiveInitialLedger x, x)) :
    physicalPlannedSmallUpdate (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i => PhysicalAuxLabels P (C i))
      (fun t i d => physicalFullEdgeDelta (C i) (k t i * (physicalSharedProduct d : ℕ)))
      (fun _ i _ => physicalFullEdgeD (C i))
      (fun t i => physicalMixedBigStep (C i) (k t i))
      (tag.map (Sum.map id (physicalSelectedPlannedKey i ds))) r x
      (physicalSelectedPlannedEventEquiv C k i ds tag x e) =
    physicalFullSmallRawUpdate (fun j => C (i j)) (physicalSelectedPlannedMultiplier k i ds) tag r x e := by
  cases tag with
  | none => rfl
  | some tag =>
    cases tag with
    | inl j => rfl
    | inr j =>
      change physicalTranslateResidues r
        (k j (i j) * (physicalFullSharedD (C (i j))
          (productActiveMemorySplit (fun g => physicalFullSharedIndices (C (i j) g)) B x).1 e.1 : ℤ) *
          (physicalSharedProduct (physicalSharedPrefix
            (physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc))) : ℕ)) =
        physicalTranslateResidues r
          (k j (i j) * (physicalSharedProduct (physicalSharedPrefix
            (physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc))) : ℕ) *
            (physicalFullSharedD (C (i j))
              (productActiveMemorySplit (fun g => physicalFullSharedIndices (C (i j) g)) B x).1 e.1 : ℤ))
      congr 1
      ring



end Keys
end Bounty
