section

/- Exact uniform averaging over the small residue vector alone. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_group_residue_vertex_expectation {G : Type*} [Fintype G]
    [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ} (groups : Finset G)
    [∀ a : ↥(physicalPrimeGroups P groups), NeZero a.val.2.val]
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (labels : ℕ → PhysicalMarkLists P J ell) (visits : Finset ℕ)
    (offset : ℕ → ℤ) (q : ℕ → ℝ) :
    (∑ r : PhysicalGroupResidues P groups,
      (∏ a : ↥(physicalPrimeGroups P groups), 1 / (a.val.2.val : ℝ)) *
      ∏ j ∈ visits, physicalResidueVertexWeight
        (fun g : ↥groups => labels j g.val) (q j)
        (physicalTranslateResidues (physicalGroupResidueVector r) (offset j))) =
    ∏ a : ↥(physicalPrimeGroups P groups),
      (∑ z : ZMod a.val.2.val, activeResidueWeight visits
        (visits.filter (fun j => a.val ∈ physicalMarkedPrimes (labels j)))
        (fun j => -(offset j : ZMod a.val.2.val)) (fun j => 1 - q j) z) /
      (a.val.2.val : ℝ) := by
  classical
  simp only [← physical_group_residue_path_factorization hP hprime]
  let f := fun (a : ↥(physicalPrimeGroups P groups)) (z : ZMod a.val.2.val) =>
    activeResidueWeight visits
      (visits.filter (fun j => a.val ∈ physicalMarkedPrimes (labels j)))
      (fun j => -(offset j : ZMod a.val.2.val)) (fun j => 1 - q j) z
  change (∑ r : PhysicalGroupResidues P groups,
    (∏ a : ↥(physicalPrimeGroups P groups), 1 / (a.val.2.val : ℝ)) * ∏ a, f a (r a)) =
    ∏ a, (∑ z, f a z) / (a.val.2.val : ℝ)
  have he : ∀ r : PhysicalGroupResidues P groups,
      (∏ a : ↥(physicalPrimeGroups P groups), 1 / (a.val.2.val : ℝ)) * ∏ a, f a (r a) =
      ∏ a, f a (r a) / (a.val.2.val : ℝ) := by
    intro r
    rw [← prod_mul_distrib]
    apply prod_congr rfl
    intro a _
    ring
  simp only [he]
  simpa only [← sum_div] using
    (Fintype.prod_sum (fun (a : ↥(physicalPrimeGroups P groups))
      (z : ZMod a.val.2.val) => f a z / (a.val.2.val : ℝ))).symm

theorem physical_group_residue_vertex_pool_expectation {G : Type*} [Fintype G]
    [DecidableEq G] {P : G → Finset ℕ} [∀ a : PhysicalPrime P, NeZero a.2.val]
    {J ell : ℕ} (groups : Finset G)
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (labels : ℕ → PhysicalMarkLists P J ell) (visits : Finset ℕ)
    (offset : ℕ → ℤ) (q : ℕ → ℝ) :
    (∑ r : PhysicalGroupResidues P groups,
      (∏ a : ↥(physicalPrimeGroups P groups), 1 / (a.val.2.val : ℝ)) *
      ∏ j ∈ visits, physicalResidueVertexWeight
        (fun g : ↥groups => labels j g.val) (q j)
        (physicalTranslateResidues (physicalGroupResidueVector r) (offset j))) =
    poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val)
      (physicalPrimeGroups P groups) visits
      (fun a => visits.filter (fun j => a ∈ physicalMarkedPrimes (labels j)))
      (fun a j => -(offset j : ZMod a.2.val)) (fun j => 1 - q j) := by
  rw [physical_group_residue_vertex_expectation groups hP hprime]
  exact prod_coe_sort (physicalPrimeGroups P groups) (fun a =>
    (∑ z : ZMod a.2.val, activeResidueWeight visits
      (visits.filter (fun j => a ∈ physicalMarkedPrimes (labels j)))
      (fun j => -(offset j : ZMod a.2.val)) (fun j => 1 - q j) z) / (a.2.val : ℝ))

end Bounty
end

section

/- Only selected groups receive a baseline and a pending-memory run history. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_group_residue_run_normalization {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} [∀ a : PhysicalPrime P, NeZero a.2.val] {J ell : ℕ}
    (groups : Finset G) (V : G → ℝ) (L : ℕ → PhysicalMarkLists P J ell)
    (C : ℕ → G → Finset (Fin J)) (n : ℕ)
    (h : (a : PhysicalPrime P) → ℕ → ZMod a.2.val) (η : ℕ → ℝ) (b : PhysicalPrime P → ℝ)
    (hnew : ∀ j < n, ∀ g ∈ groups,
      (physicalGroupMarks (L (j + 1)) g \ physicalGroupMarks (L j) g).card = ell + (C j g).card)
    (hb : ∀ a : PhysicalPrime P, a.1 ∈ groups →
      b a = 1 - (∑ j ∈ range (n + 1), η j) / a.2.val)
    (hb0 : ∀ a : PhysicalPrime P, a.1 ∈ groups → b a ≠ 0) :
    physicalGroupPathMass V groups C ell n *
      poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val)
        (physicalPrimeGroups P groups) (range (n + 1))
        (fun a => (range (n + 1)).filter (fun j => a ∈ physicalMarkedPrimes (L j))) h η =
      (∏ a ∈ physicalPrimeGroups P groups, b a) *
        ∏ a ∈ physicalPrimeGroups P groups,
          ghostPhaseRunHistory (fun j => decide (a ∈ physicalMarkedPrimes (L j)))
            (h a) η ((a.2.val : ℝ) * b a)⁻¹ (V a.1) n := by
  classical
  rw [show physicalGroupPathMass V groups C ell n =
    ∏ a ∈ physicalPrimeGroups P groups,
      (V a.1)⁻¹ ^ ghostPhaseRunCount (fun j => decide (a ∈ physicalMarkedPrimes (L j))) n from
        (physical_selected_group_run_weights groups V L C n hnew).symm]
  unfold poolPathResidueExpectation
