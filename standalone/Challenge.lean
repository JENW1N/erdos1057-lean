    (f : (∀ i, X i) → ℂ) :
    finiteProductEventAction E weight target (fun _ _ => 1) f =
      finiteCoordinateFinsetAction (finiteLocalEventAction E weight target) univ f := by
  have hf : f = fun z => ∑ y : (∀ i, X i),
      f y * ∏ i, (if z i = y i then (1 : ℂ) else 0) :=
    funext (finite_product_delta_expansion f)
