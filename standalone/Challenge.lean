section

/- Exact energy assembly from only the retained full dyadic boxes. -/

open Finset MeasureTheory
namespace Bounty

def retainedFourDyadicBox (S : Finset ℕ) (N i j k l : ℕ) : Prop :=
  ∃ d ∈ dyadicNatBucket (Icc 1 N) i, ∃ a ∈ dyadicNatBucket (Icc 1 N) j,
    ∃ b ∈ dyadicNatBucket (Icc 1 N) k, ∃ c ∈ dyadicNatBucket (Icc 1 N) l,
      d*a*b*c ∈ S

noncomputable def fourDyadicBoxSum (N : ℕ) (δ α β γ F : ℕ → ℂ)
    (i j k l : ℕ) : ℂ :=
  ∑ d ∈ dyadicNatBucket (Icc 1 N) i, ∑ a ∈ dyadicNatBucket (Icc 1 N) j,
    ∑ b ∈ dyadicNatBucket (Icc 1 N) k, ∑ c ∈ dyadicNatBucket (Icc 1 N) l,
      δ d*α a*β b*γ c*F (d*a*b*c)

theorem endpoint_four_dyadic_energy {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (S : Finset ℕ) (N : ℕ) (hS : ∀ n ∈ S, n ≤ N)
    (δ α β γ : ℕ → ℂ) (F : Ω → ℕ → ℂ) (hF : ∀ s n, n ∉ S → F s n = 0)
    (E : ℝ) (hE0 : 0 ≤ E)
    (hf : ∀ i ∈ dyadicNatIndices (Icc 1 N), ∀ j ∈ dyadicNatIndices (Icc 1 N),
      ∀ k ∈ dyadicNatIndices (Icc 1 N), ∀ l ∈ dyadicNatIndices (Icc 1 N),
      retainedFourDyadicBox S N i j k l →
      Integrable (fun s => ‖fourDyadicBoxSum N δ α β γ (F s) i j k l‖ ^ 2) μ)
    (hE : ∀ i ∈ dyadicNatIndices (Icc 1 N), ∀ j ∈ dyadicNatIndices (Icc 1 N),
      ∀ k ∈ dyadicNatIndices (Icc 1 N), ∀ l ∈ dyadicNatIndices (Icc 1 N),
      retainedFourDyadicBox S N i j k l →
      (∫ s, ‖fourDyadicBoxSum N δ α β γ (F s) i j k l‖ ^ 2 ∂μ) ≤ E) :
    (∫ s, ‖∑ n ∈ S, endpointFourConvolution δ α β γ n * F s n‖ ^ 2 ∂μ)
      ≤ ((dyadicNatIndices (Icc 1 N)).card : ℝ) ^ 8 * E := by
  classical
  let f : ℕ → ℕ → ℕ → ℕ → Ω → ℂ := fun i j k l s =>
    if retainedFourDyadicBox S N i j k l then fourDyadicBoxSum N δ α β γ (F s) i j k l else 0
  have heq (s : Ω) : (∑ n ∈ S, endpointFourConvolution δ α β γ n * F s n) =
      ∑ i ∈ dyadicNatIndices (Icc 1 N), ∑ j ∈ dyadicNatIndices (Icc 1 N),
        ∑ k ∈ dyadicNatIndices (Icc 1 N), ∑ l ∈ dyadicNatIndices (Icc 1 N), f i j k l s := by
    rw [endpoint_four_supported_dyadic_boxes S N hS δ α β γ (F s) (hF s)]
    apply sum_congr rfl
    intro i _
    apply sum_congr rfl
    intro j _
    apply sum_congr rfl
    intro k _
    apply sum_congr rfl
    intro l _
    by_cases h : retainedFourDyadicBox S N i j k l
    · have h' : ∃ d ∈ dyadicNatBucket (Icc 1 N) i, ∃ a ∈ dyadicNatBucket (Icc 1 N) j,
          ∃ b ∈ dyadicNatBucket (Icc 1 N) k, ∃ c ∈ dyadicNatBucket (Icc 1 N) l,
            d*a*b*c ∈ S := h
      simp only [f, if_pos h, if_pos h', fourDyadicBoxSum]
    · have h' : ¬∃ d ∈ dyadicNatBucket (Icc 1 N) i, ∃ a ∈ dyadicNatBucket (Icc 1 N) j,
          ∃ b ∈ dyadicNatBucket (Icc 1 N) k, ∃ c ∈ dyadicNatBucket (Icc 1 N) l,
            d*a*b*c ∈ S := h
      simp only [f, if_neg h, if_neg h']
  simp_rw [heq]
  apply four_integrated_energy_le_card_eight μ _ f E
  · intro i hi j hj k hk l hl
    by_cases h : retainedFourDyadicBox S N i j k l
    · simpa only [f, if_pos h] using hf i hi j hj k hk l hl h
    · simp only [f, if_neg h, norm_zero, zero_pow (by omega : 2 ≠ 0)]
      exact integrable_zero _ _ _
  · intro i hi j hj k hk l hl
    by_cases h : retainedFourDyadicBox S N i j k l
    · simpa only [f, if_pos h] using hE i hi j hj k hk l hl h
    · simpa only [f, if_neg h, norm_zero, zero_pow (by omega : 2 ≠ 0), integral_zero] using hE0

end Bounty
end

