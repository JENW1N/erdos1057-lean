theorem global_birth_joint_prefix_output_only
    (initial : GlobalBirthJointPhase R → ℂ)
    (hinit : ∀ z, ¬ globalBirthJointPending z ≤ cap 0 → initial z = 0)
    (n : Nat) (x : Fin (n + 1) → GlobalBirthJointPhase R) :
    finiteChronologicalPrefix (globalBirthJointHistoryKernel a steps cap) initial n x =
      finiteChronologicalPrefix (fun i => globalBirthJointKernel (steps i) (cap (i + 1)))
        initial n x := by
  have he : globalBirthJointHistoryKernel a steps cap =
      finiteInputMaskedKernel (fun i z => globalBirthJointPending z ≤ cap i)
        (fun i => globalBirthJointKernel (steps i) (cap (i + 1))) := by
    funext i z w
    unfold globalBirthJointHistoryKernel globalBirthJointCutKernel finiteInputMaskedKernel
    split_ifs <;> rfl
  rw [he]
  apply finite_chronological_input_masks_collapse
    (fun i z => globalBirthJointPending z ≤ cap i)
    (fun i => globalBirthJointKernel (steps i) (cap (i + 1))) initial
  · intro i z w hz
    exact if_neg hz
  · exact hinit

theorem global_birth_joint_initial_prefix_output_only
    (β : (g : Fin N) → P g → ℝ) (n : Nat)
    (x : Fin (n + 1) → GlobalBirthJointPhase R) :
    finiteChronologicalPrefix (globalBirthJointHistoryKernel a steps cap)
      (fun z => ((∏ g, ∏ p, ghostPhaseInitial (a 0 g p) (β g p) (z g p) : ℝ) : ℂ)) n x =
    finiteChronologicalPrefix (fun i => globalBirthJointKernel (steps i) (cap (i + 1)))
      (fun z => ((∏ g, ∏ p, ghostPhaseInitial (a 0 g p) (β g p) (z g p) : ℝ) : ℂ)) n x :=
  global_birth_joint_prefix_output_only a steps cap _
    (ghost_phase_joint_initial_zero_of_pending (a 0) β (cap 0)) n x

/- Full weighted traces retain precisely the output projector at each cut.
The initial tensor may already use beta/V independently of all step data. -/
theorem global_birth_joint_initial_trace_output_only
    (β : (g : Fin N) → P g → ℝ) (F : GlobalBirthJointPhase R → ℂ) (n : Nat) :
    (∑ x : Fin (n + 1) → GlobalBirthJointPhase R,
      F (x (Fin.last n)) * finiteChronologicalPrefix (globalBirthJointHistoryKernel a steps cap)
        (fun z => ((∏ g, ∏ p, ghostPhaseInitial (a 0 g p) (β g p) (z g p) : ℝ) : ℂ)) n x) =
    ∑ x : Fin (n + 1) → GlobalBirthJointPhase R,
      F (x (Fin.last n)) *
        finiteChronologicalPrefix (fun i => globalBirthJointKernel (steps i) (cap (i + 1)))
          (fun z => ((∏ g, ∏ p, ghostPhaseInitial (a 0 g p) (β g p) (z g p) : ℝ) : ℂ)) n x := by
  apply sum_congr rfl
  intro x _
  rw [global_birth_joint_initial_prefix_output_only a steps cap β n x]

