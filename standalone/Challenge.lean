/- Exact full-pair summation at a single shared quotient position. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_scaled_root_sum_full_pair
    {G : Type*} [Fintype G] [dG : DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (C : G → Finset (Fin J)) (q a b : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (positions : Finset ℤ) (w : ℤ)
    (f g : ℤ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ)
    (hf : ∀ (L : PhysicalMarkLists P J ell) w,
      f ((physicalSharedFactor C L : ℤ) * w) = f w)
    (hg : ∀ (L : PhysicalMarkLists P J ell) w,
      g ((physicalSharedFactor C L : ℤ) * w) = g w) :
    (physicalStateMass V J ell : ℂ) *
      (∑ L : PhysicalMarkLists P J ell, ∑ R : PhysicalMarkLists P J ell,
        if (physicalSharedFactor C L : ℤ) * w ∈ positions ∧
            (physicalSharedFactor C L : ℤ) *
              (w + k * (physicalFreeFactor C aux : ℕ)) ∈ positions then
          physicalRootPositionTerm V C q (-(a+b)) k K aux
            (fun n => physicalPhase (-a) n.natAbs * f n)
            (fun n => physicalPhase b n.natAbs * g n) Ψ Z L R
            ((physicalSharedFactor C L : ℤ) * w)
        else 0) =
    (physicalAuxMass V C aux : ℂ) *
      (Ψ ((w : ℝ) / (Z * physicalFreeFactor C aux)) * (w : ℂ)⁻¹ *
        (starRingEnd ℂ) (f w) * g (w + k * (physicalFreeFactor C aux : ℕ))) *
      physicalFullPairCorrelation P C V q w.natAbs
        (w + k * (physicalFreeFactor C aux : ℕ)).natAbs (fun L R =>
          if (physicalSharedFactor C L : ℤ) * w ∈ positions ∧
              (physicalSharedFactor C L : ℤ) *
                (w + k * (physicalFreeFactor C aux : ℕ)) ∈ positions then
            physicalPhasedPairCoefficient C K aux a b w.natAbs
              (w + k * (physicalFreeFactor C aux : ℕ)).natAbs L R
          else 0) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold physicalFullPairCorrelation
  simp only [mul_sum]
  apply sum_congr rfl
  intro L _
  apply sum_congr rfl
  intro R _
  by_cases hguard : (physicalSharedFactor C L : ℤ) * w ∈ positions ∧
      (physicalSharedFactor C L : ℤ) *
        (w + k * (physicalFreeFactor C aux : ℕ)) ∈ positions
  · rw [if_pos hguard, physical_phased_root_term_scaled hprime V C q a b k K aux f g Ψ Z
      L R w (hf L w) (hg L _)]
    by_cases hshared : physicalSharedCompatible C L R
    · rw [if_pos hshared, if_pos hguard]
      push_cast
      ring
    · have hc : physicalPhasedPairCoefficient C K aux a b w.natAbs
          (w + k * (physicalFreeFactor C aux : ℕ)).natAbs L R = 0 := by
        apply if_neg
        exact fun h => hshared h.1
      rw [if_neg hshared, hc]
      simp only [mul_zero]
  · rw [if_neg hguard]
    by_cases hshared : physicalSharedCompatible C L R
    · rw [if_pos hshared, if_neg hguard]
      simp only [mul_zero]
    · rw [if_neg hshared]
      simp only [mul_zero]

end Bounty
