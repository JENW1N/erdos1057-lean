section

/- Finite cardinality bounds for the concrete physical prime patterns. -/

open Finset
open scoped Classical

namespace Bounty

theorem repeated_big_prime_pattern_cut_subset {G : Type*} [DecidableEq G]
    {J ell : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t) (g : G) :
    repeatedBigPrimePatternCut probes r t i g ⊆ probes g := by
  cases i with
  | inl u => exact empty_subset _
  | inr ab =>
      intro j hj
      have hm := (mem_repeatedBigAuxCut ab.1.val ab.2.val g j).mp hj
      rcases mem_union.mp hm with ha | hb
      · have hs := ((clean_mem_nonempty_subsets _ _).mp ab.1.property).2 ha
        have hp := (mem_sigma.mp hs).2
        simpa [repeatedBigPrimeProbeSlots] using hp
      · have hs := ((clean_mem_nonempty_subsets _ _).mp ab.2.property).2 hb
        have hp := (mem_sigma.mp hs).2
        simpa [repeatedBigPrimeProbeSlots] using hp

theorem repeated_big_prime_pattern_cut_card_le {G : Type*} [DecidableEq G]
    {J ell m : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G)
    (hp : ∀ g, (probes g).card ≤ m)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t) (g : G) :
    (repeatedBigPrimePatternCut probes r t i g).card ≤ m :=
  (card_le_card (repeated_big_prime_pattern_cut_subset probes r t i g)).trans (hp g)

theorem repeated_big_prime_probe_sigma_card_le {G : Type*} [DecidableEq G]
    {J ell m : ℕ} (probes : G → Finset (Fin J)) (r : Finset G)
    (hp : ∀ g, (probes g).card ≤ m) :
    (r.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes)).card ≤ m * r.card := by
  rw [card_sigma]
  calc
    _ ≤ ∑ _g ∈ r, m := by
      apply sum_le_sum
      intro g hg
      simpa only [repeatedBigPrimeProbeSlots, card_map] using hp g
    _ = _ := by simp [Nat.mul_comm]

theorem repeated_big_prime_pattern_pair_card {G : Type*} [DecidableEq G]
    {J ell : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G) :
    Fintype.card (RepeatedBigPrimePatternPair (ell := ell) probes r t) =
      (2 ^ (r.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes)).card - 1) *
        (2 ^ (t.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes)).card - 1) := by
  unfold RepeatedBigPrimePatternPair
  rw [Fintype.card_prod, Fintype.card_coe, Fintype.card_coe]
  simp [cleanNonemptySubsets]

theorem repeated_big_prime_pattern_pair_card_le {G : Type*} [DecidableEq G]
    {J ell m : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G)
    (hp : ∀ g, (probes g).card ≤ m) :
    Fintype.card (RepeatedBigPrimePatternPair (ell := ell) probes r t) ≤
      2 ^ (m * (r.card + t.card)) := by
  rw [repeated_big_prime_pattern_pair_card]
  calc
    _ ≤ 2 ^ (r.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes)).card *
        2 ^ (t.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes)).card :=
      Nat.mul_le_mul (Nat.sub_le _ _) (Nat.sub_le _ _)
    _ = 2 ^ ((r.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes)).card +
        (t.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes)).card) := (pow_add _ _ _).symm
    _ ≤ _ := by
      apply Nat.pow_le_pow_right (by decide : 1 ≤ 2)
      have hr := repeated_big_prime_probe_sigma_card_le (ell := ell) probes r hp
      have ht := repeated_big_prime_probe_sigma_card_le (ell := ell) probes t hp
      nlinarith




theorem repeated_big_prime_pattern_pair_card_le_groups {G : Type*}
    [Fintype G] [DecidableEq G] {J ell m : ℕ}
    (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    (hp : ∀ g, (probes g).card ≤ m) :
    Fintype.card (RepeatedBigPrimePatternPair (ell := ell) probes r t) ≤
      2 ^ (m * Fintype.card G) := by
  apply (repeated_big_prime_pattern_pair_card_le (ell := ell) probes r t hp).trans
  apply Nat.pow_le_pow_right (by decide : 1 ≤ 2)
  apply Nat.mul_le_mul_left
  rw [← card_union_of_disjoint hrt]
  exact card_le_univ _

end Bounty
end

