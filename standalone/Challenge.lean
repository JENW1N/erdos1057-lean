noncomputable def physicalFullStateLabels
    (x : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B)
    (hx : FullActiveInjective x) : PhysicalMarkLists P J ell :=
  fun g => ⟨(x g).1 ∘ (physicalFullSlotIndex (C g)).symm,
