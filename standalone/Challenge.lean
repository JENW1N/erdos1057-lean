/- Exact conversion of each smooth spatial correlation to harmonic normalization. -/

open Finset
open scoped ContDiff

namespace Bounty

noncomputable def typeIIHarmonicDyadic (t : ℝ) : ℝ := t * typeIISmoothDyadic t

theorem typeII_harmonic_dyadic_contDiff : ContDiff ℝ ∞ typeIIHarmonicDyadic :=
  contDiff_id.mul typeII_smooth_dyadic_contDiff




theorem typeII_harmonic_dyadic_bounds (t : ℝ) :
    0 ≤ typeIIHarmonicDyadic t ∧ typeIIHarmonicDyadic t ≤ 2 := by
  by_cases hzero : typeIISmoothDyadic t = 0
  · simp [typeIIHarmonicDyadic, hzero]
  · have hs := typeII_smooth_dyadic_support hzero
    have hb := typeII_smooth_dyadic_bounds t
    have ht : 0 ≤ t := by linarith [hs.1]
    exact ⟨mul_nonneg ht hb.1, (mul_le_of_le_one_right ht hb.2).trans hs.2.le⟩

theorem typeII_finite_harmonic_normalization (S : Finset ℕ) {Z : ℝ} (hZ : 0 < Z)
    (ψ : ℝ → ℝ) (f : ℕ → ℂ) (hS : ∀ z ∈ S, 0 < z) :
    (∑ z ∈ S, (ψ ((z : ℝ) / Z) : ℂ) * f z) =
      (Z : ℂ) * ∑ z ∈ S,
        ((((z : ℝ) / Z) * ψ ((z : ℝ) / Z) / (z : ℝ) : ℝ) : ℂ) * f z := by
  rw [mul_sum]
  apply sum_congr rfl
  intro z hz
  have hz0 : (z : ℝ) ≠ 0 := by exact_mod_cast (hS z hz).ne'
  have hid : Z * (((z : ℝ) / Z) * ψ ((z : ℝ) / Z) / (z : ℝ)) =
      ψ ((z : ℝ) / Z) := by field_simp
  rw [← mul_assoc, ← Complex.ofReal_mul, hid]




end Bounty
