    obtain ⟨σ, hσ, hm⟩ := physical_encoded_observation_permutation C k
      (cut i.val) (cut (i.val + 1)) (physicalSelectedFineTag n i.val) (s i) (e i)
      (physical_fine_tag_source_permutation j) (t (4 * j.val)) (t i.val)
      (hs (4 * j.val) (by have := j.isLt; omega)) (ht i)
    exact ⟨σ, (ho i).trans hσ, hm⟩
  · intro j
    let i : Fin (4 * n + 1) := ⟨4 * j.val + 2, by have := j.isLt; omega⟩
    obtain ⟨a, ha⟩ := physical_encoded_observation_edge C k
      (cut i.val) (cut (i.val + 1)) (physicalSelectedFineTag n i.val) (s i) (e i)
      j (physical_fine_tag_edge j)
    exact ⟨a, (ho i).trans ha⟩
  · intro j
    let i : Fin (4 * n + 1) := ⟨4 * j.val + 3, by have := j.isLt; omega⟩
    obtain ⟨κ, hκ, hm⟩ := physical_encoded_observation_permutation C k
      (cut i.val) (cut (i.val + 1)) (physicalSelectedFineTag n i.val) (s i) (e i)
      (physical_fine_tag_target_permutation j) (t (4 * j.val + 2)) (t i.val)
      (hs (4 * j.val + 2) (by have := j.isLt; omega)) (ht i)
    have htag : physicalSelectedFineTag n (4 * j.val + 4) = some (.inl j.succ) := by
      simpa only [Fin.val_succ, Nat.mul_add, Nat.mul_one] using physical_fine_tag_visit j.succ
    have hc : cut (4 * j.val + 4) = cut (4 * j.val + 5) := by
      simpa only [htag, PhysicalMarkRowEncoding] using hencode (4 * j.val + 4)
    let l : Fin (4 * n + 1) := ⟨4 * j.val + 4, by have := j.isLt; omega⟩
    have hg := physical_encoded_ghost_mark_step C k (cut l.val) (cut (l.val + 1))
      (physicalSelectedFineTag n l.val) (s l) (e l) j.succ htag hc
      (t i.val) (t l.val) (hs (4 * j.val + 3) (by have := j.isLt; omega)) (ht l)
    exact ⟨κ, (ho i).trans hκ, hg.trans hm⟩

end Fine
end Bounty
