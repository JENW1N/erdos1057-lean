  have h8:x-y∈(Ideal.span {(8:(_root_.OAI.ActualEisensteinCubic.O))}:Ideal (_root_.OAI.ActualEisensteinCubic.O)):=
    Ideal.mem_span_singleton.mpr ((show (8:(_root_.OAI.ActualEisensteinCubic.O))∣72 from ⟨9,by norm_num⟩).trans h72)
  have h4:(4:(_root_.OAI.ActualEisensteinCubic.O))∣x-y:=(show (4:(_root_.OAI.ActualEisensteinCubic.O))∣72 from ⟨18,by norm_num⟩).trans h72
  change ((unitSupplement u x * (supportedIdealRow lambda x)^a) * (twoSupplement x)^b) *
