section

/- The full actual prime comparison block with structural vanishing and probe bounds discharged. -/

namespace Bounty

open Finset
open scoped Classical

noncomputable def primeActivePhase {I : Type*} (P : I → Finset ℕ)
    (active : Finset I) (ζ Θ : ℝ) (x : ∀ i, P i) : ℂ :=
  primeTuplePhase ζ Θ (∏ i ∈ active, (x i).val)

theorem prime_active_phase_norm {I : Type*} (P : I → Finset ℕ)
    (active : Finset I) (ζ Θ : ℝ) (x : ∀ i, P i) :
    ‖primeActivePhase P active ζ Θ x‖ = 1 :=
  prime_tuple_phase_norm ζ Θ _

theorem prime_asymmetric_grouped_block_bound {G : Type*} [Fintype G] [DecidableEq G]
    {I : G → Type*} [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)]
    (P : G → Finset ℕ) (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hP : ∀ g p, p ∈ P g → 0 < p)
    (hmass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (probes tails : ∀ g, Finset (I g)) (hpt : ∀ g, Disjoint (probes g) (tails g))
    (m ell : ℕ) (hm : 0 < m) (hp : ∀ g, (probes g).card = m) (ht : ∀ g, (tails g).card = ell)
    (s t : Finset G) (hst : Disjoint s t) (active : Finset (Sigma I))
    (Q : ℕ) (h : ℝ) (keptA keptB : Finset (Sigma I) → Finset ℤ) (ζ Θ : ℝ)
    (f g : (∀ g, I g → P g) → ℂ)
    (hf : ∀ a, finiteGroupSlotSymmetric a f) (hg : ∀ a, finiteGroupSlotSymmetric a g)
    (ε : ℝ) (hε : 0 ≤ ε)
    (herr : ∀ S ∈ (s.sigma probes).powerset, ∀ T ∈ (t.sigma probes).powerset,
      ∀ A ∈ cleanNonemptySubsets (s.sigma probes \ S),
      ∀ B ∈ cleanNonemptySubsets (t.sigma probes \ T),
        ‖cleanKernelPairing (finiteProductWeight (fun a : Sigma I => physicalLabelLaw V a.1))
            (primeAsymmetricComparisonKernel (fun a : Sigma I => P a.1) (fun a => V a.1)
              active Q h keptA keptB ζ Θ A B)
            (finiteCoordinateComponent (fun a : Sigma I => physicalLabelLaw V a.1) S (s.sigma probes).toList
              (finiteGroupedTailTest (physicalLabelLaw V) tails f))
            (finiteCoordinateComponent (fun a : Sigma I => physicalLabelLaw V a.1) T (t.sigma probes).toList
              (finiteGroupedTailTest (physicalLabelLaw V) tails g)) -
          cleanRawPairing (finiteProductWeight (fun a : Sigma I => physicalLabelLaw V a.1))
            (primeActivePhase (fun a : Sigma I => P a.1) active ζ Θ)
            (finiteCoordinateComponent (fun a : Sigma I => physicalLabelLaw V a.1) S (s.sigma probes).toList
              (finiteGroupedTailTest (physicalLabelLaw V) tails f))
            (finiteCoordinateComponent (fun a : Sigma I => physicalLabelLaw V a.1) T (t.sigma probes).toList
              (finiteGroupedTailTest (physicalLabelLaw V) tails g))‖ ≤
        ε * Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun a : Sigma I => physicalLabelLaw V a.1))
          (finiteCoordinateComponent (fun a : Sigma I => physicalLabelLaw V a.1) S (s.sigma probes).toList
            (finiteGroupedTailTest (physicalLabelLaw V) tails f))) *
          Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun a : Sigma I => physicalLabelLaw V a.1))
            (finiteCoordinateComponent (fun a : Sigma I => physicalLabelLaw V a.1) T (t.sigma probes).toList
              (finiteGroupedTailTest (physicalLabelLaw V) tails g)))) :
    ‖cleanRawPairing (finiteProductWeight (fun a : Sigma I => physicalLabelLaw V a.1))
            (primeActivePhase (fun a : Sigma I => P a.1) active ζ Θ)
        (finiteGroupedTailTest (physicalLabelLaw V) tails f) (finiteGroupedTailTest (physicalLabelLaw V) tails g) -
      ∑ A ∈ cleanNonemptySubsets (s.sigma probes), ∑ B ∈ cleanNonemptySubsets (t.sigma probes),
        (-1 : ℂ) ^ (A.card + B.card) *
          cleanKernelPairing (finiteProductWeight (fun a : Sigma I => physicalLabelLaw V a.1))
            (primeAsymmetricComparisonKernel (fun a : Sigma I => P a.1) (fun a => V a.1)
              active Q h keptA keptB ζ Θ A B)
            (finiteGroupedTailTest (physicalLabelLaw V) tails f) (finiteGroupedTailTest (physicalLabelLaw V) tails g)‖ ≤
      (Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ s.card) +
        Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ t.card) +
        (3 : ℝ) ^ ((s.sigma probes).card + (t.sigma probes).card) * ε) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight
          (fun g => finiteProductWeight (fun _ : I g => physicalLabelLaw V g))) f) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight
          (fun g => finiteProductWeight (fun _ : I g => physicalLabelLaw V g))) g) := by
  have hμ : ∀ g (x : P g), 0 ≤ physicalLabelLaw V g x :=
    physical_label_law_nonneg V (fun g => (hV g).le)
  have hmμ : ∀ g, ∑ x : P g, physicalLabelLaw V g x = 1 :=
    fun g => physical_label_law_sum V g (hV g) (hmass g)
  have hnμ : ∀ g (x : P g), physicalLabelLaw V g x ≠ 0 := by
    intro g x
    unfold physicalLabelLaw
    apply div_ne_zero one_ne_zero
    exact mul_ne_zero (hV g).ne' (by exact_mod_cast (hP g x.val x.property).ne')
  let rootInlineArg0 := physicalLabelLaw (P := P) V
  let rootInlineArg1 := hmμ
  let rootInlineArg2 := hnμ
  let rootInlineArg3 := primeActivePhase (fun a : Sigma I => P a.1) active ζ Θ
  let rootInlineArg4 := fun x => (prime_active_phase_norm (fun a : Sigma I => P a.1) active ζ Θ x).le
  let rootInlineArg5 := fun A B => primeAsymmetricValue (fun a : Sigma I => P a.1) (fun a => V a.1)
    (active \ (A ∪ B)) A B Q h (keptA A) (keptB B) ζ Θ
  let μ := rootInlineArg0
  let hmass := rootInlineArg1
  let hμnz := rootInlineArg2
  let k := rootInlineArg3
  let hk := rootInlineArg4
  let F := rootInlineArg5
  have hUV : Disjoint (s.sigma probes) (t.sigma probes) := by
    apply disjoint_left.mpr
    intro a ha hb
    exact disjoint_left.mp hst (mem_sigma.mp ha).1 (mem_sigma.mp hb).1
  exact finite_asymmetric_signed_block_envelope (fun a : Sigma I => μ a.1)
    (fun a x => hμ a.1 x) (fun a => hmass a.1) active (s.sigma probes) (t.sigma probes)
    hUV (fun a x => hμnz a.1 x) k hk F (finiteGroupedTailTest μ tails f)
    (finiteGroupedTailTest μ tails g) _ _ _ _
    (finite_flatten_tail_norm_le μ hμ hmass tails f)
    (finite_flatten_tail_norm_le μ hμ hmass tails g)
    (finite_flatten_probe_tail_norm μ hμ hmass probes tails hpt m ell hm hp ht s f hf)
    (finite_flatten_probe_tail_norm μ hμ hmass probes tails hpt m ell hm hp ht t g hg)
    ε hε herr

end Bounty
end

