  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have hlen : 0 ≤ len := by
    have h := logarithmic_cell_length_lower (L := L) hY0.le S
    have hp : 0 ≤ Y*L^(-S) := by positivity
    exact hp.trans h
  have hz : 1 < z := Real.one_lt_exp_iff.mpr (by positivity)
  have hV0 : 0 ≤ V := (finite_prime_avoidance_product_pos _ (fun _ hp => (mem_filter.mp hp).2)).le
  have hVz : V ≤ 1/((a/40)*L) := full_prime_avoidance_exp_upper (by positivity)
  have hbase := hcount hY0.le (show Y ≤ Real.exp (L^(-S))*Y by linarith)
    hz (show 1 ≤ 2 by omega) (show Even 2 by decide)
  change |((roughBand Y (Real.exp (L^(-S))*Y) z).card : ℝ)-len*V| ≤
    K*(len*V*Real.exp (-2)+z^(4*(2 : ℝ)+2)) at hbase
  rw [show 4*(2 : ℝ)+2 = 10 by norm_num] at hbase
  have he2 : Real.exp (-2) ≤ 1 := Real.exp_le_one_iff.mpr (by norm_num)
  have hrough : ((roughBand Y (Real.exp (L^(-S))*Y) z).card : ℝ) ≤
      (K+1)*len*V+K*z^(10 : ℝ) := by
    have hh := (abs_le.mp hbase).2
    have he := mul_le_mul_of_nonneg_left he2 (mul_nonneg hlen hV0)
    nlinarith
  have hz10 : z^(10 : ℝ) = Real.exp ((a/4)*L) := by
    dsimp [z]
    rw [← Real.exp_mul]
    congr 1
    ring
  have herror : K*z^(10 : ℝ) ≤ len/L := by
    simp only [zero_mul, add_zero] at hprofile
    have hm := mul_le_mul_of_nonneg_left hprofile (Real.exp_pos (a*L)).le
    have heq : Real.exp (a*L)*(K*Real.exp (-(3*a/4)*L)) = K*Real.exp ((a/4)*L) := by
      calc
        _ = K*Real.exp (a*L+(-(3*a/4)*L)) := by rw [Real.exp_add]; ring
        _ = _ := by congr 2; ring
    rw [heq] at hm
    rw [hz10]
    apply hm.trans
    calc
      _ ≤ Y*L^(-(S+1)) := mul_le_mul_of_nonneg_right hY (by positivity)
      _ = (Y*L^(-S))/L := by
        rw [show -(S+1) = -S+(-1) by ring, Real.rpow_add hL, Real.rpow_neg_one]
        ring
      _ ≤ len/L := div_le_div_of_nonneg_right (logarithmic_cell_length_lower hY0.le S) hL.le
  have hmain := mul_le_mul_of_nonneg_left hVz (show 0 ≤ (K+1)*len by positivity)
  calc
    _ ≤ (K+1)*len*V+K*z^(10 : ℝ) := hrough
    _ ≤ (K+1)*len*(1/((a/40)*L))+len/L := add_le_add hmain herror
    _ = _ := by dsimp [len]; field_simp

theorem exists_exponential_rough_logarithmic_cell_upper {a γ₀ : ℝ}
    (ha : 0 < a) (hγ₀ : 0 < γ₀) :
    ∃ C : ℝ, 0 < C ∧ ∀ S : ℝ, ∀ᶠ L : ℝ in atTop,
      ∀ γ : ℝ, γ₀ ≤ γ → ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ((roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (γ*L))).card : ℝ) ≤
        C*(Real.exp (L^(-S))*Y-Y)/L := by
  let a₀ := min a (40*γ₀)
  have ha₀ : 0 < a₀ := lt_min ha (by positivity)
  obtain ⟨C, hC, hbound⟩ := exists_low_cutoff_rough_logarithmic_cell_upper ha₀
  refine ⟨C, hC, ?_⟩
  intro S
  filter_upwards [hbound S, eventually_gt_atTop (0 : ℝ)] with L hb hL
  intro γ hγ Y hY
  have hY' : Real.exp (a₀*L) ≤ Y :=
    (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right (min_le_left _ _) hL.le)).trans hY
  have hcut : Real.exp ((a₀/40)*L) ≤ Real.exp (γ*L) := by
    apply Real.exp_le_exp.mpr
    apply mul_le_mul_of_nonneg_right _ hL.le
    have hh : a₀ ≤ 40*γ₀ := min_le_right _ _
    linarith
  exact (Nat.cast_le.mpr (card_le_card (rough_band_subset_of_cutoff hcut))).trans (hb Y hY')

end Bounty
