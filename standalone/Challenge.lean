theorem finite_coordinate_lift_identity {G : Type*} [DecidableEq G] {Y : G → Type*}
    (g : G) (f : (∀ h, Y h) → ℂ) : finiteCoordinateLift g (fun v => v) f = f := by
  funext x
  simp only [finite_coordinate_lift_eq_update, Function.update_eq_self]

theorem finite_coordinate_lift_composition {G : Type*} [DecidableEq G] {Y : G → Type*}
    (g : G) (P Q : (Y g → ℂ) → Y g → ℂ) (f : (∀ h, Y h) → ℂ) :
    finiteCoordinateLift g P (finiteCoordinateLift g Q f) =
      finiteCoordinateLift g (fun v => P (Q v)) f := by
  funext x
  simp only [finite_coordinate_lift_eq_update, Function.update_self, Function.update_idem]

theorem finite_group_unflatten_update {G : Type*} [DecidableEq G]
    {I X : G → Type*} [∀ g, DecidableEq (I g)]
    (x : ∀ a : Sigma I, X a.1) (g : G) (i : I g) (v : X g) :
    finiteGroupFlattenEquiv.symm (Function.update x ⟨g, i⟩ v) =
      Function.update (finiteGroupFlattenEquiv.symm x) g
        (Function.update (finiteGroupFlattenEquiv.symm x g) i v) := by
  funext h j
  by_cases hh : h = g
  · subst h
    by_cases hj : j = i
    · subst j
      simp only [finite_group_unflatten_apply, Function.update_self]
    · have hs : (⟨g, j⟩ : Sigma I) ≠ ⟨g, i⟩ := by simpa using hj
      simp only [finite_group_unflatten_apply, Function.update_of_ne hs, Function.update_self,
        Function.update_of_ne hj]
  · have hs : (⟨h, j⟩ : Sigma I) ≠ ⟨g, i⟩ := fun he => hh (congrArg Sigma.fst he)
    simp only [finite_group_unflatten_apply, Function.update_of_ne hs, Function.update_of_ne hh]

