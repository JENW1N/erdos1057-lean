section

/- Numerical bounds for fixed probe sizes and logarithmically many prime groups.
The density-loss parameter is allowed polynomial growth in the path length. -/

open Filter

namespace Bounty

/- A positive proportion of logarithmically many groups turns a fixed probe
loss into a power saving. -/
theorem repeated_big_sqrt_probe_le {L theta beta E : ℝ} {n : ℕ}
    (hL : 1 ≤ L) (htheta : 0 < theta) (htheta1 : theta ≤ 1)
    (hn : beta * Real.log L ≤ (n : ℝ))
    (hgap : beta * Real.log theta / 2 ≤ -E) :
    Real.sqrt (theta ^ n) ≤ L ^ (-E) := by
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hlog : Real.log theta ≤ 0 := Real.log_nonpos htheta.le htheta1
  have hpow : theta ^ n ≤ L ^ (-2 * E) := by
    rw [← Real.exp_log htheta, ← Real.exp_nat_mul, Real.rpow_def_of_pos hL0]
    apply Real.exp_le_exp.mpr
    have hh := mul_le_mul_of_nonpos_right hn hlog
    have hg := mul_le_mul_of_nonneg_right hgap (Real.log_nonneg hL)
    nlinarith
  calc
    Real.sqrt (theta ^ n) ≤ Real.sqrt (L ^ (-2 * E)) := Real.sqrt_le_sqrt hpow
    _ = L ^ (-E) := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hL0.le]
      congr 1
      ring

/- An exponential in a logarithmic group count has an explicit polynomial
bound. The natural exponent can count any fixed number of probes per group. -/
theorem repeated_big_log_count_pow_le {L a b : ℝ} (m s : ℕ)
    (hL : 0 < L) (hb : 1 ≤ b) (hs : (s : ℝ) ≤ a * Real.log L) :
    b ^ (m * s) ≤ L ^ ((m : ℝ) * a * Real.log b) := by
  have hb0 : 0 < b := lt_of_lt_of_le zero_lt_one hb
  rw [← Real.exp_log hb0, ← Real.exp_nat_mul, Real.rpow_def_of_pos hL]
  apply Real.exp_le_exp.mpr
  have hh := mul_le_mul_of_nonneg_left hs
    (mul_nonneg (Nat.cast_nonneg m) (Real.log_nonneg hb))
  rw [Real.log_exp]
  push_cast
  nlinarith

/- Concrete scalar error budget after the finite pattern count. -/
noncomputable def repeatedBigNumericError (s m J ell Q : ℕ) (xi T P v : ℝ) : ℝ :=
  (1 + (2 : ℝ) ^ (m * s) * (((Q * Q : ℕ) : ℝ) / xi) ^ 2) *
    ((((2 * s * (ell + m) : ℕ) : ℝ) * T / P) +
      (s : ℝ) * ((m : ℝ) * (2 * ((J + ell : ℕ) : ℝ))) / (v * P))

/- Fixed constants in the density and collision errors. -/
noncomputable def repeatedBigNumericErrorConstant (m J ell : ℕ) (a v : ℝ) : ℝ :=
  2 * (2 * a * ((ell + m : ℕ) : ℝ) +
    a * ((m : ℝ) * (2 * ((J + ell : ℕ) : ℝ))) / v)

/- All factors in the actual finite pattern error are bounded explicitly;
no estimate for that error is assumed as a premise. -/
theorem repeated_big_numeric_error_le {L a q x tau v T P xi : ℝ}
    (s m J ell Q : ℕ) (hL : 1 ≤ L) (ha : 0 ≤ a) (hq : 0 ≤ q)
    (hx : 0 ≤ x) (htau : 0 ≤ tau) (hv : 0 < v) (hP : 0 < P)
    (hs : (s : ℝ) ≤ a * Real.log L) (hQ : (Q : ℝ) ≤ L ^ q)
    (hxi : L ^ (-x) ≤ xi) (hT0 : 0 ≤ T) (hT : T ≤ L ^ tau) :
    repeatedBigNumericError s m J ell Q xi T P v ≤
      repeatedBigNumericErrorConstant m J ell a v *
        L ^ ((m : ℝ) * a * Real.log 2 + 4 * q + 2 * x + tau + 1) / P := by
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hxi0 : 0 < xi := lt_of_lt_of_le (Real.rpow_pos_of_pos hL0 _) hxi
  have hsL : (s : ℝ) ≤ a * L := hs.trans
    (mul_le_mul_of_nonneg_left (Real.log_le_self hL0.le) ha)
  have htwo := repeated_big_log_count_pow_le (L := L) (a := a) (b := 2) m s hL0
    (by norm_num) hs
  have hQ2 : ((Q * Q : ℕ) : ℝ) ≤ L ^ (2 * q) := by
    push_cast
    calc
      (Q : ℝ) * Q ≤ L ^ q * L ^ q := mul_le_mul hQ hQ (Nat.cast_nonneg _) (by positivity)
      _ = L ^ (2 * q) := by rw [← Real.rpow_add hL0]; congr 1; ring
  have hratio : ((Q * Q : ℕ) : ℝ) / xi ≤ L ^ (2 * q + x) := by
    calc
      _ ≤ L ^ (2 * q) / L ^ (-x) := div_le_div₀ (by positivity) hQ2
        (Real.rpow_pos_of_pos hL0 _) hxi
      _ = _ := by rw [← Real.rpow_sub hL0]; congr 1; ring
  have hB : (((Q * Q : ℕ) : ℝ) / xi) ^ 2 ≤ L ^ (4 * q + 2 * x) := by
    calc
      _ ≤ (L ^ (2 * q + x)) ^ (2 : ℕ) := pow_le_pow_left₀ (by positivity) hratio 2
      _ = _ := by rw [← Real.rpow_natCast, ← Real.rpow_mul hL0.le]; congr 1; ring
  have hgamma : 0 ≤ (m : ℝ) * a * Real.log 2 + 4 * q + 2 * x := by
    have hl : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
    positivity
  have hcoeff : 1 + (2 : ℝ) ^ (m * s) * (((Q * Q : ℕ) : ℝ) / xi) ^ 2 ≤
      2 * L ^ ((m : ℝ) * a * Real.log 2 + 4 * q + 2 * x) := by
    have hp := mul_le_mul htwo hB (sq_nonneg _) (Real.rpow_nonneg hL0.le _)
    rw [← Real.rpow_add hL0, ← add_assoc] at hp
    have hone := Real.one_le_rpow hL hgamma
    nlinarith
  have hLtau : L ≤ L ^ (tau + 1) := by
    simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le hL
      (show (1 : ℝ) ≤ tau + 1 by linarith)
  have hdensity : (((2 * s * (ell + m) : ℕ) : ℝ) * T) ≤
      (2 * a * ((ell + m : ℕ) : ℝ)) * L ^ (tau + 1) := by
    have hh := mul_le_mul hsL hT hT0 (by positivity : 0 ≤ a * L)
    have hh' := mul_le_mul_of_nonneg_left hh
      (show 0 ≤ 2 * ((ell + m : ℕ) : ℝ) by positivity)
    rw [Real.rpow_add hL0, Real.rpow_one]
    push_cast at hh' ⊢
    ring_nf at hh' ⊢
    exact hh'
  have hcollision : (s : ℝ) * ((m : ℝ) * (2 * ((J + ell : ℕ) : ℝ))) / v ≤
      (a * ((m : ℝ) * (2 * ((J + ell : ℕ) : ℝ))) / v) * L ^ (tau + 1) := by
    have hh := hsL.trans (mul_le_mul_of_nonneg_left hLtau ha)
    have hh' := div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_right hh (by positivity : 0 ≤ (m : ℝ) * (2 * ((J + ell : ℕ) : ℝ)))) hv.le
    ring_nf at hh' ⊢
    exact hh'
  unfold repeatedBigNumericError repeatedBigNumericErrorConstant
  have hsum : (((2 * s * (ell + m) : ℕ) : ℝ) * T / P) +
      (s : ℝ) * ((m : ℝ) * (2 * ((J + ell : ℕ) : ℝ))) / (v * P) ≤
      (2 * a * ((ell + m : ℕ) : ℝ) +
        a * ((m : ℝ) * (2 * ((J + ell : ℕ) : ℝ))) / v) * L ^ (tau + 1) / P := by
    have hh := div_le_div_of_nonneg_right (add_le_add hdensity hcollision) hP.le
    ring_nf at hh ⊢
    exact hh
  calc
    _ ≤ (2 * L ^ ((m : ℝ) * a * Real.log 2 + 4 * q + 2 * x)) *
        ((2 * a * ((ell + m : ℕ) : ℝ) +
          a * ((m : ℝ) * (2 * ((J + ell : ℕ) : ℝ))) / v) * L ^ (tau + 1) / P) :=
      mul_le_mul hcoeff hsum (by positivity) (by positivity)
    _ = _ := by
      rw [show L ^ ((m : ℝ) * a * Real.log 2 + 4 * q + 2 * x + tau + 1) =
        L ^ ((m : ℝ) * a * Real.log 2 + 4 * q + 2 * x) * L ^ (tau + 1) by
          rw [← Real.rpow_add hL0]; congr 1; ring]
      ring

/- Uniform power saving for the literal density-plus-collision budget.
The cutoff, density loss, group count, and smallest prime remain quantified
inside the eventual statement. -/
theorem eventually_repeated_big_numeric_error_small (m J ell : ℕ)
    {a q x tau v c : ℝ} (ha : 0 ≤ a) (hq : 0 ≤ q) (hx : 0 ≤ x)
    (htau : 0 ≤ tau) (hv : 0 < v) (hc : 0 < c) (E : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (s Q : ℕ) (xi T P : ℝ),
      (s : ℝ) ≤ a * Real.log L → (Q : ℝ) ≤ L ^ q →
      L ^ (-x) ≤ xi → 0 ≤ T → T ≤ L ^ tau → Real.exp (L ^ c) ≤ P →
      repeatedBigNumericError s m J ell Q xi T P v ≤ L ^ (-E) := by
  let K := repeatedBigNumericErrorConstant m J ell a v
  let d := (m : ℝ) * a * Real.log 2 + 4 * q + 2 * x + tau + 1
  filter_upwards [eventually_ge_atTop (1 : ℝ), eventually_ge_atTop K,
    eventually_exp_neg_rpow_mul_rpow_le hc (show (0 : ℝ) < 1 by norm_num) (d + 1) E]
    with L hL hKL hdecay
  intro s Q xi T P hs hQ hxi hT0 hT hP
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hP0 : 0 < P := lt_of_lt_of_le (Real.exp_pos _) hP
  have hbase := repeated_big_numeric_error_le s m J ell Q hL ha hq hx htau hv hP0
    hs hQ hxi hT0 hT
  change repeatedBigNumericError s m J ell Q xi T P v ≤ K * L ^ d / P at hbase
  calc
    _ ≤ K * L ^ d / P := hbase
    _ ≤ L * L ^ d / Real.exp (L ^ c) := div_le_div₀
      (mul_nonneg hL0.le (Real.rpow_nonneg hL0.le _))
      (mul_le_mul_of_nonneg_right hKL (Real.rpow_nonneg hL0.le _))
      (Real.exp_pos _) hP
    _ = Real.exp (-1 * L ^ c) * L ^ (d + 1) := by
      rw [show L ^ (d + 1) = L ^ d * L by rw [Real.rpow_add hL0, Real.rpow_one]]
      simp only [neg_mul, one_mul, Real.exp_neg]
      ring
    _ ≤ _ := hdecay

/- The two block losses and the complete finite probe sum fit the desired
power bound with one power of slack in the parameter choices. -/
theorem repeated_big_positive_block_bound {L theta beta a D E : ℝ}
    (m s r t n : ℕ) (hL : 3 ≤ L) (htheta : 0 < theta) (htheta1 : theta ≤ 1)
    (hr : beta * Real.log L ≤ (r : ℝ)) (ht : beta * Real.log L ≤ (t : ℝ))
    (hs : (s : ℝ) ≤ a * Real.log L) (hn : n ≤ m * s)
    (hgap : beta * Real.log theta / 2 ≤ -(E + 1))
    (hD : (m : ℝ) * a * Real.log 3 + E + 1 ≤ D) :
    Real.sqrt (theta ^ r) + Real.sqrt (theta ^ t) + (3 : ℝ) ^ n * L ^ (-D) ≤
      L ^ (-E) := by
  have hL1 : 1 ≤ L := by linarith
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL1
  have hr' := repeated_big_sqrt_probe_le hL1 htheta htheta1 hr hgap
  have ht' := repeated_big_sqrt_probe_le hL1 htheta htheta1 ht hgap
  have hn' : (3 : ℝ) ^ n * L ^ (-D) ≤ L ^ (-(E + 1)) := by
    calc
      _ ≤ (3 : ℝ) ^ (m * s) * L ^ (-D) := mul_le_mul_of_nonneg_right
        (pow_le_pow_right₀ (by norm_num) hn) (Real.rpow_nonneg hL0.le _)
      _ ≤ L ^ ((m : ℝ) * a * Real.log 3) * L ^ (-D) := mul_le_mul_of_nonneg_right
        (repeated_big_log_count_pow_le m s hL0 (by norm_num) hs)
        (Real.rpow_nonneg hL0.le _)
      _ = L ^ ((m : ℝ) * a * Real.log 3 - D) := by rw [← Real.rpow_add hL0]; rfl
      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hL1 (by linarith)
  have hlast : 3 * L ^ (-(E + 1)) ≤ L ^ (-E) := by
    rw [show -(E + 1) = -E - 1 by ring, Real.rpow_sub hL0, Real.rpow_one,
      ← mul_div_assoc]
    apply (div_le_iff₀ hL0).mpr
    nlinarith [Real.rpow_pos_of_pos hL0 (-E)]
  linarith

end Bounty
end

section

/- Exact damping factorization for the complete clean pattern action.
The ordered memory occurrences stay in the residue fiber. Both adjacent
active projections remain in their original order. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def cleanResidueWeightMap {X R : Type*} (w : R → ℝ)
    (f : X → R → ℂ) (x : X) (r : R) : ℂ := (w r : ℂ) * f x r

theorem clean_active_map_residue_weight {X R : Type*}
    (Proj : (X → ℂ) →ₗ[ℂ] (X → ℂ)) (w : R → ℝ) (f : X → R → ℂ) :
    cleanActiveMap Proj (cleanResidueWeightMap w f) =
      cleanResidueWeightMap w (cleanActiveMap Proj f) := by
  funext x r
  change Proj ((w r : ℂ) • fun y => f y r) x = _
  rw [map_smul]
  rfl

noncomputable def cleanHybridPatternDampedAction {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (k : ℤ) (B : G → ℕ) (p : FixedOrderedMemoryLabels Pb N)
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ)
    (source : RepeatedBigLists Pb J ell) (r : PhysicalResidues Ps × FixedOrderedResidues p) : ℂ :=
  ∑ i, ∑ aux, ∑ target,
    (cleanHybridBetweenKernel Vb b (C i) ζ θ ρ k B p r.2 (K i) d aux source target *
      physicalPhase ζ (physicalSharedProduct d)) *
    f target (physicalTranslateResidues r.1 (cleanHybridStep k (C i) source aux d),
      fixedOrderedResidueTranslate p r.2 (cleanHybridStep k (C i) source aux d))

section

variable
  {I S G : Type*}
  [sharedInstance1 : Fintype I]
  [sharedInstance2 : Fintype S]
  [sharedInstance3 : Fintype G]
  {Ps : S → Finset ℕ}
  {Pb : G → Finset ℕ}
  {J ell : ℕ}
  {N : G → ℕ}
  (Vb : G → ℝ)
  (b : ∀ g, Pb g → ℝ)
  (C : I → G → Finset (Fin J))
  (ζ θ ρ : ℝ)
  (k : ℤ)
  (B : G → ℕ)
  (p : FixedOrderedMemoryLabels Pb N)
  (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
  (d : PhysicalSharedLists Ps J)

include I S G sharedInstance1 sharedInstance2 sharedInstance3 Ps Pb J ell N Vb b C ζ θ ρ k B p K d

theorem clean_hybrid_pattern_damped_factorization 
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ) :
    cleanHybridPatternDampedAction Vb b C ζ θ ρ k B p K d f =
      cleanResidueWeightMap (fun r => cleanMemoryInputWeight ρ p r.2)
        (cleanHybridPatternCoreAction Vb b C ζ θ k p K d
          (cleanResidueWeightMap (fun r => cleanMemoryOutputWeight ρ B p r.2) f)) := by
  funext source r
  simp only [cleanHybridPatternDampedAction, cleanHybridPatternCoreAction,
    cleanHybridCoreAction, cleanResidueWeightMap, mul_sum]
  apply sum_congr rfl
  intro i _
  apply sum_congr rfl
  intro aux _
  apply sum_congr rfl
  intro target _
  simp only [cleanHybridBetweenKernel, cleanHybridCoreCoefficient,
    clean_hybrid_memory_factor_split, Complex.ofReal_mul]
  ring

theorem clean_hybrid_projected_damped_factorization 
    (Proj : (RepeatedBigLists Pb J ell → ℂ) →ₗ[ℂ] (RepeatedBigLists Pb J ell → ℂ))
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ) :
    cleanActiveMap Proj (cleanHybridPatternDampedAction Vb b C ζ θ ρ k B p K d
      (cleanActiveMap Proj f)) =
      cleanResidueWeightMap (fun r => cleanMemoryInputWeight ρ p r.2)
        (cleanActiveMap Proj (cleanHybridPatternCoreAction Vb b C ζ θ k p K d
          (cleanActiveMap Proj
            (cleanResidueWeightMap (fun r => cleanMemoryOutputWeight ρ B p r.2) f)))) := by
  rw [clean_hybrid_pattern_damped_factorization, clean_active_map_residue_weight,
    clean_active_map_residue_weight]

end


theorem clean_residue_weight_norm_le {X R : Type*} [Fintype X] [Fintype R]
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (w : R → ℝ)
    (hw0 : ∀ r, 0 ≤ w r) (hw1 : ∀ r, w r ≤ 1) (f : X → R → ℂ) :
    cleanWeightedNorm μ (cleanResidueWeightMap w f) ≤ cleanWeightedNorm μ f := by
  apply Real.sqrt_le_sqrt
  apply sum_le_sum
  intro x _
  apply mul_le_mul_of_nonneg_left _ (hμ x)
  apply sum_le_sum
  intro r _
  apply pow_le_pow_left₀ (norm_nonneg _)
  calc
    ‖cleanResidueWeightMap w f x r‖ = w r * ‖f x r‖ := by
      simp only [cleanResidueWeightMap, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (hw0 r)]
    _ ≤ 1 * ‖f x r‖ := mul_le_mul_of_nonneg_right (hw1 r) (norm_nonneg _)
    _ = _ := one_mul _

theorem clean_hybrid_projected_damped_norm_le {I S G : Type*}
    [Fintype I] [Fintype S] [Fintype G]
    {Ps : S → Finset ℕ} {Pb : G → Finset ℕ} {J ell : ℕ} {N : G → ℕ}
    (Vb : G → ℝ) (b : ∀ g, Pb g → ℝ) (C : I → G → Finset (Fin J))
    (ζ θ ρ : ℝ) (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1) (k : ℤ)
    (B : G → ℕ) (p : FixedOrderedMemoryLabels Pb N)
    [∀ q : PhysicalPrime Ps, NeZero q.2.val] [∀ g j, NeZero (p g j).val]
    (K : ∀ i, RepeatedBigLists Pb J ell → RepeatedBigLists Pb J ell → PhysicalAuxLabels Pb (C i) → ℂ)
    (d : PhysicalSharedLists Ps J)
    (Proj : (RepeatedBigLists Pb J ell → ℂ) →ₗ[ℂ] (RepeatedBigLists Pb J ell → ℂ))
    (w : RepeatedBigLists Pb J ell → ℝ) (hw : ∀ x, 0 ≤ w x)
    (M : ℝ) (hM : 0 ≤ M)
    (hcore : ∀ f, cleanWeightedNorm w (cleanActiveMap Proj
      (cleanHybridPatternCoreAction Vb b C ζ θ k p K d (cleanActiveMap Proj f))) ≤
        M * cleanWeightedNorm w f)
    (f : RepeatedBigLists Pb J ell → (PhysicalResidues Ps × FixedOrderedResidues p) → ℂ) :
    cleanWeightedNorm w (cleanActiveMap Proj
      (cleanHybridPatternDampedAction Vb b C ζ θ ρ k B p K d (cleanActiveMap Proj f))) ≤
        M * cleanWeightedNorm w f := by
  rw [clean_hybrid_projected_damped_factorization]
  exact (clean_residue_weight_norm_le w hw (fun r : PhysicalResidues Ps × FixedOrderedResidues p => cleanMemoryInputWeight ρ p r.2)
    (fun r => clean_memory_input_weight_nonneg hρ0 p r.2)
    (fun r => clean_memory_input_weight_le_one hρ0 hρ1 p r.2) _).trans
      ((hcore _).trans (mul_le_mul_of_nonneg_left
        (clean_residue_weight_norm_le w hw (fun r : PhysicalResidues Ps × FixedOrderedResidues p => cleanMemoryOutputWeight ρ B p r.2)
          (fun r => clean_memory_output_weight_nonneg hρ0 B p r.2)
          (fun r => clean_memory_output_weight_le_one hρ0 hρ1 B p r.2) f) hM))

end Bounty
end

section

/- Exact coordinates for the full bounded product memory. Every ordered
occurrence keeps its own prime label and residue, including repeated labels.
The active slots are the literal first and tail blocks of the clean kernel. -/

open Finset
open scoped Classical

namespace Bounty

abbrev CleanFullMemoryState {G : Type*} (P : G → Finset ℕ) (J ell B : ℕ) :=
  ProductBoundedOrderedState (fun g => ↥(P g)) (fun g => UnrestrictedResidueParticle (fun p : P g => p.val))
    (fun _ => J + ell) B

abbrev CleanFullMemoryCoordinates {G : Type*} (P : G → Finset ℕ) (J ell B : ℕ) :=
  Σ N : G → Fin (B + 1), Σ p : FixedOrderedMemoryLabels P (fun g => (N g).val),
    RepeatedBigLists P J ell × FixedOrderedResidues p

def cleanFullMemoryState {G : Type*} {P : G → Finset ℕ} {J ell B : ℕ}
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p) :
    CleanFullMemoryState P J ell B :=
  fun g => (fun j => source g (finSumFinEquiv.symm j),
    ⟨N g, fun j => ⟨p g j, r g j⟩⟩)

def cleanFullMemoryEquiv {G : Type*} (P : G → Finset ℕ) (J ell B : ℕ) :
    CleanFullMemoryState P J ell B ≃ CleanFullMemoryCoordinates P J ell B where
  toFun x := ⟨fun g => (x g).2.1, fun g j => ((x g).2.2 j).1,
    (fun g j => (x g).1 (finSumFinEquiv j)), fun g j => ((x g).2.2 j).2⟩
  invFun x := cleanFullMemoryState x.1 x.2.1 x.2.2.1 x.2.2.2
  left_inv x := by
    funext g
    apply Prod.ext
    · funext j
      simp only [cleanFullMemoryState, Equiv.apply_symm_apply]
    · rfl
  right_inv x := by
    rcases x with ⟨N, p, source, r⟩
    simp only [cleanFullMemoryState, Equiv.symm_apply_apply]

theorem cleanFullMemoryEquiv_symm_apply {G : Type*} (P : G → Finset ℕ) (J ell B : ℕ)
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p) :
    (cleanFullMemoryEquiv P J ell B).symm ⟨N, p, source, r⟩ =
      cleanFullMemoryState N p source r := rfl

theorem cleanFullMemoryState_total_memory {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell B : ℕ}
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p) :
    productTotalMemory (cleanFullMemoryState N p source r) = ∑ g, (N g).val := rfl

noncomputable def cleanMemoryLabelWeight {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {B : ℕ} (ν : ∀ g, P g → ℝ)
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val)) : ℝ :=
  ∏ g, (∏ j, ν g (p g j)) / ((N g).val.factorial : ℝ)

theorem cleanFullMemoryState_weight {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell B : ℕ} (μ ν : ∀ g, P g → ℝ)
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p) :
    productMemoryWeight μ (fun g z => ν g z.1) (cleanFullMemoryState N p source r) =
      (∏ g, ∏ s, μ g (source g s)) * cleanMemoryLabelWeight ν N p := by
  unfold productMemoryWeight boundedOrderedStateWeight boundedOrderedMemoryWeight
    cleanFullMemoryState cleanMemoryLabelWeight
  rw [← prod_mul_distrib]
  apply prod_congr rfl
  intro g _
  congr 1
  exact Equiv.prod_comp finSumFinEquiv.symm (fun s => μ g (source g s))




theorem clean_full_memory_sum {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell B : ℕ} [∀ g (p : P g), NeZero p.val]
    (μ ν : ∀ g, P g → ℝ) (F : CleanFullMemoryState P J ell B → ℝ) :
    (∑ x : CleanFullMemoryState P J ell B,
      productMemoryWeight μ (fun g z => ν g z.1) x * F x) =
      ∑ N : G → Fin (B + 1),
        ∑ p : FixedOrderedMemoryLabels P (fun g => (N g).val),
          cleanMemoryLabelWeight ν N p *
            ∑ source : RepeatedBigLists P J ell, (∏ g, ∏ s, μ g (source g s)) *
              ∑ r : FixedOrderedResidues p, F (cleanFullMemoryState N p source r) := by
  rw [← (cleanFullMemoryEquiv P J ell B).symm.sum_comp
    (fun x => productMemoryWeight μ (fun g z => ν g z.1) x * F x)]
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro N _
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro p _
  rw [Fintype.sum_prod_type, mul_sum]
  apply sum_congr rfl
  intro source _
  rw [mul_sum, mul_sum]
  apply sum_congr rfl
  intro r _
  rw [cleanFullMemoryEquiv_symm_apply, cleanFullMemoryState_weight]
  ring




theorem cleanMemoryLabelWeight_nonneg {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {B : ℕ} (ν : ∀ g, P g → ℝ)
    (hν : ∀ g p, 0 ≤ ν g p)
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val)) :
    0 ≤ cleanMemoryLabelWeight ν N p :=
  prod_nonneg fun g _ => div_nonneg (prod_nonneg fun j _ => hν g (p g j))
    (Nat.cast_nonneg _)

theorem clean_full_memory_tilted_residue_energy {G R : Type*}
    [Fintype G] [DecidableEq G] [Fintype R]
    {P : G → Finset ℕ} {J ell B : ℕ} [∀ g (p : P g), NeZero p.val]
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (ν : ∀ g, P g → ℝ)
    (f : CleanFullMemoryState P J ell B → R → ℂ) :
    (∑ x : CleanFullMemoryState P J ell B,
      productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (b g))
        (fun g z => ν g z.1) x * ∑ r : R, ‖f x r‖ ^ 2) =
      ∑ N : G → Fin (B + 1),
        ∑ p : FixedOrderedMemoryLabels P (fun g => (N g).val),
          cleanMemoryLabelWeight ν N p *
            ∑ source : RepeatedBigLists P J ell, repeatedBigActiveMass V b source *
              ∑ r : R × FixedOrderedResidues p,
                ‖f (cleanFullMemoryState N p source r.2) r.1‖ ^ 2 := by
  rw [clean_full_memory_sum]
  apply sum_congr rfl
  intro N _
  apply sum_congr rfl
  intro p _
  congr 1
  apply sum_congr rfl
  intro source _
  congr 1
  rw [Fintype.sum_prod_type, sum_comm]

end Bounty
end

section

/- Exact reindexing and binary partition of finite ordered product lists. -/

open Finset

namespace Bounty

section

variable
  {I J : Type*}
  [sharedInstance1 : Fintype I]
  [sharedInstance2 : Fintype J]
  [sharedInstance3 : DecidableEq I]
  [sharedInstance4 : DecidableEq J]

include I J sharedInstance1 sharedInstance2 sharedInstance3 sharedInstance4

theorem ordered_slot_sum_test_equiv 
    (choices : J → Finset ℕ) (e : I ≃ J) (F : ℕ → ℝ) :
    (∑ x : ∀ j, choices j, F (orderedSlotProduct choices x)) =
      ∑ y : ∀ i, choices (e i), F (orderedSlotProduct (fun i => choices (e i)) y) := by
  classical
  apply Fintype.sum_equiv (Equiv.piCongrLeft (fun j => choices j) e).symm
  intro x
  congr 1
  exact (e.prod_comp (fun j => (x j).val)).symm

theorem ordered_slot_weight_equiv  (choices : J → Finset ℕ) (e : I ≃ J)
    (normalization : ℝ) (n : ℕ) :
    orderedSlotWeight choices normalization n =
      orderedSlotWeight (fun i => choices (e i)) normalization n := by
  classical
  unfold orderedSlotWeight
  convert ordered_slot_sum_test_equiv choices e
    (fun d => if d = n then 1/normalization else 0) using 1
  all_goals apply Finset.sum_congr (by ext; simp); intro x _; rfl

theorem ordered_slot_sum_test_sum 
    (A : I → Finset ℕ) (B : J → Finset ℕ) (F : ℕ → ℝ) :
    (∑ x : ∀ i : I ⊕ J, ↥(Sum.elim A B i), F (orderedSlotProduct (Sum.elim A B) x)) =
      ∑ a : ∀ i, A i, ∑ b : ∀ j, B j,
        F (orderedSlotProduct A a * orderedSlotProduct B b) := by
  classical
  let f : (∀ i, A i) × (∀ j, B j) → ℝ := fun y =>
    F (orderedSlotProduct A y.1 * orderedSlotProduct B y.2)
  calc
    _ = ∑ y, f y := by
      apply Fintype.sum_equiv (Equiv.sumPiEquivProdPi (fun i : I ⊕ J => ↥(Sum.elim A B i)))
      intro x
      congr 1
      exact Fintype.prod_sum_type (fun i => (x i).val)
    _ = _ := Fintype.sum_prod_type f

theorem ordered_slot_weight_sum_split 
    (A : I → Finset ℕ) (B : J → Finset ℕ) (normalization : ℝ) (n : ℕ) :
    orderedSlotWeight (Sum.elim A B) normalization n =
      ∑ a : ∀ i, A i, ∑ b : ∀ j, B j,
        if orderedSlotProduct A a * orderedSlotProduct B b = n then 1/normalization else 0 := by
  classical
  unfold orderedSlotWeight
  convert ordered_slot_sum_test_sum A B (fun d => if d = n then 1/normalization else 0) using 1
  apply Finset.sum_congr (by ext; simp)
  intro x _
  rfl

end


end Bounty
end

section

/- Exact one-mark expansions, including the endpoint q = 0. -/

open Finset

namespace Bounty

theorem one_marked_factor_choice_sum {G : Type*} (P : G → Finset ℕ) (g : G)
    (q V : ℝ) (n : ℤ) :
    markedDivisorFactor q V (physicalOmega P g n) 1 =
      ∑ p : P g, if (p.val : ℤ) ∣ n then q^(physicalOmega P g n - 1)/V else 0 := by
  classical
  rw [sum_coe_sort (P g) (fun p : ℕ => if (p : ℤ) ∣ n then q^(physicalOmega P g n - 1)/V else 0)]
  rw [← sum_filter]
  simp only [sum_const, nsmul_eq_mul]
  unfold markedDivisorFactor physicalOmega physicalDivisorPool
  simp only [Nat.descFactorial_one, pow_one]
  ring

theorem one_marked_weight_choice_sum {G : Type*} [DecidableEq G] (groups : Finset G)
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ) (n : ℤ) :
    markedDivisorWeight groups P q V (fun _ => 1) n =
      ∑ x : ∀ g : groups, P g.val,
        ∏ g : groups, if ((x g).val : ℤ) ∣ n then q^(physicalOmega P g.val n - 1)/V g.val else 0 := by
  classical
  unfold markedDivisorWeight
  rw [← prod_coe_sort groups]
  simp_rw [one_marked_factor_choice_sum]
  exact Fintype.prod_sum _

end Bounty
end

