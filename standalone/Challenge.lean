/- A fixed nine-interval cover of the full common-window convolution support. -/

open Finset MeasureTheory

namespace Bounty

theorem geometric_local_interval_cover {X : ℝ} (hX : 0 < X) (K : ℕ) {v : ℝ}
    (hv : v ∈ Set.Icc (X/2) (3*X*(2:ℝ)^K)) :
    ∃ i ∈ range (K+1), v ∈ Set.Icc ((X*(2:ℝ)^i)/2) (3*(X*(2:ℝ)^i)) := by
  induction K with
  | zero => exact ⟨0, by simp, by simpa using hv⟩
  | succ K ih =>
    by_cases hprev : v ≤ 3*X*(2:ℝ)^K
    · obtain ⟨i,hi,hvi⟩ := ih ⟨hv.1,hprev⟩
      exact ⟨i, mem_range.mpr (by have := mem_range.mp hi; omega), hvi⟩
    · refine ⟨K+1, by simp, ?_⟩
      have hpos : 0 < X*(2:ℝ)^K := by positivity
      rw [pow_succ] at hv ⊢
      constructor <;> nlinarith [hv.2]

theorem wide_mellin_interval_cover {Y v : ℝ} (hY : 0 < Y)
    (hv : v ∈ Set.Icc (Y/16) (65*Y)) :
    ∃ i ∈ range 9, v ∈ Set.Icc (((Y/8)*(2:ℝ)^i)/2) (3*((Y/8)*(2:ℝ)^i)) := by
  apply geometric_local_interval_cover (by positivity : 0 < Y/8) 8
  constructor <;> norm_num <;> linarith [hv.1,hv.2]

theorem wide_mellin_scale_bounds {Y : ℝ} (hY : 0 < Y) {i : ℕ} (hi : i ∈ range 9) :
    Y/8 ≤ (Y/8)*(2:ℝ)^i ∧ (Y/8)*(2:ℝ)^i ≤ 32*Y := by
  have hlo : 1 ≤ (2:ℝ)^i := one_le_pow₀ (by norm_num)
  have hhi : (2:ℝ)^i ≤ 256 := by
    have h := pow_le_pow_right₀ (by norm_num : (1:ℝ) ≤ 2) (show i ≤ 8 by
      have := mem_range.mp hi; omega)
    norm_num at h
    exact h
  constructor <;> nlinarith

theorem local_additive_convolution_wide_support (S : Finset ℕ) (a : ℕ → ℂ)
    {Y H v : ℝ} (_hY : 0 < Y) (hH : 0 < H) (hsmall : H ≤ Y/64)
    (hS : ∀ n ∈ S, Y/8 ≤ (n:ℝ) ∧ (n:ℝ) ≤ 64*Y)
    (hv : v ∉ Set.Icc (Y/16) (65*Y)) : localAdditiveConvolution S a H v = 0 := by
  unfold localAdditiveConvolution
  apply sum_eq_zero
  intro n hn
  have hz : localMellinKernelSchwartz (((n:ℝ)-v)/H) = 0 := by
    apply local_mellin_kernel_unit_support
    apply lt_of_not_ge
    intro hb
    rw [abs_div, abs_of_pos hH] at hb
    have ht := abs_le.mp ((div_le_one hH).mp hb)
    apply hv
    constructor <;> linarith [(hS n hn).1, (hS n hn).2, ht.1, ht.2]
  rw [hz, mul_zero]

end Bounty
end

