  have he := physical_small_big_average_cap_eq (S := S) (Ps := Ps) (J := J) (ell := ell)
    (fun s => physicalSmallBigFullPhasedAction (fun g (p : P g) => p.val) shared B
      (fun d c _ => -(k * (D_B c * physicalSharedProduct d : ℕ)))
