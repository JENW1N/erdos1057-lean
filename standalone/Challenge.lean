section

/- A first-derivative test with monotone phase increments on an integer interval. -/

open Finset

namespace Bounty

theorem sum_integer_interval_as_range (g : ℤ → ℂ) {a b : ℤ} (hab : a ≤ b) :
    ∑ n ∈ Icc a b, g n = ∑ n ∈ range (b-a+1).toNat, g (a+n) := by
  symm
  apply sum_bij (fun (n : ℕ) _ => a+(n : ℤ))
  · intro n hn
    rw [mem_range] at hn
    rw [mem_Icc]
    have hcast : ((b-a+1).toNat : ℤ) = b-a+1 := Int.toNat_of_nonneg (by omega)
    constructor <;> omega
  · intro n hn m hm he
    omega
  · intro z hz
    have hz' := mem_Icc.mp hz
    refine ⟨(z-a).toNat, ?_, ?_⟩
    · rw [mem_range]
      omega
    · omega
  · intro n hn
    rfl

theorem integer_first_derivative_sum_bound (f : ℤ → ℝ) (a b k : ℤ)
    {δ : ℝ} (hδ : 0 < δ) (hδhalf : δ ≤ 1/2)
    (hband : ∀ n ∈ Icc a b, (k : ℝ)+δ ≤ f (n+1)-f n ∧
      f (n+1)-f n ≤ (k : ℝ)+1-δ)
    (hmono : MonotoneOn (fun n => f (n+1)-f n) (Set.Icc a b) ∨
      AntitoneOn (fun n => f (n+1)-f n) (Set.Icc a b)) :
    ‖∑ n ∈ Icc a b, realUnitPhase (f n)‖ ≤ 2/δ := by
  by_cases hab : a ≤ b
  · rw [sum_integer_interval_as_range _ hab]
    have hm (n : ℕ) (hn : n < (b-a+1).toNat) : a+(n : ℤ) ∈ Icc a b := by
      rw [mem_Icc]
      have hcast : ((b-a+1).toNat : ℤ) = b-a+1 := Int.toNat_of_nonneg (by omega)
      constructor <;> omega
    apply first_derivative_range_sum_bound (fun n => f (a+(n : ℤ))) _ k hδ hδhalf
    · intro n hn
      simpa only [Nat.cast_add, Nat.cast_one, ← add_assoc] using hband _ (hm n hn)
    · rcases hmono with hmon | hmon
      · left
        intro n hn m hm' hnm
        simpa only [Nat.cast_add, Nat.cast_one, ← add_assoc] using
          hmon (mem_Icc.mp (hm n hn)) (mem_Icc.mp (hm m hm')) (by omega)
      · right
        intro n hn m hm' hnm
        simpa only [Nat.cast_add, Nat.cast_one, ← add_assoc] using
          hmon (mem_Icc.mp (hm n hn)) (mem_Icc.mp (hm m hm')) (by omega)
  · rw [Icc_eq_empty_of_lt (lt_of_not_ge hab),sum_empty,norm_zero]
    positivity

end Bounty
end

section

/- A genuine second derivative exponential-sum test, using the proved first derivative estimate. -/

open Finset

namespace Bounty

theorem nat_second_derivative_sum_bound (f : ℕ → ℝ) {a b : ℕ} {lam A : ℝ}
    (hab : a ≤ b) (hlam : 0 < lam) (hA : 1 ≤ A)
    (hsep : ∀ i ∈ Icc a b, ∀ j ∈ Icc a b, i ≤ j →
      lam*((j : ℝ)-i) ≤ (f (j+1)-f j)-(f (i+1)-f i) ∧
        (f (j+1)-f j)-(f (i+1)-f i) ≤ A*lam*((j : ℝ)-i)) :
    ‖∑ n ∈ Icc a b, realUnitPhase (f n)‖ ≤
      6*(A*((b : ℝ)-a+1)*Real.sqrt lam+2/Real.sqrt lam) := by
  have he := discrete_second_derivative_from_first (d := fun n => f (n+1)-f n)
    (z := fun n => realUnitPhase (f n)) (C := 2) hab hlam hA (by norm_num) hsep
    (fun n _ => (real_unit_phase_norm _).le)
  norm_num only [show (2 : ℝ)+4=6 by norm_num] at he
  apply he
  intro δ hδ hδhalf l r k hl hr hlr hband
  apply nat_first_derivative_sum_bound f l r k hδ hδhalf hband
  intro i hi j hj hij
  have hi' : i ∈ Icc a b := mem_Icc.mpr ⟨hl.trans hi.1,hi.2.trans hr⟩
  have hj' : j ∈ Icc a b := mem_Icc.mpr ⟨hl.trans hj.1,hj.2.trans hr⟩
  have h := (hsep i hi' j hj' hij).1
  have hijR : (i : ℝ) ≤ j := by exact_mod_cast hij
  nlinarith

theorem second_derivative_sum_bound {f f' f'' : ℝ → ℝ} {a b : ℕ} {lam A : ℝ}
    (hab : a ≤ b) (hlam : 0 < lam) (hA : 1 ≤ A)
    (hf : ∀ x ∈ Set.Icc (a : ℝ) (b+1), HasDerivAt f (f' x) x)
    (hf' : ∀ x ∈ Set.Icc (a : ℝ) (b+1), HasDerivAt f' (f'' x) x)
    (hb : ∀ x ∈ Set.Icc (a : ℝ) (b+1), lam ≤ f'' x ∧ f'' x ≤ A*lam) :
    ‖∑ n ∈ Icc a b, realUnitPhase (f n)‖ ≤
      6*(A*((b : ℝ)-a+1)*Real.sqrt lam+2/Real.sqrt lam) := by
  apply nat_second_derivative_sum_bound (fun n => f n) hab hlam hA
  intro i hi j hj hij
  have hi' : (i : ℝ) ∈ Set.Icc (a : ℝ) b := by
    constructor
    · exact_mod_cast (mem_Icc.mp hi).1
    · exact_mod_cast (mem_Icc.mp hi).2
  have hj' : (j : ℝ) ∈ Set.Icc (a : ℝ) b := by
    constructor
    · exact_mod_cast (mem_Icc.mp hj).1
    · exact_mod_cast (mem_Icc.mp hj).2
  simpa only [Nat.cast_add,Nat.cast_one] using
    second_derivative_increment_bounds hf hf' hb hi' hj' (by exact_mod_cast hij)

theorem norm_sum_real_unit_phase_neg (S : Finset ℕ) (f : ℕ → ℝ) :
    ‖∑ n ∈ S, realUnitPhase (-f n)‖ = ‖∑ n ∈ S, realUnitPhase (f n)‖ := by
  have he (x : ℝ) : realUnitPhase (-x) = (starRingEnd ℂ) (realUnitPhase x) := by
    unfold realUnitPhase
    rw [← Complex.exp_conj]
    congr 1
    simp only [map_mul,Complex.conj_ofReal,Complex.conj_I]
    push_cast
    ring
  simp_rw [he]
  rw [← map_sum]
  exact Complex.norm_conj _

theorem second_derivative_sum_bound_negative {f f' f'' : ℝ → ℝ} {a b : ℕ} {lam A : ℝ}
    (hab : a ≤ b) (hlam : 0 < lam) (hA : 1 ≤ A)
    (hf : ∀ x ∈ Set.Icc (a : ℝ) (b+1), HasDerivAt f (f' x) x)
    (hf' : ∀ x ∈ Set.Icc (a : ℝ) (b+1), HasDerivAt f' (f'' x) x)
    (hb : ∀ x ∈ Set.Icc (a : ℝ) (b+1), -A*lam ≤ f'' x ∧ f'' x ≤ -lam) :
    ‖∑ n ∈ Icc a b, realUnitPhase (f n)‖ ≤
      6*(A*((b : ℝ)-a+1)*Real.sqrt lam+2/Real.sqrt lam) := by
  have h := second_derivative_sum_bound hab hlam hA
    (fun x hx => (hf x hx).neg) (fun x hx => (hf' x hx).neg)
    (show ∀ x ∈ Set.Icc (a : ℝ) (b+1), lam ≤ -f'' x ∧ -f'' x ≤ A*lam from by
      intro x hx
      have hb' := hb x hx
      constructor <;> linarith)
  simpa only [Pi.neg_apply,norm_sum_real_unit_phase_neg] using h

end Bounty
end

section

/- Actual prime-polynomial power moments and derivative moments. The
integer coefficients, their factorial energy bound, and their support range
are all derived from the prime tuples rather than assumed. -/

open Finset MeasureTheory
open scoped Classical
namespace Bounty

theorem prime_polynomial_support_range (P : Finset ℕ)
    (hP : ∀ p ∈ P, Nat.Prime p) (U : ℝ) (hU : ∀ p ∈ P, (p : ℝ) ≤ U)
    (j N : ℕ) (hN : U ^ j ≤ (N : ℝ)) :
    ∀ n ∈ primePolynomialSupport P j, 1 ≤ n ∧ n ≤ N := by
  intro n hn
  exact ⟨prime_polynomial_support_pos P hP j n hn,
    Nat.cast_le.mp ((prime_polynomial_support_real_le P U hU j n hn).trans hN)⟩

theorem prime_polynomial_mean_square_factor_nonneg (N : ℕ) (hN : 1 ≤ N)
    (a b : ℝ) (hab : a ≤ b) :
    0 ≤ (b - a) + 4 * (N : ℝ) * (1 + Real.log N) := by
  have hlog : 0 ≤ Real.log N := Real.log_nonneg (by exact_mod_cast hN)
  exact add_nonneg (sub_nonneg.mpr hab)
    (mul_nonneg (mul_nonneg (by norm_num) (Nat.cast_nonneg _))
      (add_nonneg zero_le_one hlog))

theorem prime_polynomial_power_mean_square (P : Finset ℕ)
    (hP : ∀ p ∈ P, Nat.Prime p) (w : P → ℂ)
    (U : ℝ) (hU : ∀ p ∈ P, (p : ℝ) ≤ U) (j N : ℕ)
    (hN : 1 ≤ N) (hUN : U ^ j ≤ (N : ℝ)) (a b : ℝ) (hab : a ≤ b) :
    (∫ t in a..b,
      ‖(∑ p : P, w p * Complex.exp (((Real.log (p.val : ℝ) * t : ℝ) : ℂ) * Complex.I)) ^ j‖ ^ 2) ≤
      ((b - a) + 4 * (N : ℝ) * (1 + Real.log N)) *
        (j.factorial : ℝ) * (∑ p : P, ‖w p‖ ^ 2) ^ j := by
  have hexp : (fun t : ℝ =>
      ‖(∑ p : P, w p * Complex.exp (((Real.log (p.val : ℝ) * t : ℝ) : ℂ) * Complex.I)) ^ j‖ ^ 2) =
      (fun t : ℝ => ‖∑ n ∈ primePolynomialSupport P j, primePolynomialCoefficient P w j n *
        Complex.exp (((Real.log (n : ℝ) * t : ℝ) : ℂ) * Complex.I)‖ ^ 2) := by
    funext t
    rw [prime_polynomial_power_exp_log P hP w j t]
  rw [hexp]
  have hm := dirichlet_polynomial_mean_square (primePolynomialSupport P j)
    (primePolynomialCoefficient P w j) N a b hab (prime_polynomial_support_range P hP U hU j N hUN)
  have hc := mul_le_mul_of_nonneg_left (prime_polynomial_coefficients_sq_le_factorial P hP w j)
    (prime_polynomial_mean_square_factor_nonneg N hN a b hab)
  exact hm.trans (by simpa only [mul_assoc] using hc)




theorem prime_polynomial_power_hasDerivAt (P : Finset ℕ)
    (hP : ∀ p ∈ P, Nat.Prime p) (w : P → ℂ) (j : ℕ) (t : ℝ) :
    HasDerivAt
      (fun t : ℝ =>
        (∑ p : P, w p * Complex.exp (((Real.log (p.val : ℝ) * t : ℝ) : ℂ) * Complex.I)) ^ j)
      (∑ n ∈ primePolynomialSupport P j,
        (primePolynomialCoefficient P w j n * ((Real.log (n : ℝ) : ℂ) * Complex.I)) *
          Complex.exp (((Real.log (n : ℝ) * t : ℝ) : ℂ) * Complex.I)) t := by
  have hexp : (fun t : ℝ =>
      (∑ p : P, w p * Complex.exp (((Real.log (p.val : ℝ) * t : ℝ) : ℂ) * Complex.I)) ^ j) =
      (fun t : ℝ => ∑ n ∈ primePolynomialSupport P j, primePolynomialCoefficient P w j n *
        Complex.exp (((Real.log (n : ℝ) * t : ℝ) : ℂ) * Complex.I)) :=
    funext (prime_polynomial_power_exp_log P hP w j)
  rw [hexp]
  exact dirichlet_polynomial_hasDerivAt _ _ t

theorem prime_polynomial_power_derivative_mean_square (P : Finset ℕ)
    (hP : ∀ p ∈ P, Nat.Prime p) (w : P → ℂ)
    (U : ℝ) (hU : ∀ p ∈ P, (p : ℝ) ≤ U) (j N : ℕ)
    (hN : 1 ≤ N) (hUN : U ^ j ≤ (N : ℝ)) (a b : ℝ) (hab : a ≤ b) :
    (∫ t in a..b, ‖∑ n ∈ primePolynomialSupport P j,
      (primePolynomialCoefficient P w j n * ((Real.log (n : ℝ) : ℂ) * Complex.I)) *
        Complex.exp (((Real.log (n : ℝ) * t : ℝ) : ℂ) * Complex.I)‖ ^ 2) ≤
      ((b - a) + 4 * (N : ℝ) * (1 + Real.log N)) * (Real.log N) ^ 2 *
        (j.factorial : ℝ) * (∑ p : P, ‖w p‖ ^ 2) ^ j := by
  have hs := prime_polynomial_support_range P hP U hU j N hUN
  have hm := dirichlet_polynomial_mean_square (primePolynomialSupport P j)
    (fun n => primePolynomialCoefficient P w j n * ((Real.log (n : ℝ) : ℂ) * Complex.I))
    N a b hab hs
  have he := (dirichlet_derivative_coefficient_energy (primePolynomialSupport P j)
    (primePolynomialCoefficient P w j) N hs).trans
    (mul_le_mul_of_nonneg_left (prime_polynomial_coefficients_sq_le_factorial P hP w j)
      (sq_nonneg _))
  exact hm.trans (by simpa only [mul_assoc] using
    mul_le_mul_of_nonneg_left he (prime_polynomial_mean_square_factor_nonneg N hN a b hab))

end Bounty
end

section

/- Supremum energy on an arbitrary finite collection of closed unit intervals. -/

open scoped BigOperators
open Set

namespace Bounty

theorem sparse_dirichlet_unit_interval_suprema (indices : Finset ℤ)
    (support : Finset ℕ) (c : ℕ → ℂ) (N : ℕ) {a b U E : ℝ}
    (hU : 0 ≤ U) (hE : 0 ≤ E)
    (hleft : ∀ j ∈ indices, a ≤ (j : ℝ))
    (hright : ∀ j ∈ indices, (j : ℝ) + 1 ≤ b) (hwidth : b - a ≤ N)
    (hkernel : ∀ z : ℝ, |z| ≤ N →
      ‖∑ n ∈ support, Complex.exp ((Real.log (n : ℝ) * z : ℝ) * Complex.I)‖ ≤
        U / (1 + |z|) + E) :
    (∑ j ∈ indices, unitIntervalEnergySup
      (fun t => ∑ n ∈ support, c n * Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)) j) ≤
      (3 * U * (1 + 2 * (1 + Real.log N)) + (indices.card : ℝ) * E) *
        ∑ n ∈ support, ‖c n‖ ^ 2 := by
  classical
  let F : ℝ → ℂ := fun t => ∑ n ∈ support,
    c n * Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)
  have hF : Continuous F := by dsimp [F]; fun_prop
  choose point hpoint hvalue using exists_unit_interval_energy_max F hF
  have hspan (i : ℤ) (hi : i ∈ indices) (j : ℤ) (hj : j ∈ indices) :
      |point i - point j| ≤ N := by
    have hi0 := (hpoint i).1
    have hi1 := (hpoint i).2
    have hj0 := (hpoint j).1
    have hj1 := (hpoint j).2
    exact abs_le.mpr ⟨by linarith [hleft i hi, hright j hj],
      by linarith [hright i hi, hleft j hj]⟩
  have hclass (r : Fin 3) :
      (∑ j ∈ indices.filter (fun j => unitIntervalResidue j = r), unitIntervalEnergySup F j) ≤
      (U * (1 + 2 * (1 + Real.log N)) +
        ((indices.filter (fun j => unitIntervalResidue j = r)).card : ℝ) * E) *
        ∑ n ∈ support, ‖c n‖ ^ 2 := by
    simp_rw [hvalue]
    exact sparse_dirichlet_polynomial_energy _ point support c N hU hE
      (fun i hi j hj hij => unit_interval_residue_separated (hpoint i) (hpoint j)
        ((Finset.mem_filter.mp hi).2.trans (Finset.mem_filter.mp hj).2.symm) hij)
      (fun i hi j hj => hspan i (Finset.mem_filter.mp hi).1 j (Finset.mem_filter.mp hj).1)
      hkernel
  have hsum := Finset.sum_le_sum (fun r (_ : r ∈ (Finset.univ : Finset (Fin 3))) => hclass r)
  have hcard : (∑ r : Fin 3, ((indices.filter (fun j => unitIntervalResidue j = r)).card : ℝ)) =
      (indices.card : ℝ) := by exact_mod_cast unit_interval_residue_card_sum indices
  have hfiber : (∑ r : Fin 3, ∑ j ∈ indices.filter (fun j => unitIntervalResidue j = r),
      unitIntervalEnergySup F j) = ∑ j ∈ indices, unitIntervalEnergySup F j :=
    Finset.sum_fiberwise_of_maps_to (fun _ _ => Finset.mem_univ _) _
  rw [hfiber, ← Finset.sum_mul, Finset.sum_add_distrib] at hsum
  simp_rw [← Finset.sum_mul] at hsum
  rw [hcard] at hsum
  simpa only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
    Nat.cast_ofNat, mul_assoc] using hsum

end Bounty
end

section

namespace Bounty

theorem affine_logarithmic_phase_hasDerivAt
    (q a u x : ℝ) (hq : 0 < q) (hx : 0 < x+a/q) :
    HasDerivAt (fun y => u * Real.log (q*y+a))
      (logarithmicDerivativeChain u (a/q) 1 x) x := by
  have heq : q*x+a = q*(x+a/q) := by field_simp
  have hpos : 0 < q*x+a := by rw [heq]; positivity
  have h := ((((hasDerivAt_id x).const_mul q).add_const a).log (ne_of_gt hpos)).const_mul u
  simp only [logarithmicDerivativeChain, pow_zero, Nat.factorial_zero, Nat.cast_one,
    mul_one, Nat.zero_add, pow_one]
  simp only [id_eq, mul_one] at h
  apply h.congr_deriv
  rw [heq]
  field_simp

theorem mixed_affine_logarithmic_phase_derivatives
    (hs : List ℝ) (q a u x : ℝ) (hq : 0 < q)
    (hhs : ∀ h ∈ hs, 0 ≤ h) (hx : 0 < x+a/q) :
    HasDerivAt (mixedForwardDifference hs (fun y => u * Real.log (q*y+a)))
      (mixedForwardDifference hs (logarithmicDerivativeChain u (a/q) 1) x) x ∧
    HasDerivAt (mixedForwardDifference hs (logarithmicDerivativeChain u (a/q) 1))
      (mixedForwardDifference hs (logarithmicDerivativeChain u (a/q) 2) x) x := by
  constructor
  · apply mixed_forward_difference_hasDerivAt hs _ _ (-(a/q)) hhs
    · intro y hy
      exact affine_logarithmic_phase_hasDerivAt q a u y hq (by linarith)
    · linarith
  · exact mixed_logarithmic_difference_hasDerivAt hs u (a/q) 1 x hhs hx

end Bounty
end

section

open Finset

namespace Bounty

theorem integer_phase_iterated_van_der_corput
    (A B H : ℤ) (m : ℕ) (T : ℝ) (φ : ℝ → ℝ)
    (hAB : A ≤ B) (hH : 1 ≤ H) (hHN : H ≤ B-A+1) (hT : 0 ≤ T)
    (hterminal : ∀ hs : List ℤ, hs.length = m →
      (∀ h ∈ hs, 1 ≤ h ∧ h < H) →
      ∀ a b : ℤ, A ≤ a → b ≤ B →
      ‖∑ n ∈ Icc a b, Complex.exp
        ((mixedForwardDifference (hs.map (fun h : ℤ => (h:ℝ))) φ (n:ℝ):ℂ)*Complex.I)‖ ≤
        ((B-A+1:ℤ):ℝ)*T) :
    ∀ a b : ℤ, A ≤ a → b ≤ B →
      ‖∑ n ∈ Icc a b, Complex.exp ((φ (n:ℝ):ℂ)*Complex.I)‖ ≤
        ((B-A+1:ℤ):ℝ)*vanDerCorputScalarBound (H:ℝ) T m := by
  induction m generalizing φ with
  | zero =>
    intro a b ha hb
    simpa only [List.length_nil, List.map_nil, mixedForwardDifference,
      vanDerCorputScalarBound] using hterminal [] rfl (by simp) a b ha hb
  | succ m ih =>
    intro a b ha hb
    let N : ℝ := ((B-A+1:ℤ):ℝ)
    let V : ℝ := vanDerCorputScalarBound (H:ℝ) T m
    have hN : 0 < N := by dsimp only [N]; exact_mod_cast (by omega : 0 < B-A+1)
    have hHr : 0 < (H:ℝ) := by exact_mod_cast (by omega : 0 < H)
    have hV : 0 ≤ V := van_der_corput_scalar_bound_nonneg _ _ hT _
    have hdiff (h : ℤ) (hh : h ∈ Icc (1:ℤ) (H-1)) :
        ‖∑ n ∈ Icc a (b-h), Complex.exp
          (((φ ((n:ℝ)+(h:ℝ))-φ (n:ℝ)):ℂ)*Complex.I)‖ ≤ N*V := by
      simp only [← Complex.ofReal_sub]
      apply ih (φ := fun x => φ (x+(h:ℝ))-φ x)
      · intro hs hlen hshifts c d hc hd
        have hlen' : (hs++[h]).length = m+1 := by simp [hlen]
        have hshifts' : ∀ k ∈ hs++[h], 1 ≤ k ∧ k < H := by
          intro k hk
          rcases List.mem_append.mp hk with hk | hk
          · exact hshifts k hk
          · have heq : k = h := by simpa using hk
            subst k
            have hh' := mem_Icc.mp hh
            omega
        have he := hterminal (hs++[h]) hlen' hshifts' c d hc hd
        simpa only [List.map_append, List.map_cons, List.map_nil,
          mixed_forward_difference_append, mixedForwardDifference] using he
      · exact ha
      · have hh' := mem_Icc.mp hh
        omega
    have hsumbound :
        (∑ h ∈ Icc (1:ℤ) (H-1), ‖∑ n ∈ Icc a (b-h), Complex.exp
          (((φ ((n:ℝ)+(h:ℝ))-φ (n:ℝ)):ℂ)*Complex.I)‖) ≤ (H:ℝ)*(N*V) := by
      calc
        _ ≤ ∑ _h ∈ Icc (1:ℤ) (H-1), N*V := sum_le_sum hdiff
        _ = ((H:ℝ)-1)*(N*V) := by
          rw [sum_const, nsmul_eq_mul]
          congr 1
          have hc := Int.card_Icc_of_le (a := 1) (b := H-1) (by omega)
          have heq : H-1+1-1 = H-1 := by ring
          rw [heq] at hc
          exact_mod_cast hc
        _ ≤ (H:ℝ)*(N*V) := by nlinarith
    have hvdc := integer_phase_van_der_corput_subinterval A B a b H φ hAB ha hb hH hHN
    have hsq : ‖∑ n ∈ Icc a b, Complex.exp ((φ (n:ℝ):ℂ)*Complex.I)‖^2 ≤
        N^2*(2/(H:ℝ)+4*V) := by
      calc
        _ ≤ 2*N^2/(H:ℝ)+(4*N/(H:ℝ))*((H:ℝ)*(N*V)) :=
          hvdc.trans (add_le_add le_rfl (mul_le_mul_of_nonneg_left hsumbound (by positivity)))
        _ = _ := by field_simp
    have hbase : 0 ≤ 2/(H:ℝ)+4*V := by positivity
    have hsqrt : (N*Real.sqrt (2/(H:ℝ)+4*V))^2 = N^2*(2/(H:ℝ)+4*V) := by
      rw [mul_pow, Real.sq_sqrt hbase]
    have hnonneg : 0 ≤ N*Real.sqrt (2/(H:ℝ)+4*V) := by positivity
    change _ ≤ N*Real.sqrt (2/(H:ℝ)+4*V)
    nlinarith [norm_nonneg (∑ n ∈ Icc a b, Complex.exp ((φ (n:ℝ):ℂ)*Complex.I))]

end Bounty
end

section

/- Prime divisibility after removing the actual shared product. -/

open Finset

namespace Bounty

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (C : G → Finset (Fin J))
  (L : PhysicalMarkLists P J ell)
  (hprime : ∀ g p, p ∈ P g → p.Prime)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (p : PhysicalPrime P)

include G sharedInstance1 P J ell C L hprime hdis p

theorem physical_prime_dvd_shared_factor  :
    p.2.val ∣ physicalSharedFactor C L ↔ p ∈ physicalSharedPrimes C L := by
  classical
  have hp := hprime p.1 _ p.2.property
  constructor
  · intro hd
    obtain ⟨a, _, ha⟩ := (hp.prime.dvd_finsetProd_iff _).mp hd
    have he : p.2.val = (L a.1 (Sum.inl a.2.val)).val :=
      ((Nat.dvd_prime (hprime a.1 _ (L a.1 (Sum.inl a.2.val)).property)).mp ha).resolve_left hp.ne_one
    have htag : p = ⟨a.1, L a.1 (Sum.inl a.2.val)⟩ :=
      physical_prime_value_injective hdis he
    rw [htag, mem_physical_shared_primes]
    exact ⟨Sum.inl a.2.val,
      (physical_mem_shared_slots_iff _ _).mpr ⟨a.2.val, (mem_sdiff.mp a.2.property).2, rfl⟩, rfl⟩
  · intro hm
    obtain ⟨s, hs, he⟩ := (mem_physical_shared_primes C L p).mp hm
    obtain ⟨j, hj, rfl⟩ := (physical_mem_shared_slots_iff _ _).mp hs
    rw [← he]
    exact dvd_prod_of_mem (fun a : PhysicalSharedIndex C => (L a.1 (Sum.inl a.2.val)).val)
      (mem_univ ⟨p.1, ⟨j, mem_sdiff.mpr ⟨mem_univ _, hj⟩⟩⟩)

theorem physical_prime_dvd_shared_mul  (w : ℤ) :
    (p.2.val : ℤ) ∣ (physicalSharedFactor C L : ℤ) * w ↔
      p ∈ physicalSharedPrimes C L ∨ (p.2.val : ℤ) ∣ w := by
  rw [(Nat.prime_iff_prime_int.mp (hprime p.1 _ p.2.property)).dvd_mul,
    Int.natCast_dvd_natCast, physical_prime_dvd_shared_factor C L hprime hdis]

end


end Bounty
end

section

/- Extracted prime sums as literal four-factor divisor convolutions. -/

open Finset

namespace Bounty

noncomputable def endpointFourConvolution (δ α β γ : ℕ → ℂ) (n : ℕ) : ℂ :=
  ∑ d ∈ n.divisors, δ d * endpointTripleConvolution α β γ (n / d)

theorem prime_sum_eq_divisor_convolution (S : Finset ℕ) (δ f : ℕ → ℂ)
    {n : ℕ} (hn : n ≠ 0) :
    (∑ p ∈ S, if p ∣ n then δ p * f (n / p) else 0) =
      ∑ p ∈ n.divisors, (if p ∈ S then δ p else 0) * f (n / p) := by
  classical
  have hs : S.filter (fun p => p ∣ n) = n.divisors.filter (fun p => p ∈ S) := by
    ext p
    constructor
    · intro h
      obtain ⟨hp, hd⟩ := mem_filter.mp h
      exact mem_filter.mpr ⟨Nat.mem_divisors.mpr ⟨hd, hn⟩, hp⟩
    · intro h
      obtain ⟨hd, hp⟩ := mem_filter.mp h
      exact mem_filter.mpr ⟨hp, (Nat.mem_divisors.mp hd).1⟩
  rw [← sum_filter, hs, sum_filter]
  simp only [ite_mul, zero_mul]

theorem prime_peel_weighted_triple_convolution (S Q : Finset ℕ) (δ W α β γ : ℕ → ℂ)
    (hW : ∀ a d : ℕ, d ≠ 0 → Disjoint d.primeFactors Q → W (a * d) = W a)
    (hα : ∀ d, ¬ Disjoint d.primeFactors Q → α d = 0)
    (hβ : ∀ d, ¬ Disjoint d.primeFactors Q → β d = 0)
    {n : ℕ} (hn : n ≠ 0) :
    (∑ p ∈ S, if p ∣ n then δ p *
      (W (n / p) * invariantTripleEndpoint Q α β γ (n / p)) else 0) =
      endpointFourConvolution (fun p => if p ∈ S then δ p else 0) α β
        (fun r => W r * γ (primePoolFreePart Q r)) n := by
  classical
  unfold endpointFourConvolution
  rw [← prime_sum_eq_divisor_convolution S δ _ hn]
  apply sum_congr rfl
  intro p _
  by_cases hp : p ∣ n
  · rw [if_pos hp, if_pos hp]
    congr 1
    apply weighted_invariant_triple_convolution Q W α β γ hW hα hβ
    intro hz
    have he := Nat.mul_div_cancel' hp
    rw [hz, mul_zero] at he
    exact hn he.symm
  · rw [if_neg hp, if_neg hp]

end Bounty
end

section

/- The actual prime-polynomial exceptional set is measurable and covered
by exactly the occupied unit intervals used in its counting theorem. -/

open Finset Set MeasureTheory
open scoped Classical

namespace Bounty

theorem prime_exceptional_times_measurable (s : Finset ℕ) (coeff : s → ℂ)
    (η R : ℝ) : MeasurableSet (primeExceptionalTimes s coeff η R) := by
  have hp : Continuous (primeReciprocalPolynomial s coeff) := by
    unfold primeReciprocalPolynomial
    fun_prop
  exact (isClosed_le continuous_abs continuous_const).measurableSet.inter
    (isOpen_lt continuous_const hp.norm).measurableSet

theorem prime_exceptional_times_covered (s : Finset ℕ) (coeff : s → ℂ)
    (η R : ℝ) :
    ∀ t ∈ primeExceptionalTimes s coeff η R,
      ∃ j ∈ primeExceptionalIntervals s coeff η R,
        t ∈ Icc (j : ℝ) ((j : ℝ) + 1) := by
  intro t ht
  have hunit : t ∈ Icc ((⌊t⌋ : ℤ) : ℝ) (((⌊t⌋ : ℤ) : ℝ) + 1) :=
    ⟨Int.floor_le t, (Int.lt_floor_add_one t).le⟩
  refine ⟨⌊t⌋, ?_, hunit⟩
  exact (mem_primeExceptionalIntervals s coeff η R ⌊t⌋).mpr ⟨t, hunit, ht⟩




theorem prime_exceptional_integral_le_unit_suprema (s : Finset ℕ) (coeff : s → ℂ)
    (η R : ℝ) (F : ℝ → ℂ) (hF : Continuous F) :
    (∫ t in primeExceptionalTimes s coeff η R, ‖F t‖ ^ 2) ≤
      ∑ j ∈ primeExceptionalIntervals s coeff η R, unitIntervalEnergySup F j :=
  exceptional_integral_le_unit_suprema (primeExceptionalIntervals s coeff η R)
    (primeExceptionalTimes s coeff η R) (prime_exceptional_times_measurable s coeff η R)
    F hF (prime_exceptional_times_covered s coeff η R)

end Bounty
end

section

/- A global norm bound for the literal reciprocal prime polynomial. -/

open Finset

namespace Bounty

theorem prime_reciprocal_polynomial_norm_le (s : Finset ℕ) (coeff : s → ℂ)
    {P B : ℝ} (hP : 1 ≤ P) (hB : 0 ≤ B)
    (hband : ∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P)
    (hcoeff : ∀ p : s, ‖coeff p‖ ≤ B) (t : ℝ) :
    ‖primeReciprocalPolynomial s coeff t‖ ≤ 2 * B := by
  have hP0 : 0 < P := zero_lt_one.trans_le hP
  unfold primeReciprocalPolynomial
  calc
    _ ≤ ∑ p : s, ‖(coeff p / (p.val : ℂ)) *
        Complex.exp (((Real.log (p.val : ℝ) * t : ℝ) : ℂ) * Complex.I)‖ := norm_sum_le _ _
    _ ≤ ∑ _p : s, B / P := by
      apply Finset.sum_le_sum
      intro p _
      rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one, norm_div, Complex.norm_natCast]
      exact div_le_div₀ hB (hcoeff p) hP0 (hband p.val p.property).1
    _ = (s.card : ℝ) * (B / P) := by simp
    _ ≤ (2 * P) * (B / P) :=
      mul_le_mul_of_nonneg_right (nat_dyadic_card_le s P hP hband) (div_nonneg hB hP0.le)
    _ = 2 * B := by field_simp

end Bounty
end

