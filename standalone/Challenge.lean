  funext x
  simp only [finite_product_event_sum, finite_product_event_const_mul,
    finite_local_event_finset_sum, finite_local_event_finset_const_mul]
  apply sum_congr rfl
  intro y _
  rw [finite_product_event_tensor E weight target
      (fun i a => if a = y i then (1 : ℂ) else 0) x,
    finite_local_event_univ_prod E weight target
      (fun i a => if a = y i then (1 : ℂ) else 0) x]
