theorem eventually_candidate_cross_scale_below_cutoff {b K : ℝ}
    (hb : 0 < b) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop, ∀ U V E Z : ℝ,
      exp (b*L) ≤ U → U ≤ exp L → exp (b*L) ≤ V → V ≤ exp L →
      E = U*L^(-K) → 0 < Z → Z ≤ 24*U^2*V*L^88/E →
      3*Z < exp (4*L) := by
  filter_upwards [eventually_typeII_actual_dyadic_geometry hb hK,
    eventually_ge_atTop (log 3+1)] with L hgeo hL
  intro U V E Z hUlo hUhi hVlo hVhi hE hZ hZupper
  obtain ⟨hU, hV, hE0, _, _, _, _, hlog, _⟩ :=
    hgeo U V E hUlo hUhi hVlo hVhi hE
  have hlogZ : log Z ≤ 3*L := (log_le_log hZ hZupper).trans hlog
  have hZexp : Z ≤ exp (3*L) := by
    calc
      Z = exp (log Z) := (exp_log hZ).symm
      _ ≤ exp (3*L) := exp_le_exp.mpr hlogZ
  have hthree : 3 < exp L := (log_lt_iff_lt_exp (by norm_num)).mp (by linarith)
  calc
    3*Z ≤ 3*exp (3*L) := mul_le_mul_of_nonneg_left hZexp (by norm_num)
    _ < exp L*exp (3*L) := mul_lt_mul_of_pos_right hthree (exp_pos _)
    _ = exp (4*L) := by rw [← exp_add]; congr 1; ring

end Bounty
