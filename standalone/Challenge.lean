    (fun n=>W ((n:ℝ)/Z))
  change _=(∑n∈Finset.Icc 1 D,weightedCoeff χ S n*W ((n:ℝ)/Z)) at he
  rw [←he] at hh
  convert hh using 1
  apply Finset.sum_congr rfl
  intro I hI
  dsimp only [weightedMoebius]
