/- Exact conditional marked-list averages for both stripped endpoints. -/

open Finset
open scoped Classical
namespace Bounty

theorem group_marked_average_mul_left {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ)
    (c : ℂ) (b : GroupMarkedLists P t → ℂ) :
    groupMarkedAverage P t n (fun L => c * b L) =
      c * groupMarkedAverage P t n b := by
  unfold groupMarkedAverage
  rw [← mul_sum]
  ring

theorem completion_marked_pair_sum_eq_average {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (q : ℝ) (V : G → ℝ) (w z : ℤ)
    (b : GroupMarkedLists P (fun g => ell + (C g).card) →
      GroupMarkedLists P (fun g => ell + (C g).card) → ℂ) :
    (physicalCompletionMass V C ell : ℂ) ^ 2 *
      (∑ u : GroupMarkedLists P (fun g => ell + (C g).card),
      ∑ v : GroupMarkedLists P (fun g => ell + (C g).card),
        (groupMarkedVertexWeight P q (fun g => ell + (C g).card) w u : ℂ) *
        (groupMarkedVertexWeight P q (fun g => ell + (C g).card) z v : ℂ) * b u v) =
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) w : ℂ) *
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) z : ℂ) *
      groupMarkedAverage P (fun g => ell + (C g).card) w
        (fun u => groupMarkedAverage P (fun g => ell + (C g).card) z (b u)) := by
  calc
    _ = (physicalCompletionMass V C ell : ℂ) *
        ∑ u : GroupMarkedLists P (fun g => ell + (C g).card),
          (groupMarkedVertexWeight P q (fun g => ell + (C g).card) w u : ℂ) *
          ((physicalCompletionMass V C ell : ℂ) *
            ∑ v : GroupMarkedLists P (fun g => ell + (C g).card),
              (groupMarkedVertexWeight P q (fun g => ell + (C g).card) z v : ℂ) * b u v) := by
      simp only [mul_sum]
      apply sum_congr rfl
      intro u _
      apply sum_congr rfl
      intro v _
      ring
    _ = (physicalCompletionMass V C ell : ℂ) *
        ∑ u : GroupMarkedLists P (fun g => ell + (C g).card),
          (groupMarkedVertexWeight P q (fun g => ell + (C g).card) w u : ℂ) *
          ((markedDivisorWeight univ P q V (fun g => ell + (C g).card) z : ℂ) *
            groupMarkedAverage P (fun g => ell + (C g).card) z (b u)) := by
      simp only [completion_marked_vertex_sum_eq_average]
    _ = _ := by
      rw [completion_marked_vertex_sum_eq_average, group_marked_average_mul_left]
      ring

end Bounty
end

section

/- The original compatible-completion restriction and auxiliary ban use the
same quantitative shared-draw exclusion estimate on the actual divisor fibers. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_cut_shared_constant_error {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime) (V : G → ℝ)
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (u v : GroupMarkedLists P (fun g => ell + (C g).card))
    (aux : PhysicalAuxLabels P C) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    (hu : ∀ g i, (u g i).val ∣ w) (hv : ∀ g i, (v g i).val ∣ z)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (c : ℂ) :
    ‖(∑ s : PhysicalAuxLabels P (fun g => univ \ C g),
      if physicalRawCutGood C u v s then
        if ∀ g j, s g j ∉ physicalSharedForbidden C aux g w z
          then (physicalAuxMass V (fun g => univ \ C g) s : ℂ) * c else 0
      else 0) - c‖ ≤
      (∑ g, (J - (C g).card : ℕ) *
        (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)) * ‖c‖ := by
  rw [physical_cut_avoiding_mean_eq_shared_good_mean C hprime u v aux hw hz hu hv]
  exact (by
    have he := finite_constant_restriction_error
      (S := PhysicalAuxLabels P (fun g => univ \ C g))
      (fun s => physicalAuxMass V (fun g => univ \ C g) s)
      (fun s => physical_aux_mass_nonneg V _ (fun g => (hV g).le) s)
      (physical_aux_mass_sum V _ hV hMass)
      (physicalSharedDrawGood C (fun g => physicalSharedForbidden C aux g w z)) c
    rw [he]
    apply mul_le_mul_of_nonneg_right _ (norm_nonneg c)
    refine le_trans ?_ (physical_shared_draw_endpoint_bad_mass V C hV hMass aux hw hz hPmin hp)
    apply le_of_eq
    apply sum_congr rfl
    intro s _
    by_cases hs : ¬physicalSharedDrawGood C (fun g => physicalSharedForbidden C aux g w z) s
    · simp only [if_pos hs]
    · simp only [if_neg hs]
  )

theorem group_marked_average_sub {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (n : ℤ) (a b : GroupMarkedLists P t → ℂ) :
    groupMarkedAverage P t n (fun L => a L - b L) =
      groupMarkedAverage P t n a - groupMarkedAverage P t n b := by
  unfold groupMarkedAverage
  rw [sum_sub_distrib, mul_sub]

theorem group_marked_pair_average_norm_le {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (t : G → ℕ) (w z : ℤ)
    (b : GroupMarkedLists P t → GroupMarkedLists P t → ℂ)
    {H : ℝ} (hH : 0 ≤ H)
    (hb : ∀ (u : GroupMarkedListsAt P t w) (v : GroupMarkedListsAt P t z),
      ‖b u.val v.val‖ ≤ H) :
    ‖groupMarkedAverage P t w (fun u => groupMarkedAverage P t z (b u))‖ ≤ H := by
  apply group_marked_average_norm_le P t w _ hH
  intro u
  exact group_marked_average_norm_le P t z (b u.val) hH (hb u)

end Bounty
