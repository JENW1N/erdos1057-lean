namespace Bounty
section Paths
variable {S G I V K : Type} [Fintype S] [Fintype G] [DecidableEq G]
  [Fintype I] {Ps : S → Finset ℕ} {P : G → Type} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {J ell : ℕ} {M : G → ℕ}
  (shared : I → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : I → Type) [∀ i, Fintype (A i)]
  (Δ D : ∀ _k : K, ∀ i, PhysicalSharedLists Ps J → SharedActiveLabels P (shared i) → A i → G → ℤ)
  (kbig : ∀ _k : K, ∀ i, SharedActiveLabels P (shared i) → A i → ℤ)
  (ω : ∀ i, SharedActiveLabels P (shared i) → A i → ℝ)
  (μ : ∀ g, P g → ℝ) (qghost : V → ℝ) (ρ : ℝ) (Vb : G → ℝ)
  (Vs : S → ℝ) (qedge : K → ℝ)
  (phase : ∀ tag s, PhysicalMixedWordEvent (ell := ell) n shared B A Δ D tag s → ℂ)


noncomputable def physicalMixedWordPathAction (steps : List (Option (V ⊕ K)))
    (pathPhase : ∀ s, FiniteEventPath (PhysicalMixedWordEvent (ell := ell) n shared B A Δ D)
      (physicalMixedWordTarget n shared B A Δ D kbig) steps s → ℂ)
    (F : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B → ℂ) :=
  let _ : ∀ tag s, Fintype (PhysicalMixedWordEvent (V := V) (ell := ell) n shared B A Δ D tag s) :=
    physicalMixedWordEventFintype n shared B A Δ D
  finiteEventPathAction (PhysicalMixedWordEvent (ell := ell) n shared B A Δ D)
    (physicalMixedWordTarget n shared B A Δ D kbig)
    (physicalMixedWordWeight n shared B A Δ D kbig ω μ qghost ρ Vb Vs qedge) steps pathPhase F

theorem physical_mixed_word_eq_paths (steps : List (Option (V ⊕ K)))
    (F : PhysicalMixedWordState (Ps := Ps) (J := J) (ell := ell) (M := M) n B → ℂ) :
    finiteOperatorListAction
      (physicalMixedWordRow n shared B A Δ D kbig ω μ qghost ρ Vb Vs qedge phase) steps F =
    physicalMixedWordPathAction n shared B A Δ D kbig ω μ qghost ρ Vb Vs qedge steps
      (finiteEventLocalPhase (PhysicalMixedWordEvent (ell := ell) n shared B A Δ D)
        (physicalMixedWordTarget n shared B A Δ D kbig) phase steps) F := by
  let _ : ∀ tag s, Fintype (PhysicalMixedWordEvent (V := V) (ell := ell) n shared B A Δ D tag s) :=
    physicalMixedWordEventFintype n shared B A Δ D
  exact finite_phased_rows_eq_event_paths _ _ _ _ steps F

end Paths
