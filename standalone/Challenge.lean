open Finset

namespace Bounty

theorem integer_Icc_sum_as_nat_Icc (g : ℤ → ℂ) (a b : ℤ) (hab : a ≤ b) :
    ∑ n ∈ Icc a b, g n = ∑ n ∈ Icc 0 (b-a).toNat, g (a+(n:ℤ)) := by
  symm
  apply sum_bij (fun (n : ℕ) _ => a+(n:ℤ))
  · intro n hn
    have hn' := mem_Icc.mp hn
    rw [mem_Icc]
    omega
  · intro n hn m hm he
    omega
  · intro z hz
    have hz' := mem_Icc.mp hz
    refine ⟨(z-a).toNat, ?_, ?_⟩
    · rw [mem_Icc]
      omega
    · omega
  · intro n hn
    rfl

theorem integer_second_derivative_sum_bound
    {f f' f'' : ℝ → ℝ} {a b : ℤ} {lam A : ℝ}
    (hab : a ≤ b) (hlam : 0 < lam) (hA : 1 ≤ A)
    (hf : ∀ x ∈ Set.Icc (a:ℝ) ((b:ℝ)+1), HasDerivAt f (f' x) x)
    (hf' : ∀ x ∈ Set.Icc (a:ℝ) ((b:ℝ)+1), HasDerivAt f' (f'' x) x)
    (hb : ∀ x ∈ Set.Icc (a:ℝ) ((b:ℝ)+1), lam ≤ f'' x ∧ f'' x ≤ A*lam) :
    ‖∑ n ∈ Icc a b, realUnitPhase (f (n:ℝ))‖ ≤
      6*(A*((b:ℝ)-a+1)*Real.sqrt lam+2/Real.sqrt lam) := by
  have hD : ((b-a).toNat:ℝ) = (b:ℝ)-a := by
    exact_mod_cast Int.toNat_of_nonneg (show 0 ≤ b-a by omega)
  have hm (x : ℝ) (hx : x ∈ Set.Icc (0:ℝ) (((b-a).toNat:ℝ)+1)) :
      (a:ℝ)+x ∈ Set.Icc (a:ℝ) ((b:ℝ)+1) := by
    rw [hD] at hx
    constructor <;> linarith [hx.1,hx.2]
  have hbound := second_derivative_sum_bound
    (f := fun x => f ((a:ℝ)+x)) (f' := fun x => f' ((a:ℝ)+x))
    (f'' := fun x => f'' ((a:ℝ)+x)) (a := 0) (b := (b-a).toNat)
    (Nat.zero_le _) hlam hA
    (fun x hx => by
      simpa only [Function.comp_def, id_eq, mul_one] using
        (hf _ (hm x (by simpa only [Nat.cast_zero] using hx))).comp x ((hasDerivAt_id x).const_add (a:ℝ)))
    (fun x hx => by
      simpa only [Function.comp_def, id_eq, mul_one] using
        (hf' _ (hm x (by simpa only [Nat.cast_zero] using hx))).comp x ((hasDerivAt_id x).const_add (a:ℝ)))
    (fun x hx => hb _ (hm x (by simpa only [Nat.cast_zero] using hx)))
  rw [integer_Icc_sum_as_nat_Icc _ a b hab]
  simpa only [Int.cast_add, Int.cast_natCast, Nat.cast_zero, sub_zero, hD] using hbound

theorem integer_second_derivative_sum_bound_negative
    {f f' f'' : ℝ → ℝ} {a b : ℤ} {lam A : ℝ}
    (hab : a ≤ b) (hlam : 0 < lam) (hA : 1 ≤ A)
    (hf : ∀ x ∈ Set.Icc (a:ℝ) ((b:ℝ)+1), HasDerivAt f (f' x) x)
    (hf' : ∀ x ∈ Set.Icc (a:ℝ) ((b:ℝ)+1), HasDerivAt f' (f'' x) x)
    (hb : ∀ x ∈ Set.Icc (a:ℝ) ((b:ℝ)+1), -A*lam ≤ f'' x ∧ f'' x ≤ -lam) :
    ‖∑ n ∈ Icc a b, realUnitPhase (f (n:ℝ))‖ ≤
      6*(A*((b:ℝ)-a+1)*Real.sqrt lam+2/Real.sqrt lam) := by
  have hD : ((b-a).toNat:ℝ) = (b:ℝ)-a := by
    exact_mod_cast Int.toNat_of_nonneg (show 0 ≤ b-a by omega)
  have hm (x : ℝ) (hx : x ∈ Set.Icc (0:ℝ) (((b-a).toNat:ℝ)+1)) :
      (a:ℝ)+x ∈ Set.Icc (a:ℝ) ((b:ℝ)+1) := by
    rw [hD] at hx
    constructor <;> linarith [hx.1,hx.2]
  have hbound := second_derivative_sum_bound_negative
    (f := fun x => f ((a:ℝ)+x)) (f' := fun x => f' ((a:ℝ)+x))
    (f'' := fun x => f'' ((a:ℝ)+x)) (a := 0) (b := (b-a).toNat)
    (Nat.zero_le _) hlam hA
    (fun x hx => by
      simpa only [Function.comp_def, id_eq, mul_one] using
        (hf _ (hm x (by simpa only [Nat.cast_zero] using hx))).comp x ((hasDerivAt_id x).const_add (a:ℝ)))
    (fun x hx => by
      simpa only [Function.comp_def, id_eq, mul_one] using
        (hf' _ (hm x (by simpa only [Nat.cast_zero] using hx))).comp x ((hasDerivAt_id x).const_add (a:ℝ)))
    (fun x hx => hb _ (hm x (by simpa only [Nat.cast_zero] using hx)))
  rw [integer_Icc_sum_as_nat_Icc _ a b hab]
  simpa only [Int.cast_add, Int.cast_natCast, Nat.cast_zero, sub_zero, hD] using hbound

end Bounty
end

section

/- The exact shared-prime overlap correction to the stripped vertex weight. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalUnsharedVertex {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ℝ) (w : ℤ) : ℝ :=
  finiteMarkedVertex (physicalMarkedPrimes L \ physicalSharedPrimes C L)
    (fun p : PhysicalPrime P => (p.2.val : ℤ) ∣ w) q

noncomputable def physicalSharedOverlap {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ℝ) (w : ℤ) : ℝ :=
  ∏ p ∈ physicalSharedPrimes C L, if (p.2.val : ℤ) ∣ w then q else 1

theorem physical_shared_vertex_removal {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (q : ℝ) (w : ℤ) :
    physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * w) *
        physicalSharedOverlap C L q w = physicalUnsharedVertex C L q w := by
  rw [physical_vertex_weight_as_finite]
  have h := finite_shared_vertex_removal (physicalMarkedPrimes L) (physicalSharedPrimes C L)
    (fun p : PhysicalPrime P => (p.2.val : ℤ) ∣ w)
    (fun p : PhysicalPrime P => (p.2.val : ℤ) ∣ (physicalSharedFactor C L : ℤ) * w)
    q (physical_shared_primes_subset_marked C L)
    (fun p => physical_prime_dvd_shared_mul C L hprime hdis p w)
  unfold physicalSharedOverlap physicalUnsharedVertex
  convert h using 1
  · congr 1
    apply prod_congr rfl
    intro p _
    split_ifs <;> rfl
  · apply congrArg (fun s => finiteMarkedVertex s
      (fun p : PhysicalPrime P => (p.2.val : ℤ) ∣ w) q)
    ext p
    simp only [mem_sdiff]

theorem physical_shared_overlap_eq_one {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ℝ) (w : ℤ)
    (havoid : ∀ p ∈ physicalSharedPrimes C L, ¬(p.2.val : ℤ) ∣ w) :
    physicalSharedOverlap C L q w = 1 := by
  exact prod_eq_one (fun p hp => if_neg (havoid p hp))




theorem physical_shared_factor_eq_of_compatible {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    {L R : PhysicalMarkLists P J ell} (hshared : physicalSharedCompatible C L R) :
    physicalSharedFactor C L = physicalSharedFactor C R := by
  apply prod_congr rfl
  intro a _
  rw [hshared a.1 a.2.val (mem_sdiff.mp a.2.property).2]

theorem physical_shared_vertex_pair_removal {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L R : PhysicalMarkLists P J ell) (hshared : physicalSharedCompatible C L R)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h))) (q : ℝ) (w z : ℤ) :
    (physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * w) *
      physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) * z)) *
      (physicalSharedOverlap C L q w * physicalSharedOverlap C L q z) =
        physicalUnsharedVertex C L q w * physicalUnsharedVertex C R q z := by
  have hR : physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) * z) *
      physicalSharedOverlap C L q z = physicalUnsharedVertex C R q z := by
    rw [physical_shared_factor_eq_of_compatible C hshared]
    simpa only [physicalSharedOverlap, physical_shared_primes_eq_of_compatible C hshared] using
      physical_shared_vertex_removal C R hprime hdis q z
  calc
    _ = (physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * w) *
          physicalSharedOverlap C L q w) *
        (physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) * z) *
          physicalSharedOverlap C L q z) := by ring
    _ = _ := by rw [physical_shared_vertex_removal C L hprime hdis q w, hR]




end Bounty
end

section

/- Weighted support, rather than closure of all quotients, removes a finite endpoint mask. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

theorem typeII_weighted_direct_endpoint_support
    (M H : Finset ℕ) (A B : ℕ → ℂ) (W : ℕ → ℝ) (t : ℝ) {v : ℕ}
    (hv : 0 < v) (hM : ∀ m ∈ M, 0 < m)
    (hW : ∀ m ∈ M, ∀ h : ℕ, 0 < h → W (m*h)=W h)
    (hsupport : ∀ h : ℕ, 0 < h → h ∉ H → (W h:ℂ)*B h=0) :
    typeIIDirectEndpoint M H A B t v * (W v:ℂ) =
      typeIIDirectEndpoint M (Icc 1 v) A B t v * (W v:ℂ) := by
  classical
  rw [typeII_direct_endpoint_eq_divisor_mask M H A B t v hM,
    typeII_direct_endpoint_eq_divisor_mask M (Icc 1 v) A B t v hM, sum_mul, sum_mul]
  apply sum_congr rfl
  intro m hm
  by_cases hd : m ∣ v
  · have hq := reconstructed_factor_mem_Icc hv hd (le_refl v)
    have hqpos : 0 < v/m := (mem_Icc.mp hq).1
    simp only [hd, true_and, hq, if_true]
    by_cases hh : v/m ∈ H
    · simp only [hh, if_true]
    · simp only [hh, if_false, zero_mul]
      have hWv : W v = W (v/m) := by
        calc
          _ = W (m*(v/m)) := congrArg W (Nat.mul_div_cancel' hd).symm
          _ = _ := hW m hm (v/m) hqpos
      have hz := congrArg (fun z : ℂ => conj z) (hsupport (v/m) hqpos hh)
      simp only [map_mul, Complex.conj_ofReal, map_zero] at hz
      rw [hWv]
      linear_combination -(A m * typeIIPhase t m) * hz
  · simp only [hd, false_and, if_false]

theorem typeII_weighted_rough_endpoint_support
    (P M H R C : Finset ℕ) (A c : ℕ → ℂ) (W : ℕ → ℝ) (t σ : ℝ) {v : ℕ}
    (hv : 0 < v) (hM : ∀ m ∈ M, 0 < m)
    (hfree : ∀ m ∈ M, Disjoint m.primeFactors P)
    (hW : ∀ m ∈ M, ∀ h : ℕ, 0 < h → W (m*h)=W h)
    (hsupport : ∀ h : ℕ, 0 < h → h ∉ H →
      (W h:ℂ)*typeIIRoughConvolution R C σ c (primePoolFreePart P h)=0) :
    typeIIDirectEndpoint M H A
      (fun h => typeIIRoughConvolution R C σ c (primePoolFreePart P h)) t v * (W v:ℂ) =
      typeIIInvariantEndpoint P M R C A c t σ v * (W v:ℂ) := by
  rw [typeII_weighted_direct_endpoint_support M H A _ W t hv hM hW hsupport,
    typeII_direct_rough_endpoint_eq_invariant_of_complete P M (Icc 1 v) R C A c t σ
      hv hM hfree (fun m _ hd => reconstructed_factor_mem_Icc hv hd (le_refl v))]
  rfl

theorem typeII_cross_pair_eq_invariant_of_weighted_support
    (P M H R C : Finset ℕ) (A c : ℕ → ℂ) (W : ℕ → ℝ)
    (ρ σ ξ₁ ξ₂ ξ₃ : ℝ) {z w : ℕ} (hz : 0 < z) (hw : 0 < w)
    (hM : ∀ m ∈ M, 0 < m) (hH : ∀ h ∈ H, 0 < h)
    (hfree : ∀ m ∈ M, Disjoint m.primeFactors P)
    (hW : ∀ m ∈ M, ∀ h : ℕ, 0 < h → W (m*h)=W h)
    (hsupport : ∀ h : ℕ, 0 < h → h ∉ H →
      (W h:ℂ)*typeIIRoughConvolution R C σ c (primePoolFreePart P h)=0) :
    typeIICrossPairCoefficient M H A W
      (fun h => typeIIRoughConvolution R C σ c (primePoolFreePart P h)) ρ ξ₁ ξ₂ ξ₃ z w =
      typeIIPhase (ρ+ξ₃) z * typeIIPhase (-ρ) w *
        conj (typeIIInvariantEndpoint P M R C A c (ρ-ξ₂) σ z) *
        typeIIInvariantEndpoint P M R C A c (ξ₁+ρ) σ w * (W z:ℂ) * (W w:ℂ) := by
  rw [typeII_cross_pair_coefficient_factorization M H A W _ ρ ξ₁ ξ₂ ξ₃ z w hM hH
    (fun m hm h hh => hW m hm h (hH h hh))]
  have hz' := typeII_weighted_rough_endpoint_support P M H R C A c W (ρ-ξ₂) σ hz hM hfree hW hsupport
  have hw' := typeII_weighted_rough_endpoint_support P M H R C A c W (ξ₁+ρ) σ hw hM hfree hW hsupport
  have hzc := congrArg (fun x : ℂ => conj x) hz'
  simp only [map_mul, Complex.conj_ofReal] at hzc
  calc
    _ = (typeIIPhase (ρ+ξ₃) z * typeIIPhase (-ρ) w) *
      (conj (typeIIDirectEndpoint M H A
        (fun h => typeIIRoughConvolution R C σ c (primePoolFreePart P h)) (ρ-ξ₂) z) * (W z:ℂ)) *
      (typeIIDirectEndpoint M H A
        (fun h => typeIIRoughConvolution R C σ c (primePoolFreePart P h)) (ξ₁+ρ) w * (W w:ℂ)) := by ring
    _ = _ := by rw [hzc, hw']; ring

end Bounty
end

section

/- The actual marked coefficients are unchanged by factors outside the prime pool. -/

open Finset

namespace Bounty

theorem physical_divisor_pool_mul_free {G : Type*} (P : G → Finset ℕ)
    (g : G) (Q : Finset ℕ) (hP : ∀ p ∈ P g, p.Prime) (hPQ : P g ⊆ Q)
    (a b : ℕ) (hb : b ≠ 0) (hfree : Disjoint b.primeFactors Q) :
    physicalDivisorPool P g ((a * b : ℕ) : ℤ) = physicalDivisorPool P g (a : ℤ) := by
  exact physical_divisor_pool_mul_disjoint P g hP (hfree.symm.mono_left hPQ)
    (Nat.mem_factoredNumbers_of_primeFactors_subset hb (fun _ h => h)) a

theorem marked_divisor_weight_mul_free {G : Type*} (groups : Finset G)
    (P : G → Finset ℕ) (Q : Finset ℕ) (q : ℝ) (V : G → ℝ) (t : G → ℕ)
    (hP : ∀ g ∈ groups, ∀ p ∈ P g, p.Prime) (hPQ : ∀ g ∈ groups, P g ⊆ Q)
    (a b : ℕ) (hb : b ≠ 0) (hfree : Disjoint b.primeFactors Q) :
    markedDivisorWeight groups P q V t ((a * b : ℕ) : ℤ) =
      markedDivisorWeight groups P q V t (a : ℤ) := by
  unfold markedDivisorWeight
  apply prod_congr rfl
  intro g hg
  simp only [physicalOmega, physical_divisor_pool_mul_free P g Q (hP g hg) (hPQ g hg) a b hb hfree]

theorem group_marked_average_mul_free {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (Q : Finset ℕ) (t : G → ℕ)
    (hP : ∀ g, ∀ p ∈ P g, p.Prime) (hPQ : ∀ g, P g ⊆ Q)
    (a b : ℕ) (hb : b ≠ 0) (hfree : Disjoint b.primeFactors Q)
    (c : GroupMarkedLists P t → ℂ) :
    groupMarkedAverage P t ((a * b : ℕ) : ℤ) c = groupMarkedAverage P t (a : ℤ) c := by
  apply group_marked_average_congr_divisor_pools
  intro g
  exact physical_divisor_pool_mul_free P g Q (hP g) (hPQ g) a b hb hfree

theorem primePoolPart_mul_pool_free (Q : Finset ℕ) (a b : ℕ)
    (hb : b ≠ 0) (hfree : Disjoint b.primeFactors Q) :
    primePoolPart Q (a * b) = primePoolPart Q a := by
  by_cases ha : a = 0
  · simp only [ha, zero_mul]
  · rw [primePoolPart_mul Q ha hb, primePoolPart_eq_one_of_disjoint hfree.symm
      (Nat.mem_factoredNumbers_of_primeFactors_subset hb (fun _ h => h)), mul_one]

end Bounty
