section Phase
variable {K : Type u} {X : Type v} (E : K → X → Type w)
  (target : ∀ k x, E k x → X) (phase : ∀ k x, E k x → ℂ)

def finiteEventLocalPhase : ∀ ks x, FiniteEventPath E target ks x → ℂ
  | [], _, _ => 1
  | k :: ks, x, ⟨e, p⟩ => phase k x e * finiteEventLocalPhase ks (target k x e) p




variable [∀ k x, Fintype (E k x)] (weight : ∀ k x, E k x → ℝ)

noncomputable def finiteLocalPhasedRow (k : K) (F : X → ℂ) (x : X) : ℂ :=
  ∑ e : E k x, (weight k x e : ℂ) * phase k x e * F (target k x e)

theorem finite_event_local_phase_cons (k : K) (ks : List K) (F : X → ℂ) (x : X) :
    finiteEventPathAction E target weight (k :: ks)
      (finiteEventLocalPhase E target phase (k :: ks)) F x =
    finiteLocalPhasedRow E target phase weight k
      (finiteEventPathAction E target weight ks (finiteEventLocalPhase E target phase ks) F) x := by
  classical
  let _ : ∀ e : E k x, Fintype (FiniteEventPath E target ks (target k x e)) :=
    fun e => finiteEventPathFintype E target ks (target k x e)
  change (∑ p : (Σ e : E k x, FiniteEventPath E target ks (target k x e)),
    ((weight k x p.1 * finiteEventPathWeight E target weight ks _ p.2 : ℝ) : ℂ) *
      (phase k x p.1 * finiteEventLocalPhase E target phase ks _ p.2) *
      F (finiteEventPathTerminal E target ks _ p.2)) = _
  rw [Fintype.sum_sigma]
  unfold finiteLocalPhasedRow finiteEventPathAction
  simp only [mul_sum, Complex.ofReal_mul]
  apply sum_congr rfl
  intro e _
  apply sum_congr rfl
  intro p _
  ring

theorem finite_phased_rows_eq_event_paths (ks : List K) (F : X → ℂ) :
    finiteOperatorListAction (finiteLocalPhasedRow E target phase weight) ks F =
    finiteEventPathAction E target weight ks (finiteEventLocalPhase E target phase ks) F := by
  induction ks with
  | nil =>
    funext x
    change F x = ∑ _p : PUnit.{w + 1}, (1 : ℂ) * 1 * F x
    simp
  | cons k ks ih =>
    funext x
    rw [finite_event_local_phase_cons]
    change finiteLocalPhasedRow E target phase weight k
      (finiteOperatorListAction (finiteLocalPhasedRow E target phase weight) ks F) x = _
    rw [ih]

end Phase
end

