      U T hU hT f g hf hg C D hC hD hμatom hνatom r hr u hcop β hβ ζ
    apply hpair.trans
    apply mul_le_mul_of_nonneg_right _ (Real.sqrt_nonneg _)
    exact minor_arc_uniform_factor_le hL hC hD ht hq hparam hCb hDb
