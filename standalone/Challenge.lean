/- Packing preserves the original chronological tags and number of steps. -/

namespace Bounty
section Schedule
variable {S I V K : Type} {Ps : S → Finset ℕ} {J ell : ℕ}

theorem physical_mixed_big_steps_tags (ks : List (Option (V ⊕ K)))
    (L : PhysicalMarkLists Ps J ell)
    (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks) :
    (physicalMixedBigSteps ks L pl).map
      (Option.map (Sum.map id (fun key => key.1))) = ks := by
  induction ks generalizing L with
  | nil => rfl
  | cons tag ks ih =>
    cases tag with
    | none =>
      rcases pl with ⟨σ, pl⟩
      simpa only [physicalMixedBigSteps, List.map_cons, Option.map_none] using
        congrArg (none :: ·) (ih (physicalPermuteLabels σ L) pl)
    | some tag =>
      cases tag with
      | inl j =>
        simpa only [physicalMixedBigSteps, List.map_cons, Option.map_some, Sum.map_inl, id_eq] using
          congrArg (some (.inl j) :: ·) (ih L pl)
      | inr k =>
        rcases pl with ⟨⟨i, R⟩, pl⟩
        simpa only [physicalMixedBigSteps, List.map_cons, Option.map_some, Sum.map_inr] using
          congrArg (some (.inr k) :: ·) (ih R pl)




end Schedule
end Bounty
