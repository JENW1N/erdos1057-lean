/- The literal full clean-event sum, including its auxiliary draw and both
total-memory cutoffs, equals the fresh-target integral. Memory symmetry is
retained as an explicit hypothesis for the continuation. -/

open Finset
open scoped Classical

namespace Bounty

theorem full_active_clean_event_sum {G : Type*} [Fintype G] [dG : DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {M : G → ℕ}
    (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : SharedActiveLabels P S → Type*) [∀ c, Fintype (A c)]
    (Δ D : ∀ c, A c → G → ℤ)
    (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (θ : ∀ c, A c → (∀ g, Fin (S g)ᶜ.card → P g) → ℂ)
    (f : ∀ c, A c → ProductBoundedOrderedState P
      (fun g => UnrestrictedResidueParticle (n g)) M B → ℂ)
    (hf : ∀ c a, ProductMemorySymmetric (f c a))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    let c := (productActiveMemorySplit S B x).1
    let s := (productActiveMemorySplit S B x).2
    (∑ e : FullActiveEdgeEvent n S B A Δ D x,
      (fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V x e : ℂ) *
        (if ∀ g, (e.2 g).1 = ∅ ∧ (e.2 g).2.1 = ∅ then
          θ c e.1 (fun g =>
            (unrestrictedJointEventTarget n (Δ c e.1) (D c e.1)
              (fun g => (S g)ᶜ.card) B s e.2 g).1) else 0) *
        f c e.1 (fullActiveEdgeEventTarget n S B A Δ D x e)) =
      if productTotalMemory x ≤ B then
        ∑ a : A c, (ω c a : ℂ) *
          (∏ g, (unrestrictedBoundedCleanFactor (n g) (Δ c a g) ρ (s g) : ℂ)) *
          ∑ target : (∀ g, Fin (S g)ᶜ.card → P g),
            ((∏ g, ∏ j, μ g (target g j) : ℝ) : ℂ) * θ c a target *
              f c a ((productActiveMemorySplit S B).symm (c,
                fun g => unrestrictedBoundedCleanTarget (n g) (Δ c a g) (s g) (target g)))
      else 0 := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro c s
  let F := fun a : A c => equivFiberSlice (productActiveMemorySplit S B) (f c a) c
  have hF (a : A c) : ProductMemorySymmetric (F a) :=
    productActiveMemorySlice_symmetric S B (f c a) (hf c a) c
  have hrow (a : A c) := unrestricted_joint_clean_event_phase_sum n (Δ c a) (D c a)
    μ ρ V (fun g => (S g)ᶜ.card) B (θ c a) (F a) (hF a) s
  simp only [mul_assoc] at hrow
  have htotal : productTotalMemory s = productTotalMemory x :=
    productActiveMemorySplit_total_memory S B x
  rw [Fintype.sum_sigma]
  simp only [fullActiveEdgeEventWeight, fullActiveEdgeEventTarget, Complex.ofReal_mul]
  change (∑ a : A c, ∑ e : UnrestrictedJointEvent n (Δ c a) (D c a)
      (fun g => (S g)ᶜ.card) B s,
      (ω c a : ℂ) * (unrestrictedJointCutoffEventWeight n (Δ c a) (D c a)
        μ ρ V (fun g => (S g)ᶜ.card) B s e : ℂ) *
        (if ∀ g, (e g).1 = ∅ ∧ (e g).2.1 = ∅ then θ c a
          (fun g => (unrestrictedJointEventTarget n (Δ c a) (D c a)
            (fun g => (S g)ᶜ.card) B s e g).1) else 0) *
        F a (unrestrictedJointEventTarget n (Δ c a) (D c a)
          (fun g => (S g)ᶜ.card) B s e)) = _
  simp only [mul_assoc, ← mul_sum]
  simp_rw [hrow]
  rw [htotal]
  split_ifs
  · apply sum_congr rfl
    intro a _
    simp only [F, equivFiberSlice, Complex.ofReal_prod]
    apply congrArg (fun z : ℂ => (ω c a : ℂ) *
      ((∏ g, (unrestrictedBoundedCleanFactor (n g) (Δ c a g) ρ (s g) : ℂ)) * z))
    apply sum_congr
    · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
    · intro target _
      rfl
  · simp only [mul_zero, sum_const_zero]

end Bounty
end

