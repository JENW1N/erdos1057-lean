namespace Bounty

noncomputable def candidateSelectedResidualCoefficient
    (c L q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
    (take : Fin ((candidateQIndices c L).card*r) → Bool)
    (hkeep : take ((candidateAllocationOrder c L r).symm
      (candidateRoughSlot c L r jStar hr hj)) = false)
    (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
    (t u : candidatePIndices c L → ℕ) (big : Finset (candidatePIndices c L))
    (b : GroupMarkedLists (fun g : big => candidatePBand (c*L) g.val.val)
      (fun g : big => u g.val) → ℂ) (κ θ : ℕ → ℂ) (n : ℕ) : ℂ :=
  selectedMarkedWeight (fun g : candidatePIndices c L => candidatePBand (c*L) g.val)
    ((candidatePIndices c L).biUnion (candidatePBand (c*L))) q
    (fun g => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ)) t u big b κ n *
    conj (candidateResidualPrimeCoefficient c L r jStar hr hj take hkeep
      (candidateAllocationFourierTwist c L r jStar take ξ)
      (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) n)) * θ n

theorem exists_candidate_selected_residual_power_bound {c q : ℝ}
    (hc : 0 < c) (hq0 : 0 ≤ q) (hq1 : q < 1) (T : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ L : ℝ in atTop, ∀ B : ℝ,
      ∀ (r jStar : ℕ) (hr : 0 < r) (hj : jStar ∈ candidateQIndices c L)
      (take : Fin ((candidateQIndices c L).card*r) → Bool)
      (hkeep : take ((candidateAllocationOrder c L r).symm
        (candidateRoughSlot c L r jStar hr hj)) = false)
      (ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ)
      (t u : candidatePIndices c L → ℕ) (big : Finset (candidatePIndices c L))
      (b : GroupMarkedLists (fun g : big => candidatePBand (c*L) g.val.val)
        (fun g : big => u g.val) → ℂ) (κ θ : ℕ → ℂ),
      (∀ g, t g ≤ T) → (∀ l, ‖b l‖ ≤ L^B) →
      (∀ d, ‖κ d‖ ≤ 1) → (∀ n, ‖θ n‖ ≤ 1) → ∀ n : ℕ,
      ‖candidateSelectedResidualCoefficient c L q r jStar hr hj take hkeep ξ
        t u big b κ θ n‖ ≤ L^(C+B) := by
  obtain ⟨v,V,hv,_,hpool⟩ := exists_candidate_P_pool_bounds hc
  refine ⟨(2/(5*Real.log 2))*Real.log (markedDivisorBound q v T),
    mul_nonneg (by positivity) (Real.log_nonneg (one_le_markedDivisorBound q v T)), ?_⟩
  filter_upwards [hpool] with L hp
  rcases hp with ⟨hL,_,_,hcard,_,hdata⟩
  have hLpos : 0 < L := zero_lt_one.trans_le hL
  intro B r jStar hr hj take hkeep ξ t u big b κ θ ht hb hκ hθ n
  have hw := selected_marked_weight_norm_le_rpow
    (fun g : candidatePIndices c L => candidatePBand (c*L) g.val)
    ((candidatePIndices c L).biUnion (candidatePBand (c*L))) hq0 hq1 hv hLpos
    (fun g => ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ)) t u T big
    (fun g => (hdata g.val g.property).1) ht (by simpa using hcard) b hb κ hκ n
  have hr' := norm_candidate_residual_prime_coefficient_le_one
    (mul_nonneg hc.le hLpos.le) hr hj take hkeep
    (candidateAllocationFourierTwist c L r jStar take ξ) (by
      intro slot p hp
      exact (candidate_allocation_fourier_twist_norm c L r jStar take ξ slot
        (Nat.pos_of_ne_zero (candidate_Q_slot_nonzero c L r jStar slot hp))).le)
    (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) n)
  rw [candidateSelectedResidualCoefficient,norm_mul,norm_mul,Complex.norm_conj]
  calc
    _ ≤ (L^((2/(5*Real.log 2))*Real.log (markedDivisorBound q v T)+B)*1)*1 :=
      mul_le_mul (mul_le_mul hw hr' (norm_nonneg _) (Real.rpow_nonneg hLpos.le _))
        (hθ n) (norm_nonneg _) (by positivity)
    _ = _ := by ring

