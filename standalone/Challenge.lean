theorem shortEnergy_scalar_normalization (C H R Z K X F G ε : ℝ)
    (hC : 0≤C) (hH : 0≤H) (hR : 0≤R) (hZ : 1≤Z) (hK : 0≤K)
    (hX : 0<X) (hF : 0≤F) (hG : 1≤G) (hε : 0≤ε)
    (hFZ : F≤Z^3) (hmass : X*F≤Z^3)
    (hmargin : (2*K)*G≤X*F*Z^(-((1:ℝ)/40))) :
