section

/- Both original shared-overlap branches combine into the marked-pair
approximation. The coefficient is identified only on the good event. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_whole_pair_comparison {G : Type*} [Fintype G] [dG : DecidableEq G]
    (P : G → Finset ℕ) {J ell : ℕ} (C : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    {q : ℝ} (hq0 : 0 < q) (hq1 : q ≤ 1)
    (aux : PhysicalAuxLabels P C) {w z : ℕ} (hw : 0 < w) (hz : 0 < z)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → ℂ)
    (b : GroupMarkedLists P (fun g => ell + (C g).card) →
      GroupMarkedLists P (fun g => ell + (C g).card) → ℂ)
    {H : ℝ} (hH : 0 ≤ H)
    (hK : ∀ L R, physicalSharedCompatible C L R → ‖K L R‖ ≤ H)
    (hb : ∀ (u : GroupMarkedListsAt P (fun g => ell + (C g).card) (w : ℤ))
      (v : GroupMarkedListsAt P (fun g => ell + (C g).card) (z : ℤ)), ‖b u.val v.val‖ ≤ H)
    (hgood : ∀ L R, physicalSharedCompatible C L R →
      (∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z) →
      K L R = b (physicalGroupUnsharedEmbedding C L) (physicalGroupUnsharedEmbedding C R)) :
    ‖physicalFullPairCorrelation P C V q w z K -
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (w : ℤ) : ℂ) *
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (z : ℤ) : ℂ) *
      groupMarkedAverage P (fun g => ell + (C g).card) (w : ℤ) (fun u =>
        groupMarkedAverage P (fun g => ell + (C g).card) (z : ℤ) (b u))‖ ≤
      (markedDivisorWeight univ P q V (fun g => ell + (C g).card) (w : ℤ) *
        markedDivisorWeight univ P q V (fun g => ell + (C g).card) (z : ℤ)) *
      ((∑ g, (J - (C g).card : ℕ) *
          (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)) *
        (H + H / q ^ (2 * ∑ g : G, (J - (C g).card)))) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  let W0 := markedDivisorWeight univ P q V (fun g => ell + (C g).card) (w : ℤ)
  let W1 := markedDivisorWeight univ P q V (fun g => ell + (C g).card) (z : ℤ)
  let δ : ℝ := ∑ g, (J - (C g).card : ℕ) *
    (Real.log w / Real.log 2 + Real.log z / Real.log 2 + J) / (V g * Pmin)
  let T : ℂ := (W0 : ℂ) * (W1 : ℂ) *
    groupMarkedAverage P (fun g => ell + (C g).card) (w : ℤ) (fun u =>
      groupMarkedAverage P (fun g => ell + (C g).card) (z : ℤ) (b u))
  let Kg : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → ℂ := fun L R =>
    if ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z then K L R else 0
  let Kb : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → ℂ := fun L R =>
    if ¬(∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z) then K L R else 0
  have hsplit : physicalFullPairCorrelation P C V q w z K =
      physicalFullPairCorrelation P C V q w z Kg + physicalFullPairCorrelation P C V q w z Kb := by
    rw [← physical_full_pair_add]
    apply physical_full_pair_congr
    intro L R _
    dsimp only [Kg, Kb]
    by_cases ha : ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z
    · simp only [if_pos ha, if_neg (not_not.mpr ha), add_zero]
    · simp only [if_neg ha, if_pos ha, zero_add]
  have hg : ‖physicalFullPairCorrelation P C V q w z Kg - T‖ ≤ (W0 * W1) * (δ * H) := by
    have he : physicalFullPairCorrelation P C V q w z Kg =
        physicalFullPairCorrelation P C V q w z (fun L R =>
          if ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z then
            b (physicalGroupUnsharedEmbedding C L) (physicalGroupUnsharedEmbedding C R) else 0) := by
      apply physical_full_pair_congr
      intro L R hLR
      dsimp only [Kg]
      by_cases ha : ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z
      · rw [if_pos ha, if_pos ha, hgood L R hLR ha]
      · rw [if_neg ha, if_neg ha]
    rw [he]
    exact physical_good_pair_comparison P C hprime hdis V hV hMass hq0.le aux hw hz hPmin hp b hH hb
  have hbad : ‖physicalFullPairCorrelation P C V q w z Kb‖ ≤
      (W0 * W1) * (δ * (H / q ^ (2 * ∑ g : G, (J - (C g).card)))) := by
    simpa only [physicalFullPairCorrelation, Kb, mul_ite, mul_zero] using
      physical_bad_original_pair_norm_le P C hprime hdis V hV hMass hq0 hq1
        aux hw hz hPmin hp K hH hK
  change ‖physicalFullPairCorrelation P C V q w z K - T‖ ≤
    (W0 * W1) * (δ * (H + H / q ^ (2 * ∑ g : G, (J - (C g).card))))
  calc
    _ = ‖(physicalFullPairCorrelation P C V q w z Kg - T) +
        physicalFullPairCorrelation P C V q w z Kb‖ := by
      rw [hsplit]
      congr 1
      ring
    _ ≤ ‖physicalFullPairCorrelation P C V q w z Kg - T‖ +
        ‖physicalFullPairCorrelation P C V q w z Kb‖ := norm_add_le _ _
    _ ≤ (W0 * W1) * (δ * H) +
        (W0 * W1) * (δ * (H / q ^ (2 * ∑ g : G, (J - (C g).card)))) := add_le_add hg hbad
    _ = _ := by ring

end Bounty
end

section

/- Literal retained prime coefficients with all auxiliary exclusions and the
three logarithmic phases, before and after removal of shared coordinates. -/

open Finset
open scoped Classical
namespace Bounty

section Coefficient
variable {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
  (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
  (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ)
  (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
  (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
  (a b : ℝ) (w z : ℕ)

noncomputable def physicalOriginalPrimePairCoefficient
    (L R : PhysicalMarkLists P J ell) : ℂ :=
  let C := repeatedBigPrimePatternCut probes r t i
  let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) =>
    primeProductRetainedCells (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
  if physicalListAdmissible C aux L R then
    (repeatedBigPrimePatternWeight probes r t i *
      repeatedBigPrimePatternKernel P V probes r t hrt Q h kept i
        (fun g s => L g s) (fun g s => R g s) aux) *
      physicalPhase a (physicalSharedFactor C L * w) *
      physicalPhase b (physicalSharedFactor C L * z) *
      physicalPhase (-(a+b)) (physicalD C L aux)
  else 0

noncomputable def physicalUnsharedPrimePairCoefficient
    (u v : GroupMarkedLists P (fun g => ell + (repeatedBigPrimePatternCut probes r t i g).card)) : ℂ :=
  let C := repeatedBigPrimePatternCut probes r t i
  let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) =>
    primeProductRetainedCells (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
  if physicalUnsharedAuxAvoids C aux u ∧ physicalUnsharedAuxAvoids C aux v then
    (repeatedBigPrimePatternWeight probes r t i *
      physicalUnsharedPrimePatternKernel P V probes r t hrt Q h kept i u v aux) *
      physicalPhase a w * physicalPhase b z * physicalPhase (-(a+b)) (physicalFreeFactor C aux)
  else 0

theorem physical_original_prime_pair_coefficient_norm_le (hξ : 0 < ξ)
    (L R : PhysicalMarkLists P J ell) :
    ‖physicalOriginalPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z L R‖ ≤
      repeatedBigPrimePatternBound probes r t Q ξ i := by
  unfold physicalOriginalPrimePairCoefficient
  dsimp only
  split_ifs
  · rw [physical_prime_pattern_kernel_factors_unshared]
    simpa only [norm_mul, physical_phase_norm, mul_one] using
      physical_unshared_weighted_prime_pattern_norm_le P V probes r t hrt Q h ξ hξ i
        (physicalGroupUnsharedEmbedding (repeatedBigPrimePatternCut probes r t i) L)
        (physicalGroupUnsharedEmbedding (repeatedBigPrimePatternCut probes r t i) R) aux
  · simpa only [norm_zero] using repeated_big_prime_pattern_bound_nonneg probes r t Q ξ i

theorem physical_unshared_prime_pair_coefficient_norm_le (hξ : 0 < ξ)
    (u v : GroupMarkedLists P (fun g => ell + (repeatedBigPrimePatternCut probes r t i g).card)) :
    ‖physicalUnsharedPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z u v‖ ≤
      repeatedBigPrimePatternBound probes r t Q ξ i := by
  unfold physicalUnsharedPrimePairCoefficient
  dsimp only
  split_ifs
  · exact physical_unshared_prime_three_phase_norm_le P V probes r t hrt Q h ξ hξ
      i u v aux a b (-(a+b)) w z _
  · simpa only [norm_zero] using repeated_big_prime_pattern_bound_nonneg probes r t Q ξ i

theorem physical_prime_pair_coefficient_eq_of_good_shared
    (hprime : ∀ g p, p ∈ P g → p.Prime) (hw : 0 < w) (hz : 0 < z)
    (L R : PhysicalMarkLists P J ell)
    (hLR : physicalSharedCompatible (repeatedBigPrimePatternCut probes r t i) L R)
    (hgood : ∀ g j, physicalSharedAux (repeatedBigPrimePatternCut probes r t i) L g j ∉
      physicalSharedForbidden (repeatedBigPrimePatternCut probes r t i) aux g w z) :
    physicalOriginalPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z L R =
      physicalUnsharedPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b w z
        (physicalGroupUnsharedEmbedding (repeatedBigPrimePatternCut probes r t i) L)
        (physicalGroupUnsharedEmbedding (repeatedBigPrimePatternCut probes r t i) R) := by
  unfold physicalOriginalPrimePairCoefficient physicalUnsharedPrimePairCoefficient
  dsimp only
  rw [physical_list_admissible_iff_of_good_shared _ aux L R w z hLR hgood]
  split_ifs
  · rw [physical_prime_pattern_kernel_factors_unshared, physical_D_shared_free]
    have hd : 0 < physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux :=
      prod_pos (fun g _ => prod_pos (fun j _ => (hprime g _ (aux g j).property).pos))
    have he := physical_shared_phase_cancel a b
      (physical_shared_factor_pos (repeatedBigPrimePatternCut probes r t i) L hprime) hw hz hd
    simp only [mul_assoc] at he ⊢
    rw [he]
  · rfl

end Coefficient
end Bounty
end

section

/- Cutoff guards are removed only on the nonzero support of the actual outer test. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_fixed_root_full_pair_of_coverage
    {G : Type*} [Fintype G] [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (C : G → Finset (Fin J)) (q a b : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (positions W : Finset ℤ)
    (hW : ∀ L : PhysicalMarkLists P J ell, ∀ n ∈ positions,
      n / physicalSharedFactor C L ∈ W)
    (f g : ℤ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ)
    (hf : ∀ (L : PhysicalMarkLists P J ell) w,
      f ((physicalSharedFactor C L : ℤ) * w) = f w)
    (hg : ∀ (L : PhysicalMarkLists P J ell) w,
      g ((physicalSharedFactor C L : ℤ) * w) = g w)
    (hcover : ∀ w ∈ W,
      Ψ ((w : ℝ) / (Z * physicalFreeFactor C aux)) * (w : ℂ)⁻¹ *
        (starRingEnd ℂ) (f w) * g (w + k * (physicalFreeFactor C aux : ℕ)) ≠ 0 →
      ∀ L : PhysicalMarkLists P J ell,
        (physicalSharedFactor C L : ℤ) * w ∈ positions ∧
        (physicalSharedFactor C L : ℤ) *
          (w + k * (physicalFreeFactor C aux : ℕ)) ∈ positions) :
    physicalFixedRootCorrelation V C q (-(a+b)) k K aux positions
      (fun n => physicalPhase (-a) n.natAbs * f n)
      (fun n => physicalPhase b n.natAbs * g n) Ψ Z =
    (physicalAuxMass V C aux : ℂ) * ∑ w ∈ W,
      (Ψ ((w : ℝ) / (Z * physicalFreeFactor C aux)) * (w : ℂ)⁻¹ *
        (starRingEnd ℂ) (f w) * g (w + k * (physicalFreeFactor C aux : ℕ))) *
      physicalFullPairCorrelation P C V q w.natAbs
        (w + k * (physicalFreeFactor C aux : ℕ)).natAbs
        (physicalPhasedPairCoefficient C K aux a b w.natAbs
          (w + k * (physicalFreeFactor C aux : ℕ)).natAbs) := by
  rw [physical_fixed_root_full_pair_guarded hdis hprime V C q a b k K aux positions W hW
    f g Ψ Z hf hg]
  congr 1
  apply sum_congr rfl
  intro w hw
  by_cases ht : Ψ ((w : ℝ) / (Z * physicalFreeFactor C aux)) * (w : ℂ)⁻¹ *
      (starRingEnd ℂ) (f w) * g (w + k * (physicalFreeFactor C aux : ℕ)) = 0
  · rw [ht, zero_mul, zero_mul]
  · congr 1
    apply physical_full_pair_congr
    intro L R _
    exact if_pos (hcover w hw ht L)




end Bounty
end

section

/- The two unshared endpoint exclusions hold away from the original free-label
divisibility set, since every free label divides the actual shift. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_unshared_aux_avoids_of_no_free_divisor {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (n : ℤ) (hn : ∀ p ∈ physicalFreePrimeSet C aux, ¬ (p : ℤ) ∣ n)
    (u : GroupMarkedListsAt P (fun g => ell + (C g).card) n) :
    physicalUnsharedAuxAvoids C aux u.val := by
  intro g j s he
  have hp : (aux g j).val ∈ physicalFreePrimeSet C aux :=
    (physical_mem_free_prime_set C aux _).mpr ⟨g, j, rfl⟩
  have hd := u.property g s
  rw [← he] at hd
  exact hn _ hp hd

theorem physical_no_free_divisor_shift {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (n k : ℤ) (hn : ∀ p ∈ physicalFreePrimeSet C aux, ¬ (p : ℤ) ∣ n) :
    ∀ p ∈ physicalFreePrimeSet C aux, ¬ (p : ℤ) ∣ n + k * (physicalFreeFactor C aux : ℕ) := by
  intro p hp hz
  apply hn p hp
  simpa only [add_sub_cancel_right] using dvd_sub hz (physical_free_prime_set_dvd_step C aux k hp)




end Bounty
