/- A concrete full-state coordinate schedule for the selected fine rows.
Visits use empty shared coordinates; both sides of each edge use its C_j. -/

namespace Bounty

noncomputable def physicalSelectedFineCut {N J n : ℕ}
    (C : Fin n → Fin N → Finset (Fin J)) (i : ℕ) : Fin N → Finset (Fin J) :=
  if hj : i / 4 < n then
    if 2 ≤ i % 4 then C ⟨i / 4, hj⟩ else fun _ => ∅
  else fun _ => ∅

theorem physical_selected_fine_cut_encoding {N J n : ℕ}
    (C : Fin n → Fin N → Finset (Fin J)) (i : ℕ) :
    PhysicalMarkRowEncoding C (physicalSelectedFineTag n i)
      (physicalSelectedFineCut C i) (physicalSelectedFineCut C (i + 1)) := by
  by_cases hi : i < 4 * n + 1
  · by_cases h0 : i % 4 = 0
    · have hcur : ¬ 2 ≤ i % 4 := by omega
      have hnext : ¬ 2 ≤ (i + 1) % 4 := by omega
      simp only [physicalSelectedFineTag, dif_pos hi, dif_pos h0, PhysicalMarkRowEncoding]
      unfold physicalSelectedFineCut
      split_ifs <;> simp_all
    · by_cases h2 : i % 4 = 2
      · have hj : i / 4 < n := by omega
        have hj' : (i + 1) / 4 < n := by omega
        have hd : (i + 1) / 4 = i / 4 := by omega
        have hm : 2 ≤ (i + 1) % 4 := by omega
        simp only [physicalSelectedFineTag, dif_pos hi,
          PhysicalMarkRowEncoding, physicalSelectedFineCut, dif_pos hj, dif_pos hj',
          h2, le_refl, if_true, if_pos hm]
        constructor
        · rfl
        · exact congrArg C (Fin.ext hd)
      · simp only [physicalSelectedFineTag, dif_pos hi, dif_neg h0, dif_neg h2,
          PhysicalMarkRowEncoding]
  · simp only [physicalSelectedFineTag, dif_neg hi, PhysicalMarkRowEncoding]

end Bounty
