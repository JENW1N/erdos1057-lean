section

/- The actual conjugated cell character times a Mellin phase has unit bound
and remains in its original logarithmic cell. -/

open Finset
open scoped Classical
namespace Bounty

theorem prime_cell_phased_conjugate_norm {I : Type*} [Fintype I]
    (P : I → Finset ℕ) (h : ℝ) (d : ℤ) {Q : ℕ} (χ : BoundedPrimitiveCharacter Q)
    (ζ : ℝ) (x : ∀ i, P i) :
    ‖(starRingEnd ℂ) (primeProductCellCharacter P h d χ x) *
      physicalPhase ζ (∏ i, (x i).val)‖ ≤ 1 := by
  rw [norm_mul, Complex.norm_conj, physical_phase_norm, mul_one]
  exact prime_product_cell_character_norm P h d χ x

theorem prime_cell_phased_conjugate_range {I : Type*} [Fintype I]
    (P : I → Finset ℕ) {h : ℝ} (hh : 0 < h) (d : ℤ)
    {Q : ℕ} (χ : BoundedPrimitiveCharacter Q) (ζ : ℝ) (x : ∀ i, P i)
    (hpos : 0 < ∏ i, (x i).val)
    (hx : (starRingEnd ℂ) (primeProductCellCharacter P h d χ x) *
      physicalPhase ζ (∏ i, (x i).val) ≠ 0) :
    Real.exp (((d : ℝ)-1)*h) < (∏ i, (x i).val : ℕ) ∧
      (∏ i, (x i).val : ℕ) ≤ Real.exp ((d : ℝ)*h) := by
  have hchar : primeProductCellCharacter P h d χ x ≠ 0 := by
    intro he
    exact hx (by rw [he, map_zero, zero_mul])
  exact (upper_log_cell_nat_eq_iff hh hpos d).mp (prime_cell_character_mem P h d χ x hchar)

end Bounty
