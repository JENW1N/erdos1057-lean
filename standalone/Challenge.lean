/- A finite path action with coordinatewise kernels and terminal values
factors into the product of its coordinate path actions. -/
theorem finite_path_action_tensor {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] {R : Type*} [CommSemiring R]
    (K : ℕ → (i : I) → X i → X i → R) (f : (i : I) → X i → R)
    (n : ℕ) (x : (i : I) → X i) :
    finitePathAction (fun j x y => ∏ i, K j i (x i) (y i))
        (fun x => ∏ i, f i (x i)) n x =
      ∏ i, finitePathAction (fun j => K j i) (f i) n (x i) := by
  classical
  induction n generalizing x with
  | zero => rfl
  | succ n ih =>
    simp only [finitePathAction, ih]
    simp_rw [← prod_mul_distrib]
    exact (Fintype.prod_sum (fun i y =>
      K n i (x i) y * finitePathAction (fun j => K j i) (f i) n y)).symm












end

