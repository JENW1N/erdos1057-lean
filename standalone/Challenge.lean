/- On the good shared draw, the original auxiliary exclusions are exactly
the exclusions against the unshared endpoint lists. -/

open Finset
open scoped Classical
namespace Bounty

def physicalUnsharedAuxAvoids {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (u : GroupMarkedLists P (fun g => ell + (C g).card)) : Prop :=
  ∀ g (j : C g) s, aux g j ≠ u g s

theorem physical_aux_avoids_iff_of_good_shared {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (L : PhysicalMarkLists P J ell) (w z : ℕ)
    (hgood : ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z) :
    physicalAuxAvoids C aux L ↔
      physicalUnsharedAuxAvoids C aux (physicalGroupUnsharedEmbedding C L) := by
  rw [physical_aux_avoids_shared_unshared_iff]
  have hs : ∀ g (j : C g) (s : ↥(univ \ C g)), aux g j ≠ L g (Sum.inl s.val) := by
    intro g j s he
    apply hgood g s
    exact mem_filter.mpr ⟨mem_univ _, Or.inr ⟨j, he⟩⟩
  exact and_iff_right hs

theorem physical_list_admissible_iff_of_good_shared {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (L R : PhysicalMarkLists P J ell) (w z : ℕ)
    (hLR : physicalSharedCompatible C L R)
    (hgood : ∀ g j, physicalSharedAux C L g j ∉ physicalSharedForbidden C aux g w z) :
    physicalListAdmissible C aux L R ↔
      physicalUnsharedAuxAvoids C aux (physicalGroupUnsharedEmbedding C L) ∧
        physicalUnsharedAuxAvoids C aux (physicalGroupUnsharedEmbedding C R) := by
  have hgR : ∀ g j, physicalSharedAux C R g j ∉ physicalSharedForbidden C aux g w z := by
    rw [← physical_shared_aux_eq_of_compatible C hLR]
    exact hgood
  rw [physicalListAdmissible, and_iff_right hLR,
    physical_aux_avoids_iff_of_good_shared C aux L w z hgood,
    physical_aux_avoids_iff_of_good_shared C aux R w z hgR]

end Bounty
