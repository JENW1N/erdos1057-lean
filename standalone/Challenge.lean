  exact fixedRadialCoefficientScalar*∑'t:ThetaFullIndex,
    ((fixedConjugateCuspArray 0 t.1 t.2.1 t.2.2.1.val t.2.2.2.val*
      sourceFrequencyAngle (thetaFullFrequency t))/
