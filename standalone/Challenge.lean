section

/- Complete fine-history selection is equivalent to its four chronological tests. -/

open scoped Classical
namespace Bounty
section Fine
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J))

theorem physical_selected_data_test_iff_four
    (d : PhysicalSelectedData P ell C)
    (o : ℕ → PhysicalMarkObservation P ell C)
    (t : ℕ → PhysicalBoundedMarkState P J ell B) :
    physicalSelectedDataTest C d o t ↔
      (∀ j : Fin (n + 1), o (4 * j.val) = .inr none ∧ (t (4 * j.val)).1 = d.2.1 j) ∧
      (∀ j : Fin n, o (4 * j.val + 1) = .inl (d.2.2.1 j)) ∧
      (∀ j : Fin n, o (4 * j.val + 2) = .inr (some ⟨j, d.1 j⟩) ∧
        (t (4 * j.val + 2)).1 = physicalPermuteLabels (d.2.2.2 j) (d.2.1 j.succ)) ∧
      (∀ j : Fin n, o (4 * j.val + 3) = .inl (physicalInversePermutations (d.2.2.2 j))) := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro j
      exact (physical_selected_fine_test_visit C _ _ _ _ j _ _).mp (h _ (by have := j.isLt; omega))
    · intro j
      exact (physical_selected_fine_test_source_permutation C _ _ _ _ j _ _).mp
        (h _ (by have := j.isLt; omega))
    · intro j
      exact (physical_selected_fine_test_edge C _ _ _ _ j _ _).mp (h _ (by have := j.isLt; omega))
    · intro j
      exact (physical_selected_fine_test_target_permutation C _ _ _ _ j _ _).mp
        (h _ (by have := j.isLt; omega))
  · rintro ⟨h0, h1, h2, h3⟩ i hi
    have hr : i % 4 < 4 := Nat.mod_lt _ (by omega)
    have he : i = 4 * (i / 4) + i % 4 := by omega
    rcases (show i % 4 = 0 ∨ i % 4 = 1 ∨ i % 4 = 2 ∨ i % 4 = 3 by omega) with h | h | h | h
    · let j : Fin (n + 1) := ⟨i / 4, by omega⟩
      have hij : i = 4 * j.val := by dsimp [j]; omega
      rw [hij]
      exact (physical_selected_fine_test_visit C _ _ _ _ j _ _).mpr (h0 j)
    · let j : Fin n := ⟨i / 4, by omega⟩
      have hij : i = 4 * j.val + 1 := by dsimp [j]; omega
      rw [hij]
      exact (physical_selected_fine_test_source_permutation C _ _ _ _ j _ _).mpr (h1 j)
    · let j : Fin n := ⟨i / 4, by omega⟩
      have hij : i = 4 * j.val + 2 := by dsimp [j]; omega
      rw [hij]
      exact (physical_selected_fine_test_edge C _ _ _ _ j _ _).mpr (h2 j)
    · let j : Fin n := ⟨i / 4, by omega⟩
      have hij : i = 4 * j.val + 3 := by dsimp [j]; omega
      rw [hij]
      exact (physical_selected_fine_test_target_permutation C _ _ _ _ j _ _).mpr (h3 j)

end Fine
end Bounty
