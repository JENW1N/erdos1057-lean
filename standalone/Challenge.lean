      (fun j => physicalFullEdgeDelta (C (i j)) (physicalSelectedPlannedMultiplier k i ds j))
      (fun j => physicalFullEdgeD (C (i j))) ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) x) :
    physicalEffectivePlanSmallFactor C k B Vs (fun _ => q)
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) r
      (physicalSmallSelectedFinePlanEquiv (physicalSelectedSmallArrays i ds)).1
      (physicalSmallSelectedFinePlanEquiv (physicalSelectedSmallArrays i ds)).2 x
      (physicalSelectedEffectivePathEquiv C k i ds x p) =
    deterministicLedgerPhase
