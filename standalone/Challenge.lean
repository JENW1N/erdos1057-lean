/- The concrete weighted rows bound full original path mass, in particular at empty memory. -/

open Finset Classical

namespace Bounty

theorem productLengthLyapunov_one_le {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ} {v : ℝ} (hv : 1 ≤ v)
    (s : ProductBoundedOrderedState P Z M B) : 1 ≤ productLengthLyapunov v s := by
  rw [productLengthLyapunov_eq_total]
  exact one_le_pow₀ hv

theorem productLengthLyapunov_empty {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} {B : ℕ} (v : ℝ)
    (s : ProductBoundedOrderedState P Z M B) (hs : productTotalMemory s = 0) :
    productLengthLyapunov v s = 1 := by
  rw [productLengthLyapunov_eq_total, hs, pow_zero]

