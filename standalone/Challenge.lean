/- The original selected marked endpoint is approximated by its exact
four-factor convolution, with the proved small-prime square-error bound. -/

open Finset
open scoped Classical
namespace Bounty

theorem selected_four_convolution_error_energy
    {G : Type*} [Fintype G] [dG : DecidableEq G]
    (P : G → Finset ℕ) {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v)
    (V : G → ℝ) (t : G → ℕ) (T : ℕ)
    (hV : ∀ g, v ≤ V g) (ht : ∀ g, t g ≤ T)
    (hprime : ∀ g, ∀ p ∈ P g, p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (k : ℕ) (htg : t g = k + 1) (big : Finset G) (hsmall : g ∉ big)
    (b : GroupMarkedLists (fun h : big => P h.val) (fun h : big => t h.val) → ℂ)
    {H : ℝ} (hH : 0 ≤ H) (hb : ∀ L, ‖b L‖ ≤ H)
    (Q : Finset ℕ) (hQ : ∀ g, P g ⊆ Q) (α β γ : ℕ → ℂ)
    (hαfree : ∀ d, ¬ Disjoint d.primeFactors Q → α d = 0)
    (hβfree : ∀ d, ¬ Disjoint d.primeFactors Q → β d = 0)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (positions : Finset ℕ) (N : ℕ) (hpos : ∀ n ∈ positions, 0 < n ∧ n ≤ N) :
    let c := fun n : ℕ => groupMarkedAverage
      (fun h : big => P h.val) (fun h : big => t h.val) (n : ℤ) b
    (∑ n ∈ positions,
      ‖(markedDivisorWeight univ P q V t (n : ℤ) : ℂ) * c n *
          invariantTripleEndpoint Q α β γ n -
        endpointFourConvolution (fun p => if p ∈ P g then 1 / (V g : ℂ) else 0) α β
          (fun r => selectedMarkedWeight P Q q V (Function.update t g k) t big b (fun _ => 1) r *
            γ (primePoolFreePart Q r)) n‖ ^ 2) ≤
      H ^ 2 * (((markedDivisorBound q v T) ^ Fintype.card G * (1 + 2 * Real.log N / v)) ^ 2 *
        (((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) *
          ∑ p ∈ P g, 1 / (p : ℝ) ^ 2)) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  have he := weighted_small_mark_extraction_error_energy P hq0 hq1 hv V t T hV ht hprime hdis
    g k htg big hsmall b hH hb Q (hQ g) α β γ hA hB hC hα hβ hγ positions N hpos
  dsimp only at he ⊢
  convert he using 1
  apply sum_congr rfl
  intro n hn
  rw [weighted_group_marked_sum_selected_average,
    selected_marked_prime_peel_four_convolution P Q q V t t g k big b α β γ hprime hQ
      hαfree hβfree (ne_of_gt (hpos n hn).1)]
  rfl

end Bounty
