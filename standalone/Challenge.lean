theorem fixedChildRow_secondTest_normPhase (pool : Finset ι) (Ψ : ActualEisensteinCubic.O →* ℂ) (m f y : ActualEisensteinCubic.O)
    (V : ℝ → ℂ) (X a b : ℝ) (hX : 0<X) (negative : Bool) :
