theorem physical_mark_raw_extension_marks_congr {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (L : PhysicalMarkLists P J ell) (F G : PhysicalBoundedMarkState P J ell B → ℂ)
    (hFG : ∀ t, t.1 = L → F t = G t) :
    physicalMarkRawExtension F L = physicalMarkRawExtension G L := by
  funext u
  unfold physicalMarkRawExtension
  split_ifs
  · exact hFG _ rfl
  · rfl

section Rows
