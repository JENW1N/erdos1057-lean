def ramifiedLinearChar (u:ActualEisensteinCubic.Oˣ) (n:ℕ):AddChar ActualEisensteinCubic.O ℂ where
  toFun x:=eisEmbedding (symbol (u.val*lambda^n) (1+3*x))
  map_zero_eq_one':=by simp [symbol_one]
  map_add_eq_mul':=by
    intro x y
    have hp (z:ActualEisensteinCubic.O):(3:ActualEisensteinCubic.O)∣1+3*z-1:=⟨z,by ring⟩
    have hprod:(3:ActualEisensteinCubic.O)∣(1+3*x)*(1+3*y)-1:=⟨x+y+3*x*y,by ring⟩
    rw [ramified_symbol_congr_mod_nine u n (1+3*(x+y))
      ((1+3*x)*(1+3*y)) (hp _) hprod ⟨-x*y,by ring⟩,
      symbol_mul_denominator,map_mul]

lemma ramifiedLinearChar_period (u:ActualEisensteinCubic.Oˣ) (n:ℕ) (x:ActualEisensteinCubic.O)
    (hx:x∈Ideal.span {(3:ActualEisensteinCubic.O)}) : ramifiedLinearChar u n x=1 := by
  obtain ⟨w,rfl⟩:=Ideal.mem_span_singleton.mp hx
  change eisEmbedding (symbol (u.val*lambda^n) (1+3*(3*w)))=1
  rw [ramified_symbol_congr_mod_nine u n _ 1 ⟨3*w,by ring⟩ (by simp) ⟨w,by ring⟩]
  simp [symbol_one]

def ramifiedQuotientChar (u:ActualEisensteinCubic.Oˣ) (n:ℕ):AddChar (ActualEisensteinCubic.O⧸Ideal.span {(3:ActualEisensteinCubic.O)}) ℂ:=
  IdealGaussCRT.quotientAddChar _ (ramifiedLinearChar u n) (ramifiedLinearChar_period u n)

lemma ramifiedQuotientChar_rep (u:ActualEisensteinCubic.Oˣ) (n:ℕ) (x:ActualEisensteinCubic.O⧸Ideal.span {(3:ActualEisensteinCubic.O)}) :
    ramifiedQuotientChar u n x=
      eisEmbedding (symbol (u.val*lambda^n)
        (1+3*GaussianShiftedPartition.representative 3 x)) := by
  conv_lhs => rw [←GaussianShiftedPartition.representative_spec 3 x]
  rfl

def ramifiedFrequencyChar (k:ActualEisensteinCubic.O) (u:ActualEisensteinCubic.Oˣ) (n:ℕ):
    AddChar (ActualEisensteinCubic.O⧸Ideal.span {(3:ActualEisensteinCubic.O)}) ℂ:=
  ramifiedQuotientChar u n *
    (eisTraceModChar ShortDraftTrace.breveE ConcreteBreveE.breveE_period_coordinates
      3 (by norm_num)).mulShift (Ideal.Quotient.mk _ k)

lemma ramifiedFrequencyChar_rep (k:ActualEisensteinCubic.O) (u:ActualEisensteinCubic.Oˣ) (n:ℕ)
    (x:ActualEisensteinCubic.O⧸Ideal.span {(3:ActualEisensteinCubic.O)}) :
    ramifiedFrequencyChar k u n x=
      eisEmbedding (symbol (u.val*lambda^n)
        (1+3*GaussianShiftedPartition.representative 3 x))*
      residueAdditive k 3 (3*GaussianShiftedPartition.representative 3 x) := by
  rw [ramifiedFrequencyChar,AddChar.mul_apply,ramifiedQuotientChar_rep]
  congr 1
  conv_lhs => rw [←GaussianShiftedPartition.representative_spec 3 x]
  simp only [AddChar.mulShift_apply,←map_mul,eisTraceModChar,IdealGaussCRT.traceModChar_mk]
  unfold residueAdditive cuspFrequency
  simp only [map_mul,map_ofNat]
  congr 1
  field_simp

theorem ramifiedNineSum_eq_character_test (k:ActualEisensteinCubic.O) (u:ActualEisensteinCubic.Oˣ) (n:ℕ) :
    ramifiedNineSum k u n=
      if ramifiedFrequencyChar k u n=1 then 9*residueAdditive k 3 1 else 0 := by
  let:Finite (ActualEisensteinCubic.O⧸Ideal.span {(3:ActualEisensteinCubic.O)}):=finite_quotient_span (by norm_num)
  let:Fintype (ActualEisensteinCubic.O⧸Ideal.span {(3:ActualEisensteinCubic.O)}):=Fintype.ofFinite _
  have hcard:(Fintype.card (ActualEisensteinCubic.O⧸Ideal.span {(3:ActualEisensteinCubic.O)}):ℂ)=9:=by
    have hh:=three_absNorm
    change Nat.card (ActualEisensteinCubic.O⧸Ideal.span {(3:ActualEisensteinCubic.O)})=9 at hh
    exact_mod_cast (show Fintype.card (ActualEisensteinCubic.O⧸Ideal.span {(3:ActualEisensteinCubic.O)})=9 by
      simpa only [Nat.card_eq_fintype_card] using hh)
  have he:ramifiedNineSum k u n=residueAdditive k 3 1*
      ∑'x:ActualEisensteinCubic.O⧸Ideal.span {(3:ActualEisensteinCubic.O)},ramifiedFrequencyChar k u n x:=by
    rw [ramifiedNineSum,←tsum_mul_left]
    apply tsum_congr
    intro x
    rw [ramifiedFrequencyChar_rep,residueAdditive_add]
    ring
  rw [he,tsum_fintype]
  split_ifs with hchar
  · rw [AddChar.sum_eq_card_of_eq_one hchar,hcard]
    ring
  · rw [AddChar.sum_eq_zero_of_ne_one hchar,mul_zero]

theorem ramified_arithmetic_character_test (h k:ActualEisensteinCubic.O) (u:ActualEisensteinCubic.Oˣ) (n:ℕ) (hn:2≤n)
    (hk:3*h=(u.val*lambda^n)*k) :
    arithmeticResidueSum h (u.val*lambda^n)=
      if ramifiedFrequencyChar k u n=1 then ((3^n:ℕ):ℂ)*residueAdditive k 3 1 else 0 := by
  rw [ramified_arithmetic_nine_sum h k u n hn hk,ramifiedNineSum_eq_character_test]
  have hp:(3:ℕ)^n=3^(n-2)*9:=by
    have hn':n=(n-2)+2:=by omega
    conv_lhs => rw [hn']
    rw [pow_add]
    norm_num
  split_ifs
  · rw [hp,Nat.cast_mul]
    norm_num
    ring
  · ring

end CubicEisenstein

