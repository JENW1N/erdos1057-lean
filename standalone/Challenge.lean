section Energy
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)
  (S : Finset (PhysicalSelectedData P ell C)) (w : PhysicalSelectedData P ell C → ℂ)

omit [∀ g, ∀ p : ↥(P g), NeZero p.val] in
theorem physical_selected_initial_pairing
    (a : PhysicalMarkLists P J ell → ℂ)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    (∑ M : PhysicalMarkLists P J ell, a M *
      (∑ d ∈ S, w d *
        finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
          (physicalSelectedFineRow C d.1 d.2.1 d.2.2.1 d.2.2.2 k β V ρ hV ω retention)
          (4 * n + 1) F (physicalInitialMarkState B M))) =
    ∑ d ∈ S, a (d.2.1 0) * (w d *
      finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
        (physicalSelectedFineRow C d.1 d.2.1 d.2.2.1 d.2.2.2 k β V ρ hV ω retention)
        (4 * n + 1) F (physicalInitialMarkState B (d.2.1 0))) := by
  apply finite_selected_source_pairing
  intro d hd M
  have h := physical_selected_fine_initial_mark_indicator C d.1 d.2.1 d.2.2.1 d.2.2.2
    k β V ρ hV ω retention F M
  split_ifs with hM
  · simpa only [if_pos hM] using h
  · simpa only [if_neg hM] using h




