noncomputable def typeIICrossFourierPowers (y : TypeIIShiftIndex)
    (ξ : EuclideanSpace ℝ (Fin 3)) : ℂ :=
  typeIIPhase (2*Real.pi*ξ 0) y.2.1.1 * typeIIPhase (2*Real.pi*ξ 1) y.2.2.1 *
    typeIIPhase (2*Real.pi*ξ 2) y.1.2




theorem typeII_cross_fourier_powers_eq (y : TypeIIShiftIndex)
    (hm : 0 < y.2.1.1) (hm' : 0 < y.2.2.1) (hz : 0 < y.1.2)
    (ξ : EuclideanSpace ℝ (Fin 3)) :
    typeIICrossFourierPowers y ξ =
      ∏ i, ((![(y.2.1.1:ℝ),(y.2.2.1:ℝ),(y.1.2:ℝ)] : Fin 3 → ℝ) i : ℂ)^
        (((2*Real.pi*ξ i : ℝ):ℂ)*Complex.I) := by
  simp [typeIICrossFourierPowers, Fin.prod_univ_three,
