  simpa only [sub_add_sub_cancel] using dvd_add hh hA

lemma comparison_levelTwo (A:levelTwo) (N:SL(2,(_root_.OAI.ActualEisensteinCubic.O)))
    (hNA:N*(A:SL(2,(_root_.OAI.ActualEisensteinCubic.O)))⁻¹∈levelThree) : N∈levelTwo := by
  have hh:=Subgroup.mul_mem levelTwo (levelThree_le_levelTwo hNA) A.property
  simpa only [inv_mul_cancel_right] using hh

lemma levelTwo_cube_zero_phase (A N:levelTwo) (p q:(_root_.OAI.ActualEisensteinCubic.O))
    (hp:lambda^2∣p-1)
    (hA:lambda^2∣((A:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) 0 0)-1)
    (hN:lambda^2∣((N:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) 0 0)-1)
    (hx:(A:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) 0 0+3*q*(A:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) 1 0=(N:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) 0 0)
    (hc:(N:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) 1 0=p^3*(A:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) 1 0)
    (hNA:(N:SL(2,(_root_.OAI.ActualEisensteinCubic.O)))*(A:SL(2,(_root_.OAI.ActualEisensteinCubic.O)))⁻¹∈levelThree) :
    complexCharacter ⟨(N:SL(2,(_root_.OAI.ActualEisensteinCubic.O)))*(A:SL(2,(_root_.OAI.ActualEisensteinCubic.O)))⁻¹,hNA⟩=1 := by
  have hcop:IsCoprime ((N:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) 0 0) p:=by
    refine ⟨(N:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) 1 1,-(N:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) 0 1*p^2*(A:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) 1 0,?_⟩
    have hd:(N:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) 0 0*(N:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) 1 1-
