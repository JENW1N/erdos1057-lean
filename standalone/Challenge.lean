/- On original paths with injective initial active labels, every compatible selected child is owned by a later event. -/

namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))
  (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (p : FullPermutationMixedPath n S B A Δ D steps x)

theorem full_mixed_common_initial_label_injOn (hx : FullActiveInjective x) :
    Set.InjOn
      (fun i => fullMixedCommonBirthLabel n S B A Δ D steps x p (fullMixedCommonBirthOrder M B steps i))
      {i | fullMixedCommonIndexStage M B steps i = 0} := by
  intro i hi j hj he
  obtain ⟨a, ha⟩ := (full_mixed_common_index_stage_zero_iff M B steps i).mp hi
  obtain ⟨b, hb⟩ := (full_mixed_common_index_stage_zero_iff M B steps j).mp hj
  dsimp only at he
  rw [ha, hb, full_mixed_common_initial_label, full_mixed_common_initial_label] at he
  have hab := full_mixed_common_initial_injective x hx (Option.some.inj he)
  apply (fullMixedCommonBirthOrder M B steps).injective
  rw [ha, hb, hab]

theorem full_mixed_common_compatible_initial_child_none (hx : FullActiveInjective x)
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))
    (hcompat : birthForestCompatible
      (fun i => fullMixedCommonBirthPerformed n S B A Δ D steps x p (fullMixedCommonBirthOrder M B steps i))
      (fun i => fullMixedCommonBirthLabel n S B A Δ D steps x p (fullMixedCommonBirthOrder M B steps i)) code) :
    ∀ i, fullMixedCommonIndexStage M B steps i = 0 → code i = none := by
  apply birth_forest_no_child_in_injective_prefix code _ _ _ _
    (full_mixed_common_initial_label_injOn n S B A Δ D steps x p hx) hcompat
  intro i j hij hj
  have h := full_mixed_common_index_stage_monotone M B steps hij.le
  rw [hj] at h
  exact le_antisymm h (Fin.zero_le _)

