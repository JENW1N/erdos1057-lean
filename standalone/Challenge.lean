open MeasureTheory
open scoped FourierTransform

namespace Bounty

noncomputable def centeredLocalMellinPolynomial
    (S : Finset ℕ) (a : ℕ → ℂ) (Y t : ℝ) : ℂ :=
  Complex.exp (((-t*Real.log Y:ℝ):ℂ)*Complex.I) * localMellinPolynomial S a t

theorem centered_local_mellin_polynomial_continuous
    (S : Finset ℕ) (a : ℕ → ℂ) (Y : ℝ) :
    Continuous (centeredLocalMellinPolynomial S a Y) := by
  have hp := local_mellin_polynomial_continuous S a
  unfold centeredLocalMellinPolynomial
  fun_prop

theorem centered_local_mellin_polynomial_norm
    (S : Finset ℕ) (a : ℕ → ℂ) (Y t : ℝ) :
    ‖centeredLocalMellinPolynomial S a Y t‖ = ‖localMellinPolynomial S a t‖ := by
  unfold centeredLocalMellinPolynomial
  rw [norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]

theorem local_log_convolution_mellin_coordinates
    (S : Finset ℕ) (a : ℕ → ℂ) (hS : ∀ n ∈ S, 0 < n)
    {h Y : ℝ} (hh : 0 < h) (hY : 0 < Y) (u : ℝ) :
    localLogConvolution S a (h*Y) (Y*Real.exp u) =
      ((h/(2*Real.pi):ℝ):ℂ) *
        localMellinTransform h (centeredLocalMellinPolynomial S a Y) u := by
  have hv : 0 < Y*Real.exp u := mul_pos hY (Real.exp_pos u)
  rw [local_mellin_representation S a hS hv (mul_pos hh hY)]
  have hc : h*Y/(2*Real.pi*(Y*Real.exp u)) = (h/(2*Real.pi))*Real.exp (-u) := by
    rw [Real.exp_neg]
    field_simp
  rw [hc]
  unfold localMellinTransform
  rw [Complex.ofReal_mul, mul_assoc]
  congr 1
  congr 1
  apply integral_congr_ae
  filter_upwards [] with t
  have hfreq : (h/(2*Real.pi)*Real.exp (-u))*t = Real.exp (-u)*(h*t)/(2*Real.pi) := by ring
  rw [hfreq, Real.log_mul hY.ne' (Real.exp_ne_zero u), Real.log_exp]
  unfold centeredLocalMellinPolynomial
  have hexp : Complex.exp (((-t*(Real.log Y+u):ℝ):ℂ)*Complex.I) =
      Complex.exp (((-t*u:ℝ):ℂ)*Complex.I) *
        Complex.exp (((-t*Real.log Y:ℝ):ℂ)*Complex.I) := by
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  rw [hexp]
  ring

theorem scaled_exponential_log_dyad_image {Y : ℝ} (hY : 0 < Y) :
    (fun u : ℝ => Y*Real.exp u) '' Set.Icc (Real.log (1/2:ℝ)) (Real.log 3) =
      Set.Icc (Y/2) (3*Y) := by
  have hc : Continuous (fun u : ℝ => Y*Real.exp u) := by fun_prop
  have hm : StrictMono (fun u : ℝ => Y*Real.exp u) :=
    fun a b hab => mul_lt_mul_of_pos_left (Real.exp_strictMono hab) hY
  rw [hc.image_Icc_of_strictMono hm, Real.exp_log (by norm_num : (0:ℝ)<1/2),
    Real.exp_log (by norm_num : (0:ℝ)<3)]
  congr 1 <;> ring

theorem logarithmic_dyad_integral_substitution {Y : ℝ} (hY : 0 < Y) (F : ℝ → ℝ) :
    (∫ v in Set.Icc (Y/2) (3*Y), F v) =
      ∫ u in Set.Icc (Real.log (1/2:ℝ)) (Real.log 3), Y*Real.exp u * F (Y*Real.exp u) := by
  rw [← scaled_exponential_log_dyad_image hY]
  have hi : Set.InjOn (fun u : ℝ => Y*Real.exp u)
      (Set.Icc (Real.log (1/2:ℝ)) (Real.log 3)) := by
    intro a ha b hb hab
    apply Real.exp_injective
    exact (mul_left_cancel₀ hY.ne') hab
  rw [integral_image_eq_integral_abs_deriv_smul measurableSet_Icc
    (fun u hu => ((Real.hasDerivAt_exp u).const_mul Y).hasDerivWithinAt) hi]
  apply integral_congr_ae
  filter_upwards [] with u
  rw [abs_of_pos (mul_pos hY (Real.exp_pos u)), smul_eq_mul]

end Bounty
