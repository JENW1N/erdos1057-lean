section

/- Four-factor integral decay with actual small-prime exceptional sets.
Both integral-energy inputs are discharged from literal dyadic coefficients.
The high- and low-frequency pointwise estimates remain explicit. -/

open Filter Finset Set MeasureTheory

namespace Bounty

theorem eventually_prime_four_factor_integral_decay
    {a beta c d Bcoeff A As H Bsave B0 Cmean Cres kmean kres q t : ℝ}
    (ha : 0 < a) (ha1 : a ≤ 1) (hbeta : beta < 1) (hc : 0 ≤ c) (hd : 0 < d)
    (hBcoeff : 1 ≤ Bcoeff) (hAs0 : 0 ≤ As)
    (hAs : A + (Cmean + 2 + 2 * kmean) + 1 ≤ 2 * As)
    (hH : A + 2 + (Cres + 2 + 2 * kres) + 1 ≤ 2 * H)
    (hBsave : A + B0 + 2 + 2 * q + 2 * t + 1 ≤ 2 * Bsave) :
    ∀ᶠ L : ℝ in atTop, ∀ (s : Finset ℕ), (∀ p ∈ s, Nat.Prime p) →
      ∀ (coeff : s → ℂ) (Y P R : ℝ),
      1 ≤ Y → d * L ≤ Real.log Y → Real.log Y ≤ c * L →
      Real.exp (L ^ a) / 2 ≤ P → P ≤ Real.exp (L ^ beta) →
      0 ≤ R → R ≤ Y →
      (∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P) →
      (∀ p : s, ‖coeff p‖ ≤ Bcoeff) →
      ∀ (Q M T : ℝ → ℂ), Continuous Q → Continuous M → Continuous T →
      (∀ u ∈ Set.Icc (-R) R, ‖Q u‖ ≤ L ^ q) →
      (∀ u ∈ Set.Icc (-R) R, ‖T u‖ ≤ L ^ t) →
      (∀ u ∈ Set.Icc (-R) R, L ^ B0 < |u| → ‖Q u‖ ≤ L ^ (-H)) →
      (∀ u ∈ Set.Icc (-R) R, |u| ≤ L ^ B0 → ‖M u‖ ≤ L ^ (-Bsave)) →
      ∀ (Km Kr : ℕ) (lom him : Fin Km → ℕ) (lor hir : Fin Kr → ℕ)
        (wm : Fin Km → ℕ → ℂ) (wr : Fin Kr → ℕ → ℂ)
        (Um : Fin Km → ℝ) (Ur : Fin Kr → ℝ),
      (Km : ℝ) ≤ L ^ kmean → (Kr : ℝ) ≤ L ^ kres →
      (∀ j, 1 ≤ Um j ∧ R ≤ Um j ∧ Real.log (Um j) ≤ c * L ∧
        Um j ≤ (lom j : ℝ) ∧ (him j : ℝ) ≤ 2 * Um j ∧
        (∑ n ∈ Finset.Icc (lom j) (him j), ‖wm j n‖ ^ 2) ≤ L ^ Cmean / Um j) →
      (∀ j, Y ^ (3 / 5 : ℝ) ≤ Ur j ∧ Ur j ≤ (lor j : ℝ) ∧
        (hir j : ℝ) ≤ 2 * Ur j ∧
        (∑ n ∈ Finset.Icc (lor j) (hir j), ‖wr j n‖ ^ 2) ≤ L ^ Cres / Ur j) →
      (∀ u, Q u * M u * T u = ∑ j : Fin Km, ∑ n ∈ Finset.Icc (lom j) (him j),
        wm j n * Complex.exp ((Real.log (n : ℝ) * u : ℝ) * Complex.I)) →
      (∀ u, M u * T u = ∑ j : Fin Kr, ∑ n ∈ Finset.Icc (lor j) (hir j),
        wr j n * Complex.exp ((Real.log (n : ℝ) * u : ℝ) * Complex.I)) →
      (∫ u in Set.Icc (-R) R, ‖primeReciprocalPolynomial s coeff u * Q u * M u * T u‖ ^ 2)
        ≤ L ^ (-A) := by
  filter_upwards [eventually_dyadic_family_mean_energy (C := Cmean) (k := kmean) hc,
    eventually_prime_exceptional_dyadic_family_energy (C := Cres) (k := kres)
      ha ha1 hbeta hc hAs0 hBcoeff hd,
    eventually_ge_atTop (4 : ℝ), eventually_ge_atTop (2 * Bcoeff)]
    with L hmean hsparse hL hLB
  intro s hs coeff Y P R hY hloglo hloghi hPlo hPhi hR hRY hband hcoeff
    Q M T hQ hM hT hQbound hTbound hhigh hlow
    Km Kr lom him lor hir wm wr Um Ur hKm hKr hmdata hrdata hmrep hrrep
  have hL1 : 1 ≤ L := by linarith
  have hP1 : 1 ≤ P := by
    have hx : 1 ≤ L ^ a := Real.one_le_rpow hL1 ha.le
    have he : Real.exp 1 ≤ Real.exp (L ^ a) := Real.exp_le_exp.mpr hx
    have htwo : 2 ≤ Real.exp (1 : ℝ) := by
      have hh := Real.add_one_le_exp (1 : ℝ)
      norm_num at hh ⊢
      exact hh
    linarith
  have hS : Continuous (primeReciprocalPolynomial s coeff) := by
    unfold primeReciprocalPolynomial
    fun_prop
  have hSbound : ∀ u ∈ Set.Icc (-R) R,
      ‖primeReciprocalPolynomial s coeff u‖ ≤ L ^ (1 : ℝ) := by
    intro u _
    simpa only [Real.rpow_one] using
      (prime_reciprocal_polynomial_norm_le s coeff hP1
        (zero_le_one.trans hBcoeff) hband hcoeff u).trans hLB
  have hmean' := hmean Km lom him wm Um R hKm hR hmdata
  simp_rw [← hmrep] at hmean'
  have hsparse' := hsparse s hs coeff Y P R hY hloglo hloghi hPlo hPhi hR hRY
    hband hcoeff Kr lor hir wr Ur hKr hrdata
  simp_rw [← hrrep] at hsparse'
  have hE : {u ∈ Set.Icc (-R) R | L ^ (-As) < ‖primeReciprocalPolynomial s coeff u‖} =
      primeExceptionalTimes s coeff (L ^ (-As)) R := by
    ext u
    change ((-R ≤ u ∧ u ≤ R) ∧ _) ↔ (|u| ≤ R ∧ _)
    rw [abs_le]
  refine three_regime_integral_decay R (primeReciprocalPolynomial s coeff) Q M T
    hS hQ hM hT hL hAs (by simpa using hH) (by simpa using hBsave)
    hSbound hQbound hTbound ?_ hlow hmean' ?_
  · intro u hu _ hlarge
    exact hhigh u hu hlarge
  · simpa only [hE] using hsparse'

end Bounty
end

section

/- Partial summation of the oscillatory rough count keeps the frequency in the coefficients. -/

open Finset

namespace Bounty

theorem exists_rough_harmonic_phase_bound (τ : ℝ) (hτ : 0 < τ) :
    ∃ δ C K N0 : ℝ, 0 < δ ∧ 0 < C ∧ 0 < K ∧ 1 ≤ N0 ∧
      ∀ (z : ℝ) (h : ℕ), 1 < z → 1 ≤ h → Even h →
      ∀ (Y x u : ℝ) (a b q : ℕ) [NeZero q] (χ : DirichletCharacter ℂ q),
      a ≤ b → Y ≤ (a : ℝ)+1 → (b : ℝ) ≤ 2*Y →
      N0 ≤ Y/(z^(4*(h : ℝ)+2)*(q : ℝ)) →
      1 ≤ x → x^(τ/2) ≤ Y/(z^(4*(h : ℝ)+2)*(q : ℝ)) →
      u ≠ 0 → |u| ≤ x^2 →
      ‖∑ n ∈ (Ioc a b).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ)),
        harmonicMellinWeight u n*χ (n : ZMod q)‖ ≤
        3*K*(2*Real.exp (-(h : ℝ))+z^(4*(h : ℝ)+2)/Y+
          C*Real.log (2*z)*(1/|u|+(Y/(z^(4*(h : ℝ)+2)*(q : ℝ)))^(-δ))) := by
  obtain ⟨δ,C,K,N0,hδ,hC,hK,hN0,hraw⟩ := exists_rough_logarithmic_sieve_bound τ hτ
  refine ⟨δ,C,K,N0,hδ,hC,hK,hN0,?_⟩
  intro z h hz hh heven Y x u a b q hqInst χ hab hYa hbY hN hx hxN hu hux
  have hz0 : 0 < z := lt_trans zero_lt_one hz
  have hqR : 0 < (q : ℝ) := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne q)
  have hlevel : 0 < z^(4*(h : ℝ)+2) := Real.rpow_pos_of_pos hz0 _
  have hNpos : 0 < Y/(z^(4*(h : ℝ)+2)*(q : ℝ)) :=
    lt_of_lt_of_le (lt_of_lt_of_le zero_lt_one hN0) hN
  have hY : 0 < Y := (div_pos_iff.mp hNpos).resolve_right (by
    intro ht
    exact (not_lt_of_ge (mul_pos hlevel hqR).le) ht.2) |>.1
  have hlog : 0 ≤ Real.log (2*z) := Real.log_nonneg (by linarith)
  by_cases heq : a = b
  · subst b
    simp only [Ioc_self,filter_empty,sum_empty,norm_zero]
    positivity
  have hab' : a < b := lt_of_le_of_ne hab heq
  let g : ℕ → ℂ := fun n => if ∀ p ∈ n.primeFactors, z < (p : ℝ)
    then χ (n : ZMod q)*Complex.exp (((u*Real.log (n : ℝ) : ℝ) : ℂ)*Complex.I) else 0
  let B : ℝ := K*(2*Y*Real.exp (-(h : ℝ))+z^(4*(h : ℝ)+2))+
    Y*(C*(1/|u|+(Y/(z^(4*(h : ℝ)+2)*(q : ℝ)))^(-δ)))*(K*Real.log (2*z))
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hprefix : ∀ i ∈ Icc a b, ‖∑ n ∈ Ioc a i, g n‖ ≤ B := by
    intro i hi
    have hi' := mem_Icc.mp hi
    have hb := hraw z h hz hh heven Y x u a i q χ hi'.1 hYa
      ((Nat.cast_le.mpr hi'.2).trans hbY) hN hx hxN hu hux
    simpa only [sum_filter,g,B] using hb
  have hb := norm_harmonic_mellin_interval_sum_le (v := 0) g hY hab'
    (by simpa only [Nat.cast_add,Nat.cast_one] using hYa) hbY hB hprefix
  simp only [abs_zero,mul_zero,add_zero] at hb
  have he : (∑ n ∈ (Ioc a b).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ)),
      harmonicMellinWeight u n*χ (n : ZMod q)) =
      ∑ n ∈ Ioc a b, harmonicMellinWeight 0 n*g n := by
    rw [sum_filter]
    apply sum_congr rfl
    intro n hn
    simp only [g,harmonicMellinWeight,zero_mul,Complex.ofReal_zero,
      mul_zero,Complex.exp_zero]
    rw [mul_comm Complex.I]
    split_ifs <;> ring
  rw [he]
  apply hb.trans_eq
  dsimp [B]
  field_simp

end Bounty
end

