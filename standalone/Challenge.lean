theorem absNorm_ramified
    (P : Ideal O) [P.IsPrime] [P.LiesOver (Ideal.span {(3 : ℤ)})] :
    Ideal.absNorm P = 3 := by
  letI : IsCyclotomicExtension {3} ℚ K := instIsCyclotomicExtensionSingletonNatSetOfNatRatK
  letI : IsGalois ℚ K := instIsGaloisRatK
