section
open Finset Classical
universe uJ uK uG uP uA

section

variable {J : Type uJ} {K : Type uK} {G : Type uG} {P : G → Type uP}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type uA)
  (Δ D : ∀ k c, A k c → G → ℤ)

def FullMixedMemoryEvent : (J ⊕ K) →
    ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → Type _
  | .inl _, s => ULift.{uA} (CoupledGhostEvent M B s)
  | .inr k, s => FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) s

noncomputable abbrev fullMixedMemoryEventFintype [Fintype G] [∀ g, Fintype (P g)]
    [∀ g p, NeZero (n g p)] [∀ k c, Fintype (A k c)] (k : J ⊕ K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    Fintype (FullMixedMemoryEvent n S B A Δ D k s) := by
  cases k <;> dsimp [FullMixedMemoryEvent] <;> infer_instance

noncomputable def fullMixedMemoryEventTarget (k : J ⊕ K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullMixedMemoryEvent n S B A Δ D k s →
      ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B :=
  match k with
  | .inl _ => fun e => coupledGhostJointEventTarget M B s e.down
  | .inr k => fullActiveEdgeEventTarget n (S k) B (A k) (Δ k) (D k) s

noncomputable def fullMixedMemoryEventWeight [Fintype G]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (k : J ⊕ K)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullMixedMemoryEvent n S B A Δ D k s → ℝ :=
  match k with
  | .inl j => fun e => coupledGhostJointEventWeight
      (fun g => physicalGhostRetention (n g) (q j) ρ)
      (fun g => physicalGhostTermination (n g) (q j) ρ)
      (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
      (fun g => unrestrictedResidueWeight (μ g)) M B s e.down
  | .inr k => fullActiveEdgeEventWeight n (S k) B (A k) (Δ k) (D k) (ω k) μ ρ V s







end
end

