theorem ordered_retrieval_factorial {j a : ℕ} (ha : a ≤ j) :
    (j.descFactorial a : ℝ) / j.factorial = 1 / ((j-a).factorial : ℝ) := by
  have hj : (j.factorial : ℝ) ≠ 0 := by positivity
  have hja : ((j-a).factorial : ℝ) ≠ 0 := by positivity
  have hfac : ((j-a).factorial : ℝ) * (j.descFactorial a : ℝ) = j.factorial := by
    exact_mod_cast Nat.factorial_mul_descFactorial ha
  field_simp
  nlinarith [hfac]

/- The memory factorial is invariant under reversing an ordered retrieval
of `a` old particles and storage of `b` new particles. -/
theorem ordered_retrieval_reversal (u a b : ℕ) :
    ((u+a).descFactorial a : ℝ) / (u+a).factorial =
      ((u+b).descFactorial b : ℝ) / (u+b).factorial := by
  rw [ordered_retrieval_factorial (by omega), ordered_retrieval_factorial (by omega)]
  simp









end

