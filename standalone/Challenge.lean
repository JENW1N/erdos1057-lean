/- Residues supported only on a selected set of physical prime groups. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalPrimeGroupEquiv {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (groups : Finset G) :
    PhysicalPrime (fun g : ↥groups => P g.val) ≃ ↥(physicalPrimeGroups P groups) where
  toFun p := ⟨⟨p.1.val, p.2⟩, by simp [physicalPrimeGroups, p.1.property]⟩
  invFun p := ⟨⟨p.val.1, (mem_filter.mp p.property).2⟩, p.val.2⟩
  left_inv p := by cases p; rfl
  right_inv p := by cases p; rfl

abbrev PhysicalGroupResidues {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (groups : Finset G) :=
  ∀ a : ↥(physicalPrimeGroups P groups), ZMod a.val.2.val

noncomputable def physicalGroupResidueVector {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {groups : Finset G} (r : PhysicalGroupResidues P groups) :
    PhysicalResidues (fun g : ↥groups => P g.val) :=
  fun p => r (physicalPrimeGroupEquiv P groups p)

theorem physical_group_marked_primes {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (groups : Finset G)
    (L : PhysicalMarkLists P J ell)
    (p : PhysicalPrime (fun g : ↥groups => P g.val)) :
    p ∈ physicalMarkedPrimes (fun g : ↥groups => L g.val) ↔
      (⟨p.1.val, p.2⟩ : PhysicalPrime P) ∈ physicalMarkedPrimes L := by
  rw [mem_physical_marked_primes, mem_physical_marked_primes]
  rfl

theorem physical_group_residue_path_factorization {G : Type*} [Fintype G]
    [DecidableEq G] {P : G → Finset ℕ} {J ell : ℕ}
    (hP : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (groups : Finset G) (labels : ℕ → PhysicalMarkLists P J ell)
    (visits : Finset ℕ) (offset : ℕ → ℤ) (q : ℕ → ℝ)
    (r : PhysicalGroupResidues P groups) :
    (∏ a : ↥(physicalPrimeGroups P groups), activeResidueWeight visits
      (visits.filter (fun j => a.val ∈ physicalMarkedPrimes (labels j)))
      (fun j => -(offset j : ZMod a.val.2.val)) (fun j => 1 - q j) (r a)) =
    ∏ j ∈ visits, physicalResidueVertexWeight
      (fun g : ↥groups => labels j g.val) (q j)
      (physicalTranslateResidues (physicalGroupResidueVector r) (offset j)) := by
  classical
  rw [physical_residue_vertex_path_factorization
    (fun g h hgh => hP (fun hval => hgh (Subtype.ext hval)))
    (fun g => hprime g.val)]
  rw [← (physicalPrimeGroupEquiv P groups).prod_comp]
  apply prod_congr rfl
  intro p _
  simp only [physicalGroupResidueVector, physicalPrimeGroupEquiv,
    Equiv.coe_fn_mk, physical_group_marked_primes]
  rfl




end Bounty
end

