   have hexp : ∀v∈Set.Icc a b,
       ((∫z in periodDomain,g (cuspCoordinateLift (v,z)))/(v:ℂ)^3)=
         (((9*Real.sqrt 3/2:ℝ):ℂ)*scatteringCoefficient s h)*
           (ρ v*((v:ℂ)^(-s-1)*sourceFourierKernel s (cuspFrequency h*v))) := by
     intro v hv
