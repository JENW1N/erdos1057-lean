lemma admissiblePrimeGood (K:Ideal (_root_.OAI.ActualEisensteinCubic.O)) (hK:Admissible K) (P:PrimeIndex K) : lambda∉P.val :=
  (hK.2.2 P.val (Multiset.mem_toFinset.mp P.property)).1

theorem quadraticRow_eq_primeIndex (K:Ideal (_root_.OAI.ActualEisensteinCubic.O)) (hK:Admissible K) (x:(_root_.OAI.ActualEisensteinCubic.O)) :
    let : ∀ P : PrimeIndex K, P.val.IsMaximal := primeIndexMaximal K
    quadraticRow K x=finiteSexticRow (fun P:PrimeIndex K=>P.val)
      (admissiblePrimeGood K hK) (fun _=>3) x := by
  let : ∀ P : PrimeIndex K, P.val.IsMaximal := primeIndexMaximal K
  change quadraticRow K x=finiteSexticRow (fun P:PrimeIndex K=>P.val)
    (admissiblePrimeGood K hK) (fun _=>3) x
  have hs:∀I∈({K}:Finset (Ideal (_root_.OAI.ActualEisensteinCubic.O))),Admissible I:=by
    intro I hI
    simpa only [Finset.mem_singleton.mp hI] using hK
  have heq:primePool ({K}:Finset (Ideal (_root_.OAI.ActualEisensteinCubic.O)))=primeSupport K:=by
    simp [primePool,primeSupport]
  let e:primePool ({K}:Finset (Ideal (_root_.OAI.ActualEisensteinCubic.O)))≃PrimeIndex K:={
    toFun:=fun P=>⟨P.val,heq ▸ P.property⟩
    invFun:=fun P=>⟨P.val,heq.symm ▸ P.property⟩
    left_inv:=fun _=>rfl
    right_inv:=fun _=>rfl }
  rw [quadraticRow_eq_pool {K} hs K (Finset.mem_singleton_self K) x,
    idealSupport_singleton_univ]
  simp only [QuadraticInitialBound.quadraticRow,finiteSquarefreeRow,Finset.prod_pow,
    finiteSexticRow,MulChar.pow_apply' _ (by decide : (3:ℕ)≠0)]
  congr 1
  exact Fintype.prod_equiv e _ _ (fun P=>rfl)

theorem completedLocalExponent_residual (I F Q:Ideal (_root_.OAI.ActualEisensteinCubic.O)) (hFQ:F∣Q)
    (P:PrimeIndex (rowResidualPart I Q)) : completedLocalExponent I F P.val=1 := by
  have h:=rowResidualPart_prime_exponent I Q P.val (Multiset.mem_toFinset.mp P.property)
  have hnot:¬P.val∣F:=fun hd=>h.2.2 (hd.trans hFQ)
  simp only [completedLocalExponent,h.2.1,if_neg hnot,mul_zero,add_zero,Nat.reduceMod]




def residualQuadraticPhase (K:Ideal (_root_.OAI.ActualEisensteinCubic.O)) (u:(_root_.OAI.ActualEisensteinCubic.O)ˣ) (m:ℕ) (D E:Ideal (_root_.OAI.ActualEisensteinCubic.O)) : ℂ :=
  quadraticRow K ((u.val*lambda^m)*primaryGenerator (D*E))







