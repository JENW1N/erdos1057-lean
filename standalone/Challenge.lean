open Finset Filter
open scoped Topology
theorem eventually_candidate_localized_mass_harmonic_lower {c eps q : ℝ} {r J : ℕ}
    (hc : 0 < c) (hr : 0 < r) (heps0 : 0 ≤ eps) (heps1 : eps ≤ 1/10) (hq : 0 ≤ q)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1)
    (hepsr : eps * (r : ℝ) ≤ 1/400) (hJ : 1000 * (r : ℝ) ≤ 2^J) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J < jStar →
      Real.exp L * ((((2 * Real.log 2 - 1) / 16) / ((6/5 : ℝ) * c)) / L) *
        candidateSmallPHarmonicMass c L q (Real.exp ((c / 100) * L)) *
        candidatePrefixRestHarmonicMass c L eps r jStar J hr ≤
      candidateLocalizedWindowMass c L eps q r jStar J hr := by
  filter_upwards [eventually_candidate_rest_free_prime_count hc hr heps0 heps1 hcenter hepsr hJ]
    with L hcount
  intro jStar hJstar
  have h := indexed_free_prime_mass_lower
    (candidateSmallPSet c L (Real.exp ((c / 100) * L))) (candidateQBand (c * L) 0)
    (candidatePWeight c L q)
    (orderedSlotProduct (candidatePrefixRestChoices c L eps r jStar J hr))
    ((r.factorial : ℝ)^(candidateQIndices c L).card) (Real.exp L)
    ((((2 * Real.log 2 - 1) / 16) / ((6/5 : ℝ) * c)) / L)
    (by positivity) (fun p _ => candidate_P_weight_nonneg c L hq p) (hcount jStar hJstar)
  rw [candidate_small_P_weight_harmonic_sum, ← candidate_prefix_rest_mass_eq_tuple_sum] at h
  exact h

theorem exists_candidate_localized_window_mass_lower {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) :
    ∃ eps : ℝ, ∃ J : ℕ, ∃ K : ℝ, 0 < eps ∧ eps ≤ 1/10 ∧ 0 < K ∧
      ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J < jStar →
        K * (Real.exp L / L) * candidateOneMarkedHarmonicMass c L q *
          candidateQHarmonicMass c L r jStar ≤
        candidateLocalizedWindowMass c L eps q r jStar J hr := by
  obtain ⟨eps, J, heps, heps1, hepsr, hJ⟩ := exists_candidate_localization_parameters hr
  obtain ⟨rho, hrho, hrest⟩ := exists_candidate_prefix_rest_mass_fraction hc heps heps1 r J hr
  let D : ℝ := ((2 * Real.log 2 - 1) / 16) / ((6/5 : ℝ) * c)
  have hD : 0 < D := div_pos wide_prime_window_lower_constant_pos (by positivity)
  refine ⟨eps, J, D * rho / 2, heps, heps1, by positivity, ?_⟩
  filter_upwards [eventually_candidate_localized_mass_harmonic_lower hc hr heps.le heps1 hq0
      hcenter hepsr hJ, hrest,
    eventually_candidate_small_P_half_mass hc hq0 hq1 (by positivity : 0 < c / 100),
    eventually_gt_atTop (0 : ℝ)] with L hmass hrmass hsmall hL
  intro jStar hJstar
  have hQ0 : 0 ≤ candidateQHarmonicMass c L r jStar := by
    apply tsum_nonneg
    intro n
    exact div_nonneg (candidate_Q_weight_nonneg c L r jStar n) (Nat.cast_nonneg n)
  have hparts : (candidateOneMarkedHarmonicMass c L q / 2) *
        (rho * candidateQHarmonicMass c L r jStar) ≤
      candidateSmallPHarmonicMass c L q (Real.exp ((c / 100) * L)) *
        candidatePrefixRestHarmonicMass c L eps r jStar J hr :=
    mul_le_mul hsmall (hrmass jStar hJstar) (mul_nonneg hrho.le hQ0)
      (candidate_small_P_harmonic_nonneg c L q _ hq0)
  calc
    _ = (Real.exp L * (D / L)) *
        ((candidateOneMarkedHarmonicMass c L q / 2) *
          (rho * candidateQHarmonicMass c L r jStar)) := by ring
    _ ≤ (Real.exp L * (D / L)) *
        (candidateSmallPHarmonicMass c L q (Real.exp ((c / 100) * L)) *
          candidatePrefixRestHarmonicMass c L eps r jStar J hr) :=
      mul_le_mul_of_nonneg_left hparts (by positivity)
    _ = Real.exp L * (D / L) *
        candidateSmallPHarmonicMass c L q (Real.exp ((c / 100) * L)) *
          candidatePrefixRestHarmonicMass c L eps r jStar J hr := by ring
    _ ≤ _ := hmass jStar hJstar
end

