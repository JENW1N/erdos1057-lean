open scoped BigOperators
theorem prime_band_product_character_factor {q : ℕ} (χ : DirichletCharacter ℂ q)
    (S : Finset ℕ) (c : ℕ) (v : ℝ) :
    (∑ p ∈ S, (1 / (v * (p : ℝ))) • χ ((c * p : ℕ) : ZMod q)) =
      (1 / v : ℝ) • (χ (c : ZMod q) * ∑ p ∈ S, (1 / (p : ℝ)) • χ (p : ZMod q)) := by
  rw [Finset.mul_sum, Finset.smul_sum]
  apply Finset.sum_congr rfl
  intro p _
  simp only [Nat.cast_mul, map_mul, Complex.real_smul,
    Complex.ofReal_mul, one_div, mul_inv_rev]
  ring

theorem prime_band_product_mixture_bound {X : Type*} [Fintype X] {q : ℕ}
    (χ : DirichletCharacter ℂ q) (S : X → Finset ℕ) (c : X → ℕ)
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (hmass : ∑ x, μ x ≤ 1)
    {v B : ℝ} (hv : 0 < v) (hB : 0 ≤ B)
    (hinner : ∀ x, ‖∑ p ∈ S x, (1 / (p : ℝ)) • χ (p : ZMod q)‖ ≤ B) :
    ‖∑ x, (μ x : ℂ) * ∑ p ∈ S x,
      (1 / (v * (p : ℝ))) • χ ((c x * p : ℕ) : ZMod q)‖ ≤ B / v := by
  have hlocal (x : X) : ‖∑ p ∈ S x,
      (1 / (v * (p : ℝ))) • χ ((c x * p : ℕ) : ZMod q)‖ ≤ B / v := by
    rw [prime_band_product_character_factor, norm_smul, norm_mul,
      Real.norm_eq_abs, abs_of_pos (one_div_pos.mpr hv)]
    calc
      _ ≤ (1 / v) * (1 * B) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul (χ.norm_le_one _) (hinner x) (norm_nonneg _) (by norm_num))
          (by positivity)
      _ = _ := by ring
  calc
    _ ≤ ∑ x, ‖(μ x : ℂ) * ∑ p ∈ S x,
        (1 / (v * (p : ℝ))) • χ ((c x * p : ℕ) : ZMod q)‖ := norm_sum_le _ _
    _ = ∑ x, μ x * ‖∑ p ∈ S x,
        (1 / (v * (p : ℝ))) • χ ((c x * p : ℕ) : ZMod q)‖ := by
      apply Finset.sum_congr rfl
      intro x _
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hμ x)]
    _ ≤ ∑ x, μ x * (B / v) := Finset.sum_le_sum (fun x _ =>
      mul_le_mul_of_nonneg_left (hlocal x) (hμ x))
    _ = (∑ x, μ x) * (B / v) := (Finset.sum_mul _ _ _).symm
    _ ≤ B / v := by simpa only [one_mul] using
      mul_le_mul_of_nonneg_right hmass (div_nonneg hB hv.le)
end

