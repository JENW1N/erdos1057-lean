section

/- Retention indices may be reindexed without changing any ordered birth address. -/

open Finset Classical
namespace Bounty

abbrev boundedGhostMemoryPermute {P Z : Type*} {t B : ℕ}
    (s : BoundedOrderedState P Z t B) (τ : Equiv.Perm (Fin s.2.1.val)) :
    BoundedOrderedState P Z t B := (s.1, ⟨s.2.1, s.2.2 ∘ τ⟩)

noncomputable def boundedGhostEventPermEquiv {P Z : Type*} {t B : ℕ}
    (s : BoundedOrderedState P Z t B) (τ : Equiv.Perm (Fin s.2.1.val)) :
    BoundedGhostEvent t B s ≃ BoundedGhostEvent t B (boundedGhostMemoryPermute s τ) :=
  Equiv.sigmaCongrRight fun _ =>
    Equiv.prodCongr (Equiv.finsetCongr τ.symm) (Equiv.refl _)

theorem boundedGhostEventPermEquiv_apply {P Z : Type*} {t B : ℕ}
    (s : BoundedOrderedState P Z t B) (τ : Equiv.Perm (Fin s.2.1.val))
    (e : BoundedGhostEvent t B s) :
    boundedGhostEventPermEquiv s τ e =
      ⟨e.1, e.2.1.map τ.symm.toEmbedding, e.2.2⟩ := rfl

theorem bounded_ghost_event_perm_weight {P Z : Type*} {t B : ℕ}
    (A D C ν : Z → ℝ) (s : BoundedOrderedState P Z t B)
    (τ : Equiv.Perm (Fin s.2.1.val)) (e : BoundedGhostEvent t B s) :
    boundedGhostEventWeight A D C ν t B (boundedGhostMemoryPermute s τ)
        (boundedGhostEventPermEquiv s τ e) = boundedGhostEventWeight A D C ν t B s e := by
  rcases e with ⟨b, retained, births⟩
  rw [boundedGhostEventPermEquiv_apply]
  have hcomp : univ \ retained.map τ.symm.toEmbedding =
      (univ \ retained).map τ.symm.toEmbedding := by
    rw [Finset.map_sdiff]
    simp
  simp only [boundedGhostEventWeight, boundedGhostMemoryPermute, card_map,
    hcomp, prod_map, Function.comp_apply, Equiv.coe_toEmbedding, Equiv.apply_symm_apply]

theorem bounded_ghost_event_perm_test {P Z : Type*} [Fintype Z] [DecidableEq Z]
    {t B : ℕ} (s : BoundedOrderedState P Z t B)
    (τ : Equiv.Perm (Fin s.2.1.val)) (e : BoundedGhostEvent t B s)
    (f : BoundedOrderedState P Z t B → ℂ) (hf : BoundedOrderedSymmetric f) :
    f (boundedGhostEventTarget t B (boundedGhostMemoryPermute s τ)
        (boundedGhostEventPermEquiv s τ e)) = f (boundedGhostEventTarget t B s e) := by
  rw [boundedGhostEventPermEquiv_apply]
  rcases e with ⟨b, retained, births⟩
  have hocc : orderedTupleOccupancy
      (retainedBirthTuple (s.2.2 ∘ τ) (retained.map τ.symm.toEmbedding) births) =
      orderedTupleOccupancy (retainedBirthTuple s.2.2 retained births) := by
    simp only [retained_birth_tuple_occupancy, retainedTupleOccupancy, sum_map,
      Function.comp_apply, Equiv.coe_toEmbedding, Equiv.apply_symm_apply]
  have hext := symmetric_tuple_equal_on_occupancy (boundedOrderedZeroExtension f s.1)
    ((boundedOrderedZeroExtension_symmetric_iff f).mpr hf s.1) _ _ hocc
  by_cases h : retained.card + b.val ≤ B
  · simpa [boundedGhostEventTarget, boundedGhostMemoryPermute,
      boundedOrderedZeroExtension, retainedBirthTuple, h] using hext
  · simpa [boundedGhostEventTarget, boundedGhostMemoryPermute,
      retainedBirthTuple, h] using hf s.1 s.2.1 s.2.2 τ




end Bounty
end

section

/- Exact causal integration on the original dependent paths, including arbitrary path observables. -/

open Finset Classical

namespace Bounty

universe u v w z

section Integral
variable {K : Type u} {X : Type v} (E : K → X → Type w)
    [∀ k x, Fintype (E k x)] (target : ∀ k x, E k x → X)
    (weight : ∀ k x, E k x → ℝ)

noncomputable def finiteEventPathIntegral (steps : List K) (x : X)
    (F : FiniteEventPath E target steps x → ℝ) : ℝ :=
  let _ := finiteEventPathFintype E target steps x
  ∑ p, finiteEventPathWeight E target weight steps x p * F p

theorem finite_event_path_integral_nil (x : X)
    (F : FiniteEventPath E target [] x → ℝ) :
    finiteEventPathIntegral E target weight [] x F = F PUnit.unit := by
  change (∑ p : PUnit.{w + 1}, 1 * F p) = F PUnit.unit
  simpa only [one_mul] using Fintype.sum_subsingleton (fun p : PUnit.{w + 1} => 1 * F p) PUnit.unit

theorem finite_event_path_integral_cons (k : K) (steps : List K) (x : X)
    (F : FiniteEventPath E target (k :: steps) x → ℝ) :
    finiteEventPathIntegral E target weight (k :: steps) x F =
      ∑ e : E k x, weight k x e * finiteEventPathIntegral E target weight steps
        (target k x e) (fun p => F ⟨e, p⟩) := by
  let _ : ∀ e : E k x, Fintype (FiniteEventPath E target steps (target k x e)) :=
    fun e => finiteEventPathFintype E target steps (target k x e)
  change (∑ p : (e : E k x) × FiniteEventPath E target steps (target k x e),
    (weight k x p.1 * finiteEventPathWeight E target weight steps _ p.2) * F p) = _
  rw [Fintype.sum_sigma]
  simp only [finiteEventPathIntegral, mul_sum, mul_assoc]



















end Integral

end Bounty
end

section

/- The actual bounded edge row has the existing uniform length-weighted row bound. -/

open Finset Classical

namespace Bounty

theorem unrestricted_bounded_length_row_le_raw {P : Type*} [Fintype P]
    (n : P → ℕ) (Δ D : ℤ) (μ : P → ℝ) (ρ V v : ℝ)
    (hρ : 0 ≤ ρ) (hV : 0 ≤ V) (hv : 0 ≤ v) (hμ : ∀ p, 0 ≤ μ p)
    (t B : ℕ) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    (∑ e : UnrestrictedBoundedEvent n Δ D t B s,
      |unrestrictedBoundedEventWeight n Δ D μ ρ V t B s e| *
        v ^ (unrestrictedBoundedEventTarget n Δ D t B s e).2.1.val) ≤
      unrestrictedEdgeRowMass s.1 s.2.2 (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ ρ V v
        (unrestrictedResidueEligible n Δ D s.2.2) := by
  simp only [Fintype.sum_sigma, Fintype.sum_prod_type,
    unrestrictedEdgeRowMass, unrestrictedEdgeChoiceRowMass]
  apply sum_le_sum
  intro stores _
  apply sum_le_sum
  intro promotions _
  apply sum_le_sum
  intro e _
  apply sum_le_sum
  intro fresh _
  rw [abs_of_nonneg (unrestrictedBoundedEventWeight_nonneg n Δ D μ hρ hV hμ t B s _)]
  by_cases h : unrestrictedResidueStorageAllowed n D s.1 stores ∧
      (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) stores promotions e).1 ≤ B
  · simp [unrestrictedBoundedEventWeight, unrestrictedBoundedEventTarget, h.1, h.2]
  · simp only [unrestrictedBoundedEventWeight, h, if_false, zero_mul]
    exact mul_nonneg (unrestrictedEdgeEventMass_nonneg _ _ _ _ _ μ hρ hV hμ _ _ _ _)
      (pow_nonneg hv _)

theorem unrestricted_bounded_length_row_le {P : Type*} [Fintype P]
    (n : P → ℕ) (Δ D : ℤ) (μ : P → ℝ) {ρ V v vmin : ℝ}
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : vmin ≤ V) (hμ : ∀ p, 0 ≤ μ p) (hmass : ∑ p, μ p ≤ 2)
    (t B T : ℕ) (ht : t ≤ T)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) :
    (∑ e : UnrestrictedBoundedEvent n Δ D t B s,
      |unrestrictedBoundedEventWeight n Δ D μ ρ V t B s e| *
        v ^ (unrestrictedBoundedEventTarget n Δ D t B s e).2.1.val) ≤
      v ^ s.2.1.val * unrestrictedEdgeRowBound ρ v vmin T := by
  exact (unrestricted_bounded_length_row_le_raw n Δ D μ ρ V v hρ0.le
    (hvmin.trans_le hV).le (zero_lt_one.trans hv).le hμ t B s).trans
      (unrestricted_edge_row_mass_le s.1 s.2.2 (unrestrictedResidueSeed n)
        (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ hρ0 hρ1 hv hvmin hV hμ hmass
        (unrestrictedResidueEligible n Δ D s.2.2)
        (unrestrictedResidueEligible_translated_hit n Δ D s.2.2) T ht)

end Bounty
end

section

/- Scalar domination of nonnegative pair weights. -/

open Finset

namespace Bounty

theorem sum_nonneg_pair_coefficient_bound {ι : Type*} (F : Finset ι)
    (A f g : ι → ℝ) {K : ℝ} (hK : 0 ≤ K)
    (hA : ∀ v ∈ F, 0 ≤ A v) (hf : ∀ v ∈ F, f v ≤ K)
    (hg0 : ∀ v ∈ F, 0 ≤ g v) (hg : ∀ v ∈ F, g v ≤ K) :
    (∑ v ∈ F, A v*f v*g v) ≤ K^2*(∑ v ∈ F, A v) := by
  calc
    _ ≤ ∑ v ∈ F, A v*K^2 := by
      apply sum_le_sum
      intro v hv
      have hfg : f v*g v ≤ K*K := mul_le_mul (hf v hv) (hg v hv) (hg0 v hv) hK
      simpa only [pow_two, mul_assoc] using mul_le_mul_of_nonneg_left hfg (hA v hv)
    _ = _ := by rw [← sum_mul]; ring

end Bounty
end

