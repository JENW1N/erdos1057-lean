section

/- Local phase products along the original schedule and its four-step edge positions. -/

open Finset
open scoped Classical
namespace Bounty

theorem finite_schedule_local_phase_product
    {X : Type*} (E : ℕ → X → Type*) (target : ∀ i x, E i x → X)
    (phase : ∀ i x, E i x → ℂ) (m : ℕ) (x : X)
    (p : FiniteEventPath E target (List.range m) x) :
    finiteEventLocalPhase E target phase (List.range m) x p =
      ∏ i : Fin m, phase i.val (finiteScheduleOccurrence E target m x p i).1
        (finiteScheduleOccurrence E target m x p i).2 := by
  rw [finite_event_local_phase_occurrences]
  let F : Fin m → ℂ := fun i => phase i.val (finiteScheduleOccurrence E target m x p i).1
    (finiteScheduleOccurrence E target m x p i).2
  change _ = ∏ i : Fin m, F i
  rw [← (finCongr (show (List.range m).length = m from List.length_range)).prod_comp F]
  apply prod_congr rfl
  intro i _
  exact (finite_schedule_occurrence_apply E target phase m x p
    ((finCongr (show (List.range m).length = m from List.length_range)) i)).symm

theorem four_step_sparse_product (n : ℕ) (f : Fin (4 * n + 1) → ℂ)
    (hf : ∀ i, i.val % 4 ≠ 2 → f i = 1) :
    (∏ i : Fin (4 * n + 1), f i) =
      ∏ j : Fin n, f ⟨4 * j.val + 2, by have := j.isLt; omega⟩ := by
  symm
  apply prod_bij_ne_one (fun j _ _ => (⟨4 * j.val + 2, by have := j.isLt; omega⟩ : Fin (4 * n + 1)))
  · intros; exact mem_univ _
  · intro a _ _ b _ _ hab
    apply Fin.ext
    have hv := congrArg Fin.val hab
    dsimp only at hv
    omega
  · intro i _ hi
    have hm : i.val % 4 = 2 := by
      by_contra h
      exact hi (hf i h)
    let j : Fin n := ⟨i.val / 4, by have := i.isLt; omega⟩
    have he : (⟨4 * j.val + 2, by have := j.isLt; omega⟩ : Fin (4 * n + 1)) = i := by
      apply Fin.ext
      dsimp only [j]
      omega
    refine ⟨j, mem_univ _, ?_, he⟩
    simpa only [he] using hi
  · intros; rfl

end Bounty
