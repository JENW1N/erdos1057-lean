      finiteTwoKernelAverage μ ν KA KB x y (fun d e => χ d * ψ e * F d e)) =
    ∑ d, ∑ e, ((μ d : ℂ) * (χ d * finiteKernelTestTransform μ KA f d)) *
      ((ν e : ℂ) * (ψ e * finiteKernelTestTransform ν KB g e)) * F d e := by
  rw [finite_two_kernel_pairing_fubini]
  apply Finset.sum_congr rfl
  intro d _
  apply Finset.sum_congr rfl
  intro e _
  ring

