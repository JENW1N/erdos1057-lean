section

/- The actual candidate tuple multiplier has arbitrary saving away from one
cell-scale major region, with no single-dyad support assumption. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem exists_candidate_cell_minor_bound {c : ℝ} (hc : 0 < c) (J : ℕ) (Rsave : ℝ) :
    ∃ q : ℝ, 0 ≤ q ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
      let P := fun g : S => candidatePBand (c*L) g.val
      let V := fun g : S => ∑ p ∈ P g, 1/(p : ℝ)
      ∀ (ell : ℕ) (probes : S → Finset (Fin J)) (r t : Finset S)
        (A B : Finset (RepeatedBigFlatIndex S J ell)),
        A ⊆ r.sigma (repeatedBigPrimeProbeSlots probes) → A.Nonempty →
        B ⊆ t.sigma (repeatedBigPrimeProbeSlots probes) → B.Nonempty →
      ∀ (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex S J ell) ∉ A ∪ B)
        (hAB : Disjoint A B) (k : ℤ)
        (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ),
        (∀ a, ‖bA a‖ ≤ 1) → (∀ b, ‖bB b‖ ≤ 1) →
      ∀ HA HB : ℝ, 0 ≤ HA → 0 ≤ HB →
        (∀ a, bA a ≠ 0 → HA ≤ (∏ i, (a i).val : ℕ)) →
        (∀ b, bB b ≠ 0 → HB ≤ (∏ i, (b i).val : ℕ)) →
      ∀ θ, θ ∉ productMajorArcSet k L q HA HB →
        ‖physicalAuxFourierMultiplier P V A B hU hAB k bA bB θ‖ ≤ L^(-Rsave) := by
  obtain ⟨κ, _, hatom⟩ := exists_candidate_subset_atom_inputs hc J
  let q₀ := max 0 (2*κ+2+2*(Rsave+3)+3)
  have hq₀ : 0 ≤ q₀ := le_max_left _ _
  refine ⟨q₀+1, by positivity, ?_⟩
  filter_upwards [hatom,
    eventually_candidate_subset_product_range hc (ε := 1) (by norm_num) J,
    eventually_mul_rpow_le_exp_rpow q₀ 2 (c := (1/10 : ℝ)) (by norm_num),
    eventually_ge_atTop (512 : ℝ)] with L ha hrange hlarge hL
  intro S hS P V ell probes r t A B hA hAne hB hBne hU hAB k bA bB hbA hbB
    HA HB hHA hHB hcellA hcellB θ hminor
  have hrangeA := hrange S hS ell probes r A hA hAne
  have hrangeB := hrange S hS ell probes t B hB hBne
  have hposA (a : ∀ i : A, P i.val.1) : 0 < ∏ i, (a i).val := by
    have hh := (Real.exp_pos _).trans_le (hrangeA a).1
    exact_mod_cast hh
  have hposB (b : ∀ i : B, P i.val.1) : 0 < ∏ i, (b i).val := by
    have hh := (Real.exp_pos _).trans_le (hrangeB b).1
    exact_mod_cast hh
  have hlogA (a : ∀ i : A, P i.val.1) : Real.log (∏ i, (a i).val : ℕ) ≤ L := by
    have hp : (0 : ℝ) < (∏ i, (a i).val : ℕ) := by exact_mod_cast hposA a
    simpa only [Real.log_exp, one_mul] using Real.log_le_log hp (hrangeA a).2
  have hlogB (b : ∀ i : B, P i.val.1) : Real.log (∏ i, (b i).val : ℕ) ≤ L := by
    have hp : (0 : ℝ) < (∏ i, (b i).val : ℕ) := by exact_mod_cast hposB b
    simpa only [Real.log_exp, one_mul] using Real.log_le_log hp (hrangeB b).2
  exact physical_aux_fourier_cell_minor_bound P V A B hU hAB k bA bB (ha S hS).1
    (fun _ => rfl) hbA hbB L κ q₀ Rsave HA HB hL hq₀ (le_max_right _ _)
    hHA hHB hposA hposB (fun a => hlarge.trans (hrangeA a).1)
    (fun b => hlarge.trans (hrangeB b).1) hlogA hlogB hcellA hcellB
    ((ha S hS).2 ell probes r A hA) ((ha S hS).2 ell probes t B hB) θ hminor

end Bounty
end

section

/- Separate endpoint energies from the identical-endpoint cutoff bound. -/

open Finset Real

namespace Bounty

theorem harmonic_source_energy_of_self_cutoff {Y B : ℝ} (hY : 0 < Y)
    (Z a v : ℝ) (F : ℤ → ℂ)
    (hself : (8/Y)*sqrt (∑ n ∈ harmonicCommonSupport Y,
        ‖(harmonicCommonCutoff ((n:ℝ)/Y):ℂ)*F n‖^2)*
      sqrt (∑ n ∈ harmonicCommonSupport Y,
        ‖(harmonicCommonCutoff ((n:ℝ)/Y):ℂ)*F n‖^2) ≤ B) :
    (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellSource Y Z a v F n‖^2) ≤ 8*Y*B := by
  have hE : 0 ≤ ∑ n ∈ harmonicCommonSupport Y,
      ‖(harmonicCommonCutoff ((n:ℝ)/Y):ℂ)*F n‖^2 := sum_nonneg (fun _ _ => sq_nonneg _)
  rw [mul_assoc, mul_self_sqrt hE] at hself
  have hs : 8*(∑ n ∈ harmonicCommonSupport Y,
      ‖(harmonicCommonCutoff ((n:ℝ)/Y):ℂ)*F n‖^2) ≤ B*Y := by
    apply (div_le_iff₀ hY).1
    simpa only [div_mul_eq_mul_div] using hself
  have hb := harmonic_cell_source_square_energy hY Z a v F
  nlinarith

theorem harmonic_target_energy_of_self_cutoff {Y B : ℝ} (hY : 0 < Y)
    (b : ℝ) (F : ℤ → ℂ)
    (hself : (8/Y)*sqrt (∑ n ∈ harmonicCommonSupport Y,
        ‖(harmonicCommonCutoff ((n:ℝ)/Y):ℂ)*F n‖^2)*
      sqrt (∑ n ∈ harmonicCommonSupport Y,
        ‖(harmonicCommonCutoff ((n:ℝ)/Y):ℂ)*F n‖^2) ≤ B) :
    (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellTarget Y b F n‖^2) ≤ Y*B/8 := by
  rw [harmonic_cell_target_square_energy]
  have hE : 0 ≤ ∑ n ∈ harmonicCommonSupport Y,
      ‖(harmonicCommonCutoff ((n:ℝ)/Y):ℂ)*F n‖^2 := sum_nonneg (fun _ _ => sq_nonneg _)
  rw [mul_assoc, mul_self_sqrt hE] at hself
  have hs : 8*(∑ n ∈ harmonicCommonSupport Y,
      ‖(harmonicCommonCutoff ((n:ℝ)/Y):ℂ)*F n‖^2) ≤ B*Y := by
    apply (div_le_iff₀ hY).1
    simpa only [div_mul_eq_mul_div] using hself
  linarith

theorem harmonic_single_energies_of_self_cutoff {Y L T : ℝ} (hY : 0 < Y) (hL : 8 ≤ L)
    (Z a b v : ℝ) (F : ℤ → ℂ)
    (hself : (8/Y)*sqrt (∑ n ∈ harmonicCommonSupport Y,
        ‖(harmonicCommonCutoff ((n:ℝ)/Y):ℂ)*F n‖^2)*
      sqrt (∑ n ∈ harmonicCommonSupport Y,
        ‖(harmonicCommonCutoff ((n:ℝ)/Y):ℂ)*F n‖^2) ≤ L^T) :
    (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellSource Y Z a v F n‖^2) ≤ Y*L^(T+1) ∧
    (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellTarget Y b F n‖^2) ≤ Y*L^(T+1) := by
  have hLp : 0 < L := by linarith
  have hpower : 8*Y*L^T ≤ Y*L^(T+1) := by
    rw [Real.rpow_add hLp,Real.rpow_one]
    nlinarith [mul_le_mul_of_nonneg_right hL (mul_nonneg hY.le (Real.rpow_nonneg hLp.le T))]
  refine ⟨(harmonic_source_energy_of_self_cutoff hY Z a v F hself).trans hpower,?_⟩
  apply (harmonic_target_energy_of_self_cutoff hY b F hself).trans
  apply le_trans _ hpower
  nlinarith [mul_nonneg hY.le (Real.rpow_nonneg hLp.le T)]

end Bounty
end

section

/- The integrated cutoff bound with an arbitrary base Mellin-frequency shift. -/

open Finset MeasureTheory

namespace Bounty

theorem harmonic_normalized_four_box_integrated_tail_shifted {Y : ℝ} (hY : 0 < Y)
    (a b R E w : ℝ) (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c)
    (henergy : ∀ u, (∫ s in Set.Icc a b,
      ‖(∑ d ∈ D, δ d * harmonicMellinWeight (s+w+2*Real.pi*u) d) *
        (∑ a ∈ A, α a * harmonicMellinWeight (s+w+2*Real.pi*u) a) *
        (∑ b ∈ B, β b * harmonicMellinWeight (s+w+2*Real.pi*u) b) *
        (∑ c ∈ C, γ c * harmonicMellinWeight (s+w+2*Real.pi*u) c)‖^2) ≤ E) :
    IntegrableOn (fun s => ‖harmonicNormalizedFourBoxError Y (s+w) R D A B C δ α β γ‖^2)
      (Set.Icc a b) ∧
    (∫ s in Set.Icc a b, ‖harmonicNormalizedFourBoxError Y (s+w) R D A B C δ α β γ‖^2) ≤
      (∫ u in {u : ℝ | R < ‖u‖}, ‖harmonicWindowLogFourier u‖)^2 * E := by
  let P : ℝ → ℂ := fun s =>
    (∑ d ∈ D, δ d * harmonicMellinWeight (s+w) d) *
      (∑ a ∈ A, α a * harmonicMellinWeight (s+w) a) *
      (∑ b ∈ B, β b * harmonicMellinWeight (s+w) b) *
      (∑ c ∈ C, γ c * harmonicMellinWeight (s+w) c)
  let M : ℝ := (∑ d ∈ D, ‖δ d‖) * (∑ a ∈ A, ‖α a‖) *
    (∑ b ∈ B, ‖β b‖) * (∑ c ∈ C, ‖γ c‖)
  have hP : Continuous P := by dsimp [P,harmonicMellinWeight]; fun_prop
  have hPM (s : ℝ) : ‖P s‖ ≤ M := by
    have hb (S : Finset ℕ) (f : ℕ → ℂ) (hS : ∀ n ∈ S, 0 < n) :
        ‖∑ n ∈ S, f n * harmonicMellinWeight (s+w) n‖ ≤ ∑ n ∈ S, ‖f n‖ := by
      simpa only [mul_comm,div_one] using finite_mellin_norm_le_mass S f (s+w) 1
        zero_lt_one (fun n hn => by exact_mod_cast (Nat.succ_le_iff.mpr (hS n hn)))
    dsimp only [P,M]
    simp only [norm_mul]
    exact mul_le_mul (mul_le_mul (mul_le_mul (hb D δ hD) (hb A α hA)
      (norm_nonneg _) (by positivity)) (hb B β hB) (norm_nonneg _) (by positivity))
      (hb C γ hC) (norm_nonneg _) (by positivity)
  have he : ∀ u, (∫ s in Set.Icc a b, ‖P (s+2*Real.pi*u)‖^2) ≤ E := by
    intro u
    simpa only [P,add_right_comm] using henergy u
  have ht := harmonic_window_tail_square a b Y R hP (show 0 ≤ M by dsimp [M]; positivity) hPM he
  have hid (s : ℝ) : (∫ u in {u : ℝ | R < ‖u‖},
      harmonicWindowLogFourier u * physicalMellinPhase (-2*Real.pi*u) Y *
        P (s+2*Real.pi*u)) = harmonicNormalizedFourBoxError Y (s+w) R D A B C δ α β γ := by
    simpa only [P,add_right_comm] using
      (harmonic_normalized_four_box_error_eq_tail hY (s+w) R D A B C δ α β γ hD hA hB hC).symm
  simpa only [hid] using ht

end Bounty
end

section

/- The full signed physical weight includes its deterministic history on every schedule. -/

open scoped Classical
namespace Bounty
section General
variable {I K : Type} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => P g)
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → P g → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

noncomputable def physicalFullSignedWeight (steps : List (Option (I ⊕ K)))
    (x : PhysicalFullBoundedState P J ell B)
    (p : FullPermutationMixedPath (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)) steps x) : ℂ :=
    (finiteEventPathWeight (FullPermutationMixedEvent (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)))
      (fullPermutationMixedEventTarget (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)))
      (fullPermutationMixedEventWeight (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)) ω (fun g p => β g p / V g) retention ρ V)
      steps x p : ℂ) * physicalFullHistoryPhase C k ω β ρ V steps x p

end General
section Original
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (k : Fin n → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : Fin (n + 1) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

theorem physical_original_full_signed_weight
    (x : PhysicalFullBoundedState P J ell B)
    (p : FullPermutationMixedPath (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)) ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) x) :
    physicalOriginalFineWeight C k ω β retention ρ V x p =
      physicalFullSignedWeight C k ω β retention ρ V
        ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)) x p :=
  physical_original_weight_history C k ω β retention ρ V x p

end Original
