section

/- Convert the local forest product into its exact number of constrained births in each group. -/

open Finset Classical

namespace Bounty

theorem finite_product_two_values {I : Type*} [Fintype I]
    (selected : I → Prop) [DecidablePred selected] (root atom : ℝ) :
    (∏ i, if selected i then atom else root) =
      atom ^ (univ.filter selected).card * root ^ (Fintype.card I - (univ.filter selected).card) := by
  rw [prod_ite, prod_const, prod_const]
  have hc := univ.card_filter_add_card_filter_not selected
  simp only [card_univ] at hc
  have hn : (univ.filter (fun i => ¬ selected i)).card = Fintype.card I - (univ.filter selected).card := by omega
  rw [hn]

theorem grouped_forest_cost_eq {G : Type*} [Fintype G] [DecidableEq G]
    (I : G → Type*) [∀ g, Fintype (I g)] {m : ℕ} {α : Type*}
    (ord : Fin m ≃ Sigma I) (code : BirthForestCode m) (anchor : Fin m → Option α)
    (root atom : G → ℝ) (d : G → ℕ)
    (hd : ∀ g, (univ.filter (fun i : I g =>
      code (ord.symm ⟨g, i⟩) ≠ none ∨ anchor (ord.symm ⟨g, i⟩) ≠ none)).card = d g) :
    (∏ j, match code j with
      | some _ => atom (ord j).1
      | none => match anchor j with | none => root (ord j).1 | some _ => atom (ord j).1) =
      ∏ g, atom g ^ d g * root g ^ (Fintype.card (I g) - d g) := by
  rw [← ord.symm.prod_comp]
  calc
    _ = ∏ i : Sigma I, if code (ord.symm i) ≠ none ∨ anchor (ord.symm i) ≠ none then atom i.1 else root i.1 := by
      apply prod_congr rfl
      intro i _
      simp only [Equiv.apply_symm_apply]
      cases code (ord.symm i) <;> cases anchor (ord.symm i) <;> simp
    _ = _ := by
      rw [Fintype.prod_sigma]
      apply prod_congr rfl
      intro g _
      have hh := finite_product_two_values
        (fun y : I g => code (ord.symm ⟨g, y⟩) ≠ none ∨ anchor (ord.symm ⟨g, y⟩) ≠ none)
        (root g) (atom g)
      rw [hd g] at hh
      exact hh

end Bounty
end

