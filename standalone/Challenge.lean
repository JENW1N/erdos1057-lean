/- The determinant reindexing uses only the actual nonzero coefficient support. -/

open Finset

namespace Bounty

theorem typeII_off_diagonal_energy_restrict_support (E N M H : Finset ℕ)
    (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ) :
    typeIIOffDiagonalEnergy E N M H η α aH =
      typeIIOffDiagonalEnergy E N (M.filter (fun m => α m ≠ 0)) H η α aH := by
  classical
  unfold typeIIOffDiagonalEnergy
  simp only [sum_product, sum_filter, mul_sum]
  apply sum_congr rfl
  intro e he
  apply sum_congr rfl
  intro n hn
  apply sum_congr rfl
  intro m hm
  by_cases hzero : α m = 0
  · simp [hzero, typeIIEquationTerm]
  · simp only [ne_eq, hzero, not_false_eq_true, if_true, mul_sum]
    apply sum_congr rfl
    intro h hh
    apply sum_congr rfl
    intro m' hm'
    by_cases hzero' : α m' = 0
    · simp [hzero', typeIIEquationTerm]
    · simp only [hzero', not_false_eq_true, if_true, mul_sum]

theorem typeII_off_diagonal_energy_eq_supported_determinant_sum
    (E N M H : Finset ℕ) (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ)
    {Elo U W : ℝ} {B : ℕ}
    (hElo : 0 < Elo) (hE : ∀ e ∈ E, Elo ≤ (e : ℝ))
    (hM : ∀ m ∈ M, (m : ℝ) ≤ U) (hB : U / (2 * Elo) ≤ B) (hBW : (B : ℝ) ≤ W)
    (hrough : ∀ m ∈ M, α m ≠ 0 → ∀ p ∈ m.primeFactors, W < (p : ℝ)) :
    typeIIOffDiagonalEnergy E N M H η α aH =
      ∑ y ∈ typeIIDeterminantDomain E N (M.filter (fun m => α m ≠ 0)) H
        (Icc (-(B : ℤ)) B) (Icc 0 ((M.filter (fun m => α m ≠ 0)).sup id * H.sup id)),
        typeIIShiftWeight η α aH y := by
  classical
  rw [typeII_off_diagonal_energy_restrict_support]
  apply typeII_off_diagonal_energy_eq_bounded_determinant_sum _ _ _ _ _ _ _ hElo hE
    (fun m hm => hM m (mem_filter.mp hm).1) hB hBW
  intro m hm
  exact hrough m (mem_filter.mp hm).1 (mem_filter.mp hm).2

end Bounty

