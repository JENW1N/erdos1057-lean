/- Normalized finite box masses and rapid decay of the fixed harmonic source tail. -/

open Finset MeasureTheory Filter Real
namespace Bounty







theorem eventually_schwartz_tail_polynomial (f : SchwartzMap ℝ ℂ) {r : ℝ} (hr : 0 < r)
    (K C D : ℝ) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop,
      (∫ u in {u : ℝ | L^r < ‖u‖}, ‖f u‖)*K*L^C ≤ L^(-D) := by
  obtain ⟨M, hM⟩ := exists_nat_gt ((C+D+1)/r)
  have hMr : C+D+1 < r*(M : ℝ) := by
    have hh := (div_lt_iff₀ hr).mp hM
    simpa only [mul_comm] using hh
  obtain ⟨A, hA, htail⟩ := schwartz_norm_rapid_tail f M
  filter_upwards [eventually_ge_atTop (max 1 (A*K))] with L hL
  have hL1 : 1 ≤ L := (le_max_left _ _).trans hL
  have hAK : A*K ≤ L := (le_max_right _ _).trans hL
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL1
  calc
    _ ≤ (A*(L^r)^(-(M : ℝ)))*K*L^C := by
      gcongr
      exact htail (L^r) (one_le_rpow hL1 hr.le)
    _ = (A*K)*(L^r)^(-(M : ℝ))*L^C := by ring
    _ ≤ L*(L^r)^(-(M : ℝ))*L^C := by gcongr
    _ = L^(1-r*(M : ℝ)+C) := by
      nth_rw 1 [← rpow_one L]
      rw [← rpow_mul hL0.le, ← rpow_add hL0, ← rpow_add hL0]
      congr 1
      ring
    _ ≤ L^(-D) := rpow_le_rpow_of_exponent_le hL1 (by linarith)




end Bounty
