      physicalMemoryLabeledScalar (fun g : {g // ¬small g} => V g.val) patterns
        (fun i g => C i g.val) (fun _ => 0)
        (physicalFixedEdgeBigCoefficient small patterns C ζ K a L R)
        (physicalRestrictedEdge (fun g => ¬small g) patterns C a)
