theorem exists_candidate_localization_parameters {r : ℕ} (hr : 0 < r) :
    ∃ eps : ℝ, ∃ J : ℕ, 0 < eps ∧ eps ≤ 1/10 ∧
      eps * (r : ℝ) ≤ 1/400 ∧ 1000 * (r : ℝ) ≤ 2^J := by
  have hr0 : (0 : ℝ) < r := by exact_mod_cast hr
  have hr1 : (1 : ℝ) ≤ r := by exact_mod_cast hr
  obtain ⟨J, hJ⟩ := pow_unbounded_of_one_lt (1000 * (r : ℝ)) (by norm_num : (1 : ℝ) < 2)
  refine ⟨1 / (400 * (r : ℝ)), J, by positivity, ?_, ?_, hJ.le⟩
  · apply (div_le_iff₀ (by positivity : 0 < 400 * (r : ℝ))).mpr
    nlinarith
  · have heq : (1 / (400 * (r : ℝ))) * (r : ℝ) = 1/400 := by field_simp
    exact heq.le



