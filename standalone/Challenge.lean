noncomputable def candidateRestrictedOrdinaryMass (c L eps q : ℝ) (r jStar J : ℕ) : ℝ :=
  ∑ p ∈ candidateSmallPSet c L (Real.exp ((c / 100) * L)),
    candidatePWeight c L q p *
      ∑ n ∈ arithmeticProductWindow p (Real.exp L),
        orderedSlotWeight (candidatePrefixChoices c L eps r jStar J)
          ((r.factorial : ℝ)^(candidateQIndices c L).card) n

noncomputable def candidateOrdinaryWindowMass (c L q : ℝ) (r jStar : ℕ) : ℝ :=
  ∑ p ∈ candidateSmallPSet c L (Real.exp ((c / 100) * L)),
    candidatePWeight c L q p *
      ∑ n ∈ arithmeticProductWindow p (Real.exp L), candidateQWeight c L r jStar n

theorem candidate_restricted_ordinary_eq_localized (c L eps q : ℝ) (r jStar J : ℕ)
    (hr : 0 < r) (hJ : J < jStar) :
    candidateRestrictedOrdinaryMass c L eps q r jStar J =
      candidateLocalizedWindowMass c L eps q r jStar J hr := by
  classical
  unfold candidateRestrictedOrdinaryMass candidateLocalizedWindowMass
  apply sum_congr rfl
  intro p hp
  rw [ordered_slot_arithmetic_window_split _ (candidateFreeSlot c L r hr) _
      (candidate_small_P_set_nonzero hp), candidate_prefix_free_choice c L eps r jStar J hr hJ,
    mul_sum]
  apply sum_congr rfl
  intro y _
  change candidatePWeight c L q p *
    (((primeProductWindow (candidateQBand (c * L) 0)
      ((p * orderedSlotProduct (candidatePrefixRestChoices c L eps r jStar J hr) y : ℕ) : ℝ)
      (Real.exp L)).card : ℝ) / ((r.factorial : ℝ)^(candidateQIndices c L).card)) = _
  ring



end

