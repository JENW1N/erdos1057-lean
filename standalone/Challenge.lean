/- The existing ledger-forgetting equivalence preserves every birth payload. -/

namespace Bounty

theorem full_mixed_ledger_birth_projection
    {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, DecidableEq (P g)]
    (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
    (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*)
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (steps : List (Option (J ⊕ K)))
    (H : (g : Fin N) → Finset (P g))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullMixedLedgerPath n S B A Δ D steps (H, x))
    (a : FullMixedBirthAddress S B steps) :
    fullMixedLedgerPathBornData n S B A Δ D steps (H, x) p a =
      fullMixedPathBornData n S B A Δ D steps x
        (finiteLedgerEventPathEquiv (FullPermutationMixedEvent n S B A Δ D)
          (fullPermutationMixedEventTarget n S B A Δ D)
          (fullMixedLedgerUpdate n S B A Δ D) steps H x p) a := by
  have h := finite_ledger_event_path_occurrence (FullPermutationMixedEvent n S B A Δ D)
    (fullPermutationMixedEventTarget n S B A Δ D)
    (fullMixedLedgerUpdate n S B A Δ D) steps H x p a.1
  exact congrArg
    (fun e => fullMixedEventBornData n S B A Δ D (steps.get a.1) e.1 e.2 a.2) h

end Bounty
