section

/- Natural-index logarithmic sums and the first-derivative frequency range. -/

open Finset

namespace Bounty

theorem nat_logarithmic_first_derivative (a b : ℕ) (U t : ℝ)
    (hU : 1 ≤ U) (ha : U ≤ (a : ℝ)) (hab : a ≤ b) (hb : (b : ℝ) ≤ 2*U)
    (ht : t ≠ 0) (htmax : |t| ≤ U) :
    ‖∑ n ∈ Icc a b, Complex.exp ((t*Real.log (n : ℝ) : ℝ)*Complex.I)‖ ≤
      12*Real.pi*U/|t| := by
  have hcast : ∀ n : ℤ, ((n : ℤ) : ℝ) = (n : ℝ) := fun _ => rfl
  have he := nat_sum_eq_integer_interval_sum
    (fun n : ℤ => Complex.exp ((t*Real.log (n : ℝ) : ℝ)*Complex.I)) a b
  simp only [Int.cast_natCast] at he
  rw [he]
  have ha' : 0 < ((a : ℤ) : ℝ) := by exact_mod_cast (by linarith : 0 < (a : ℝ))
  have hav : ((a : ℤ) : ℝ) ≤ 3*U := by
    simp only [Int.cast_natCast]
    have : (a : ℝ) ≤ (b : ℝ) := by exact_mod_cast hab
    linarith
  have hbV : ((b : ℤ) : ℝ)+1 ≤ 3*U := by simp only [Int.cast_natCast]; linarith
  have htpi : |t| ≤ Real.pi*((a : ℤ) : ℝ) := by
    simp only [Int.cast_natCast]
    have hp := Real.pi_gt_three
    nlinarith
  have hh := logarithmic_first_derivative_signed (a : ℤ) (b : ℤ) (3*U) t ha' hav hbV ht htpi
  convert hh using 1 <;> ring

end Bounty
end

section

/- The exceptional-interval subpower bound is uniform over coefficients
bounded by any fixed real constant, with the large-scale threshold allowed
to depend on that constant. -/

open Filter
open scoped Topology

namespace Bounty

theorem eventually_prime_exceptional_bounded_coefficients_subpower
    {a beta c A B d ε : ℝ}
    (ha : 0 < a) (ha1 : a ≤ 1) (hbeta : beta < 1) (hc : 0 ≤ c) (hA : 0 ≤ A)
    (hB : 1 ≤ B) (hd : 0 < d) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ (s : Finset ℕ), (∀ p ∈ s, Nat.Prime p) →
      ∀ (coeff : s → ℂ) (Y P R : ℝ),
      1 ≤ Y → d * L ≤ Real.log Y → Real.log Y ≤ c * L →
      Real.exp (L ^ a) / 2 ≤ P → P ≤ Real.exp (L ^ beta) →
      0 ≤ R → R ≤ Y →
      (∀ p ∈ s, P ≤ (p : ℝ) ∧ (p : ℝ) ≤ 2 * P) →
      (∀ p : s, ‖coeff p‖ ≤ B) →
      ((primeExceptionalIntervals s coeff (L ^ (-A)) R).card : ℝ) ≤ Y ^ ε := by
  have hA' : 0 ≤ A + 1 := by linarith
  have hB0 : 0 < B := zero_lt_one.trans_le hB
  filter_upwards [eventually_prime_exceptional_intervals_subpower ha ha1 hbeta hc hA' hd hε,
    eventually_ge_atTop B] with L hsub hBL
  intro s hs coeff Y P R hY hloglo hloghi hPlo hPhi hR hRY hband hcoeff
  have hcard := Finset.card_le_card
    (prime_exceptional_intervals_normalize_subset s coeff A R hB0 hBL)
  have hcardR : ((primeExceptionalIntervals s coeff (L ^ (-A)) R).card : ℝ) ≤
      ((primeExceptionalIntervals s (fun p => coeff p / (B : ℂ))
        (L ^ (-(A + 1))) R).card : ℝ) := by exact_mod_cast hcard
  exact hcardR.trans (hsub s hs (fun p => coeff p / (B : ℂ)) Y P R
    hY hloglo hloghi hPlo hPhi hR hRY hband
    (prime_normalized_coefficient_norm_le_one s coeff hB0 hcoeff))

end Bounty
