section

/- The actual candidate prime ranges discharge the arithmetic hypotheses
for uniform small-group omission averaging. Source lists remain injective,
and no shared small-group product is conditioned on before the average. -/

open Finset Filter
open scoped Classical Topology

namespace Bounty



















theorem eventually_candidate_omission_bounds {s : ℝ} (hs : 0 < s)
    (ell : ℕ) (C₂ : ℝ) :
    ∀ᶠ L : ℝ in atTop,
      (Real.exp (L ^ (1/5 : ℝ))) ^ (ell * (candidateSmallPIndices s L).card) <
        Real.exp (L ^ (3/10 : ℝ)) ∧
      L ^ C₂ < Real.exp (L ^ (3/10 : ℝ)) ∧
      (∀ j ∈ candidateSmallPIndices s L, ∀ p ∈ candidatePBand (s * L) j,
        (p : ℝ) ≤ Real.exp (L ^ (1/5 : ℝ))) ∧
      (∀ j ∈ candidateBigPIndices s L, ∀ p ∈ candidatePBand (s * L) j,
        Nat.Prime p ∧ Real.exp (L ^ (3/10 : ℝ)) < (p : ℝ)) ∧
      (∀ j ∈ candidatePIndices s L, ∀ p ∈ candidatePBand (s * L) j, Nat.Prime p) ∧
      Pairwise (fun i j : ℕ => Disjoint (candidatePBand (s * L) i)
        (candidatePBand (s * L) j)) := by
  obtain ⟨vs, Vs, _, _, hsmall⟩ := eventually_candidate_P_groups
    (α := (1/10 : ℝ)) (β := (1/5 : ℝ)) hs (by norm_num) (by norm_num) (by norm_num)
  obtain ⟨vb, Vb, _, _, hbig⟩ := eventually_candidate_P_groups
    (α := (3/10 : ℝ)) (β := (2/5 : ℝ)) hs (by norm_num) (by norm_num) (by norm_num)
  filter_upwards [hsmall, hbig,
    eventually_small_omission_power_lt (show (1/5 : ℝ) < 3/10 by norm_num)
      ell (1 / (5 * Real.log 2)),
    eventually_log_times_rpow_lt (show (0 : ℝ) < 3/10 by norm_num) C₂,
    eventually_gt_atTop (0 : ℝ)] with L hsL hbL hpower hstep hL
  have hcard : ((candidateSmallPIndices s L).card : ℝ) ≤
      (1 / (5 * Real.log 2)) * Real.log L := by
    have hc := hsL.2.1
    change ((candidateSmallPIndices s L).card : ℝ) ≤ _ at hc
    rw [show 2 * ((1/5 : ℝ) - 1/10) / Real.log 2 = 1 / (5 * Real.log 2) by ring] at hc
    exact hc
  refine ⟨hpower _ hcard, ?_, ?_, ?_, ?_, hsL.2.2.1⟩
  · rw [Real.rpow_def_of_pos hL]
    apply Real.exp_lt_exp.mpr
    simpa only [Real.rpow_zero, mul_one, mul_comm] using hstep
  · intro j hj p hp
    exact ((hsL.2.2.2 j hj).2.2 p hp).2.2
  · intro j hj p hp
    exact ⟨((hbL.2.2.2 j hj).2.2 p hp).1, ((hbL.2.2.2 j hj).2.2 p hp).2.1⟩
  · intro j hj p hp
    rcases mem_union.mp hj with hj | hj
    · exact ((hsL.2.2.2 j hj).2.2 p hp).1
    · exact ((hbL.2.2.2 j hj).2.2 p hp).1
















theorem eventually_candidate_small_big_indices_disjoint {s : ℝ} (hs : 0 < s) :
    ∀ᶠ L : ℝ in atTop, Disjoint (candidateSmallPIndices s L) (candidateBigPIndices s L) := by
  obtain ⟨vb, Vb, hvb, _, hbig⟩ := eventually_candidate_P_groups
    (α := (3/10 : ℝ)) (β := (2/5 : ℝ)) hs (by norm_num) (by norm_num) (by norm_num)
  filter_upwards [hbig, eventually_candidate_omission_bounds hs 0 0,
    eventually_ge_atTop (1 : ℝ)] with L hb hL hOne
  apply disjoint_left.mpr
  intro j hjs hjb
  have hne : (candidatePBand (s * L) j).Nonempty := by
    apply nonempty_iff_ne_empty.mpr
    intro he
    have hv := (hb.2.2.2 j hjb).1
    rw [he, sum_empty] at hv
    exact (not_le_of_gt hvb) hv
  obtain ⟨p, hp⟩ := hne
  have hsUpper := hL.2.2.1 j hjs p hp
  have hbLower := (hL.2.2.2.1 j hjb p hp).2
  have horder : Real.exp (L ^ (1/5 : ℝ)) ≤ Real.exp (L ^ (3/10 : ℝ)) :=
    Real.exp_le_exp.mpr (Real.rpow_le_rpow_of_exponent_le hOne (by norm_num))
  exact (not_lt_of_ge (hsUpper.trans horder)) hbLower




end Bounty
