theorem physical_full_shared_label_product {G : Type*} {P : G → Finset ℕ}
    {Z : G → Type*} {J ell B : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (q : ∀ g, BoundedOrderedTuple (Z g) B) (g : G) :
    (∏ i, ((productActiveMemorySplit (fun g => physicalFullSharedIndices (C g)) B
      (physicalFullMemoryState C L q)).1 g i).val) =
    ∏ j ∈ univ \ C g, (L g (Sum.inl j)).val := by
  let S := physicalFullSharedIndices (ell := ell) (C g)
  let T := physicalSharedSlots (ell := ell) (C g)
  change (∏ i : Fin S.card, (L g (physicalFullSlotIndex (C g) (S.equivFin.symm i).val)).val) = _
  calc
    _ = ∏ i : Fin S.card, (L g (physicalFullSharedEquiv (C g) (S.equivFin.symm i)).val).val := by
      apply prod_congr rfl
      intro i _
      exact congrArg (fun s => (L g s).val)
        (finite_partition_equiv_left S T (physicalFullSharedEquiv (C g))
          (physicalFullUnsharedEquiv (C g)) (S.equivFin.symm i))
    _ = ∏ i : T, (L g i.val).val :=
      (S.equivFin.symm.trans (physicalFullSharedEquiv (C g))).prod_comp (fun i => (L g i.val).val)
    _ = ∏ i ∈ T, (L g i).val := prod_coe_sort T (fun i => (L g i).val)
    _ = _ := by simp only [T, physicalSharedSlots, prod_map, Function.Embedding.inl_apply]

