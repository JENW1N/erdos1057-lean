        Real.sqrt (K^(candidateBigPIndices scale L).card))*
        Real.sqrt ((⌈L^2⌉₊ : ℝ)/
          (((J+ell).choose ell)^(candidateSmallPIndices scale L).card : ℕ)) := by
    calc
      _ ≤ A^(candidateSmallPIndices scale L).card *
          (2*L^C*Real.sqrt ((⌈L^2⌉₊ : ℝ)/
