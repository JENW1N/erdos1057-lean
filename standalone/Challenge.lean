open Finset
open scoped Classical
namespace Bounty

section Fine
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J))
  (cut : ℕ → Fin N → Finset (Fin J))

theorem physical_selected_fine_record_data_unique
    {aux aux' : ∀ j, PhysicalAuxLabels P (C j)}
    {L L' : Fin (n + 1) → PhysicalMarkLists P J ell}
    {σ τ σ' τ' : Fin n → PhysicalPermutations (Fin N) J ell}
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))
    (h : List.Forall₂ (physicalSelectedFineTraceTest C aux L σ τ cut) (List.range (4 * n + 1)) r)
    (h' : List.Forall₂ (physicalSelectedFineTraceTest C aux' L' σ' τ' cut) (List.range (4 * n + 1)) r) :
    aux = aux' ∧ L = L' ∧ σ = σ' ∧ τ = τ' := by
  apply physical_selected_fine_data_unique_of_joint_tests C
  intro i hi
  have hir : i < r.length := by simpa only [← h.length_eq, List.length_range] using hi
  have hil : i < (List.range (4 * n + 1)).length := by simpa only [List.length_range] using hi
  have ha : physicalSelectedFineTraceTest C aux L σ τ cut i (r.get ⟨i, hir⟩) := by
    simpa only [List.get_eq_getElem, List.getElem_range] using h.get hil hir
  have hb : physicalSelectedFineTraceTest C aux' L' σ' τ' cut i (r.get ⟨i, hir⟩) := by
    simpa only [List.get_eq_getElem, List.getElem_range] using h'.get hil hir
  obtain ⟨t, het, ht⟩ := ha
  obtain ⟨u, heu, hu⟩ := hb
  have he : u = t := physical_bounded_mark_encode_injective (cut (i + 1)) (heu.trans het.symm)
  exact ⟨(r.get ⟨i, hir⟩).2.1, t, ht, he ▸ hu⟩

noncomputable def physicalSelectedDataRecordTest (d : PhysicalSelectedData P ell C)
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C)) : Prop :=
  List.Forall₂ (physicalSelectedFineTraceTest C d.1 d.2.1 d.2.2.1 d.2.2.2 cut)
    (List.range (4 * n + 1)) r

theorem physical_selected_data_record_unique {d e : PhysicalSelectedData P ell C}
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))
    (hd : physicalSelectedDataRecordTest C cut d r)
    (he : physicalSelectedDataRecordTest C cut e r) : d = e := by
  obtain ⟨ha, hL, hσ, hτ⟩ := physical_selected_fine_record_data_unique C cut r hd he
  exact Prod.ext ha (Prod.ext hL (Prod.ext hσ hτ))

noncomputable def physicalSelectedDataRecordPhase
    (S : Finset (PhysicalSelectedData P ell C))
    (w : PhysicalSelectedData P ell C → ℂ)
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C)) : ℂ :=
  ∑ d ∈ S, if physicalSelectedDataRecordTest C cut d r then w d else 0




end Fine
end Bounty
