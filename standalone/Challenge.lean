section

/- A four-factor convolution is majorized by the fourth Dirichlet power of zeta. -/

open Finset

namespace Bounty

theorem divisor_card_eq_zeta_square (n : ℕ) :
    n.divisors.card = (ArithmeticFunction.zeta ^ 2) n := by
  rw [pow_two, ArithmeticFunction.zeta_mul_apply]
  calc
    _ = ∑ _d ∈ n.divisors, (1 : ℕ) := by simp only [sum_const, smul_eq_mul, mul_one]
    _ = _ := by
      apply sum_congr rfl
      intro d hd
      exact (ArithmeticFunction.zeta_apply_ne (Nat.ne_of_gt (Nat.pos_of_mem_divisors hd))).symm

theorem divisor_sum_zeta_norm_le (δ f : ℕ → ℂ) {D B : ℝ}
    (hD : 0 ≤ D) (_hB : 0 ≤ B) (k n : ℕ)
    (hδ : ∀ d, ‖δ d‖ ≤ D)
    (hf : ∀ m, ‖f m‖ ≤ B * ((ArithmeticFunction.zeta ^ k) m : ℝ)) :
    ‖∑ d ∈ n.divisors, δ d * f (n / d)‖ ≤
      D * B * ((ArithmeticFunction.zeta ^ (k + 1)) n : ℝ) := by
  calc
    _ ≤ ∑ d ∈ n.divisors, ‖δ d * f (n / d)‖ := norm_sum_le _ _
    _ ≤ ∑ d ∈ n.divisors, D * (B * ((ArithmeticFunction.zeta ^ k) (n / d) : ℝ)) := by
      apply sum_le_sum
      intro d _
      rw [norm_mul]
      exact mul_le_mul (hδ d) (hf (n / d)) (norm_nonneg _) hD
    _ = D * B * (∑ d ∈ n.divisors, ((ArithmeticFunction.zeta ^ k) d : ℝ)) := by
      rw [← mul_sum, ← mul_sum, Nat.sum_div_divisors n (fun d => ((ArithmeticFunction.zeta ^ k) d : ℝ))]
      ring
    _ = _ := by rw [pow_succ, ArithmeticFunction.mul_zeta_apply, Nat.cast_sum]

theorem divisor_pair_convolution_norm_le (β γ : ℕ → ℂ) {B C : ℝ}
    (hB : 0 ≤ B) (_hC : 0 ≤ C) (hβ : ∀ d, ‖β d‖ ≤ B) (hγ : ∀ d, ‖γ d‖ ≤ C)
    (n : ℕ) :
    ‖∑ d ∈ n.divisors, β d * γ (n / d)‖ ≤
      B * C * ((ArithmeticFunction.zeta ^ 2) n : ℝ) := by
  calc
    _ ≤ ∑ d ∈ n.divisors, ‖β d * γ (n / d)‖ := norm_sum_le _ _
    _ ≤ ∑ _d ∈ n.divisors, B * C := by
      apply sum_le_sum
      intro d _
      rw [norm_mul]
      exact mul_le_mul (hβ d) (hγ (n / d)) (norm_nonneg _) hB
    _ = _ := by rw [sum_const, nsmul_eq_mul, divisor_card_eq_zeta_square]; ring

theorem endpoint_triple_convolution_zeta_bound (α β γ : ℕ → ℂ) {A B C : ℝ}
    (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ d, ‖α d‖ ≤ A) (hβ : ∀ d, ‖β d‖ ≤ B) (hγ : ∀ d, ‖γ d‖ ≤ C)
    (n : ℕ) :
    ‖endpointTripleConvolution α β γ n‖ ≤
      A * B * C * ((ArithmeticFunction.zeta ^ 3) n : ℝ) := by
  have h := divisor_sum_zeta_norm_le α (fun m => ∑ d ∈ m.divisors, β d * γ (m / d))
    hA (mul_nonneg hB hC) 2 n hα (divisor_pair_convolution_norm_le β γ hB hC hβ hγ)
  simpa only [endpointTripleConvolution, mul_sum, ← mul_assoc] using h

theorem endpoint_four_convolution_zeta_bound (δ α β γ : ℕ → ℂ) {D A B C : ℝ}
    (hD : 0 ≤ D) (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hδ : ∀ d, ‖δ d‖ ≤ D) (hα : ∀ d, ‖α d‖ ≤ A)
    (hβ : ∀ d, ‖β d‖ ≤ B) (hγ : ∀ d, ‖γ d‖ ≤ C) (n : ℕ) :
    ‖endpointFourConvolution δ α β γ n‖ ≤
      D * A * B * C * ((ArithmeticFunction.zeta ^ 4) n : ℝ) := by
  have h := divisor_sum_zeta_norm_le δ (endpointTripleConvolution α β γ)
    hD (mul_nonneg (mul_nonneg hA hB) hC) 3 n hδ
    (endpoint_triple_convolution_zeta_bound α β γ hA hB hC hα hβ hγ)
  simpa only [endpointFourConvolution, ← mul_assoc] using h

end Bounty
end

section

/- The actual four-factor divisor convolution equals its finite box transform. -/

open Finset

namespace Bounty

theorem endpoint_four_finite_transform (S D A B C : Finset ℕ) (δ α β γ F : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c)
    (hδ : ∀ d, d ∉ D → δ d = 0) (hα : ∀ a, a ∉ A → α a = 0)
    (hβ : ∀ b, b ∉ B → β b = 0) (hγ : ∀ c, c ∉ C → γ c = 0)
    (hS : ∀ d ∈ D, ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C, d*a*b*c ∈ S) :
    (∑ n ∈ S, endpointFourConvolution δ α β γ n*F n) =
      ∑ d ∈ D, ∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C, δ d*α a*β b*γ c*F (d*a*b*c) := by
  classical
  let U := (B ×ˢ C).image (fun bc => bc.1*bc.2)
  let V := (A ×ˢ U).image (fun ar => ar.1*ar.2)
  have hU : ∀ r ∈ U, 0 < r := finite_natural_product_pos B C hB hC
  have hV : ∀ r ∈ V, 0 < r := finite_natural_product_pos A U hA hU
  have hf : ∀ r, r ∉ V → endpointTripleConvolution α β γ r = 0 :=
    endpoint_triple_finite_support A B C α β γ hA hB hC hα hβ hγ
  have hout := finite_divisor_convolution_transform S D V δ
    (endpointTripleConvolution α β γ) F hD hV hδ hf (by
      intro d hd r hr
      obtain ⟨ar,har,rfl⟩ := mem_image.mp hr
      obtain ⟨bc,hbc,hbcEq⟩ := mem_image.mp (mem_product.mp har).2
      rw [← hbcEq]
      simpa only [Nat.mul_assoc] using hS d hd ar.1 (mem_product.mp har).1
        bc.1 (mem_product.mp hbc).1 bc.2 (mem_product.mp hbc).2)
  calc
    _ = ∑ d ∈ D, ∑ r ∈ V, δ d*endpointTripleConvolution α β γ r*F (d*r) := hout
    _ = _ := by
      apply sum_congr rfl
      intro d hd
      have hi := endpoint_triple_finite_transform V A B C α β γ (fun r => F (d*r))
        hA hB hC hα hβ hγ (by
          intro a ha b hb c hc
          apply mem_image.mpr
          refine ⟨(a,b*c),mem_product.mpr ⟨ha,?_⟩,?_⟩
          · exact mem_image.mpr ⟨(b,c),mem_product.mpr ⟨hb,hc⟩,rfl⟩
          · exact (Nat.mul_assoc a b c).symm)
      calc
        _ = δ d*(∑ r ∈ V, endpointTripleConvolution α β γ r*F (d*r)) := by
          rw [mul_sum]
          apply sum_congr rfl
          intro r hr
          ring
        _ = δ d*(∑ a ∈ A, ∑ b ∈ B, ∑ c ∈ C, α a*β b*γ c*F (d*(a*b*c))) :=
          congrArg (fun z => δ d*z) hi
        _ = _ := by simp only [mul_sum,mul_assoc]

theorem endpoint_four_finite_mellin (S D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ)
    (hD : ∀ d ∈ D, 0 < d) (hA : ∀ a ∈ A, 0 < a)
    (hB : ∀ b ∈ B, 0 < b) (hC : ∀ c ∈ C, 0 < c)
    (hδ : ∀ d, d ∉ D → δ d = 0) (hα : ∀ a, a ∉ A → α a = 0)
    (hβ : ∀ b, b ∉ B → β b = 0) (hγ : ∀ c, c ∉ C → γ c = 0)
    (hS : ∀ d ∈ D, ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C, d*a*b*c ∈ S) (t : ℝ) :
    (∑ n ∈ S, endpointFourConvolution δ α β γ n*harmonicMellinWeight t n) =
      (∑ d ∈ D, δ d*harmonicMellinWeight t d)*
      (∑ a ∈ A, α a*harmonicMellinWeight t a)*
      (∑ b ∈ B, β b*harmonicMellinWeight t b)*
      (∑ c ∈ C, γ c*harmonicMellinWeight t c) := by
  rw [endpoint_four_finite_transform S D A B C δ α β γ _ hD hA hB hC hδ hα hβ hγ hS]
  exact harmonic_mellin_four_factor_box D A B C hD hA hB hC δ α β γ t

end Bounty
end

section

/- A nonzero coefficient supplies actual supported integer factors. -/

open Finset

namespace Bounty

theorem divisor_pair_nonzero_factors (α β : ℕ → ℂ) {n : ℕ}
    (hn : (∑ d ∈ n.divisors, α d*β (n/d)) ≠ 0) :
    ∃ a b : ℕ, 0 < a ∧ 0 < b ∧ α a ≠ 0 ∧ β b ≠ 0 ∧ a*b = n := by
  obtain ⟨a,ha,hna⟩ := exists_ne_zero_of_sum_ne_zero hn
  have hb : 0 < n/a := Nat.pos_of_ne_zero (by
    intro hz
    have he := Nat.mul_div_cancel' (Nat.dvd_of_mem_divisors ha)
    rw [hz,mul_zero] at he
    exact (Nat.ne_zero_of_mem_divisors ha) he.symm)
  refine ⟨a,n/a,Nat.pos_of_mem_divisors ha,hb,?_,?_,Nat.mul_div_cancel' (Nat.dvd_of_mem_divisors ha)⟩
  · intro hz
    exact hna (by rw [hz,zero_mul])
  · intro hz
    exact hna (by rw [hz,mul_zero])

theorem endpoint_triple_nonzero_factors (α β γ : ℕ → ℂ) {n : ℕ}
    (hn : endpointTripleConvolution α β γ n ≠ 0) :
    ∃ a b c : ℕ, 0 < a ∧ 0 < b ∧ 0 < c ∧ α a ≠ 0 ∧ β b ≠ 0 ∧ γ c ≠ 0 ∧ a*b*c = n := by
  unfold endpointTripleConvolution at hn
  obtain ⟨a,ha,hna⟩ := exists_ne_zero_of_sum_ne_zero hn
  obtain ⟨b,hb,hnab⟩ := exists_ne_zero_of_sum_ne_zero hna
  have ha0 := Nat.pos_of_mem_divisors ha
  have hb0 := Nat.pos_of_mem_divisors hb
  have hc0 : 0 < n/a/b := Nat.pos_of_ne_zero (by
    intro hz
    have he := Nat.mul_div_cancel' (Nat.dvd_of_mem_divisors hb)
    rw [hz,mul_zero] at he
    exact (Nat.ne_zero_of_mem_divisors hb) he.symm)
  have hα : α a ≠ 0 := by intro hz; exact hnab (by rw [hz,zero_mul,zero_mul])
  have hβ : β b ≠ 0 := by intro hz; exact hnab (by rw [hz,mul_zero,zero_mul])
  have hγ : γ (n/a/b) ≠ 0 := by intro hz; exact hnab (by rw [hz,mul_zero])
  refine ⟨a,b,n/a/b,ha0,hb0,hc0,hα,hβ,hγ,?_⟩
  rw [Nat.mul_assoc,Nat.mul_div_cancel' (Nat.dvd_of_mem_divisors hb),
    Nat.mul_div_cancel' (Nat.dvd_of_mem_divisors ha)]




end Bounty
end

