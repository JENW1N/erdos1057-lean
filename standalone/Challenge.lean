section

variable {I S G : Type*} [Fintype I] [Fintype S] [Fintype G]
    [DecidableEq S] [DecidableEq G]
    {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}
    [∀ p : PhysicalPrime Ps, NeZero p.2.val] [∀ g (p : P g), NeZero p.val]

theorem physical_mixed_gated_clean_pattern_projected_pairing
    (initial : ∀ g, Finset (P g)) (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : I → G → Finset (Fin J)) (ζ θ ρ : ℝ) (k : ℤ)
    (K : ∀ i, RepeatedBigLists P J ell → RepeatedBigLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (Vs : S → ℝ) (hVs : ∀ s, 0 < Vs s) (q : ℝ)
    (ν : ∀ g, P g → ℝ)
    (sourceGate targetGate : PhysicalSmallBigState Ps J ell
      (CleanFullMemoryState P J ell B) → ℂ)
    (hsg : ∀ s (τ : FullActiveSlotPermutations (fun _ : G => J + ell)),
      sourceGate (s.1, fullActivePermutation τ s.2) = sourceGate s)
    (htg : ∀ s (τ : FullActiveSlotPermutations (fun _ : G => J + ell)),
      targetGate (s.1, fullActivePermutation τ s.2) = targetGate s)
    (u f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ)
    (hf : ∀ s, ProductMemorySymmetric (fun x => targetGate (s,x) * f (s,x)))
    (hPs : ∀ s p, p ∈ Ps s → 0 < p) (hP : ∀ g p, p ∈ P g → 0 < p) :
    let W : CleanFullMemoryState P J ell B → ℝ := productMemoryWeight (fun g => tiltedPhysicalBirthLaw V g (b g)) (fun g z => ν g z.1)
    (∑ s, (physicalSmallBigMeasure Vs W s : ℂ) * (starRingEnd ℂ) (u s) *
      physicalSmallBigBigAverage (physicalMixedGatedCleanPatternAction initial V b C ζ θ ρ k K
        Vs q sourceGate targetGate (physicalSmallBigBigAverage f)) s) =
      ∑ d, ∑ r, ∑ x, (W x : ℂ) *
        (starRingEnd ℂ) (physicalSmallBigCondition Vs q (fun s => sourceGate s * u s) d x r) *
        cleanFullMemoryActiveMap (cleanFullMemoryInitialPatternEventAction initial V b C ζ θ ρ k
          (fun i => canonicalMixedEdgeD (C i) d) K d
          (cleanFullMemoryActiveMap (physicalSmallBigCondition Vs q (fun s => targetGate s * f s) d))) x r := by
  intro W
  let smallAux : PhysicalAuxLabels Ps (fun _ => (∅ : Finset (Fin J))) :=
    fun _ j => False.elim (notMem_empty j.val j.property)
  have hp := physical_small_big_big_projected_pairing
    (Ps := Ps) (P := fun g => ↥(P g))
    (Z := fun g => UnrestrictedResidueParticle (fun p : P g => p.val))
    (J := J) (ell := ell) (M := fun _ => J + ell) (B := B) Vs q
    (fun g => tiltedPhysicalBirthLaw V g (b g)) (fun g z => ν g z.1)
    sourceGate targetGate hsg htg
    (physicalMixedGatedCleanPatternAction initial V b C ζ θ ρ k K Vs q sourceGate targetGate)
    (fun d f x r => ∑ i, physicalMixedCleanInitialAction initial V b (C i) ζ θ ρ k (K i) d f x r)
    (fun u f => physical_mixed_gated_clean_pattern_pairing initial V b C ζ θ ρ k K
      Vs hVs q W smallAux sourceGate targetGate u f) u f
  refine hp.trans ?_
  apply sum_congr rfl
  intro d _
  apply sum_congr rfl
  intro r _
  apply sum_congr rfl
  intro x _
  have he := congrFun (congrFun (physical_mixed_clean_pattern_projected_reencode initial V b C
    ζ θ ρ k K d (physicalSmallBigCondition Vs q (fun s => targetGate s * f s) d)
    (fun rs => physical_small_big_condition_memory_symmetric Vs q _ hf d rs) hPs hP) x) r
  have he' := congrArg (fun z : ℂ => (W x : ℂ) *
      (starRingEnd ℂ) (physicalSmallBigCondition Vs q (fun s => sourceGate s * u s) d x r) * z) he
  dsimp only [cleanFullMemoryActiveMap, W] at he' ⊢
  exact he'

end

end Bounty
