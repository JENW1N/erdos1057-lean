      (fun a => F a * fullMixedCommonResidualWeight sizes shared B aux Δ D edgePhase ω μ q ρ V steps (x a) (p a))
      (fun a => fullMixedCommonIndexedPerformed sizes shared B aux Δ D steps (x a) (p a))
