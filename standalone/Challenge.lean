section

/- Bounded character slices for the actual smooth off-diagonal energy. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

noncomputable def typeIIRealCharacterAverage (M H Z : Finset ℕ)
    (k : ℤ) [NeZero (2 * k.natAbs)] (η : ℝ → ℝ → ℝ) (α aH : ℕ → ℂ) : ℂ :=
  (1 / ((2 * k.natAbs).totient : ℂ)) *
    ∑ χ : DirichletCharacter ℂ (2 * k.natAbs),
      ∑ y ∈ typeIICrossSlice M H Z k,
        typeIIRealShiftWeight η α aH y * χ (y.2.1.1 : ZMod (2 * k.natAbs)) *
          conj (χ (y.2.2.1 : ZMod (2 * k.natAbs)))

noncomputable def typeIIRealCharacterSlice (M H Z : Finset ℕ)
    (k : ℤ) (η : ℝ → ℝ → ℝ) (α aH : ℕ → ℂ) : ℂ :=
  if hk : k = 0 then 0 else
    @typeIIRealCharacterAverage M H Z k
      ⟨by simpa only [ne_eq, mul_eq_zero, OfNat.ofNat_ne_zero, false_or,
        Int.natAbs_eq_zero] using hk⟩ η α aH

theorem typeII_smooth_character_slice_eq (E N M H Z : Finset ℕ)
    (k : ℤ) (η : ℝ → ℝ → ℝ) (α aH : ℕ → ℂ)
    {W : ℝ} (hW : 2 ≤ W) (hM : ∀ m ∈ M, 0 < m)
    (hrough : ∀ m ∈ M, ∀ p ∈ m.primeFactors, W < (p : ℝ))
    (hsmall : (k.natAbs : ℝ) ≤ W)
    (hpos : ∀ e n, η e n ≠ 0 → 0 < e)
    (hmem : ∀ e n : ℕ, η e n ≠ 0 → e ∈ E ∧ n ∈ N) :
    (∑ y ∈ typeIIDeterminantDomain E N M H {k} Z,
      typeIIShiftWeight (fun e n => η e n) α aH y) =
      (typeIIRealCharacterSlice M H Z k η α aH).re := by
  classical
  by_cases hk : k = 0
  · subst k
    rw [typeII_zero_determinant_slice]
    simp [typeIIRealCharacterSlice]
  · rw [typeIIRealCharacterSlice, dif_neg hk]
    have hs := @typeII_smooth_determinant_character_sum E N M H Z k
      ⟨by simpa only [ne_eq, mul_eq_zero, OfNat.ofNat_ne_zero, false_or,
        Int.natAbs_eq_zero] using hk⟩ η α aH W hW hM hrough hsmall hpos hmem
    have hr := congrArg Complex.re hs
    simpa only [Complex.re_sum, typeII_shift_complex_weight_re,
      typeIIRealCharacterAverage] using hr

theorem typeII_smooth_off_diagonal_bounded (E N M H : Finset ℕ)
    (η : ℝ → ℝ → ℝ) (α aH : ℕ → ℂ) {Elo U W : ℝ} {B : ℕ}
    (hElo : 0 < Elo) (hE : ∀ e ∈ E, Elo ≤ (e : ℝ))
    (hMpos : ∀ m ∈ M, 0 < m) (hM : ∀ m ∈ M, (m : ℝ) ≤ U)
    (hB : U / (2 * Elo) ≤ B) (hBW : (B : ℝ) ≤ W) (hW : 2 ≤ W)
    (hrough : ∀ m ∈ M, α m ≠ 0 → ∀ p ∈ m.primeFactors, W < (p : ℝ))
    (hpos : ∀ e n, η e n ≠ 0 → 0 < e)
    (hmem : ∀ e n : ℕ, η e n ≠ 0 → e ∈ E ∧ n ∈ N) :
    typeIIOffDiagonalEnergy E N M H (fun e n => η e n) α aH =
      ∑ k ∈ Icc (-(B : ℤ)) B,
        (typeIIRealCharacterSlice (M.filter (fun m => α m ≠ 0)) H
          (Icc 0 ((M.filter (fun m => α m ≠ 0)).sup id * H.sup id)) k η α aH).re := by
  classical
  rw [typeII_off_diagonal_energy_eq_supported_determinant_sum E N M H
    (fun e n => η e n) α aH hElo hE hM hB hBW hrough,
    typeII_determinant_sum_slices]
  apply sum_congr rfl
  intro k hk
  apply typeII_smooth_character_slice_eq _ _ _ _ _ _ _ _ _ hW
  · intro m hm
    exact hMpos m (mem_filter.mp hm).1
  · intro m hm
    exact hrough m (mem_filter.mp hm).1 (mem_filter.mp hm).2
  · have hi : |k| ≤ (B : ℤ) := abs_le.mpr (mem_Icc.mp hk)
    rw [← Int.natCast_natAbs] at hi
    have hr : (k.natAbs : ℝ) ≤ B := by exact_mod_cast hi
    exact hr.trans hBW
  · exact hpos
  · exact hmem

theorem typeII_majorant_off_diagonal_bounded (M H : Finset ℕ) (α aH : ℕ → ℂ)
    {L E V U W : ℝ} {B : ℕ} (hL : 0 < L) (hE : 0 < E) (hV : 0 < V)
    (hMpos : ∀ m ∈ M, 0 < m) (hM : ∀ m ∈ M, (m : ℝ) ≤ U)
    (hB : U / (2 * (E / (2 * L ^ 88))) ≤ B) (hBW : (B : ℝ) ≤ W) (hW : 2 ≤ W)
    (hrough : ∀ m ∈ M, α m ≠ 0 → ∀ p ∈ m.primeFactors, W < (p : ℝ)) :
    typeIIOffDiagonalEnergy (Icc ⌈E / (2 * L ^ 88)⌉₊ ⌊2 * E⌋₊)
      (Icc ⌈V / 2⌉₊ ⌊3 * V⌋₊) M H
      (fun e n => typeIIEMajorant (L ^ 88) ((e : ℝ) / E) *
        typeIINMajorant ((n : ℝ) / V)) α aH =
      ∑ k ∈ Icc (-(B : ℤ)) B,
        (typeIIRealCharacterSlice (M.filter (fun m => α m ≠ 0)) H
          (Icc 0 ((M.filter (fun m => α m ≠ 0)).sup id * H.sup id)) k
          (fun e n => typeIIEMajorant (L ^ 88) (e / E) * typeIINMajorant (n / V)) α aH).re := by
  have hlo : ∀ e ∈ Icc ⌈E / (2 * L ^ 88)⌉₊ ⌊2 * E⌋₊,
      E / (2 * L ^ 88) ≤ (e : ℝ) := by
    intro e he
    exact (Nat.le_ceil _).trans (by exact_mod_cast (mem_Icc.mp he).1)
  apply typeII_smooth_off_diagonal_bounded _ _ M H
    (fun e n => typeIIEMajorant (L ^ 88) (e / E) * typeIINMajorant (n / V)) α aH
    (by positivity) hlo hMpos hM hB hBW hW hrough
  · intro e n hne
    exact (typeII_majorant_real_support hL hE hV hne).1
  · exact typeII_majorant_integer_support hL hE hV

end Bounty
end

section

/- Actual cross-product scale bounds on the support of the smooth majorants. -/

namespace Bounty

theorem typeII_real_cross_equation {m m' h z k : ℝ}
    (hm : m ≠ 0) (hm' : m' ≠ 0) (hk : k ≠ 0) (hz : z = m' * h) :
    m * ((m' - m) * z / (k * m * m') + 1 / m) =
      2 * ((m' - m) / (2 * k)) * h + 1 := by
  rw [hz]
  field_simp

theorem typeII_cross_scale_range {U V E P m m' e n h z : ℝ}
    (hU : 0 < U) (hV : 0 < V) (hE : 0 < E) (hP : 0 < P)
    (hUV : 4 ≤ U * V) (hm : m ∈ Set.Icc U (2 * U))
    (hm' : m' ∈ Set.Icc U (2 * U))
    (he : e ∈ Set.Ioo (E / (2 * P)) (2 * E))
    (hn : n ∈ Set.Ioo (V / 2) (3 * V))
    (heq : m * n = 2 * e * h + 1) (hz : z = m' * h) :
    U ^ 2 * V / (16 * E) < z ∧ z < 12 * U ^ 2 * V * P / E := by
  have hm0 : 0 < m := hU.trans_le hm.1
  have he0 : 0 < e := lt_trans (by positivity) he.1
  have hmnlo : U * V / 2 < m * n := by
    calc
      U * V / 2 = U * (V / 2) := by ring
      _ ≤ m * (V / 2) := mul_le_mul_of_nonneg_right hm.1 (by positivity)
      _ < m * n := mul_lt_mul_of_pos_left hn.1 hm0
  have hmnhi : m * n < 6 * U * V := by
    calc
      m * n < m * (3 * V) := mul_lt_mul_of_pos_left hn.2 hm0
      _ ≤ (2 * U) * (3 * V) := mul_le_mul_of_nonneg_right hm.2 (by positivity)
      _ = 6 * U * V := by ring
  have hehpos : 0 < e * h := by nlinarith
  have hh : 0 < h := (mul_pos_iff_of_pos_left he0).mp hehpos
  have hlo : U * V / 16 < E * h := by
    have hbound := mul_lt_mul_of_pos_right he.2 hh
    nlinarith
  have hhi : E * h < 6 * U * V * P := by
    have helow : E < 2 * P * e := by
      have hh := (div_lt_iff₀ (by positivity : 0 < 2 * P)).mp he.1
      nlinarith
    have hbound := mul_lt_mul_of_pos_right helow hh
    have hproduct := mul_lt_mul_of_pos_right hmnhi hP
    nlinarith [heq]
  have hElow : U ^ 2 * V / 16 < E * z := by
    have ha := mul_lt_mul_of_pos_left hlo hU
    have hb := mul_le_mul_of_nonneg_right hm'.1 (mul_nonneg hE.le hh.le)
    rw [hz]
    nlinarith
  have hEhigh : E * z < 12 * U ^ 2 * V * P := by
    have ha := mul_lt_mul_of_pos_left hhi (by positivity : 0 < 2 * U)
    have hb := mul_le_mul_of_nonneg_right hm'.2 (mul_nonneg hE.le hh.le)
    rw [hz]
    nlinarith
  constructor
  · apply (div_lt_iff₀ (by positivity : 0 < 16 * E)).mpr
    nlinarith
  · apply (lt_div_iff₀ hE).mpr
    nlinarith

theorem typeII_majorant_cross_scale_range {y : TypeIIShiftIndex} {L U V E : ℝ}
    (hL : 0 < L) (hU : 0 < U) (hV : 0 < V) (hE : 0 < E)
    (hUV : 4 ≤ U * V) (hk : y.1.1 ≠ 0)
    (hm : (y.2.1.1 : ℝ) ∈ Set.Icc U (2 * U))
    (hm' : (y.2.2.1 : ℝ) ∈ Set.Icc U (2 * U))
    (hz : y.1.2 = y.2.2.1 * y.2.1.2)
    (hne : typeIIEMajorant (L ^ 88) (typeIIRealE y / E) *
      typeIINMajorant (typeIIRealN y / V) ≠ 0) :
    U ^ 2 * V / (16 * E) < (y.1.2 : ℝ) ∧
      (y.1.2 : ℝ) < 12 * U ^ 2 * V * L ^ 88 / E := by
  obtain ⟨he, he', hn, hn'⟩ := typeII_majorant_real_box hL hE hV hne
  have hzr : (y.1.2 : ℝ) = (y.2.2.1 : ℝ) * y.2.1.2 := by exact_mod_cast hz
  have heq := typeII_real_cross_equation (k := (y.1.1 : ℝ)) (hU.trans_le hm.1).ne'
    (hU.trans_le hm'.1).ne' (by exact_mod_cast hk) hzr
  exact typeII_cross_scale_range hU hV hE (pow_pos hL _) hUV hm hm'
    ⟨he, he'⟩ ⟨hn, hn'⟩ heq hzr

end Bounty
end

section

/- Exact retained coefficient separation for the truncated active-slot integrals. -/

open Finset Filter MeasureTheory

namespace Bounty

section

variable
  (c L : ℝ)
  (r jStar : ℕ)
  (R T : ℝ)
  (take : Fin ((candidateQIndices c L).card*r) → Bool)
  (F : ℕ → ℕ → ℂ)

include c L r jStar R T take F

theorem candidate_separated_allocation_box_integrable  :
    Integrable (candidateSeparatedAllocationIntegrand c L r jStar R take F)
      (activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T) := by
  have h := (integrable_finsetSum (s := (univ : Finset (∀ slot,
      candidateQSlotChoices c L r jStar slot))) (fun x hx =>
    (active_allocation_box_integrable (candidateAllocationRadius r) R T
      (fun i => Real.log (candidateAllocationValue c L r jStar x i))
      (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
      (candidateAllocationActive c L r jStar) take).mul_const
        (F (candidateAllocatedFactor c L r jStar x take)
          (candidateRetainedFactor c L r jStar 1 x take)))).div_const
      (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ)
  exact h.congr (Filter.Eventually.of_forall
    (candidate_separated_allocation_integrand_eq c L r jStar R take F))

theorem candidate_slot_box_integral  :
    ((∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
      (∫ ξ, activeAllocationFourierIntegrand (candidateAllocationRadius r) R
        (fun i => Real.log (candidateAllocationValue c L r jStar x i))
        (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
        (candidateAllocationActive c L r jStar) take ξ
          ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T) *
      F (candidateAllocatedFactor c L r jStar x take)
        (candidateRetainedFactor c L r jStar 1 x take)) /
      (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ)) =
      ∫ ξ, candidateSeparatedAllocationIntegrand c L r jStar R take F ξ
        ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T := by
  symm
  calc
    _ = ∫ ξ : ActiveAllocationIndex (candidateAllocationActive c L r jStar) → ℝ,
      (∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
        activeAllocationFourierIntegrand (candidateAllocationRadius r) R
          (fun i => Real.log (candidateAllocationValue c L r jStar x i))
          (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
          (candidateAllocationActive c L r jStar) take ξ *
        F (candidateAllocatedFactor c L r jStar x take)
          (candidateRetainedFactor c L r jStar 1 x take)) /
        (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ)
        ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T :=
      integral_congr_ae (Filter.Eventually.of_forall (fun ξ =>
        (candidate_separated_allocation_integrand_eq c L r jStar R take F ξ).symm))
    _ = _ := by
      rw [integral_div, integral_finsetSum]
      · simp only [integral_mul_const]
      · intro x hx
        exact (active_allocation_box_integrable _ _ _ _ _ _ _).mul_const _

end


theorem eventually_candidate_retained_box_integral {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ) (R T : ℝ) (S : Finset ℕ)
      (take : Fin ((candidateQIndices c L).card*r) → Bool),
      (∀ p ∈ S, p ∈ Nat.factoredNumbers
        ((candidatePIndices c L).biUnion (candidatePBand (c*L)))) →
      ∀ F : ℕ → ℕ → ℂ,
      Integrable (candidateRetainedAllocationIntegrand c L q r jStar R S take F)
        (activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T) ∧
      (∑ p ∈ S, (candidatePWeight c L q p : ℂ) *
        ((∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
          (∫ ξ, activeAllocationFourierIntegrand (candidateAllocationRadius r) R
            (fun i => Real.log (candidateAllocationValue c L r jStar x i))
            (fun i => c*L/2^(candidateAllocationOrder c L r i).1.val)
            (candidateAllocationActive c L r jStar) take ξ
              ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T) *
          F (candidateAllocatedFactor c L r jStar x take)
            (candidateRetainedFactor c L r jStar p x take)) /
          (((r.factorial : ℝ)^(candidateQIndices c L).card : ℝ) : ℂ))) =
        ∫ ξ, candidateRetainedAllocationIntegrand c L q r jStar R S take F ξ
          ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T := by
  filter_upwards [eventually_candidate_retained_allocation_integrand_eq hc] with L heq
  intro q r jStar R T S take hS F
  have hint : Integrable (candidateFullPAllocationIntegrand c L q r jStar R S take F)
      (activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T) := by
    apply integrable_finsetSum
    intro p hp
    exact (candidate_separated_allocation_box_integrable c L r jStar R T take
      (fun e n => F e (p*n))).const_mul _
  refine ⟨hint.congr (Filter.Eventually.of_forall (heq q r jStar R S take hS F)), ?_⟩
  calc
    _ = ∫ ξ, candidateFullPAllocationIntegrand c L q r jStar R S take F ξ
        ∂activeAllocationBoxMeasure (candidateAllocationActive c L r jStar) T := by
      unfold candidateFullPAllocationIntegrand
      rw [integral_finsetSum]
      · apply sum_congr rfl
        intro p hp
        rw [integral_const_mul]
        congr 1
        simp_rw [candidate_retained_factor_eq_mul_one c L r jStar p]
        exact candidate_slot_box_integral c L r jStar R T take (fun e n => F e (p*n))
      · intro p hp
        exact (candidate_separated_allocation_box_integrable c L r jStar R T take
          (fun e n => F e (p*n))).const_mul _
    _ = _ := integral_congr_ae (Filter.Eventually.of_forall (heq q r jStar R S take hS F))

end Bounty
end

