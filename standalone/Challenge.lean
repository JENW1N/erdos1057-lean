/- The exact original auxiliary multiplier is small outside a measurable
rational major set, with an explicit polynomial choice of denominator cutoff. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_aux_fourier_minor_bound
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hA : ∀ a, ‖bA a‖ ≤ 1) (hB : ∀ b, ‖bB b‖ ≤ 1)
    (U W : ℕ) (hUpos : 0 < U) (hWpos : 0 < W)
    (hArange : ∀ a, bA a ≠ 0 → U ≤ ∏ i : A, (a i).val ∧ (∏ i : A, (a i).val) < 2*U)
    (hBrange : ∀ b, bB b ≠ 0 → W ≤ ∏ i : B, (b i).val ∧ (∏ i : B, (b i).val) < 2*W)
    {C D : ℝ} (hC : 0 ≤ C) (hD : 0 ≤ D)
    (hAtomA : ∀ m : ℕ,
      (∑ a ∈ univ.filter (fun a : (∀ i : A, P i.val.1) => (∏ i : A, (a i).val) = m),
        finiteProductWeight (fun i : A => physicalLabelLaw V i.val.1) a) ≤ C/(m : ℝ))
    (hAtomB : ∀ m : ℕ,
      (∑ b ∈ univ.filter (fun b : (∀ i : B, P i.val.1) => (∏ i : B, (b i).val) = m),
        finiteProductWeight (fun i : B => physicalLabelLaw V i.val.1) b) ≤ D/(m : ℝ))
    (L κ t q Rsave : ℝ) (hL : 512 ≤ L) (ht : 0 ≤ t) (hq : 0 ≤ q)
    (hparam : 2*κ+t+2*Rsave+3 ≤ q) (hCb : C ≤ L^κ) (hDb : D ≤ L^κ)
    (hUlarge : L^q ≤ (U : ℝ)) (hWlarge : L^q ≤ (W : ℝ))
    (hlog : Real.log ((U : ℝ)*W) ≤ L^t) :
    ∀ θ, θ ∉ productMajorArcSet k L q U W →
      ‖physicalAuxFourierMultiplier P V A B hU hAB k bA bB θ‖ ≤ L^(-Rsave) := by
  intro θ hminor
  exact product_minor_arc_norm_bound hL hC hD ht hq hparam hCb hDb
    hUlarge hWlarge hlog k θ _
    (fun _u _r _β hr hcop hβ heq =>
      physical_aux_fourier_dyadic_bound P V A B hU hAB k bA bB hV hMass hA hB
        U W hUpos hWpos hArange hBrange hC hD hAtomA hAtomB θ hr hcop hβ heq)
    hminor

end Bounty
