section

/- Number and lower scale of the actual logarithmic cells meeting a dyad. -/

open Finset Filter

namespace Bounty

theorem int_finset_card_le_real_span (F : Finset ℤ) {a b : ℝ} (hab : a ≤ b)
    (hF : ∀ k ∈ F, a ≤ (k : ℝ) ∧ (k : ℝ) ≤ b) : (F.card : ℝ) ≤ b-a+1 := by
  classical
  by_cases hne : F.Nonempty
  · let lo := F.min' hne
    let hi := F.max' hne
    have hlohi : lo ≤ hi := F.min'_le_max' hne
    have hsub : F ⊆ Icc lo hi := fun k hk => mem_Icc.mpr ⟨F.min'_le k hk, F.le_max' k hk⟩
    have hc : (F.card : ℤ) ≤ (Icc lo hi).card := Int.ofNat_le.mpr (card_le_card hsub)
    rw [Int.card_Icc_of_le (a := lo) (b := hi) (by omega)] at hc
    have hcR : (F.card : ℝ) ≤ (hi : ℝ)+1-(lo : ℝ) := by exact_mod_cast hc
    have hlo := (hF lo (F.min'_mem hne)).1
    have hhi := (hF hi (F.max'_mem hne)).2
    linarith
  · rw [not_nonempty_iff_eq_empty.mp hne, card_empty, Nat.cast_zero]
    linarith

theorem logarithmic_cell_indices_card_dyad {δ Y : ℝ} (hδ : 0 < δ) (hY : 0 < Y)
    (F : Finset ℕ) (hF : ∀ n ∈ F, Y ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*Y) :
    ((logarithmicCellIndices δ F).card : ℝ) ≤ Real.log 2/δ+2 := by
  have hlogY : Real.log Y ≤ Real.log (2*Y) := Real.log_le_log hY (by linarith)
  have hspan : Real.log Y/δ-1 ≤ Real.log (2*Y)/δ := by
    have := div_le_div_of_nonneg_right hlogY hδ.le
    linarith
  have hindices : ∀ k ∈ logarithmicCellIndices δ F,
      Real.log Y/δ-1 ≤ (k : ℝ) ∧ (k : ℝ) ≤ Real.log (2*Y)/δ := by
    intro k hk
    obtain ⟨n, hn, rfl⟩ := mem_image.mp hk
    have hnR : 0 < (n : ℝ) := hY.trans_le (hF n hn).1
    have hb := logarithmic_cell_index_bounds hδ n
    have hlo := Real.log_le_log hY (hF n hn).1
    have hhi := Real.log_le_log hnR (hF n hn).2
    constructor
    · have hh : Real.log Y/δ ≤ (logarithmicCellIndex δ n : ℝ)+1 :=
        (div_le_iff₀ hδ).mpr (hlo.trans hb.2)
      linarith
    · exact ((le_div_iff₀ hδ).mpr (hb.1.le.trans hhi))
  have h := int_finset_card_le_real_span (logarithmicCellIndices δ F) hspan hindices
  rw [Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) hY.ne'] at h
  convert h using 1
  ring

theorem logarithmic_cell_base_lower {a L δ : ℝ} (hδ : 0 < δ)
    (hsmall : δ ≤ a*L/2) {n : ℕ} (hn : Real.exp (a*L) ≤ (n : ℝ)) :
    Real.exp ((a/2)*L) ≤ logarithmicCellBase δ (logarithmicCellIndex δ n) := by
  have hnR : 0 < (n : ℝ) := (Real.exp_pos _).trans_le hn
  have hlog := Real.log_le_log (Real.exp_pos (a*L)) hn
  rw [Real.log_exp] at hlog
  have hb := (logarithmic_cell_index_bounds hδ n).2
  apply Real.exp_le_exp.mpr
  nlinarith

theorem eventually_logarithmic_cell_dyad_bounds {a S : ℝ} (ha : 0 < a) (hS : 0 ≤ S) :
    ∀ᶠ L : ℝ in atTop, 0 < L ∧ ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ∀ F : Finset ℕ, (∀ n ∈ F, Y ≤ (n : ℝ) ∧ (n : ℝ) ≤ 2*Y) →
        ((logarithmicCellIndices (L^(-S)) F).card : ℝ) ≤ L^(S+1) ∧
        ∀ k ∈ logarithmicCellIndices (L^(-S)) F,
          Real.exp ((a/2)*L) ≤ logarithmicCellBase (L^(-S)) k := by
  filter_upwards [eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (2/a),
    eventually_ge_atTop (Real.log 2+2)] with L hL1 hLa hLc
  have hL : 0 < L := zero_lt_one.trans_le hL1
  refine ⟨hL, ?_⟩
  intro Y hY F hF
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have hδ : 0 < L^(-S) := Real.rpow_pos_of_pos hL _
  have hδ1 : L^(-S) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hL1 (by linarith)
  have hsmall : L^(-S) ≤ a*L/2 := by
    have hh := (div_le_iff₀ ha).mp hLa
    nlinarith
  constructor
  · have hc := logarithmic_cell_indices_card_dyad hδ hY0 F hF
    have hpow : 1 ≤ L^S := Real.one_le_rpow hL1 hS
    have hdiv : Real.log 2/L^(-S) = Real.log 2*L^S := by rw [Real.rpow_neg hL.le]; field_simp
    rw [hdiv] at hc
    calc
      _ ≤ Real.log 2*L^S+2 := hc
      _ ≤ (Real.log 2+2)*L^S := by nlinarith
      _ ≤ L*L^S := mul_le_mul_of_nonneg_right hLc (by positivity)
      _ = L^(S+1) := by rw [Real.rpow_add hL, Real.rpow_one]; ring
  · intro k hk
    obtain ⟨n, hn, rfl⟩ := mem_image.mp hk
    exact logarithmic_cell_base_lower hδ hsmall (hY.trans (hF n hn).1)

end Bounty
end

section

/- Exact full-cell cancellation leaves at most the two boundary cells of an interval. -/

open Finset

namespace Bounty

theorem logarithmic_cell_subset_interval {δ : ℝ} (hδ : 0 < δ) {m n : ℕ} {k : ℤ}
    (hk : k ∈ logarithmicCellIndices δ (Ioc m n))
    (hleft : k ≠ logarithmicCellIndex δ (m+1)) (hright : k ≠ logarithmicCellIndex δ n) :
    logarithmicCellSet δ k ⊆ Ioc m n := by
  obtain ⟨i, hi, hik⟩ := mem_image.mp hk
  have hi0 : 0 < i := lt_of_le_of_lt (Nat.zero_le _) (mem_Ioc.mp hi).1
  have hiC := (mem_logarithmic_cell_iff hδ hi0 k).mpr hik
  intro j hj
  obtain ⟨hjlo, hjhi⟩ := mem_Ioc.mp hj
  obtain ⟨hilo, hihi⟩ := mem_Ioc.mp hiC
  obtain ⟨hmi, hin⟩ := mem_Ioc.mp hi
  apply mem_Ioc.mpr
  constructor
  · by_contra h
    have hmC : m+1 ∈ logarithmicCellSet δ k := mem_Ioc.mpr ⟨by omega, by omega⟩
    exact hleft ((mem_logarithmic_cell_iff hδ (by omega) k).mp hmC).symm
  · by_contra h
    have hn0 : 0 < n := by omega
    have hnC : n ∈ logarithmicCellSet δ k := mem_Ioc.mpr ⟨by omega, by omega⟩
    exact hright ((mem_logarithmic_cell_iff hδ hn0 k).mp hnC).symm

theorem logarithmic_interval_cancellation_bound {δ : ℝ} (hδ : 0 < δ)
    (m n : ℕ) (g : ℕ → ℂ) {M : ℝ} (hM : 0 ≤ M)
    (hzero : ∀ k ∈ logarithmicCellIndices δ (Ioc m n), ∑ i ∈ logarithmicCellSet δ k, g i = 0)
    (hmass : ∀ k ∈ logarithmicCellIndices δ (Ioc m n),
      (∑ i ∈ logarithmicCellSet δ k, ‖g i‖) ≤ M) :
    ‖∑ i ∈ Ioc m n, g i‖ ≤ 2*M := by
  classical
  let K := logarithmicCellIndices δ (Ioc m n)
  let B := K.filter (fun k => ¬logarithmicCellSet δ k ⊆ Ioc m n)
  let f := fun k => ∑ i ∈ (Ioc m n).filter (fun i => logarithmicCellIndex δ i = k), g i
  have hBK : B ⊆ K := filter_subset _ _
  have hBpair : B ⊆ {logarithmicCellIndex δ (m+1), logarithmicCellIndex δ n} := by
    intro k hk
    obtain ⟨hkK, hknot⟩ := mem_filter.mp hk
    by_contra h
    have hneq : k ≠ logarithmicCellIndex δ (m+1) ∧ k ≠ logarithmicCellIndex δ n := by
      simpa only [mem_insert, mem_singleton, not_or] using h
    exact hknot (logarithmic_cell_subset_interval hδ hkK hneq.1 hneq.2)
  have hBcard : B.card ≤ 2 := (card_le_card hBpair).trans (by
    apply (card_insert_le _ _).trans
    simp only [card_singleton, Nat.le_refl])
  have hfzero : ∀ k ∈ K, k ∉ B → f k = 0 := by
    intro k hk hnot
    have hsub : logarithmicCellSet δ k ⊆ Ioc m n := by
      by_contra h
      exact hnot (mem_filter.mpr ⟨hk, h⟩)
    have heq : (Ioc m n).filter (fun i => logarithmicCellIndex δ i = k) = logarithmicCellSet δ k := by
      ext i
      constructor
      · intro hi
        obtain ⟨hiI, hiK⟩ := mem_filter.mp hi
        exact (mem_logarithmic_cell_iff hδ
          (lt_of_le_of_lt (Nat.zero_le _) (mem_Ioc.mp hiI).1) k).mpr hiK
      · intro hi
        exact mem_filter.mpr ⟨hsub hi, (mem_logarithmic_cell_iff hδ (logarithmic_cell_pos hi) k).mp hi⟩
    dsimp [f]
    rw [heq]
    exact hzero k hk
  have hsum : (∑ i ∈ Ioc m n, g i) = ∑ k ∈ B, f k := by
    rw [← sum_logarithmic_cell_fibers δ (Ioc m n) g]
    exact (sum_subset hBK hfzero).symm
  rw [hsum]
  calc
    _ ≤ ∑ k ∈ B, ‖f k‖ := norm_sum_le _ _
    _ ≤ ∑ _k ∈ B, M := by
      apply sum_le_sum
      intro k hk
      apply (norm_sum_le _ _).trans
      apply le_trans _ (hmass k (hBK hk))
      apply sum_le_sum_of_subset_of_nonneg
      · intro i hi
        obtain ⟨hiI, hiK⟩ := mem_filter.mp hi
        exact (mem_logarithmic_cell_iff hδ
          (lt_of_le_of_lt (Nat.zero_le _) (mem_Ioc.mp hiI).1) k).mpr hiK
      · intro i _ _
        exact norm_nonneg _
    _ = (B.card : ℝ)*M := by simp only [sum_const, nsmul_eq_mul]
    _ ≤ 2*M := mul_le_mul_of_nonneg_right (by exact_mod_cast hBcard) hM

end Bounty
end

section

/- Principal characters are exactly one on the actual prime-minus-proxy support. -/

open Finset Filter

namespace Bounty

theorem coprime_of_small_prime_avoidance {n r : ℕ} {W : ℝ}
    (hr : 0 < r) (hrW : (r : ℝ) ≤ W)
    (havoid : ∀ p ∈ primeBand 0 W, ¬p ∣ n) : n.Coprime r := by
  apply Nat.coprime_of_dvd'
  intro p hp hpn hpr
  have hpW : (p : ℝ) ≤ W := (Nat.cast_le.mpr (Nat.le_of_dvd hr hpr)).trans hrW
  have hW : 0 ≤ W := (Nat.cast_nonneg r).trans hrW
  have hpm : p ∈ primeBand 0 W := (mem_primeBand_iff le_rfl hW p).mpr
    ⟨hp, Nat.cast_pos.mpr hp.pos, hpW⟩
  exact False.elim (havoid p hpm hpn)

theorem prime_logarithmic_proxy_principal_identity (L S : ℝ) {n r : ℕ}
    (hr : 0 < r) (hrW : (r : ℝ) ≤ Real.exp (Real.sqrt L))
    (hnW : Real.exp (Real.sqrt L) < (n : ℝ)) :
    (((if n.Prime then 1 else 0 : ℝ)-primeLogarithmicProxy L S n : ℝ) : ℂ)*
      (1 : DirichletCharacter ℂ r) (n : ZMod r) =
    (((if n.Prime then 1 else 0 : ℝ)-primeLogarithmicProxy L S n : ℝ) : ℂ) := by
  by_cases hp : n.Prime
  · have hcop : n.Coprime r := hp.coprime_iff_not_dvd.mpr (by
      intro hnr
      have hnrR := (Nat.cast_le.mpr (Nat.le_of_dvd hr hnr)).trans hrW
      exact (not_lt_of_ge hnrR) hnW)
    rw [MulChar.one_apply ((ZMod.isUnit_iff_coprime _ _).mpr hcop), mul_one]
  · by_cases hz : primeLogarithmicProxy L S n = 0
    · simp only [if_neg hp, hz, sub_zero, Complex.ofReal_zero, zero_mul]
    · have hcop : n.Coprime r := coprime_of_small_prime_avoidance hr hrW
        (prime_cell_proxy_avoids_small_primes hz)
      rw [MulChar.one_apply ((ZMod.isUnit_iff_coprime _ _).mpr hcop), mul_one]

theorem eventually_prime_logarithmic_proxy_principal_identity {a : ℝ}
    (ha : 0 < a) (S T : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ n : ℕ, Real.exp (a*L) ≤ (n : ℝ) →
      ∀ r : ℕ, 0 < r → (r : ℝ) ≤ L^T →
        (((if n.Prime then 1 else 0 : ℝ)-primeLogarithmicProxy L S n : ℝ) : ℂ)*
          (1 : DirichletCharacter ℂ r) (n : ZMod r) =
        (((if n.Prime then 1 else 0 : ℝ)-primeLogarithmicProxy L S n : ℝ) : ℂ) := by
  have ha2 : 0 < a/2 := by positivity
  filter_upwards [eventually_rpow_le_exp_sqrt T, eventually_sqrt_le_dyadic_scale ha2 0,
    eventually_gt_atTop (0 : ℝ)] with L hmod hsqrt hL
  intro n hn r hr hrT
  apply prime_logarithmic_proxy_principal_identity L S hr (hrT.trans hmod)
  apply lt_of_lt_of_le _ hn
  apply Real.exp_lt_exp.mpr
  simp only [pow_zero, div_one] at hsqrt
  nlinarith

end Bounty
end

