noncomputable def boundedOrderedGhostOperator {P Z : Type*}
    [Fintype Z] [DecidableEq Z] (A D C ν : Z → ℝ) (t B : ℕ)
    (f : BoundedOrderedState P Z t B → ℂ) (s : BoundedOrderedState P Z t B) : ℂ :=
  symmetricOrderedGhostOperator A D C ν B
    (boundedOrderedZeroExtension f s.1) (boundedOrderedTupleToFinite s.2)

theorem bounded_ordered_memory_energy_range {Z : Type*} [Fintype Z]
    (ν : Z → ℝ) (B : ℕ) (F : FiniteOrderedTuple Z → ℂ) :
    finiteWeightedEnergy (boundedOrderedMemoryWeight ν)
      (fun q : BoundedOrderedTuple Z B => F (boundedOrderedTupleToFinite q)) =
      ∑ n ∈ range (B + 1),
        (∑ q : Fin n → Z, (∏ j, ν (q j)) * ‖F ⟨n, q⟩‖ ^ 2) / (n.factorial : ℝ) := by
  simpa only [finiteWeightedEnergy, smul_eq_mul, one_div_mul_eq_div] using
    bounded_ordered_memory_smul_sum_range ν B (fun q => ‖F q‖ ^ 2)

theorem bounded_ordered_state_energy_split {P Z : Type*} [Fintype P] [Fintype Z]
    (μ : P → ℝ) (ν : Z → ℝ) (t B : ℕ) (f : BoundedOrderedState P Z t B → ℂ) :
    finiteWeightedEnergy (boundedOrderedStateWeight μ ν) f =
      ∑ active : Fin t → P, (∏ i, μ (active i)) *
        finiteWeightedEnergy (boundedOrderedMemoryWeight ν) (fun q => f (active, q)) := by
  simp only [finiteWeightedEnergy, Fintype.sum_prod_type, boundedOrderedStateWeight,
    mul_sum, mul_assoc]

theorem bounded_ordered_ghost_symmetric {P Z : Type*} [Fintype Z] [DecidableEq Z]
    (A D C ν : Z → ℝ) (t B : ℕ) (f : BoundedOrderedState P Z t B → ℂ)
    (hf : BoundedOrderedSymmetric f) :
    BoundedOrderedSymmetric (boundedOrderedGhostOperator A D C ν t B f) := by
  intro active N q τ
  exact symmetric_ordered_ghost_operator_symmetric A D C ν B
    (boundedOrderedZeroExtension f active)
    ((boundedOrderedZeroExtension_symmetric_iff f).mpr hf active) N.val q τ

theorem bounded_ordered_ghost_energy_le {P Z : Type*} [Fintype P] [Fintype Z]
    [DecidableEq Z] (μ : P → ℝ) (A D C ν v : Z → ℝ) (t B : ℕ)
    (hμ : ∀ p, 0 ≤ μ p) (hA : ∀ z, 0 ≤ A z)
    (hν : ∀ z, 0 < ν z) (hv : ∀ z, 0 < v z)
    (hD : ∀ z, A z + |D z| / v z ≤ 1) (hC : ∀ z, A z + |C z| / v z ≤ 1)
    (f : BoundedOrderedState P Z t B → ℂ) (hf : BoundedOrderedSymmetric f) :
    finiteWeightedEnergy (boundedOrderedStateWeight μ ν)
      (boundedOrderedGhostOperator A D C ν t B f) ≤
      Real.exp (∑ z, (|C z| + |D z|) * ν z * v z) *
        finiteWeightedEnergy (boundedOrderedStateWeight μ ν) f := by
  have hlocal (active : Fin t → P) :
      finiteWeightedEnergy (boundedOrderedMemoryWeight ν)
        (fun q => boundedOrderedGhostOperator A D C ν t B f (active, q)) ≤
      Real.exp (∑ z, (|C z| + |D z|) * ν z * v z) *
        finiteWeightedEnergy (boundedOrderedMemoryWeight ν) (fun q => f (active, q)) := by
    have h := symmetric_ordered_ghost_l2_sq_le A D C ν v B hA hν hv hD hC
      (boundedOrderedZeroExtension f active)
      ((boundedOrderedZeroExtension_symmetric_iff f).mpr hf active)
    rw [← bounded_ordered_memory_energy_range, ← bounded_ordered_memory_energy_range] at h
    have hext (q : BoundedOrderedTuple Z B) :
        boundedOrderedZeroExtension f active (boundedOrderedTupleToFinite q) = f (active, q) :=
      boundedOrderedZeroExtension_apply f (active, q)
    simpa only [boundedOrderedGhostOperator, hext] using h
  rw [bounded_ordered_state_energy_split, bounded_ordered_state_energy_split, mul_sum]
  apply sum_le_sum
  intro active _
  calc
    _ ≤ (∏ i, μ (active i)) *
        (Real.exp (∑ z, (|C z| + |D z|) * ν z * v z) *
          finiteWeightedEnergy (boundedOrderedMemoryWeight ν) (fun q => f (active, q))) :=
      mul_le_mul_of_nonneg_left (hlocal active) (prod_nonneg fun i _ => hμ (active i))
    _ = _ := by ring
end

