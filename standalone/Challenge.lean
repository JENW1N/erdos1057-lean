open Finset
noncomputable def arithmeticProductWindow (p : ℕ) (X : ℝ) : Finset ℕ :=
  (Iic ⌊16 * X⌋₊).filter (fun n => X < (p * n : ℕ) ∧ (p * n : ℕ) ≤ 16 * X)

theorem mem_arithmeticProductWindow_iff {p n : ℕ} (hp : p ≠ 0) (X : ℝ) :
    n ∈ arithmeticProductWindow p X ↔ X < (p * n : ℕ) ∧ (p * n : ℕ) ≤ 16 * X := by
  simp only [arithmeticProductWindow, mem_filter, mem_Iic]
  constructor
  · exact And.right
  · intro h
    refine ⟨Nat.le_floor ?_, h⟩
    have hn : n ≤ p * n := Nat.le_mul_of_pos_left n (Nat.pos_of_ne_zero hp)
    exact (by exact_mod_cast hn : (n : ℝ) ≤ (p * n : ℕ)).trans h.2

theorem ordered_slot_arithmetic_window_sum {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (N : ℝ) {p : ℕ} (hp : p ≠ 0) (X : ℝ) :
    (∑ n ∈ arithmeticProductWindow p X, orderedSlotWeight choices N n) =
      ∑ x : ∀ i, choices i,
        if X < (p * orderedSlotProduct choices x : ℕ) ∧
          (p * orderedSlotProduct choices x : ℕ) ≤ 16 * X then 1 / N else 0 := by
  rw [ordered_slot_weight_window_sum]
  simp only [mem_arithmeticProductWindow_iff hp]

theorem ordered_slot_arithmetic_window_split {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (i : I) (N : ℝ) {p : ℕ} (hp : p ≠ 0) (X : ℝ) :
    (∑ n ∈ arithmeticProductWindow p X, orderedSlotWeight choices N n) =
      ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
        ((primeProductWindow (choices i)
          ((p * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y : ℕ) : ℝ) X).card : ℝ) / N := by
  rw [ordered_slot_arithmetic_window_sum choices N hp X]
  exact (by
    classical
    rw [ordered_slot_sum_test_split choices i
      (fun n => if X < (p * n : ℕ) ∧ (p * n : ℕ) ≤ 16 * X then 1 / N else 0)]
    rw [sum_comm]
    apply sum_congr rfl
    intro y _
    rw [primeProductWindow_card_eq_sum, sum_div]
    apply sum_congr rfl
    intro a _
    have heq : ((p * (a.val *
        orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y) : ℕ) : ℝ) =
        (a.val : ℝ) * ((p * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y : ℕ) : ℝ) := by
      simp only [Nat.cast_mul]
      ring
    rw [heq]
    split_ifs <;> simp
  )
end

