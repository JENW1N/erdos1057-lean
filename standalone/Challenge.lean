open Finset












/- Complete finite trace weight, with all transitions indexed directly by `Fin n`. -/
noncomputable def ghostPhaseFiniteTraceWeight {R : Type*} [Fintype R] [DecidableEq R]
    (isVisit atgt asrc : ℕ → Bool) (htgt hsrc : ℕ → R) (η β : ℕ → ℝ)
    (a0 : Bool) (β0 : ℝ) (an : Bool) {n : ℕ}
    (x : Fin (n + 1) → GhostPhaseState R) : ℝ :=
  ghostPhaseInitial a0 β0 (x 0) *
    (∏ j : Fin n, ghostPhaseMixedStep (isVisit j) (atgt j) (asrc j)
      (htgt j) (hsrc j) (η j) (β j) (x j.succ) (x j.castSucc)) *
    ghostPhaseTerminal an (x (Fin.last n))















end

