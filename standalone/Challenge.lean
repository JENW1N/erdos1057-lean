/- Remove unit visit factors from an alternating finite product. -/

open Finset
namespace Bounty

theorem alternating_even_one_product {M : Type*} [CommMonoid M]
    (f : ℕ → M) (n : ℕ) (h : ∀ j ≤ n, f (2 * j) = 1) :
    (∏ i ∈ range (2 * n + 1), f i) = ∏ j ∈ range n, f (2 * j + 1) := by
  induction n with
  | zero => simpa using h 0 (by omega)
  | succ n ih =>
    have hn : 2 * (n + 1) + 1 = (2 * n + 1) + 1 + 1 := by omega
    rw [hn, prod_range_succ, prod_range_succ, ih (fun j hj => h j (by omega)),
      show 2 * n + 1 + 1 = 2 * (n + 1) by omega, h (n + 1) le_rfl,
      mul_one, prod_range_succ]

end Bounty
