open MeasureTheory

namespace Bounty

theorem local_mellin_interval_mean_square (S : Finset ℕ) (a : ℕ → ℂ)
    (N : ℕ) (hS : ∀ n ∈ S, 1 ≤ n ∧ n ≤ N) (T : ℝ) (hT : 0 ≤ T) :
    (∫ t in Set.Icc (-T) T, ‖localMellinPolynomial S a t‖^2) ≤
      (2*T+4*(N:ℝ)*(1+Real.log N))*(∑ n ∈ S, ‖a n‖^2) := by
  have hm := dirichlet_polynomial_mean_square S a N (-T) T (by linarith) hS
  rw [intervalIntegral.integral_of_le (by linarith), ← integral_Icc_eq_integral_Ioc] at hm
  rw [show T - -T = 2*T by ring] at hm
  simpa only [localMellinPolynomial, mul_comm] using hm

theorem local_mellin_rapid_tail (S : Finset ℕ) (a : ℕ → ℂ)
    (N : ℕ) (hS : ∀ n ∈ S, 1 ≤ n ∧ n ≤ N) {L h : ℝ}
    (hL : 1 ≤ L) (hh : 0 < h) (M : ℕ) :
    (∫ t in {t : ℝ | L/h < |t|},
      (1+|h*t|)^(-((M+2:ℕ):ℝ))*‖localMellinPolynomial S a t‖^2) ≤
      (8*(L/h)+8*(N:ℝ)*(1+Real.log N))*(∑ n ∈ S, ‖a n‖^2)*L^(-(M:ℝ)) := by
  have hE : 0 ≤ ∑ n ∈ S, ‖a n‖^2 := Finset.sum_nonneg (fun _ _ => sq_nonneg _)
  have hlog : 0 ≤ Real.log N := Real.log_natCast_nonneg N
  have hb := weighted_mean_tail_bound (fun t => ‖localMellinPolynomial S a t‖^2)
    ((local_mellin_polynomial_continuous S a).norm.pow 2) (fun _ => sq_nonneg _)
    hL hh (A := 2*(∑ n ∈ S, ‖a n‖^2))
    (B := 4*(N:ℝ)*(1+Real.log N)*(∑ n ∈ S, ‖a n‖^2))
    (by positivity) M
    (local_mellin_weighted_energy_integrable S a hh (by exact_mod_cast (by omega : 1 < M+2)))
    (fun T hT => by
      have hm := local_mellin_interval_mean_square S a N hS T hT.le
      nlinarith)
  convert hb using 1
  ring

end Bounty
end

section

/- Comparing Mellin decay weights at nearby scales keeps the same polynomial. -/

open MeasureTheory

namespace Bounty

theorem mellin_decay_weight_scale_le (j : ℕ) {h q : ℝ}
    (hh : 0 ≤ h) (hq : 0 ≤ q) (hscale : h ≤ 32*q) (t : ℝ) :
    (1+|q*t|)^(-(j:ℝ)) ≤ (32:ℝ)^j * (1+|h*t|)^(-(j:ℝ)) := by
  have hx : 0 < 1+|q*t| := by positivity
  have hy : 0 < 1+|h*t| := by positivity
  have hxy : 1+|h*t| ≤ 32*(1+|q*t|) := by
    rw [abs_mul,abs_of_nonneg hh,abs_mul,abs_of_nonneg hq]
    nlinarith [mul_le_mul_of_nonneg_right hscale (abs_nonneg t)]
  rw [Real.rpow_neg hx.le, Real.rpow_natCast, Real.rpow_neg hy.le, Real.rpow_natCast]
  have hp : 1/(1+|q*t|)^j ≤ (32:ℝ)^j/(1+|h*t|)^j := by
    apply (div_le_div_iff₀ (pow_pos hx j) (pow_pos hy j)).mpr
    simpa only [one_mul,mul_pow] using pow_le_pow_left₀ hy.le hxy j
  simpa only [div_eq_mul_inv,one_mul] using hp

theorem local_mellin_energy_scale_le {j : ℕ} (hj : 2 ≤ j)
    (S : Finset ℕ) (a : ℕ → ℂ) {Y Z H : ℝ}
    (hY : 0 < Y) (hZ : 0 < Z) (hH : 0 < H) (hZY : Z ≤ 32*Y) :
    (∫ t : ℝ, (1+|(H/Z)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) ≤
      (32:ℝ)^j * ∫ t : ℝ, (1+|(H/Y)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2 := by
  have hjR : 1 < (j:ℝ) := by exact_mod_cast (show 1 < j by omega)
  have hi := local_mellin_weighted_energy_integrable S a (div_pos hH hZ) hjR
  have hi' := local_mellin_weighted_energy_integrable S a (div_pos hH hY) hjR
  have hscale : H/Y ≤ 32*(H/Z) := by
    calc
      H/Y ≤ H/(Z/32) := div_le_div_of_nonneg_left hH.le (by positivity) (by linarith)
      _ = 32*(H/Z) := by ring
  calc
    _ ≤ ∫ t : ℝ, (32:ℝ)^j * ((1+|(H/Y)*t|)^(-(j:ℝ))*‖localMellinPolynomial S a t‖^2) := by
      apply integral_mono hi (hi'.const_mul _)
      intro t
      simpa only [mul_assoc] using mul_le_mul_of_nonneg_right
        (mellin_decay_weight_scale_le j (div_nonneg hH.le hY.le) (div_nonneg hH.le hZ.le) hscale t)
        (sq_nonneg ‖localMellinPolynomial S a t‖)
    _ = _ := integral_const_mul _ _

end Bounty
end

section

/- Summing uniform centered local energies over the exact product major region. -/

open Finset MeasureTheory
namespace Bounty

theorem product_major_energy_of_rational_local
    (S : Finset ℤ) (f : ℤ → ℂ) {k : ℤ} {L q K U V Y A : ℝ}
    (hk : k ≠ 0) (hL : 5 ≤ L) (hq : 0 ≤ q) (hK : 0 ≤ K)
    (hkB : (k.natAbs : ℝ) ≤ L^K) (hU : 0 < U) (hV : 0 < V)
    (hY : 0 ≤ Y) (hscale : L^q ≤ U*V)
    (hlocal : ∀ (r : ℕ), 0 < r → (r : ℝ) ≤ L^(K+q) → ∀ a : ℤ,
      (∫ x in Set.Icc
        ((a : ℝ)/r-1/(|(k : ℝ)| *(U*V)/L^q))
        ((a : ℝ)/r+1/(|(k : ℝ)| *(U*V)/L^q)),
        ‖finiteFourierSum S f x‖^2) ≤ Y*L^(-(A+2*q+K+1))) :
    (∫ x in productMajorArcSet k L q U V ∩ Set.Ioc 0 1,
      ‖finiteFourierSum S f x‖^2) ≤ Y*L^(-A) := by
  have hLp : 0 < L := by linarith
  have hwidth : 1/(|(k : ℝ)| *(U*V)/L^q) = L^q/(|(k : ℝ)| *(U*V)) := by
    rw [one_div_div]
  have hsum := product_major_energy_uniform_bound S f hk hU hV hscale
    (E := Y*L^(-(A+2*q+K+1))) ?_
  · calc
      _ ≤ (⌊L^q⌋₊ : ℝ)*(2*((⌊L^q⌋₊*(k.natAbs+1) : ℕ) : ℝ)+1)*
          (Y*L^(-(A+2*q+K+1))) := hsum
      _ ≤ L^(2*q+K+1)*(Y*L^(-(A+2*q+K+1))) :=
        mul_le_mul_of_nonneg_right (rational_major_arc_polynomial_count hL hq hK hkB)
          (mul_nonneg hY (Real.rpow_nonneg hLp.le _))
      _ = Y*L^(-A) := by
        rw [mul_left_comm, ← Real.rpow_add hLp]
        congr 1
        congr 1
        ring
  · intro r hr u _
    obtain ⟨hdr, hden⟩ := rational_major_arc_denominator hLp hk hkB hr
    have he := hlocal (k.natAbs*r) hdr hden (-(k.sign*u))
    rw [hwidth, ← product_major_center_positive_denominator hk u (mem_Icc.mp hr).1] at he
    exact he

end Bounty
end

