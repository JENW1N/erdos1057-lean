noncomputable def physicalUnsharedCoordinate {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (C : G → Finset (Fin J))
    (u : GroupMarkedLists P (fun g => ell + (C g).card))
    (g : G) (s : PhysicalSlots J ell) (hs : s ∈ physicalUnsharedSlots (C g)) : P g :=
  u g ((physicalGroupUnsharedIndex (C g)).symm ⟨s, hs⟩)

theorem physical_unshared_coordinate_embedding {G : Type*} {P : G → Finset ℕ}
    {J ell : ℕ} (C : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell)
    (g : G) (s : PhysicalSlots J ell) (hs : s ∈ physicalUnsharedSlots (C g)) :
    physicalUnsharedCoordinate C (physicalGroupUnsharedEmbedding C L) g s hs = L g s := by
  change L g ((physicalGroupUnsharedIndex (C g))
    ((physicalGroupUnsharedIndex (C g)).symm ⟨s, hs⟩)).val = _
  rw [Equiv.apply_symm_apply]

theorem repeated_big_aux_union_unshared {G : Type*} [DecidableEq G] {J ell : ℕ}
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (i : RepeatedBigFlatIndex G J ell) (hi : i ∈ A ∪ B) :
    i.2 ∈ physicalUnsharedSlots (repeatedBigAuxCut A B i.1) := by
  rw [physicalUnsharedSlots, mem_compl]
  intro hs
  obtain ⟨j, hj, he⟩ := (physical_mem_shared_slots_iff _ _).mp hs
  apply hj
  apply (mem_repeatedBigAuxCut A B i.1 j).mpr
  have hie : i = ⟨i.1, Sum.inl j⟩ := Sigma.ext rfl (heq_of_eq he)
  rwa [← hie]

noncomputable def physicalPrimeUnsharedRestriction {G : Type*} [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (A B T : Finset (RepeatedBigFlatIndex G J ell)) (hT : T ⊆ A ∪ B)
    (u : GroupMarkedLists P (fun g => ell + (repeatedBigAuxCut A B g).card)) :
    ∀ i : T, P i.val.1 :=
  fun i => physicalUnsharedCoordinate (repeatedBigAuxCut A B) u i.val.1 i.val.2
    (repeated_big_aux_union_unshared A B i.val (hT i.property))

theorem physical_prime_unshared_restriction_embedding {G : Type*} [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ}
    (A B T : Finset (RepeatedBigFlatIndex G J ell)) (hT : T ⊆ A ∪ B)
    (L : PhysicalMarkLists P J ell) :
    physicalPrimeUnsharedRestriction A B T hT
      (physicalGroupUnsharedEmbedding (repeatedBigAuxCut A B) L) =
      finiteCoordinateRestrict T (repeatedBigFlatEquiv P J ell (fun g s => L g s)) := by
  funext i
  exact physical_unshared_coordinate_embedding (repeatedBigAuxCut A B) L i.val.1 i.val.2 _

end Bounty
