open Finset Classical
abbrev BoundedGhostEvent {P Z : Type*} (t B : ℕ)
    (s : BoundedOrderedState P Z t B) :=
  Σ b : Fin (B + 1), Finset (Fin s.2.1.val) × (Fin b.val → Z)

noncomputable def boundedGhostEventTarget {P Z : Type*} (t B : ℕ)
    (s : BoundedOrderedState P Z t B) (e : BoundedGhostEvent t B s) :
    BoundedOrderedState P Z t B :=
  let q := retainedBirthTuple s.2.2 e.2.1 e.2.2
  if h : q.1 ≤ B then (s.1, ⟨⟨q.1, Nat.lt_succ_of_le h⟩, q.2⟩) else s

noncomputable def boundedGhostEventWeight {P Z : Type*} (A D C ν : Z → ℝ)
    (t B : ℕ) (s : BoundedOrderedState P Z t B) (e : BoundedGhostEvent t B s) : ℝ :=
  if e.2.1.card + e.1.val ≤ B then
    ((∏ j ∈ e.2.1, A (s.2.2 j)) * (∏ j ∈ univ \ e.2.1, D (s.2.2 j))) *
      (∏ j, C (e.2.2 j) * ν (e.2.2 j)) / (e.1.val.factorial : ℝ)
  else 0










theorem bounded_ordered_ghost_eq_event_sum {P Z : Type*}
    [Fintype Z] [DecidableEq Z] (A D C ν : Z → ℝ) (t B : ℕ)
    (f : BoundedOrderedState P Z t B → ℂ) (s : BoundedOrderedState P Z t B) :
    boundedOrderedGhostOperator A D C ν t B f s =
      ∑ e : BoundedGhostEvent t B s, (boundedGhostEventWeight A D C ν t B s e : ℂ) *
        f (boundedGhostEventTarget t B s e) := by
  change symmetricOrderedGhostRow s.2.2 A D C ν B (boundedOrderedZeroExtension f s.1) = _
  unfold symmetricOrderedGhostRow
  rw [Fintype.sum_sigma]
  simp only [Fintype.sum_prod_type]
  rw [← Fin.sum_univ_eq_sum_range]
  apply sum_congr rfl
  intro b _
  rw [powerset_univ]
  apply sum_congr rfl
  intro retained _
  apply sum_congr rfl
  intro births _
  by_cases h : retained.card + b.val ≤ B
  · simp [boundedGhostEventWeight, boundedGhostEventTarget, retainedBirthTuple,
      boundedOrderedZeroExtension, h]
  · simp [boundedGhostEventWeight, h]




theorem boundedGhostEventWeight_abs {P Z : Type*} (A D C ν : Z → ℝ)
    (hA : ∀ z, 0 ≤ A z) (hν : ∀ z, 0 ≤ ν z) (t B : ℕ)
    (s : BoundedOrderedState P Z t B) (e : BoundedGhostEvent t B s) :
    |boundedGhostEventWeight A D C ν t B s e| =
      boundedGhostEventWeight A (fun z => |D z|) (fun z => |C z|) ν t B s e := by
  unfold boundedGhostEventWeight
  split_ifs
  · simp only [abs_div, abs_mul, abs_prod, abs_of_nonneg (Nat.cast_nonneg e.1.val.factorial : (0 : ℝ) ≤ _)]
    simp only [abs_of_nonneg (hA _), abs_of_nonneg (hν _)]
  · exact abs_zero
end

