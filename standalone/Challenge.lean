section

/- Local additive Fourier energy reduces to the actual logarithmic convolution energy. -/

open Finset MeasureTheory

namespace Bounty

theorem local_additive_convolution_dyadic_support (S : Finset ℕ) (a : ℕ → ℂ)
    {Y H v : ℝ} (_hY : 0 < Y) (hH : 0 < H) (hsmall : H ≤ Y/8)
    (hS : ∀ n ∈ S, Y ≤ (n:ℝ) ∧ (n:ℝ) ≤ 2*Y)
    (hv : v ∉ Set.Icc (Y/2) (3*Y)) : localAdditiveConvolution S a H v = 0 := by
  unfold localAdditiveConvolution
  apply sum_eq_zero
  intro n hn
  have hz : localMellinKernelSchwartz (((n:ℝ)-v)/H) = 0 := by
    apply local_mellin_kernel_unit_support
    apply lt_of_not_ge
    intro hb
    rw [abs_div, abs_of_pos hH] at hb
    have ht := abs_le.mp ((div_le_one hH).mp hb)
    apply hv
    constructor <;> linarith [(hS n hn).1, (hS n hn).2, ht.1, ht.2]
  rw [hz, mul_zero]

theorem local_log_convolution_continuousOn (S : Finset ℕ) (a : ℕ → ℂ)
    (hS : ∀ n ∈ S, 0 < n) {Y : ℝ} (hY : 0 < Y) (H : ℝ) :
    ContinuousOn (localLogConvolution S a H) (Set.Icc (Y/2) (3*Y)) := by
  have hv : ∀ v ∈ Set.Icc (Y/2) (3*Y), v ≠ 0 := by
    intro v hv
    have : 0 < v := by linarith [hv.1]
    exact this.ne'
  apply continuousOn_finsetSum
  intro n hn
  apply continuousOn_const.mul
  apply localMellinKernelSchwartz.continuous.comp_continuousOn
  apply ContinuousOn.div_const
  apply continuousOn_id.mul
  apply ContinuousOn.log
  · exact continuousOn_const.div continuousOn_id hv
  · intro v hv'
    exact div_ne_zero (by exact_mod_cast (hS n hn).ne') (hv v hv')

theorem local_convolution_difference (S : Finset ℕ) (a : ℕ → ℂ) (H v : ℝ) :
    localAdditiveConvolution S a H v - localLogConvolution S a H v =
      ∑ n ∈ S, a n * (localMellinKernelSchwartz (((n:ℝ)-v)/H) -
        localMellinKernelSchwartz (v*Real.log ((n:ℝ)/v)/H)) := by
  simp only [localAdditiveConvolution, localLogConvolution, mul_sub, sum_sub_distrib]

theorem exists_local_fourier_log_energy_constant :
    ∃ C : ℝ, 0 < C ∧ ∀ (S : Finset ℕ) (a : ℕ → ℂ) (Y H : ℝ),
      0 < Y → 1 ≤ H → H ≤ Y/8 →
      (∀ n ∈ S, Y ≤ (n:ℝ) ∧ (n:ℝ) ≤ 2*Y) →
      (∫ β in {β : ℝ | |β| ≤ 1/H}, ‖localAdditivePolynomial S a β‖^2) ≤
        (8/H^2) * (∫ v in Set.Icc (Y/2) (3*Y), ‖localLogConvolution S a H v‖^2) +
          C * (H/Y)^2 * (∑ n ∈ S, ‖a n‖^2) := by
  obtain ⟨C, hC, herr⟩ := exists_actual_local_kernel_error_constant
  refine ⟨8*C, by positivity, ?_⟩
  intro S a Y H hY hH hsmall hS
  have hHp : 0 < H := lt_of_lt_of_le zero_lt_one hH
  have hSpos : ∀ n ∈ S, 0 < n := by
    intro n hn
    exact_mod_cast hY.trans_le (hS n hn).1
  have hla := local_additive_convolution_contDiff S a H
  have hll := local_log_convolution_continuousOn S a hSpos hY H
  have hlaInt : IntegrableOn (fun v => ‖localAdditiveConvolution S a H v‖^2) (Set.Icc (Y/2) (3*Y)) :=
    (hla.continuous.norm.pow 2).integrableOn_Icc
  have hllInt : IntegrableOn (fun v => ‖localLogConvolution S a H v‖^2) (Set.Icc (Y/2) (3*Y)) :=
    (hll.norm.pow 2).integrableOn_Icc
  have hdInt : IntegrableOn (fun v => ‖localAdditiveConvolution S a H v-localLogConvolution S a H v‖^2) (Set.Icc (Y/2) (3*Y)) :=
    ((hla.continuous.continuousOn.sub hll).norm.pow 2).integrableOn_Icc
  have htri (v : ℝ) : ‖localAdditiveConvolution S a H v‖^2 ≤
      2*‖localLogConvolution S a H v‖^2 +
        2*‖localAdditiveConvolution S a H v-localLogConvolution S a H v‖^2 := by
    have hn := norm_add_le (localLogConvolution S a H v)
      (localAdditiveConvolution S a H v-localLogConvolution S a H v)
    have he : localLogConvolution S a H v + (localAdditiveConvolution S a H v-localLogConvolution S a H v) = localAdditiveConvolution S a H v := by abel
    rw [he] at hn
    have hs := pow_le_pow_left₀ (norm_nonneg _) hn 2
    nlinarith [sq_nonneg (‖localLogConvolution S a H v‖-
      ‖localAdditiveConvolution S a H v-localLogConvolution S a H v‖)]
  have hti := integral_mono hlaInt ((hllInt.const_mul 2).add (hdInt.const_mul 2)) htri
  simp only [Pi.add_apply] at hti
  rw [integral_add (hllInt.const_mul 2) (hdInt.const_mul 2), integral_const_mul,
    integral_const_mul] at hti
  have he := herr S a hSpos Y H hY hH hsmall
  simp_rw [← local_convolution_difference S a H] at he
  have heq : (∫ v : ℝ, ‖localAdditiveConvolution S a H v‖^2) =
      ∫ v in Set.Icc (Y/2) (3*Y), ‖localAdditiveConvolution S a H v‖^2 := by
    symm
    apply setIntegral_eq_integral_of_forall_compl_eq_zero
    intro v hv
    rw [local_additive_convolution_dyadic_support S a hY hHp hsmall hS hv, norm_zero, zero_pow (by decide)]
  apply (local_fourier_energy_le_convolution S a hHp).trans
  rw [heq]
  calc
    _ ≤ (4/H^2) * (2*(∫ v in Set.Icc (Y/2) (3*Y), ‖localLogConvolution S a H v‖^2) +
        2*(∫ v in Set.Icc (Y/2) (3*Y), ‖localAdditiveConvolution S a H v-localLogConvolution S a H v‖^2)) :=
      mul_le_mul_of_nonneg_left hti (by positivity)
    _ = (8/H^2)*(∫ v in Set.Icc (Y/2) (3*Y), ‖localLogConvolution S a H v‖^2) +
        8*((∫ v in Set.Icc (Y/2) (3*Y), ‖localAdditiveConvolution S a H v-localLogConvolution S a H v‖^2)/H^2) := by ring
    _ ≤ (8/H^2)*(∫ v in Set.Icc (Y/2) (3*Y), ‖localLogConvolution S a H v‖^2) +
        8*(C*(H/Y)^2*(∑ n ∈ S, ‖a n‖^2)) := by linarith
    _ = _ := by ring

end Bounty
end

section

/- The square-error estimate for the actual ordered-list coefficient on big groups. -/

open Finset
open scoped Classical

namespace Bounty

theorem weighted_small_mark_extraction_error_energy
    {G : Type*} [Fintype G]
    (P : G → Finset ℕ) {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v)
    (V : G → ℝ) (t : G → ℕ) (T : ℕ)
    (hV : ∀ g, v ≤ V g) (ht : ∀ g, t g ≤ T)
    (hprime : ∀ g, ∀ p ∈ P g, p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (g : G) (k : ℕ) (htg : t g = k + 1) (big : Finset G) (hsmall : g ∉ big)
    (b : GroupMarkedLists (fun h : big => P h.val) (fun h : big => t h.val) → ℂ)
    {H : ℝ} (hH : 0 ≤ H) (hb : ∀ L, ‖b L‖ ≤ H)
    (Q : Finset ℕ) (hQ : P g ⊆ Q) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (positions : Finset ℕ) (N : ℕ) (hpos : ∀ n ∈ positions, 0 < n ∧ n ≤ N) :
    let c := fun n : ℕ => groupMarkedAverage
      (fun h : big => P h.val) (fun h : big => t h.val) (n : ℤ) b
    (∑ n ∈ positions,
      ‖weightedGroupMarkedSum P q V t (n : ℤ) (fun L => b (fun h : big => L h.val)) *
          invariantTripleEndpoint Q α β γ n -
        markedPrimePeel univ P q V t g k (fun m => c m * invariantTripleEndpoint Q α β γ m) n‖ ^ 2) ≤
      H ^ 2 * (((markedDivisorBound q v T) ^ Fintype.card G * (1 + 2 * Real.log N / v)) ^ 2 *
        (((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) *
          ∑ p ∈ P g, 1 / (p : ℝ) ^ 2)) := by
  classical
  dsimp only
  have hc (n : ℕ) :
      ‖groupMarkedAverage (fun h : big => P h.val) (fun h : big => t h.val) (n : ℤ) b‖ ≤ H :=
    group_marked_average_norm_le _ _ _ b hH (fun L => hb L.val)
  have hinv (n p : ℕ) (hp : p ∈ P g) (hpn : p ∣ n) :=
    group_marked_selected_average_div_prime P t big (fun h _ => hprime h)
      hdis g hsmall hp (hprime g p hp) hpn b
  have h := invariant_marked_coefficient_peel_error_energy univ P hq0 hq1 hv V t T
    (fun h _ => hV h) (fun h _ => ht h) (fun h _ => hprime h) hdis
    g (mem_univ g) k htg Q hQ α β γ hA hB hC hα hβ hγ positions N hpos
    (fun n => groupMarkedAverage (fun h : big => P h.val) (fun h : big => t h.val) (n : ℤ) b)
    (fun n _ => hc n) (fun n _ p hp hpn => hinv n p hp hpn)
  simpa only [weighted_group_marked_sum_selected_average, mul_assoc, card_univ] using h

end Bounty
