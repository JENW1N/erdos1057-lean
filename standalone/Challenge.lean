section

/- The full compact, range-restricted allocation retains the original marking. -/

open Finset Real

namespace Bounty

noncomputable def candidateRangeAllocationMass (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (E : ℝ) : ℝ :=
  ∑ take : Fin ((candidateQIndices c L).card*r) → Bool,
    if E/L^88 ≤ (candidateAllocatedFactor c L r jStar x take : ℝ) ∧
      (candidateAllocatedFactor c L r jStar x take : ℝ) ≤ E
    then candidateCompactAllocationWeight c L r jStar x (log E) take else 0

noncomputable def candidateCompactRangeQWeight (c L : ℝ) (r jStar : ℕ) (E : ℝ) (n : ℕ) : ℝ :=
  ∑ x : ∀ slot, candidateQSlotChoices c L r jStar slot,
    if orderedSlotProduct (candidateQSlotChoices c L r jStar) x = n
    then candidateRangeAllocationMass c L r jStar x E /
      ((r.factorial : ℝ)^(candidateQIndices c L).card) else 0

noncomputable def candidateCompactRangeCoefficient (c L q : ℝ) (r jStar : ℕ) (E : ℝ) (u : ℕ) : ℝ :=
  candidateCompactRangeQWeight c L r jStar E
    (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) u) *
  markedDivisorWeight (candidatePIndices c L) (candidatePBand (c*L)) q
    (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p : ℝ)) (fun _ => 1) (u : ℤ)

theorem candidate_range_allocation_mass_bounds (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (E : ℝ) :
    0 ≤ candidateRangeAllocationMass c L r jStar x E ∧
      candidateRangeAllocationMass c L r jStar x E ≤ 1 := by
  constructor
  · exact sum_nonneg (fun take _ => by
      split_ifs
      · exact (candidate_compact_allocation_bounds c L r jStar x (log E) take).1
      · exact le_rfl)
  · apply le_trans ?_ (candidate_compact_allocation_total_mass_le_one c L r jStar x (log E))
    apply sum_le_sum
    intro take _
    split_ifs
    · exact le_rfl
    · exact (candidate_compact_allocation_bounds c L r jStar x (log E) take).1

theorem candidate_compact_range_Q_bounds (c L : ℝ) (r jStar : ℕ) (E : ℝ) (n : ℕ) :
    0 ≤ candidateCompactRangeQWeight c L r jStar E n ∧
      candidateCompactRangeQWeight c L r jStar E n ≤ candidateQWeight c L r jStar n := by
  classical
  have sum_compare {X : Type} (s t : Finset X) (f g : X → ℝ)
      (hst : s=t) (hfg : ∀ x ∈ s, f x ≤ g x) : (∑ x ∈ s, f x) ≤ ∑ x ∈ t, g x := by
    rw [← hst]
    exact sum_le_sum hfg
  have hnorm : 0 ≤ (r.factorial : ℝ)^(candidateQIndices c L).card := by positivity
  constructor
  · exact sum_nonneg (fun x _ => by
      split_ifs
      · exact div_nonneg (candidate_range_allocation_mass_bounds c L r jStar x E).1 hnorm
      · exact le_rfl)
  · unfold candidateCompactRangeQWeight candidateQWeight orderedSlotWeight
    apply sum_compare
    · ext x; simp only [mem_univ]
    · intro x hx
      split_ifs
      · exact div_le_div_of_nonneg_right (candidate_range_allocation_mass_bounds c L r jStar x E).2 hnorm
      · exact le_rfl

theorem candidate_compact_range_coefficient_bounds (c L : ℝ) {q : ℝ} (hq : 0 ≤ q)
    (r jStar : ℕ) (E : ℝ) (u : ℕ) :
    0 ≤ candidateCompactRangeCoefficient c L q r jStar E u ∧
      candidateCompactRangeCoefficient c L q r jStar E u ≤ candidateCoefficient c L q r jStar u := by
  have hw := marked_divisor_weight_nonneg (candidatePIndices c L) (candidatePBand (c*L)) hq
    (fun j => ∑ p ∈ candidatePBand (c*L) j, 1/(p : ℝ)) (fun _ => 1)
    (fun _ _ => sum_nonneg (fun _ _ => by positivity)) (u : ℤ)
  have hb := candidate_compact_range_Q_bounds c L r jStar E
    (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c*L))) u)
  exact ⟨mul_nonneg hb.1 hw, mul_le_mul_of_nonneg_right hb.2 hw⟩

theorem candidate_range_allocation_mass_eq_one (c L : ℝ) (r jStar : ℕ)
    (x : ∀ slot, candidateQSlotChoices c L r jStar slot) (E : ℝ)
    (hunit : (∑ take, candidateCompactAllocationWeight c L r jStar x (log E) take) = 1)
    (hrange : ∀ take, 0 < candidateCompactAllocationWeight c L r jStar x (log E) take →
      E/L^88 ≤ (candidateAllocatedFactor c L r jStar x take : ℝ) ∧
        (candidateAllocatedFactor c L r jStar x take : ℝ) ≤ E) :
    candidateRangeAllocationMass c L r jStar x E = 1 := by
  rw [← hunit]
  apply sum_congr rfl
  intro take ht
  split_ifs with h
  · rfl
  · have hn := (candidate_compact_allocation_bounds c L r jStar x (log E) take).1
    have hp : ¬0 < candidateCompactAllocationWeight c L r jStar x (log E) take :=
      fun hp => h (hrange take hp)
    linarith

end Bounty
end

