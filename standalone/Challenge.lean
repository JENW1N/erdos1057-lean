theorem totient_sieve_squarefree_mass_le_log (N : ℕ) {D : ℝ}
    (hD : 1 ≤ D) (hND : (N : ℝ) ≤ D) :
    (∑ d ∈ (Icc 1 N).filter Squarefree, 1 / (Nat.totient d : ℝ)) ≤
      (2 * primeEulerProductUpperConstant) * Real.log (2 * D) := by
  let P := (Icc 1 N).filter Nat.Prime
  have hP : ∀ p ∈ P, p.Prime := fun _ hp => (mem_filter.mp hp).2
  have hsub := totient_sieve_squarefree_moduli_subset P ((Icc 1 N).filter Squarefree) hP
    (fun _ hd => (mem_filter.mp hd).2) (totient_sieve_interval_squarefree_prime_support N)
  calc
    _ ≤ ∑ d ∈ (∏ p ∈ P, p).divisors, 1 / (Nat.totient d : ℝ) :=
      sum_le_sum_of_subset_of_nonneg hsub (fun _ _ _ => by positivity)
    _ = ∏ p ∈ P, (1 + 1 / ((p : ℝ) - 1)) := totient_sieve_divisor_mass P hP
    _ ≤ _ := totient_sieve_interval_euler_product_le_log N hD hND

theorem totient_sieve_noncoprime_mass_le_log (N n : ℕ) (hn : n ≠ 0) {D : ℝ}
    (hD : 1 ≤ D) (hND : (N : ℝ) ≤ D) :
    (∑ d ∈ (Icc 1 N).filter (fun d => Squarefree d ∧ ¬ Nat.Coprime d n),
      1 / (Nat.totient d : ℝ)) ≤
      (∑ p ∈ n.primeFactors, 1 / ((p : ℝ) - 1)) *
        ((2 * primeEulerProductUpperConstant) * Real.log (2 * D)) := by
  have hnonneg (p : ℕ) (hp : p ∈ n.primeFactors) : 0 ≤ 1 / ((p : ℝ) - 1) := by
    have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast (Nat.prime_of_mem_primeFactors hp).one_le
    positivity
  apply (totient_sieve_interval_noncoprime_mass N n hn).trans
  apply mul_le_mul
  · exact sum_le_sum_of_subset_of_nonneg (filter_subset _ _) (fun p hp _ => hnonneg p hp)
  · exact totient_sieve_interval_euler_product_le_log N hD hND
  · apply prod_nonneg
    intro p hp
    have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast (mem_filter.mp hp).2.one_le
    positivity
  · exact sum_nonneg hnonneg
