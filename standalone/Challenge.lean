/- Rounding the reservoir-to-ambient size ratio gives all the finite spectral
conditions as soon as the ambient character error is at most `N / 64`. -/
theorem fejer_length_parameters {N Q A : ℝ} (hN : 0 < N) (hNQ : N ≤ Q)
    (hA : 0 ≤ A) (hsmall : 64 * A ≤ N) :
    ∃ R : ℕ, 0 < R ∧ 64 * Q ≤ N * R ∧
      (R - 1 : ℝ) * A ≤ Q ∧ (R : ℝ) ≤ 65 * Q / N := by
  let z : ℝ := 64 * Q / N
  have hQ : 0 < Q := hN.trans_le hNQ
  have hz : 0 < z := div_pos (by positivity) hN
  have hratio : 1 ≤ Q / N := (le_div_iff₀ hN).mpr (by simpa using hNQ)
  have hceil := Nat.le_ceil z
  have hceil' := Nat.ceil_lt_add_one hz.le
  have hR : 0 < ⌈z⌉₊ := Nat.ceil_pos.mpr hz
  refine ⟨⌈z⌉₊, hR, ?_, ?_, ?_⟩
  · exact (div_le_iff₀ hN).mp hceil |>.trans_eq (by ring)
  · have hle : (⌈z⌉₊ : ℝ) - 1 ≤ z := by linarith
    have hmul := mul_le_mul_of_nonneg_right hle hA
    have hlast : z * A ≤ Q := by
      change 64 * Q / N * A ≤ Q
      rw [div_mul_eq_mul_div]
      apply (div_le_iff₀ hN).mpr
      have h := mul_le_mul_of_nonneg_left hsmall hQ.le
      convert h using 1
      ring
    exact hmul.trans hlast
  · dsimp [z] at hceil' ⊢
    have hid : 65 * Q / N = 64 * Q / N + Q / N := by ring
    rw [hid]
    linarith
end

section
open Filter Set
open scoped Topology
/- A continuous cofinal real function maps every terminal ray onto a terminal ray. -/
theorem eventually_exists_preimage_ge {X : ℝ → ℝ} {a : ℝ}
    (hcont : ContinuousOn X (Ici a)) (htop : Tendsto X atTop atTop) (c : ℝ) :
    ∀ᶠ x : ℝ in atTop, ∃ y : ℝ, c ≤ y ∧ X y = x := by
  have hc : ContinuousOn X (Ici (max a c)) :=
    hcont.mono (Ici_subset_Ici.mpr (le_max_left a c))
  refine eventually_atTop.mpr ⟨X (max a c), ?_⟩
  intro x hx
  obtain ⟨y, hy, hxy⟩ := intermediate_value_Ici hc htop hx
  exact ⟨y, (le_max_right a c).trans hy, hxy⟩

/- An eventual property verified along a continuous cofinal parameter holds for all large values. -/
theorem eventually_of_eventually_comp_cofinal {X : ℝ → ℝ} {a : ℝ}
    (hcont : ContinuousOn X (Ici a)) (htop : Tendsto X atTop atTop)
    {P : ℝ → Prop} (hP : ∀ᶠ y : ℝ in atTop, P (X y)) :
    ∀ᶠ x : ℝ in atTop, P x := by
  obtain ⟨c, hc⟩ := eventually_atTop.mp hP
  filter_upwards [eventually_exists_preimage_ge hcont htop c] with x hx
  obtain ⟨y, hy, rfl⟩ := hx
  exact hc y hy







/- The size parameter used for prime-subset products in the transfer argument. -/
noncomputable def carmichaelSizeParameter (η ν y : ℝ) : ℝ :=
  (5 * y) ^ ((1 + ν) * y ^ η)

/- The size parameter is continuous on the ray where its bases are positive. -/
theorem carmichaelSizeParameter_continuousOn (η ν : ℝ) :
    ContinuousOn (carmichaelSizeParameter η ν) (Ici 1) := by
  unfold carmichaelSizeParameter
  have hpow : ContinuousOn (fun y : ℝ => y ^ η) (Ici 1) :=
    continuousOn_id.rpow_const (fun y hy =>
      Or.inl (ne_of_gt (lt_of_lt_of_le zero_lt_one hy)))
  exact (continuousOn_const.mul continuousOn_id).rpow (continuousOn_const.mul hpow)
    (fun y hy => Or.inl (mul_ne_zero (by norm_num)
      (ne_of_gt (lt_of_lt_of_le zero_lt_one hy))))

/- This elementary comparison already proves that the size parameter tends to infinity. -/
theorem self_le_carmichaelSizeParameter {η ν y : ℝ}
    (hη : 0 ≤ η) (hν : 0 ≤ ν) (hy : 1 ≤ y) :
    y ≤ carmichaelSizeParameter η ν y := by
  have hpow : 1 ≤ y ^ η := Real.one_le_rpow hy hη
  have hexp : 1 ≤ (1 + ν) * y ^ η := by nlinarith
  have hbase : 1 ≤ 5 * y := by linarith
  have hle : 5 * y ≤ (5 * y) ^ ((1 + ν) * y ^ η) :=
    by simpa only [Real.rpow_one] using Real.rpow_le_rpow_of_exponent_le hbase hexp
  exact (by linarith : y ≤ 5 * y).trans hle

theorem carmichaelSizeParameter_tendsto_atTop {η ν : ℝ}
    (hη : 0 ≤ η) (hν : 0 ≤ ν) :
    Tendsto (carmichaelSizeParameter η ν) atTop atTop := by
  apply tendsto_atTop_mono' atTop _ tendsto_id
  filter_upwards [eventually_ge_atTop (1 : ℝ)] with y hy
  exact self_le_carmichaelSizeParameter hη hν hy

/- All-large-parameter estimates at the Carmichael size scale imply all-large-X estimates. -/
theorem eventually_of_carmichaelSizeParameter {η ν : ℝ}
    (hη : 0 ≤ η) (hν : 0 ≤ ν) {P : ℝ → Prop}
    (hP : ∀ᶠ y : ℝ in atTop, P (carmichaelSizeParameter η ν y)) :
    ∀ᶠ x : ℝ in atTop, P x :=
  eventually_of_eventually_comp_cofinal (carmichaelSizeParameter_continuousOn η ν)
    (carmichaelSizeParameter_tendsto_atTop hη hν) hP
end

section
open Filter
open scoped Topology
/- A logarithm times a smaller real power is negligible compared with a larger power. -/
theorem tendsto_rpow_log_div_rpow {a b : ℝ} (hab : a < b) :
    Tendsto (fun y : ℝ => y ^ a * Real.log y / y ^ b) atTop (𝓝 0) := by
  have h := (isLittleO_log_rpow_atTop (sub_pos.mpr hab)).tendsto_div_nhds_zero
  refine h.congr' ?_
  filter_upwards [eventually_gt_atTop (0 : ℝ)] with y hy
  rw [Real.rpow_sub hy]
  have ha : y ^ a ≠ 0 := ne_of_gt (Real.rpow_pos_of_pos hy a)
  have hb : y ^ b ≠ 0 := ne_of_gt (Real.rpow_pos_of_pos hy b)
  field_simp

/- Arbitrary fixed coefficients and an additive constant preserve the comparison. -/
theorem tendsto_mul_rpow_log_add_div_rpow {a b : ℝ} (hb : 0 < b) (hab : a < b)
    (d k : ℝ) :
    Tendsto (fun y : ℝ => (d * y ^ a * Real.log y + k) / y ^ b) atTop (𝓝 0) := by
  have h := ((tendsto_rpow_log_div_rpow hab).const_mul d).add
    ((tendsto_rpow_atTop hb).const_div_atTop k)
  have heq : (fun y : ℝ => (d * y ^ a * Real.log y + k) / y ^ b) =
      (fun y : ℝ => d * (y ^ a * Real.log y / y ^ b) + k / y ^ b) := by
    funext y
    ring
  rw [heq]
  simpa only [mul_zero, zero_add] using h

/- Eventually every positive multiple of the larger power absorbs the error term. -/
theorem eventually_mul_rpow_log_add_le_rpow {a b c : ℝ}
    (hb : 0 < b) (hab : a < b) (hc : 0 < c) (d k : ℝ) :
    ∀ᶠ y : ℝ in atTop, d * y ^ a * Real.log y + k ≤ c * y ^ b := by
  filter_upwards [(tendsto_mul_rpow_log_add_div_rpow hb hab d k).eventually_le_const hc,
    eventually_gt_atTop (0 : ℝ)] with y h hy
  exact (div_le_iff₀ (Real.rpow_pos_of_pos hy b)).mp h





















end

section
open Filter Finset
open scoped Topology
/- The complete logarithmic size budget is sublinear when `a + d < 1`.
This is uniform in all local weights and active moduli satisfying the stated
growth bounds. The degree is chosen explicitly by a ceiling. -/
theorem eventually_residue_precision_parameters {a d A γ : ℝ}
    (ha : 0 ≤ a) (hd : 0 ≤ d) (had : a + d < 1) (hA : 0 < A) (hγ : 0 < γ) :
    ∀ᶠ L : ℝ in atTop, ∀ ℓ B C q N : ℝ,
      0 ≤ ℓ → 0 ≤ B → 0 ≤ C → 0 < q → 0 < N →
      ℓ ≤ A * (L^a * Real.log L) → B ≤ A * (L^a * Real.log L) →
      Real.log q ≤ A * (L^(a + d) * Real.log L) →
      Real.log (1 + C) ≤ A * L^d → γ * L ≤ Real.log N →
      let k := Nat.ceil (5 * ℓ + B + Real.log 4)
      5 * ℓ + B + Real.log 4 ≤ (k : ℝ) ∧
      (k : ℝ) ≤ (6 * A + Real.log 4 + 1) * (L^a * Real.log L) ∧
      4 * q * (k + 1 : ℕ) * Real.exp (B + 2 * ℓ) * (1 + C)^k ≤ N := by
  let K : ℝ := 6 * A + Real.log 4 + 1
  let H : ℝ := Real.log 4 + K + 1 + 4 * A + K * A
  have hlog4 : 0 ≤ Real.log 4 := Real.log_nonneg (by norm_num)
  have hK : 0 ≤ K := by dsimp [K]; positivity
  have hscale : ∀ᶠ L : ℝ in atTop, H * (L^(a + d) * Real.log L) ≤ γ * L := by
    simpa only [add_zero, Real.rpow_one, mul_assoc] using
      eventually_mul_rpow_log_add_le_rpow (b := 1) (by norm_num) had hγ H 0
  filter_upwards [hscale,
    eventually_ge_atTop (Real.exp 1)] with L hbudget hL
  have hL1 : 1 ≤ L := le_trans (Real.one_le_exp (by norm_num : (0 : ℝ) ≤ 1)) hL
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL1
  have hlogL : 1 ≤ Real.log L := by
    simpa only [Real.log_exp] using Real.log_le_log (Real.exp_pos 1) hL
  let u := L^a * Real.log L
  let v := L^(a + d) * Real.log L
  have hu : 1 ≤ u := by
    dsimp [u]
    nlinarith [Real.one_le_rpow hL1 ha]
  have huv : u ≤ v := by
    exact mul_le_mul_of_nonneg_right
      (Real.rpow_le_rpow_of_exponent_le hL1 (by linarith)) (by linarith)
  have hv : 1 ≤ v := hu.trans huv
  have hmul : u * L^d = v := by
    dsimp [u, v]
    rw [Real.rpow_add hL0]
    ring
  intro ℓ B C q N hℓ hB hC hq hN hℓbound hBbound hqbound hCbound hNbound
  dsimp only
  let k := Nat.ceil (5 * ℓ + B + Real.log 4)
  have hk : 5 * ℓ + B + Real.log 4 ≤ (k : ℝ) := Nat.le_ceil _
  have hkupper : (k : ℝ) ≤ 5 * ℓ + B + Real.log 4 + 1 :=
    (Nat.ceil_lt_add_one (by positivity : 0 ≤ 5 * ℓ + B + Real.log 4)).le
  have hku : (k : ℝ) ≤ K * u := by
    dsimp [K]
    change ℓ ≤ A * u at hℓbound
    change B ≤ A * u at hBbound
    nlinarith [mul_le_mul_of_nonneg_left hu (show 0 ≤ Real.log 4 + 1 by positivity)]
  refine ⟨hk, hku, ?_⟩
  apply residue_size_condition_of_log hC hq hN k
  have hlogk : Real.log (k + 1 : ℕ) ≤ (K + 1) * v := by
    have hl := Real.log_le_self (by positivity : (0 : ℝ) ≤ (k + 1 : ℕ))
    have hk1 : ((k + 1 : ℕ) : ℝ) ≤ (K + 1) * u := by
      push_cast
      nlinarith
    exact hl.trans (hk1.trans (mul_le_mul_of_nonneg_left huv (by positivity)))
  have hlinear : B + 2 * ℓ ≤ 3 * A * v := by
    have hAv := mul_le_mul_of_nonneg_left huv hA.le
    change ℓ ≤ A * u at hℓbound
    change B ≤ A * u at hBbound
    nlinarith
  have hlogmass : (k : ℝ) * Real.log (1 + C) ≤ K * A * v := by
    calc
      _ ≤ (k : ℝ) * (A * L^d) := mul_le_mul_of_nonneg_left hCbound (Nat.cast_nonneg k)
      _ ≤ (K * u) * (A * L^d) := mul_le_mul_of_nonneg_right hku (by positivity)
      _ = K * A * v := by rw [← hmul]; ring
  have hlogconst : Real.log 4 ≤ Real.log 4 * v := by nlinarith
  change Real.log q ≤ A * v at hqbound
  change H * v ≤ γ * L at hbudget
  calc
    _ ≤ Real.log 4 * v + A * v + (K + 1) * v + 3 * A * v + K * A * v := by linarith
    _ = H * v := by dsimp [H]; ring
    _ ≤ γ * L := hbudget
    _ ≤ Real.log N := hNbound
end

section
open Finset
/- The contribution of the primes that have no active visit in the path. -/
noncomputable def inactivePathResidueWeight {ι : Type*} (m : ι → ℕ) (S : Finset ι)
    (visits : Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ) (n : ℤ) : ℝ :=
  ∏ i ∈ S, ∏ j ∈ visits, (1 - η j * (if (n : ZMod (m i)) = h i j then 1 else 0))

theorem inactive_path_residue_weight_eq {ι : Type*} (m : ι → ℕ) (S : Finset ι)
    (visits : Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ) (n : ℤ) :
    inactivePathResidueWeight m S visits h η n =
      ∏ i ∈ S, (1 - visitExclusion visits (h i) η (n : ZMod (m i))) := by
  simp [inactivePathResidueWeight, visitExclusion]

/- The local average of a never-active prime is one minus its exclusion
probability, including all repeated visits. -/
theorem inactive_path_local_average {ι : Type*} (m : ι → ℕ) [∀ i, NeZero (m i)]
    (visits : Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ) (i : ι) :
    ((∑ r : ZMod (m i), ∏ j ∈ visits, (1 - η j * (if r = h i j then 1 else 0))) / (m i : ℝ)) =
      1 - exclusionLocalMean m (fun i => visitExclusion visits (h i) η) i := by
  have hm : (m i : ℝ) ≠ 0 := by exact_mod_cast NeZero.ne (m i)
  simp only [exclusionLocalMean, visitExclusion, sum_sub_distrib,
    sum_const, card_univ, ZMod.card, nsmul_eq_mul, mul_one]
  field_simp
  ring

/- The independent-residue expectation is the product of all local
averages, with uniform measure at each active and inactive modulus. -/
noncomputable def pathResidueExpectation {α β : Type*}
    (ma : α → ℕ) [∀ i, NeZero (ma i)] (mb : β → ℕ) [∀ i, NeZero (mb i)]
    (Sa : Finset α) (Sb : Finset β) (visits : Finset ℕ)
    (active : α → Finset ℕ) (ha : ∀ i, ℕ → ZMod (ma i)) (hb : ∀ i, ℕ → ZMod (mb i))
    (η : ℕ → ℝ) : ℝ :=
  (∏ i ∈ Sa, (∑ r, activeResidueWeight visits (active i) (ha i) η r) / (ma i : ℝ)) *
    ∏ i ∈ Sb, (∑ r, ∏ j ∈ visits, (1 - η j * (if r = hb i j then 1 else 0))) / (mb i : ℝ)

section

variable
  {α β : Type*}
  [sharedInstance1 : DecidableEq α]
  [sharedInstance2 : DecidableEq β]
  (ma : α → ℕ)
  [sharedInstance4 : ∀ i, NeZero (ma i)]
  (mb : β → ℕ)
  [sharedInstance6 : ∀ i, NeZero (mb i)]
  (Sa : Finset α)
  (Sb : Finset β)
  (visits : Finset ℕ)
  (active : α → Finset ℕ)
  (ha : ∀ i, ℕ → ZMod (ma i))
  (hb : ∀ i, ℕ → ZMod (mb i))
  (η : ℕ → ℝ)
  (anchor : α → ℕ)

include α β sharedInstance1 sharedInstance2 ma sharedInstance4 mb sharedInstance6 Sa Sb visits active ha hb η anchor

/- For compatible active visits, the product-density main term in residue
replacement is exactly the independent-residue expectation. -/
theorem path_residue_expectation_eq 
    (hanchor : ∀ i ∈ Sa, anchor i ∈ active i)
    (hcompat : ∀ i ∈ Sa, ∀ j ∈ active i, ha i j = ha i (anchor i)) :
    pathResidueExpectation ma mb Sa Sb visits active ha hb η =
      ((∏ i ∈ Sa, activeVisitDamping visits (active i) (ha i) η (anchor i)) /
        ((∏ i ∈ Sa, ma i) : ℕ)) *
        ∏ i ∈ Sb, (1 - exclusionLocalMean mb (fun i => visitExclusion visits (hb i) η) i) := by
  unfold pathResidueExpectation
  have he : (∏ i ∈ Sa, (∑ r, activeResidueWeight visits (active i) (ha i) η r) / (ma i : ℝ)) =
      (∏ i ∈ Sa, activeVisitDamping visits (active i) (ha i) η (anchor i)) /
        ((∏ i ∈ Sa, ma i) : ℕ) := by
    rw [prod_natCast, ← prod_div_distrib]
    apply prod_congr rfl
    intro i hi
    rw [active_lifespan_residue_sum visits (active i) (ha i) η (anchor i) (hanchor i hi),
      if_pos (hcompat i hi)]
    rfl
  rw [he]
  congr 1
  apply prod_congr rfl
  intro i hi
  exact inactive_path_local_average mb visits hb η i

/- Complete finite path replacement. Compatible active primes fix one
congruence; their deterministic damping is retained in both the main term
and the error. The hypotheses on degree and interval length are explicit. -/
theorem path_residue_replacement 
    (hma : (Sa : Set α).Pairwise (fun i j => Nat.Coprime (ma i) (ma j)))
    (hmb : Pairwise (fun i j => Nat.Coprime (mb i) (mb j)))
    (hcross : ∀ i ∈ Sa, ∀ j, Nat.Coprime (ma i) (mb j))
    (hanchor : ∀ i ∈ Sa, anchor i ∈ active i)
    (hcompat : ∀ i ∈ Sa, ∀ j ∈ active i, ha i j = ha i (anchor i))
    (hη : ∀ j ∈ visits, 0 ≤ η j ∧ η j ≤ 1)
    (hsmall : ∀ i ∈ Sb, exclusionLocalMean mb (fun i => visitExclusion visits (hb i) η) i ≤ 1 / 2)
    {N : ℕ} (hN : 0 < N) (z : ℤ) (k : ℕ) (B : ℝ)
    (hk : 5 * (∑ i ∈ Sb, exclusionLocalMean mb (fun i => visitExclusion visits (hb i) η) i) +
      B + Real.log 4 ≤ (k : ℝ))
    (hsize : 4 * ((∏ i ∈ Sa, ma i) : ℕ) * (k + 1 : ℕ) *
      Real.exp (B + 2 * ∑ i ∈ Sb, exclusionLocalMean mb (fun i => visitExclusion visits (hb i) η) i) *
        (1 + ∑ i ∈ Sb, exclusionLocalMass mb (fun i => visitExclusion visits (hb i) η) i)^k ≤ N) :
    |((∑ n ∈ Ico z (z + N),
        (∏ i ∈ Sa, activeResidueWeight visits (active i) (ha i) η (n : ZMod (ma i))) *
          inactivePathResidueWeight mb Sb visits hb η n) / (N : ℝ)) -
      pathResidueExpectation ma mb Sa Sb visits active ha hb η| ≤
      Real.exp (-B) * pathResidueExpectation ma mb Sa Sb visits active ha hb η := by
  rw [path_residue_expectation_eq ma mb Sa Sb visits active ha hb η anchor hanchor hcompat]
  let Q := ∏ i ∈ Sa, ma i
  have hQ : 0 < Q := prod_pos (fun i hi => Nat.pos_of_ne_zero (NeZero.ne (ma i)))
  let : NeZero Q := ⟨ne_of_gt hQ⟩
  have hQcop : ∀ j, Nat.Coprime Q (mb j) := fun j =>
    Nat.coprime_prod_left_iff.mpr (fun i hi => hcross i hi j)
  obtain ⟨c, hfactor⟩ := active_path_residue_factorization ma Sa visits active ha η anchor hma hanchor hcompat
  let D := ∏ i ∈ Sa, activeVisitDamping visits (active i) (ha i) η (anchor i)
  have hD : 0 ≤ D := prod_nonneg (fun i hi => active_visit_damping_nonneg visits (active i) (ha i) η (anchor i) hη)
  have he := conditioned_crt_damped_interval Q mb hmb hQcop (c : ZMod Q)
    (fun i => visitExclusion visits (hb i) η) Sb
    (fun i hi t => visit_exclusion_unit visits (hb i) η hη t) hsmall hN z k B D hD hk hsize
  have hsum : (∑ n ∈ Ico z (z + N),
        (∏ i ∈ Sa, activeResidueWeight visits (active i) (ha i) η (n : ZMod (ma i))) *
          inactivePathResidueWeight mb Sb visits hb η n) =
      D * (∑ n ∈ Ico z (z + N), (if (n : ZMod Q) = (c : ZMod Q) then 1 else 0) *
        ∏ i ∈ Sb, (1 - visitExclusion visits (hb i) η (n : ZMod (mb i)))) := by
    rw [mul_sum]
    apply sum_congr rfl
    intro n hn
    rw [hfactor n, inactive_path_residue_weight_eq]
    change (_ * D) * _ = D * (_ * _)
    ring
  rw [hsum]
  simpa only [Q, D, mul_div_right_comm] using he

end

end

section
open Finset
/- The absolute local mass is bounded by the total visit weight, since
the grouped exclusion weight is nonnegative. -/
theorem visit_local_mass_le {ι : Type*} (m : ι → ℕ) [∀ i, NeZero (m i)]
    (visits : Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ)
    (hη : ∀ j ∈ visits, 0 ≤ η j ∧ η j ≤ 1) (i : ι) :
    exclusionLocalMass m (fun i => visitExclusion visits (h i) η) i ≤ ∑ j ∈ visits, η j := by
  unfold exclusionLocalMass
  have he : ∀ r, |visitExclusion visits (h i) η r| = visitExclusion visits (h i) η r :=
    fun r => abs_of_nonneg (visit_exclusion_unit visits (h i) η hη r).1
  simp_rw [he]
  exact visit_exclusion_mass visits (h i) η hη

section

variable
  {ι : Type*}
  (m : ι → ℕ)
  [sharedInstance2 : ∀ i, NeZero (m i)]
  (S : Finset ι)
  (visits : Finset ℕ)
  (h : ∀ i, ℕ → ZMod (m i))
  (η : ℕ → ℝ)
  (hη : ∀ j ∈ visits, 0 ≤ η j ∧ η j ≤ 1)

include ι m sharedInstance2 S visits h η hη

/- Summing the local means costs only the harmonic mass of the modulus set. -/
theorem visit_mean_sum_le_harmonic  :
    (∑ i ∈ S, exclusionLocalMean m (fun i => visitExclusion visits (h i) η) i) ≤
      (∑ j ∈ visits, η j) * ∑ i ∈ S, 1 / (m i : ℝ) := by
  calc
    _ ≤ ∑ i ∈ S, (∑ j ∈ visits, η j) / (m i : ℝ) :=
      sum_le_sum (fun i hi => visit_exclusion_mean_bound (m i) visits (h i) η hη)
    _ = _ := by rw [mul_sum]; apply sum_congr rfl; intro i hi; ring

/- Summing absolute masses is bounded by the number of moduli times
the total visit weight. -/
theorem visit_mass_sum_le_card  :
    (∑ i ∈ S, exclusionLocalMass m (fun i => visitExclusion visits (h i) η) i) ≤
      (S.card : ℝ) * ∑ j ∈ visits, η j := by
  calc
    _ ≤ ∑ _i ∈ S, ∑ j ∈ visits, η j := sum_le_sum (fun i hi => visit_local_mass_le m visits h η hη i)
    _ = _ := by simp

end


/- A modulus exceeding twice the total visit weight gives a local
exclusion probability at most one half. -/
theorem visit_mean_le_half {ι : Type*} (m : ι → ℕ) [∀ i, NeZero (m i)]
    (visits : Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ)
    (hη : ∀ j ∈ visits, 0 ≤ η j ∧ η j ≤ 1) (i : ι)
    (hm : 2 * (∑ j ∈ visits, η j) ≤ (m i : ℝ)) :
    exclusionLocalMean m (fun i => visitExclusion visits (h i) η) i ≤ 1 / 2 := by
  refine (visit_exclusion_mean_bound (m i) visits (h i) η hη).trans ?_
  apply (div_le_iff₀ (by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne (m i)))).2
  linarith

/- Disjoint prime groups add their harmonic masses without multiplicity. -/
theorem prime_group_harmonic_bound {G : Type*} [DecidableEq G]
    (groups : Finset G) (P : G → Finset ℕ)
    (hdisj : (groups : Set G).PairwiseDisjoint P) (V : ℝ)
    (hV : ∀ g ∈ groups, (∑ p ∈ P g, 1 / (p : ℝ)) ≤ V) :
    (∑ p ∈ groups.biUnion P, 1 / (p : ℝ)) ≤ (groups.card : ℝ) * V := by
  rw [sum_biUnion hdisj]
  calc
    _ ≤ ∑ _g ∈ groups, V := sum_le_sum hV
    _ = _ := by simp




/- Distinct positive integers bounded by `exp H` number at most `exp H`. -/
theorem prime_pool_card_le_exp (P : Finset ℕ) (H : ℝ)
    (hpos : ∀ p ∈ P, 0 < p) (hmax : ∀ p ∈ P, (p : ℝ) ≤ Real.exp H) :
    (P.card : ℝ) ≤ Real.exp H := by
  have hc : (P.card : ℝ) ≤ (⌊Real.exp H⌋₊ : ℝ) := by
    exact_mod_cast card_positive_nat_finset_le_floor hpos hmax
  exact hc.trans (Nat.floor_le (Real.exp_pos H).le)

/- An injective family of positive integer moduli inherits the
cardinality bound for its image. -/
theorem moduli_card_le_exp {ι : Type*} [DecidableEq ι] (m : ι → ℕ)
    (S : Finset ι) (H : ℝ) (hinj : Set.InjOn m S)
    (hpos : ∀ i ∈ S, 0 < m i) (hmax : ∀ i ∈ S, (m i : ℝ) ≤ Real.exp H) :
    (S.card : ℝ) ≤ Real.exp H := by
  have he := prime_pool_card_le_exp (S.image m) H
    (by intro p hp; obtain ⟨i, hi, rfl⟩ := mem_image.mp hp; exact hpos i hi)
    (by intro p hp; obtain ⟨i, hi, rfl⟩ := mem_image.mp hp; exact hmax i hi)
  simpa only [card_image_of_injOn hinj] using he

/- Indexed modulus products satisfy the same logarithmic estimate, even
without injectivity of the indexing map. -/
theorem modulus_product_log_bound {ι : Type*} (m : ι → ℕ) (S : Finset ι) (H : ℝ)
    (hpos : ∀ i ∈ S, 0 < m i) (hmax : ∀ i ∈ S, (m i : ℝ) ≤ Real.exp H) :
    Real.log ((∏ i ∈ S, m i : ℕ) : ℝ) ≤ (S.card : ℝ) * H := by
  have hp : ∀ i ∈ S, (m i : ℝ) ≠ 0 := fun i hi => ne_of_gt (by exact_mod_cast hpos i hi)
  rw [Nat.cast_prod, Real.log_prod hp]
  calc
    _ ≤ ∑ _i ∈ S, H := by
      apply sum_le_sum
      intro i hi
      have ht := Real.log_le_log (by exact_mod_cast hpos i hi) (hmax i hi)
      simpa only [Real.log_exp] using ht
    _ = _ := by simp









end

section
open Filter Finset
open scoped Topology
/- Every fixed real power is negligible relative to an exponential of a
positive power. -/
theorem tendsto_rpow_div_exp_rpow (a : ℝ) {c : ℝ} (hc : 0 < c) :
    Tendsto (fun L : ℝ => L^a / Real.exp (L^c)) atTop (𝓝 0) := by
  have he := ((isLittleO_rpow_exp_atTop (a / c)).tendsto_div_nhds_zero).comp
    (tendsto_rpow_atTop hc)
  apply he.congr'
  filter_upwards [eventually_gt_atTop (0 : ℝ)] with L hL
  simp only [Function.comp_apply]
  rw [← Real.rpow_mul hL.le]
  congr 2
  field_simp

/- The lower end of a prime pool eventually dominates any fixed power
bound for the total visit weight. -/
theorem eventually_mul_rpow_le_exp_rpow (a A : ℝ) {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, A * L^a ≤ Real.exp (L^c) := by
  have he := (tendsto_rpow_div_exp_rpow a hc).const_mul A
  have hz : A * (0 : ℝ) < 1 := by simp
  filter_upwards [he.eventually_le_const hz] with L hL
  have hd : 0 < Real.exp (L^c) := Real.exp_pos _
  have hh : A * L^a / Real.exp (L^c) ≤ 1 := by
    simpa only [mul_div_assoc] using hL
  simpa only [one_mul] using (div_le_iff₀ hd).mp hh

/- Taking a logarithm removes the exponential size of the complete
prime pool. The polynomial visit factor only changes a lower-order term. -/
theorem eventually_log_polynomial_exp_bound {a d A : ℝ}
    (ha : 0 ≤ a) (hd : 0 < d) (hA : 0 ≤ A) :
    ∀ᶠ L : ℝ in atTop, ∀ C : ℝ, 0 ≤ C → C ≤ A * L^a * Real.exp (L^d) →
      Real.log (1 + C) ≤ 2 * L^d := by
  have he := eventually_mul_rpow_log_add_le_rpow (a := 0) hd hd
    (show (0 : ℝ) < 1 by norm_num) a (Real.log (1 + A))
  filter_upwards [he, eventually_ge_atTop (1 : ℝ)] with L hlog hL
  have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hLa : 1 ≤ L^a := Real.one_le_rpow hL ha
  have hexp : 1 ≤ Real.exp (L^d) := Real.one_le_exp (Real.rpow_nonneg hLpos.le d)
  have hprod : 1 ≤ L^a * Real.exp (L^d) := by nlinarith
  intro C hC hbound
  have hupper : 1 + C ≤ (1 + A) * L^a * Real.exp (L^d) := by nlinarith
  calc
    Real.log (1 + C) ≤ Real.log ((1 + A) * L^a * Real.exp (L^d)) :=
      Real.log_le_log (by positivity) hupper
    _ = Real.log (1 + A) + a * Real.log L + L^d := by
      rw [Real.log_mul (by positivity) (ne_of_gt (Real.exp_pos _)),
        Real.log_mul (by positivity) (ne_of_gt (Real.rpow_pos_of_pos hLpos a)),
        Real.log_rpow hLpos, Real.log_exp]
    _ ≤ 2 * L^d := by simp only [Real.rpow_zero, mul_one, one_mul] at hlog; linarith

/- The prime-pool range, harmonic mass, and active-modulus bound give
all numerical hypotheses needed by conditioned residue replacement.
The threshold is independent of the individual path and its residues. -/
theorem eventually_prime_pool_precision {a c d A γ : ℝ}
    (ha : 0 ≤ a) (hc : 0 < c) (hd : 0 < d) (had : a + d < 1)
    (hA : 0 < A) (hγ : 0 < γ) :
    ∀ᶠ L : ℝ in atTop, ∀ t H ℓ B C q N : ℝ,
      0 ≤ t → 0 ≤ H → 0 ≤ ℓ → 0 ≤ B → 0 ≤ C → 0 < q → 0 < N →
      t ≤ A * L^a → H ≤ A * Real.log L → ℓ ≤ t * H →
      B ≤ A * (L^a * Real.log L) → C ≤ t * Real.exp (L^d) →
      Real.log q ≤ A * (L^(a + d) * Real.log L) → γ * L ≤ Real.log N →
      let k := Nat.ceil (5 * ℓ + B + Real.log 4)
      2 * t ≤ Real.exp (L^c) ∧
      5 * ℓ + B + Real.log 4 ≤ (k : ℝ) ∧
      (k : ℝ) ≤ (6 * (A^2 + A + 2) + Real.log 4 + 1) * (L^a * Real.log L) ∧
      4 * q * (k + 1 : ℕ) * Real.exp (B + 2 * ℓ) * (1 + C)^k ≤ N := by
  let K : ℝ := A^2 + A + 2
  have hK : 0 < K := by dsimp [K]; positivity
  have hAK : A ≤ K := by dsimp [K]; nlinarith [sq_nonneg A]
  have hA2K : A^2 ≤ K := by dsimp [K]; linarith
  have h2K : 2 ≤ K := by dsimp [K]; nlinarith [sq_nonneg A]
  filter_upwards [eventually_mul_rpow_le_exp_rpow a (2 * A) hc,
    eventually_log_polynomial_exp_bound ha hd hA.le,
    eventually_residue_precision_parameters ha hd.le had hK hγ,
    eventually_ge_atTop (1 : ℝ)] with L hmin hmass hprecision hL
  have hL0 : 0 ≤ L := zero_le_one.trans hL
  have hlog : 0 ≤ Real.log L := Real.log_nonneg hL
  have hu : 0 ≤ L^a * Real.log L := mul_nonneg (Real.rpow_nonneg hL0 a) hlog
  have hv : 0 ≤ L^(a + d) * Real.log L := mul_nonneg (Real.rpow_nonneg hL0 (a + d)) hlog
  intro t H ℓ B C q N ht hH hℓ hB hC hq hN htbound hHbound hℓbound hBbound hCbound hqbound hNbound
  have hmin' : 2 * t ≤ Real.exp (L^c) := by nlinarith
  have hℓ' : ℓ ≤ K * (L^a * Real.log L) := by
    calc
      ℓ ≤ t * H := hℓbound
      _ ≤ (A * L^a) * (A * Real.log L) := mul_le_mul htbound hHbound hH (by positivity)
      _ = A^2 * (L^a * Real.log L) := by ring
      _ ≤ K * (L^a * Real.log L) := mul_le_mul_of_nonneg_right hA2K hu
  have hB' : B ≤ K * (L^a * Real.log L) :=
    hBbound.trans (mul_le_mul_of_nonneg_right hAK hu)
  have hq' : Real.log q ≤ K * (L^(a + d) * Real.log L) :=
    hqbound.trans (mul_le_mul_of_nonneg_right hAK hv)
  have hC' : Real.log (1 + C) ≤ K * L^d := by
    apply (hmass C hC ?_).trans (mul_le_mul_of_nonneg_right h2K (Real.rpow_nonneg hL0 d))
    exact hCbound.trans (mul_le_mul_of_nonneg_right htbound (Real.exp_pos _).le)
  exact ⟨hmin', hprecision ℓ B C q N hℓ hB hC hq hN hℓ' hB' hq' hC' hNbound⟩
end

section
open Filter Finset
open scoped Topology
/- An inconsistent active prime has zero independent-residue expectation. -/
theorem path_residue_expectation_incompatible {α β : Type*} [DecidableEq α]
    (ma : α → ℕ) [∀ i, NeZero (ma i)] (mb : β → ℕ) [∀ i, NeZero (mb i)]
    (Sa : Finset α) (Sb : Finset β) (visits : Finset ℕ)
    (active : α → Finset ℕ) (ha : ∀ i, ℕ → ZMod (ma i)) (hb : ∀ i, ℕ → ZMod (mb i))
    (η : ℕ → ℝ) {i : α} (hi : i ∈ Sa) {a z : ℕ}
    (hfirst : a ∈ active i) (hlast : z ∈ active i) (hne : ha i a ≠ ha i z) :
    pathResidueExpectation ma mb Sa Sb visits active ha hb η = 0 := by
  have hz : (∏ j ∈ Sa, (∑ r, activeResidueWeight visits (active j) (ha j) η r) / (ma j : ℝ)) = 0 := by
    apply prod_eq_zero hi
    have hr : ∀ r, activeResidueWeight visits (active i) (ha i) η r = 0 :=
      active_residue_weight_incompatible visits (active i) (ha i) η hfirst hlast hne
    simp only [hr, sum_const_zero, zero_div]
  unfold pathResidueExpectation
  rw [hz, zero_mul]

/- Prime-pool bounds imply exponentially accurate residue replacement,
uniformly over the residues, marks, damping, and integer interval. The
active visits may be incompatible; in that case both sides vanish exactly. -/
theorem eventually_path_replacement_of_prime_bounds {a c d A γ : ℝ} (ha0 : 0 ≤ a) (hc : 0 < c) (hd : 0 < d)
    (had : a + d < 1) (hA : 0 < A) (hγ : 0 < γ) :
    ∀ᶠ L : ℝ in atTop, ∀ (α β : Type) [DecidableEq α] [DecidableEq β]
      (ma : α → ℕ) [∀ i, NeZero (ma i)] (mb : β → ℕ) [∀ i, NeZero (mb i)]
      (Sa : Finset α) (Sb : Finset β) (visits : Finset ℕ)
      (active : α → Finset ℕ) (ha : ∀ i, ℕ → ZMod (ma i)) (hb : ∀ i, ℕ → ZMod (mb i))
      (η : ℕ → ℝ) (anchor : α → ℕ) (N : ℕ) (z : ℤ) (B : ℝ),
      (Sa : Set α).Pairwise (fun i j => Nat.Coprime (ma i) (ma j)) →
      Pairwise (fun i j => Nat.Coprime (mb i) (mb j)) →
      (∀ i ∈ Sa, ∀ j, Nat.Coprime (ma i) (mb j)) →
      (∀ i ∈ Sa, anchor i ∈ active i) →
      (∀ j ∈ visits, 0 ≤ η j ∧ η j ≤ 1) →
      (∑ j ∈ visits, η j) ≤ A * L^a →
      (Sb.card : ℝ) ≤ Real.exp (L^d) →
      (∑ i ∈ Sb, 1 / (mb i : ℝ)) ≤ A * Real.log L →
      (∀ i ∈ Sb, Real.exp (L^c) ≤ (mb i : ℝ)) →
      (Sa.card : ℝ) ≤ A * (L^a * Real.log L) →
      (∀ i ∈ Sa, (ma i : ℝ) ≤ Real.exp (L^d)) →
      0 < N → γ * L ≤ Real.log (N : ℝ) →
      0 ≤ B → B ≤ A * (L^a * Real.log L) →
      |((∑ n ∈ Ico z (z + N),
          (∏ i ∈ Sa, activeResidueWeight visits (active i) (ha i) η (n : ZMod (ma i))) *
            inactivePathResidueWeight mb Sb visits hb η n) / (N : ℝ)) -
        pathResidueExpectation ma mb Sa Sb visits active ha hb η| ≤
        Real.exp (-B) * pathResidueExpectation ma mb Sa Sb visits active ha hb η := by
  filter_upwards [eventually_prime_pool_precision ha0 hc hd had hA hγ,
    eventually_ge_atTop (1 : ℝ)] with L hprecision hL
  intro α β _ _ ma _ mb _ Sa Sb visits active ha hb η anchor N z B hma hmb hcross hanchor hη
    htbound hcount hHbound hmin hactive hmax hN hNbound hB hBbound
  have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one hL
  let t := ∑ j ∈ visits, η j
  let H := ∑ i ∈ Sb, 1 / (mb i : ℝ)
  let ℓ := ∑ i ∈ Sb, exclusionLocalMean mb (fun i => visitExclusion visits (hb i) η) i
  let C := ∑ i ∈ Sb, exclusionLocalMass mb (fun i => visitExclusion visits (hb i) η) i
  let Q := ∏ i ∈ Sa, ma i
  have ht : 0 ≤ t := sum_nonneg (fun j hj => (hη j hj).1)
  have hH : 0 ≤ H := sum_nonneg (fun i hi => by positivity)
  have hℓ : 0 ≤ ℓ := sum_nonneg (fun i hi =>
    (exclusion_local_mean_unit mb (fun i => visitExclusion visits (hb i) η) i
      (visit_exclusion_unit visits (hb i) η hη)).1)
  have hC : 0 ≤ C := by
    apply sum_nonneg
    intro i hi
    exact sum_nonneg (fun r hr => abs_nonneg _)
  have hQ : 0 < Q := prod_pos (fun i hi => Nat.pos_of_ne_zero (NeZero.ne (ma i)))
  have hℓbound : ℓ ≤ t * H := visit_mean_sum_le_harmonic mb Sb visits hb η hη
  have hCbound : C ≤ t * Real.exp (L^d) := by
    calc
      C ≤ (Sb.card : ℝ) * t := visit_mass_sum_le_card mb Sb visits hb η hη
      _ ≤ Real.exp (L^d) * t := mul_le_mul_of_nonneg_right hcount ht
      _ = _ := mul_comm _ _
  have hqbound : Real.log (Q : ℝ) ≤ A * (L^(a + d) * Real.log L) := by
    calc
      _ ≤ (Sa.card : ℝ) * L^d := modulus_product_log_bound ma Sa (L^d)
        (fun i hi => Nat.pos_of_ne_zero (NeZero.ne (ma i))) hmax
      _ ≤ (A * (L^a * Real.log L)) * L^d :=
        mul_le_mul_of_nonneg_right hactive (Real.rpow_nonneg hLpos.le d)
      _ = _ := by rw [Real.rpow_add hLpos]; ring
  obtain ⟨hsmall, hk, _hkupper, hsize⟩ := hprecision t H ℓ B C (Q : ℝ) (N : ℝ)
    ht hH hℓ hB hC (by exact_mod_cast hQ) (by exact_mod_cast hN)
    htbound hHbound hℓbound hBbound hCbound hqbound hNbound
  by_cases hcompat : ∀ i ∈ Sa, ∀ j ∈ active i, ha i j = ha i (anchor i)
  · apply path_residue_replacement ma mb Sa Sb visits active ha hb η anchor hma hmb hcross
      hanchor hcompat hη _ hN z (Nat.ceil (5 * ℓ + B + Real.log 4)) B hk hsize
    intro i hi
    apply visit_mean_le_half mb visits hb η hη i
    exact hsmall.trans (hmin i hi)
  · push Not at hcompat
    obtain ⟨i, hi, j, hj, hne⟩ := hcompat
    have hexpect := path_residue_expectation_incompatible ma mb Sa Sb visits active ha hb η hi
      hj (hanchor i hi) hne
    have hzero : ∀ n : ℤ, (∏ j ∈ Sa,
        activeResidueWeight visits (active j) (ha j) η (n : ZMod (ma j))) = 0 :=
      active_path_residue_incompatible ma Sa visits active ha η hi hj (hanchor i hi) hne
    simp only [hzero, zero_mul, sum_const_zero, zero_div, hexpect, sub_self, abs_zero, mul_zero, le_refl]
end

section
open Finset









/- The same estimate applies to complex coefficients in the operator
expansion while the path residue factors remain real. -/
theorem complex_path_error_bound {P : Type*} (paths : Finset P)
    (c : P → ℂ) (actual expected : P → ℝ) (ε : ℝ)
    (herror : ∀ p ∈ paths, |actual p - expected p| ≤ ε * expected p) :
    ‖(∑ p ∈ paths, c p * (actual p : ℂ)) - ∑ p ∈ paths, c p * (expected p : ℂ)‖ ≤
      ε * ∑ p ∈ paths, ‖c p‖ * expected p := by
  rw [← sum_sub_distrib]
  calc
    _ ≤ ∑ p ∈ paths, ‖c p * (actual p : ℂ) - c p * (expected p : ℂ)‖ := norm_sum_le _ _
    _ = ∑ p ∈ paths, ‖c p‖ * |actual p - expected p| := by
      apply sum_congr rfl
      intro p hp
      rw [← mul_sub, norm_mul, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
    _ ≤ ∑ p ∈ paths, ‖c p‖ * (ε * expected p) :=
      sum_le_sum (fun p hp => mul_le_mul_of_nonneg_left (herror p hp) (norm_nonneg _))
    _ = _ := by rw [mul_sum]; apply sum_congr rfl; intro p hp; ring



end

section
open Finset
/- Damping once for every successful hit is the corresponding product
of affine indicator factors. -/
theorem damping_product_power {P : Type*} (S : Finset P)
    (hit : P → Prop) [DecidablePred hit] (q : ℝ) :
    (∏ p ∈ S, (1 - (1 - q) * (if hit p then 1 else 0))) = q^(S.filter hit).card := by
  have he : ∀ p, (1 - (1 - q) * (if hit p then 1 else 0)) = if hit p then q else 1 := by
    intro p
    by_cases h : hit p <;> simp [h]
  simp only [he, prod_ite, prod_const, one_pow, mul_one]

/- A local active residue weight can be read as a product over visits. -/
theorem active_residue_weight_as_visit_product {R : Type*} [DecidableEq R]
    (visits active : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ) (r : R)
    (hactive : active ⊆ visits) :
    activeResidueWeight visits active h η r =
      ∏ j ∈ visits, (if j ∈ active then (if r = h j then 1 else 0)
        else 1 - η j * (if r = h j then 1 else 0)) := by
  have hfilter : visits.filter (fun j => j ∈ active) = active := by
    ext j
    simp only [mem_filter]
    exact ⟨And.right, fun hj => ⟨hactive hj, hj⟩⟩
  have hnot : visits.filter (fun j => j ∉ active) = visits \ active := by
    ext j
    simp only [mem_filter, mem_sdiff]
  rw [prod_ite, hfilter, hnot]
  rfl

/- At a vertex, active divisibility indicators and damping for the
other group primes equal a single product over the whole prime pool. -/
theorem vertex_residue_factor_as_product {P : Type*} [DecidableEq P]
    (pool marked : Finset P) (hit : P → Prop) [DecidablePred hit]
    (q : ℝ) (hmarked : marked ⊆ pool) :
    (∏ p ∈ marked, (if hit p then (1 : ℝ) else 0)) *
        q^((pool \ marked).filter hit).card =
      ∏ p ∈ pool, (if p ∈ marked then (if hit p then 1 else 0)
        else 1 - (1 - q) * (if hit p then 1 else 0)) := by
  have hfilter : pool.filter (fun p => p ∈ marked) = marked := by
    ext p
    simp only [mem_filter]
    exact ⟨And.right, fun hp => ⟨hmarked hp, hp⟩⟩
  have hnot : pool.filter (fun p => p ∉ marked) = pool \ marked := by
    ext p
    simp only [mem_filter, mem_sdiff]
  symm
  rw [prod_ite, hfilter, hnot, damping_product_power]

/- Regrouping the physical path factor by prime gives precisely the
local active-residue weights used by residue replacement. -/
theorem physical_path_residue_factorization {P : Type*} [DecidableEq P]
    (m : P → ℕ) (pool : Finset P) (visits : Finset ℕ)
    (marked : ℕ → Finset P) (h : ∀ p, ℕ → ZMod (m p)) (q : ℕ → ℝ) (n : ℤ)
    (hmarked : ∀ j ∈ visits, marked j ⊆ pool) :
    (∏ j ∈ visits,
      (∏ p ∈ marked j, (if (n : ZMod (m p)) = h p j then (1 : ℝ) else 0)) *
        (q j)^((pool \ marked j).filter (fun p => (n : ZMod (m p)) = h p j)).card) =
      ∏ p ∈ pool, activeResidueWeight visits
        (visits.filter (fun j => p ∈ marked j)) (h p) (fun j => 1 - q j) (n : ZMod (m p)) := by
  calc
    _ = ∏ j ∈ visits, ∏ p ∈ pool,
        (if p ∈ marked j then (if (n : ZMod (m p)) = h p j then 1 else 0)
        else 1 - (1 - q j) * (if (n : ZMod (m p)) = h p j then 1 else 0)) := by
      apply prod_congr rfl
      intro j hj
      exact vertex_residue_factor_as_product pool (marked j)
        (fun p => (n : ZMod (m p)) = h p j) (q j) (hmarked j hj)
    _ = _ := by
      rw [prod_comm]
      apply prod_congr rfl
      intro p hp
      rw [active_residue_weight_as_visit_product visits _ (h p) _ _ (filter_subset _ _)]
      apply prod_congr rfl
      intro j hj
      simp only [mem_filter, hj, true_and]

/- A shifted divisibility condition is the residue constraint used in
the local path factors. This also holds for a zero integer offset. -/
theorem shifted_congruence_iff_dvd (m : ℕ) (n h : ℤ) :
    (n : ZMod m) = -(h : ZMod m) ↔ (m : ℤ) ∣ n + h := by
  rw [eq_neg_iff_add_eq_zero, ← Int.cast_add, ZMod.intCast_zmod_eq_zero_iff_dvd]

/- The divisibility-and-damping expression in the physical path
expansion has exactly the grouped-residue form, including repeated offsets. -/
theorem physical_path_divisibility_factorization {P : Type*} [DecidableEq P]
    (m : P → ℕ) (pool : Finset P) (visits : Finset ℕ)
    (marked : ℕ → Finset P) (offset : ℕ → ℤ) (q : ℕ → ℝ) (n : ℤ)
    (hmarked : ∀ j ∈ visits, marked j ⊆ pool) :
    (∏ j ∈ visits,
      (∏ p ∈ marked j, (if (m p : ℤ) ∣ n + offset j then (1 : ℝ) else 0)) *
        (q j)^((pool \ marked j).filter (fun p => (m p : ℤ) ∣ n + offset j)).card) =
      ∏ p ∈ pool, activeResidueWeight visits
        (visits.filter (fun j => p ∈ marked j)) (fun j => -(offset j : ZMod (m p)))
        (fun j => 1 - q j) (n : ZMod (m p)) := by
  have he := physical_path_residue_factorization m pool visits marked
    (fun p j => -(offset j : ZMod (m p))) q n hmarked
  simpa only [shifted_congruence_iff_dvd] using he
end

section
open Finset
/- A single binomial-geometric term is bounded by its positive total sum. -/
theorem damped_choose_bound {ρ : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1) (z t : ℕ) :
    ((z + t).choose t : ℝ) * ρ^z ≤ 1 / (1 - ρ)^(t + 1) := by
  have hnorm : ‖ρ‖ < 1 := by simpa only [Real.norm_eq_abs, abs_of_nonneg hρ0] using hρ1
  have hs := hasSum_choose_mul_geometric_of_norm_lt_one t hnorm
  have hb := sum_le_hasSum ({z} : Finset ℕ)
    (fun n hn => show (0 : ℝ) ≤ ((n + t).choose t : ℝ) * ρ^n by positivity) hs
  simpa only [sum_singleton] using hb

/- The ordered-list count with geometric damping has an explicit
bound independent of the excess number of available labels. -/
theorem damped_descFactorial_bound {ρ : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1) (z t : ℕ) :
    ((z + t).descFactorial t : ℝ) * ρ^z ≤ (t.factorial : ℝ) / (1 - ρ)^(t + 1) := by
  rw [Nat.descFactorial_eq_factorial_mul_choose, Nat.cast_mul, mul_assoc]
  simpa only [mul_one_div] using
    mul_le_mul_of_nonneg_left (damped_choose_bound hρ0 hρ1 z t) (Nat.cast_nonneg t.factorial)

/- A single constant works for every unshared-slot count up to a fixed
bound and for every group harmonic mass bounded below by a positive value. -/
theorem uniform_damped_descFactorial_bound {ρ v V : ℝ}
    (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1) (hv : 0 < v) (hV : v ≤ V)
    (T z t : ℕ) (ht : t ≤ T) :
    (((z + t).descFactorial t : ℝ) * ρ^z) / V^t ≤
      ((T.factorial : ℝ) * (max 1 (1 / v))^T) / (1 - ρ)^(T + 1) := by
  have hVpos : 0 < V := hv.trans_le hV
  have hden : 0 < 1 - ρ := sub_pos.mpr hρ1
  have hvInv : 1 / V ≤ max 1 (1 / v) :=
    (one_div_le_one_div_of_le hv hV).trans (le_max_right _ _)
  have hInv : (1 / V)^t ≤ (max 1 (1 / v))^T := by
    exact (pow_le_pow_left₀ (by positivity) hvInv t).trans
      (pow_le_pow_right₀ (le_max_left _ _) ht)
  have hfac : (t.factorial : ℝ) ≤ (T.factorial : ℝ) := by exact_mod_cast Nat.factorial_le ht
  have hbase : 1 ≤ 1 / (1 - ρ) := (one_le_div hden).2 (by linarith)
  have hpow : (1 / (1 - ρ))^(t + 1) ≤ (1 / (1 - ρ))^(T + 1) :=
    pow_le_pow_right₀ hbase (Nat.add_le_add_right ht 1)
  calc
    _ ≤ ((t.factorial : ℝ) / (1 - ρ)^(t + 1)) / V^t :=
      div_le_div_of_nonneg_right (damped_descFactorial_bound hρ0 hρ1 z t) (pow_nonneg hVpos.le t)
    _ = (t.factorial : ℝ) * (1 / (1 - ρ))^(t + 1) * (1 / V)^t := by
      rw [one_div_pow, one_div_pow]
      ring
    _ ≤ (T.factorial : ℝ) * (1 / (1 - ρ))^(T + 1) * (max 1 (1 / v))^T := by
      apply mul_le_mul
      · exact mul_le_mul hfac hpow (by positivity) (by positivity)
      · exact hInv
      · positivity
      · positivity
    _ = _ := by rw [one_div_pow]; ring

/- Endpoint damping by `q^(z/2)` uniformly absorbs the unshared-list
count. The constant only uses `q`, the lower mass bound, and the maximum
number of unshared slots. -/
theorem exists_physical_damping_bound {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hv : 0 < v) (T : ℕ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ (V : ℝ), v ≤ V → ∀ z t : ℕ, t ≤ T →
      (((z + t).descFactorial t : ℝ) * q^((z : ℝ) / 2)) / V^t ≤ C := by
  let ρ := Real.sqrt q
  have hρ0 : 0 ≤ ρ := Real.sqrt_nonneg q
  have hρ1 : ρ < 1 := by
    have hs : ρ^2 = q := Real.sq_sqrt hq0
    nlinarith
  let C := ((T.factorial : ℝ) * (max 1 (1 / v))^T) / (1 - ρ)^(T + 1)
  refine ⟨max 1 C, le_max_left _ _, ?_⟩
  intro V hV z t ht
  have hp : q^((z : ℝ) / 2) = ρ^z := by
    dsimp [ρ]
    rw [Real.sqrt_eq_rpow, ← Real.rpow_natCast, ← Real.rpow_mul hq0]
    congr 1
    ring
  rw [hp]
  exact (uniform_damped_descFactorial_bound hρ0 hρ1 hv hV T z t ht).trans (le_max_right _ _)

/- A constant loss in each of logarithmically many groups gives a
fixed power of `L`. -/
theorem group_product_bound_of_log_card {G : Type*} (groups : Finset G)
    (f : G → ℝ) {C L K : ℝ} (hC : 1 ≤ C) (hL : 0 < L)
    (hf0 : ∀ g ∈ groups, 0 ≤ f g) (hfC : ∀ g ∈ groups, f g ≤ C)
    (hcard : (groups.card : ℝ) ≤ K * Real.log L) :
    (∏ g ∈ groups, f g) ≤ L^(K * Real.log C) := by
  have hCpos : 0 < C := lt_of_lt_of_le zero_lt_one hC
  calc
    _ ≤ ∏ _g ∈ groups, C := prod_le_prod₀ hf0 hfC
    _ = C^groups.card := by simp
    _ = Real.exp ((groups.card : ℝ) * Real.log C) := by
      rw [← Real.rpow_natCast, Real.rpow_def_of_pos hCpos]
      congr 1
      ring
    _ ≤ Real.exp ((K * Real.log L) * Real.log C) :=
      Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right hcard (Real.log_nonneg hC))
    _ = L^(K * Real.log C) := by
      rw [Real.rpow_def_of_pos hL]
      congr 1
      ring
end

section
open Filter Finset
open scoped Topology
/- Independent uniform residues for every modulus in one prime pool. -/
noncomputable def poolPathResidueExpectation {ι : Type*} (m : ι → ℕ)
    [∀ i, NeZero (m i)] (pool : Finset ι) (visits : Finset ℕ)
    (active : ι → Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ) : ℝ :=
  ∏ i ∈ pool, (∑ r, activeResidueWeight visits (active i) (h i) η r) / (m i : ℝ)

/- The residue factor of a label with no active visit is just its
product of inactive damping factors. -/
theorem active_residue_weight_empty {R : Type*} [DecidableEq R]
    (visits : Finset ℕ) (h : ℕ → R) (η : ℕ → ℝ) (r : R) :
    activeResidueWeight visits ∅ h η r =
      ∏ j ∈ visits, (1 - η j * (if r = h j then 1 else 0)) := by
  simp [activeResidueWeight]

/- Splitting the prime pool into ever-active and never-active labels
recovers exactly the two-family finite path weight. -/
theorem pool_path_weight_split {ι : Type*} [DecidableEq ι] (m : ι → ℕ)
    (pool A : Finset ι) (visits : Finset ℕ) (active : ι → Finset ℕ)
    (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ) (hA : A ⊆ pool)
    (hempty : ∀ i ∈ pool \ A, active i = ∅) (n : ℤ) :
    (∏ i ∈ pool, activeResidueWeight visits (active i) (h i) η (n : ZMod (m i))) =
      (∏ i : A, activeResidueWeight visits (active i.val) (h i.val) η (n : ZMod (m i.val))) *
      inactivePathResidueWeight (fun i : ↥(pool \ A) => m i.val) univ visits
        (fun i => h i.val) η n := by
  change _ = (∏ i : A, activeResidueWeight visits (active i.val) (h i.val) η (n : ZMod (m i.val))) *
    ∏ i : ↥(pool \ A), ∏ j ∈ visits, (1 - η j * (if (n : ZMod (m i.val)) = h i.val j then 1 else 0))
  rw [prod_coe_sort A (fun i => activeResidueWeight visits (active i) (h i) η (n : ZMod (m i))),
    prod_coe_sort (pool \ A) (fun i => ∏ j ∈ visits, (1 - η j * (if (n : ZMod (m i)) = h i j then 1 else 0)))]
  rw [← prod_sdiff (f := fun i => activeResidueWeight visits (active i) (h i) η (n : ZMod (m i))) hA,
    mul_comm]
  congr 1
  apply prod_congr rfl
  intro i hi
  rw [hempty i hi, active_residue_weight_empty]

/- The two-family expectation is the full product of uniform local
averages over the original prime pool, with no normalization lost. -/
theorem pool_path_expectation_split {ι : Type*} [DecidableEq ι]
    (m : ι → ℕ) [∀ i, NeZero (m i)]
    (pool A : Finset ι) (visits : Finset ℕ) (active : ι → Finset ℕ)
    (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ) (hA : A ⊆ pool)
    (hempty : ∀ i ∈ pool \ A, active i = ∅) :
    poolPathResidueExpectation m pool visits active h η =
      pathResidueExpectation (fun i : A => m i.val) (fun i : ↥(pool \ A) => m i.val)
        univ univ visits (fun i => active i.val) (fun i => h i.val) (fun i => h i.val) η := by
  unfold poolPathResidueExpectation pathResidueExpectation
  rw [prod_coe_sort A (fun i => (∑ r, activeResidueWeight visits (active i) (h i) η r) / (m i : ℝ)),
    prod_coe_sort (pool \ A) (fun i => (∑ r, ∏ j ∈ visits, (1 - η j * (if r = h i j then 1 else 0))) / (m i : ℝ))]
  rw [← prod_sdiff (f := fun i => (∑ r, activeResidueWeight visits (active i) (h i) η r) / (m i : ℝ)) hA,
    mul_comm]
  congr 1
  apply prod_congr rfl
  intro i hi
  simp only [hempty i hi, active_residue_weight_empty]

/- The full pool has the same uniform relative replacement estimate as
the active/inactive model. Only the prime-pool bounds and the number of
ever-active labels occur in the hypotheses. -/
theorem eventually_single_pool_path_replacement {a c d A γ : ℝ}
    (ha0 : 0 ≤ a) (hc : 0 < c) (hd : 0 < d) (had : a + d < 1)
    (hA : 0 < A) (hγ : 0 < γ) :
    ∀ᶠ L : ℝ in atTop, ∀ (ι : Type) [DecidableEq ι]
      (m : ι → ℕ) [∀ i, NeZero (m i)] (pool : Finset ι) (visits : Finset ℕ)
      (active : ι → Finset ℕ) (h : ∀ i, ℕ → ZMod (m i)) (η : ℕ → ℝ)
      (N : ℕ) (z : ℤ) (B : ℝ),
      (pool : Set ι).Pairwise (fun i j => Nat.Coprime (m i) (m j)) →
      Set.InjOn m pool →
      (∀ j ∈ visits, 0 ≤ η j ∧ η j ≤ 1) →
      (∑ j ∈ visits, η j) ≤ A * L^a →
      (∑ i ∈ pool, 1 / (m i : ℝ)) ≤ A * Real.log L →
      (∀ i ∈ pool, Real.exp (L^c) ≤ (m i : ℝ)) →
      (∀ i ∈ pool, (m i : ℝ) ≤ Real.exp (L^d)) →
      ((pool.filter (fun i => (active i).Nonempty)).card : ℝ) ≤ A * (L^a * Real.log L) →
      0 < N → γ * L ≤ Real.log (N : ℝ) →
      0 ≤ B → B ≤ A * (L^a * Real.log L) →
      |((∑ n ∈ Ico z (z + N), ∏ i ∈ pool,
          activeResidueWeight visits (active i) (h i) η (n : ZMod (m i))) / (N : ℝ)) -
        poolPathResidueExpectation m pool visits active h η| ≤
        Real.exp (-B) * poolPathResidueExpectation m pool visits active h η := by
  classical
  filter_upwards [eventually_path_replacement_of_prime_bounds ha0 hc hd had hA hγ] with L hlarge
  intro ι _ m _ pool visits active h η N z B hcop hinj hη ht hH hmin hmax hcount hN hNbound hB hBbound
  let S := pool.filter (fun i => (active i).Nonempty)
  let I := pool \ S
  have hS : S ⊆ pool := filter_subset _ _
  have hI : I ⊆ pool := sdiff_subset
  have hempty : ∀ i ∈ I, active i = ∅ := by
    intro i hi
    have hip := (mem_sdiff.mp hi).1
    have his := (mem_sdiff.mp hi).2
    by_contra hn
    exact his (mem_filter.mpr ⟨hip, nonempty_iff_ne_empty.mpr hn⟩)
  have hnonempty : ∀ i : S, (active i.val).Nonempty := fun i => (mem_filter.mp i.property).2
  let anchor : S → ℕ := fun i => Classical.choose (hnonempty i)
  have hanchor : ∀ i : S, anchor i ∈ active i.val := fun i => Classical.choose_spec (hnonempty i)
  have hcopa : ((univ : Finset S) : Set S).Pairwise (fun i j => Nat.Coprime (m i.val) (m j.val)) := by
    intro i hi j hj hij
    exact hcop (hS i.property) (hS j.property) (fun he => hij (Subtype.ext he))
  have hcopb : Pairwise (fun i j : I => Nat.Coprime (m i.val) (m j.val)) := by
    intro i j hij
    exact hcop (hI i.property) (hI j.property) (fun he => hij (Subtype.ext he))
  have hcross : ∀ i : S, ∀ j : I, Nat.Coprime (m i.val) (m j.val) := by
    intro i j
    apply hcop (hS i.property) (hI j.property)
    intro he
    exact (mem_sdiff.mp j.property).2 (he ▸ i.property)
  have hcardI : ((univ : Finset I).card : ℝ) ≤ Real.exp (L^d) := by
    simpa only [card_univ, Fintype.card_coe] using moduli_card_le_exp m I (L^d)
      (fun i hi j hj hij => hinj (hI hi) (hI hj) hij)
      (fun i hi => Nat.pos_of_ne_zero (NeZero.ne (m i))) (fun i hi => hmax i (hI hi))
  have hHI : (∑ i : I, 1 / (m i.val : ℝ)) ≤ A * Real.log L := by
    rw [sum_coe_sort I (fun i => 1 / (m i : ℝ))]
    exact (sum_le_sum_of_subset_of_nonneg hI (fun i hi hn => by positivity)).trans hH
  have hcardS : ((univ : Finset S).card : ℝ) ≤ A * (L^a * Real.log L) := by
    simpa only [card_univ, Fintype.card_coe] using hcount
  have he := hlarge S I (fun i => m i.val) (fun i => m i.val) univ univ visits
    (fun i => active i.val) (fun i => h i.val) (fun i => h i.val) η anchor N z B
    hcopa hcopb (fun i hi j => hcross i j) (fun i hi => hanchor i) hη ht hcardI hHI
    (fun i hi => hmin i.val (hI i.property)) hcardS
    (fun i hi => hmax i.val (hS i.property)) hN hNbound hB hBbound
  have hweight := pool_path_weight_split m pool S visits active h η hS hempty
  have hexpect := pool_path_expectation_split m pool S visits active h η hS hempty
  rw [hexpect]
  simp_rw [hweight]
  exact he
end

section
open Finset
/- The ever-active labels are exactly the union of the visit mark sets. -/
theorem active_visit_pool_eq_biUnion {ι : Type*} [DecidableEq ι]
    (pool : Finset ι) (visits : Finset ℕ) (marked : ℕ → Finset ι)
    (hmarked : ∀ j ∈ visits, marked j ⊆ pool) :
    pool.filter (fun i => (visits.filter (fun j => i ∈ marked j)).Nonempty) =
      visits.biUnion marked := by
  ext i
  simp only [mem_filter, nonempty_iff_ne_empty, mem_biUnion]
  constructor
  · rintro ⟨hi, hn⟩
    obtain ⟨j, hj⟩ := nonempty_iff_ne_empty.mpr hn
    exact ⟨j, (mem_filter.mp hj).1, (mem_filter.mp hj).2⟩
  · rintro ⟨j, hj, hi⟩
    exact ⟨hmarked j hj hi, nonempty_iff_ne_empty.mp ⟨j, mem_filter.mpr ⟨hj, hi⟩⟩⟩

/- The distinct labels appearing anywhere in a path are bounded by
its number of visits times the per-visit mark bound. -/
theorem marked_path_pool_card_bound {ι : Type*} [DecidableEq ι]
    (pool : Finset ι) (visits : Finset ℕ) (marked : ℕ → Finset ι) (K : ℕ)
    (hmarked : ∀ j ∈ visits, marked j ⊆ pool)
    (hK : ∀ j ∈ visits, (marked j).card ≤ K) :
    (pool.filter (fun i => (visits.filter (fun j => i ∈ marked j)).Nonempty)).card ≤
      visits.card * K := by
  rw [active_visit_pool_eq_biUnion pool visits marked hmarked]
  calc
    _ ≤ ∑ j ∈ visits, (marked j).card := card_biUnion_le
    _ ≤ ∑ _j ∈ visits, K := sum_le_sum hK
    _ = _ := by simp

/- Ceiling the real moment length and including both endpoints changes
its bound by only an absolute factor. -/
theorem ceiling_path_length_bounds {L a : ℝ} (hL : 1 ≤ L) (ha : 0 ≤ a) :
    let n := 2 * Nat.ceil (L^a)
    (n : ℝ) ≤ 4 * L^a ∧ (n + 1 : ℕ) ≤ 5 * L^a := by
  have hp : 1 ≤ L^a := Real.one_le_rpow hL ha
  have hc := (Nat.ceil_lt_add_one (show 0 ≤ L^a by linarith)).le
  dsimp only
  push_cast
  constructor <;> nlinarith

/- Unit-interval damping defects have total mass bounded by the number
of visits. -/
theorem visit_weight_sum_le_card (visits : Finset ℕ) (η : ℕ → ℝ)
    (hη : ∀ j ∈ visits, η j ≤ 1) :
    (∑ j ∈ visits, η j) ≤ visits.card := by
  calc
    _ ≤ ∑ _j ∈ visits, (1 : ℝ) := sum_le_sum hη
    _ = _ := by simp
end

section
open Filter Finset
open scoped Topology
/- A logarithmic number of groups and the ceiling moment length give
the uniform replacement estimate for the physical divisibility factor. -/
theorem eventually_grouped_path_replacement {a c d C V E γ : ℝ}
    (ha : 0 ≤ a) (hc : 0 < c) (hd : 0 < d) (had : a + d < 1)
    (hC : 0 < C) (hV : 0 < V) (hE : 0 ≤ E) (hγ : 0 < γ) (M : ℕ) :
    ∀ᶠ L : ℝ in atTop, ∀ (ι : Type) [DecidableEq ι]
      (m : ι → ℕ) [∀ i, NeZero (m i)] (pool : Finset ι) (s : ℕ)
      (marked : ℕ → Finset ι) (offset : ℕ → ℤ) (q : ℕ → ℝ) (N : ℕ) (z : ℤ),
      let n := 2 * Nat.ceil (L^a)
      let visits := range (n + 1)
      (pool : Set ι).Pairwise (fun i j => Nat.Coprime (m i) (m j)) →
      Set.InjOn m pool →
      (s : ℝ) ≤ C * Real.log L →
      (∑ i ∈ pool, 1 / (m i : ℝ)) ≤ s * V →
      (∀ i ∈ pool, Real.exp (L^c) ≤ (m i : ℝ)) →
      (∀ i ∈ pool, (m i : ℝ) ≤ Real.exp (L^d)) →
      (∀ j ∈ visits, marked j ⊆ pool) →
      (∀ j ∈ visits, (marked j).card ≤ M * s) →
      (∀ j ∈ visits, 0 ≤ q j ∧ q j ≤ 1) →
      0 < N → γ * L ≤ Real.log (N : ℝ) →
      |((∑ k ∈ Ico z (z + N), ∏ j ∈ visits,
          (∏ i ∈ marked j, (if (m i : ℤ) ∣ k + offset j then (1 : ℝ) else 0)) *
            (q j)^((pool \ marked j).filter (fun i => (m i : ℤ) ∣ k + offset j)).card) / (N : ℝ)) -
        poolPathResidueExpectation m pool visits
          (fun i => visits.filter (fun j => i ∈ marked j))
          (fun i j => -(offset j : ZMod (m i))) (fun j => 1 - q j)| ≤
        Real.exp (-E * n * Real.log L) *
          poolPathResidueExpectation m pool visits
            (fun i => visits.filter (fun j => i ∈ marked j))
            (fun i j => -(offset j : ZMod (m i))) (fun j => 1 - q j) := by
  let A : ℝ := 6 + 5 * M * C + C * V + 4 * E
  have hA : 0 < A := by dsimp [A]; nlinarith [mul_nonneg (Nat.cast_nonneg M) hC.le, mul_nonneg hC.le hV.le]
  have h5A : 5 ≤ A := by dsimp [A]; nlinarith [mul_nonneg (Nat.cast_nonneg M) hC.le, mul_nonneg hC.le hV.le]
  have hMCA : 5 * M * C ≤ A := by dsimp [A]; nlinarith [mul_nonneg (Nat.cast_nonneg M) hC.le, mul_nonneg hC.le hV.le]
  have hCVA : C * V ≤ A := by dsimp [A]; nlinarith [mul_nonneg (Nat.cast_nonneg M) hC.le, mul_nonneg hC.le hV.le]
  have hEA : 4 * E ≤ A := by dsimp [A]; nlinarith [mul_nonneg (Nat.cast_nonneg M) hC.le, mul_nonneg hC.le hV.le]
  filter_upwards [eventually_single_pool_path_replacement ha hc hd had hA hγ,
    eventually_ge_atTop (1 : ℝ)] with L hlarge hL
  intro ι _ m _ pool s marked offset q N z
  dsimp only
  let n := 2 * Nat.ceil (L^a)
  let visits := range (n + 1)
  intro hcop hinj hs hH hmin hmax hmarked hmarks hq hN hNbound
  have hlog : 0 ≤ Real.log L := Real.log_nonneg hL
  have hpow : 0 ≤ L^a := Real.rpow_nonneg (zero_le_one.trans hL) a
  obtain ⟨hn, hn1⟩ := ceiling_path_length_bounds hL ha
  change (n : ℝ) ≤ 4 * L^a at hn
  change (n + 1 : ℕ) ≤ 5 * L^a at hn1
  have hη : ∀ j ∈ visits, 0 ≤ 1 - q j ∧ 1 - q j ≤ 1 := by
    intro j hj
    have hh := hq j hj
    constructor <;> linarith
  have ht : (∑ j ∈ visits, (1 - q j)) ≤ A * L^a := by
    calc
      _ ≤ (visits.card : ℝ) := visit_weight_sum_le_card visits _ (fun j hj => (hη j hj).2)
      _ ≤ 5 * L^a := by simpa only [visits, card_range] using hn1
      _ ≤ A * L^a := mul_le_mul_of_nonneg_right h5A hpow
  have hHbound : (∑ i ∈ pool, 1 / (m i : ℝ)) ≤ A * Real.log L := by
    calc
      _ ≤ (s : ℝ) * V := hH
      _ ≤ (C * Real.log L) * V := mul_le_mul_of_nonneg_right hs hV.le
      _ = (C * V) * Real.log L := by ring
      _ ≤ A * Real.log L := mul_le_mul_of_nonneg_right hCVA hlog
  have hactive : ((pool.filter (fun i => (visits.filter (fun j => i ∈ marked j)).Nonempty)).card : ℝ) ≤
      A * (L^a * Real.log L) := by
    have hbound : ((pool.filter (fun i => (visits.filter (fun j => i ∈ marked j)).Nonempty)).card : ℝ) ≤
        (visits.card : ℝ) * ((M : ℝ) * s) := by
      exact_mod_cast marked_path_pool_card_bound pool visits marked (M * s) hmarked hmarks
    calc
      _ ≤ (visits.card : ℝ) * ((M : ℝ) * s) := hbound
      _ ≤ (5 * L^a) * ((M : ℝ) * (C * Real.log L)) := by
        apply mul_le_mul
        · simpa only [visits, card_range] using hn1
        · exact mul_le_mul_of_nonneg_left hs (Nat.cast_nonneg M)
        · positivity
        · positivity
      _ = (5 * M * C) * (L^a * Real.log L) := by ring
      _ ≤ A * (L^a * Real.log L) := mul_le_mul_of_nonneg_right hMCA (mul_nonneg hpow hlog)
  have hB : 0 ≤ E * n * Real.log L := by positivity
  have hBbound : E * n * Real.log L ≤ A * (L^a * Real.log L) := by
    calc
      _ ≤ E * (4 * L^a) * Real.log L :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hn hE) hlog
      _ = (4 * E) * (L^a * Real.log L) := by ring
      _ ≤ A * (L^a * Real.log L) := mul_le_mul_of_nonneg_right hEA (mul_nonneg hpow hlog)
  have he := hlarge ι m pool visits (fun i => visits.filter (fun j => i ∈ marked j))
    (fun i j => -(offset j : ZMod (m i))) (fun j => 1 - q j) N z (E * n * Real.log L)
    hcop hinj hη ht hHbound hmin hmax hactive hN hNbound hB hBbound
  have hfactor := fun k => physical_path_divisibility_factorization m pool visits marked offset q k hmarked
  dsimp only [visits, n] at he hfactor
  simp_rw [hfactor]
  simpa only [neg_mul] using he



end

section
open Finset
/- Completing a shared embedding is equivalent to embedding the
unshared slots into the labels not used by the shared slots. -/
def sharedCompletionEquiv {S U P : Type*} (shared : S ↪ P) :
    {f : S ⊕ U ↪ P // ∀ s, f (Sum.inl s) = shared s} ≃
      (U ↪ {p : P // p ∉ Set.range shared}) where
  toFun f := {
    toFun := fun u => ⟨f.val (Sum.inr u), by
      rintro ⟨s, hs⟩
      have he : f.val (Sum.inl s) = f.val (Sum.inr u) := (f.property s).trans hs
      have hx := f.val.injective he
      cases hx⟩
    inj' := by
      intro u v huv
      have he := f.val.injective (congrArg Subtype.val huv)
      exact Sum.inr.inj he }
  invFun g := ⟨{
    toFun := Sum.elim shared (fun u => (g u).val)
    inj' := by
      intro x y hxy
      cases x with
      | inl s =>
        cases y with
        | inl t => exact congrArg Sum.inl (shared.injective hxy)
        | inr u => exact False.elim ((g u).property ⟨s, hxy⟩)
      | inr u =>
        cases y with
        | inl s => exact False.elim ((g u).property ⟨s, hxy.symm⟩)
        | inr v => exact congrArg Sum.inr (g.injective (Subtype.ext hxy)) }, fun s => rfl⟩
  left_inv f := by
    apply Subtype.ext
    apply Function.Embedding.ext
    intro x
    cases x with
    | inl s => exact (f.property s).symm
    | inr u => rfl
  right_inv g := by
    apply Function.Embedding.ext
    intro u
    rfl

/- The number of ordered injective completions is the descending
factorial of the number of labels left after fixing the shared slots. -/
theorem shared_completion_card {S U P : Type*} [Fintype S] [Fintype U] [Fintype P]
    (shared : S ↪ P) :
    Nat.card {f : S ⊕ U ↪ P // ∀ s, f (Sum.inl s) = shared s} =
      (Fintype.card P - Fintype.card S).descFactorial (Fintype.card U) := by
  classical
  rw [Nat.card_congr (sharedCompletionEquiv shared), Nat.card_eq_fintype_card,
    Fintype.card_embedding_eq]
  have he : Fintype.card {p : P // p ∉ Set.range shared} = Fintype.card P - Fintype.card S := by
    let e : {p : P // p ∉ Set.range shared} ≃ ↥((Set.range shared)ᶜ) := {
      toFun := fun p => ⟨p.val, p.property⟩
      invFun := fun p => ⟨p.val, p.property⟩
      left_inv := fun p => rfl
      right_inv := fun p => rfl }
    rw [Fintype.card_congr e]
    simpa only [Fintype.card_range] using Fintype.card_compl_set (Set.range shared)
  rw [he]



end

section
open Finset






/- The completion bound also holds for arbitrary finite shared and
unshared slot types, so no particular ordering of the shared slots is needed. -/
theorem exists_completion_mass_bound_types {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hv : 0 < v) (T : ℕ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ (S U P : Type) [Fintype S] [Fintype U] [Fintype P]
      (shared : S ↪ P) (V : ℝ), v ≤ V → Fintype.card U ≤ T →
        ((Nat.card {f : S ⊕ U ↪ P // ∀ s, f (Sum.inl s) = shared s} : ℝ) *
          q^(((Fintype.card P - (Fintype.card S + Fintype.card U) : ℕ) : ℝ) / 2)) /
            V^(Fintype.card U) ≤ C := by
  obtain ⟨C, hC, hbound⟩ := exists_physical_damping_bound hq0 hq1 hv T
  refine ⟨C, hC, ?_⟩
  intro S U P _ _ _ shared V hV hT
  rw [shared_completion_card]
  have hS := Fintype.card_le_of_embedding shared
  by_cases hM : Fintype.card S + Fintype.card U ≤ Fintype.card P
  · have he : Fintype.card P - Fintype.card S =
        Fintype.card P - (Fintype.card S + Fintype.card U) + Fintype.card U := by omega
    rw [he]
    exact hbound V hV _ _ hT
  · have hz : (Fintype.card P - Fintype.card S).descFactorial (Fintype.card U) = 0 :=
      Nat.descFactorial_eq_zero_iff_lt.mpr (by omega)
    rw [hz]
    simp only [Nat.cast_zero, zero_mul, zero_div]
    exact zero_le_one.trans hC




/- Independent auxiliary choices with total mass at most one preserve
a uniform nonnegative row bound. -/
theorem auxiliary_average_row_bound {ι : Type*} (choices : Finset ι)
    (μ row : ι → ℝ) {C : ℝ} (hC : 0 ≤ C)
    (hμ : ∀ i ∈ choices, 0 ≤ μ i) (hmass : (∑ i ∈ choices, μ i) ≤ 1)
    (hrow : ∀ i ∈ choices, row i ≤ C) :
    (∑ i ∈ choices, μ i * row i) ≤ C := by
  calc
    _ ≤ ∑ i ∈ choices, μ i * C := sum_le_sum (fun i hi => mul_le_mul_of_nonneg_left (hrow i hi) (hμ i hi))
    _ = (∑ i ∈ choices, μ i) * C := by rw [sum_mul]
    _ ≤ 1 * C := mul_le_mul_of_nonneg_right hmass hC
    _ = C := one_mul C



end

section
open Finset



/- Averaging complex row coefficients over auxiliary choices of total
mass at most one preserves a uniform absolute row estimate. -/
theorem auxiliary_complex_row_bound {A P : Type*}
    (choices : Finset A) (rows : Finset P) (μ : A → ℝ) (K : A → P → ℂ)
    {C : ℝ} (hC : 0 ≤ C) (hμ : ∀ a ∈ choices, 0 ≤ μ a)
    (hmass : (∑ a ∈ choices, μ a) ≤ 1)
    (hrow : ∀ a ∈ choices, (∑ p ∈ rows, ‖K a p‖) ≤ C) :
    (∑ p ∈ rows, ‖∑ a ∈ choices, (μ a : ℂ) * K a p‖) ≤ C := by
  calc
    _ ≤ ∑ p ∈ rows, ∑ a ∈ choices, μ a * ‖K a p‖ := by
      apply sum_le_sum
      intro p hp
      calc
        _ ≤ ∑ a ∈ choices, ‖(μ a : ℂ) * K a p‖ := norm_sum_le _ _
        _ = _ := by
          apply sum_congr rfl
          intro a ha
          simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hμ a ha)]
    _ = ∑ a ∈ choices, μ a * ∑ p ∈ rows, ‖K a p‖ := by
      rw [sum_comm]
      simp only [mul_sum]
    _ ≤ C := auxiliary_average_row_bound choices μ _ hC hμ hmass hrow

/- Summing patterns costs only the sum of their absolute coefficient
bounds. No orthogonality between patterns is required. -/
theorem pattern_absolute_row_bound {A P : Type*}
    (patterns : Finset A) (rows : Finset P) (K : A → P → ℂ)
    (mass : A → ℝ) (C : ℝ)
    (hrow : ∀ a ∈ patterns, (∑ p ∈ rows, ‖K a p‖) ≤ mass a * C) :
    (∑ p ∈ rows, ‖∑ a ∈ patterns, K a p‖) ≤ (∑ a ∈ patterns, mass a) * C := by
  calc
    _ ≤ ∑ p ∈ rows, ∑ a ∈ patterns, ‖K a p‖ := sum_le_sum (fun p hp => norm_sum_le _ _)
    _ = ∑ a ∈ patterns, ∑ p ∈ rows, ‖K a p‖ := sum_comm
    _ ≤ ∑ a ∈ patterns, mass a * C := sum_le_sum hrow
    _ = _ := by rw [sum_mul]



end

section
open Finset
/- Iterated finite row action; the terminal weight can impose a return
condition or any other restriction on the final state. -/
noncomputable def finitePathMass {ι : Type*} (states : Finset ι)
    (K : ℕ → ι → ι → ℝ) (terminal : ι → ℝ) : ℕ → ι → ℝ
  | 0, i => terminal i
  | n + 1, i => ∑ j ∈ states, K n i j * finitePathMass states K terminal n j




/- A row bound multiplies once per step, even when the kernels vary and
the endpoint is restricted. -/
theorem finite_path_mass_le_pow {ι : Type*} (states : Finset ι)
    (K : ℕ → ι → ι → ℝ) (terminal : ι → ℝ) {A : ℝ} (hA : 0 ≤ A)
    (hK : ∀ n i, i ∈ states → ∀ j ∈ states, 0 ≤ K n i j)
    (hrow : ∀ n i, i ∈ states → (∑ j ∈ states, K n i j) ≤ A)
    (ht : ∀ i ∈ states, terminal i ≤ 1) (n : ℕ) :
    ∀ i ∈ states, finitePathMass states K terminal n i ≤ A^n := by
  induction n with
  | zero => simpa only [finitePathMass, pow_zero] using ht
  | succ n ih =>
    intro i hi
    calc
      _ ≤ ∑ j ∈ states, K n i j * A^n :=
        sum_le_sum (fun j hj => mul_le_mul_of_nonneg_left (ih j hj) (hK n i hi j hj))
      _ = (∑ j ∈ states, K n i j) * A^n := by rw [sum_mul]
      _ ≤ A * A^n := mul_le_mul_of_nonneg_right (hrow n i hi) (pow_nonneg hA n)
      _ = A^(n + 1) := by rw [pow_succ']









end

section
open Finset
/- The first `J` slots and the final `ell` slots of a mark list. -/
abbrev PhysicalSlots (J ell : ℕ) := Fin J ⊕ Fin ell

/- Each group carries an injective ordered list of its own prime labels. -/
abbrev PhysicalMarkLists {G : Type*} (P : G → Finset ℕ) (J ell : ℕ) :=
  ∀ g, PhysicalSlots J ell ↪ ↥(P g)

/- The finite mark lists that divide a specified integer position. -/
abbrev PhysicalMarksAt {G : Type*} (P : G → Finset ℕ) (J ell : ℕ) (n : ℤ) :=
  {labels : PhysicalMarkLists P J ell //
    ∀ g s, (((labels g s).val : ℕ) : ℤ) ∣ n}

/- A physical state consists of its integer position and admissible marks. -/
abbrev PhysicalState {G : Type*} (P : G → Finset ℕ) (J ell : ℕ) :=
  Σ n : ℤ, PhysicalMarksAt P J ell n

/- The group primes available at an integer position, including zero. -/
def physicalDivisorPool {G : Type*} (P : G → Finset ℕ) (g : G) (n : ℤ) : Finset ℕ :=
  (P g).filter (fun p => (p : ℤ) ∣ n)

/- The number of available labels in one group. -/
def physicalOmega {G : Type*} (P : G → Finset ℕ) (g : G) (n : ℤ) : ℕ :=
  (physicalDivisorPool P g n).card

/- An admissible mark list embeds all its slots into the available pool. -/
def physicalMarksEmbedding {G : Type*} (P : G → Finset ℕ) (J ell : ℕ)
    (n : ℤ) (labels : PhysicalMarksAt P J ell n) (g : G) :
    PhysicalSlots J ell ↪ ↥(physicalDivisorPool P g n) where
  toFun s := ⟨(labels.val g s).val, mem_filter.mpr ⟨(labels.val g s).property, labels.property g s⟩⟩
  inj' := by
    intro s t hst
    have he : (labels.val g s).val = (labels.val g t).val :=
      congrArg (fun p : ↥(physicalDivisorPool P g n) => p.val) hst
    exact (labels.val g).injective (Subtype.ext he)




/- Only first-block slots outside `C` are shared by a pattern. -/
def physicalSharedSlots {J ell : ℕ} (C : Finset (Fin J)) : Finset (PhysicalSlots J ell) :=
  (univ \ C).map Function.Embedding.inl

/- The complementary slots are resampled at each endpoint. -/
def physicalUnsharedSlots {J ell : ℕ} (C : Finset (Fin J)) : Finset (PhysicalSlots J ell) :=
  (physicalSharedSlots (ell := ell) C)ᶜ

theorem physical_shared_slots_card {J ell : ℕ} (C : Finset (Fin J)) :
    (physicalSharedSlots (ell := ell) C).card = J - C.card := by
  simp only [physicalSharedSlots, card_map, card_sdiff, inter_univ, card_univ, Fintype.card_fin]

theorem physical_unshared_slots_card {J ell : ℕ} (C : Finset (Fin J)) :
    (physicalUnsharedSlots (ell := ell) C).card = ell + C.card := by
  have hc : C.card ≤ J := by simpa only [Fintype.card_fin] using card_le_univ C
  simp only [physicalUnsharedSlots, card_compl, Fintype.card_sum, Fintype.card_fin,
    physical_shared_slots_card]
  omega




/- Groupwise endpoint damping. Natural subtraction equals the genuine
excess count at every physical state by `physical_slots_le_omega`. -/
noncomputable def physicalDamping {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) (q : ℝ) (n : ℤ) : ℝ :=
  ∏ g, q^(((physicalOmega P g n - (J + ell) : ℕ) : ℝ) / 2)

theorem physical_damping_unit {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (n : ℤ) :
    0 ≤ physicalDamping P J ell q n ∧ physicalDamping P J ell q n ≤ 1 := by
  constructor
  · exact prod_nonneg (fun g hg => Real.rpow_nonneg hq0 _)
  · exact prod_le_one₀ (fun g hg => Real.rpow_nonneg hq0 _)
      (fun g hg => Real.rpow_le_one hq0 hq1 (by positivity))

/- Every marked state has the same counting-measure normalization. -/
noncomputable def physicalStateMass {G : Type*} [Fintype G]
    (V : G → ℝ) (J ell : ℕ) : ℝ := ∏ g, 1 / (V g)^(J + ell)

theorem physical_state_mass_pos {G : Type*} [Fintype G]
    (V : G → ℝ) (hV : ∀ g, 0 < V g) (J ell : ℕ) :
    0 < physicalStateMass V J ell := prod_pos (fun g hg => by exact div_pos zero_lt_one (pow_pos (hV g) _))
end

section
open Finset
/- Free labels are sampled independently; no injectivity is imposed. -/
abbrev PhysicalAuxLabels {G : Type*} (P : G → Finset ℕ) {J : ℕ}
    (C : G → Finset (Fin J)) := ∀ g, ↥(C g) → ↥(P g)

/- The source and target copy precisely the first-block slots outside C. -/
def physicalSharedCompatible {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (src tgt : PhysicalMarkLists P J ell) : Prop :=
  ∀ g j, j ∉ C g → src g (Sum.inl j) = tgt g (Sum.inl j)

/- A free label may not occur in any slot of the indicated endpoint. -/
def physicalAuxAvoids {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (labels : PhysicalMarkLists P J ell) : Prop :=
  ∀ g (j : C g) s, aux g j ≠ labels g s

/- For disjoint prime groups, banning a free label from its own
endpoint group is equivalent to banning it from the entire endpoint list. -/
theorem physical_aux_avoids_global_iff {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C)
    (labels : PhysicalMarkLists P J ell)
    (hP : Pairwise (fun g h => Disjoint (P g) (P h))) :
    physicalAuxAvoids C aux labels ↔
      ∀ g (j : C g) h s, (aux g j).val ≠ (labels h s).val := by
  constructor
  · intro ha g j h s he
    by_cases hgh : g = h
    · subst h
      exact ha g j s (Subtype.ext he)
    · have hp : (aux g j).val ∈ P h := by rw [he]; exact (labels h s).property
      exact (disjoint_left.mp (hP hgh)) (aux g j).property hp
  · intro ha g j s he
    exact ha g j g s (congrArg Subtype.val he)

/- One group contributes one factor for every first-block slot: the
copied shared label or an independent auxiliary label. -/
noncomputable def physicalGroupD {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (labels : PhysicalMarkLists P J ell)
    (aux : PhysicalAuxLabels P C) (g : G) : ℕ :=
  (∏ j ∈ univ \ C g, (labels g (Sum.inl j)).val) * ∏ j : C g, (aux g j).val

noncomputable def physicalD {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (labels : PhysicalMarkLists P J ell)
    (aux : PhysicalAuxLabels P C) : ℕ := ∏ g, physicalGroupD C labels aux g

theorem physical_shared_compatible_symm {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) {src tgt : PhysicalMarkLists P J ell}
    (h : physicalSharedCompatible C src tgt) : physicalSharedCompatible C tgt src :=
  fun g j hj => (h g j hj).symm

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (C : G → Finset (Fin J))

include G sharedInstance1 P J ell C

/- D is unchanged when compatible endpoint lists are reversed. -/
theorem physical_D_eq_of_shared 
    {src tgt : PhysicalMarkLists P J ell} (h : physicalSharedCompatible C src tgt)
    (aux : PhysicalAuxLabels P C) : physicalD C src aux = physicalD C tgt aux := by
  unfold physicalD physicalGroupD
  apply prod_congr rfl
  intro g hg
  congr 1
  apply prod_congr rfl
  intro j hj
  rw [h g j (mem_sdiff.mp hj).2]

theorem physical_D_pos 
    (labels : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hP : ∀ g p, p ∈ P g → 0 < p) : 0 < physicalD C labels aux := by
  apply prod_pos
  intro g hg
  apply mul_pos
  · exact prod_pos (fun j hj => hP g _ (labels g (Sum.inl j)).property)
  · exact prod_pos (fun j hj => hP g _ (aux g j).property)

/- Each shared label is one of the factors of D. -/
theorem physical_shared_label_dvd_D 
    (labels : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (g : G) (j : Fin J) (hj : j ∉ C g) :
    (labels g (Sum.inl j)).val ∣ physicalD C labels aux := by
  have hmem : j ∈ univ \ C g := mem_sdiff.mpr ⟨mem_univ j, hj⟩
  have hlocal : (labels g (Sum.inl j)).val ∣ physicalGroupD C labels aux g :=
    dvd_mul_of_dvd_left (dvd_prod_of_mem (fun j => (labels g (Sum.inl j)).val) hmem) _
  exact dvd_trans hlocal (dvd_prod_of_mem (fun g => physicalGroupD C labels aux g) (mem_univ g))

/- Shared divisibility is preserved by the dilation step n -> n+kD. -/
theorem physical_shared_divides_target 
    (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C)
    (k : ℤ) (g : G) (j : Fin J) (hj : j ∉ C g) :
    (((x.2.val g (Sum.inl j)).val : ℕ) : ℤ) ∣ x.1 + k * (physicalD C x.2.val aux : ℕ) := by
  have hD : (((x.2.val g (Sum.inl j)).val : ℕ) : ℤ) ∣ (physicalD C x.2.val aux : ℕ) := by
    exact_mod_cast physical_shared_label_dvd_D C x.2.val aux g j hj
  exact dvd_add (x.2.property g (Sum.inl j)) (dvd_mul_of_dvd_right hD k)

end


/- Support conditions of an unsymmetrized physical edge. -/
def physicalAdmissible {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) (k : ℤ) (x y : PhysicalState P J ell) : Prop :=
  physicalSharedCompatible C x.2.val y.2.val ∧
  physicalAuxAvoids C aux x.2.val ∧ physicalAuxAvoids C aux y.2.val ∧
  y.1 = x.1 + k * (physicalD C x.2.val aux : ℕ)

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (C : G → Finset (Fin J))
  (aux : PhysicalAuxLabels P C)
  (k : ℤ)

include G sharedInstance1 P J ell C aux k

/- Reversing an edge exchanges endpoint bans and negates the dilation
step, while leaving the sampled free labels and D unchanged. -/
theorem physical_admissible_reverse  {x y : PhysicalState P J ell}
    (h : physicalAdmissible C aux k x y) : physicalAdmissible C aux (-k) y x := by
  rcases h with ⟨hshared, hx, hy, hpos⟩
  refine ⟨physical_shared_compatible_symm C hshared, hy, hx, ?_⟩
  rw [← physical_D_eq_of_shared C hshared aux, hpos]
  ring

theorem physical_admissible_reverse_iff  (x y : PhysicalState P J ell) :
    physicalAdmissible C aux k x y ↔ physicalAdmissible C aux (-k) y x := by
  constructor
  · exact physical_admissible_reverse C aux k
  · intro h
    simpa only [neg_neg] using physical_admissible_reverse C aux (-k) h

end

end

section
open Finset
/- The reciprocal-prime probability assigned to a group label. -/
noncomputable def physicalLabelLaw {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (p : P g) : ℝ := 1 / (V g * (p.val : ℝ))

theorem physical_label_law_nonneg {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (hV : ∀ g, 0 ≤ V g) (g : G) (p : P g) :
    0 ≤ physicalLabelLaw V g p := by
  unfold physicalLabelLaw
  exact div_nonneg zero_le_one (mul_nonneg (hV g) (Nat.cast_nonneg p.val))

/- The auxiliary law is normalized by the group's harmonic mass. -/
theorem physical_label_law_sum {G : Type*} {P : G → Finset ℕ}
    (V : G → ℝ) (g : G) (hV : 0 < V g)
    (hMass : ∑ p ∈ P g, 1 / (p : ℝ) = V g) :
    (∑ p : P g, physicalLabelLaw V g p) = 1 := by
  have he : ∀ p : P g, physicalLabelLaw V g p = (1 / (p.val : ℝ)) / V g := by
    intro p
    unfold physicalLabelLaw
    rw [div_div, mul_comm]
  simp_rw [he]
  rw [← sum_div, sum_coe_sort (P g) (fun p => 1 / (p : ℝ)), hMass, div_self (ne_of_gt hV)]

/- Every free slot is sampled independently, including coincidences
between two different free slots. -/
noncomputable def physicalAuxMass {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (aux : PhysicalAuxLabels P C) : ℝ :=
  ∏ g, ∏ j : C g, physicalLabelLaw V g (aux g j)

theorem physical_aux_mass_nonneg {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 ≤ V g) (aux : PhysicalAuxLabels P C) :
    0 ≤ physicalAuxMass V C aux :=
  prod_nonneg (fun g _ => prod_nonneg (fun j _ => physical_label_law_nonneg V hV g (aux g j)))

theorem physical_aux_mass_sum {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) :
    (∑ aux : PhysicalAuxLabels P C, physicalAuxMass V C aux) = 1 := by
  classical
  unfold physicalAuxMass
  have hout : (∑ aux : PhysicalAuxLabels P C, ∏ g, ∏ j : C g, physicalLabelLaw V g (aux g j)) =
      ∏ g, ∑ f : ↥(C g) → ↥(P g), ∏ j : C g, physicalLabelLaw V g (f j) :=
    (Fintype.prod_sum (fun g (f : ↥(C g) → ↥(P g)) => ∏ j : C g, physicalLabelLaw V g (f j))).symm
  rw [hout]
  apply prod_eq_one
  intro g hg
  have hin : (∑ f : ↥(C g) → ↥(P g), ∏ j : C g, physicalLabelLaw V g (f j)) =
      ∏ _j : C g, ∑ p : P g, physicalLabelLaw V g p :=
    (Fintype.prod_sum (fun (_j : C g) (p : P g) => physicalLabelLaw V g p)).symm
  rw [hin]
  apply prod_eq_one
  intro j hj
  exact physical_label_law_sum V g (hV g) (hMass g)

/- Each target completion is weighted by one inverse harmonic mass
for every unshared slot. -/
noncomputable def physicalCompletionMass {G : Type*} [Fintype G] {J : ℕ}
    (V : G → ℝ) (C : G → Finset (Fin J)) (ell : ℕ) : ℝ :=
  ∏ g, 1 / (V g)^(ell + (C g).card)

theorem physical_completion_mass_pos {G : Type*} [Fintype G] {J : ℕ}
    (V : G → ℝ) (C : G → Finset (Fin J)) (ell : ℕ) (hV : ∀ g, 0 < V g) :
    0 < physicalCompletionMass V C ell :=
  prod_pos (fun g _ => div_pos zero_lt_one (pow_pos (hV g) _))






end

section
open Finset
/- The unit-modulus phase D^(i zeta), written using the real logarithm. -/
noncomputable def physicalPhase (ζ : ℝ) (D : ℕ) : ℂ :=
  Complex.exp ((ζ * Real.log (D : ℝ) : ℝ) * Complex.I)

theorem physical_phase_norm (ζ : ℝ) (D : ℕ) : ‖physicalPhase ζ D‖ = 1 := by
  rw [physicalPhase, Complex.norm_exp]
  simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re,
    Complex.I_im, mul_zero, zero_mul, sub_self, Real.exp_zero]

theorem physical_phase_reverse (ζ : ℝ) (D : ℕ) :
    physicalPhase (-ζ) D = (starRingEnd ℂ) (physicalPhase ζ D) := by
  unfold physicalPhase
  rw [← Complex.exp_conj]
  congr 1
  simp only [map_mul, Complex.conj_ofReal, Complex.conj_I, neg_mul, Complex.ofReal_neg]
  ring

/- One sampled auxiliary choice contributes this row coefficient. The
coefficient function may depend on both ordered lists and the free labels. -/
noncomputable def physicalEdgeCoeff {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) : ℂ := by
  classical
  exact if physicalAdmissible C aux k x y then
    ((physicalAuxMass V C aux * physicalCompletionMass V C ell *
      physicalDamping P J ell q x.1 * physicalDamping P J ell q y.1 : ℝ) : ℂ) *
      K x.2.val y.2.val aux * physicalPhase ζ (physicalD C x.2.val aux)
    else 0

/- The adjoint edge uses the same auxiliary choice, reverses the two
lists and the step, and conjugates the list coefficient and phase. -/
theorem physical_edge_reverse {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) :
    physicalEdgeCoeff V C q (-ζ) (-k) (fun a b f => (starRingEnd ℂ) (K b a f)) aux y x =
      (starRingEnd ℂ) (physicalEdgeCoeff V C q ζ k K aux x y) := by
  classical
  by_cases h : physicalAdmissible C aux k x y
  · have hr := physical_admissible_reverse C aux k h
    have hD := physical_D_eq_of_shared C h.1 aux
    have hscalar : physicalAuxMass V C aux * physicalCompletionMass V C ell *
        physicalDamping P J ell q y.1 * physicalDamping P J ell q x.1 =
        physicalAuxMass V C aux * physicalCompletionMass V C ell *
        physicalDamping P J ell q x.1 * physicalDamping P J ell q y.1 := by ring
    simp only [physicalEdgeCoeff, if_pos h, if_pos hr, hscalar, ← hD,
      physical_phase_reverse, map_mul, Complex.conj_ofReal]
  · have hr : ¬ physicalAdmissible C aux (-k) y x := by
      exact fun hr => h ((physical_admissible_reverse_iff C aux k x y).mpr hr)
    simp only [physicalEdgeCoeff, if_neg h, if_neg hr, map_zero]

/- Summing all auxiliary choices gives the unsymmetrized pattern kernel. -/
noncomputable def physicalPatternKernel {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (x y : PhysicalState P J ell) : ℂ :=
  ∑ aux : PhysicalAuxLabels P C, physicalEdgeCoeff V C q ζ k K aux x y

theorem physical_pattern_reverse {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (x y : PhysicalState P J ell) :
    physicalPatternKernel V C q (-ζ) (-k) (fun a b f => (starRingEnd ℂ) (K b a f)) y x =
      (starRingEnd ℂ) (physicalPatternKernel V C q ζ k K x y) := by
  unfold physicalPatternKernel
  simp only [physical_edge_reverse, map_sum]



end

section
open Finset
/- Multiplicativity of the phase permits the small/big group split. -/
theorem physical_phase_mul (ζ : ℝ) {D E : ℕ} (hD : 0 < D) (hE : 0 < E) :
    physicalPhase ζ (D * E) = physicalPhase ζ D * physicalPhase ζ E := by
  unfold physicalPhase
  rw [Nat.cast_mul, Real.log_mul (by exact_mod_cast ne_of_gt hD) (by exact_mod_cast ne_of_gt hE),
    ← Complex.exp_add]
  congr 1
  push_cast
  ring

/- The mass of one permitted sampled edge before its bounded list
coefficient and its unit-modulus phase are applied. -/
noncomputable def physicalEdgeMass {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q : ℝ) (k : ℤ) (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) : ℝ := by
  classical
  exact if physicalAdmissible C aux k x y then
    physicalAuxMass V C aux * physicalCompletionMass V C ell *
      physicalDamping P J ell q x.1 * physicalDamping P J ell q y.1
    else 0

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (V : G → ℝ)
  (C : G → Finset (Fin J))

include G sharedInstance1 P J ell V C

theorem physical_edge_mass_nonneg 
    {q : ℝ} (k : ℤ) (hV : ∀ g, 0 < V g) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) :
    0 ≤ physicalEdgeMass V C q k aux x y := by
  classical
  unfold physicalEdgeMass
  split_ifs
  · exact mul_nonneg (mul_nonneg
      (mul_nonneg (physical_aux_mass_nonneg V C (fun g => (hV g).le) aux)
        (physical_completion_mass_pos V C ell hV).le)
      (physical_damping_unit P J ell hq0 hq1 x.1).1)
      (physical_damping_unit P J ell hq0 hq1 y.1).1
  · exact le_rfl

/- The sampled coefficient is its real mass times the list coefficient
and dilation phase. -/
theorem physical_edge_coefficient_factor 
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) :
    physicalEdgeCoeff V C q ζ k K aux x y =
      (physicalEdgeMass V C q k aux x y : ℂ) * K x.2.val y.2.val aux *
        physicalPhase ζ (physicalD C x.2.val aux) := by
  classical
  unfold physicalEdgeCoeff physicalEdgeMass
  split_ifs <;> simp only [Complex.ofReal_zero, zero_mul]

/- The absolute coefficient retains the exact support and real edge
mass; taking absolute values does not introduce a phase loss. -/
theorem physical_edge_norm 
    {q : ℝ} (ζ : ℝ) (k : ℤ) (hV : ∀ g, 0 < V g) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) :
    ‖physicalEdgeCoeff V C q ζ k K aux x y‖ =
      physicalEdgeMass V C q k aux x y * ‖K x.2.val y.2.val aux‖ := by
  rw [physical_edge_coefficient_factor, norm_mul, norm_mul, physical_phase_norm, mul_one,
    Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (physical_edge_mass_nonneg V C k hV hq0 hq1 aux x y)]

/- A uniform list-coefficient bound multiplies the exact nonnegative
edge mass, without dropping the transition support. -/
theorem physical_edge_norm_le 
    {q : ℝ} (ζ : ℝ) (k : ℤ) (hV : ∀ g, 0 < V g) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (x y : PhysicalState P J ell) {B : ℝ}
    (hK : ‖K x.2.val y.2.val aux‖ ≤ B) :
    ‖physicalEdgeCoeff V C q ζ k K aux x y‖ ≤ physicalEdgeMass V C q k aux x y * B := by
  rw [physical_edge_norm V C ζ k hV hq0 hq1]
  exact mul_le_mul_of_nonneg_left hK (physical_edge_mass_nonneg V C k hV hq0 hq1 aux x y)

end




end

section
open Finset
/- Mark lists satisfying divisibility are exactly lists taking their
values in the corresponding available divisor pools. -/
def physicalMarksAtEquiv {G : Type*} (P : G → Finset ℕ) (J ell : ℕ) (n : ℤ) :
    PhysicalMarksAt P J ell n ≃
      (∀ g, PhysicalSlots J ell ↪ ↥(physicalDivisorPool P g n)) where
  toFun labels g := physicalMarksEmbedding P J ell n labels g
  invFun f := ⟨fun g => {
    toFun := fun s => ⟨(f g s).val, (mem_filter.mp (f g s).property).1⟩
    inj' := by
      intro s t hst
      have he : (f g s).val = (f g t).val :=
        congrArg (fun p : P g => p.val) hst
      exact (f g).injective (Subtype.ext he) },
    fun g s => (mem_filter.mp (f g s).property).2⟩
  left_inv labels := by
    apply Subtype.ext
    funext g
    apply Function.Embedding.ext
    intro s
    rfl
  right_inv f := by
    funext g
    apply Function.Embedding.ext
    intro s
    rfl

/- The full physical fiber has the expected product of falling-factorial
cardinalities; a group with too few divisors makes the fiber empty. -/
theorem physical_marks_fiber_card {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) (n : ℤ) :
    Nat.card (PhysicalMarksAt P J ell n) =
      ∏ g, (physicalOmega P g n).descFactorial (J + ell) := by
  classical
  rw [Nat.card_congr (physicalMarksAtEquiv P J ell n), Nat.card_eq_fintype_card, Fintype.card_pi]
  apply prod_congr rfl
  intro g hg
  rw [Fintype.card_embedding_eq]
  simp only [Fintype.card_coe, Fintype.card_sum, Fintype.card_fin, physicalOmega]

/- A finite position cutoff gives a finite type of physical states. -/
def physicalCutoffEquiv {G : Type*} (P : G → Finset ℕ) (J ell : ℕ) (I : Finset ℤ) :
    {x : PhysicalState P J ell // x.1 ∈ I} ≃ (Σ n : I, PhysicalMarksAt P J ell n.val) where
  toFun x := ⟨⟨x.val.1, x.property⟩, x.val.2⟩
  invFun y := ⟨⟨y.1.val, y.2⟩, y.1.property⟩
  left_inv x := by cases x with | mk x hx => cases x; rfl
  right_inv y := by cases y with | mk n labels => cases n; rfl

/- No global instance is added: the finite cutoff enumeration is an
explicit object that can be installed locally when a finite matrix is used. -/
noncomputable abbrev physicalCutoffFintype {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (J ell : ℕ) (I : Finset ℤ) :
    Fintype {x : PhysicalState P J ell // x.1 ∈ I} := by
  classical
  exact Fintype.ofEquiv (Σ n : I, PhysicalMarksAt P J ell n.val) (physicalCutoffEquiv P J ell I).symm

/- The cutoff cardinality is the sum of the exact fiber counts. -/
theorem physical_cutoff_card {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (J ell : ℕ) (I : Finset ℤ) :
    Nat.card {x : PhysicalState P J ell // x.1 ∈ I} =
      ∑ n ∈ I, ∏ g, (physicalOmega P g n).descFactorial (J + ell) := by
  classical
  rw [Nat.card_congr (physicalCutoffEquiv P J ell I), Nat.card_eq_fintype_card, Fintype.card_sigma]
  simp only [← Nat.card_eq_fintype_card, physical_marks_fiber_card]
  exact sum_coe_sort I (fun n => ∏ g, (physicalOmega P g n).descFactorial (J + ell))
end

section
open Finset
/- Reorder a full list into its shared slots followed by the free
first-block slots and the final ell slots. -/
def physicalSlotSplit {J ell : ℕ} (C : Finset (Fin J)) :
    ({j : Fin J // j ∉ C} ⊕ (↥C ⊕ Fin ell)) ≃ PhysicalSlots J ell where
  toFun
    | Sum.inl s => Sum.inl s.val
    | Sum.inr (Sum.inl s) => Sum.inl s.val
    | Sum.inr (Sum.inr s) => Sum.inr s
  invFun
    | Sum.inl j => if hj : j ∈ C then Sum.inr (Sum.inl ⟨j, hj⟩) else Sum.inl ⟨j, hj⟩
    | Sum.inr j => Sum.inr (Sum.inr j)
  left_inv := by
    rintro (s | (s | s))
    · simp only [s.property, ↓reduceDIte]
    · simp only [s.property, ↓reduceDIte]
    · rfl
  right_inv := by
    intro s
    cases s with
    | inl j => by_cases hj : j ∈ C <;> simp only [hj, ↓reduceDIte]
    | inr j => rfl

/- Reordering the slots identifies actual full-list completions with
the shared/unshared completion type used by the counting argument. -/
def physicalSlotCompletionEquiv {J ell : ℕ} {Q : Type*} (C : Finset (Fin J))
    (shared : {j : Fin J // j ∉ C} ↪ Q) :
    {f : PhysicalSlots J ell ↪ Q // ∀ s : {j : Fin J // j ∉ C}, f (Sum.inl s.val) = shared s} ≃
    {f : ({j : Fin J // j ∉ C} ⊕ (↥C ⊕ Fin ell)) ↪ Q // ∀ s, f (Sum.inl s) = shared s} where
  toFun f := ⟨(physicalSlotSplit C).toEmbedding.trans f.val, f.property⟩
  invFun f := ⟨(physicalSlotSplit C).symm.toEmbedding.trans f.val, by
    intro s
    change f.val ((physicalSlotSplit C).symm ((physicalSlotSplit C) (Sum.inl s))) = shared s
    rw [Equiv.symm_apply_apply]
    exact f.property s⟩
  left_inv f := by
    apply Subtype.ext
    apply Function.Embedding.ext
    intro s
    change f.val ((physicalSlotSplit C) ((physicalSlotSplit C).symm s)) = f.val s
    rw [Equiv.apply_symm_apply]
  right_inv f := by
    apply Subtype.ext
    apply Function.Embedding.ext
    intro s
    change f.val ((physicalSlotSplit C).symm ((physicalSlotSplit C) s)) = f.val s
    rw [Equiv.symm_apply_apply]

/- The copied-slot type has cardinality J-|C|. -/
theorem physical_shared_slot_type_card {J : ℕ} (C : Finset (Fin J)) :
    Fintype.card {j : Fin J // j ∉ C} = J - C.card := by
  classical
  rw [Fintype.card_subtype_compl]
  simp only [Fintype.card_fin, Fintype.card_coe]




/- The copied labels of an actual source state embed into the divisors
available at the target position n+kD. -/
def physicalSharedTargetEmbedding {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C) (k : ℤ) (g : G) :
    {j : Fin J // j ∉ C g} ↪
      ↥(physicalDivisorPool P g (x.1 + k * (physicalD C x.2.val aux : ℕ))) where
  toFun s := ⟨(x.2.val g (Sum.inl s.val)).val,
    mem_filter.mpr ⟨(x.2.val g (Sum.inl s.val)).property,
      physical_shared_divides_target C x aux k g s.val s.property⟩⟩
  inj' := by
    intro s t hst
    have he : (x.2.val g (Sum.inl s.val)).val = (x.2.val g (Sum.inl t.val)).val :=
      congrArg (fun p : ↥(physicalDivisorPool P g (x.1 + k * (physicalD C x.2.val aux : ℕ))) => p.val) hst
    have hs := (x.2.val g).injective (Subtype.ext he)
    exact Subtype.ext (Sum.inl.inj hs)

/- The damped completion bound now applies in the original physical
slot order, uniformly in J and in the target divisor pool. -/
theorem exists_physical_target_mass_bound {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hv : 0 < v) (ell m : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (J : ℕ) (C : Finset (Fin J)), C.card ≤ m →
      ∀ (Q : Type) [Fintype Q] (shared : {j : Fin J // j ∉ C} ↪ Q) (V : ℝ), v ≤ V →
        ((Nat.card {f : PhysicalSlots J ell ↪ Q //
          ∀ s : {j : Fin J // j ∉ C}, f (Sum.inl s.val) = shared s} : ℝ) *
          q^(((Fintype.card Q - (J + ell) : ℕ) : ℝ) / 2)) / V^(ell + C.card) ≤ A := by
  obtain ⟨A, hA, hbound⟩ := exists_completion_mass_bound_types hq0 hq1 hv (ell + m)
  refine ⟨A, hA, ?_⟩
  intro J C hC Q _ shared V hV
  have hcard : C.card ≤ J := by simpa only [Fintype.card_fin] using card_le_univ C
  have hM : Fintype.card {j : Fin J // j ∉ C} + Fintype.card (↥C ⊕ Fin ell) = J + ell := by
    rw [physical_shared_slot_type_card, Fintype.card_sum, Fintype.card_coe, Fintype.card_fin]
    omega
  have hU : Fintype.card (↥C ⊕ Fin ell) = ell + C.card := by
    simp only [Fintype.card_sum, Fintype.card_coe, Fintype.card_fin, Nat.add_comm]
  have hc := Nat.card_congr (physicalSlotCompletionEquiv (ell := ell) C shared)
  have he := hbound {j : Fin J // j ∉ C} (↥C ⊕ Fin ell) Q shared V hV
    (by rw [hU]; exact Nat.add_le_add_left hC ell)
  rw [hM, hU, ← hc] at he
  exact he
end

section
open Finset
noncomputable def physicalNextPosition {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C) (k : ℤ) : ℤ :=
  x.1 + k * (physicalD C x.2.val aux : ℕ)

abbrev PhysicalCompatibleTargets {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C) (k : ℤ) :=
  {y : PhysicalMarksAt P J ell (physicalNextPosition C x aux k) //
    physicalSharedCompatible C x.2.val y.val}

abbrev PhysicalLocalTargets {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C) (k : ℤ) (g : G) :=
  {f : PhysicalSlots J ell ↪ ↥(physicalDivisorPool P g (physicalNextPosition C x aux k)) //
    ∀ s : {j : Fin J // j ∉ C g}, f (Sum.inl s.val) = physicalSharedTargetEmbedding C x aux k g s}

/- A compatible target state is exactly one independent ordered
completion in each group, in the original physical slot order. -/
noncomputable def physicalCompatibleTargetsEquiv {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C) (k : ℤ) :
    PhysicalCompatibleTargets C x aux k ≃ (∀ g, PhysicalLocalTargets C x aux k g) where
  toFun y g := ⟨physicalMarksEmbedding P J ell (physicalNextPosition C x aux k) y.val g, by
    intro s
    apply Subtype.ext
    exact (congrArg Subtype.val (y.property g s.val s.property)).symm⟩
  invFun f := ⟨(physicalMarksAtEquiv P J ell (physicalNextPosition C x aux k)).symm (fun g => (f g).val), by
    intro g j hj
    apply Subtype.ext
    exact (congrArg (fun p : ↥(physicalDivisorPool P g (physicalNextPosition C x aux k)) => p.val)
      ((f g).property ⟨j, hj⟩)).symm⟩
  left_inv y := by
    apply Subtype.ext
    apply Subtype.ext
    funext g
    apply Function.Embedding.ext
    intro s
    rfl
  right_inv f := by
    funext g
    apply Subtype.ext
    apply Function.Embedding.ext
    intro s
    rfl

theorem physical_compatible_targets_card {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C) (k : ℤ) :
    Nat.card (PhysicalCompatibleTargets C x aux k) =
      ∏ g, Nat.card (PhysicalLocalTargets C x aux k g) := by
  classical
  rw [Nat.card_congr (physicalCompatibleTargetsEquiv C x aux k), Nat.card_eq_fintype_card, Fintype.card_pi]
  simp only [Nat.card_eq_fintype_card]

/- The complete compatible-target row mass, with target damping and
completion normalization, is bounded by one fixed constant per group.
The constant depends on ell+m, q, and the lower harmonic mass, but not J. -/
theorem exists_physical_compatible_target_mass_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell m : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] (P : G → Finset ℕ)
      (J : ℕ) (V : G → ℝ) (C : G → Finset (Fin J)),
      (∀ g, v ≤ V g) → (∀ g, (C g).card ≤ m) →
      ∀ (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C) (k : ℤ),
        (Nat.card (PhysicalCompatibleTargets C x aux k) : ℝ) * physicalCompletionMass V C ell *
          physicalDamping P J ell q (physicalNextPosition C x aux k) ≤ A^(Fintype.card G) := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_target_mass_bound hq0 hq1 hv ell m
  refine ⟨A, hA, ?_⟩
  intro G _ P J V C hV hC x aux k
  classical
  have hVp : ∀ g, 0 < V g := fun g => hv.trans_le (hV g)
  rw [physical_compatible_targets_card, Nat.cast_prod]
  unfold physicalCompletionMass physicalDamping
  rw [← prod_mul_distrib, ← prod_mul_distrib]
  have hpoint : ∀ g, (Nat.card (PhysicalLocalTargets C x aux k g) : ℝ) *
      (1 / (V g)^(ell + (C g).card)) *
      q^(((physicalOmega P g (physicalNextPosition C x aux k) - (J + ell) : ℕ) : ℝ) / 2) ≤ A := by
    intro g
    have hh := hbound J (C g) (hC g)
      ↥(physicalDivisorPool P g (physicalNextPosition C x aux k))
      (physicalSharedTargetEmbedding C x aux k g) (V g) (hV g)
    have hcard : Nat.card ↥(physicalDivisorPool P g (physicalNextPosition C x aux k)) =
        physicalOmega P g (physicalNextPosition C x aux k) := by
      rw [Nat.card_eq_fintype_card, Fintype.card_coe]
      rfl
    rw [← Nat.card_eq_fintype_card, hcard] at hh
    have hlocal : ((Nat.card (PhysicalLocalTargets C x aux k g) : ℝ) *
        q^(((physicalOmega P g (physicalNextPosition C x aux k) - (J + ell) : ℕ) : ℝ) / 2)) /
          (V g)^(ell + (C g).card) ≤ A := by
      convert hh using 1

    calc
      _ = ((Nat.card (PhysicalLocalTargets C x aux k g) : ℝ) *
          q^(((physicalOmega P g (physicalNextPosition C x aux k) - (J + ell) : ℕ) : ℝ) / 2)) /
            (V g)^(ell + (C g).card) := by ring
      _ ≤ A := hlocal
  calc
    _ ≤ ∏ _g : G, A := by
      apply prod_le_prod₀
      · intro g hg
        exact mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (div_nonneg zero_le_one (pow_nonneg (hVp g).le _)))
          (Real.rpow_nonneg hq0 _)
      · intro g hg
        exact hpoint g
    _ = _ := by simp
end

section
open Finset Classical
theorem physical_state_ext {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    {x y : PhysicalState P J ell} (hpos : x.1 = y.1) (hmarks : x.2.val = y.2.val) : x = y := by
  rcases x with ⟨n, a, ha⟩
  rcases y with ⟨r, b, hb⟩
  dsimp only at hpos hmarks
  cases hpos
  cases hmarks
  rfl

/- Forgetting the endpoint exclusion bans embeds admissible targets
into the finite collection of compatible completions. -/
def physicalAdmissibleTargetEmbedding {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C) (k : ℤ) :
    {y : PhysicalState P J ell // physicalAdmissible C aux k x y} ↪
      PhysicalCompatibleTargets C x aux k where
  toFun y := ⟨⟨y.val.2.val, by
    intro g s
    rw [physicalNextPosition, ← y.property.2.2.2]
    exact y.val.2.property g s⟩, y.property.1⟩
  inj' := by
    intro y z h
    apply Subtype.ext
    apply physical_state_ext
    · exact y.property.2.2.2.trans z.property.2.2.2.symm
    · exact congrArg (fun t : PhysicalCompatibleTargets C x aux k => t.val.val) h

/- A finite cutoff or additional restriction can only reduce the number
of admissible targets. -/
theorem physical_admissible_targets_card_le {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (x : PhysicalState P J ell) (aux : PhysicalAuxLabels P C) (k : ℤ)
    (rows : Finset (PhysicalState P J ell)) :
    (rows.filter (fun y => physicalAdmissible C aux k x y)).card ≤
      Nat.card (PhysicalCompatibleTargets C x aux k) := by
  classical
  let f : ↥(rows.filter (fun y => physicalAdmissible C aux k x y)) →
      PhysicalCompatibleTargets C x aux k := fun y =>
    physicalAdmissibleTargetEmbedding C x aux k ⟨y.val, (mem_filter.mp y.property).2⟩
  have hf : Function.Injective f := by
    intro y z h
    have he := (physicalAdmissibleTargetEmbedding C x aux k).injective h
    exact Subtype.ext (congrArg (fun t : {y : PhysicalState P J ell // physicalAdmissible C aux k x y} => t.val) he)
  simpa only [Fintype.card_coe, Nat.card_eq_fintype_card] using Fintype.card_le_of_injective f hf

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (V : G → ℝ)
  (C : G → Finset (Fin J))

include G sharedInstance1 P J ell V C

/- Every supported edge has the same target position and therefore the
same endpoint damping. This gives an exact row-mass formula. -/
theorem physical_edge_mass_sum 
    (q : ℝ) (k : ℤ) (aux : PhysicalAuxLabels P C) (x : PhysicalState P J ell)
    (rows : Finset (PhysicalState P J ell)) :
    (∑ y ∈ rows, physicalEdgeMass V C q k aux x y) =
      (rows.filter (fun y => physicalAdmissible C aux k x y)).card *
        (physicalAuxMass V C aux * physicalCompletionMass V C ell *
          physicalDamping P J ell q x.1 * physicalDamping P J ell q (physicalNextPosition C x aux k)) := by
  classical
  have he : (∑ y ∈ rows, physicalEdgeMass V C q k aux x y) =
      ∑ _y ∈ rows.filter (fun y => physicalAdmissible C aux k x y),
        physicalAuxMass V C aux * physicalCompletionMass V C ell *
          physicalDamping P J ell q x.1 * physicalDamping P J ell q (physicalNextPosition C x aux k) := by
    rw [sum_filter]
    apply sum_congr rfl
    intro y hy
    by_cases ha : physicalAdmissible C aux k x y
    · simp only [physicalEdgeMass, if_pos ha]
      rw [ha.2.2.2]
      rfl
    · simp only [physicalEdgeMass, if_neg ha]
  rw [he, sum_const, nsmul_eq_mul]

/- The damped completion estimate bounds the mass of actual edges,
including all exclusion bans and any finite cutoff. -/
theorem physical_edge_mass_row_le 
    {q A : ℝ} (k : ℤ) (hV : ∀ g, 0 < V g) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (aux : PhysicalAuxLabels P C) (x : PhysicalState P J ell)
    (rows : Finset (PhysicalState P J ell))
    (hA : (Nat.card (PhysicalCompatibleTargets C x aux k) : ℝ) * physicalCompletionMass V C ell *
      physicalDamping P J ell q (physicalNextPosition C x aux k) ≤ A) :
    (∑ y ∈ rows, physicalEdgeMass V C q k aux x y) ≤ physicalAuxMass V C aux * A := by
  classical
  have haux := physical_aux_mass_nonneg V C (fun g => (hV g).le) aux
  have hc := (physical_completion_mass_pos V C ell hV).le
  have hx := physical_damping_unit P J ell hq0 hq1 x.1
  have ht := (physical_damping_unit P J ell hq0 hq1 (physicalNextPosition C x aux k)).1
  have hcount : ((rows.filter (fun y => physicalAdmissible C aux k x y)).card : ℝ) ≤
      (Nat.card (PhysicalCompatibleTargets C x aux k) : ℝ) := by
    exact_mod_cast physical_admissible_targets_card_le C x aux k rows
  rw [physical_edge_mass_sum]
  calc
    _ ≤ (Nat.card (PhysicalCompatibleTargets C x aux k) : ℝ) *
        (physicalAuxMass V C aux * physicalCompletionMass V C ell *
          physicalDamping P J ell q x.1 * physicalDamping P J ell q (physicalNextPosition C x aux k)) :=
      mul_le_mul_of_nonneg_right hcount (mul_nonneg (mul_nonneg (mul_nonneg haux hc) hx.1) ht)
    _ = physicalAuxMass V C aux * ((Nat.card (PhysicalCompatibleTargets C x aux k) : ℝ) *
        physicalCompletionMass V C ell * physicalDamping P J ell q (physicalNextPosition C x aux k)) *
          physicalDamping P J ell q x.1 := by ring
    _ ≤ physicalAuxMass V C aux * ((Nat.card (PhysicalCompatibleTargets C x aux k) : ℝ) *
        physicalCompletionMass V C ell * physicalDamping P J ell q (physicalNextPosition C x aux k)) * 1 :=
      mul_le_mul_of_nonneg_left hx.2 (mul_nonneg haux (mul_nonneg (mul_nonneg (Nat.cast_nonneg _) hc) ht))
    _ ≤ physicalAuxMass V C aux * A := by
      rw [mul_one]
      exact mul_le_mul_of_nonneg_left hA haux

/- The absolute row sum of a sampled physical coefficient is bounded
by its auxiliary probability times the damped completion bound. -/
theorem physical_edge_norm_row_le 
    {q A B : ℝ} (ζ : ℝ) (k : ℤ) (hV : ∀ g, 0 < V g) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (x : PhysicalState P J ell)
    (rows : Finset (PhysicalState P J ell)) (hB : 0 ≤ B)
    (hK : ∀ y ∈ rows, ‖K x.2.val y.2.val aux‖ ≤ B)
    (hA : (Nat.card (PhysicalCompatibleTargets C x aux k) : ℝ) * physicalCompletionMass V C ell *
      physicalDamping P J ell q (physicalNextPosition C x aux k) ≤ A) :
    (∑ y ∈ rows, ‖physicalEdgeCoeff V C q ζ k K aux x y‖) ≤ physicalAuxMass V C aux * A * B := by
  calc
    _ ≤ ∑ y ∈ rows, physicalEdgeMass V C q k aux x y * B :=
      sum_le_sum (fun y hy => physical_edge_norm_le V C ζ k hV hq0 hq1 K aux x y (hK y hy))
    _ = (∑ y ∈ rows, physicalEdgeMass V C q k aux x y) * B := by rw [sum_mul]
    _ ≤ _ := mul_le_mul_of_nonneg_right (physical_edge_mass_row_le V C k hV hq0 hq1 aux x rows hA) hB

end

end

section
open Finset
/- Summing the sampled edge bounds costs exactly the total auxiliary
probability, which is one. -/
theorem physical_pattern_norm_row_le {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    {q A B : ℝ} (ζ : ℝ) (k : ℤ) (hV : ∀ g, 0 < V g) (hq0 : 0 ≤ q) (hq1 : q ≤ 1)
    (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (x : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)) (hB : 0 ≤ B)
    (hK : ∀ aux y, y ∈ rows → ‖K x.2.val y.2.val aux‖ ≤ B)
    (hA : ∀ aux, (Nat.card (PhysicalCompatibleTargets C x aux k) : ℝ) * physicalCompletionMass V C ell *
      physicalDamping P J ell q (physicalNextPosition C x aux k) ≤ A) :
    (∑ y ∈ rows, ‖physicalPatternKernel V C q ζ k K x y‖) ≤ A * B := by
  classical
  calc
    _ ≤ ∑ y ∈ rows, ∑ aux : PhysicalAuxLabels P C, ‖physicalEdgeCoeff V C q ζ k K aux x y‖ :=
      sum_le_sum (fun y _ => norm_sum_le _ _)
    _ = ∑ aux : PhysicalAuxLabels P C, ∑ y ∈ rows, ‖physicalEdgeCoeff V C q ζ k K aux x y‖ := sum_comm
    _ ≤ ∑ aux : PhysicalAuxLabels P C, physicalAuxMass V C aux * A * B :=
      sum_le_sum (fun aux _ => physical_edge_norm_row_le V C ζ k hV hq0 hq1 K aux x rows hB (hK aux) (hA aux))
    _ = (∑ aux : PhysicalAuxLabels P C, physicalAuxMass V C aux) * A * B := by rw [sum_mul, sum_mul]
    _ = A * B := by rw [physical_aux_mass_sum V C hV hMass, one_mul]

/- The physical kernel has a bound of one fixed constant per prime
group, independent of the number of copied mark slots and the cutoff. -/
theorem exists_physical_pattern_row_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell m : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] [DecidableEq G] (P : G → Finset ℕ)
      (J : ℕ) (V : G → ℝ) (C : G → Finset (Fin J)),
      (∀ g, v ≤ V g) → (∀ g, (C g).card ≤ m) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      ∀ (ζ : ℝ) (k : ℤ)
        (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
        (B : ℝ), 0 ≤ B → (∀ a b aux, ‖K a b aux‖ ≤ B) →
        ∀ (x : PhysicalState P J ell) (rows : Finset (PhysicalState P J ell)),
        (∑ y ∈ rows, ‖physicalPatternKernel V C q ζ k K x y‖) ≤ A^(Fintype.card G) * B := by
  obtain ⟨A, hA, hbound⟩ := exists_physical_compatible_target_mass_bound hq0 hq1 hv ell m
  refine ⟨A, hA, ?_⟩
  intro G _ _ P J V C hV hC hMass ζ k K B hB hK x rows
  exact physical_pattern_norm_row_le V C ζ k (fun g => hv.trans_le (hV g)) hq0 hq1.le hMass K x rows hB
    (fun aux y _ => hK x.2.val y.2.val aux) (fun aux => hbound G P J V C hV hC x aux k)

/- Edge reversal preserves absolute values, so the reverse kernel
provides exactly the column estimates for the original kernel. -/
theorem physical_pattern_norm_reverse {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (q ζ : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (x y : PhysicalState P J ell) :
    ‖physicalPatternKernel V C q (-ζ) (-k) (fun a b f => (starRingEnd ℂ) (K b a f)) y x‖ =
      ‖physicalPatternKernel V C q ζ k K x y‖ := by
  rw [physical_pattern_reverse]
  exact RCLike.norm_conj _
end

