  have hCm : 0 ≤ C*Real.log L := (Nat.cast_nonneg m).trans hm
  have hthree : (m : ℝ) ≤ (3*C)*Real.log L := by nlinarith
  have htotal : ((2*s+m : ℕ) : ℝ) ≤ (3*C)*Real.log L := by
    push_cast
    nlinarith
