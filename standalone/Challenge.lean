def physicalOmissionSlots (J ell : ℕ) : Finset (PhysicalSlots J ell) :=
  univ.map Function.Embedding.inr

theorem physical_omission_slots_card (J ell : ℕ) :
    (physicalOmissionSlots J ell).card = ell := by
