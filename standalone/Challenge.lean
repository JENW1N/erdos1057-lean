/- Once the initial prefix has no selected children, forest constraints are exactly the subsequent stage constraints. -/

namespace Bounty

theorem birth_forest_compatible_iff_event_stages {m L : ℕ} {α : Type*}
    (owner : Fin m → Fin (L + 1)) (code : BirthForestCode m)
    (hcode : ∀ i, owner i = 0 → code i = none) (values : Fin m → Option α) :
    birthForestCompatible (fun i => (values i).isSome = true) values code ↔
      ∀ u : Fin L, birthForestStageCondition owner u.succ values code := by
  rw [birth_forest_compatible_iff_stages owner]
  constructor
  · intro h u
