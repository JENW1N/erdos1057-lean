    ((Ideal.absNorm (Ideal.span {p}):ℂ)^(-s))^3
  let B:ℂ→ℂ:=fun s=>-((Ideal.absNorm (Ideal.span {p}):ℂ)^(-s)*primeCubicGauss p hp hprimary 1 h)
