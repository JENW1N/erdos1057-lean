/- The signed raw-minus-comparison prime family on the genuine mixed state.
Both endpoint slot averages, the original auxiliary law, and the fixed
fresh-birth initial exclusion remain in the actual operator. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_joint_average_sum
    {I S G : Type*} [Fintype I] [Fintype S] [DecidableEq S]
    [Fintype G] [DecidableEq G] {Ps : S → Finset ℕ} {P Z : G → Type*}
    {J ell B : ℕ} {M : G → ℕ}
    (F : I → PhysicalSmallBigState Ps J ell (ProductBoundedOrderedState P Z M B) → ℂ) :
    physicalSmallBigJointAverage (∑ i, F i) = ∑ i, physicalSmallBigJointAverage (F i) := by
  funext s
  rw [physical_small_big_joint_average_eq_sum]
  simp only [Finset.sum_apply, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl
  intro i _
  exact (physical_small_big_joint_average_eq_sum (F i) s).symm

section
variable {S G : Type} [Fintype S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Finset ℕ} {J ell B : ℕ}

noncomputable def physicalMixedRepeatedLabels (C : G → Finset (Fin J))
    (x : CleanFullMemoryState P J ell B) : RepeatedBigLists P J ell :=
  fun g j => (x g).1 ((physicalFullSlotIndex (C g)).symm j)

noncomputable def physicalMixedCoefficientTarget (C : G → Finset (Fin J)) (k : ℤ)
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (e : PhysicalMixedCoefficientEvent C k a s) :
    PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) :=
  physicalSmallBigTarget (PhysicalSmallBigFullEvent (fun g (p : P g) => p.val)
    (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
    (fun d c g => physicalMixedEdgeDelta C k d c a g)
    (fun d c g => physicalMixedEdgeD C d c a g))
    (physicalSmallBigFullTarget (fun g (p : P g) => p.val)
      (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
      (fun d c g => physicalMixedEdgeDelta C k d c a g)
      (fun d c g => physicalMixedEdgeD C d c a g))
    (fun x => physicalMixedBigStep C k
      (productActiveMemorySplit (fun g => physicalFullSharedIndices (ell := ell) (C g)) B x).1 a) s e

noncomputable def physicalMixedPrimePatternAction
    (V : G → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    (Q : ℕ) (h ξ : ℝ) (k : ℤ) (initial : ∀ g, Finset (P g))
    (φ : ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
        PhysicalMixedCoefficientEvent (repeatedBigPrimePatternCut probes r t i) k a s → ℂ)
    (f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ) :=
  let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) => primeProductRetainedCells
    (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
  ∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
    physicalMixedCoefficientAction (repeatedBigPrimePatternCut probes r t i) k V baseline ρ Vs q initial
      (fun a s e => repeatedBigPrimePatternWeight probes r t i *
        repeatedBigPrimePatternKernel P V probes r t hrt Q h kept i
          (physicalMixedRepeatedLabels (repeatedBigPrimePatternCut probes r t i) s.2)
          (physicalMixedRepeatedLabels (repeatedBigPrimePatternCut probes r t i)
            (physicalMixedCoefficientTarget (repeatedBigPrimePatternCut probes r t i) k a s e).2) a *
        φ i a s e) f
end




end Bounty
end

section

/- The actual auxiliary-averaged mixed coefficient row preserves pending
symmetry when its signed phase observes the two active endpoints and the
store, promotion-slot and fresh-label data. The fixed initial exclusion is
applied to fresh births before the original auxiliary sum. -/

open Finset Classical
namespace Bounty

section
variable {S G : Type} [Fintype S] [Fintype G] [dG : DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Finset ℕ}
  [∀ g (p : P g), NeZero p.val] {J ell B : ℕ}
  (C : G → Finset (Fin J)) (k : ℤ)

noncomputable def physicalMixedCoefficientReindex
    (a : PhysicalAuxLabels P C)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val)) :=
  physicalSmallBigEventMemoryReindex (fun g (p : P g) => p.val)
    (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
    (fun d c g => physicalMixedEdgeDelta C k d c a g)
    (fun d c g => physicalMixedEdgeD C d c a g) s τ

noncomputable def physicalMixedCoefficientObservablePhase
    (a : PhysicalAuxLabels P C)
    (Φ : PhysicalBareResidueState Ps J ell → PhysicalBareResidueState Ps J ell →
      (∀ g, Fin (J + ell) → P g) → (∀ g, Fin (J + ell) → P g) →
      (∀ g, EdgeDrawObservation (P g) (physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) → ℂ) :=
  physicalSmallBigObservablePhase (fun g (p : P g) => p.val)
    (fun g => physicalFullSharedIndices (ell := ell) (C g)) B
    (fun d c g => physicalMixedEdgeDelta C k d c a g)
    (fun d c g => physicalMixedEdgeD C d c a g)
    (fun c => physicalMixedBigStep C k c a) Φ

omit dG in
theorem physical_mixed_coefficient_observable_reindex
    (a : PhysicalAuxLabels P C)
    (Φ : PhysicalBareResidueState Ps J ell → PhysicalBareResidueState Ps J ell →
      (∀ g, Fin (J + ell) → P g) → (∀ g, Fin (J + ell) → P g) →
      (∀ g, EdgeDrawObservation (P g) (physicalFullSharedIndices (ell := ell) (C g))ᶜ.card) → ℂ)
    (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
    (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val)) (e : PhysicalMixedCoefficientEvent C k a s) :
    physicalMixedCoefficientObservablePhase C k a Φ (s.1, productMemoryReindex s.2 τ)
      (physicalMixedCoefficientReindex C k a s τ e) =
      physicalMixedCoefficientObservablePhase C k a Φ s e :=
  physical_small_big_observable_phase_reindex _ _ B _ _ _ Φ s τ e

theorem physical_mixed_coefficient_signed_memory_symmetric
    (V : G → ℝ) (baseline : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (initial : ∀ g, Finset (P g))
    (Ψ : ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B)),
      PhysicalMixedCoefficientEvent C k a s → ℂ)
    (hΨ : ∀ a (s : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
      (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val)) (e : PhysicalMixedCoefficientEvent C k a s),
      Ψ a (s.1, productMemoryReindex s.2 τ) (physicalMixedCoefficientReindex C k a s τ e) = Ψ a s e)
    (f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ)
    (hf : ∀ s, ProductMemorySymmetric (fun x => f (s,x))) :
    ∀ s, ProductMemorySymmetric (fun x =>
      physicalMixedCoefficientAction C k V baseline ρ Vs q initial Ψ f (s,x)) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  intro s x g τ
  unfold physicalMixedCoefficientAction
  apply sum_congr rfl
  intro a _
  apply congrArg (fun z : ℂ => (physicalAuxMass V C a : ℂ) * z)
  have hphase : ∀ (y : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B))
      (σ : ∀ h, Equiv.Perm (Fin (y.2 h).2.1.val)) (e : PhysicalMixedCoefficientEvent C k a y),
      (if ∀ h i, ((physicalMixedCoefficientReindex C k a y σ e).2.2 h).2.2.2 i ∉ initial h then
        Ψ a (y.1, productMemoryReindex y.2 σ) (physicalMixedCoefficientReindex C k a y σ e) else 0) =
      (if ∀ h i, (e.2.2 h).2.2.2 i ∉ initial h then Ψ a y e else 0) := by
    intro y σ e
    change (if ∀ h i, (e.2.2 h).2.2.2 i ∉ initial h then
        Ψ a (y.1, productMemoryReindex y.2 σ) (physicalMixedCoefficientReindex C k a y σ e) else 0) = _
    rw [hΨ a y σ e]
  exact physical_small_big_full_signed_memory_symmetric _ _ B _ _ _ ρ V _ Vs q _ hphase f hf s x g τ







end
end Bounty
end

