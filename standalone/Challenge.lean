section
open Finset
/- Input damping counts every old pending zero, including repeated labels. -/
noncomputable def cleanMemoryInputWeight {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {N : G → ℕ} (ρ : ℝ)
    (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) : ℝ :=
  ∏ g, ρ ^ orderedPredicateCount (fixedOrderedResidueMemory p r g) unrestrictedResidueHit

/- Output damping includes the actual groupwise memory-sector cutoff. -/
noncomputable def cleanMemoryOutputWeight {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {N : G → ℕ} (ρ : ℝ) (B : G → ℕ)
    (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) : ℝ :=
  ∏ g, if N g ≤ B g then
    ρ ^ orderedPredicateCount (fixedOrderedResidueMemory p r g) unrestrictedResidueHit else 0

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  {P : G → Finset ℕ}
  {N : G → ℕ}

include G sharedInstance1 P N

/- The output factor is evaluated at the translated coordinates. No
residue-dependent multiplier needs to remain in the between-test kernel. -/
theorem clean_hybrid_memory_factor_split  (ρ : ℝ) (B : G → ℕ)
    (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) (Δ : ℤ) :
    cleanHybridMemoryFactor ρ B p r Δ = cleanMemoryInputWeight ρ p r *
      cleanMemoryOutputWeight ρ B p (fixedOrderedResidueTranslate p r Δ) := by
  unfold cleanHybridMemoryFactor cleanMemoryInputWeight cleanMemoryOutputWeight
  rw [← prod_mul_distrib]
  apply prod_congr rfl
  intro g _
  by_cases h : N g ≤ B g <;> simp only [h, if_true, if_false, mul_zero]

theorem clean_memory_input_weight_nonneg  {ρ : ℝ} (hρ : 0 ≤ ρ)
    (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) :
    0 ≤ cleanMemoryInputWeight ρ p r :=
  prod_nonneg (fun _ _ => pow_nonneg hρ _)

theorem clean_memory_output_weight_nonneg  {ρ : ℝ} (hρ : 0 ≤ ρ) (B : G → ℕ)
    (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) :
    0 ≤ cleanMemoryOutputWeight ρ B p r := by
  apply prod_nonneg
  intro g _
  split_ifs
  · exact pow_nonneg hρ _
  · exact le_rfl

theorem clean_memory_input_weight_le_one  {ρ : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) :
    cleanMemoryInputWeight ρ p r ≤ 1 :=
  prod_le_one₀ (fun _ _ => pow_nonneg hρ0 _) (fun _ _ => pow_le_one₀ hρ0 hρ1)

theorem clean_memory_output_weight_le_one  {ρ : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (B : G → ℕ) (p : FixedOrderedMemoryLabels P N) (r : FixedOrderedResidues p) :
    cleanMemoryOutputWeight ρ B p r ≤ 1 := by
  apply prod_le_one₀
  · intro g _
    split_ifs
    · exact pow_nonneg hρ0 _
    · exact le_rfl
  · intro g _
    split_ifs
    · exact pow_le_one₀ hρ0 hρ1
    · exact zero_le_one

end










end

