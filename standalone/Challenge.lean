theorem finite_sigma_outside_inside_disjoint  :
    Disjoint ((sᶜ).sigma B) (s.sigma (fun g => A g ∪ B g)) := by
  apply disjoint_left.mpr
  intro a ha hb
  exact (mem_compl.mp (mem_sigma.mp ha).1) (mem_sigma.mp hb).1

theorem finite_sigma_outside_inside_union  :
    (sᶜ).sigma B ∪ s.sigma (fun g => A g ∪ B g) = s.sigma A ∪ univ.sigma B := by
  ext a
  by_cases h : a.1 ∈ s <;> simp [h]

