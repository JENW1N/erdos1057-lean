    (τ : ∀ g, Equiv.Perm (Fin (s.2 g).2.1.val)) (e : CoupledGhostEvent M B s.2) :
    physicalSmallBigGhostBirthPhase M B φ (s.1, productMemoryReindex s.2 τ)
        (jointGhostMemoryReindex M B s.2 τ e) = physicalSmallBigGhostBirthPhase M B φ s e := rfl

theorem physical_small_big_ghost_birth_memory_symmetric
    {S G : Type*} [Fintype G] [DecidableEq G] {Ps : S → Finset ℕ}
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)]
