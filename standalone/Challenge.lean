/- Concrete uniform Lyapunov rows and their iteration for the original full mixed trajectories. -/

open Finset Classical

namespace Bounty

noncomputable def fullMixedLengthRowFactor {J K G : Type*} [Fintype G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v vmin : ℝ) (V : G → ℝ) (T : ℕ) :
    Option (J ⊕ K) → ℝ
  | none => 1
  | some (.inl j) => ∏ g, Real.exp ((|(1 - q j) * V g / ρ| * ∑ p, μ g p) * v)
  | some (.inr _) => unrestrictedEdgeRowBound ρ v vmin T ^ Fintype.card G

theorem fullMixedLengthRowFactor_nonneg {J K G : Type*} [Fintype G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v vmin : ℝ) (V : G → ℝ) (T : ℕ)
    (hρ : ρ < 1) (hv : 0 ≤ v) (tag : Option (J ⊕ K)) :
    0 ≤ fullMixedLengthRowFactor μ q ρ v vmin V T tag := by
  cases tag with
  | none => exact zero_le_one
  | some tag =>
    cases tag with
    | inl j => exact prod_nonneg fun _ _ => (Real.exp_pos _).le
    | inr k => exact pow_nonneg (unrestricted_edge_row_bound_nonneg hρ hv T) _

section Mixed
variable {J K G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Type*} [∀ g, Fintype (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)] {M : G → ℕ}
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → G → ℤ) (ω : ∀ k c, A k c → ℝ)
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v vmin : ℝ) (V : G → ℝ)

theorem full_permutation_mixed_length_row_le
    (hω : ∀ k c a, 0 ≤ ω k c a) (hωmass : ∀ k c, ∑ a, ω k c a ≤ 1)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (hq0 : ∀ j, 0 ≤ q j) (hq1 : ∀ j, q j ≤ 1)
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v) (hvmin : 0 < vmin)
    (hV : ∀ g, vmin ≤ V g)
    (hD : ∀ j, q j / ρ ^ 2 + ((1 - q j) / ρ) / v ≤ 1)
    (T : ℕ) (ht : ∀ k g, (S k g)ᶜ.card ≤ T)
    (tag : Option (J ⊕ K))
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    (∑ e : FullPermutationMixedEvent n S B A Δ D tag s,
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag s e| *
        productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D tag s e)) ≤
      fullMixedLengthRowFactor μ q ρ v vmin V T tag * productLengthLyapunov v s := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
    fullPermutationMixedEventFintype n S B A Δ D
  cases tag with
  | none =>
    have hm : (∑ e : FullPermutationMixedEvent (J := J) n S B A Δ D none s,
        fullActivePermutationWeight M e.down) = 1 :=
      ((Equiv.ulift : FullPermutationMixedEvent (J := J) n S B A Δ D none s ≃
        FullActiveSlotPermutations M).sum_comp (fullActivePermutationWeight M)).trans
          (fullActivePermutationWeight_mass M)
    change (∑ e : FullPermutationMixedEvent (J := J) n S B A Δ D none s,
      |fullActivePermutationWeight M e.down| * productLengthLyapunov v s) ≤ 1 * productLengthLyapunov v s
    simp_rw [abs_of_nonneg (fullActivePermutationWeight_nonneg M _)]
    rw [← sum_mul, hm]
  | some tag =>
    cases tag with
    | inl j =>
      have he := (Equiv.ulift : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s ≃
        CoupledGhostEvent M B s).sum_comp (fun e =>
          |coupledGhostJointEventWeight (fun g => physicalGhostRetention (n g) (q j) ρ)
            (fun g => physicalGhostTermination (n g) (q j) ρ)
            (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
            (fun g => unrestrictedResidueWeight (μ g)) M B s e| *
            productLengthLyapunov v (coupledGhostJointEventTarget M B s e))
      apply le_trans ?_ (coupled_physical_ghost_length_row_le n μ (q j) ρ v V hμ (hq0 j) (hq1 j)
        hρ0 (zero_lt_one.trans hv) (hD j) M B s)
      apply le_of_eq
      refine Eq.trans ?_ he
      apply sum_congr
      · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
      · intro e _
        rfl
    | inr k =>
      exact (full_active_edge_length_row_le n (S k) B (A k) (Δ k) (D k) (ω k) μ V
        (hω k) (hωmass k) hρ0 hρ1 hv hvmin hV hμ hmass T (ht k) s).trans_eq (mul_comm _ _)




end Mixed

