section

/- Exact packing into small-coordinate choices and original full big paths.
No pattern, auxiliary, permutation, or zero-weight event is removed. -/

open Finset
open scoped Classical
namespace Bounty
section Packing
variable {S G I V K : Type} [Fintype S]
  {Ps : S → Finset ℕ} {P : G → Type}
  (n : ∀ g, P g → ℕ) {J ell : ℕ} {M : G → ℕ}
  (shared : I → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : I → Type)
  (Δ D : ∀ _k : K, ∀ i, PhysicalSharedLists Ps J → SharedActiveLabels P (shared i) → A i → G → ℤ)
  (kbig : ∀ _k : K, ∀ i, SharedActiveLabels P (shared i) → A i → ℤ)

noncomputable def physicalMixedPathUnpack : ∀ ks r L x,
    FiniteEventPath (PhysicalMixedWordEvent (V := V) (ell := ell) n shared B A Δ D)
      (physicalMixedWordTarget n shared B A Δ D kbig) ks ((r, L), x) →
    Σ pl : PhysicalMixedSmallPlan (I := I) ks, PhysicalMixedPlannedBigPath n shared B A Δ D ks L pl x
  | [], _, _, _, _ => ⟨PUnit.unit, PUnit.unit⟩
  | none :: ks, r, L, x, ⟨⟨σ, τ⟩, p⟩ =>
      let z := physicalMixedPathUnpack ks r (physicalPermuteLabels σ L) (fullActivePermutation τ x) p
      ⟨(σ, z.1), ⟨ULift.up τ, z.2⟩⟩
  | some (.inl _) :: ks, r, L, x, ⟨e, p⟩ =>
      let z := physicalMixedPathUnpack ks r L (coupledGhostJointEventTarget M B x e) p
      ⟨z.1, ⟨ULift.up e, z.2⟩⟩
  | some (.inr k) :: ks, r, L, x, ⟨⟨i, a, ⟨R, ⟨_, e⟩⟩⟩, p⟩ =>
      let z := physicalMixedPathUnpack ks
        (physicalTranslateResidues r (kbig k i (productActiveMemorySplit (shared i) B x).1 a *
          (physicalSharedProduct (physicalSharedPrefix L) : ℕ))) R
        (fullActiveEdgeEventTarget n (shared i) B (fun _ => A i)
          (Δ k i (physicalSharedPrefix L)) (D k i (physicalSharedPrefix L)) x ⟨a, e⟩) p
      ⟨((i, R), z.1), ⟨⟨a, e⟩, z.2⟩⟩

noncomputable def physicalMixedPathPack : ∀ ks r L x,
    (Σ pl : PhysicalMixedSmallPlan (I := I) ks, PhysicalMixedPlannedBigPath n shared B A Δ D ks L pl x) →
    FiniteEventPath (PhysicalMixedWordEvent (V := V) (ell := ell) n shared B A Δ D)
      (physicalMixedWordTarget n shared B A Δ D kbig) ks ((r, L), x)
  | [], _, _, _, _ => PUnit.unit
  | none :: ks, r, L, x, ⟨(σ, pl), ⟨τ, p⟩⟩ =>
      ⟨(σ, τ.down), physicalMixedPathPack ks r (physicalPermuteLabels σ L)
        (fullActivePermutation τ.down x) ⟨pl, p⟩⟩
  | some (.inl _) :: ks, r, L, x, ⟨pl, ⟨e, p⟩⟩ =>
      ⟨e.down, physicalMixedPathPack ks r L
        (coupledGhostJointEventTarget M B x e.down) ⟨pl, p⟩⟩
  | some (.inr k) :: ks, r, L, x, ⟨((i, R), pl), ⟨⟨a, e⟩, p⟩⟩ =>
      ⟨⟨i, a, (R, ⟨(), e⟩)⟩, physicalMixedPathPack ks
        (physicalTranslateResidues r (kbig k i (productActiveMemorySplit (shared i) B x).1 a *
          (physicalSharedProduct (physicalSharedPrefix L) : ℕ))) R
        (fullActiveEdgeEventTarget n (shared i) B (fun _ => A i)
          (Δ k i (physicalSharedPrefix L)) (D k i (physicalSharedPrefix L)) x ⟨a, e⟩) ⟨pl, p⟩⟩

theorem physical_mixed_path_pack_unpack (ks : List (Option (V ⊕ K))) r L x
    (p : FiniteEventPath (PhysicalMixedWordEvent (ell := ell) n shared B A Δ D)
      (physicalMixedWordTarget n shared B A Δ D kbig) ks ((r, L), x)) :
    physicalMixedPathPack n shared B A Δ D kbig ks r L x
      (physicalMixedPathUnpack n shared B A Δ D kbig ks r L x p) = p := by
  induction ks generalizing r L x with
  | nil => cases p; rfl
  | cons tag ks ih =>
    cases tag with
    | none =>
      rcases p with ⟨⟨σ, τ⟩, p⟩
      simp only [physicalMixedPathUnpack, physicalMixedPathPack]
      erw [Sigma.eta, ih]
    | some tag =>
      cases tag with
      | inl j =>
        rcases p with ⟨e, p⟩
        simp only [physicalMixedPathUnpack, physicalMixedPathPack]
        erw [Sigma.eta, ih]
      | inr k =>
        rcases p with ⟨⟨i, a, R, u, e⟩, p⟩
        cases u
        simp only [physicalMixedPathUnpack, physicalMixedPathPack]
        erw [Sigma.eta, ih]

theorem physical_mixed_path_unpack_pack (ks : List (Option (V ⊕ K))) r L x
    (z : Σ pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks,
      PhysicalMixedPlannedBigPath n shared B A Δ D ks L pl x) :
    physicalMixedPathUnpack n shared B A Δ D kbig ks r L x
      (physicalMixedPathPack n shared B A Δ D kbig ks r L x z) = z := by
  induction ks generalizing r L x with
  | nil => rcases z with ⟨⟨⟩, ⟨⟩⟩; rfl
  | cons tag ks ih =>
    cases tag with
    | none =>
      rcases z with ⟨⟨σ, pl⟩, ⟨⟨τ⟩, p⟩⟩
      simp only [physicalMixedPathPack, physicalMixedPathUnpack]
      rw [ih]
    | some tag =>
      cases tag with
      | inl j =>
        rcases z with ⟨pl, ⟨⟨e⟩, p⟩⟩
        simp only [physicalMixedPathPack, physicalMixedPathUnpack]
        rw [ih]
      | inr k =>
        rcases z with ⟨⟨⟨i, R⟩, pl⟩, ⟨⟨a, e⟩, p⟩⟩
        simp only [physicalMixedPathPack, physicalMixedPathUnpack]
        rw [ih]

noncomputable def physicalMixedPathPackingEquiv (ks : List (Option (V ⊕ K))) r L x :
    FiniteEventPath (PhysicalMixedWordEvent (ell := ell) n shared B A Δ D)
      (physicalMixedWordTarget n shared B A Δ D kbig) ks ((r, L), x) ≃
    Σ pl : PhysicalMixedSmallPlan (I := I) ks, PhysicalMixedPlannedBigPath n shared B A Δ D ks L pl x where
  toFun := physicalMixedPathUnpack n shared B A Δ D kbig ks r L x
  invFun := physicalMixedPathPack n shared B A Δ D kbig ks r L x
  left_inv := physical_mixed_path_pack_unpack n shared B A Δ D kbig ks r L x
  right_inv := physical_mixed_path_unpack_pack n shared B A Δ D kbig ks r L x

end Packing
end Bounty
end

