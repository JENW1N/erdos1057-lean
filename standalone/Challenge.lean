/- Integrating the corrected pair sieve over all actual normalized assignments. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem exists_candidate_pair_sieve_bound :
    ∃ K : ℝ, 0 < K ∧ ∀ (c q θ : ℝ), 0 < c → 0 ≤ q → q ≤ 1 → 0 < θ →
      ∀ (r J : ℕ), θ < 2*c/(2 : ℝ)^J → (12/5 : ℝ)*(r : ℝ)*c/(2 : ℝ)^J ≤ 1/25 →
      ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ), J ≤ jStar →
      ∀ (a b s t : ℕ) (W : ℝ) (S : Finset (ℕ × ℕ)) (u : ℕ × ℕ → ℕ),
        a ≤ b → s ≤ t → 0 ≤ W → W ≤ Real.exp (θ*L) →
        (∀ v ∈ S, v.1*v.2 = 2*u v+1) →
        (∀ v ∈ S, v.1 ∈ Ioc a b ∧ v.2 ∈ Ioc s t) →
        (∀ v ∈ S, ∀ p ∈ primeBand 0 W, ¬p ∣ v.1*v.2) →
        (∑ v ∈ S, candidateCoefficient c L q r jStar (u v)) ≤
          (K * (((b : ℝ)-a)*((t : ℝ)-s)) *
              (∏ p ∈ primeBand 0 W, (1-1/(p : ℝ)))^2 *
              (∏ p ∈ primeBand 0 (Real.exp (θ*L)), (1-1/(p : ℝ))) *
              candidateOneMarkedHarmonicMass c L q +
            ((Real.exp (θ*L))^(10 : ℝ))^3 * (Real.exp ((1/20 : ℝ)*L))^2 +
            (((b : ℝ)-a)+((t : ℝ)-s))*((Real.exp (θ*L))^(10 : ℝ))^2 *
              Real.exp ((1/20 : ℝ)*L)) * candidateMicroQHarmonicMass c L r jStar J := by
  classical
  obtain ⟨K, hK, hsieve⟩ := exists_candidate_odd_shifted_divisor_pair_bound
  refine ⟨K, hK, ?_⟩
  intro c q θ hc hq0 hq1 hθ r J hcut hsize
  filter_upwards [hsieve c q hc hq0 hq1,
    eventually_candidate_coefficient_le_micro_assignment hc hq0 r J hcut,
    eventually_candidate_micro_assignment_size hc r J hsize,
    eventually_candidate_micro_assignment_total_weight hc r J hsize,
    eventually_candidate_micro_assignment_normalization hc,
    eventually_candidate_micro_assignment_primeFactors_range hc (show (6/5 : ℝ)*c ≤ 2*c by linarith),
    eventually_candidate_P_pool_prime_range hc hθ,
    eventually_ge_atTop (2 : ℝ)] with L hsi hmajor hds hmass hnorm hsupp hpool hL
  intro jStar hj a b s t W S u hab hst hW hWz hv hrect hrough
  let P := (candidatePIndices c L).biUnion (candidatePBand (c*L))
  let z := Real.exp (θ*L)
  let M := Real.exp ((1/20 : ℝ)*L)
  let N := candidateMicroAssignmentNormalization c L r J
  let A := K * (((b : ℝ)-a)*((t : ℝ)-s)) *
    (∏ p ∈ primeBand 0 W, (1-1/(p : ℝ)))^2 *
    (∏ p ∈ primeBand 0 z, (1-1/(p : ℝ))) * candidateOneMarkedHarmonicMass c L q
  let B := (z^(10 : ℝ))^3
  let C := (((b : ℝ)-a)+((t : ℝ)-s))*(z^(10 : ℝ))^2
  have hN : 0 < N := (hnorm r jStar J).1
  have hz : 1 < z := Real.one_lt_exp_iff.mpr (mul_pos hθ (by linarith))
  have hL1 : 1 ≤ L := by linarith
  have hL20 : L ≤ L^20 := by simpa using pow_le_pow_right₀ hL1 (show 1 ≤ 20 by omega)
  have hL220 : L^2 ≤ L^20 := pow_le_pow_right₀ hL1 (by omega)
  have hprime : ∀ p ∈ P, p.Prime := by
    intro p hp
    obtain ⟨g, _, hpg⟩ := mem_biUnion.mp hp
    exact (mem_filter.mp hpg).2
  have hP2 : 2 ∉ P := by
    intro hp
    have h := (hpool 2 hp).1
    norm_num at h
    linarith
  have hPz : P ⊆ primeBand 0 z := by
    intro p hp
    exact (mem_primeBand_iff le_rfl (Real.exp_pos _).le p).mpr
      ⟨hprime p hp, Nat.cast_pos.mpr (hprime p hp).pos, (hpool p hp).2⟩
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hC : 0 ≤ C := by
    have hx : 0 ≤ (b : ℝ)-a := sub_nonneg.mpr (Nat.cast_le.mpr hab)
    have hy : 0 ≤ (t : ℝ)-s := sub_nonneg.mpr (Nat.cast_le.mpr hst)
    dsimp [C]
    positivity
  have hpoint (x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i) :
      (∑ v ∈ S, primeAssignmentTerm P q z N (u v)
        (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x)) ≤
      (1/N) * (A / (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x : ℝ) +
        B*(orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x : ℝ)+C) := by
    let D := orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x
    have hD : D ≠ 0 := candidate_micro_assignment_product_ne_zero c L r jStar J x
    have hDL : (D : ℝ) ≤ Real.exp L := (hds jStar x).trans (Real.exp_le_exp.mpr (by linarith))
    have hmin : ∀ p ∈ D.primeFactors, L^2 ≤ (p : ℝ) := fun p hp =>
      hL220.trans (hsupp r jStar J x p hp).1.le
    have hPm : ∀ p ∈ P \ D.primeFactors, ¬p ∣ D := by
      intro p hp hpd
      exact (mem_sdiff.mp hp).2 ((hprime p (mem_sdiff.mp hp).1).mem_primeFactors hpd hD)
    have he := @hsi a b s t D ⟨hD⟩ W z (P \ D.primeFactors) hDL hmin hab hst hW hWz hz
      (sdiff_subset) (fun p hp => hPz (mem_sdiff.mp hp).1) hPm
      (fun hp => hP2 (mem_sdiff.mp hp).1)
    have ht := sum_prime_assignment_le_odd_pair_sum P hprime hP2 hq0 hN.le (show 0 ≤ z from (Real.exp_pos (θ*L)).le)
      a b s t D S u hv hrect hrough
    refine ht.trans ((mul_le_mul_of_nonneg_left he (by positivity)).trans_eq ?_)
    dsimp [A, B, C, D]
    ring
  have hsum : (∑ v ∈ S, candidateCoefficient c L q r jStar (u v)) ≤
      ∑ x : ∀ i, candidateMicroAssignmentChoices c L r jStar J i,
        ∑ v ∈ S, primeAssignmentTerm P q z N (u v)
          (orderedSlotProduct (candidateMicroAssignmentChoices c L r jStar J) x) := by
    calc
      _ ≤ ∑ v ∈ S, candidateMicroAssignmentMajorant c L q r jStar J z (u v) :=
        sum_le_sum (fun v _ => hmajor jStar hj (u v))
      _ = _ := by unfold candidateMicroAssignmentMajorant; rw [sum_comm]
  refine hsum.trans ((sum_le_sum (fun x _ => hpoint x)).trans ?_)
  exact candidate_assignment_error_sum c L r jStar J hB hC (Real.exp_pos _).le hN.le
    (hds jStar) (hnorm r jStar J).2 (hmass jStar)

