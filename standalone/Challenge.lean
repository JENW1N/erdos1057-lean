  (w : PhysicalSelectedData P ell C → ℂ)

noncomputable def physicalOriginalWeightedMoment
    (f : PhysicalFullBoundedState P J ell B → ℂ) (x : PhysicalFullBoundedState P J ell B) : ℂ :=
