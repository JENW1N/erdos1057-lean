/- Exact divisor/cofactor reindexing of full ambient shifted-product pair sums. -/

open Finset

namespace Bounty

theorem shifted_pair_index_of_dvd {p u : ℕ} (hd : p ∣ 2*u+1) :
    shiftedPairIndex (p,(2*u+1)/p) = u := by
  unfold shiftedPairIndex
  dsimp only
  rw [Nat.mul_div_cancel' hd]
  omega










theorem sum_shifted_factor_pairs {M : Type*} [AddCommMonoid M]
    (T : Finset ℕ) (F : ℕ × ℕ → M) :
    (∑ v ∈ shiftedFactorPairs T, F v) =
      ∑ u ∈ T, ∑ p ∈ (2*u+1).divisors, F (p,(2*u+1)/p) := by
  classical
  have hprod (u : ℕ) (v : ℕ × ℕ)
      (hv : v ∈ (2*u+1).divisors.image (fun p => (p,(2*u+1)/p))) :
      v.1*v.2 = 2*u+1 := by
    obtain ⟨p,hp,rfl⟩ := mem_image.mp hv
    exact Nat.mul_div_cancel' (Nat.mem_divisors.mp hp).1
  have hd : Set.PairwiseDisjoint (↑T) (fun u =>
      (2*u+1).divisors.image (fun p => (p,(2*u+1)/p))) := by
    intro u hu w hw huw
    apply disjoint_left.mpr
    intro v hvu hvw
    have h1 := hprod u v hvu
    have h2 := hprod w v hvw
    exact huw (by omega)
  unfold shiftedFactorPairs
  rw [sum_biUnion hd]
  apply sum_congr rfl
  intro u hu
  rw [sum_image]
  intro p hp q hq hpq
  exact congrArg Prod.fst hpq










