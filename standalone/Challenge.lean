/- Uniform per-block cancellation with arbitrary real product-window cutoffs. -/

open Finset Filter

namespace Bounty

theorem eventually_product_window_block_power_saving {a eta theta H C : ℝ}
    (ha : 0 < a) (heta : 0 < eta) (htheta : theta < 1/2)
    (hH : 0 ≤ H) (hC : 0 ≤ C) (B : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ P U R : ℝ,
      Real.exp (a*L) ≤ P → Real.exp (a*L) ≤ U → U ≤ 32*Real.exp L →
      P*U ≤ C*Real.exp L → Real.exp (eta*L) ≤ R → R ≤ Real.exp (theta*L) →
      ∀ (Q S T : Finset ℕ),
        (∀ q ∈ Q, R/2 ≤ (q : ℝ)) → (∀ q ∈ Q, (q : ℝ) ≤ R) →
        (∀ m ∈ S, 0 < m) → (∀ n ∈ T, 0 < n) →
        (∀ m ∈ S, (m : ℝ) ≤ P) → (∀ n ∈ T, (n : ℝ) ≤ U) →
        ∀ α β : ℕ → ℂ,
          (∀ m ∈ S, ‖α m‖ ≤ Real.exp (H*Real.sqrt L)) →
          (∀ n ∈ T, ‖β n‖ ≤ Real.exp (H*Real.sqrt L)) →
          ∀ A Z : ℝ, 0 ≤ A → 0 ≤ Z →
            (∑ q ∈ Q, 1/(q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q,
              ‖∑ m ∈ S, ∑ n ∈ T.filter (fun n : ℕ =>
                A < (m : ℝ)*(n : ℝ) ∧ (m : ℝ)*(n : ℝ) ≤ Z),
                α m * β n * χ ((m*n : ℕ) : ZMod q)‖) ≤
              Real.exp L * L^(-B) := by
  have hdecay := eventually_large_sieve_subexponential_energy_bound ha heta htheta
    (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) hH)
    (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) hC) 3 B
  filter_upwards [hdecay, eventually_window_dyadic_prefix_cost,
    eventually_ge_atTop (0 : ℝ), eventually_ge_atTop (4*(6 + 8*Real.pi))]
      with L hdecayL hcostL hL hprefL
  intro P U R hP hU hUHi hPU hRLo hRHi Q S T hQD hQR hSpos hTpos hS hT α β hα hβ A Z hA hZ
  have hP0 : 0 ≤ P := (Real.exp_pos _).le.trans hP
  have hU0 : 0 ≤ U := (Real.exp_pos _).le.trans hU
  have hU1 : 1 ≤ U := (Real.one_le_exp_iff.mpr (mul_nonneg ha.le hL)).trans hU
  have hR1 : 1 ≤ R := (Real.one_le_exp_iff.mpr (mul_nonneg heta.le hL)).trans hRLo
  have hR0 : 0 < R := zero_lt_one.trans_le hR1
  let K := ⌊U⌋₊.log2 + 1
  obtain ⟨hprefix, hcol⟩ := finite_nat_dyadic_prefix hU1 T hT
  have hK : (K + 1 : ℝ) ≤ L^2 := by
    simpa only [K, Nat.cast_add, Nat.cast_one] using hcostL U hU1 hUHi
  have hEa := positive_nat_finset_exponential_energy_le S α hP0 hSpos hS hα
  have hEb := positive_nat_finset_exponential_energy_le T β hU0 hTpos hT hβ
  have hEb' : (∑ n ∈ T, ‖β n‖^2) ≤ (2*U)*Real.exp ((2*H)*Real.sqrt L) := by
    exact hEb.trans (mul_le_mul_of_nonneg_right (by linarith) (Real.exp_nonneg _))
  have hV : Real.exp (a*L) ≤ 2*U := hU.trans (by linarith)
  have hPV : P*(2*U) ≤ (2*C)*Real.exp L := by nlinarith
  have hnumeric := hdecayL P (2*U) R (∑ m ∈ S, ‖α m‖^2) (∑ n ∈ T, ‖β n‖^2)
    hP hV hPV hRLo hRHi (sum_nonneg (fun _ _ => sq_nonneg _)) hEa hEb'
  have hwindow := multiplicative_large_sieve_product_window_real Q
    (show 0 < R/2 by positivity) hR1 hQD hQR hA hZ K S T hSpos hprefix α β
    hP0 (by positivity : 0 ≤ 2*U) hS hcol
  calc
    _ ≤ 2*(K + 1 : ℝ)*((6 + 8*Real.pi)/(R/2)) *
        Real.sqrt ((P + R^2)*(2*U + R^2)*(∑ m ∈ S, ‖α m‖^2)*∑ n ∈ T, ‖β n‖^2) := hwindow
    _ ≤ (L^3/R) *
        Real.sqrt ((P + R^2)*(2*U + R^2)*(∑ m ∈ S, ‖α m‖^2)*∑ n ∈ T, ‖β n‖^2) :=
      mul_le_mul_of_nonneg_right (window_dyadic_prefactor_le K hR0 hK hprefL) (Real.sqrt_nonneg _)
    _ ≤ _ := by
      rw [show (3 : ℝ) = ((3 : ℕ) : ℝ) by norm_num, Real.rpow_natCast] at hnumeric
      exact hnumeric

end Bounty

end

