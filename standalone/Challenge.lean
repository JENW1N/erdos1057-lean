/- Any fixed multiple of the modulus logarithm is eventually absorbed by an
arbitrarily small positive increase in its power exponent. -/
theorem eventually_mul_rpow_log_five_mul_le_rpow (δ : ℝ) {σ : ℝ}
    (hσ : 0 < σ) (d : ℝ) :
    ∀ᶠ y : ℝ in atTop, d * y ^ δ * Real.log (5 * y) ≤ y ^ (δ + σ) := by
  filter_upwards [eventually_mul_rpow_log_add_le_rpow (a := 0) (b := σ)
    (c := 1) hσ hσ zero_lt_one d (d * Real.log 5), eventually_gt_atTop (0 : ℝ)]
    with y h hy
  have hlog : d * Real.log (5 * y) ≤ y ^ σ := by
    rw [Real.log_mul (by norm_num) (ne_of_gt hy)]
    simp only [Real.rpow_zero, mul_one, one_mul] at h
    nlinarith
  calc
    d * y ^ δ * Real.log (5 * y) = y ^ δ * (d * Real.log (5 * y)) := by ring
    _ ≤ y ^ δ * y ^ σ := mul_le_mul_of_nonneg_left hlog (Real.rpow_nonneg hy.le _)
    _ = y ^ (δ + σ) := (Real.rpow_add hy δ σ).symm

/- The threshold is uniform in the natural number whose logarithm is bounded.
The result also holds at `q = 0`, under Mathlib's total logarithm conventions. -/
theorem eventually_log_natLog_le_rpow (δ : ℝ) {σ : ℝ} (hσ : 0 < σ) :
    ∀ᶠ y : ℝ in atTop, ∀ q : ℕ,
      Real.log (q : ℝ) ≤ y ^ δ * Real.log (5 * y) →
      Real.log (q : ℝ) ≤ y ^ (δ + σ) ∧
      (Nat.log 2 q : ℝ) ≤ y ^ (δ + σ) := by
  filter_upwards [eventually_mul_rpow_log_five_mul_le_rpow δ hσ 1,
    eventually_mul_rpow_log_five_mul_le_rpow δ hσ (1 / Real.log 2)] with y hreal hbase
  intro q hlog
  have hlog2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  refine ⟨hlog.trans (by simpa only [one_mul] using hreal), ?_⟩
  calc
    (Nat.log 2 q : ℝ) ≤ Real.logb 2 (q : ℝ) := by
      simpa using Real.natLog_le_logb q 2
    _ = Real.log (q : ℝ) / Real.log 2 := rfl
    _ ≤ (y ^ δ * Real.log (5 * y)) / Real.log 2 :=
      div_le_div_of_nonneg_right hlog hlog2.le
    _ = (1 / Real.log 2) * y ^ δ * Real.log (5 * y) := by ring
    _ ≤ y ^ (δ + σ) := hbase

theorem log_card_zmod_units_le {L : ℕ} (hL : 0 < L) :
    Real.log (Nat.card (ZMod L)ˣ : ℝ) ≤ Real.log (L : ℝ) := by
  let : NeZero L := ⟨ne_of_gt hL⟩
  apply Real.log_le_log
  · exact_mod_cast (Nat.card_pos (α := (ZMod L)ˣ))
  · exact_mod_cast card_zmod_units_le hL

/- A single threshold bounds both logarithms of every unit group of every
positive modulus satisfying the smooth-modulus estimate. -/
theorem eventually_unitGroup_log_natLog_le_rpow (δ : ℝ) {σ : ℝ} (hσ : 0 < σ) :
    ∀ᶠ y : ℝ in atTop, ∀ L : ℕ, 0 < L →
      Real.log (L : ℝ) ≤ y ^ δ * Real.log (5 * y) →
      Real.log (Nat.card (ZMod L)ˣ : ℝ) ≤ y ^ (δ + σ) ∧
      (Nat.log 2 (Nat.card (ZMod L)ˣ) : ℝ) ≤ y ^ (δ + σ) := by
  filter_upwards [eventually_log_natLog_le_rpow δ hσ] with y hy
  intro L hL hlog
  exact hy _ ((log_card_zmod_units_le hL).trans hlog)
end

