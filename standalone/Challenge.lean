section

/- The actual active-slot Fourier phase separates into unit prime-slot twists. -/

open Finset MeasureTheory

namespace Bounty

noncomputable def activeAllocationFrequencyInput {N : ℕ}
    (active : Fin N → Bool) (s : Fin N → ℝ)
    (ξ : ActiveAllocationIndex active → ℝ) (i : Fin N) : ℝ :=
  if hi : active i = true then 2 * Real.pi * ξ ⟨i, hi⟩ / s i else 0

theorem active_allocation_frequency_sum {N : ℕ} (R : ℝ)
    (v s : Fin N → ℝ) (active take : Fin N → Bool)
    (ξ : ActiveAllocationIndex active → ℝ) :
    (∑ i, activeAllocationFrequencyInput active s ξ i *
      (orderedSlotResidual R (fun j => if take j then 1 else 0) v i - v i)) =
      2 * Real.pi * ∑ i : ActiveAllocationIndex active,
        ξ i * ((allocationPrefixResidual v R take i.val - v i.val) / s i.val) := by
  classical
  simp_rw [← allocation_prefix_eq_ordered_residual]
  calc
    _ = ∑ i ∈ univ.filter (fun i => active i = true),
        activeAllocationFrequencyInput active s ξ i *
          (allocationPrefixResidual v R take i - v i) := by
      rw [sum_filter]
      apply sum_congr rfl
      intro i hi
      by_cases ha : active i = true
      · simp [ha]
      · simp [activeAllocationFrequencyInput, ha]
    _ = ∑ i : ActiveAllocationIndex active,
        activeAllocationFrequencyInput active s ξ i.val *
          (allocationPrefixResidual v R take i.val - v i.val) := sum_subtype _ (by simp) _
    _ = _ := by
      rw [mul_sum]
      apply sum_congr rfl
      intro i hi
      simp only [activeAllocationFrequencyInput, i.property, dite_true]
      ring

theorem active_allocation_integrand_phase {N : ℕ} (A R : ℝ)
    (v s : Fin N → ℝ) (active take : Fin N → Bool)
    (ξ : ActiveAllocationIndex active → ℝ) :
    activeAllocationFourierIntegrand A R v s active take ξ =
      Complex.exp (Complex.I * ((2 * Real.pi * ∑ i : ActiveAllocationIndex active,
        ξ i * ((allocationPrefixResidual v R take i.val - v i.val) / s i.val) : ℝ) : ℂ)) *
          activeAllocationFourierWeight A active take ξ := by
  simp only [activeAllocationFourierIntegrand, activeAllocationFourierWeight,
    typeIICutoffFourierIntegrand, prod_mul_distrib]
  rw [← Complex.exp_sum]
  congr 2
  simp only [mul_sum, Complex.ofReal_sum]
  apply sum_congr rfl
  intro i hi
  push_cast
  ring




theorem active_allocation_prime_powers_separated {N : ℕ} (A R : ℝ)
    (p s : Fin N → ℝ) (hp : ∀ i, 0 < p i) (active take : Fin N → Bool)
    (ξ : ActiveAllocationIndex active → ℝ) :
    activeAllocationFourierIntegrand A R (fun i => Real.log (p i)) s active take ξ =
      (Complex.exp (Complex.I * ((R * ∑ i, activeAllocationFrequencyInput active s ξ i : ℝ) : ℂ)) *
        ∏ j, (p j : ℂ) ^ ((orderedSlotFrequency (fun i => if take i then 1 else 0)
          (activeAllocationFrequencyInput active s ξ) j : ℂ) * Complex.I)) *
            activeAllocationFourierWeight A active take ξ := by
  rw [active_allocation_integrand_phase, ← active_allocation_frequency_sum,
    ordered_slot_prime_power_separation R _ p _ hp]




theorem active_allocation_inactive_frequency_zero {N : ℕ}
    (active take : Fin N → Bool) (s : Fin N → ℝ)
    (ξ : ActiveAllocationIndex active → ℝ) (i : Fin N)
    (ha : active i = false) (ht : take i = false) :
    orderedSlotFrequency (fun j => if take j then 1 else 0)
      (activeAllocationFrequencyInput active s ξ) i = 0 := by
  simp [orderedSlotFrequency, activeAllocationFrequencyInput, ha, ht]




end Bounty

