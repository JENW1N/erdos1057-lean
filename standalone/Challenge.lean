section

/- Exact and asymptotic normalized strict Buchstab recursions on logarithmic cells. -/

open Finset Filter

namespace Bounty

noncomputable def logarithmicCellCountScale (L S Y : ℝ) : ℝ :=
  (Real.exp (L ^ (-S)) * Y - Y) / L

noncomputable def normalizedRoughCellCount (L S Y z : ℝ) : ℝ :=
  ((roughBand Y (Real.exp (L ^ (-S)) * Y) z).card : ℝ) / logarithmicCellCountScale L S Y

noncomputable def normalizedPrimeCellCount (L S Y : ℝ) : ℝ :=
  ((primeBand Y (Real.exp (L ^ (-S)) * Y)).card : ℝ) / logarithmicCellCountScale L S Y

theorem logarithmic_cell_count_scale_pos {L S Y : ℝ} (hL : 0 < L) (hY : 0 < Y) :
    0 < logarithmicCellCountScale L S Y := by
  unfold logarithmicCellCountScale
  apply div_pos _ hL
  have hδ : 0 < L ^ (-S) := Real.rpow_pos_of_pos hL _
  have he : 1 < Real.exp (L ^ (-S)) := by
    simpa only [Real.exp_zero] using Real.exp_lt_exp.mpr hδ
  nlinarith

theorem logarithmic_cell_count_scale_div (L S Y t : ℝ) :
    logarithmicCellCountScale L S (Y / t) = logarithmicCellCountScale L S Y / t := by
  unfold logarithmicCellCountScale
  simp only [div_eq_mul_inv]
  ring

theorem logarithmic_cell_small_prime_bound {L S Y : ℝ}
    (hY : Real.exp (L ^ (-S)) ≤ Y) {p : ℕ}
    (hp : (p : ℝ) ≤ Real.sqrt (Real.exp (L ^ (-S)) * Y)) : (p : ℝ) ≤ Y := by
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have hB : Real.exp (L ^ (-S)) * Y ≤ Y ^ 2 := by nlinarith
  exact hp.trans ((Real.sqrt_le_iff).mpr ⟨hY0.le, hB⟩)

theorem normalized_buchstab_cell_remainder_identity {L S Y z : ℝ}
    (hL : 0 < L) (hY : Real.exp (L ^ (-S)) ≤ Y) (hz : 0 < z) (hzY : z ≤ Y) :
    normalizedRoughCellCount L S Y z - normalizedPrimeCellCount L S Y -
      (∑ p ∈ primeBand z (Real.sqrt (Real.exp (L ^ (-S)) * Y)),
        normalizedRoughCellCount L S (Y / (p : ℝ)) (p : ℝ) / (p : ℝ)) =
      ((strictBuchstabRemainder Y (Real.exp (L ^ (-S)) * Y) z).card : ℝ) /
        logarithmicCellCountScale L S Y := by
  classical
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have hscale := logarithmic_cell_count_scale_pos (S := S) hL hY0
  have hδ : 0 < L ^ (-S) := Real.rpow_pos_of_pos hL _
  have hY1 : 1 ≤ Y := (Real.one_le_exp hδ.le).trans hY
  have hB : 0 ≤ Real.exp (L ^ (-S)) * Y := by positivity
  have hcount : ((roughBand Y (Real.exp (L ^ (-S)) * Y) z).card : ℝ) =
      ((primeBand (max Y z) (Real.exp (L ^ (-S)) * Y)).card : ℝ) +
      (∑ p ∈ primeBand z (Real.sqrt (Real.exp (L ^ (-S)) * Y)),
        ((roughBand (max 1 (Y / (p : ℝ)))
          ((Real.exp (L ^ (-S)) * Y) / (p : ℝ)) (p : ℝ)).card : ℝ)) +
      ((strictBuchstabRemainder Y (Real.exp (L ^ (-S)) * Y) z).card : ℝ) := by
    exact_mod_cast strict_buchstab_count_with_remainder hY1 hB hz.le
  rw [max_eq_left hzY] at hcount
  have hcofactor : ∀ p ∈ primeBand z (Real.sqrt (Real.exp (L ^ (-S)) * Y)),
      ((roughBand (max 1 (Y / (p : ℝ)))
        ((Real.exp (L ^ (-S)) * Y) / (p : ℝ)) (p : ℝ)).card : ℝ) /
          logarithmicCellCountScale L S Y =
        normalizedRoughCellCount L S (Y / (p : ℝ)) (p : ℝ) / (p : ℝ) := by
    intro p hp
    obtain ⟨hpp, _, hpB⟩ := (mem_primeBand_iff hz.le (Real.sqrt_nonneg _) p).mp hp
    have hp0 : (0 : ℝ) < p := Nat.cast_pos.mpr hpp.pos
    have hpY : (p : ℝ) ≤ Y := logarithmic_cell_small_prime_bound hY hpB
    have hquot : 1 ≤ Y / (p : ℝ) := (le_div_iff₀ hp0).mpr (by simpa using hpY)
    rw [max_eq_right hquot, mul_div_assoc]
    unfold normalizedRoughCellCount
    rw [logarithmic_cell_count_scale_div]
    field_simp
  have hnorm := congrArg (fun t : ℝ => t / logarithmicCellCountScale L S Y) hcount
  rw [add_div, add_div, sum_div] at hnorm
  have hsum :
      (∑ p ∈ primeBand z (Real.sqrt (Real.exp (L ^ (-S)) * Y)),
        ((roughBand (max 1 (Y / (p : ℝ)))
          ((Real.exp (L ^ (-S)) * Y) / (p : ℝ)) (p : ℝ)).card : ℝ) /
            logarithmicCellCountScale L S Y) =
      ∑ p ∈ primeBand z (Real.sqrt (Real.exp (L ^ (-S)) * Y)),
        normalizedRoughCellCount L S (Y / (p : ℝ)) (p : ℝ) / (p : ℝ) := sum_congr rfl hcofactor
  rw [hsum] at hnorm
  change ((roughBand Y (Real.exp (L ^ (-S)) * Y) z).card : ℝ) / logarithmicCellCountScale L S Y -
    ((primeBand Y (Real.exp (L ^ (-S)) * Y)).card : ℝ) / logarithmicCellCountScale L S Y - _ = _
  linarith

theorem normalized_rough_cell_count_nonneg {L S Y z : ℝ} (hL : 0 < L) (hY : 0 < Y) :
    0 ≤ normalizedRoughCellCount L S Y z :=
  div_nonneg (Nat.cast_nonneg _) (logarithmic_cell_count_scale_pos hL hY).le




theorem eventually_normalized_buchstab_cell_error {a γ₀ S : ℝ}
    (ha : 0 < a) (hγ₀ : 0 < γ₀) (hS : 0 ≤ S) (Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ γ : ℝ, γ₀ ≤ γ → ∀ Y : ℝ, Real.exp (a * L) ≤ Y →
      Real.exp (γ * L) ≤ Y →
      0 ≤ normalizedRoughCellCount L S Y (Real.exp (γ * L)) - normalizedPrimeCellCount L S Y -
        (∑ p ∈ primeBand (Real.exp (γ * L)) (Real.sqrt (Real.exp (L ^ (-S)) * Y)),
          normalizedRoughCellCount L S (Y / (p : ℝ)) (p : ℝ) / (p : ℝ)) ∧
      normalizedRoughCellCount L S Y (Real.exp (γ * L)) - normalizedPrimeCellCount L S Y -
        (∑ p ∈ primeBand (Real.exp (γ * L)) (Real.sqrt (Real.exp (L ^ (-S)) * Y)),
          normalizedRoughCellCount L S (Y / (p : ℝ)) (p : ℝ) / (p : ℝ)) ≤ L ^ (-Bsave) := by
  filter_upwards [eventually_rough_logarithmic_cell_squarefree_count_error hγ₀ hS Bsave,
    eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (1 / a)] with L hbad hL1 hLa
  intro γ hγ Y hY hzY
  have hL : 0 < L := zero_lt_one.trans_le hL1
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  have haL : 1 ≤ a * L := by
    have h := (div_le_iff₀ ha).mp hLa
    nlinarith
  have hδ : L ^ (-S) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hL1 (neg_nonpos.mpr hS)
  have hcellY : Real.exp (L ^ (-S)) ≤ Y :=
    (Real.exp_le_exp.mpr (hδ.trans haL)).trans hY
  rw [normalized_buchstab_cell_remainder_identity hL hcellY (Real.exp_pos _) hzY]
  have hscale := logarithmic_cell_count_scale_pos (S := S) hL hY0
  refine ⟨div_nonneg (Nat.cast_nonneg _) hscale.le, ?_⟩
  apply (div_le_iff₀ hscale).mpr
  have hY1 : 1 ≤ Y := (Real.one_le_exp (mul_nonneg ha.le hL.le)).trans hY
  have hrem : ((strictBuchstabRemainder Y (Real.exp (L ^ (-S)) * Y) (Real.exp (γ * L))).card : ℝ) ≤
      (((roughBand Y (Real.exp (L ^ (-S)) * Y) (Real.exp (γ * L))).filter
        (fun n => ¬ Squarefree n)).card : ℝ) := by
    exact_mod_cast card_le_card (strict_buchstab_remainder_subset_nonsquarefree hY1)
  have herror := hbad γ hγ Y hY0.le
  rw [rough_band_squarefree_count_error] at herror
  exact hrem.trans herror

end Bounty


end

section

/- At a retained small prefix, the big action is the literal full capped
edge event sum. Its displacement and residue translation depend only on the
retained big labels and fixed auxiliary data. -/

open Finset Classical

namespace Bounty

section

variable {S G : Type*} [Fintype S] [Fintype G] [DecidableEq G]
  {Ps : S → Finset ℕ} {P : G → Type*} [∀ g, Fintype (P g)]
  (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
  {J : ℕ} {M : G → ℕ} (shared : ∀ g, Finset (Fin (M g))) (B : ℕ)
  (Δ D : PhysicalSharedLists Ps J → SharedActiveLabels P shared → G → ℤ)
  (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
  (kbig : SharedActiveLabels P shared → ℤ)

abbrev PhysicalSmallBigFullEvent (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :=
  FullActiveEdgeEvent n shared B (fun _ => Unit) (fun c _ => Δ d c) (fun c _ => D d c) x

noncomputable def physicalSmallBigFullTarget (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : PhysicalSmallBigFullEvent n shared B Δ D d x) :=
  fullActiveEdgeEventTarget n shared B (fun _ => Unit) (fun c _ => Δ d c) (fun c _ => D d c) x e

noncomputable def physicalSmallBigFullCoefficient
    (Ψ : ∀ d x, PhysicalResidues Ps → PhysicalSmallBigFullEvent n shared B Δ D d x → ℂ)
    (r : PhysicalResidues Ps) (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : PhysicalSmallBigFullEvent n shared B Δ D d x) : ℂ :=
  (fullActiveEdgeEventWeight n shared B (fun _ => Unit) (fun c _ => Δ d c) (fun c _ => D d c)
    (fun _ _ => 1) μ ρ V x e : ℂ) * Ψ d x r e

omit [∀ g p, NeZero (n g p)] in
/- This is an identity of the actual finite event sums, including both
memory cutoffs and any bounded source/event-dependent coefficient. -/
theorem physical_small_big_full_prefix_eq
    (Ψ : ∀ d x, PhysicalResidues Ps → PhysicalSmallBigFullEvent n shared B Δ D d x → ℂ)
    (F : PhysicalSharedLists Ps J →
      ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → PhysicalResidues Ps → ℂ)
    (d : PhysicalSharedLists Ps J)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (r : PhysicalResidues Ps) :
    physicalSmallBigPrefixAction (PhysicalSmallBigFullEvent n shared B Δ D)
      (physicalSmallBigFullTarget n shared B Δ D)
      (physicalSmallBigFullCoefficient n shared B Δ D μ ρ V Ψ)
      (fun y => kbig (productActiveMemorySplit shared B y).1) F d x r =
    fullActiveExternalCoefficientAction n shared B (fun _ => Unit)
      (fun c _ => Δ d c) (fun c _ => D d c) (fun _ _ => 1) μ ρ V
      (fun c _ => physicalResidueTranslationEquiv (P := Ps)
        (kbig c * (physicalSharedProduct d : ℕ))) (Ψ d) (F d) x r := by
  rfl

variable [∀ p : PhysicalPrime Ps, NeZero p.2.val]

theorem physical_small_big_full_prefix_energy_le
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (shared g)ᶜ.card ≤ T)
    (Ψ : ∀ d x, PhysicalResidues Ps → PhysicalSmallBigFullEvent n shared B Δ D d x → ℂ)
    (H : ℝ) (hH : 0 ≤ H) (hΨ : ∀ d x r e, ‖Ψ d x r e‖ ≤ H)
    (F : PhysicalSharedLists Ps J →
      ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → PhysicalResidues Ps → ℂ)
    (hF : ∀ d r, ProductMemorySymmetric (fun x => F d x r)) :
    physicalSmallBigConditionEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (physicalSmallBigPrefixAction (PhysicalSmallBigFullEvent n shared B Δ D)
        (physicalSmallBigFullTarget n shared B Δ D)
        (physicalSmallBigFullCoefficient n shared B Δ D μ ρ V Ψ)
        (fun y => kbig (productActiveMemorySplit shared B y).1) F) ≤
      H ^ 2 * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        physicalSmallBigConditionEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g))) F := by
  unfold physicalSmallBigConditionEnergy
  rw [mul_sum]
  apply sum_le_sum
  intro d hd
  simp_rw [physical_small_big_full_prefix_eq]
  exact full_active_external_coefficient_energy_le n shared B (fun _ => Unit)
    (fun c _ => Δ d c) (fun c _ => D d c) (fun _ _ => 1) μ ρ V
    (fun c _ => physicalResidueTranslationEquiv (P := Ps) (kbig c * (physicalSharedProduct d : ℕ)))
    (by intros; exact zero_le_one) (by intro c; simp only [Fintype.sum_unique, le_refl])
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht (Ψ d) H hH (hΨ d) (F d) (hF d)

theorem physical_small_big_conditioned_full_prefix_energy_le [DecidableEq S]
    {ell : ℕ} (Vs : S → ℝ) (q : ℝ)
    {v vmin vmax : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hVlo : ∀ g, vmin ≤ V g) (hVhi : ∀ g, V g ≤ vmax)
    (hμ : ∀ g p, 0 ≤ μ g p) (hmass : ∀ g, ∑ p, μ g p ≤ 2)
    (T : ℕ) (ht : ∀ g, (shared g)ᶜ.card ≤ T)
    (Ψ : ∀ d x, PhysicalResidues Ps → PhysicalSmallBigFullEvent n shared B Δ D d x → ℂ)
    (H : ℝ) (hH : 0 ≤ H) (hΨ : ∀ d x r e, ‖Ψ d x r e‖ ≤ H)
    (F : PhysicalSmallBigState Ps J ell
      (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) → ℂ)
    (hF : ∀ s, ProductMemorySymmetric (fun x => F (s, x))) :
    physicalSmallBigConditionEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
      (physicalSmallBigPrefixAction (PhysicalSmallBigFullEvent n shared B Δ D)
        (physicalSmallBigFullTarget n shared B Δ D)
        (physicalSmallBigFullCoefficient n shared B Δ D μ ρ V Ψ)
        (fun y => kbig (productActiveMemorySplit shared B y).1) (physicalSmallBigCondition Vs q F)) ≤
      H ^ 2 * unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G *
        physicalSmallBigConditionEnergy (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
          (physicalSmallBigCondition Vs q F) := by
  exact physical_small_big_full_prefix_energy_le n shared B Δ D μ ρ V kbig
    hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht Ψ H hH hΨ
    (physicalSmallBigCondition Vs q F)
    (fun d r => physical_small_big_condition_memory_symmetric Vs q F hF d r)

end

end Bounty
end

section

/- Energy transfer through the two actual small conditioning maps.
The remaining bound is on the big event action at each retained small
prefix. The small measure is the original residue-valid counting measure. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_energy_of_prefix_bound
    {S X : Type*} [Fintype S] [dS : DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (q ζ : ℝ) (W : X → ℝ) (hW : ∀ x, 0 ≤ W x)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    {A H K : ℝ} (hA : 0 ≤ A) (hH : 0 ≤ H) (hK : 0 ≤ K)
    (hκ : ∀ d, ‖κ d‖ ≤ H)
    (hcondition : ∀ u : PhysicalSmallBigState P J ell X → ℂ,
      physicalSmallBigConditionEnergy W (physicalSmallBigCondition V q u) ≤
        A * physicalSmallBigEnergy V W u)
    (F : PhysicalSmallBigState P J ell X → ℂ)
    (hprefix : physicalSmallBigConditionEnergy W
      (physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F)) ≤
        K * physicalSmallBigConditionEnergy W (physicalSmallBigCondition V q F)) :
    physicalSmallBigEnergy V W (physicalSmallBigAction V q ζ aux κ E target a k F) ≤
      A ^ 2 * H ^ 2 * K * physicalSmallBigEnergy V W F := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  let Y := PhysicalSharedLists P J × (PhysicalResidues P × X)
  let ν : Y → ℝ := fun y => W y.2.2
  let C : (PhysicalSmallBigState P J ell X → ℂ) → Y → ℂ :=
    fun u y => physicalSmallBigCondition V q u y.1 y.2.2 y.2.1
  let v : Y → ℂ := fun y => κ y.1 * physicalPhase ζ (physicalSharedProduct y.1) *
    physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F) y.1 y.2.2 y.2.1
  have hCe (u : PhysicalSmallBigState P J ell X → ℂ) :
      finiteWeightedEnergy ν (C u) =
        physicalSmallBigConditionEnergy W (physicalSmallBigCondition V q u) := by
    simp only [ν, C, Y, finiteWeightedEnergy, Fintype.sum_prod_type, physicalSmallBigConditionEnergy]
  have hv : finiteWeightedEnergy ν v ≤
      (H ^ 2 * K * A) * finiteWeightedEnergy (physicalSmallBigMeasure V W) F := by
    calc
      _ ≤ H ^ 2 * physicalSmallBigConditionEnergy W
          (physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F)) := by
        simp only [ν, v, Y, finiteWeightedEnergy, Fintype.sum_prod_type,
          physicalSmallBigConditionEnergy, mul_sum]
        apply sum_le_sum
        intro d _
        apply sum_le_sum
        intro r _
        apply sum_le_sum
        intro x _
        rw [norm_mul, norm_mul, physical_phase_norm, mul_one, mul_pow]
        have hsq : ‖κ d‖ ^ 2 ≤ H ^ 2 := (sq_le_sq₀ (norm_nonneg _) hH).mpr (hκ d)
        nlinarith [mul_le_mul_of_nonneg_right hsq
          (mul_nonneg (hW x) (sq_nonneg
            ‖physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F) d x r‖))]
      _ ≤ H ^ 2 * (K * physicalSmallBigConditionEnergy W (physicalSmallBigCondition V q F)) :=
        mul_le_mul_of_nonneg_left hprefix (sq_nonneg H)
      _ ≤ H ^ 2 * (K * (A * physicalSmallBigEnergy V W F)) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left (hcondition F) hK) (sq_nonneg H)
      _ = _ := by rw [physical_small_big_energy_eq]; ring
  have h := finite_conditioned_energy_le (physicalSmallBigMeasure V W) ν
    (physical_small_big_measure_nonneg V hV W hW) (fun y => hW y.2.2)
    C hA (mul_nonneg (mul_nonneg (sq_nonneg H) hK) hA)
    (fun u => by rw [hCe, physical_small_big_energy_eq]; exact hcondition u)
    F (physicalSmallBigAction V q ζ aux κ E target a k F) v hv
    (fun u => by
      simpa only [ν, C, v, Y, Fintype.sum_prod_type] using
        physical_small_big_pairing V hV q ζ W aux κ E target a k u F)
  rw [physical_small_big_energy_eq, physical_small_big_energy_eq] at h
  convert h using 1
  ring

/- The small norm conversion is supplied by the original conditioning
estimate, uniformly in the number J of retained slots. The only remaining
energy premise concerns the explicit big-event operator. -/
theorem exists_physical_small_big_energy_bound
    {q v : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (S X : Type) [Fintype S] [DecidableEq S] [Fintype X]
      (P : S → Finset ℕ) [∀ p : PhysicalPrime P, NeZero p.2.val]
      (J : ℕ) (V : S → ℝ), (∀ s, v ≤ V s) →
      ∀ (ζ : ℝ) (W : X → ℝ), (∀ x, 0 ≤ W x) →
      ∀ (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
        (κ : PhysicalSharedLists P J → ℂ)
        (E : PhysicalSharedLists P J → X → Type) [∀ d x, Fintype (E d x)]
        (target : ∀ d x, E d x → X)
        (a : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
        (H K : ℝ), 0 ≤ H → 0 ≤ K → (∀ d, ‖κ d‖ ≤ H) →
      ∀ F : PhysicalSmallBigState P J ell X → ℂ,
      physicalSmallBigConditionEnergy W
        (physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F)) ≤
          K * physicalSmallBigConditionEnergy W (physicalSmallBigCondition V q F) →
      physicalSmallBigEnergy V W (physicalSmallBigAction V q ζ aux κ E target a k F) ≤
        A ^ (2 * Fintype.card S) * H ^ 2 * K * physicalSmallBigEnergy V W F := by
  obtain ⟨A, hA, hcond⟩ := exists_physical_small_big_condition_energy_bound hq0 hq1 hv ell
  refine ⟨A, hA, ?_⟩
  intro S X _ dS _
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  intro P _ J V hV ζ W hW aux κ E _ target a k H K hH hK hκ F hprefix
  have h := physical_small_big_energy_of_prefix_bound V (fun s => hv.trans_le (hV s)) q ζ W hW
    aux κ E target a k (pow_nonneg (zero_le_one.trans hA) _) hH hK hκ
    (hcond S X P J V hV W hW) F hprefix
  simpa only [← pow_mul, Nat.mul_comm (Fintype.card S) 2] using h

end Bounty
end

section

/- Sparse small-source averaging in the original mixed measure. The
choice index may include an auxiliary draw. A source gate stays explicit,
and support rarity is used jointly before integrating either choice. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_small_big_sparse_permutation_energy_le
    {S X Q : Type*} [Fintype S] [Fintype X] [Fintype Q]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (W : X → ℝ) (hW : ∀ x, 0 ≤ W x)
    (π : Q → ℝ) (hπ : ∀ a, 0 ≤ π a) (hπmass : ∑ a, π a ≤ 1)
    (σ : Q → PhysicalPermutations S J ell)
    (good : PhysicalSmallBigState P J ell X → Prop)
    (bad : Q → PhysicalSmallBigState P J ell X → Prop)
    (output : Q → PhysicalSmallBigState P J ell X → ℂ)
    (hzero : ∀ a s, ¬ bad a s → output a s = 0)
    {δ K : ℝ} (hδ : 0 ≤ δ) (hK : 0 ≤ K)
    (hrare : ∀ s, good s →
      (∑ a, if bad a (physicalSmallBigPermutation (σ a) s) then π a else 0) ≤ δ)
    (f : PhysicalSmallBigState P J ell X → ℂ)
    (henergy : ∀ a, physicalSmallBigEnergy V W (output a) ≤
      K * physicalSmallBigEnergy V W f) :
    physicalSmallBigEnergy V W (fun s => ∑ a, (π a : ℂ) *
      (if good s then output a (physicalSmallBigPermutation (σ a) s) else 0)) ≤
      δ * K * physicalSmallBigEnergy V W f := by
  rw [← physical_small_big_energy_eq, ← physical_small_big_energy_eq]
  refine finite_sparse_average_energy_le π hπ hπmass (physicalSmallBigMeasure V W)
    (physical_small_big_measure_nonneg V hV W hW)
    (fun a s => good s ∧ bad a (physicalSmallBigPermutation (σ a) s)) _ ?_ hδ hK ?_ f ?_
  · intro a s h
    by_cases hs : good s
    · rw [if_pos hs]
      exact hzero a _ (fun hb => h ⟨hs, hb⟩)
    · exact if_neg hs
  · intro s
    by_cases hs : good s
    · simpa only [hs, true_and] using hrare s hs
    · simpa only [hs, false_and, ite_false, sum_const_zero] using hδ
  · intro a
    rw [physical_small_big_energy_eq]
    calc
      _ ≤ physicalSmallBigEnergy V W (fun s => output a (physicalSmallBigPermutation (σ a) s)) := by
        rw [← physical_small_big_energy_eq, ← physical_small_big_energy_eq]
        apply sum_le_sum
        intro s _
        apply mul_le_mul_of_nonneg_left _ (physical_small_big_measure_nonneg V hV W hW s)
        dsimp only
        split_ifs
        · exact le_rfl
        · simpa only [norm_zero, zero_pow (by decide : 2 ≠ 0)] using
            sq_nonneg ‖output a (physicalSmallBigPermutation (σ a) s)‖
      _ = physicalSmallBigEnergy V W (output a) := physical_small_big_permutation_energy V W (σ a) _
      _ ≤ _ := by simpa only [physical_small_big_energy_eq] using henergy a

end Bounty
end

section

/- Uniform small-slot averaging is self-adjoint for the actual mixed
residue-valid measure. Big pending-memory symmetry is retained. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalSmallBigAverage {S X : Type*} [Fintype S] [DecidableEq S]
    {P : S → Finset ℕ} {J ell : ℕ}
    (f : PhysicalSmallBigState P J ell X → ℂ) (s : PhysicalSmallBigState P J ell X) : ℂ :=
  (Fintype.card (PhysicalPermutations S J ell) : ℂ)⁻¹ *
    ∑ σ : PhysicalPermutations S J ell, f (physicalSmallBigPermutation σ s)

section

variable
  {S X : Type*}
  [sharedInstance1 : Fintype S]
  [sharedInstance2 : DecidableEq S]
  [sharedInstance3 : Fintype X]
  {P : S → Finset ℕ}
  [sharedInstance5 : ∀ p : PhysicalPrime P, NeZero p.2.val]
  {J ell : ℕ}
  (V : S → ℝ)
  (W : X → ℝ)

include S X sharedInstance1 sharedInstance2 sharedInstance3 P sharedInstance5 J ell V W

theorem physical_small_big_permutation_pairing
     (σ : PhysicalPermutations S J ell)
    (f g : PhysicalSmallBigState P J ell X → ℂ) :
    (∑ s, (physicalSmallBigMeasure V W s : ℂ) * f s *
      g (physicalSmallBigPermutation σ s)) =
      ∑ s, (physicalSmallBigMeasure V W s : ℂ) *
        f (physicalSmallBigPermutation σ⁻¹ s) * g s := by
  have h := (physicalSmallBigPermutation (P := P) (X := X) σ).sum_comp
    (fun s => (physicalSmallBigMeasure V W s : ℂ) *
      f ((physicalSmallBigPermutation σ).symm s) * g s)
  have hi : (physicalSmallBigPermutation (P := P) (X := X) σ).symm =
      physicalSmallBigPermutation σ⁻¹ := by
    apply Equiv.ext
    intro s
    rfl
  simp only [physical_small_big_permutation_measure, Equiv.symm_apply_apply] at h
  simpa only [hi] using h

theorem physical_small_big_average_pairing
    
    (f g : PhysicalSmallBigState P J ell X → ℂ) :
    (∑ s, (physicalSmallBigMeasure V W s : ℂ) * f s * physicalSmallBigAverage g s) =
      ∑ s, (physicalSmallBigMeasure V W s : ℂ) * physicalSmallBigAverage f s * g s := by
  calc
    _ = (Fintype.card (PhysicalPermutations S J ell) : ℂ)⁻¹ *
        ∑ σ : PhysicalPermutations S J ell, ∑ s,
          (physicalSmallBigMeasure V W s : ℂ) * f s * g (physicalSmallBigPermutation σ s) := by
      simp only [physicalSmallBigAverage, mul_sum]
      rw [sum_comm]
      apply sum_congr rfl
      intro σ _
      apply sum_congr rfl
      intro s _
      ring
    _ = (Fintype.card (PhysicalPermutations S J ell) : ℂ)⁻¹ *
        ∑ σ : PhysicalPermutations S J ell, ∑ s,
          (physicalSmallBigMeasure V W s : ℂ) * f (physicalSmallBigPermutation σ⁻¹ s) * g s := by
      simp_rw [physical_small_big_permutation_pairing]
    _ = (Fintype.card (PhysicalPermutations S J ell) : ℂ)⁻¹ *
        ∑ σ : PhysicalPermutations S J ell, ∑ s,
          (physicalSmallBigMeasure V W s : ℂ) * f (physicalSmallBigPermutation σ s) * g s := by
      apply congrArg (fun z : ℂ => (Fintype.card (PhysicalPermutations S J ell) : ℂ)⁻¹ * z)
      exact Equiv.sum_comp (Equiv.inv (PhysicalPermutations S J ell))
        (fun σ => ∑ s, (physicalSmallBigMeasure V W s : ℂ) *
          f (physicalSmallBigPermutation σ s) * g s)
    _ = _ := by
      simp only [physicalSmallBigAverage, mul_sum, sum_mul]
      rw [sum_comm]
      apply sum_congr rfl
      intro s _
      apply sum_congr rfl
      intro σ _
      ring

end








theorem physical_small_big_average_memory_symmetric
    {S G : Type*} [Fintype S] [DecidableEq S] [DecidableEq G]
    {P : S → Finset ℕ} {Pb Z : G → Type*} {J ell B : ℕ} {t : G → ℕ}
    (f : PhysicalSmallBigState P J ell (ProductBoundedOrderedState Pb Z t B) → ℂ)
    (hf : ∀ s, ProductMemorySymmetric (fun x => f (s, x))) :
    ∀ s, ProductMemorySymmetric (fun x => physicalSmallBigAverage f (s, x)) := by
  intro s x g τ
  unfold physicalSmallBigAverage
  apply congrArg (fun z : ℂ => (Fintype.card (PhysicalPermutations S J ell) : ℂ)⁻¹ * z)
  apply sum_congr rfl
  intro σ _
  exact hf (s.1, physicalPermuteLabels σ s.2) x g τ

theorem physical_small_big_average_sandwich_pairing
    {S X : Type*} [Fintype S] [DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ)
    (T R : (PhysicalSmallBigState P J ell X → ℂ) → PhysicalSmallBigState P J ell X → ℂ)
    (f g : PhysicalSmallBigState P J ell X → ℂ)
    (hpair : (∑ s, (physicalSmallBigMeasure V W s : ℂ) * physicalSmallBigAverage f s *
        T (physicalSmallBigAverage g) s) =
      ∑ s, (physicalSmallBigMeasure V W s : ℂ) * R (physicalSmallBigAverage f) s *
        physicalSmallBigAverage g s) :
    (∑ s, (physicalSmallBigMeasure V W s : ℂ) * f s *
      physicalSmallBigAverage (T (physicalSmallBigAverage g)) s) =
      ∑ s, (physicalSmallBigMeasure V W s : ℂ) *
        physicalSmallBigAverage (R (physicalSmallBigAverage f)) s * g s := by
  rw [physical_small_big_average_pairing]
  exact hpair.trans (physical_small_big_average_pairing V W _ g)

end Bounty
end

section

/- Exact transposition through the original small conditioning map.
The underlying measure remains the residue-valid small-state measure. -/

open Finset Classical

namespace Bounty

theorem physical_small_big_condition_conj
    {S X : Type*} [Fintype S] [DecidableEq S]
    {P : S → Finset ℕ} {J ell : ℕ} (V : S → ℝ) (q : ℝ)
    (F : PhysicalSmallBigState P J ell X → ℂ)
    (d : PhysicalSharedLists P J) (x : X) (r : PhysicalResidues P) :
    physicalSmallBigCondition V q (fun s => (starRingEnd ℂ) (F s)) d x r =
      (starRingEnd ℂ) (physicalSmallBigCondition V q F d x r) := by
  simp only [physicalSmallBigCondition, physicalSmallCondition, map_mul, map_sum,
    Complex.conj_ofReal]

section

variable
  {S X : Type*}
  [sharedInstance1 : Fintype S]
  [sharedInstance2 : DecidableEq S]
  [sharedInstance3 : Fintype X]
  {P : S → Finset ℕ}
  [sharedInstance5 : ∀ p : PhysicalPrime P, NeZero p.2.val]
  {J ell : ℕ}
  (V : S → ℝ)
  (hV : ∀ s, 0 < V s)

include S X sharedInstance1 sharedInstance2 sharedInstance3 P sharedInstance5 J ell V hV

theorem physical_small_big_bilinear_pairing
     (q ζ : ℝ) (W : X → ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (u F : PhysicalSmallBigState P J ell X → ℂ) :
    (∑ s, (physicalSmallBigMeasure V W s : ℂ) * u s *
      physicalSmallBigAction V q ζ aux κ E target a k F s) =
      ∑ d, ∑ r, ∑ x, (W x : ℂ) * physicalSmallBigCondition V q u d x r *
        (κ d * physicalPhase ζ (physicalSharedProduct d) *
          physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F) d x r) := by
  have h := physical_small_big_pairing V hV q ζ W aux κ E target a k
    (fun s => (starRingEnd ℂ) (u s)) F
  simpa only [physical_small_big_condition_conj, Complex.conj_conj] using h

/- A prefix transpose lifts exactly to the mixed measure. This statement is
algebraic: its premise is an equality of the specified two prefix actions. -/
theorem physical_small_big_transpose_of_prefix_pairing
     (q : ℝ) (W : X → ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (E R : PhysicalSharedLists P J → X → Type*)
    [∀ d x, Fintype (E d x)] [∀ d x, Fintype (R d x)]
    (target : ∀ d x, E d x → X) (back : ∀ d x, R d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℂ)
    (b : PhysicalResidues P → ∀ d x, R d x → ℂ) (k l : X → ℤ)
    (u F : PhysicalSmallBigState P J ell X → ℂ)
    (hprefix : ∀ d,
      (∑ r, ∑ x, (W x : ℂ) * physicalSmallBigCondition V q u d x r *
        physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F) d x r) =
      ∑ r, ∑ x, (W x : ℂ) *
        physicalSmallBigPrefixAction R back b l (physicalSmallBigCondition V q u) d x r *
          physicalSmallBigCondition V q F d x r) :
    (∑ s, (physicalSmallBigMeasure V W s : ℂ) * u s *
      physicalSmallBigAction V q 0 aux (fun _ => 1) E target a k F s) =
      ∑ s, (physicalSmallBigMeasure V W s : ℂ) *
        physicalSmallBigAction V q 0 aux (fun _ => 1) R back b l u s * F s := by
  have hf := physical_small_big_bilinear_pairing V hV q 0 W aux (fun _ => 1)
    E target a k u F
  have hb := physical_small_big_bilinear_pairing V hV q 0 W aux (fun _ => 1)
    R back b l F u
  have hz (d : PhysicalSharedLists P J) : physicalPhase 0 (physicalSharedProduct d) = 1 := by
    simp [physicalPhase]
  simp only [hz, mul_one, one_mul] at hf hb
  rw [hf]
  calc
    _ = ∑ d, ∑ r, ∑ x, (W x : ℂ) *
        physicalSmallBigPrefixAction R back b l (physicalSmallBigCondition V q u) d x r *
          physicalSmallBigCondition V q F d x r := by
      apply sum_congr rfl
      intro d hd
      exact hprefix d
    _ = _ := by
      simpa only [mul_assoc, mul_comm, mul_left_comm] using hb.symm

end


end Bounty
end

section

/- Absorb the genuine small-conditioning cost and big-memory energy cost
into a fixed polynomial before choosing the omission parameter J. These are
scalar bounds only; no identity for a physical operator is asserted. -/

open Finset Filter
open scoped Topology

namespace Bounty

theorem mixed_conditioning_cost_le (small big : ℕ) {L aSmall aBig A₀ K : ℝ}
    (hL : 0 < L) (hA₀ : 0 ≤ A₀) (hK : 0 ≤ K)
    (hsmall : (small : ℝ) ≤ aSmall * Real.log L)
    (hbig : (big : ℝ) ≤ aBig * Real.log L) :
    A₀ ^ small * Real.sqrt (K ^ big) ≤
      L ^ (aSmall * Real.log (max 1 A₀) + (aBig / 2) * Real.log (max 1 K)) := by
  have hs := repeated_big_group_energy_cost_le small hL hA₀ hsmall
  have hb := Real.sqrt_le_sqrt (repeated_big_group_energy_cost_le big hL hK hbig)
  have he : Real.sqrt (L ^ (aBig * Real.log (max 1 K))) =
      L ^ ((aBig / 2) * Real.log (max 1 K)) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_mul hL.le]
    congr 1
    ring
  rw [he] at hb
  calc
    _ ≤ L ^ (aSmall * Real.log (max 1 A₀)) *
        L ^ ((aBig / 2) * Real.log (max 1 K)) :=
      mul_le_mul hs hb (Real.sqrt_nonneg _) (Real.rpow_nonneg hL.le _)
    _ = _ := (Real.rpow_add hL _ _).symm

noncomputable def candidateMixedRareCostExponent (A₀ K : ℝ) : ℝ :=
  (2 / (5 * Real.log 2)) * Real.log (max 1 A₀) +
    ((2 / (5 * Real.log 2)) / 2) * Real.log (max 1 K)

theorem eventually_candidate_mixed_conditioning_cost_le {s : ℝ} (hs : 0 < s) :
    ∀ᶠ L : ℝ in atTop, ∀ A₀ K : ℝ, 0 ≤ A₀ → 0 ≤ K →
      A₀ ^ (candidateSmallPIndices s L).card *
        Real.sqrt (K ^ (candidateBigPIndices s L).card) ≤
          L ^ candidateMixedRareCostExponent A₀ K := by
  obtain ⟨v, V, _, _, hpool⟩ := exists_candidate_P_pool_bounds hs
  filter_upwards [hpool] with L hp
  intro A₀ K hA₀ hK
  have hsmall : (candidateSmallPIndices s L).card ≤ (candidatePIndices s L).card :=
    card_le_card (show candidateSmallPIndices s L ⊆ candidatePIndices s L from subset_union_left)
  have hbig : (candidateBigPIndices s L).card ≤ (candidatePIndices s L).card :=
    card_le_card (show candidateBigPIndices s L ⊆ candidatePIndices s L from subset_union_right)
  apply mixed_conditioning_cost_le _ _ (zero_lt_one.trans_le hp.1) hA₀ hK
  · exact (by exact_mod_cast hsmall : ((candidateSmallPIndices s L).card : ℝ) ≤
      ((candidatePIndices s L).card : ℝ)).trans hp.2.2.2.1
  · exact (by exact_mod_cast hbig : ((candidateBigPIndices s L).card : ℝ) ≤
      ((candidatePIndices s L).card : ℝ)).trans hp.2.2.2.1

theorem exists_candidate_mixed_rare_parameter {s : ℝ} (hs : 0 < s)
    (ell : ℕ) (hell : 0 < ell) (J₀ : ℕ) (A₀ K A E : ℝ)
    (hA₀ : 0 ≤ A₀) (hK : 0 ≤ K) :
    ∃ J : ℕ, J₀ ≤ J ∧
      ((1 / (20 * Real.log 2)) / 2) * Real.log (((J + ell).choose ell : ℕ) : ℝ) >
        A + candidateMixedRareCostExponent A₀ K + E + 3 ∧
      ∀ᶠ L : ℝ in atTop,
        let cost := 2 * L ^ A *
          (A₀ ^ (candidateSmallPIndices s L).card * Real.sqrt (K ^ (candidateBigPIndices s L).card)) *
          Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) /
            (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ))
        cost ≤ (1 / 2 : ℝ) * L ^ (-E) ∧ L ^ (-(E + 1)) + cost ≤ L ^ (-E) := by
  obtain ⟨J, hJ, hgain, hrare⟩ := exists_candidate_rare_transfer_parameter hs ell hell J₀
    (A + candidateMixedRareCostExponent A₀ K) E
  refine ⟨J, hJ, hgain, ?_⟩
  filter_upwards [hrare, eventually_candidate_mixed_conditioning_cost_le hs,
    eventually_ge_atTop (2 : ℝ)] with L hr hc hL
  dsimp only
  have hL0 : 0 < L := by linarith
  have hcost : 2 * L ^ A *
      (A₀ ^ (candidateSmallPIndices s L).card * Real.sqrt (K ^ (candidateBigPIndices s L).card)) *
      Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) /
        (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ)) ≤
      (1 / 2 : ℝ) * L ^ (-E) := by
    calc
      _ ≤ 2 * L ^ A * L ^ candidateMixedRareCostExponent A₀ K *
          Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) /
            (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ)) :=
        mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left (hc A₀ K hA₀ hK) (by positivity)) (Real.sqrt_nonneg _)
      _ = 2 * L ^ (A + candidateMixedRareCostExponent A₀ K) *
          Real.sqrt ((⌈L ^ 2⌉₊ : ℝ) /
            (((J + ell).choose ell) ^ (candidateSmallPIndices s L).card : ℕ)) := by
        rw [Real.rpow_add hL0]
        ring
      _ ≤ _ := hr
  refine ⟨hcost, ?_⟩
  have hclean := rpow_next_saving_le_half E L hL
  linarith

end Bounty
end

section

/- The actual small and big candidate pools used by the mixed-state
energy bounds. Their residue moduli are nonzero because all labels are prime. -/

namespace Bounty

abbrev CandidateSmallGroup (scale L : ℝ) := ↥(candidateSmallPIndices scale L)

noncomputable abbrev candidateSmallPool (scale L : ℝ) (g : CandidateSmallGroup scale L) : Finset ℕ :=
  candidatePBand (scale * L) g.val




end Bounty
