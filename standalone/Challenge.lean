section

/- Exact finite cross-slice reindexing with the signed second endpoint preserved. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

theorem typeII_cross_slice_sum_reindex (M H Z : Finset ℕ) (k : ℤ)
    (W : TypeIIShiftIndex → ℂ) (hM : ∀ m ∈ M, 0 < m) (hk : k ≠ 0) :
    (∑ y ∈ typeIICrossSlice M H Z k, W y) =
      ∑ z ∈ Z, ∑ m ∈ M, ∑ h' ∈ H, ∑ m' ∈ M, ∑ h ∈ H,
        if m'*h=z ∧ (z : ℤ)+k=(m : ℤ)*h' then
          W ((k,z),((m,h),(m',h'))) else 0 := by
  classical
  simp only [typeIICrossSlice, sum_filter, sum_product, sum_singleton]
  apply sum_congr rfl
  intro z hz
  apply sum_congr rfl
  intro m hm
  simp only [TypeIICrossConditions, hM m hm, true_and]
  rw [sum_comm]
  calc
    _ = ∑ m' ∈ M, ∑ h' ∈ H, ∑ h ∈ H,
        if z=m'*h ∧ (z : ℤ)+k=(m : ℤ)*h' then
          W ((k,z),((m,h),(m',h'))) else 0 := by
      apply sum_congr rfl
      intro m' hm'
      rw [sum_comm]
      apply sum_congr rfl
      intro h' hh'
      apply sum_congr rfl
      intro h hh
      by_cases hcross : z=m'*h ∧ (z : ℤ)+k=(m : ℤ)*h'
      · rw [if_pos ⟨hk, hcross⟩, if_pos hcross]
      · rw [if_neg (fun hc => hcross hc.2), if_neg hcross]
    _ = _ := by
      rw [sum_comm]
      apply sum_congr rfl
      intro h' hh'
      apply sum_congr rfl
      intro m' hm'
      apply sum_congr rfl
      intro h hh
      simp only [eq_comm (a := z) (b := m'*h)]




theorem typeII_cross_slice_singleton_eq_cross_pair_coefficient
    (M H : Finset ℕ) (k : ℤ) (z w : ℕ)
    (A : ℕ → ℂ) (W : ℕ → ℝ) (B : ℕ → ℂ) (ρ ξ₁ ξ₂ ξ₃ : ℝ)
    (hM : ∀ m ∈ M, 0 < m) (hk : k ≠ 0) (hzw : (z : ℤ)+k=(w : ℤ)) :
    (∑ y ∈ typeIICrossSlice M H {z} k,
      A y.2.1.1 * conj (A y.2.2.1) * typeIISeparatedH W B ρ y.2.1.2 *
        conj (typeIISeparatedH W B ρ y.2.2.2) *
        typeIIPhase ξ₁ y.2.1.1 * typeIIPhase ξ₂ y.2.2.1 * typeIIPhase ξ₃ y.1.2) =
      typeIICrossPairCoefficient M H A W B ρ ξ₁ ξ₂ ξ₃ z w := by
  classical
  rw [typeII_cross_slice_sum_reindex M H {z} k _ hM hk, sum_singleton]
  unfold typeIICrossPairCoefficient
  apply sum_congr rfl
  intro m hm
  apply sum_congr rfl
  intro h' hh'
  apply sum_congr rfl
  intro m' hm'
  apply sum_congr rfl
  intro h hh
  have hcross : ((z : ℤ)+k=(m : ℤ)*h') ↔ m*h'=w := by
    rw [hzw]
    constructor <;> intro heq <;> exact_mod_cast heq.symm
  simp only [hcross]


