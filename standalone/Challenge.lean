open scoped BigOperators Classical
abbrev BoundedPrimitiveCharacter (Q : ℕ) :=
  {t : (n : Fin Q) × DirichletCharacter ℂ (n.val + 1) // t.2.IsPrimitive}

noncomputable def boundedPrimitiveModulus {Q : ℕ} (t : BoundedPrimitiveCharacter Q) : ℕ :=
  t.val.1.val + 1

noncomputable def boundedPrimitiveValue {Q : ℕ} (t : BoundedPrimitiveCharacter Q) :
    DirichletCharacter ℂ (boundedPrimitiveModulus t) := t.val.2

theorem bounded_primitive_modulus_pos {Q : ℕ} (t : BoundedPrimitiveCharacter Q) :
    0 < boundedPrimitiveModulus t := Nat.zero_lt_succ _

theorem bounded_primitive_modulus_le {Q : ℕ} (t : BoundedPrimitiveCharacter Q) :
    boundedPrimitiveModulus t ≤ Q := t.val.1.isLt

theorem bounded_primitive_value_primitive {Q : ℕ} (t : BoundedPrimitiveCharacter Q) :
    (boundedPrimitiveValue t).IsPrimitive := t.property

theorem bounded_primitive_character_card_le (Q : ℕ) :
    Fintype.card (BoundedPrimitiveCharacter Q) ≤ Q * Q := by
  calc
    _ ≤ Fintype.card ((n : Fin Q) × DirichletCharacter ℂ (n.val + 1)) :=
      Fintype.card_subtype_le _
    _ = ∑ n : Fin Q, Fintype.card (DirichletCharacter ℂ (n.val + 1)) := Fintype.card_sigma
    _ ≤ ∑ _n : Fin Q, Q := by
      apply Finset.sum_le_sum
      intro n _
      rw [← Nat.card_eq_fintype_card, DirichletCharacter.card_eq_totient_of_hasEnoughRootsOfUnity]
      exact (Nat.totient_le _).trans n.isLt
    _ = Q * Q := by simp

theorem bounded_primitive_character_injective (Q : ℕ) :
    Function.Injective (fun t : BoundedPrimitiveCharacter Q =>
      (⟨boundedPrimitiveModulus t, boundedPrimitiveValue t⟩ : (n : ℕ) × DirichletCharacter ℂ n)) := by
  rintro ⟨⟨i, χ⟩, hi⟩ ⟨⟨j, ψ⟩, hj⟩ he
  have hn : i.val + 1 = j.val + 1 := congrArg Sigma.fst he
  have hij : i = j := Fin.ext (Nat.add_right_cancel hn)
  subst j
  have hc : χ = ψ := eq_of_heq (Sigma.mk.inj he).2
  subst ψ
  rfl
end

section
open Finset
theorem block_sieve_local_bounds {ι : Type*} (s : Finset ι) (w : ι → ℝ)
    (hw : ∀ i ∈ s, 0 ≤ w i ∧ w i ≤ 1) {h : ℕ} (hh : Even h) :
    0 ≤ exclusionTruncation s w (h + 1) ∧
    (∏ i ∈ s, (1 - w i)) ≤ exclusionTruncation s w (h + 1) ∧
    exclusionTruncation s w (h + 1) - (∏ i ∈ s, (1 - w i)) ≤
      exclusionElementary s w (h + 1) := by
  have hb := exclusion_bonferroni s w hw (h + 1)
  rw [pow_succ, hh.neg_one_pow, one_mul] at hb
  have hprod : 0 ≤ ∏ i ∈ s, (1 - w i) :=
    prod_nonneg (fun i hi => sub_nonneg.mpr (hw i hi).2)
  constructor
  · linarith [hb.1]
  constructor <;> linarith [hb.1, hb.2]

theorem block_sieve_log_factor_lower {η u : ℝ} (hη : 0 < η)
    (hu0 : 0 ≤ u) (hu1 : u ≤ 1 - η) : -u / η ≤ Real.log (1 - u) := by
  have hden : 0 < 1 - u := by linarith
  have hηden : η ≤ 1 - u := by linarith
  have hdiv : u / (1 - u) ≤ u / η := div_le_div_of_nonneg_left hu0 hη hηden
  have hlog := Real.one_sub_inv_le_log_of_pos hden
  have he : 1 - (1 - u)⁻¹ = -u / (1 - u) := by field_simp; ring
  rw [he] at hlog
  have hneg : -u / η ≤ -u / (1 - u) := by
    simpa only [neg_div] using neg_le_neg hdiv
  exact hneg.trans hlog

theorem block_sieve_avoidance_lower {ι : Type*} (s : Finset ι) (w : ι → ℝ)
    {η C : ℝ} (hη : 0 < η) (hw : ∀ i ∈ s, 0 ≤ w i ∧ w i ≤ 1 - η)
    (hsum : (∑ i ∈ s, w i) ≤ C) :
    Real.exp (-C / η) ≤ ∏ i ∈ s, (1 - w i) := by
  have hf : ∀ i ∈ s, Real.exp (-w i / η) ≤ 1 - w i := by
    intro i hi
    have hpos : 0 < 1 - w i := by linarith [(hw i hi).2]
    exact (Real.exp_le_exp.mpr (block_sieve_log_factor_lower hη (hw i hi).1 (hw i hi).2)).trans_eq
      (Real.exp_log hpos)
  calc
    _ ≤ Real.exp (-(∑ i ∈ s, w i) / η) :=
      Real.exp_le_exp.mpr (div_le_div_of_nonneg_right (neg_le_neg hsum) hη.le)
    _ = ∏ i ∈ s, Real.exp (-w i / η) := by
      rw [← Real.exp_sum]
      congr 1
      rw [← sum_neg_distrib, sum_div]
    _ ≤ _ := prod_le_prod₀ (fun _ _ => (Real.exp_pos _).le) hf

theorem block_sieve_relative_error_bound {ι : Type*} (s : Finset ι) (w : ι → ℝ)
    {η C : ℝ} (hη : 0 < η) (hC : 0 ≤ C)
    (hw : ∀ i ∈ s, 0 ≤ w i ∧ w i ≤ 1 - η)
    (hsum : (∑ i ∈ s, w i) ≤ C) (h : ℕ) :
    exclusionElementary s w (h + 1) / (∏ i ∈ s, (1 - w i)) ≤
      Real.exp (C / η) * (C^(h + 1) / ((h + 1).factorial : ℝ)) := by
  have ha := block_sieve_avoidance_lower s w hη hw hsum
  have ha0 : 0 < ∏ i ∈ s, (1 - w i) := (Real.exp_pos _).trans_le ha
  have hE : exclusionElementary s w (h + 1) ≤ C^(h + 1) / ((h + 1).factorial : ℝ) := by
    apply (exclusion_elementary_le_pow_div_factorial s w (fun i hi => (hw i hi).1) (h + 1)).trans
    exact div_le_div_of_nonneg_right
      (pow_le_pow_left₀ (sum_nonneg (fun i hi => (hw i hi).1)) hsum _)
      (Nat.cast_nonneg _)
  calc
    _ ≤ (C^(h + 1) / ((h + 1).factorial : ℝ)) / (∏ i ∈ s, (1 - w i)) :=
      div_le_div_of_nonneg_right hE ha0.le
    _ ≤ (C^(h + 1) / ((h + 1).factorial : ℝ)) / Real.exp (-C / η) :=
      div_le_div_of_nonneg_left (by positivity) (Real.exp_pos _) ha
    _ = _ := by rw [neg_div, Real.exp_neg, div_inv_eq_mul]; ring
end

section
open Finset
theorem block_product_correction_insert {G : Type*} [DecidableEq G]
    (s : Finset G) (U E : G → ℝ) {a : G} (ha : a ∉ s) :
    (∑ g ∈ insert a s, E g * ∏ k ∈ (insert a s).erase g, U k) =
      E a * (∏ k ∈ s, U k) +
        U a * (∑ g ∈ s, E g * ∏ k ∈ s.erase g, U k) := by
  rw [sum_insert ha, erase_insert ha, mul_sum]
  congr 1
  apply sum_congr rfl
  intro g hg
  have hag : a ≠ g := by
    intro h
    exact ha (h ▸ hg)
  rw [erase_insert_of_ne hag, prod_insert (not_mem_subset (erase_subset _ _) ha)]
  ring

section

variable
  {G : Type*}
  [sharedInstance1 : DecidableEq G]
  (s : Finset G)
  (I U E : G → ℝ)
  (hI : ∀ g ∈ s, 0 ≤ I g)
  (hIU : ∀ g ∈ s, I g ≤ U g)
  (hE : ∀ g ∈ s, U g - I g ≤ E g)

include G sharedInstance1 s I U E hI hIU hE

theorem block_product_difference_bound  :
    0 ≤ (∏ g ∈ s, U g) - (∏ g ∈ s, I g) ∧
      (∏ g ∈ s, U g) - (∏ g ∈ s, I g) ≤
        ∑ g ∈ s, E g * ∏ k ∈ s.erase g, U k := by
  refine ⟨sub_nonneg.mpr (prod_le_prod₀ hI hIU), ?_⟩
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
    have hIa : 0 ≤ I a := hI a (mem_insert_self _ _)
    have hIUa : I a ≤ U a := hIU a (mem_insert_self _ _)
    have hEa : U a - I a ≤ E a := hE a (mem_insert_self _ _)
    have hIs : ∀ g ∈ s, 0 ≤ I g := fun g hg => hI g (mem_insert_of_mem hg)
    have hIUs : ∀ g ∈ s, I g ≤ U g := fun g hg => hIU g (mem_insert_of_mem hg)
    have hEs : ∀ g ∈ s, U g - I g ≤ E g :=
      fun g hg => hE g (mem_insert_of_mem hg)
    have hUs : 0 ≤ ∏ g ∈ s, U g :=
      prod_nonneg (fun g hg => (hIs g hg).trans (hIUs g hg))
    have hCs : 0 ≤ ∑ g ∈ s, E g * ∏ k ∈ s.erase g, U k := by
      apply sum_nonneg
      intro g hg
      apply mul_nonneg
      · exact (sub_nonneg.mpr (hIUs g hg)).trans (hEs g hg)
      · exact prod_nonneg (fun k hk =>
          (hIs k (mem_of_mem_erase hk)).trans (hIUs k (mem_of_mem_erase hk)))
    have h1 := mul_le_mul_of_nonneg_right hEa hUs
    have h2 := mul_le_mul_of_nonneg_left (ih hIs hIUs hEs) hIa
    have h3 := mul_le_mul_of_nonneg_right hIUa hCs
    rw [prod_insert ha, prod_insert ha, block_product_correction_insert s U E ha]
    nlinarith

theorem block_product_sandwich  :
    (∏ g ∈ s, U g) - (∑ g ∈ s, E g * ∏ k ∈ s.erase g, U k) ≤
        (∏ g ∈ s, I g) ∧
      (∏ g ∈ s, I g) ≤ (∏ g ∈ s, U g) := by
  have h := block_product_difference_bound s I U E hI hIU hE
  constructor <;> linarith [h.1, h.2]

end

end

section
open Finset
def blockSieveUpperSupport {G : Type*} (J : Finset G) (h n : G → ℕ) : Prop :=
  ∀ g ∈ J, n g ≤ h g

def blockSieveCorrectionSupport {G : Type*} (J : Finset G) (h n : G → ℕ) (j : G) : Prop :=
  j ∈ J ∧ n j = h j + 1 ∧ ∀ g ∈ J, g ≠ j → n g ≤ h g

theorem block_sieve_upper_correction_disjoint {G : Type*} {J : Finset G}
    {h n : G → ℕ} {j : G} (hu : blockSieveUpperSupport J h n)
    (hj : blockSieveCorrectionSupport J h n j) : False := by
  have := hu j hj.1
  have := hj.2.1
  omega

theorem block_sieve_correction_support_unique {G : Type*} {J : Finset G}
    {h n : G → ℕ} {j k : G} (hj : blockSieveCorrectionSupport J h n j)
    (hk : blockSieveCorrectionSupport J h n k) : j = k := by
  by_contra hne
  have := hk.2.2 j hj.1 hne
  have := hj.2.1
  omega

noncomputable def blockSieveUpperCoefficient {G : Type*} (J : Finset G) (h n : G → ℕ) : ℝ := by
  classical
  exact if blockSieveUpperSupport J h n then (-1 : ℝ)^(∑ g ∈ J, n g) else 0

noncomputable def blockSieveCorrectionAt {G : Type*} (J : Finset G) (h n : G → ℕ) (j : G) : ℝ := by
  classical
  exact if blockSieveCorrectionSupport J h n j then (-1 : ℝ)^(∑ g ∈ J.erase j, n g) else 0

noncomputable def blockSieveCorrectionCoefficient {G : Type*} (J : Finset G) (h n : G → ℕ) : ℝ :=
  ∑ j ∈ J, blockSieveCorrectionAt J h n j

noncomputable def blockSieveLowerCoefficient {G : Type*} (J : Finset G) (h n : G → ℕ) : ℝ :=
  blockSieveUpperCoefficient J h n - blockSieveCorrectionCoefficient J h n

theorem block_sieve_upper_coefficient_ne_zero_iff {G : Type*} (J : Finset G) (h n : G → ℕ) :
    blockSieveUpperCoefficient J h n ≠ 0 ↔ blockSieveUpperSupport J h n := by
  classical
  by_cases hs : blockSieveUpperSupport J h n <;> simp [blockSieveUpperCoefficient, hs]

theorem block_sieve_correction_at_ne_zero_iff {G : Type*} (J : Finset G) (h n : G → ℕ) (j : G) :
    blockSieveCorrectionAt J h n j ≠ 0 ↔ blockSieveCorrectionSupport J h n j := by
  classical
  by_cases hs : blockSieveCorrectionSupport J h n j <;> simp [blockSieveCorrectionAt, hs]

theorem block_sieve_correction_coefficient_eq_at {G : Type*} {J : Finset G}
    {h n : G → ℕ} {j : G} (hj : blockSieveCorrectionSupport J h n j) :
    blockSieveCorrectionCoefficient J h n = blockSieveCorrectionAt J h n j := by
  classical
  apply sum_eq_single j
  · intro k _ hkj
    apply not_ne_iff.mp
    intro hk
    exact hkj (block_sieve_correction_support_unique
      ((block_sieve_correction_at_ne_zero_iff J h n k).mp hk) hj)
  · exact fun hnot => (hnot hj.1).elim

theorem block_sieve_correction_coefficient_eq_zero {G : Type*} {J : Finset G}
    {h n : G → ℕ} (hn : ¬ ∃ j, blockSieveCorrectionSupport J h n j) :
    blockSieveCorrectionCoefficient J h n = 0 := by
  classical
  apply sum_eq_zero
  intro j _
  exact not_ne_iff.mp (fun hj => hn ⟨j, (block_sieve_correction_at_ne_zero_iff J h n j).mp hj⟩)

theorem block_sieve_correction_coefficient_ne_zero_iff {G : Type*} (J : Finset G) (h n : G → ℕ) :
    blockSieveCorrectionCoefficient J h n ≠ 0 ↔ ∃! j, blockSieveCorrectionSupport J h n j := by
  classical
  constructor
  · intro hc
    have hex : ∃ j, blockSieveCorrectionSupport J h n j := by
      by_contra hn
      exact hc (block_sieve_correction_coefficient_eq_zero hn)
    obtain ⟨j, hj⟩ := hex
    exact ⟨j, hj, fun k hk => block_sieve_correction_support_unique hk hj⟩
  · rintro ⟨j, hj, _⟩
    rw [block_sieve_correction_coefficient_eq_at hj]
    exact (block_sieve_correction_at_ne_zero_iff J h n j).mpr hj

theorem block_sieve_correction_coefficient_eq_zero_of_upper {G : Type*} {J : Finset G}
    {h n : G → ℕ} (hu : blockSieveUpperSupport J h n) :
    blockSieveCorrectionCoefficient J h n = 0 := by
  apply block_sieve_correction_coefficient_eq_zero
  rintro ⟨j, hj⟩
  exact block_sieve_upper_correction_disjoint hu hj

section

variable
  {G : Type*}
  (J : Finset G)
  (h n : G → ℕ)

include G J h n

theorem abs_block_sieve_upper_coefficient_le_one  :
    |blockSieveUpperCoefficient J h n| ≤ 1 := by
  classical
  unfold blockSieveUpperCoefficient
  split_ifs <;> simp [abs_pow]

theorem abs_block_sieve_correction_at_le_one  (j : G) :
    |blockSieveCorrectionAt J h n j| ≤ 1 := by
  classical
  unfold blockSieveCorrectionAt
  split_ifs <;> simp [abs_pow]

theorem abs_block_sieve_correction_coefficient_le_one  :
    |blockSieveCorrectionCoefficient J h n| ≤ 1 := by
  classical
  by_cases hex : ∃ j, blockSieveCorrectionSupport J h n j
  · obtain ⟨j, hj⟩ := hex
    rw [block_sieve_correction_coefficient_eq_at hj]
    exact abs_block_sieve_correction_at_le_one J h n j
  · rw [block_sieve_correction_coefficient_eq_zero hex]
    norm_num

theorem block_sieve_lower_coefficient_ne_zero_iff  :
    blockSieveLowerCoefficient J h n ≠ 0 ↔
      blockSieveUpperSupport J h n ∨ ∃! j, blockSieveCorrectionSupport J h n j := by
  classical
  by_cases hu : blockSieveUpperSupport J h n
  · have hc := block_sieve_correction_coefficient_eq_zero_of_upper hu
    simp [blockSieveLowerCoefficient, hc, (block_sieve_upper_coefficient_ne_zero_iff J h n).mpr hu, hu]
  · have hz : blockSieveUpperCoefficient J h n = 0 :=
      not_ne_iff.mp (fun hn => hu ((block_sieve_upper_coefficient_ne_zero_iff J h n).mp hn))
    simp only [blockSieveLowerCoefficient, hz, zero_sub, neg_ne_zero, hu, false_or]
    exact block_sieve_correction_coefficient_ne_zero_iff J h n

theorem abs_block_sieve_lower_coefficient_le_one  :
    |blockSieveLowerCoefficient J h n| ≤ 1 := by
  classical
  by_cases hu : blockSieveUpperSupport J h n
  · rw [blockSieveLowerCoefficient, block_sieve_correction_coefficient_eq_zero_of_upper hu, sub_zero]
    exact abs_block_sieve_upper_coefficient_le_one J h n
  · have hz : blockSieveUpperCoefficient J h n = 0 :=
      not_ne_iff.mp (fun hn => hu ((block_sieve_upper_coefficient_ne_zero_iff J h n).mp hn))
    rw [blockSieveLowerCoefficient, hz, zero_sub, abs_neg]
    exact abs_block_sieve_correction_coefficient_le_one J h n

end


def blockSieveOccupancy {G α : Type*} [DecidableEq α]
    (B : G → Finset α) (S : Finset α) (g : G) : ℕ := (S ∩ B g).card

noncomputable def blockSieveSubsetUpperCoefficient {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (S : Finset α) : ℝ :=
  if S ⊆ J.biUnion B then blockSieveUpperCoefficient J h (blockSieveOccupancy B S) else 0

noncomputable def blockSieveSubsetCorrectionAt {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (j : G) (S : Finset α) : ℝ :=
  if S ⊆ J.biUnion B then blockSieveCorrectionAt J h (blockSieveOccupancy B S) j else 0

noncomputable def blockSieveSubsetLowerCoefficient {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (S : Finset α) : ℝ :=
  if S ⊆ J.biUnion B then blockSieveLowerCoefficient J h (blockSieveOccupancy B S) else 0

section

variable
  {G α : Type*}
  [sharedInstance1 : DecidableEq α]
  (J : Finset G)
  (B : G → Finset α)

include G α sharedInstance1 J B

theorem block_sieve_subset_lower_coefficient_eq  (h : G → ℕ) (S : Finset α) :
    blockSieveSubsetLowerCoefficient J B h S = blockSieveSubsetUpperCoefficient J B h S -
      ∑ j ∈ J, blockSieveSubsetCorrectionAt J B h j S := by
  classical
  by_cases hs : S ⊆ J.biUnion B <;>
    simp [blockSieveSubsetLowerCoefficient, blockSieveSubsetUpperCoefficient,
      blockSieveSubsetCorrectionAt, blockSieveLowerCoefficient, blockSieveCorrectionCoefficient, hs]

theorem abs_block_sieve_subset_upper_coefficient_le_one  (h : G → ℕ) (S : Finset α) :
    |blockSieveSubsetUpperCoefficient J B h S| ≤ 1 := by
  classical
  unfold blockSieveSubsetUpperCoefficient
  split_ifs
  · exact abs_block_sieve_upper_coefficient_le_one _ _ _
  · norm_num

theorem abs_block_sieve_subset_correction_sum_le_one  (h : G → ℕ) (S : Finset α) :
    |∑ j ∈ J, blockSieveSubsetCorrectionAt J B h j S| ≤ 1 := by
  classical
  by_cases hs : S ⊆ J.biUnion B
  · simpa only [blockSieveSubsetCorrectionAt, if_pos hs, blockSieveCorrectionCoefficient] using
      abs_block_sieve_correction_coefficient_le_one J h (blockSieveOccupancy B S)
  · simp [blockSieveSubsetCorrectionAt, hs]

theorem abs_block_sieve_subset_lower_coefficient_le_one  (h : G → ℕ) (S : Finset α) :
    |blockSieveSubsetLowerCoefficient J B h S| ≤ 1 := by
  classical
  unfold blockSieveSubsetLowerCoefficient
  split_ifs
  · exact abs_block_sieve_lower_coefficient_le_one _ _ _
  · norm_num

theorem block_sieve_subset_upper_coefficient_ne_zero_iff  (h : G → ℕ) (S : Finset α) :
    blockSieveSubsetUpperCoefficient J B h S ≠ 0 ↔
      S ⊆ J.biUnion B ∧ blockSieveUpperSupport J h (blockSieveOccupancy B S) := by
  classical
  by_cases hs : S ⊆ J.biUnion B <;>
    simp_all [blockSieveSubsetUpperCoefficient, block_sieve_upper_coefficient_ne_zero_iff]

theorem block_sieve_subset_correction_at_ne_zero_iff  (h : G → ℕ) (j : G) (S : Finset α) :
    blockSieveSubsetCorrectionAt J B h j S ≠ 0 ↔
      S ⊆ J.biUnion B ∧ blockSieveCorrectionSupport J h (blockSieveOccupancy B S) j := by
  classical
  by_cases hs : S ⊆ J.biUnion B <;>
    simp_all [blockSieveSubsetCorrectionAt, block_sieve_correction_at_ne_zero_iff]

theorem block_sieve_subset_lower_coefficient_ne_zero_iff  (h : G → ℕ) (S : Finset α) :
    blockSieveSubsetLowerCoefficient J B h S ≠ 0 ↔ S ⊆ J.biUnion B ∧
      (blockSieveUpperSupport J h (blockSieveOccupancy B S) ∨
        ∃! j, blockSieveCorrectionSupport J h (blockSieveOccupancy B S) j) := by
  classical
  by_cases hs : S ⊆ J.biUnion B <;>
    simp_all [blockSieveSubsetLowerCoefficient, block_sieve_lower_coefficient_ne_zero_iff]

theorem block_sieve_occupancy_sum_eq_card  (S : Finset α)
    (hdisj : (J : Set G).PairwiseDisjoint B) (hs : S ⊆ J.biUnion B) :
    (∑ g ∈ J, blockSieveOccupancy B S g) = S.card := by
  classical
  have he : J.biUnion (fun g => S ∩ B g) = S := by
    ext p
    simp only [mem_biUnion, mem_inter]
    constructor
    · rintro ⟨g, _, hp, _⟩
      exact hp
    · intro hp
      obtain ⟨g, hg, hpg⟩ := mem_biUnion.mp (hs hp)
      exact ⟨g, hg, hp, hpg⟩
  have hd : (J : Set G).PairwiseDisjoint (fun g => S ∩ B g) := by
    intro i hi j hj hij
    exact (hdisj hi hj hij).mono inter_subset_right inter_subset_right
  calc
    _ = (J.biUnion (fun g => S ∩ B g)).card := (card_biUnion hd).symm
    _ = S.card := congrArg Finset.card he

theorem block_sieve_subset_upper_coefficient_eq  (h : G → ℕ) (S : Finset α)
    (hdisj : (J : Set G).PairwiseDisjoint B) (hs : S ⊆ J.biUnion B)
    (hu : blockSieveUpperSupport J h (blockSieveOccupancy B S)) :
    blockSieveSubsetUpperCoefficient J B h S = (-1 : ℝ)^S.card := by
  classical
  simp only [blockSieveSubsetUpperCoefficient, if_pos hs, blockSieveUpperCoefficient,
    if_pos hu, block_sieve_occupancy_sum_eq_card J B S hdisj hs]

end














/- Arbitrary finite-subset weights can be evaluated term by term, so in
particular this applies to the monomial `w S = ∏ p ∈ S, x p`. -/
theorem block_sieve_subset_weighted_expansion {G α : Type*} [DecidableEq α]
    (J : Finset G) (B : G → Finset α) (h : G → ℕ) (w : Finset α → ℝ) :
    (∑ S ∈ (J.biUnion B).powerset, blockSieveSubsetLowerCoefficient J B h S * w S) =
      (∑ S ∈ (J.biUnion B).powerset, blockSieveSubsetUpperCoefficient J B h S * w S) -
        ∑ j ∈ J, ∑ S ∈ (J.biUnion B).powerset, blockSieveSubsetCorrectionAt J B h j S * w S := by
  simp_rw [block_sieve_subset_lower_coefficient_eq, sub_mul, sum_sub_distrib, sum_mul]
  rw [sum_comm]



end

section
open Finset
theorem block_sieve_model_product_upper {G : Type*} (s : Finset G)
    (a e u : G → ℝ) (ha : ∀ g ∈ s, 0 < a g)
    (hu : ∀ g ∈ s, 0 ≤ u g) (hub : ∀ g ∈ s, u g ≤ a g + e g) :
    (∏ g ∈ s, u g) ≤ (∏ g ∈ s, a g) * Real.exp (∑ g ∈ s, e g / a g) := by
  calc
    _ ≤ ∏ g ∈ s, a g * Real.exp (e g / a g) := by
      apply prod_le_prod₀ hu
      intro g hg
      apply (hub g hg).trans
      have h := mul_le_mul_of_nonneg_left (Real.add_one_le_exp (e g / a g)) (ha g hg).le
      have he : a g * (e g / a g + 1) = a g + e g := by
        field_simp [(ha g hg).ne']; ring
      rwa [he] at h
    _ = _ := by rw [prod_mul_distrib, Real.exp_sum]

theorem block_sieve_model_correction_upper {G : Type*} [DecidableEq G]
    (s : Finset G) (a e u : G → ℝ) (ha : ∀ g ∈ s, 0 < a g)
    (he : ∀ g ∈ s, 0 ≤ e g) (hu : ∀ g ∈ s, 0 ≤ u g)
    (hub : ∀ g ∈ s, u g ≤ a g + e g) :
    (∑ j ∈ s, e j * ∏ g ∈ s.erase j, u g) ≤
      (∏ g ∈ s, a g) * (∑ g ∈ s, e g / a g) *
        Real.exp (∑ g ∈ s, e g / a g) := by
  have hterm : ∀ j ∈ s,
      e j * (∏ g ∈ s.erase j, u g) ≤
        (∏ g ∈ s, a g) * (e j / a j) * Real.exp (∑ g ∈ s, e g / a g) := by
    intro j hj
    have hprod := block_sieve_model_product_upper (s.erase j) a e u
      (fun g hg => ha g (mem_of_mem_erase hg))
      (fun g hg => hu g (mem_of_mem_erase hg))
      (fun g hg => hub g (mem_of_mem_erase hg))
    have hsum : (∑ g ∈ s.erase j, e g / a g) ≤ ∑ g ∈ s, e g / a g := by
      apply sum_le_sum_of_subset_of_nonneg (erase_subset j s)
      intro g hg _
      exact div_nonneg (he g hg) (ha g hg).le
    have hid : e j * (∏ g ∈ s.erase j, a g) = (∏ g ∈ s, a g) * (e j / a j) := by
      rw [← prod_erase_mul s a hj]
      field_simp [(ha j hj).ne']
    calc
      _ ≤ e j * ((∏ g ∈ s.erase j, a g) * Real.exp (∑ g ∈ s.erase j, e g / a g)) :=
        mul_le_mul_of_nonneg_left hprod (he j hj)
      _ ≤ e j * ((∏ g ∈ s.erase j, a g) * Real.exp (∑ g ∈ s, e g / a g)) := by
        apply mul_le_mul_of_nonneg_left _ (he j hj)
        exact mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr hsum)
          (prod_nonneg (fun g hg => (ha g (mem_of_mem_erase hg)).le))
      _ = _ := by rw [← mul_assoc, hid]
  calc
    _ ≤ ∑ j ∈ s, (∏ g ∈ s, a g) * (e j / a j) * Real.exp (∑ g ∈ s, e g / a g) :=
      sum_le_sum hterm
    _ = _ := by rw [← sum_mul, ← mul_sum]






end

section
open Finset
theorem factorial_term_le_exp_decay {C : ℝ} (hC : 0 ≤ C) (n : ℕ) :
    C^n / (n.factorial : ℝ) ≤
      Real.exp (C * Real.exp 1) * Real.exp (-(n : ℝ)) := by
  have hexp : (Real.exp 1)^n * Real.exp (-(n : ℝ)) = 1 := by
    rw [← Real.exp_nat_mul, mul_one, ← Real.exp_add]
    simp
  calc
    C^n / (n.factorial : ℝ) =
        ((C * Real.exp 1)^n / (n.factorial : ℝ)) * Real.exp (-(n : ℝ)) := by
      rw [mul_pow]
      calc
        _ = (C^n / (n.factorial : ℝ)) *
            ((Real.exp 1)^n * Real.exp (-(n : ℝ))) := by rw [hexp, mul_one]
        _ = _ := by ring
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (Real.pow_div_factorial_le_exp (C * Real.exp 1)
        (mul_nonneg hC (Real.exp_pos _).le) n)
      (Real.exp_pos _).le

theorem finite_sum_exp_neg_nat_le (J : Finset ℕ) :
    (∑ j ∈ J, Real.exp (-(j : ℝ))) ≤ (1 - Real.exp (-1))⁻¹ := by
  have hlt : Real.exp (-1) < 1 := Real.exp_lt_one_iff.mpr (by norm_num)
  have hs := hasSum_geometric_of_lt_one (Real.exp_pos (-1)).le hlt
  calc
    (∑ j ∈ J, Real.exp (-(j : ℝ))) = ∑ j ∈ J, (Real.exp (-1))^j := by
      apply sum_congr rfl
      intro j _
      rw [← Real.exp_nat_mul, mul_neg_one]
    _ ≤ ∑' j : ℕ, (Real.exp (-1))^j :=
      hs.summable.sum_le_tsum J (fun _ _ => by positivity)
    _ = _ := hs.tsum_eq

theorem block_sieve_factorial_tail_bound {C : ℝ} (hC : 0 ≤ C)
    {h : ℕ} (hh : 1 ≤ h) (J : Finset ℕ) :
    (∑ j ∈ J, C^((j + 1)*h + 1) / (((j + 1)*h + 1).factorial : ℝ)) ≤
      (Real.exp (C * Real.exp 1) / (1 - Real.exp (-1))) * Real.exp (-(h : ℝ)) := by
  have hterm (j : ℕ) :
      C^((j + 1)*h + 1) / (((j + 1)*h + 1).factorial : ℝ) ≤
        (Real.exp (C * Real.exp 1) * Real.exp (-(h : ℝ))) *
          Real.exp (-(j : ℝ)) := by
    have hn : h + j ≤ (j + 1)*h + 1 := by nlinarith
    have hn' : (h : ℝ) + j ≤ (((j + 1)*h + 1 : ℕ) : ℝ) := by exact_mod_cast hn
    calc
      _ ≤ Real.exp (C * Real.exp 1) *
          Real.exp (-((((j + 1)*h + 1 : ℕ) : ℝ))) := factorial_term_le_exp_decay hC _
      _ ≤ Real.exp (C * Real.exp 1) * Real.exp (-(h : ℝ) - (j : ℝ)) := by
        apply mul_le_mul_of_nonneg_left _ (Real.exp_pos _).le
        apply Real.exp_le_exp.mpr
        linarith
      _ = _ := by rw [sub_eq_add_neg, Real.exp_add]; ring
  calc
    _ ≤ ∑ j ∈ J, (Real.exp (C * Real.exp 1) * Real.exp (-(h : ℝ))) *
        Real.exp (-(j : ℝ)) := sum_le_sum (fun j _ => hterm j)
    _ = (Real.exp (C * Real.exp 1) * Real.exp (-(h : ℝ))) *
        (∑ j ∈ J, Real.exp (-(j : ℝ))) := (mul_sum ..).symm
    _ ≤ (Real.exp (C * Real.exp 1) * Real.exp (-(h : ℝ))) *
        (1 - Real.exp (-1))⁻¹ :=
      mul_le_mul_of_nonneg_left (finite_sum_exp_neg_nat_le J) (by positivity)
    _ = _ := by ring



end

section
open Finset
theorem block_sieve_dyadic_degree_sum (J : Finset ℕ) (h : ℕ) :
    (∑ j ∈ J, (((j + 1) * h + 1 : ℕ) : ℝ) / (2 : ℝ)^j) ≤ 4 * (h : ℝ) + 2 := by
  have hg : HasSum (fun j : ℕ => (1/2 : ℝ)^j) 2 := by
    convert! hasSum_geometric_of_lt_one (by norm_num : (0 : ℝ) ≤ 1/2)
      (by norm_num : (1/2 : ℝ) < 1) using 1; norm_num
  have hn : HasSum (fun j : ℕ => (j : ℝ) * (1/2 : ℝ)^j) 2 := by
    convert! hasSum_coe_mul_geometric_of_norm_lt_one
      (by norm_num : ‖(1/2 : ℝ)‖ < 1) using 1; norm_num
  have hall : HasSum (fun j : ℕ => (((j + 1) * h + 1 : ℕ) : ℝ) / (2 : ℝ)^j)
      (4 * (h : ℝ) + 2) := by
    convert! ((hn.add hg).mul_left (h : ℝ)).add hg using 1
    · ext j
      simp only [Nat.cast_add, Nat.cast_mul, Nat.cast_one, div_pow, one_pow]
      ring
    · ring
  exact (hall.summable.sum_le_tsum J (fun j _ => by positivity)).trans_eq hall.tsum_eq

theorem block_sieve_weighted_degree_sum (J : Finset ℕ) (h : ℕ) (n : ℕ → ℕ)
    (hn : ∀ j ∈ J, n j ≤ (j + 1) * h + 1) :
    (∑ j ∈ J, (n j : ℝ) / (2 : ℝ)^j) ≤ 4 * (h : ℝ) + 2 := by
  apply le_trans _ (block_sieve_dyadic_degree_sum J h)
  exact sum_le_sum (fun j hj => div_le_div_of_nonneg_right
    (Nat.cast_le.mpr (hn j hj)) (by positivity))

theorem block_sieve_log_product_level {ι : Type*} [DecidableEq ι]
    (J : Finset ℕ) (B : ℕ → Finset ι) (x : ι → ℝ) (h : ℕ) {z : ℝ}
    (hz : 1 ≤ z) (hdisj : (J : Set ℕ).PairwiseDisjoint B)
    (hpos : ∀ j ∈ J, ∀ p ∈ B j, 0 < x p)
    (hsize : ∀ j ∈ J, ∀ p ∈ B j, Real.log (x p) ≤ Real.log z / (2 : ℝ)^j)
    (hcard : ∀ j ∈ J, (B j).card ≤ (j + 1) * h + 1) :
    (∏ p ∈ J.biUnion B, x p) ≤ z^(4 * (h : ℝ) + 2) := by
  have hz0 : 0 < z := zero_lt_one.trans_le hz
  have hprodpos : 0 < ∏ p ∈ J.biUnion B, x p := by
    apply prod_pos
    intro p hp
    obtain ⟨j, hj, hp⟩ := mem_biUnion.mp hp
    exact hpos j hj p hp
  have hlog : Real.log (∏ p ∈ J.biUnion B, x p) ≤ (4 * (h : ℝ) + 2) * Real.log z := by
    rw [prod_biUnion hdisj, Real.log_prod (fun j hj => ne_of_gt (prod_pos (hpos j hj)))]
    calc
      _ = ∑ j ∈ J, ∑ p ∈ B j, Real.log (x p) := by
        apply sum_congr rfl
        intro j hj
        exact Real.log_prod (fun p hp => ne_of_gt (hpos j hj p hp))
      _ ≤ ∑ j ∈ J, ((B j).card : ℝ) * (Real.log z / (2 : ℝ)^j) := by
        apply sum_le_sum
        intro j hj
        exact (sum_le_sum (hsize j hj)).trans_eq (by simp)
      _ = (∑ j ∈ J, ((B j).card : ℝ) / (2 : ℝ)^j) * Real.log z := by
        rw [sum_mul]
        apply sum_congr rfl
        intro j _
        ring
      _ ≤ _ := mul_le_mul_of_nonneg_right
        (block_sieve_weighted_degree_sum J h (fun j => (B j).card) hcard) (Real.log_nonneg hz)
  rw [← Real.exp_log hprodpos, Real.rpow_def_of_pos hz0]
  exact Real.exp_le_exp.mpr (by simpa only [mul_comm (Real.log z)] using hlog)
end

section
open Finset
noncomputable def subsetPolynomial {ι : Type*} (P : Finset ι)
    (a : Finset ι → ℝ) (x : ι → ℝ) : ℝ :=
  ∑ S ∈ P.powerset, a S * ∏ p ∈ S, x p

section

variable
  {ι Ω : Type*}
  (P : Finset ι)
  (T : Finset Ω)
  (a r : Finset ι → ℝ)
  (μ : Ω → ℝ)
  (x : Ω → ι → ℝ)
  (g : ι → ℝ)
  (X : ℝ)

include ι Ω P T a r μ x g X

theorem subset_polynomial_average_identity 
    (hmoment : ∀ S ∈ P.powerset,
      (∑ t ∈ T, μ t * ∏ p ∈ S, x t p) = X * (∏ p ∈ S, g p) + r S) :
    (∑ t ∈ T, μ t * subsetPolynomial P a (x t)) - X * subsetPolynomial P a g =
      ∑ S ∈ P.powerset, a S * r S := by
  have heq : (∑ t ∈ T, μ t * subsetPolynomial P a (x t)) =
      ∑ S ∈ P.powerset, a S * (∑ t ∈ T, μ t * ∏ p ∈ S, x t p) := by
    simp only [subsetPolynomial, mul_sum]
    rw [sum_comm]
    apply sum_congr rfl
    intro S _
    apply sum_congr rfl
    intro t _
    ring
  rw [heq]
  have hmainsum : (∑ S ∈ P.powerset, a S * (∑ t ∈ T, μ t * ∏ p ∈ S, x t p)) =
      ∑ S ∈ P.powerset, a S * (X * (∏ p ∈ S, g p) + r S) := by
    apply sum_congr rfl
    intro S hS
    rw [hmoment S hS]
  rw [hmainsum]
  simp only [subsetPolynomial, mul_add, sum_add_distrib, mul_sum]
  have hmain : (∑ S ∈ P.powerset, a S * (X * ∏ p ∈ S, g p)) =
      ∑ S ∈ P.powerset, X * (a S * ∏ p ∈ S, g p) := by
    apply sum_congr rfl
    intro S _
    ring
  rw [hmain]
  ring

theorem subset_polynomial_average_error 
    (ha : ∀ S ∈ P.powerset, |a S| ≤ 1)
    (hmoment : ∀ S ∈ P.powerset,
      (∑ t ∈ T, μ t * ∏ p ∈ S, x t p) = X * (∏ p ∈ S, g p) + r S) :
    |(∑ t ∈ T, μ t * subsetPolynomial P a (x t)) - X * subsetPolynomial P a g| ≤
      ∑ S ∈ P.powerset, if a S = 0 then 0 else |r S| := by
  classical
  rw [subset_polynomial_average_identity P T a r μ x g X hmoment]
  apply (abs_sum_le_sum_abs _ _).trans
  apply sum_le_sum
  intro S hS
  by_cases hzero : a S = 0
  · simp [hzero]
  · rw [if_neg hzero, abs_mul]
    exact mul_le_of_le_one_left (abs_nonneg _) (ha S hS)

end


theorem subset_polynomial_sandwich_transfer {ι Ω : Type*}
    (P : Finset ι) (T : Finset Ω) (a b : Finset ι → ℝ)
    (μ F : Ω → ℝ) (x : Ω → ι → ℝ) (g : ι → ℝ) (X A E R : ℝ)
    (hμ : ∀ t ∈ T, 0 ≤ μ t) (hX : 0 ≤ X)
    (hpoint : ∀ t ∈ T, subsetPolynomial P b (x t) ≤ F t ∧
      F t ≤ subsetPolynomial P a (x t))
    (hmodela : |subsetPolynomial P a g - A| ≤ E)
    (hmodelb : |subsetPolynomial P b g - A| ≤ E)
    (herra : |(∑ t ∈ T, μ t * subsetPolynomial P a (x t)) - X * subsetPolynomial P a g| ≤ R)
    (herrb : |(∑ t ∈ T, μ t * subsetPolynomial P b (x t)) - X * subsetPolynomial P b g| ≤ R) :
    |(∑ t ∈ T, μ t * F t) - X * A| ≤ X * E + R := by
  have hlo : (∑ t ∈ T, μ t * subsetPolynomial P b (x t)) ≤ ∑ t ∈ T, μ t * F t :=
    sum_le_sum (fun t ht => mul_le_mul_of_nonneg_left (hpoint t ht).1 (hμ t ht))
  have hhi : (∑ t ∈ T, μ t * F t) ≤ ∑ t ∈ T, μ t * subsetPolynomial P a (x t) :=
    sum_le_sum (fun t ht => mul_le_mul_of_nonneg_left (hpoint t ht).2 (hμ t ht))
  have hma := mul_le_mul_of_nonneg_left (abs_le.mp hmodela).2 hX
  have hmb := mul_le_mul_of_nonneg_left (abs_le.mp hmodelb).1 hX
  apply abs_le.mpr
  constructor <;> nlinarith [(abs_le.mp herra).2, (abs_le.mp herrb).1]
end

