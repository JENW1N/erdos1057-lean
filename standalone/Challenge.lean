open Finset
theorem indexed_free_prime_mass_lower {T : Type*} [Fintype T]
    (S P : Finset ℕ) (W : ℕ → ℝ) (R : T → ℕ) (N X H : ℝ)
    (hN : 0 ≤ N) (hW : ∀ n ∈ S, 0 ≤ W n)
    (hcount : ∀ n ∈ S, ∀ t : T,
      (X / ((n * R t : ℕ) : ℝ)) * H ≤
        ((primeProductWindow P ((n * R t : ℕ) : ℝ) X).card : ℝ)) :
    X * H * (∑ n ∈ S, W n / (n : ℝ)) *
      (∑ t : T, (1 / (R t : ℝ)) / N) ≤
      ∑ n ∈ S, ∑ t : T,
        (W n / N) * ((primeProductWindow P ((n * R t : ℕ) : ℝ) X).card : ℝ) := by
  classical
  calc
    _ = ∑ n ∈ S, ∑ t : T,
        (W n / N) * ((X / ((n * R t : ℕ) : ℝ)) * H) := by
      simp only [mul_sum, sum_mul]
      rw [sum_comm]
      apply sum_congr rfl
      intro n hn
      apply sum_congr rfl
      intro t ht
      simp only [Nat.cast_mul, div_eq_mul_inv, mul_inv]
      ring
    _ ≤ _ := by
      apply sum_le_sum
      intro n hn
      apply sum_le_sum
      intro t ht
      exact mul_le_mul_of_nonneg_left (hcount n hn t) (div_nonneg (hW n hn) hN)



end

