/- The concrete prime row, extended by zero outside the active disjoint
subset pairs. The valid branch retains the literal physical auxiliary sum. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def repeatedBigPrimeRawRow
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (ζ Θ : ℝ)
    (source target : RepeatedBigLists P J ell) : ℂ :=
  ∑ aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))),
    repeatedBigUnbannedKernel V (fun _ _ => 1) (fun _ => ∅) ζ (fun _ _ _ => 1)
      aux source target * physicalReturnPhase Θ (repeatedBigD (fun _ => ∅) source aux)

theorem repeated_big_active_pair_avoids_tail
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    {A B : Finset (RepeatedBigFlatIndex G J ell)}
    (hA : A ⊆ repeatedBigFlatActive J ell) (hB : B ⊆ repeatedBigFlatActive J ell) :
    ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B := by
  intro g j hj
  exact repeatedBigFlatActive_not_mem_inr J ell g j
    ((union_subset hA hB) hj)

noncomputable def repeatedBigPrimeComparisonRow
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell)) (Q : ℕ) (h : ℝ)
    (keptA keptB : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ)
    (ζ Θ : ℝ) : RepeatedBigLists P J ell → RepeatedBigLists P J ell → ℂ :=
  if hvalid : A ⊆ repeatedBigFlatActive J ell ∧
      B ⊆ repeatedBigFlatActive J ell ∧ Disjoint A B then
    repeatedBigPrimeRow P V A B
      (repeated_big_active_pair_avoids_tail hvalid.1 hvalid.2.1) hvalid.2.2
      Q h keptA keptB ζ Θ
  else 0

theorem repeatedBigPrimeComparisonRow_eq
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hA : A ⊆ repeatedBigFlatActive J ell) (hB : B ⊆ repeatedBigFlatActive J ell)
    (hAB : Disjoint A B) (Q : ℕ) (h : ℝ)
    (keptA keptB : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ) (ζ Θ : ℝ) :
    repeatedBigPrimeComparisonRow P V A B Q h keptA keptB ζ Θ =
      repeatedBigPrimeRow P V A B (repeated_big_active_pair_avoids_tail hA hB)
        hAB Q h keptA keptB ζ Θ := by
  unfold repeatedBigPrimeComparisonRow
  rw [dif_pos (show A ⊆ repeatedBigFlatActive J ell ∧
    B ⊆ repeatedBigFlatActive J ell ∧ Disjoint A B from ⟨hA, hB, hAB⟩)]




theorem repeated_big_prime_comparison_pairing_eq
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hA : A ⊆ repeatedBigFlatActive J ell) (hB : B ⊆ repeatedBigFlatActive J ell)
    (hAB : Disjoint A B) (Q : ℕ) (h : ℝ)
    (keptA keptB : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ)
    (ζ Θ : ℝ) (f g : RepeatedBigLists P J ell → ℂ) :
    cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigPrimeComparisonRow P V A B Q h keptA keptB ζ Θ) f g =
    cleanKernelPairing
      (finiteProductWeight (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1))
      (primeAsymmetricComparisonKernel (fun i : RepeatedBigFlatIndex G J ell => P i.1)
        (fun i => V i.1) (repeatedBigFlatActive J ell) Q h keptA keptB ζ Θ A B)
      (finiteGroupFlattenFunction f) (finiteGroupFlattenFunction g) := by
  rw [repeatedBigPrimeComparisonRow_eq P V A B hA hB hAB]
  exact repeated_big_prime_pairing_eq P V A B
    (repeated_big_active_pair_avoids_tail hA hB) hAB Q h keptA keptB ζ Θ f g

theorem repeated_big_prime_comparison_pairing_tail_eq
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (hV : ∀ g, 0 < V g) (hP : ∀ g p, p ∈ P g → 0 < p)
    (hmass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hA : A ⊆ repeatedBigFlatActive J ell) (hB : B ⊆ repeatedBigFlatActive J ell)
    (hAB : Disjoint A B) (Q : ℕ) (h : ℝ)
    (keptA keptB : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ)
    (ζ Θ : ℝ) (f g : RepeatedBigLists P J ell → ℂ) :
    cleanKernelPairing (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigPrimeComparisonRow P V A B Q h keptA keptB ζ Θ) f g =
    cleanKernelPairing
      (finiteProductWeight (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1))
      (primeAsymmetricComparisonKernel (fun i : RepeatedBigFlatIndex G J ell => P i.1)
        (fun i => V i.1) (repeatedBigFlatActive J ell) Q h keptA keptB ζ Θ A B)
      (finiteCoordinateComponent (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1)
        ∅ (repeatedBigFlatActive J ell)ᶜ.toList (finiteGroupFlattenFunction f))
      (finiteCoordinateComponent (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1)
        ∅ (repeatedBigFlatActive J ell)ᶜ.toList (finiteGroupFlattenFunction g)) := by
  rw [repeated_big_prime_comparison_pairing_eq P V A B hA hB hAB]
  apply finite_asymmetric_comparison_pairing_tail_projection
    (fun i : RepeatedBigFlatIndex G J ell => physicalLabelLaw V i.1)
    (fun i => physical_label_law_sum V i.1 (hV i.1) (hmass i.1))
    (repeatedBigFlatActive J ell) A B hA hB
  intro i _ p
  unfold physicalLabelLaw
  apply div_ne_zero one_ne_zero
  exact mul_ne_zero (hV i.1).ne' (by exact_mod_cast (hP i.1 p.val p.property).ne')

theorem repeated_big_active_mass_product
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (V : G → ℝ) :
    repeatedBigActiveMass (J := J) (ell := ell) V (fun _ _ => 1) =
      finiteProductWeight (fun g => finiteProductWeight
        (fun _ : PhysicalSlots J ell => physicalLabelLaw (P := P) V g)) := by
  funext source
  simp only [repeatedBigActiveMass, finiteProductWeight, tiltedPhysicalBirthLaw, div_one]

end Bounty
end

