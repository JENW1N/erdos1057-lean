open scoped BigOperators
theorem finite_fiber_bilinear_sum {X Y : Type*} [Fintype X] [Fintype Y]
    [DecidableEq Y] (π : X → Y) (a : X → ℂ) (b : Y → X → ℂ) (c : Y → ℂ) :
    (∑ d, (∑ x ∈ Finset.univ.filter (fun x => π x = d), a x) * c d *
      (∑ y ∈ Finset.univ.filter (fun y => π y = d), b d y)) =
      ∑ x, ∑ y, if π x = π y then a x * c (π x) * b (π x) y else 0 := by
  classical
  simp only [Finset.sum_filter]
  simp_rw [Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro x _
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro y _
  calc
    (∑ d, (if π x = d then a x else 0) * c d * (if π y = d then b d y else 0)) =
        ∑ d, if π x = d then (if π y = d then a x * c d * b d y else 0) else 0 := by
      apply Finset.sum_congr rfl
      intro d _
      split_ifs <;> ring
    _ = _ := by simp [eq_comm]
end

