theorem weightedCoeff_hasSum {q : ℕ} (χ : DirichletCharacter ℂ q)
    (S : Finset (Ideal ActualEisensteinCubic.O)) (W : ℝ→ℂ) (b Z : ℝ) (hZ : 0<Z)
    (hW : ∀x,W x≠0→x≤b) (D : ℕ) (hD : b*Z≤D) :
