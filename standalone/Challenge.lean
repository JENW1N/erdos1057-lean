/- The local Fourier-to-Mellin estimate on the same positive integer
support and rational-center modulation used by the auxiliary major arcs. -/

open Finset MeasureTheory
namespace Bounty

theorem finite_fourier_modulated_energy (S : Finset ℤ) (f : ℤ → ℂ)
    (hS : ∀ n ∈ S, 0 ≤ n) (c : ℝ) :
    (∑ n ∈ S.image Int.natAbs,
      ‖f n * fourier (n : ℤ) (c : AddCircle (1 : ℝ))‖^2) =
      ∑ n ∈ S, ‖f n‖^2 := by
  rw [sum_image]
  · apply sum_congr rfl
    intro n hn
    rw [Int.natAbs_of_nonneg (hS n hn), norm_mul, fourier_apply, Circle.norm_coe, mul_one]
  · intro a ha b hb hab
    have he := congrArg (fun n : ℕ => (n : ℤ)) hab
    simpa only [Int.natAbs_of_nonneg (hS a ha), Int.natAbs_of_nonneg (hS b hb)] using he




end Bounty
