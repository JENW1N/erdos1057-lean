section Kernels
variable {I : Type*} [Fintype I] {R : I → Type*}
  [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]

noncomputable def ghostPhaseTensorDiagonal (h : (p : I) → R p) (ρ : I → ℝ)
    (z : (p : I) → GhostPhaseState (R p)) : ℝ :=
  ∏ p, ghostPhaseDiagonal (h p) (ρ p) (z p)

noncomputable def ghostPhaseCappedVisit (a : I → Bool) (h : (p : I) → R p)
    (η β : I → ℝ) (cap : ℕ) (z w : (p : I) → GhostPhaseState (R p)) : ℝ :=
  if (ghostPhasePendingSupport z).card ≤ cap then
    ∏ p, ghostPhaseVisit (a p) (h p) (η p) (β p) (z p) (w p) else 0

noncomputable def ghostPhaseCappedDampedVisit (a : I → Bool) (h : (p : I) → R p)
    (η β ρ : I → ℝ) (cap : ℕ) (z w : (p : I) → GhostPhaseState (R p)) : ℝ :=
  if (ghostPhasePendingSupport z).card ≤ cap then
    ∏ p, ghostPhaseDampedVisit (a p) (h p) (η p) (β p) (ρ p) (z p) (w p) else 0

noncomputable def ghostPhaseCappedEdge (atgt asrc : I → Bool)
    (htgt hsrc : (p : I) → R p) (β V : I → ℝ) (cap : ℕ)
    (z w : (p : I) → GhostPhaseState (R p)) : ℝ :=
  if (ghostPhasePendingSupport z).card ≤ cap then
    ∏ p, (if atgt p && !(asrc p) then (V p)⁻¹ else 1) *
      ghostPhaseEdge (atgt p) (asrc p) (htgt p) (hsrc p) (β p) (z p) (w p) else 0

noncomputable def ghostPhaseCappedDampedEdge (atgt asrc : I → Bool)
    (htgt hsrc : (p : I) → R p) (β V ρtgt ρsrc : I → ℝ) (cap : ℕ)
    (z w : (p : I) → GhostPhaseState (R p)) : ℝ :=
  if (ghostPhasePendingSupport z).card ≤ cap then
    ∏ p, (if atgt p && !(asrc p) then (V p)⁻¹ else 1) *
      ghostPhaseDampedEdge (atgt p) (asrc p) (htgt p) (hsrc p) (β p)
        (ρtgt p) (ρsrc p) (z p) (w p) else 0

omit [∀ p, Fintype (R p)] in
theorem ghost_phase_tensor_diagonal_ne_zero (h : (p : I) → R p) (ρ : I → ℝ)
    (hρ : ∀ p, ρ p ≠ 0) (z : (p : I) → GhostPhaseState (R p)) :
    ghostPhaseTensorDiagonal h ρ z ≠ 0 :=
  prod_ne_zero_iff.mpr (fun p _ => ghostPhaseDiagonal_ne_zero (h p) (hρ p) (z p))

omit [∀ p, Fintype (R p)] in
theorem ghost_phase_capped_visit_diagonal (a : I → Bool) (h : (p : I) → R p)
    (η β ρ : I → ℝ) (cap : ℕ) (z w : (p : I) → GhostPhaseState (R p)) :
    ghostPhaseCappedDampedVisit a h η β ρ cap z w =
      ghostPhaseCappedVisit a h η β cap z w /
        (ghostPhaseTensorDiagonal h ρ z * ghostPhaseTensorDiagonal h ρ w) := by
  unfold ghostPhaseCappedDampedVisit ghostPhaseCappedVisit
  split_ifs
  · simp only [ghostPhaseDampedVisit, prod_div_distrib, prod_mul_distrib,
      ghostPhaseTensorDiagonal]
  · exact (zero_div _).symm

theorem ghost_phase_capped_edge_diagonal (atgt asrc : I → Bool)
    (htgt hsrc : (p : I) → R p) (β V ρtgt ρsrc : I → ℝ) (cap : ℕ)
    (z w : (p : I) → GhostPhaseState (R p)) :
    ghostPhaseCappedDampedEdge atgt asrc htgt hsrc β V ρtgt ρsrc cap z w =
      ghostPhaseTensorDiagonal htgt ρtgt z *
        ghostPhaseCappedEdge atgt asrc htgt hsrc β V cap z w *
          ghostPhaseTensorDiagonal hsrc ρsrc w := by
  unfold ghostPhaseCappedDampedEdge ghostPhaseCappedEdge
  split_ifs
  · simp only [ghostPhaseDampedEdge, prod_mul_distrib, ghostPhaseTensorDiagonal]
    ring
  · ring

end Kernels

section History
variable {I : Type*} [Fintype I] [DecidableEq I] {R : I → Type*}
  [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
  (a : I → ℕ → Bool) (h : (p : I) → ℕ → R p) (η : I → ℕ → ℝ)
  (β V : I → ℝ) (ρ : I → ℕ → ℝ) (visitCap edgeCap : ℕ → ℕ)

noncomputable def ghostPhaseCappedHistory (n : ℕ) : ℝ :=
  finiteAlternatingPairing
    (fun j => ghostPhaseCappedVisit (fun p => a p j) (fun p => h p j)
      (fun p => η p j) β (visitCap j))
    (fun j => ghostPhaseCappedEdge (fun p => a p (j + 1)) (fun p => a p j)
      (fun p => h p (j + 1)) (fun p => h p j) β V (edgeCap j))
    (fun z => ∏ p, ghostPhaseRunInitial (a p 0) (β p) (V p) (z p))
    (fun z => ∏ p, ghostPhaseTerminal (a p n) (z p)) n

noncomputable def ghostPhaseCappedDampedHistory (n : ℕ) : ℝ :=
  finiteAlternatingPairing
    (fun j => ghostPhaseCappedDampedVisit (fun p => a p j) (fun p => h p j)
      (fun p => η p j) β (fun p => ρ p j) (visitCap j))
    (fun j => ghostPhaseCappedDampedEdge (fun p => a p (j + 1)) (fun p => a p j)
      (fun p => h p (j + 1)) (fun p => h p j) β V
      (fun p => ρ p (j + 1)) (fun p => ρ p j) (edgeCap j))
    (fun z => ∏ p, ghostPhaseRunInitial (a p 0) (β p) (V p) (z p))
    (fun z => ∏ p, ghostPhaseTerminal (a p n) (z p)) n

/- Exact tensor rho cancellation with all visit and edge cutoffs retained.
The rho values may vary independently by prime and physical vertex. -/
theorem ghost_phase_capped_damped_history_eq (hρ : ∀ p j, ρ p j ≠ 0) (n : ℕ) :
    ghostPhaseCappedDampedHistory a h η β V ρ visitCap edgeCap n =
      ghostPhaseCappedHistory a h η β V visitCap edgeCap n := by
  unfold ghostPhaseCappedDampedHistory ghostPhaseCappedHistory finiteAlternatingPairing
  simp_rw [finite_alternating_action, ghost_phase_capped_visit_diagonal,
    ghost_phase_capped_edge_diagonal]
  refine alternating_visit_edge_diagonal_pairing
    (fun j => ghostPhaseCappedVisit (fun p => a p j) (fun p => h p j)
      (fun p => η p j) β (visitCap j))
    (fun j => ghostPhaseCappedEdge (fun p => a p (j + 1)) (fun p => a p j)
      (fun p => h p (j + 1)) (fun p => h p j) β V (edgeCap j))
    (fun j => ghostPhaseTensorDiagonal (fun p => h p j) (fun p => ρ p j))
    ?_ (fun z => ∏ p, ghostPhaseRunInitial (a p 0) (β p) (V p) (z p))
    (fun z => ∏ p, ghostPhaseTerminal (a p n) (z p)) n ?_ ?_
  · intro j z
    exact ghost_phase_tensor_diagonal_ne_zero _ _ (fun p => hρ p j) z
  · intro z hz
    apply prod_eq_one
    intro p _
    have hp := prod_ne_zero_iff.mp hz p (mem_univ p)
    have hi : ghostPhaseInitial (a p 0) (β p) (z p) ≠ 0 :=
      (mul_ne_zero_iff.mp hp).2
    exact ghost_phase_initial_diagonal_one (a p 0) (h p 0) (β p) (ρ p 0) (z p) hi
  · intro z hz
    apply prod_eq_one
    intro p _
    exact ghost_phase_terminal_diagonal_one (a p n) (h p n) (ρ p n) (z p)
      (prod_ne_zero_iff.mp hz p (mem_univ p))

end History
