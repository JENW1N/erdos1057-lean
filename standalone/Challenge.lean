section

/- Direct finite weighted energy bounds for the signed clean-prime operator. -/

open Finset Real
namespace ThirdCleanEnergy
open Bounty


theorem norm_mono {X : Type*} [Fintype X] (μ ν : X → ℝ)
    (h : ∀ x, μ x ≤ ν x) (f : X → ℂ) :
    cleanActiveNorm μ f ≤ cleanActiveNorm ν f := by
  apply sqrt_le_sqrt
  exact sum_le_sum fun x _ => mul_le_mul_of_nonneg_right (h x) (sq_nonneg _)

theorem norm_le_scaled {X : Type*} [Fintype X] (μ ν : X → ℝ)
    {C : ℝ} (hC : 0 ≤ C) (h : ∀ x, ν x ≤ C * μ x) (f : X → ℂ) :
    cleanActiveNorm ν f ≤ sqrt C * cleanActiveNorm μ f := by
  unfold cleanActiveNorm
  rw [← sqrt_mul hC, mul_sum]
  apply sqrt_le_sqrt
  exact sum_le_sum fun x _ => by
    simpa only [mul_assoc] using mul_le_mul_of_nonneg_right (h x) (sq_nonneg ‖f x‖)

end ThirdCleanEnergy
