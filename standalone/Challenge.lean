  invFun x := (physicalFullStateLabels C x.val x.property, fun g => (x.val g).2)
  left_inv s := by
    apply Prod.ext
    · exact physical_full_state_labels_encode C s.1 s.2
    · rfl
  right_inv x := by
    apply Subtype.ext
    exact physical_full_state_encode_labels C x.val x.property

