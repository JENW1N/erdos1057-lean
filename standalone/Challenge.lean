    _ ≤ ∏ _g : G, (2 : ℝ)^k := by
      apply Finset.prod_le_prod₀
      · intro g _; exact pow_nonneg (hmass g).1 k
      · intro g _; exact pow_le_pow_left₀ (hmass g).1 (hmass g).2 k
