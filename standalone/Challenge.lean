/- A selected child cannot be inactive. Root weights are unchanged. -/
noncomputable def birthForestOptionalWeights {n : ℕ} {α : Type*}
    (code : BirthForestCode n) (w : BirthForestCausalWeights n (Option α)) :
    BirthForestCausalWeights n (Option α) :=
  fun j h a => match code j, a with
    | some _, none => 0
    | _, _ => w j h a















