  (μ : ∀ i, X i → ℝ)
  (hmass : ∀ i, ∑ y, μ i y = 1)
  (U S : Finset I)
  (hS : S ⊆ U)
  (i : I)
  (hiS : i ∈ S)
  (f h : (∀ j, X j) → ℂ)
  (hi : ∀ x y, h (Function.update x i y) = h x)

include I sharedInstance1 sharedInstance2 X sharedInstance4 μ hmass U S hS i hiS f h hi

theorem finite_probe_component_pairing_zero_left  :
    (∑ x, (finiteProductWeight μ x : ℂ) *
      ((starRingEnd ℂ) (finiteCoordinateComponent μ S U.toList f x) * h x)) = 0 := by
  have he := finite_coordinate_average_selfadjoint μ i
    (finiteCoordinateComponent μ S U.toList f) h
  rw [finite_coordinate_component_average μ hmass S U.toList i
    (by simpa using hS hiS), if_pos hiS,
    finite_coordinate_average_of_independent μ i (hmass i) h hi] at he
  simpa only [Pi.zero_apply, map_zero, zero_mul, mul_zero, sum_const_zero] using he.symm

theorem finite_probe_component_pairing_zero_right  :
    (∑ x, (finiteProductWeight μ x : ℂ) *
      ((starRingEnd ℂ) (h x) * finiteCoordinateComponent μ S U.toList f x)) = 0 := by
  have he := finite_coordinate_average_selfadjoint μ i h
    (finiteCoordinateComponent μ S U.toList f)
  rw [finite_coordinate_average_of_independent μ i (hmass i) h hi,
    finite_coordinate_component_average μ hmass S U.toList i
      (by simpa using hS hiS), if_pos hiS] at he
  simpa only [Pi.zero_apply, mul_zero, sum_const_zero] using he

