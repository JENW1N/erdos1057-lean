section

/- The recovered trace coefficient is a product of local active-endpoint factors. -/

open Finset
open scoped Classical
namespace Bounty
section Record
variable {N J ell n B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J))
  (cut : ℕ → Fin N → Finset (Fin J)) (ζ : Fin n → ℝ)
  (K : ∀ j, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C j) → ℂ)

noncomputable def physicalObservedCoefficient (j : Fin n)
    (o : PhysicalMarkObservation P ell C)
    (s t : (g : Fin N) → Fin (J + ell) → ↥(P g)) : ℂ :=
  if h : ∃ a : PhysicalAuxLabels P (C j), o = .inr (some ⟨j, a⟩) then
    physicalActiveCoefficient (cut (4 * j.val + 2)) (cut (4 * j.val + 3))
      (C j) (ζ j) (K j) s t h.choose
  else 0

theorem physical_observed_coefficient_aux (j : Fin n) (a : PhysicalAuxLabels P (C j))
    (s t : (g : Fin N) → Fin (J + ell) → ↥(P g)) :
    physicalObservedCoefficient C cut ζ K j (.inr (some ⟨j, a⟩)) s t =
      physicalActiveCoefficient (cut (4 * j.val + 2)) (cut (4 * j.val + 3))
        (C j) (ζ j) (K j) s t a := by
  have h : ∃ b : PhysicalAuxLabels P (C j),
      (Sum.inr (some ⟨j, a⟩) : PhysicalMarkObservation P ell C) = .inr (some ⟨j, b⟩) := ⟨a, rfl⟩
  unfold physicalObservedCoefficient
  rw [dif_pos h]
  have he : h.choose = a := by
    exact (eq_of_heq (Sigma.mk.inj_iff.mp (Option.some.inj (Sum.inr.inj h.choose_spec))).2).symm
  rw [he]

noncomputable def physicalRecordCoefficient
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C)) : ℂ :=
  ∏ j : Fin n,
    match r[4 * j.val + 1]?, r[4 * j.val + 2]? with
    | some s, some t => physicalObservedCoefficient C cut ζ K j t.2.1
        (fun g => (s.2.2.2 g).1) (fun g => (t.2.2.2 g).1)
    | _, _ => 0

theorem physical_record_coefficient_decoded
    (o : ℕ → PhysicalMarkObservation P ell C)
    (t : ℕ → PhysicalBoundedMarkState P J ell B)
    (r : List (PhysicalFullTraceEntry (P := P) (ell := ell) (B := B) C))
    (hlen : r.length = 4 * n + 1)
    (ho : ∀ (i : ℕ) (hi : i < r.length), (r.get ⟨i, hi⟩).2.1 = o i)
    (ht : ∀ (i : ℕ) (hi : i < r.length), (r.get ⟨i, hi⟩).2.2 =
      physicalBoundedMarkEncode (cut (i + 1)) (t i))
    (a : ∀ j, PhysicalAuxLabels P (C j))
    (ha : ∀ j, o (4 * j.val + 2) = .inr (some ⟨j, a j⟩)) :
    physicalRecordCoefficient C cut ζ K r =
      ∏ j : Fin n, K j (t (4 * j.val + 1)).1 (t (4 * j.val + 2)).1 (a j) *
        physicalPhase (ζ j) (physicalD (C j) (t (4 * j.val + 1)).1 (a j)) := by
  unfold physicalRecordCoefficient
  apply prod_congr rfl
  intro j _
  have h1 : 4 * j.val + 1 < r.length := by omega
  have h2 : 4 * j.val + 2 < r.length := by omega
  rw [List.getElem?_eq_getElem h1, List.getElem?_eq_getElem h2]
  change physicalObservedCoefficient C cut ζ K j (r.get ⟨_, h2⟩).2.1
    (fun g => ((r.get ⟨_, h1⟩).2.2.2 g).1)
    (fun g => ((r.get ⟨_, h2⟩).2.2.2 g).1) = _
  rw [ho _ h2, ha j, physical_observed_coefficient_aux, ht _ h1, ht _ h2]
  exact physical_active_coefficient_encode _ _ _ _ _ _ _ _




end Record
end Bounty
end

