def boundedGhostSkeletonOutputCount {P Z : Type*} (t B : ℕ)
    (s : BoundedOrderedState P Z t B) (b : Fin (B + 1))
    (retained : Finset (Fin s.2.1.val)) : ℕ :=
  if retained.card + b.val ≤ B then retained.card + b.val else s.2.1.val

theorem bounded_ghost_target_count {P Z : Type*} (t B : ℕ)
    (s : BoundedOrderedState P Z t B) (b : Fin (B + 1))
    (retained : Finset (Fin s.2.1.val)) (births : Fin b.val → Z) :
    (boundedGhostEventTarget t B s ⟨b, retained, births⟩).2.1.val =
      boundedGhostSkeletonOutputCount t B s b retained := by
  unfold boundedGhostEventTarget retainedBirthTuple boundedGhostSkeletonOutputCount
  dsimp only
  split_ifs <;> rfl

theorem coupled_ghost_skeleton_target_memory {G : Type*} [Fintype G]
    {P Z : G → Type*} (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P Z t B) (sk : CoupledGhostSkeleton t B s)
    (births : CoupledGhostSamples t B s sk) :
    productTotalMemory (coupledGhostJointEventTarget t B s
      ((coupledGhostSkeletonEquiv t B s).symm ⟨sk, births⟩)) =
      ∑ g, boundedGhostSkeletonOutputCount (t g) B (s g) (sk g).1 (sk g).2 := by
  apply sum_congr rfl
  intro g _
  exact bounded_ghost_target_count (t g) B (s g) (sk g).1 (sk g).2 _

noncomputable def unrestrictedSkeletonOutputCount {P : Type*} (n : P → ℕ) (Δ D : ℤ)
    (t B : ℕ) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (sk : UnrestrictedLocalEdgeSkeleton n Δ D t B s) : ℕ :=
  let size := (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
    (unrestrictedResidueTransport n Δ) sk.1 sk.2.1 sk.2.2).1
  if size ≤ B then size else s.2.1.val

theorem unrestricted_bounded_skeleton_target_count {P : Type*} (n : P → ℕ) (Δ D : ℤ)
    (t B : ℕ) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (sk : UnrestrictedLocalEdgeSkeleton n Δ D t B s)
    (fresh : UnrestrictedFreshLabels P sk.2.1) :
    (unrestrictedBoundedEventTarget n Δ D t B s ⟨sk.1, sk.2.1, sk.2.2, fresh⟩).2.1.val =
      unrestrictedSkeletonOutputCount n Δ D t B s sk := by
  unfold unrestrictedBoundedEventTarget unrestrictedSkeletonOutputCount
  dsimp only
  split_ifs <;> rfl

end Bounty
