/- Full continuations at a fixed physical target list are recovered from
raw ledger/memory, and coincide with the true full target on contributing
edge events. -/

open scoped Classical
namespace Bounty

section Physical
variable {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin N → Finset (Fin J)) (R : PhysicalMarkLists P J ell)

noncomputable def physicalFullContinuation
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ) :=
  fixedActiveRawExtension (fun g (p : ↥(P g)) => p.val) B
    (fun g i => R g (physicalFullSlotIndex (C g) i)) F

theorem physical_full_continuation_decode
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ)
    (H : (g : Fin N) → Finset ↥(P g)) (x : PhysicalFullBoundedState P J ell B) :
    physicalFullContinuation C R F
      (fullMixedLedgerDecode (fun g (p : ↥(P g)) => p.val) B (H, x)) =
      F (H, physicalFullMemoryState C R (fun g => (x g).2)) :=
  fixed_active_raw_extension_decode _ _ _ F (H, x)

end Physical

section Edge
variable {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin N → Finset (Fin J)) (k : ℤ) (L R : PhysicalMarkLists P J ell)
  (H : (g : Fin N) → Finset ↥(P g))
  (q : (g : Fin N) → BoundedOrderedTuple
    (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
  (ω : ∀ _c : SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C g)), PhysicalAuxLabels P C → ℝ)
  (μ : (g : Fin N) → ↥(P g) → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (e : PhysicalFullEdgeEvent C k (physicalFullMemoryState C L q))

theorem physical_full_edge_continuation_of_nonzero
    (hw : fullActiveEdgeEventWeight (fun g (p : ↥(P g)) => p.val)
      (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
      (physicalFullEdgeDelta C k) (physicalFullEdgeD C) ω μ ρ V
      (physicalFullMemoryState C L q) e ≠ 0)
    (hp : physicalFullEdgePhase C k L R H q e ≠ 0)
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ) :
    let n := fun g (p : ↥(P g)) => p.val
    let S := fun g => physicalFullSharedIndices (ell := ell) (C g)
    let A := fun _ : SharedActiveLabels (fun g => ↥(P g)) S => PhysicalAuxLabels P C
    let x := physicalFullMemoryState C L q
    physicalFullContinuation C R F
      (fullEdgeLedgerRawTarget n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) H x e) =
      F (fullEdgeLedgerUpdate n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) H x e,
        fullActiveEdgeEventTarget n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) x e) := by
  dsimp only
  rw [show fullEdgeLedgerRawTarget (fun g (p : ↥(P g)) => p.val)
      (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
      (physicalFullEdgeDelta C k) (physicalFullEdgeD C) H (physicalFullMemoryState C L q) e =
      fullMixedLedgerDecode (fun g (p : ↥(P g)) => p.val) B
        (fullEdgeLedgerUpdate (fun g (p : ↥(P g)) => p.val)
          (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
          (physicalFullEdgeDelta C k) (physicalFullEdgeD C) H (physicalFullMemoryState C L q) e,
        fullActiveEdgeEventTarget (fun g (p : ↥(P g)) => p.val)
          (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
          (physicalFullEdgeDelta C k) (physicalFullEdgeD C) (physicalFullMemoryState C L q) e) from rfl]
  rw [physical_full_continuation_decode]
  rw [← physical_full_edge_target_of_nonzero C k L R H q ω μ ρ V e hw hp]

theorem physical_full_edge_continuation_weighted
    (F : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ) :
    let n := fun g (p : ↥(P g)) => p.val
    let S := fun g => physicalFullSharedIndices (ell := ell) (C g)
    let A := fun _ : SharedActiveLabels (fun g => ↥(P g)) S => PhysicalAuxLabels P C
    let x := physicalFullMemoryState C L q
    let w := fullActiveEdgeEventWeight n S B A (physicalFullEdgeDelta C k)
      (physicalFullEdgeD C) ω μ ρ V x e
    (w : ℂ) * physicalFullEdgePhase C k L R H q e * physicalFullContinuation C R F
      (fullEdgeLedgerRawTarget n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) H x e) =
    (w : ℂ) * physicalFullEdgePhase C k L R H q e *
      F (fullEdgeLedgerUpdate n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) H x e,
        fullActiveEdgeEventTarget n S B A (physicalFullEdgeDelta C k) (physicalFullEdgeD C) x e) := by
  dsimp only
  by_cases hw : fullActiveEdgeEventWeight (fun g (p : ↥(P g)) => p.val)
      (fun g => physicalFullSharedIndices (C g)) B (fun _ => PhysicalAuxLabels P C)
      (physicalFullEdgeDelta C k) (physicalFullEdgeD C) ω μ ρ V
      (physicalFullMemoryState C L q) e = 0
  · simp only [hw, Complex.ofReal_zero, zero_mul]
  · by_cases hp : physicalFullEdgePhase C k L R H q e = 0
    · simp only [hp, mul_zero, zero_mul]
    · rw [physical_full_edge_continuation_of_nonzero C k L R H q ω μ ρ V e hw hp F]

end Edge
