theorem physical_finite_root_term_partial_memory_normalization
    {I : Type*} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    [∀ a : PhysicalPrime P, NeZero a.2.val]
    (groups : Finset (Fin N)) (V : Fin N → ℝ) (patterns : Finset I)
    (C : I → Fin N → Finset (Fin J)) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (L : PhysicalMarkLists P J ell)
    (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (hp : physicalRootNormalizablePath V patterns C ζ k K L p)
    (hP : ∀ g a, a ∈ P g → Nat.Prime a)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ j : Fin (n + 1), ∀ g s,
      ¬ (((physicalPathSelectedEquiv patterns C (L, p)).2.2.1 j.castSucc g s).val : ℤ) ∣
        physicalPathSelectedMultiplier C k p j)
    (b : PhysicalPrime P → ℝ)
    (hb : ∀ a : PhysicalPrime P, a.1 ∈ groups →
      b a = 1 - (∑ j ∈ range (n + 2), (1 - physicalEndpointSchedule q (n + 1) j)) / a.2.val)
    (hb0 : ∀ a : PhysicalPrime P, a.1 ∈ groups → b a ≠ 0) :
    (physicalStateMass V J ell : ℂ) * physicalFiniteReturnScalar V patterns C ζ k K n L p *
      (physicalFiniteVertexExpectation C q k n L p : ℂ) =
    (physicalGroupPathMass V groupsᶜ
      (fun j => C (finitePathLabels p j).2.2.1.val) ell (n + 1) : ℂ) *
      physicalMemoryWalkScalar V patterns C ζ K (finitePathLabels p) (finitePathMarks L p) (n + 1) *
      (poolPathResidueExpectation (fun a : PhysicalPrime P => a.2.val)
        (physicalPrimeGroups P groupsᶜ) (range (n + 2))
        (fun a => (range (n + 2)).filter (fun j => a ∈ physicalMarkedPrimes (finitePathMarks L p j)))
        (fun a j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p)
          (n + 1) j : ZMod a.2.val))
        (fun j => 1 - physicalEndpointSchedule q (n + 1) j) : ℝ) *
      (∏ a ∈ physicalPrimeGroups P groups, b a : ℝ) *
      (∏ a ∈ physicalPrimeGroups P groups,
        ghostPhaseRunHistory (fun j => decide (a ∈ physicalMarkedPrimes (finitePathMarks L p j)))
          (fun j => -(physicalBareOffset C k (finitePathLabels p) (finitePathMarks L p)
            (n + 1) j : ZMod a.2.val))
          (fun j => 1 - physicalEndpointSchedule q (n + 1) j)
          ((a.2.val : ℝ) * b a)⁻¹ (V a.1) (n + 1) : ℝ) := by
  obtain ⟨r, hr⟩ := hp.2
  have hn := physical_finite_path_new_marks V patterns C ζ k K L p hp.1 r hr hP hdis hk
  rw [physical_root_normalizable_return_eq_walk V patterns C ζ k K L p hp]
  exact physical_partial_memory_walk_normalization groups V patterns C ζ K
    (finitePathLabels p) (finitePathMarks L p) (n + 1) _ _ b
    (fun j hj g _ => hn j hj g) hb hb0

end Bounty
