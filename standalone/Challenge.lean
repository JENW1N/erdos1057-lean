theorem thetaFullFrequency_tsum (c w : _root_.OAI.ActualEisensteinCubic.O→ℂ)
    (hsupp : ∀h:_root_.OAI.ActualEisensteinCubic.O,h≠0→c h≠0→∃p:ThetaFullIndex,thetaFullFrequency p=h) :
    (∑'h:{h:_root_.OAI.ActualEisensteinCubic.O // h≠0},w h.val*c h.val)=
      ∑'p:ThetaFullIndex,w (thetaFullFrequency p)*c (thetaFullFrequency p) := by
  let phi : ThetaFullIndex→{h:_root_.OAI.ActualEisensteinCubic.O // h≠0} := fun p=>⟨thetaFullFrequency p,thetaFullFrequency_ne_zero p⟩
  let f : {h:_root_.OAI.ActualEisensteinCubic.O // h≠0}→ℂ := fun h=>w h.val*c h.val
