section

/- Every occupied actual logarithmic cell has a superpolynomial lower
scale and a subexponential upper scale, uniformly in its character. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem eventually_candidate_occupied_cell_scale {c ε : ℝ}
    (hc : 0 < c) (hε : 0 < ε) (J : ℕ) (q : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
      let P := fun g : S => candidatePBand (c*L) g.val
      ∀ (ell : ℕ) (probes : S → Finset (Fin J)) (r : Finset S)
        (A : Finset (RepeatedBigFlatIndex S J ell)),
        A ⊆ r.sigma (repeatedBigPrimeProbeSlots probes) → A.Nonempty →
      ∀ (Q : ℕ) (h : ℝ), 0 < h → h ≤ 1 →
      ∀ (d : ℤ) (χ : BoundedPrimitiveCharacter Q) (ζ : ℝ),
        (∃ x : (∀ i : A, P i.val.1),
          (starRingEnd ℂ) (primeProductCellCharacter (fun i : A => P i.val.1) h d χ x) *
            physicalPhase ζ (∏ i, (x i).val) ≠ 0) →
        L^q ≤ Real.exp (((d : ℝ)-1)*h) ∧
          Real.exp (((d : ℝ)-1)*h) ≤ Real.exp (ε*L) := by
  filter_upwards [eventually_candidate_subset_product_range hc hε J,
    eventually_mul_rpow_le_exp_rpow q (Real.exp 1) (c := (1/10 : ℝ)) (by norm_num)]
    with L hrange hlarge
  intro S hS P ell probes r A hA hne Q h hh hh1 d χ ζ hx
  obtain ⟨x, hx⟩ := hx
  obtain ⟨hlo, hhi⟩ := hrange S hS ell probes r A hA hne x
  have hpos : 0 < ∏ i, (x i).val := by
    have hp := (Real.exp_pos _).trans_le hlo
    exact_mod_cast hp
  obtain ⟨hcellLo, hcellHi⟩ := prime_cell_phased_conjugate_range
    (fun i : A => P i.val.1) hh d χ ζ x hpos hx
  have hcellUpper : ((∏ i, (x i).val : ℕ) : ℝ) ≤
      Real.exp 1 * Real.exp (((d : ℝ)-1)*h) := by
    calc
      _ ≤ Real.exp ((d : ℝ)*h) := hcellHi
      _ = Real.exp h * Real.exp (((d : ℝ)-1)*h) := by
        rw [← Real.exp_add]
        congr 1
        ring
      _ ≤ _ := mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr hh1) (Real.exp_pos _).le
  refine ⟨?_, hcellLo.le.trans hhi⟩
  exact le_of_mul_le_mul_left (hlarge.trans (hlo.trans hcellUpper)) (Real.exp_pos 1)

end Bounty
end

section

/- Centered Fourier power saving from the exact retained-box source estimates. -/

open Finset Filter MeasureTheory
namespace Bounty

theorem eventually_common_source_fourier_of_boxes {b : ℝ} (hb : 0 < b) (A B : ℝ) :
    ∃ D : ℝ, A < D ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (Y H Z a v c : ℝ) (F : ℤ → ℂ) (δ α β γ : ℕ → ℂ),
      Real.exp (b*L) ≤ Y → Real.log Y ≤ 6*L →
      1 ≤ H → H ≤ Real.exp ((b/2)*L) → 0 < Z →
      (∀ n ∈ (harmonicCommonSupport Y).image Int.natAbs,
        F n = endpointFourConvolution δ α β γ n) →
      (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellSource Y Z a v F n‖ ^ 2) ≤ Y*L^B →
      let S := (harmonicCommonSupport Y).image Int.natAbs
      let N := ⌈4*Real.exp 2*Y⌉₊
      (∀ i ∈ dyadicNatIndices (Icc 1 N), ∀ j ∈ dyadicNatIndices (Icc 1 N),
        ∀ k ∈ dyadicNatIndices (Icc 1 N), ∀ l ∈ dyadicNatIndices (Icc 1 N),
        retainedFourDyadicBox S N i j k l →
        Integrable (fun t => ‖fourDyadicBoxSum N δ α β γ
          (commonSourceBoxKernel Y a v c t) i j k l‖ ^ 2)
          (volume.restrict {t : ℝ | |t| ≤ L*Y/H})) →
      (∀ i ∈ dyadicNatIndices (Icc 1 N), ∀ j ∈ dyadicNatIndices (Icc 1 N),
        ∀ k ∈ dyadicNatIndices (Icc 1 N), ∀ l ∈ dyadicNatIndices (Icc 1 N),
        retainedFourDyadicBox S N i j k l →
        (∫ t in {t : ℝ | |t| ≤ L*Y/H},
          ‖fourDyadicBoxSum N δ α β γ (commonSourceBoxKernel Y a v c t) i j k l‖ ^ 2) ≤ L^(-D)) →
      (∫ x in Set.Icc (c-1/H) (c+1/H),
        ‖finiteFourierSum (harmonicCommonSupport Y) (harmonicCellSource Y Z a v F) x‖ ^ 2)
        ≤ Y*L^(-A) := by
  obtain ⟨D,hD,hred⟩ := eventually_common_centered_fourier_of_mellin hb A B
  refine ⟨D+9, by linarith, ?_⟩
  filter_upwards [hred,eventually_common_source_mellin_of_boxes,
    eventually_ge_atTop (1 : ℝ)] with L hred hboxes hL
  intro Y H Z a v c F δ α β γ hY hlog hH hHu hZ hF hEs S N hf hM
  have hLp : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hY1 : 1 ≤ Y := (Real.one_le_exp (by positivity : 0 ≤ b*L)).trans hY
  apply hred Y H c (harmonicCellSource Y Z a v F) hY hlog hH hHu hEs
  have h := hboxes (volume.restrict {t : ℝ | |t| ≤ L*Y/H}) Y Z a v c hY1 hlog hZ
    F δ α β γ hF (L^(-(D+9))) (Real.rpow_nonneg hLp.le _) hf hM
  have hpow : L ^ 9 * L ^ (-(D+9)) = L ^ (-D) := by
    rw [← Real.rpow_natCast, ← Real.rpow_add hLp]
    congr 1
    ring
  exact h.trans_eq (by rw [hpow])

end Bounty
end

section

/- Pointwise rational twists preserve the original coefficient and phase order. -/

namespace Bounty

section

variable
  (r d : ℕ)
  {q : ℕ}
  (χ : DirichletCharacter ℂ q)
  (ψ : AddChar (Additive (ZMod (r/d))ˣ) ℂ)

include r d q χ ψ

theorem rational_normalized_phase_twist 
    (a : ℂ) (τ : ℝ) (n : ℕ) :
    (a*(χ (n : ZMod q)*typeIIPhase τ n))*
        unitAddCharDirichlet ψ (n : ZMod (r/d)) =
      a*(rationalProductCharacter r d χ ψ (n : ZMod (q*(r/d)))*typeIIPhase τ n) := by
  rw [rational_product_character_apply]
  ring

theorem rational_phase_left_twist 
