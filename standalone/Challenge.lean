section
open Finset Classical
abbrev PhysicalResidueZeroLabels {G : Type*} (P : G → Finset ℕ) (g : G)
    (r : PhysicalResidues P) := {p : ↥(P g) // r ⟨g, p⟩ = 0}

theorem physical_residue_divisor_pool_subset {G : Type*} (P : G → Finset ℕ) (g : G)
    (r : PhysicalResidues P) : physicalResidueDivisorPool P g r ⊆ P g := by
  classical
  intro p hp
  rcases mem_image.mp hp with ⟨q, _, rfl⟩
  exact q.property

theorem mem_physical_residue_divisor_pool {G : Type*} (P : G → Finset ℕ) (g : G)
    (r : PhysicalResidues P) (p : ↥(P g)) :
    p.val ∈ physicalResidueDivisorPool P g r ↔ r ⟨g, p⟩ = 0 := by
  classical
  constructor
  · intro hp
    rcases mem_image.mp hp with ⟨q, hq, he⟩
    have hqp : q = p := Subtype.ext he
    subst q
    exact (mem_filter.mp hq).2
  · intro hp
    exact mem_image.mpr ⟨p, mem_filter.mpr ⟨mem_attach _ _, hp⟩, rfl⟩

noncomputable def physicalResidueZeroLabelsEquiv {G : Type*}
    (P : G → Finset ℕ) (g : G) (r : PhysicalResidues P) :
    PhysicalResidueZeroLabels P g r ≃ ↥(physicalResidueDivisorPool P g r) :=
  Equiv.ofBijective
    (fun p => ⟨p.val.val, (mem_physical_residue_divisor_pool P g r p.val).mpr p.property⟩)
    ⟨by
      intro p q hpq
      have he : p.val.val = q.val.val :=
        congrArg (fun z : ↥(physicalResidueDivisorPool P g r) => z.val) hpq
      exact Subtype.ext (Subtype.ext he),
     by
      intro p
      let q : ↥(P g) := ⟨p.val, physical_residue_divisor_pool_subset P g r p.property⟩
      exact ⟨⟨q, (mem_physical_residue_divisor_pool P g r q).mp p.property⟩, rfl⟩⟩

theorem physical_residue_zero_labels_card {G : Type*} (P : G → Finset ℕ) (g : G)
    (r : PhysicalResidues P) :
    Fintype.card (PhysicalResidueZeroLabels P g r) = physicalResidueOmega P g r := by
  rw [Fintype.card_congr (physicalResidueZeroLabelsEquiv P g r), Fintype.card_coe]
  rfl

def physicalResidueMarksEmbedding {G : Type*} (P : G → Finset ℕ) (J ell : ℕ)
    (r : PhysicalResidues P) (L : PhysicalResidueMarksAt P J ell r) (g : G) :
    PhysicalSlots J ell ↪ PhysicalResidueZeroLabels P g r where
  toFun s := ⟨L.val g s, L.property g s⟩
  inj' := by
    intro s t hst
    exact (L.val g).injective (congrArg Subtype.val hst)




theorem physical_residue_slots_le_omega {G : Type*} (P : G → Finset ℕ) (J ell : ℕ)
    (r : PhysicalResidues P) (L : PhysicalResidueMarksAt P J ell r) (g : G) :
    J + ell ≤ physicalResidueOmega P g r := by
  have h := Fintype.card_le_of_embedding (physicalResidueMarksEmbedding P J ell r L g)
  simpa only [Fintype.card_sum, Fintype.card_fin, physical_residue_zero_labels_card] using h
end

section
open scoped BigOperators
open Classical
def physicalResidueSharedEmbedding {G : Type*} {P : G → Finset ℕ} {J : ℕ}
    (r : PhysicalResidues P) (d : PhysicalSharedLists P J)
    (hd : physicalResidueSharedValid r d) (g : G) :
    Fin J ↪ PhysicalResidueZeroLabels P g r where
  toFun j := ⟨d g j, hd g j⟩
  inj' _ _ h := (d g).injective (congrArg Subtype.val h)

def physicalResidueSharedFiberEquiv {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (r : PhysicalResidues P) (d : PhysicalSharedLists P J)
    (hd : physicalResidueSharedValid r d) :
    PhysicalResidueSharedFiber P J ell r d ≃
      (∀ g, {f : Fin J ⊕ Fin ell ↪ PhysicalResidueZeroLabels P g r //
        ∀ j, f (Sum.inl j) = physicalResidueSharedEmbedding r d hd g j}) where
  toFun L g := ⟨physicalResidueMarksEmbedding P J ell r L.val g, by
    intro j
    apply Subtype.ext
    exact congrArg (fun e : PhysicalSharedLists P J => e g j) L.property⟩
  invFun f := ⟨⟨(fun g => {
    toFun := fun s => ((f g).val s).val
    inj' := by
      intro s t h
      exact (f g).val.injective (Subtype.ext h) }),
    (fun g s => ((f g).val s).property)⟩, by
      funext g
      apply Function.Embedding.ext
      intro j
      exact congrArg Subtype.val ((f g).property j)⟩
  left_inv L := by
    apply Subtype.ext
    apply Subtype.ext
    funext g
    apply Function.Embedding.ext
    intro s
    rfl
  right_inv f := by
    funext g
    apply Subtype.ext
    apply Function.Embedding.ext
    intro s
    apply Subtype.ext
    rfl

theorem physical_residue_shared_fiber_card {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (J ell : ℕ) (r : PhysicalResidues P) (d : PhysicalSharedLists P J) :
    Nat.card (PhysicalResidueSharedFiber P J ell r d) =
      if physicalResidueSharedValid r d then
        ∏ g, (physicalResidueOmega P g r - J).descFactorial ell else 0 := by
  classical
  by_cases hd : physicalResidueSharedValid r d
  · rw [if_pos hd, Nat.card_congr (physicalResidueSharedFiberEquiv r d hd), Nat.card_pi]
    apply Finset.prod_congr rfl
    intro g _
    rw [shared_completion_card, physical_residue_zero_labels_card, Fintype.card_fin,
      Fintype.card_fin]
  · rw [if_neg hd]
    let _ : IsEmpty (PhysicalResidueSharedFiber P J ell r d) :=
      ⟨fun L => hd (physical_shared_fiber_valid r d L)⟩
    exact Nat.card_of_isEmpty

theorem physical_residue_shared_filter_card {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (J ell : ℕ) (r : PhysicalResidues P) (d : PhysicalSharedLists P J) :
    (Finset.univ.filter (fun L : PhysicalMarkLists P J ell =>
      physicalResidueMarksValid r L ∧ physicalSharedPrefix L = d)).card =
      if physicalResidueSharedValid r d then
        ∏ g, (physicalResidueOmega P g r - J).descFactorial ell else 0 := by
  classical
  have h := physical_residue_shared_fiber_card P J ell r d
  rw [Nat.card_congr (Equiv.subtypeSubtypeEquivSubtypeInter
    (physicalResidueMarksValid r) (fun L => physicalSharedPrefix L = d)),
    Nat.card_eq_fintype_card, Fintype.card_subtype] at h
  exact h
end

section
open scoped BigOperators
theorem norm_sum_sq_le_card_energy {X : Type*} (s : Finset X) (f : X → ℂ) :
    ‖∑ x ∈ s, f x‖ ^ 2 ≤ (s.card : ℝ) * ∑ x ∈ s, ‖f x‖ ^ 2 := by
  simpa using complex_row_weighted_cauchy s (fun _ => 1) f (fun _ => 1)
    (fun _ _ => by norm_num)

theorem fiber_conditioning_energy_bound {X Y : Type*} [Fintype X] [Fintype Y]
    [DecidableEq Y] (π : X → Y) (f : X → ℂ) (c : ℝ) {A : ℝ}
    (hcard : ∀ y, c ^ 2 * ((Finset.univ.filter fun x => π x = y).card : ℝ) ≤ A) :
    (∑ y, ‖(c : ℂ) * ∑ x ∈ Finset.univ.filter (fun x => π x = y), f x‖ ^ 2) ≤
      A * ∑ x, ‖f x‖ ^ 2 := by
  classical
  have hsum : (∑ y, ∑ x ∈ Finset.univ.filter (fun x => π x = y), ‖f x‖ ^ 2) =
      ∑ x, ‖f x‖ ^ 2 := by
    simp only [Finset.sum_filter]
    rw [Finset.sum_comm]
    simp
  calc
    _ = ∑ y, c ^ 2 * ‖∑ x ∈ Finset.univ.filter (fun x => π x = y), f x‖ ^ 2 := by
      apply Finset.sum_congr rfl
      intro y _
      rw [norm_mul, mul_pow, Complex.norm_real, Real.norm_eq_abs, sq_abs]
    _ ≤ ∑ y, c ^ 2 * (((Finset.univ.filter fun x => π x = y).card : ℝ) *
        ∑ x ∈ Finset.univ.filter (fun x => π x = y), ‖f x‖ ^ 2) :=
      Finset.sum_le_sum (fun y _ => mul_le_mul_of_nonneg_left
        (norm_sum_sq_le_card_energy _ f) (sq_nonneg c))
    _ ≤ ∑ y, A * ∑ x ∈ Finset.univ.filter (fun x => π x = y), ‖f x‖ ^ 2 := by
      apply Finset.sum_le_sum
      intro y _
      rw [← mul_assoc]
      exact mul_le_mul_of_nonneg_right (hcard y)
        (Finset.sum_nonneg (fun _ _ => sq_nonneg _))
    _ = _ := by rw [← Finset.mul_sum, hsum]

theorem fiber_conditioning_weighted_energy_bound {X Y : Type*} [Fintype X] [Fintype Y]
    [DecidableEq Y] (π : X → Y) (f : X → ℂ) (c : ℝ) {A mass : ℝ}
    (hcard : ∀ y, c ^ 2 * ((Finset.univ.filter fun x => π x = y).card : ℝ) ≤ A * mass) :
    (∑ y, ‖(c : ℂ) * ∑ x ∈ Finset.univ.filter (fun x => π x = y), f x‖ ^ 2) ≤
      A * ∑ x, mass * ‖f x‖ ^ 2 := by
  have h := fiber_conditioning_energy_bound π f c hcard
  simpa only [← Finset.mul_sum, mul_assoc] using h
end

section
open scoped BigOperators
noncomputable def physicalSmallConditioningScale {G : Type*} [Fintype G]
    (V : G → ℝ) (J ell : ℕ) : ℝ :=
  Real.sqrt (physicalStateMass V J ell *
    physicalCompletionMass V (fun _ => (∅ : Finset (Fin J))) ell)

theorem physical_small_conditioning_scale_sq {G : Type*} [Fintype G]
    (V : G → ℝ) (hV : ∀ g, 0 < V g) (J ell : ℕ) :
    physicalSmallConditioningScale V J ell ^ 2 = physicalStateMass V J ell *
      physicalCompletionMass V (fun _ => (∅ : Finset (Fin J))) ell := by
  apply Real.sq_sqrt
  exact mul_nonneg (physical_state_mass_pos V hV J ell).le
    (physical_completion_mass_pos V _ ell hV).le

theorem exists_small_completion_energy_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] (J : ℕ)
      (V : G → ℝ), (∀ g, v ≤ V g) → ∀ omega : G → ℕ,
      (∀ g, J + ell ≤ omega g) →
      physicalCompletionMass V (fun _ => (∅ : Finset (Fin J))) ell *
        (∏ g, q ^ (omega g - (J + ell))) *
        (∏ g, ((omega g - J).descFactorial ell : ℝ)) ≤ A ^ Fintype.card G := by
  let A := max 1 (((ell.factorial : ℝ) * (max 1 (1 / v)) ^ ell) /
    (1 - q) ^ (ell + 1))
  refine ⟨A, le_max_left _ _, ?_⟩
  intro G _ J V hV omega homega
  have hf (g : G) : (((omega g - J).descFactorial ell : ℝ) *
      q ^ (omega g - (J + ell))) / (V g) ^ ell ≤ A := by
    have hsub : omega g - J = (omega g - (J + ell)) + ell := by
      have := homega g
      omega
    rw [hsub]
    exact (uniform_damped_descFactorial_bound hq0 hq1 hv (hV g)
      ell (omega g - (J + ell)) ell le_rfl).trans (le_max_right _ _)
  have heq : physicalCompletionMass V (fun _ => (∅ : Finset (Fin J))) ell *
      (∏ g, q ^ (omega g - (J + ell))) *
      (∏ g, ((omega g - J).descFactorial ell : ℝ)) =
      ∏ g, (((omega g - J).descFactorial ell : ℝ) *
        q ^ (omega g - (J + ell))) / (V g) ^ ell := by
    simp only [physicalCompletionMass, Finset.card_empty, add_zero]
    rw [← Finset.prod_mul_distrib, ← Finset.prod_mul_distrib]
    apply Finset.prod_congr rfl
    intro g _
    ring
  rw [heq]
  calc
    _ ≤ ∏ _g : G, A := by
      apply Finset.prod_le_prod₀
      · intro g _
        exact div_nonneg (mul_nonneg (Nat.cast_nonneg _) (pow_nonneg hq0 _))
          (pow_nonneg (hv.trans_le (hV g)).le _)
      · intro g _
        exact hf g
    _ = _ := by simp

theorem small_conditioning_scale_damping_sq {G : Type*} [Fintype G]
    (V : G → ℝ) (hV : ∀ g, 0 < V g) (J ell : ℕ)
    {q : ℝ} (hq : 0 ≤ q) (omega : G → ℕ) :
    (physicalSmallConditioningScale V J ell *
      ∏ g, (Real.sqrt q) ^ (omega g - (J + ell))) ^ 2 =
      physicalStateMass V J ell *
      physicalCompletionMass V (fun _ => (∅ : Finset (Fin J))) ell *
      ∏ g, q ^ (omega g - (J + ell)) := by
  rw [mul_pow, physical_small_conditioning_scale_sq V hV, ← Finset.prod_pow]
  congr 1
  apply Finset.prod_congr rfl
  intro g _
  rw [← pow_mul, Nat.mul_comm, pow_mul, Real.sq_sqrt hq]
end

section
open scoped BigOperators Classical
noncomputable def physicalSmallCondition {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (q : ℝ)
    (r : PhysicalResidues P) (d : PhysicalSharedLists P J)
    (w : PhysicalMarkLists P J ell → ℂ) : ℂ := by
  classical
  exact ((physicalSmallConditioningScale V J ell *
      ∏ g, (Real.sqrt q) ^ (physicalResidueOmega P g r - (J + ell)) : ℝ) : ℂ) *
    ∑ L ∈ (Finset.univ : Finset (PhysicalResidueMarksAt P J ell r)).filter
      (fun L => physicalSharedPrefix L.val = d), w L.val

theorem exists_physical_small_conditioning_energy_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell : ℕ) :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (G : Type) [Fintype G] [DecidableEq G]
      (P : G → Finset ℕ) (J : ℕ) (V : G → ℝ), (∀ g, v ≤ V g) →
      ∀ (r : PhysicalResidues P) (w : PhysicalMarkLists P J ell → ℂ),
      (∑ d : PhysicalSharedLists P J, ‖physicalSmallCondition V q r d w‖ ^ 2) ≤
        A ^ Fintype.card G *
          ∑ L : PhysicalResidueMarksAt P J ell r, physicalStateMass V J ell * ‖w L.val‖ ^ 2 := by
  obtain ⟨A, hA, hbound⟩ := exists_small_completion_energy_bound hq0 hq1 hv ell
  refine ⟨A, hA, ?_⟩
  intro G _ _ P J V hV r w
  classical
  have hVpos (g : G) : 0 < V g := hv.trans_le (hV g)
  have hmass : 0 < physicalStateMass V J ell := physical_state_mass_pos V hVpos J ell
  let amp : ℝ := physicalSmallConditioningScale V J ell *
    ∏ g, (Real.sqrt q) ^ (physicalResidueOmega P g r - (J + ell))
  have hcard (d : PhysicalSharedLists P J) : amp ^ 2 *
      ((Finset.univ.filter (fun L : PhysicalResidueMarksAt P J ell r =>
        physicalSharedPrefix L.val = d)).card : ℝ) ≤
      A ^ Fintype.card G * physicalStateMass V J ell := by
    let S := Finset.univ.filter (fun L : PhysicalResidueMarksAt P J ell r =>
      physicalSharedPrefix L.val = d)
    by_cases hS : S.card = 0
    · change amp ^ 2 * (S.card : ℝ) ≤ _
      rw [hS, Nat.cast_zero, mul_zero]
      exact mul_nonneg (pow_nonneg (zero_le_one.trans hA) _) hmass.le
    · obtain ⟨L, hL⟩ := Finset.card_pos.mp (Nat.pos_of_ne_zero hS)
      have hd : physicalResidueSharedValid r d := by
        rw [← (Finset.mem_filter.mp hL).2]
        exact physical_shared_prefix_valid r L
      have hc := physical_residue_shared_fiber_card P J ell r d
      rw [if_pos hd, Nat.card_eq_fintype_card, Fintype.card_subtype] at hc
      have hcreal : ((Finset.univ.filter (fun L : PhysicalResidueMarksAt P J ell r =>
          physicalSharedPrefix L.val = d)).card : ℝ) =
          ∏ g, ((physicalResidueOmega P g r - J).descFactorial ell : ℝ) := by
        exact_mod_cast hc
      have hb := hbound G J V hV (fun g => physicalResidueOmega P g r)
        (physical_residue_slots_le_omega P J ell r L)
      change (physicalSmallConditioningScale V J ell *
        ∏ g, (Real.sqrt q) ^ (physicalResidueOmega P g r - (J + ell))) ^ 2 * _ ≤ _
      rw [small_conditioning_scale_damping_sq V hVpos J ell hq0, hcreal]
      calc
        _ = physicalStateMass V J ell *
            (physicalCompletionMass V (fun _ => (∅ : Finset (Fin J))) ell *
            (∏ g, q ^ (physicalResidueOmega P g r - (J + ell))) *
            (∏ g, ((physicalResidueOmega P g r - J).descFactorial ell : ℝ))) := by ring
        _ ≤ physicalStateMass V J ell * A ^ Fintype.card G :=
          mul_le_mul_of_nonneg_left hb hmass.le
        _ = _ := mul_comm _ _
  exact fiber_conditioning_weighted_energy_bound
    (fun L : PhysicalResidueMarksAt P J ell r => physicalSharedPrefix L.val)
    (fun L => w L.val) amp hcard
end

section
open scoped BigOperators Classical
theorem physical_small_condition_eq_vertex_sum {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (q : ℝ)
    (r : PhysicalResidues P) (d : PhysicalSharedLists P J)
    (w : PhysicalMarkLists P J ell → ℂ) :
    physicalSmallCondition V q r d w = (physicalSmallConditioningScale V J ell : ℂ) *
      ∑ L : PhysicalMarkLists P J ell, if physicalSharedPrefix L = d then
        (physicalResidueVertexWeight L (Real.sqrt q) r : ℂ) * w L else 0 := by
  classical
  let F : PhysicalMarkLists P J ell → ℂ := fun L => if physicalSharedPrefix L = d then
    (physicalResidueVertexWeight L (Real.sqrt q) r : ℂ) * w L else 0
  have he : (∑ L : PhysicalResidueMarksAt P J ell r, F L.val) = ∑ L, F L := by
    apply (Finset.sum_congr_set {L | physicalResidueMarksValid r L} F
      (fun L => F L.val) (fun _ _ => rfl) ?_).symm
    intro L hL
    change ¬ physicalResidueMarksValid r L at hL
    dsimp [F]
    simp only [physicalResidueVertexWeight, if_neg hL, Complex.ofReal_zero, zero_mul,
      ite_self]
  change physicalSmallCondition V q r d w = _ * ∑ L, F L
  rw [← he]
  unfold physicalSmallCondition
  rw [Complex.ofReal_mul, mul_assoc]
  congr 1
  rw [Finset.sum_filter, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro L _
  dsimp [F]
  simp only [physicalResidueVertexWeight, if_pos L.property]
  split_ifs <;> simp



end

section
open Finset
def distinctSurvivorStorageEmbedding {J K P : Type*}
    (f : J ↪ P) (g : K ↪ P) (T : Finset P)
    (hdis : ∀ j k, f j ≠ g k) : {j : J // f j ∉ T} ⊕ K ↪ P where
  toFun := Sum.elim (fun j => f j.val) g
  inj' := by
    intro x y hxy
    cases x with
    | inl j =>
      cases y with
      | inl l => exact congrArg Sum.inl (Subtype.ext (f.injective hxy))
      | inr k => exact (hdis j.val k hxy).elim
    | inr k =>
      cases y with
      | inl j => exact (hdis j.val k hxy.symm).elim
      | inr l => exact congrArg Sum.inr (g.injective hxy)

theorem distinct_survivor_storage_support {J K P : Type*}
    [Fintype J] [Fintype K] [DecidableEq P]
    (f : J ↪ P) (g : K ↪ P) (T : Finset P)
    (hdis : ∀ j k, f j ≠ g k) :
    univ.image (distinctSurvivorStorageEmbedding f g T hdis) =
      (univ.image f \ T) ∪ univ.image g := by
  ext p
  simp only [mem_image, mem_univ, true_and, mem_union, mem_sdiff]
  constructor
  · rintro ⟨x,hx⟩
    cases x with
    | inl j =>
      change f j.val = p at hx
      exact Or.inl ⟨⟨j.val,hx⟩, hx ▸ j.property⟩
    | inr k => exact Or.inr ⟨k,hx⟩
  · rintro (⟨⟨j,hj⟩,hp⟩ | ⟨k,hk⟩)
    · exact ⟨Sum.inl ⟨j,hj.symm ▸ hp⟩,hj⟩
    · exact ⟨Sum.inr k,hk⟩




def distinctSurvivorStorageResidue {J K P : Type*}
    (f : J ↪ P) (g : K ↪ P) (T : Finset P)
    (hdis : ∀ j k, f j ≠ g k) (R : P → Type*)
    (transport : (p : P) → R p → R p)
    (old : (j : J) → R (f j)) (stored : (k : K) → R (g k)) :
    (z : {j : J // f j ∉ T} ⊕ K) → R (distinctSurvivorStorageEmbedding f g T hdis z)
  | Sum.inl j => transport (f j.val) (old j.val)
  | Sum.inr k => stored k






end

section
open Finset
noncomputable def ghostPhasePendingSupport {I : Type*} [Fintype I] {R : I → Type*}
    (w : (i : I) → GhostPhaseState (R i)) : Finset I := by
  classical
  exact univ.filter (fun i => ∃ r, w i = some (some (some r)))

noncomputable def ghostPhaseActivitySupport {I : Type*} [Fintype I]
    (a : I → Bool) : Finset I := univ.filter (fun i => a i = true)

noncomputable def ghostPhaseChoiceSupport {I : Type*} [Fintype I]
    (c : I → Bool) : Finset I := univ.filter (fun i => c i = true)







def ghostPhaseEdgeChoiceOutput {I : Type*} {R : I → Type*}
    (atgt asrc : I → Bool) (hsrc : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) (c : I → Bool) :
    (i : I) → GhostPhaseState (R i) :=
  fun i => if c i then ghostPhaseEdgeStoreTarget (hsrc i)
    else ghostPhaseEdgeBaseTarget (atgt i) (asrc i) (w i)

/- Local support update for an allowed storage choice. -/
theorem ghost_phase_edge_choice_pending_iff {R : Type*}
    (atgt asrc c : Bool) (hsrc : R) (w : GhostPhaseState R)
    (hw : w.isSome = !asrc) (hc : c = true → atgt = false ∧ asrc = true) :
    (∃ r, (if c then ghostPhaseEdgeStoreTarget hsrc else ghostPhaseEdgeBaseTarget atgt asrc w) =
      some (some (some r))) ↔
      ((∃ r, w = some (some (some r))) ∧ atgt = false) ∨ c = true := by
  cases atgt <;> cases asrc <;> cases c <;> rcases w with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseEdgeStoreTarget, ghostPhaseEdgeBaseTarget]







/- The exact pending support after the chosen edge: delete promoted labels,
then append precisely the stored source-active labels. -/
theorem ghost_phase_edge_choice_support {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} (atgt asrc c : I → Bool) (hsrc : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (hc : ∀ i, c i = true → atgt i = false ∧ asrc i = true) :
    ghostPhasePendingSupport (ghostPhaseEdgeChoiceOutput atgt asrc hsrc w c) =
      (ghostPhasePendingSupport w \ ghostPhaseActivitySupport atgt) ∪
        ghostPhaseChoiceSupport c := by
  classical
  ext i
  simp only [mem_union, mem_sdiff]
  simp only [ghostPhasePendingSupport, ghostPhaseActivitySupport, ghostPhaseChoiceSupport,
    mem_filter, mem_univ, true_and]
  change (∃ r, (if c i then ghostPhaseEdgeStoreTarget (hsrc i)
    else ghostPhaseEdgeBaseTarget (atgt i) (asrc i) (w i)) = some (some (some r))) ↔ _
  rw [ghost_phase_edge_choice_pending_iff (atgt i) (asrc i) (c i) (hsrc i) (w i) (hw i) (hc i)]
  cases atgt i <;> simp




/- Surviving old pending residues are retained exactly, with no relabeling. -/
theorem ghost_phase_edge_choice_survivor {I : Type*} {R : I → Type*}
    (atgt asrc c : I → Bool) (hsrc : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (hc : ∀ i, c i = true → atgt i = false ∧ asrc i = true)
    (i : I) (r : R i) (hr : w i = some (some (some r))) (ht : atgt i = false) :
    ghostPhaseEdgeChoiceOutput atgt asrc hsrc w c i = some (some (some r)) := by
  have hs : asrc i = false := by
    have hi := hw i
    rw [hr] at hi
    cases ha : asrc i <;> simp_all
  have hci : c i = false := by
    cases hi : c i
    · rfl
    · have := (hc i hi).2
      simp_all
  simp [ghostPhaseEdgeChoiceOutput, hci, ht, hs, hr, ghostPhaseEdgeBaseTarget]


















end

section
open Finset
/- The selected target: transport retained memory, drop an outgoing active
lifespan by default, or store it at target residue `-delta`. -/
noncomputable def ghostPhaseMovingChoiceTarget {R : Type*} [AddGroup R]
    (atgt asrc : Bool) (delta : R) (store : Bool) (w : GhostPhaseState R) :
    GhostPhaseState R :=
  if store then ghostPhaseEdgeStoreTarget (-delta)
  else ghostPhaseEdgeBaseTarget atgt asrc (ghostPhaseShift delta w)

/- A fresh active lifespan begins exactly at an unborn inactive coordinate. -/
def ghostPhaseEdgeFresh {R : Type*} [DecidableEq R]
    (atgt asrc : Bool) (w : GhostPhaseState R) : Bool :=
  atgt && !asrc && decide (w = some none)

/- Shared active coordinates require zero displacement; promotions require
the old pending residue to equal the displacement. Completed lifespans cannot
be promoted. Other supported transitions impose no further hit condition. -/
def ghostPhaseMovingEdgeCompatible {R : Type*} [AddGroup R] [DecidableEq R]
    (atgt asrc : Bool) (delta : R) (w : GhostPhaseState R) : Bool :=
  match atgt, asrc, w with
  | true, true, _ => decide (delta = 0)
  | true, false, some none => true
  | true, false, some (some (some r)) => decide (r = delta)
  | true, false, _ => false
  | false, _, _ => true

/- The compatibility bit expresses precisely shared-hit agreement and the
fresh-or-promoted alternative for every newly active coordinate. -/
theorem ghost_phase_moving_edge_compatible_iff {R : Type*}
    [AddGroup R] [DecidableEq R] (atgt asrc : Bool) (delta : R)
    (w : GhostPhaseState R) (hw : w.isSome = !asrc) :
    ghostPhaseMovingEdgeCompatible atgt asrc delta w = true ↔
      (atgt = true ∧ asrc = true → delta = 0) ∧
        (atgt = true ∧ asrc = false →
          w = some none ∨ w = some (some (some delta))) := by
  cases atgt <;> cases asrc <;> rcases w with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseMovingEdgeCompatible]

/- The actual undamped coefficient at the selected target. Storage may be
chosen only on a source-active, target-inactive coordinate. -/
theorem ghost_phase_moving_choice_coefficient {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (atgt asrc store : Bool) (delta : R) (β : ℝ) (w : GhostPhaseState R)
    (hw : w.isSome = !asrc) (hs : store = true → atgt = false ∧ asrc = true) :
    ghostPhaseMovingEdge atgt asrc delta β
        (ghostPhaseMovingChoiceTarget atgt asrc delta store w) w =
      (if ghostPhaseEdgeFresh atgt asrc w then β else 1) *
        (if ghostPhaseMovingEdgeCompatible atgt asrc delta w then 1 else 0) := by
  cases atgt <;> cases asrc <;> cases store <;>
    rcases w with _ | (_ | (_ | r)) <;>
      simp_all [ghostPhaseMovingChoiceTarget, ghostPhaseEdgeBaseTarget,
        ghostPhaseEdgeStoreTarget, ghostPhaseEdgeFresh, ghostPhaseMovingEdgeCompatible,
        ghostPhaseShift, ghostMemoryShift,
        ghost_phase_moving_edge_active_active, ghost_phase_moving_edge_inactive_active,
        ghost_phase_moving_edge_active_inactive, ghost_phase_moving_edge_inactive_inactive]

/- Diagonal damping detects exactly pending residue zero. -/
theorem ghost_phase_diagonal_eq_zero_indicator {R : Type*} [Zero R] [DecidableEq R]
    (ρ : ℝ) (w : GhostPhaseState R) :
    ghostPhaseDiagonal 0 ρ w =
      if w = some (some (some 0)) then ρ else 1 := by
  rcases w with _ | (_ | (_ | r)) <;> simp [ghostPhaseDiagonal]

/- The selected actual damped edge coefficient splits into both endpoint
diagonals, a fresh beta factor, and the explicit compatibility indicator. -/
theorem ghost_phase_damped_moving_choice_coefficient {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (atgt asrc store : Bool) (delta : R) (β ρtgt ρsrc : ℝ) (w : GhostPhaseState R)
    (hw : w.isSome = !asrc) (hs : store = true → atgt = false ∧ asrc = true) :
    ghostPhaseDampedMovingEdge atgt asrc delta β ρtgt ρsrc
        (ghostPhaseMovingChoiceTarget atgt asrc delta store w) w =
      (if w = some (some (some 0)) then ρsrc else 1) *
        (if ghostPhaseMovingChoiceTarget atgt asrc delta store w = some (some (some 0))
          then ρtgt else 1) *
        (if ghostPhaseEdgeFresh atgt asrc w then β else 1) *
        (if ghostPhaseMovingEdgeCompatible atgt asrc delta w then 1 else 0) := by
  rw [ghostPhaseDampedMovingEdge,
    ghost_phase_moving_choice_coefficient atgt asrc store delta β w hw hs]
  simp only [ghost_phase_diagonal_eq_zero_indicator]
  ring

/- Pending-zero coordinates of a finite phase configuration. -/
noncomputable def ghostPhaseZeroSet {I : Type*} [Fintype I] {R : I → Type*}
    [∀ i, Zero (R i)] [∀ i, DecidableEq (R i)]
    (w : (i : I) → GhostPhaseState (R i)) : Finset I :=
  univ.filter (fun i => w i = some (some (some 0)))

noncomputable def ghostPhaseFreshSet {I : Type*} [Fintype I] {R : I → Type*}
    [∀ i, DecidableEq (R i)] (atgt asrc : I → Bool)
    (w : (i : I) → GhostPhaseState (R i)) : Finset I :=
  univ.filter (fun i => ghostPhaseEdgeFresh (atgt i) (asrc i) (w i))

/- Source-inactive coordinates entering the target active label. -/
noncomputable def ghostPhaseNewRunSet {I : Type*} [Fintype I]
    (atgt asrc : I → Bool) : Finset I :=
  univ.filter (fun i => atgt i && !(asrc i))

section

variable
  {I : Type*}
  [sharedInstance1 : Fintype I]
  {R : I → Type*}
  [sharedInstance3 : ∀ i, AddGroup (R i)]
  [sharedInstance4 : ∀ i, Fintype (R i)]
  [sharedInstance5 : ∀ i, DecidableEq (R i)]
  (atgt asrc store : I → Bool)
  (delta : (i : I) → R i)
  (β : I → ℝ)

include I sharedInstance1 R sharedInstance3 sharedInstance4 sharedInstance5 atgt asrc store delta β

/- Exact finite coefficient of one supported moving-frame edge choice.
The zero counts include promoted old particles at the source and newly stored
particles at the target. The indicator keeps all shared-hit and promotion
conditions, so zero-weight choices remain represented. -/
theorem ghost_phase_moving_edge_choice_product 
    (ρtgt ρsrc : ℝ) (w : (i : I) → GhostPhaseState (R i))
    (hw : ∀ i, (w i).isSome = !(asrc i))
    (hs : ∀ i, store i = true → atgt i = false ∧ asrc i = true) :
    (∏ i, ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i) (β i) ρtgt ρsrc
      (ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i)) (w i)) =
      ρsrc ^ (ghostPhaseZeroSet w).card *
        ρtgt ^ (ghostPhaseZeroSet (fun i =>
          ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i))).card *
        (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i) *
        (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
          then 1 else 0) := by
  classical
  have hc : (∏ i, if ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i)
      then (1 : ℝ) else 0) =
      if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
        then 1 else 0 := by
    by_cases h : ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
    · simp [h]
    · rw [if_neg h]
      push Not at h
      obtain ⟨i, hi⟩ := h
      exact prod_eq_zero (mem_univ i) (if_neg hi)
  have hd (v : (i : I) → GhostPhaseState (R i)) (ρ : ℝ) :
      (∏ i, if v i = some (some (some 0)) then ρ else 1) =
        ρ ^ (ghostPhaseZeroSet v).card := by
    unfold ghostPhaseZeroSet
    rw [← prod_filter, prod_const]
  simp_rw [ghost_phase_damped_moving_choice_coefficient _ _ _ _ _ _ _ _ (hw _) (hs _)]
  simp only [prod_mul_distrib, hc]
  rw [hd w ρsrc, hd (fun i =>
    ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i)) ρtgt]
  rw [ghostPhaseFreshSet, prod_filter]

/- If each new active run is explicitly normalized by `V⁻¹`, the same actual
edge coefficient acquires exactly one such factor per entering active index. -/
theorem ghost_phase_run_normalized_edge_choice_product 
    (ρtgt ρsrc V : ℝ) (w : (i : I) → GhostPhaseState (R i))
    (hw : ∀ i, (w i).isSome = !(asrc i))
    (hs : ∀ i, store i = true → atgt i = false ∧ asrc i = true) :
    (∏ i, (if atgt i && !(asrc i) then V⁻¹ else 1) *
      ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i) (β i) ρtgt ρsrc
        (ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i)) (w i)) =
      ρsrc ^ (ghostPhaseZeroSet w).card *
        ρtgt ^ (ghostPhaseZeroSet (fun i =>
          ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i))).card *
        (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i) *
        (V⁻¹) ^ (ghostPhaseNewRunSet atgt asrc).card *
        (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
          then 1 else 0) := by
  classical
  rw [prod_mul_distrib,
    ghost_phase_moving_edge_choice_product atgt asrc store delta β ρtgt ρsrc w hw hs]
  have hV : (∏ i, if atgt i && !(asrc i) then V⁻¹ else 1) =
      (V⁻¹) ^ (ghostPhaseNewRunSet atgt asrc).card := by
    rw [ghostPhaseNewRunSet, ← prod_const]
    exact (prod_filter _ _).symm
  rw [hV]
  ring

end

end

section
open Finset
/- Translation changes neither active/inactive status nor the U/D flags. -/
theorem ghost_phase_shift_isSome {R : Type*} [AddGroup R] (delta : R)
    (w : GhostPhaseState R) : (ghostPhaseShift delta w).isSome = w.isSome := by
  cases w <;> rfl

theorem ghost_phase_shift_pending_iff {R : Type*} [AddGroup R] (delta : R)
    (w : GhostPhaseState R) :
    (∃ r, ghostPhaseShift delta w = some (some (some r))) ↔
      ∃ r, w = some (some (some r)) := by
  rcases w with _ | (_ | (_ | r)) <;>
    simp [ghostPhaseShift_active, ghostPhaseShift_unborn,
      ghostPhaseShift_completed, ghostPhaseShift_pending]




/- Independent frame shifts preserve the pending support. -/
theorem ghost_phase_pending_support_shift {I : Type*} [Fintype I]
    {R : I → Type*} [∀ i, AddGroup (R i)] (delta : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) :
    ghostPhasePendingSupport (fun i => ghostPhaseShift (delta i) (w i)) =
      ghostPhasePendingSupport w := by
  classical
  ext i
  simp only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and,
    ghost_phase_shift_pending_iff]

theorem ghost_phase_mask_shift {I : Type*} {R : I → Type*}
    [∀ i, AddGroup (R i)] (a : I → Bool) (delta : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask a w) :
    ghostPhaseMask a (fun i => ghostPhaseShift (delta i) (w i)) := by
  intro i
  rw [ghost_phase_shift_isSome]
  exact hw i

/- The moving choice is precisely the fixed-frame choice on translated input,
with the source hit at -delta in the target frame. -/
theorem ghost_phase_moving_choice_output_eq {I : Type*} {R : I → Type*}
    [∀ i, AddGroup (R i)] (atgt asrc store : I → Bool) (delta : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) :
    (fun i => ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i)) =
      ghostPhaseEdgeChoiceOutput atgt asrc (fun i => -delta i)
        (fun i => ghostPhaseShift (delta i) (w i)) store := rfl

/- Moving coordinates have exactly the same delete-and-store support update. -/
theorem ghost_phase_moving_choice_support {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)]
    (atgt asrc store : I → Bool) (delta : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ i, store i = true → atgt i = false ∧ asrc i = true) :
    ghostPhasePendingSupport
      (fun i => ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i)) =
      (ghostPhasePendingSupport w \ ghostPhaseActivitySupport atgt) ∪
        ghostPhaseChoiceSupport store := by
  rw [ghost_phase_moving_choice_output_eq,
    ghost_phase_edge_choice_support atgt asrc store (fun i => -delta i)
      (fun i => ghostPhaseShift (delta i) (w i)) (ghost_phase_mask_shift asrc delta w hw) hs,
    ghost_phase_pending_support_shift]

/- A stored outgoing active label has target-frame residue -delta. -/
theorem ghost_phase_moving_choice_stored {R : Type*} [AddGroup R]
    (atgt asrc store : Bool) (delta : R) (w : GhostPhaseState R) (hs : store = true) :
    ghostPhaseMovingChoiceTarget atgt asrc delta store w = some (some (some (-delta))) := by
  simp [ghostPhaseMovingChoiceTarget, hs, ghostPhaseEdgeStoreTarget]

/- A retained old residue r is translated to r-delta. -/
theorem ghost_phase_moving_choice_survivor {I : Type*} {R : I → Type*}
    [∀ i, AddGroup (R i)] (atgt asrc store : I → Bool) (delta : (i : I) → R i)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ i, store i = true → atgt i = false ∧ asrc i = true)
    (i : I) (r : R i) (hr : w i = some (some (some r))) (ht : atgt i = false) :
    ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i) =
      some (some (some (r - delta i))) := by
  have hshift : ghostPhaseShift (delta i) (w i) = some (some (some (r - delta i))) := by
    rw [hr, ghostPhaseShift_pending]
  exact ghost_phase_edge_choice_survivor atgt asrc store (fun i => -delta i)
    (fun i => ghostPhaseShift (delta i) (w i)) (ghost_phase_mask_shift asrc delta w hw)
    hs i (r - delta i) hshift ht









end

section
open Finset
/- Old pending labels entering the target active set are promotions. -/
noncomputable def ghostPhasePromotionSet {I : Type*} [Fintype I] {R : I → Type*}
    (atgt : I → Bool) (w : (i : I) → GhostPhaseState (R i)) : Finset I := by
  classical
  exact ghostPhasePendingSupport w ∩ ghostPhaseActivitySupport atgt

/- Promotion and fresh birth are disjoint alternatives regardless of coefficients. -/
theorem ghost_phase_promotion_fresh_disjoint {I : Type*} [Fintype I]
    {R : I → Type*} [∀ i, DecidableEq (R i)] (atgt asrc : I → Bool)
    (w : (i : I) → GhostPhaseState (R i)) :
    Disjoint (ghostPhasePromotionSet atgt w) (ghostPhaseFreshSet atgt asrc w) := by
  classical
  apply disjoint_left.mpr
  intro i hp hf
  simp only [ghostPhasePromotionSet, ghostPhasePendingSupport, ghostPhaseActivitySupport,
    mem_inter, mem_filter, mem_univ, true_and] at hp
  obtain ⟨r, hr⟩ := hp.1
  simp [ghostPhaseFreshSet, ghostPhaseEdgeFresh, hr] at hf

section

variable
  {I : Type*}
  [sharedInstance1 : Fintype I]
  [sharedInstance2 : DecidableEq I]
  {R : I → Type*}
  [sharedInstance4 : ∀ i, AddGroup (R i)]
  [sharedInstance5 : ∀ i, DecidableEq (R i)]
  (atgt asrc : I → Bool)
  (delta : (i : I) → R i)
  (w : (i : I) → GhostPhaseState (R i))
  (hw : ghostPhaseMask asrc w)
  (hcompat : ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true)

include I sharedInstance1 sharedInstance2 R sharedInstance4 sharedInstance5 atgt asrc delta w hw hcompat

/- A compatible new active run is exactly one old-pending promotion or one
fresh unborn label. Completed labels cannot enter this partition. -/
theorem ghost_phase_new_run_partition  :
    ghostPhaseNewRunSet atgt asrc =
      ghostPhasePromotionSet atgt w ∪ ghostPhaseFreshSet atgt asrc w := by
  classical
  ext i
  have hwi := hw i
  have hci := hcompat i
  cases ht : atgt i <;> cases hs : asrc i <;> rcases he : w i with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseNewRunSet, ghostPhasePromotionSet, ghostPhasePendingSupport,
      ghostPhaseActivitySupport, ghostPhaseFreshSet, ghostPhaseEdgeFresh,
      ghostPhaseMovingEdgeCompatible]

/- The entering-run count splits into promotion count plus fresh count. -/
theorem ghost_phase_new_run_card  :
    (ghostPhaseNewRunSet atgt asrc).card =
      (ghostPhasePromotionSet atgt w).card + (ghostPhaseFreshSet atgt asrc w).card := by
  rw [ghost_phase_new_run_partition atgt asrc delta w hw hcompat,
    card_union_of_disjoint (ghost_phase_promotion_fresh_disjoint atgt asrc w)]

end


/- A product of fresh-label masses beta/V pays one inverse V per fresh label. -/
theorem ghost_phase_fresh_measure_product {I : Type*} [Fintype I]
    {R : I → Type*} [∀ i, DecidableEq (R i)] (atgt asrc : I → Bool)
    (w : (i : I) → GhostPhaseState (R i)) (β : I → ℝ) (V : ℝ) :
    (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i / V) =
      (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i) *
        (V⁻¹) ^ (ghostPhaseFreshSet atgt asrc w).card := by
  simp only [div_eq_mul_inv, prod_mul_distrib, prod_const]

/- Exact normalization split, including the zero indicator on incompatible
choices. There is no additional inverse V for fresh labels after beta/V. -/
theorem ghost_phase_new_run_measure_split {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (delta : (i : I) → R i) (β : I → ℝ) (V : ℝ)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w) :
    (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i) *
        (V⁻¹) ^ (ghostPhaseNewRunSet atgt asrc).card *
        (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
          then 1 else 0) =
      (V⁻¹) ^ (ghostPhasePromotionSet atgt w).card *
        (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i / V) *
        (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
          then 1 else 0) := by
  classical
  by_cases hc : ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
  · rw [if_pos hc, ghost_phase_new_run_card atgt asrc delta w hw hc,
      ghost_phase_fresh_measure_product, pow_add]
    ring
  · simp only [if_neg hc, mul_zero]

/- The actual edge with explicit all-new-run normalization has only a
promotion-count inverse power after fresh beta/V measures are extracted.
Both endpoint rho factors and the full compatibility indicator are retained. -/
theorem ghost_phase_run_normalized_edge_fresh_measure {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, Fintype (R i)]
    [∀ i, DecidableEq (R i)]
    (atgt asrc store : I → Bool) (delta : (i : I) → R i) (β : I → ℝ)
    (ρtgt ρsrc V : ℝ) (w : (i : I) → GhostPhaseState (R i))
    (hw : ghostPhaseMask asrc w)
    (hs : ∀ i, store i = true → atgt i = false ∧ asrc i = true) :
    (∏ i, (if atgt i && !(asrc i) then V⁻¹ else 1) *
      ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i) (β i) ρtgt ρsrc
        (ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i)) (w i)) =
      ρsrc ^ (ghostPhaseZeroSet w).card *
        ρtgt ^ (ghostPhaseZeroSet (fun i =>
          ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i))).card *
        (V⁻¹) ^ (ghostPhasePromotionSet atgt w).card *
        (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i / V) *
        (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
          then 1 else 0) := by
  rw [ghost_phase_run_normalized_edge_choice_product atgt asrc store delta β ρtgt ρsrc V w hw hs]
  have he := ghost_phase_new_run_measure_split atgt asrc delta β V w hw
  calc
    _ = (ρsrc ^ (ghostPhaseZeroSet w).card *
        ρtgt ^ (ghostPhaseZeroSet (fun i =>
          ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i) (store i) (w i))).card) *
        ((∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i) *
          (V⁻¹) ^ (ghostPhaseNewRunSet atgt asrc).card *
          (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
            then 1 else 0)) := by ring
    _ = _ := by rw [he]; ring
end

section
open Finset
/- An injective labeling reindexes subsets without multiplicity. -/
theorem distinct_slot_subset_sum {J P : Type*} [Fintype J]
    [DecidableEq J] [DecidableEq P] (g : J ↪ P) (F : Finset P → ℝ) :
    (∑ B ∈ (univ.image g).powerset, F B) =
      ∑ S ∈ (univ : Finset J).powerset, F (S.image g) := by
  rw [powerset_image, sum_image]
  intro S _ T _ h
  exact image_injective g.injective h

/- Only labels leaving the active set have a storage alternative. -/
theorem ghost_phase_tensor_edge_storage_subsets {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (htgt hsrc : (i : I) → R i) (β ρtgt ρsrc : I → ℝ)
    (w : (i : I) → GhostPhaseState (R i))
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ z, (∏ i, ghostPhaseDampedEdge (atgt i) (asrc i) (htgt i) (hsrc i)
      (β i) (ρtgt i) (ρsrc i) (z i) (w i)) * F z) =
      ∑ B ∈ (ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt).powerset,
        (∏ i, if i ∈ B then ghostPhaseEdgeStoreWeight (atgt i) (asrc i) (htgt i)
            (hsrc i) (ρtgt i) (w i)
          else ghostPhaseEdgeBaseWeight (atgt i) (asrc i) (htgt i) (hsrc i)
            (β i) (ρtgt i) (ρsrc i) (w i)) *
        F (ghostPhaseEdgeChoiceOutput atgt asrc hsrc w (fun i => decide (i ∈ B))) := by
  rw [ghost_phase_tensor_edge_action_expansion]
  unfold ghostPhaseEdgeChoiceOutput
  have hz : ∀ i, i ∉ ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt →
      ghostPhaseEdgeStoreWeight (atgt i) (asrc i) (htgt i) (hsrc i) (ρtgt i) (w i) = 0 := by
    intro i hi
    by_contra hn
    obtain ⟨ht, hs, _⟩ := ghost_phase_edge_store_supported _ _ _ _ _ _ hn
    apply hi
    simp [ghostPhaseActivitySupport, hs, ht]
  simpa only [ghostPhaseEdgeChoiceOutput, decide_eq_true_eq] using
    ghost_choice_sum_subsets
      (fun i => ghostPhaseEdgeBaseTarget (atgt i) (asrc i) (w i))
      (fun i => ghostPhaseEdgeStoreTarget (hsrc i))
      (fun i => ghostPhaseEdgeBaseWeight (atgt i) (asrc i) (htgt i) (hsrc i)
        (β i) (ρtgt i) (ρsrc i) (w i))
      (fun i => ghostPhaseEdgeStoreWeight (atgt i) (asrc i) (htgt i) (hsrc i) (ρtgt i) (w i))
      (ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt) hz F

/- A supported selected outcome has exactly its binary-expansion coefficient. -/
theorem ghost_phase_edge_selected_weight {R : Type*} [Fintype R] [DecidableEq R]
    (atgt asrc store : Bool) (htgt hsrc : R) (β ρtgt ρsrc : ℝ)
    (w : GhostPhaseState R) (hw : w.isSome = !asrc)
    (hs : store = true → atgt = false ∧ asrc = true) :
    ghostPhaseDampedEdge atgt asrc htgt hsrc β ρtgt ρsrc
      (if store then ghostPhaseEdgeStoreTarget hsrc else ghostPhaseEdgeBaseTarget atgt asrc w) w =
      if store then ghostPhaseEdgeStoreWeight atgt asrc htgt hsrc ρtgt w
        else ghostPhaseEdgeBaseWeight atgt asrc htgt hsrc β ρtgt ρsrc w := by
  rw [ghost_phase_damped_edge_sparse]
  cases atgt <;> cases asrc <;> cases store <;>
    rcases w with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseEdgeBaseTarget, ghostPhaseEdgeStoreTarget,
      ghostPhaseEdgeStoreWeight, ghostPhaseEdgeBaseWeight]

/- The full edge action is the sum of its actual coefficients at the distinct
storage outputs, including compatible choices whose coefficient vanishes. -/
theorem ghost_phase_tensor_edge_storage_actual {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (htgt hsrc : (i : I) → R i) (β ρtgt ρsrc : I → ℝ)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ z, (∏ i, ghostPhaseDampedEdge (atgt i) (asrc i) (htgt i) (hsrc i)
      (β i) (ρtgt i) (ρsrc i) (z i) (w i)) * F z) =
      ∑ B ∈ (ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt).powerset,
        let z := ghostPhaseEdgeChoiceOutput atgt asrc hsrc w (fun i => decide (i ∈ B))
        (∏ i, ghostPhaseDampedEdge (atgt i) (asrc i) (htgt i) (hsrc i)
          (β i) (ρtgt i) (ρsrc i) (z i) (w i)) * F z := by
  rw [ghost_phase_tensor_edge_storage_subsets]
  apply sum_congr rfl
  intro B hB
  apply congrArg (fun t => t * F (ghostPhaseEdgeChoiceOutput atgt asrc hsrc w
    (fun i => decide (i ∈ B))))
  apply prod_congr rfl
  intro i _
  have hs : decide (i ∈ B) = true → atgt i = false ∧ asrc i = true := by
    intro hi
    have h := mem_powerset.mp hB (of_decide_eq_true hi)
    simpa [ghostPhaseActivitySupport, and_comm] using h
  simpa only [ghostPhaseEdgeChoiceOutput, decide_eq_true_eq] using
    (ghost_phase_edge_selected_weight (atgt i) (asrc i) (decide (i ∈ B))
      (htgt i) (hsrc i) (β i) (ρtgt i) (ρsrc i) (w i) (hw i) hs).symm

/- Moving-frame storage outputs translate retained residues and store at
minus the displacement; the action still sums once per departing-label subset. -/
theorem ghost_phase_moving_storage_actual {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (delta : (i : I) → R i) (β ρtgt ρsrc : I → ℝ)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ z, (∏ i, ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i)
      (β i) (ρtgt i) (ρsrc i) (z i) (w i)) * F z) =
      ∑ B ∈ (ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt).powerset,
        let z := fun i => ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i)
          (decide (i ∈ B)) (w i)
        (∏ i, ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i)
          (β i) (ρtgt i) (ρsrc i) (z i) (w i)) * F z := by
  simp_rw [ghost_phase_damped_moving_edge_eq_shifted]
  apply ghost_phase_tensor_edge_storage_actual
  intro i
  have h := hw i
  rcases hwi : w i with _ | (_ | (_ | r)) <;>
    simpa [hwi, ghostPhaseShift, ghostMemoryShift] using h






end

section
open Finset
/- Every old pending index is outside the source-active mask. -/
theorem distinct_phase_old_inactive {J P : Type*} [Fintype P]
    {R : P → Type*} (asrc : P → Bool)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (f : DistinctOrderedSupport J (ghostPhasePendingSupport w)) (j : J) :
    asrc (f.val j) = false := by
  classical
  have hf := (f.property (f.val j)).mpr ⟨j, rfl⟩
  simp only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and] at hf
  obtain ⟨r, hr⟩ := hf
  have hm := hw (f.val j)
  rw [hr] at hm
  cases ha : asrc (f.val j) <;> simp_all

/- Storage indices were source-active and are target-inactive. -/
theorem distinct_phase_storage_active {K P : Type*} [Fintype P]
    (atgt asrc store : P → Bool)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true)
    (g : DistinctOrderedSupport K (ghostPhaseChoiceSupport store)) (k : K) :
    atgt (g.val k) = false ∧ asrc (g.val k) = true := by
  have hg := (g.property (g.val k)).mpr ⟨k, rfl⟩
  simp only [ghostPhaseChoiceSupport, mem_filter, mem_univ, true_and] at hg
  exact hs (g.val k) hg

/- The source phase mask guarantees that old and stored ordered labels
cannot coincide. No additional distinctness hypothesis is needed. -/
theorem distinct_phase_old_storage_disjoint {J K P : Type*} [Fintype P]
    {R : P → Type*} (atgt asrc store : P → Bool)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true)
    (f : DistinctOrderedSupport J (ghostPhasePendingSupport w))
    (g : DistinctOrderedSupport K (ghostPhaseChoiceSupport store)) :
    ∀ j k, f.val j ≠ g.val k := by
  intro j k heq
  have hf := distinct_phase_old_inactive asrc w hw f j
  have hg := (distinct_phase_storage_active atgt asrc store hs g k).2
  rw [heq, hg] at hf
  contradiction

/- The delete/append embedding enumerates the actual moving output support. -/
theorem distinct_phase_moving_embedding_support {J K P : Type*}
    [Fintype J] [Fintype K] [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)]
    (atgt asrc store : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true)
    (f : DistinctOrderedSupport J (ghostPhasePendingSupport w))
    (g : DistinctOrderedSupport K (ghostPhaseChoiceSupport store))
    (hdis : ∀ j k, f.val j ≠ g.val k) :
    univ.image (distinctSurvivorStorageEmbedding f.val g.val
      (ghostPhaseActivitySupport atgt) hdis) =
      ghostPhasePendingSupport (fun p =>
        ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p) (store p) (w p)) := by
  have hf : univ.image f.val = ghostPhasePendingSupport w := by
    ext p
    simp only [mem_image, mem_univ, true_and]
    exact (f.property p).symm
  have hg : univ.image g.val = ghostPhaseChoiceSupport store := by
    ext p
    simp only [mem_image, mem_univ, true_and]
    exact (g.property p).symm
  rw [distinct_survivor_storage_support, hf, hg]
  exact (ghost_phase_moving_choice_support atgt asrc store delta w hw hs).symm




/- The ordered transported/stored residues agree at every actual moving
output coordinate, for any proof of old/storage disjointness. -/
theorem distinct_phase_moving_residue {J K P : Type*} [Fintype P]
    {R : P → Type*} [∀ p, AddGroup (R p)]
    (atgt asrc store : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true)
    (f : DistinctOrderedSupport J (ghostPhasePendingSupport w))
    (g : DistinctOrderedSupport K (ghostPhaseChoiceSupport store))
    (hdis : ∀ j k, f.val j ≠ g.val k)
    (old : (j : J) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (j : {j : J // f.val j ∉ ghostPhaseActivitySupport atgt} ⊕ K) :
    let fout := distinctSurvivorStorageEmbedding f.val g.val
      (ghostPhaseActivitySupport atgt) hdis
    let rout := distinctSurvivorStorageResidue f.val g.val
      (ghostPhaseActivitySupport atgt) hdis R
      (fun p r => r - delta p) old (fun k => -delta (g.val k))
    ghostPhaseMovingChoiceTarget (atgt (fout j)) (asrc (fout j))
      (delta (fout j)) (store (fout j)) (w (fout j)) = some (some (some (rout j))) := by
  cases j with
  | inl j =>
    have ht : atgt (f.val j.val) = false := by
      have hj := j.property
      simp only [ghostPhaseActivitySupport, mem_filter, mem_univ, true_and] at hj
      exact Bool.eq_false_of_not_eq_true hj
    exact ghost_phase_moving_choice_survivor atgt asrc store delta w hw hs
      (f.val j.val) (old j.val) (hold j.val) ht
  | inr k =>
    have hg := (g.property (g.val k)).mpr ⟨k, rfl⟩
    have hk : store (g.val k) = true := by
      simpa only [ghostPhaseChoiceSupport, mem_filter, mem_univ, true_and] using hg
    exact ghost_phase_moving_choice_stored _ _ _ _ _ hk



end

section
open Finset
/- Number of zero residues in an ordered dependent tuple. -/
noncomputable def orderedResidueZeroCount {J : Type*} [Fintype J]
    {R : J → Type*} [∀ j, Zero (R j)] [∀ j, DecidableEq (R j)]
    (r : (j : J) → R j) : ℕ :=
  (univ.filter (fun j => r j = 0)).card

theorem ordered_zero_count_eq_sum {J : Type*} [Fintype J]
    {R : J → Type*} [∀ j, Zero (R j)] [∀ j, DecidableEq (R j)]
    (r : (j : J) → R j) :
    orderedResidueZeroCount r = ∑ j, if r j = 0 then (1 : ℕ) else 0 := by
  exact (sum_boole (fun j => r j = 0) univ).symm

theorem distinct_ordered_support_image {J P : Type*} [Fintype J] [DecidableEq P]
    {S : Finset P} (f : DistinctOrderedSupport J S) : univ.image f.val = S := by
  ext p
  simp only [mem_image, mem_univ, true_and]
  exact (f.property p).symm




/- A distinct ordered enumeration of actual pending phase coordinates has
the same zero count as the full phase-state zero set. -/
theorem distinct_phase_zero_count {J P : Type*} [Fintype J] [Fintype P]
    [DecidableEq P] {R : P → Type*} [∀ p, Zero (R p)] [∀ p, DecidableEq (R p)]
    {S : Finset P} (f : DistinctOrderedSupport J S)
    (w : (p : P) → GhostPhaseState (R p)) (hs : ghostPhasePendingSupport w = S)
    (r : (j : J) → R (f.val j))
    (hr : ∀ j, w (f.val j) = some (some (some (r j)))) :
    orderedResidueZeroCount r = (ghostPhaseZeroSet w).card := by
  classical
  unfold orderedResidueZeroCount
  apply card_bij (fun j _ => f.val j)
  · intro j hj
    have hj' : r j = 0 := by simpa only [mem_filter, mem_univ, true_and] using hj
    simp only [ghostPhaseZeroSet, mem_filter, mem_univ, true_and, hr j, hj']
  · intro j hj k hk heq
    exact f.val.injective heq
  · intro p hp
    have hz : w p = some (some (some 0)) := by
      simpa only [ghostPhaseZeroSet, mem_filter, mem_univ, true_and] using hp
    have hpS : p ∈ S := by
      rw [← hs]
      simp only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and]
      exact ⟨0, hz⟩
    obtain ⟨j, rfl⟩ := (f.property p).mp hpS
    refine ⟨j, ?_, rfl⟩
    simp only [mem_filter, mem_univ, true_and]
    have h := (hr j).symm.trans hz
    simpa only [Option.some.injEq] using h

/- Source damping includes zero residues that will be promoted as well as
zero residues that will remain in pending memory. -/
theorem ordered_zero_count_partition {J P : Type*} [Fintype J] [DecidableEq P]
    (f : J ↪ P) (T : Finset P) (R : P → Type*)
    [∀ p, Zero (R p)] [∀ p, DecidableEq (R p)] (old : (j : J) → R (f j)) :
    orderedResidueZeroCount old =
      (univ.filter (fun j => f j ∉ T ∧ old j = 0)).card +
        (univ.filter (fun j => f j ∈ T ∧ old j = 0)).card := by
  classical
  simpa only [orderedResidueZeroCount, filter_filter, not_not, and_comm] using
    (card_filter_add_card_filter_not (s := univ.filter (fun j => old j = 0))
      (fun j => f j ∉ T)).symm









end

section
open Finset
/- Exact normalized edge action with both endpoint damping factors and the
fresh-label measure. Compatibility is retained even for zero-weight choices. -/
theorem ghost_phase_measured_edge_storage {I : Type*} [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (delta : (i : I) → R i) (β : I → ℝ) (ρtgt ρsrc V : ℝ)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ z, (∏ i, (if atgt i && !(asrc i) then V⁻¹ else 1) *
      ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i)
        (β i) ρtgt ρsrc (z i) (w i)) * F z) =
      ∑ B ∈ (ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt).powerset,
        let z := fun i => ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i)
          (decide (i ∈ B)) (w i)
        (ρsrc ^ (ghostPhaseZeroSet w).card * ρtgt ^ (ghostPhaseZeroSet z).card *
          (V⁻¹) ^ (ghostPhasePromotionSet atgt w).card *
          (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i / V) *
          (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
            then 1 else 0)) * F z := by
  let N := ∏ i, if atgt i && !(asrc i) then V⁻¹ else 1
  have hN : (∑ z, (∏ i, (if atgt i && !(asrc i) then V⁻¹ else 1) *
      ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i)
        (β i) ρtgt ρsrc (z i) (w i)) * F z) =
      ∑ z, (∏ i, ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i)
        (β i) ρtgt ρsrc (z i) (w i)) * (N * F z) := by
    apply sum_congr rfl
    intro z _
    rw [prod_mul_distrib]
    dsimp only [N]
    ring
  rw [hN, ghost_phase_moving_storage_actual atgt asrc delta β (fun _ => ρtgt)
    (fun _ => ρsrc) w hw (fun z => N * F z)]
  apply sum_congr rfl
  intro B hB
  have hs : ∀ i, decide (i ∈ B) = true → atgt i = false ∧ asrc i = true := by
    intro i hi
    have h := mem_powerset.mp hB (of_decide_eq_true hi)
    simpa [ghostPhaseActivitySupport, and_comm] using h
  have hc := ghost_phase_run_normalized_edge_fresh_measure atgt asrc
    (fun i => decide (i ∈ B)) delta β ρtgt ρsrc V w hw hs
  rw [prod_mul_distrib] at hc
  dsimp only
  dsimp only [N]
  rw [← mul_assoc, mul_comm _ (∏ i, if atgt i && !(asrc i) then V⁻¹ else 1), hc]

/- The same actual edge action indexed by the canonical departing source
slots. The label embedding is injective; storage subsets carry no factorial. -/
theorem ghost_phase_measured_edge_slots {J I : Type*}
    [Fintype J] [DecidableEq J] [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (delta : (i : I) → R i) (β : I → ℝ) (ρtgt ρsrc V : ℝ)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (g : J ↪ I)
    (hg : univ.image g = ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt)
    (F : ((i : I) → GhostPhaseState (R i)) → ℝ) :
    (∑ z, (∏ i, (if atgt i && !(asrc i) then V⁻¹ else 1) *
      ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i)
        (β i) ρtgt ρsrc (z i) (w i)) * F z) =
      ∑ S ∈ (univ : Finset J).powerset,
        let z := fun i => ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i)
          (decide (i ∈ S.image g)) (w i)
        (ρsrc ^ (ghostPhaseZeroSet w).card * ρtgt ^ (ghostPhaseZeroSet z).card *
          (V⁻¹) ^ (ghostPhasePromotionSet atgt w).card *
          (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i / V) *
          (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
            then 1 else 0)) * F z := by
  rw [ghost_phase_measured_edge_storage atgt asrc delta β ρtgt ρsrc V w hw F,
    ← hg, distinct_slot_subset_sum]
end

section
open Finset
/- A real kernel identity for all real tests extends to complex tests. -/
theorem finite_real_action_complex {X J : Type*} [Fintype X]
    (S : Finset J) (K : X → ℝ) (W : J → ℝ) (out : J → X)
    (h : ∀ f : X → ℝ, (∑ x, K x * f x) = ∑ j ∈ S, W j * f (out j))
    (F : X → ℂ) :
    (∑ x, (K x : ℂ) * F x) = ∑ j ∈ S, (W j : ℂ) * F (out j) := by
  apply Complex.ext
  · simpa using h (fun x => (F x).re)
  · simpa using h (fun x => (F x).im)




/- Canonical departing-slot form, with the physical complex continuation
and no storage factorial. -/
theorem ghost_phase_measured_edge_complex_slots {J I : Type*}
    [Fintype J] [DecidableEq J] [Fintype I] [DecidableEq I]
    {R : I → Type*} [∀ i, AddGroup (R i)] [∀ i, Fintype (R i)] [∀ i, DecidableEq (R i)]
    (atgt asrc : I → Bool) (delta : (i : I) → R i) (β : I → ℝ) (ρtgt ρsrc V : ℝ)
    (w : (i : I) → GhostPhaseState (R i)) (hw : ghostPhaseMask asrc w)
    (g : J ↪ I)
    (hg : univ.image g = ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt)
    (F : ((i : I) → GhostPhaseState (R i)) → ℂ) :
    (∑ z, ((∏ i, (if atgt i && !(asrc i) then V⁻¹ else 1) *
      ghostPhaseDampedMovingEdge (atgt i) (asrc i) (delta i)
        (β i) ρtgt ρsrc (z i) (w i) : ℝ) : ℂ) * F z) =
      ∑ S ∈ (univ : Finset J).powerset,
        let z := fun i => ghostPhaseMovingChoiceTarget (atgt i) (asrc i) (delta i)
          (decide (i ∈ S.image g)) (w i)
        ((ρsrc ^ (ghostPhaseZeroSet w).card * ρtgt ^ (ghostPhaseZeroSet z).card *
          (V⁻¹) ^ (ghostPhasePromotionSet atgt w).card *
          (∏ i ∈ ghostPhaseFreshSet atgt asrc w, β i / V) *
          (if ∀ i, ghostPhaseMovingEdgeCompatible (atgt i) (asrc i) (delta i) (w i) = true
            then 1 else 0) : ℝ) : ℂ) * F z := by
  exact finite_real_action_complex _ _ _ _
    (ghost_phase_measured_edge_slots atgt asrc delta β ρtgt ρsrc V w hw g hg) F
end

section
open Finset Classical
/- Choosing eligible indices is equivalent to an ambient embedding together
with the assertion that every chosen index lies in the eligible set. -/
def promotionIndexEquiv {A J : Type*} (Z : Finset J) :
    (A ↪ ↥Z) ≃ {e : A ↪ J // ∀ a, e a ∈ Z} where
  toFun e := ⟨e.trans ⟨Subtype.val, Subtype.val_injective⟩, fun a => (e a).property⟩
  invFun e := ⟨fun a => ⟨e.val a, e.property a⟩,
    fun _ _ h => e.val.injective (congrArg Subtype.val h)⟩
  left_inv e := by ext a; rfl
  right_inv e := by apply Subtype.ext; ext a; rfl

/- Exact reindexing into the eligible embedding type. The summand can retain
all information about the old particle indices and their numerical labels. -/
theorem promotionChoice_sum_ambient {A J M : Type*} [Fintype A] [Fintype J]
    [AddCommMonoid M] (Z : Finset J) (F : (A ↪ J) → M) :
    (∑ e : A ↪ ↥Z, F (e.trans ⟨Subtype.val, Subtype.val_injective⟩)) =
      ∑ e : A ↪ J, if ∀ a, e a ∈ Z then F e else 0 := by
  calc
    _ = ∑ e : {e : A ↪ J // ∀ a, e a ∈ Z}, F e.val :=
      (promotionIndexEquiv Z).sum_comp (fun e => F e.val)
    _ = ∑ e ∈ (univ : Finset (A ↪ J)).filter (fun e => ∀ a, e a ∈ Z), F e :=
      (sum_subtype _ (by simp) F).symm
    _ = _ := sum_filter _ _

/- Distinct specified slots are filled by distinct eligible old indices. -/
theorem promotionChoice_card {A J : Type*} [Fintype A] (Z : Finset J) :
    Fintype.card (A ↪ ↥Z) = Z.card.descFactorial (Fintype.card A) := by
  simpa only [Fintype.card_coe] using
    (Fintype.card_embedding_eq (α := A) (β := ↥Z))




/- Old indices selected by an ordered promotion choice. -/
def promotionSelectedIndices {A J : Type*} [Fintype A] {Z : Finset J}
    (e : A ↪ ↥Z) : Finset J :=
  univ.map (e.trans ⟨Subtype.val, Subtype.val_injective⟩)

section

variable
  {A J : Type*}
  [sharedInstance1 : Fintype A]
  {Z : Finset J}
  (e : A ↪ ↥Z)

include A J sharedInstance1 Z e

theorem promotionSelectedIndices_card  : (promotionSelectedIndices e).card = Fintype.card A := by
  simp only [promotionSelectedIndices, card_map, card_univ]

theorem promotionSelectedIndices_subset  : promotionSelectedIndices e ⊆ Z := by
  intro j hj
  obtain ⟨a, _, rfl⟩ := mem_map.mp hj
  exact (e a).property

theorem promotionSlots_card_le  : Fintype.card A ≤ Z.card := by
  simpa only [Fintype.card_coe] using Fintype.card_le_of_embedding e

end


/- Removing a promotion choice leaves exactly the unselected eligible indices. -/
theorem promotionEligibleSurvivors_card {A J : Type*} [Fintype A] [DecidableEq J]
    {Z : Finset J} (e : A ↪ ↥Z) :
    (Z \ promotionSelectedIndices e).card = Z.card - Fintype.card A := by
  rw [card_sdiff_of_subset (promotionSelectedIndices_subset e), promotionSelectedIndices_card]

/- Total old memory loses one index for each promoted slot, including when
different old indices carry equal numerical particle values. -/
theorem promotionOldSurvivors_card {A J : Type*} [Fintype A] [Fintype J] [DecidableEq J]
    {Z : Finset J} (e : A ↪ ↥Z) :
    ((univ : Finset J) \ promotionSelectedIndices e).card =
      Fintype.card J - Fintype.card A := by
  rw [card_sdiff_of_subset (subset_univ _), promotionSelectedIndices_card, card_univ]









end

section
open Finset Classical
noncomputable def unrestrictedEdgeDampingBound (ρ vmin : ℝ) (T : ℕ) : ℝ :=
  ((T.factorial : ℝ) * (max 1 (1 / vmin)) ^ T) / (1 - ρ) ^ (T + 1)

noncomputable def unrestrictedEdgeChoiceBound (ρ v vmin : ℝ) (T : ℕ) : ℝ :=
  unrestrictedEdgeDampingBound ρ vmin T * v ^ T * 2 ^ T

noncomputable def unrestrictedEdgeRowBound (ρ v vmin : ℝ) (T : ℕ) : ℝ :=
  4 ^ T * unrestrictedEdgeChoiceBound ρ v vmin T

noncomputable def unrestrictedEdgeReversalBound (vmin vmax : ℝ) (T : ℕ) : ℝ :=
  (max 1 vmax) ^ T * (max 1 (1 / vmin)) ^ T

/- For a promotions and b stores among t slots: ordered retrieval and remaining
output damping, promotion normalization, Schur weight change, and fresh mass.
The ratio v^b/v^a is exactly the integer-exponent factor v^(b-a). -/
noncomputable def unrestrictedEdgeChoiceCost (ρ v V mass : ℝ) (z t a b : ℕ) : ℝ :=
  (((z.descFactorial a : ℝ) * ρ ^ (z - a)) / V ^ a) *
    (v ^ b / v ^ a) * mass ^ (t - a)




theorem unrestrictedEdgeDampingBound_nonneg {ρ vmin : ℝ} (hρ : ρ < 1) (T : ℕ) :
    0 ≤ unrestrictedEdgeDampingBound ρ vmin T := by
  unfold unrestrictedEdgeDampingBound
  have hd : 0 < 1 - ρ := sub_pos.mpr hρ
  have hm : 0 ≤ max 1 (1 / vmin) := le_trans zero_le_one (le_max_left _ _)
  positivity

theorem unrestrictedEdgeChoiceCost_nonneg {ρ v V mass : ℝ}
    (hρ : 0 ≤ ρ) (hv : 0 ≤ v) (hV : 0 ≤ V) (hmass : 0 ≤ mass)
    (z t a b : ℕ) : 0 ≤ unrestrictedEdgeChoiceCost ρ v V mass z t a b := by
  unfold unrestrictedEdgeChoiceCost
  positivity

/- Ordered retrievals are controlled uniformly, including the impossible
case z<a, where the descending factorial is zero. -/
theorem unrestricted_edge_damped_retrieval_le {ρ vmin V : ℝ}
    (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1) (hvmin : 0 < vmin) (hV : vmin ≤ V)
    (T z a : ℕ) (ha : a ≤ T) :
    ((z.descFactorial a : ℝ) * ρ ^ (z - a)) / V ^ a ≤
      unrestrictedEdgeDampingBound ρ vmin T := by
  by_cases haz : a ≤ z
  · have h := uniform_damped_descFactorial_bound hρ0 hρ1 hvmin hV T (z - a) a ha
    simpa only [Nat.sub_add_cancel haz, unrestrictedEdgeDampingBound] using h
  · rw [Nat.descFactorial_of_lt (Nat.lt_of_not_ge haz), Nat.cast_zero, zero_mul, zero_div]
    exact unrestrictedEdgeDampingBound_nonneg hρ1 T

/- The Schur weight change is uniformly bounded by v^T for a,b≤T. -/
theorem unrestricted_edge_weight_ratio_le {v : ℝ} (hv : 1 < v)
    (T a b : ℕ) (hb : b ≤ T) : v ^ b / v ^ a ≤ v ^ T := by
  have hv0 : 0 ≤ v := (zero_lt_one.trans hv).le
  calc
    v ^ b / v ^ a ≤ v ^ b := div_le_self (pow_nonneg hv0 b) (one_le_pow₀ hv.le)
    _ ≤ v ^ T := pow_le_pow_right₀ hv.le hb

/- A single fixed pair of transfer-slot subsets costs a constant depending
only on T, ρ, v and the lower mass bound, independently of z and J. -/
theorem unrestricted_edge_choice_cost_le {ρ v vmin V mass : ℝ}
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hV : vmin ≤ V) (hmass0 : 0 ≤ mass) (hmass2 : mass ≤ 2)
    (T z t a b : ℕ) (ht : t ≤ T) (ha : a ≤ t) (hb : b ≤ t) :
    unrestrictedEdgeChoiceCost ρ v V mass z t a b ≤
      unrestrictedEdgeChoiceBound ρ v vmin T := by
  have hv0 : 0 ≤ v := (zero_lt_one.trans hv).le
  have hV0 : 0 ≤ V := (hvmin.trans_le hV).le
  have hD := unrestricted_edge_damped_retrieval_le hρ0.le hρ1 hvmin hV T z a (ha.trans ht)
  have hW := unrestricted_edge_weight_ratio_le hv T a b (hb.trans ht)
  have hF : mass ^ (t - a) ≤ (2 : ℝ) ^ T :=
    (pow_le_pow_left₀ hmass0 hmass2 _).trans
      (pow_le_pow_right₀ (by norm_num) ((Nat.sub_le t a).trans ht))
  unfold unrestrictedEdgeChoiceCost unrestrictedEdgeChoiceBound
  apply mul_le_mul
  · exact mul_le_mul hD hW (div_nonneg (pow_nonneg hv0 _) (pow_nonneg hv0 _))
      (unrestrictedEdgeDampingBound_nonneg hρ1 T)
  · exact hF
  · exact pow_nonneg hmass0 _
  · exact mul_nonneg (unrestrictedEdgeDampingBound_nonneg hρ1 T) (pow_nonneg hv0 _)

/- Reversal changes the promotion normalization by a bounded factor for
V∈[vmin,vmax], uniformly over a,b≤T. -/
theorem unrestricted_edge_reversal_ratio_le {vmin vmax V : ℝ}
    (hvmin : 0 < vmin) (hVlo : vmin ≤ V) (hVhi : V ≤ vmax)
    (T a b : ℕ) (ha : a ≤ T) (hb : b ≤ T) :
    V ^ b / V ^ a ≤ unrestrictedEdgeReversalBound vmin vmax T := by
  have hV0 : 0 ≤ V := (hvmin.trans_le hVlo).le
  have hp : V ^ b ≤ (max 1 vmax) ^ T :=
    (pow_le_pow_left₀ hV0 (hVhi.trans (le_max_right _ _)) _).trans
      (pow_le_pow_right₀ (le_max_left _ _) hb)
  have hi : (1 / V) ^ a ≤ (max 1 (1 / vmin)) ^ T :=
    (pow_le_pow_left₀ (by positivity)
      ((one_div_le_one_div_of_le hvmin hVlo).trans (le_max_right _ _)) _).trans
      (pow_le_pow_right₀ (le_max_left _ _) ha)
  calc
    V ^ b / V ^ a = V ^ b * (1 / V) ^ a := by rw [one_div_pow]; ring
    _ ≤ (max 1 vmax) ^ T * (max 1 (1 / vmin)) ^ T :=
      mul_le_mul hp hi (by positivity) (by positivity)
    _ = _ := rfl




/- Sum over the independently chosen source store subset and target promotion
subset. The eligible old-particle count may even vary with these subsets. -/
noncomputable def unrestrictedEdgeRowCost (ρ v V mass : ℝ) (t : ℕ)
    (eligible : Finset (Fin t) → Finset (Fin t) → ℕ) : ℝ :=
  ∑ stores : Finset (Fin t), ∑ promotions : Finset (Fin t),
    unrestrictedEdgeChoiceCost ρ v V mass (eligible stores promotions) t promotions.card stores.card




/- There are exactly 4^t pairs of store and promotion subsets. -/
theorem unrestricted_edge_subset_pair_sum (t : ℕ) (C : ℝ) :
    (∑ _stores : Finset (Fin t), ∑ _promotions : Finset (Fin t), C) = (4 : ℝ) ^ t * C := by
  simp only [sum_const, card_univ, Fintype.card_finset, Fintype.card_fin,
    nsmul_eq_mul, Nat.cast_pow, Nat.cast_ofNat]
  rw [← mul_assoc, ← mul_pow]
  norm_num

/- Explicit scalar weighted row bound for one unrestricted big group. -/
theorem unrestricted_edge_row_cost_le {ρ v vmin V mass : ℝ}
    (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hv : 1 < v)
    (hvmin : 0 < vmin) (hV : vmin ≤ V) (hmass0 : 0 ≤ mass) (hmass2 : mass ≤ 2)
    (T t : ℕ) (ht : t ≤ T) (eligible : Finset (Fin t) → Finset (Fin t) → ℕ) :
    unrestrictedEdgeRowCost ρ v V mass t eligible ≤ unrestrictedEdgeRowBound ρ v vmin T := by
  have hC : 0 ≤ unrestrictedEdgeChoiceBound ρ v vmin T := by
    unfold unrestrictedEdgeChoiceBound
    exact mul_nonneg (mul_nonneg (unrestrictedEdgeDampingBound_nonneg hρ1 T)
      (pow_nonneg (zero_lt_one.trans hv).le _)) (by positivity)
  calc
    unrestrictedEdgeRowCost ρ v V mass t eligible ≤
        ∑ _stores : Finset (Fin t), ∑ _promotions : Finset (Fin t),
          unrestrictedEdgeChoiceBound ρ v vmin T := by
      apply sum_le_sum
      intro stores hs
      apply sum_le_sum
      intro promotions hp
      apply unrestricted_edge_choice_cost_le hρ0 hρ1 hv hvmin hV hmass0 hmass2 T _ t _ _ ht
      · exact (card_le_card (subset_univ promotions)).trans (by simp)
      · exact (card_le_card (subset_univ stores)).trans (by simp)
    _ = (4 : ℝ) ^ t * unrestrictedEdgeChoiceBound ρ v vmin T := unrestricted_edge_subset_pair_sum _ _
    _ ≤ (4 : ℝ) ^ T * unrestrictedEdgeChoiceBound ρ v vmin T :=
      mul_le_mul_of_nonneg_right (pow_le_pow_right₀ (by norm_num) ht) hC
    _ = _ := rfl



end

section
open Finset Classical
abbrev UnrestrictedFreshLabels {I : Type*} (P : Type*) (T : Finset I) :=
  {i : I // i ∉ T} → P

/- Stitch prescribed promoted values and freely drawn values into one target tuple. -/
noncomputable def unrestrictedTargetLabels {I P : Type*} [DecidableEq I] (T : Finset I)
    (promoted : T → P) (fresh : UnrestrictedFreshLabels P T) : I → P :=
  fun i => if hi : i ∈ T then promoted ⟨i, hi⟩ else fresh ⟨i, hi⟩

theorem unrestrictedTargetLabels_promoted {I P : Type*} [DecidableEq I] (T : Finset I)
    (promoted : T → P) (fresh : UnrestrictedFreshLabels P T) (i : T) :
    unrestrictedTargetLabels T promoted fresh i.val = promoted i := by
  simp [unrestrictedTargetLabels, i.property]

theorem unrestrictedTargetLabels_fresh {I P : Type*} [DecidableEq I] (T : Finset I)
    (promoted : T → P) (fresh : UnrestrictedFreshLabels P T) (i : {i : I // i ∉ T}) :
    unrestrictedTargetLabels T promoted fresh i.val = fresh i := by
  simp [unrestrictedTargetLabels, i.property]

/- The complementary slots have exactly total-slot-count minus promotion-count entries. -/
theorem unrestricted_fresh_slot_card {I : Type*} [Fintype I] [DecidableEq I] (T : Finset I) :
    Fintype.card {i : I // i ∉ T} = Fintype.card I - T.card := by
  rw [Fintype.card_subtype_compl]
  simp

noncomputable def unrestrictedFreshWeight {I P : Type*} [Fintype I] [DecidableEq I]
    (μ : P → ℝ) (T : Finset I) (fresh : UnrestrictedFreshLabels P T) : ℝ :=
  ∏ i : {i : I // i ∉ T}, μ (fresh i)

theorem unrestrictedFreshWeight_nonneg {I P : Type*} [Fintype I] [DecidableEq I]
    (μ : P → ℝ) (T : Finset I) (hμ : ∀ p, 0 ≤ μ p) (fresh : UnrestrictedFreshLabels P T) :
    0 ≤ unrestrictedFreshWeight μ T fresh :=
  prod_nonneg fun i _ => hμ (fresh i)

/- The unrestricted product draw has exactly the corresponding power of the total fresh mass. -/
theorem unrestricted_fresh_mass_eq {I P : Type*} [Fintype I] [DecidableEq I] [Fintype P]
    (μ : P → ℝ) (T : Finset I) :
    (∑ fresh : UnrestrictedFreshLabels P T, unrestrictedFreshWeight μ T fresh) =
      (∑ p : P, μ p) ^ (Fintype.card I - T.card) := by
  unfold unrestrictedFreshWeight
  rw [← Fintype.prod_sum]
  simp only [prod_const, card_univ, unrestricted_fresh_slot_card]












end

section
open Finset Classical
noncomputable def orderedPredicateCount {Z : Type*} (q : FiniteOrderedTuple Z)
    (hit : Z → Prop) : ℕ :=
  ∑ j, if hit (q.2 j) then 1 else 0

theorem orderedPredicateCount_append {Z : Type*} {m n : ℕ}
    (p : Fin m → Z) (q : Fin n → Z) (hit : Z → Prop) :
    orderedPredicateCount ⟨m + n, Fin.addCases p q⟩ hit =
      orderedPredicateCount ⟨m, p⟩ hit + orderedPredicateCount ⟨n, q⟩ hit := by
  unfold orderedPredicateCount
  rw [Fin.sum_univ_add]
  simp only [Fin.addCases_left, Fin.addCases_right]

theorem orderedPredicateCount_retained {Z : Type*} {N : ℕ}
    (p : Fin N → Z) (s : Finset (Fin N)) (hit : Z → Prop) :
    orderedPredicateCount ⟨s.card, retainedOrderedTuple p s⟩ hit =
      (s.filter (fun j => hit (p j))).card := by
  unfold orderedPredicateCount retainedOrderedTuple
  rw [s.equivFin.symm.sum_comp (fun j : s => if hit (p j.val) then 1 else 0)]
  calc
    _ = ∑ j ∈ s, if hit (p j) then 1 else 0 :=
      sum_coe_sort s (fun j => if hit (p j) then 1 else 0)
    _ = _ := by simp

/- Survivors of a promotion choice are old indices, never newly stored entries. -/
noncomputable def unrestrictedEdgeSurvivors {A : Type*} [Fintype A] {N : ℕ}
    {eligible : Finset (Fin N)} (e : A ↪ ↥eligible) : Finset (Fin N) :=
  univ \ promotionSelectedIndices e

/- Store the source entries, transport all memory, and remove the selected
old indices. This order is equivalent to transport-then-delete because the
promotion injection only ranges over the original index set. -/
noncomputable def unrestrictedEdgeMemory {A Z : Type*} [Fintype A] {N b : ℕ}
    (old : Fin N → Z) (transport : Z → Z) (stored : Fin b → Z)
    {eligible : Finset (Fin N)} (e : A ↪ ↥eligible) : FiniteOrderedTuple Z :=
  retainedBirthTuple (transport ∘ old) (unrestrictedEdgeSurvivors e) (transport ∘ stored)

section

variable
  {A Z : Type*}
  [sharedInstance1 : Fintype A]
  {N b : ℕ}
  (old : Fin N → Z)
  (transport : Z → Z)
  (stored : Fin b → Z)

include A Z sharedInstance1 N b old transport stored

theorem unrestrictedEdgeMemory_length 
    {eligible : Finset (Fin N)} (e : A ↪ ↥eligible) :
    (unrestrictedEdgeMemory old transport stored e).1 = N - Fintype.card A + b := by
  change (univ \ promotionSelectedIndices e).card + b = _
  rw [promotionOldSurvivors_card]
  simp only [Fintype.card_fin]

/- Every eligible old particle that is not promoted survives as an output
zero. Newly stored particles can only increase the number of output zeros. -/
theorem unrestrictedEdgeMemory_hit_count_le 
    (hit : Z → Prop) {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
    (heligible : ∀ j ∈ eligible, hit (transport (old j))) :
    eligible.card - Fintype.card A ≤
      orderedPredicateCount (unrestrictedEdgeMemory old transport stored e) hit := by
  rw [← promotionEligibleSurvivors_card e]
  change (eligible \ promotionSelectedIndices e).card ≤
    orderedPredicateCount
      ⟨(unrestrictedEdgeSurvivors e).card + b,
        Fin.addCases (retainedOrderedTuple (transport ∘ old) (unrestrictedEdgeSurvivors e))
          (transport ∘ stored)⟩ hit
  rw [orderedPredicateCount_append, orderedPredicateCount_retained]
  apply (card_le_card ?_).trans (Nat.le_add_right _ _)
  intro j hj
  obtain ⟨hjE, hjN⟩ := mem_sdiff.mp hj
  exact mem_filter.mpr ⟨mem_sdiff.mpr ⟨mem_univ _, hjN⟩, heligible j hjE⟩

theorem unrestrictedEdgeMemory_damping_le 
    (hit : Z → Prop) {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
    (heligible : ∀ j ∈ eligible, hit (transport (old j)))
    {ρ : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1) :
    ρ ^ orderedPredicateCount (unrestrictedEdgeMemory old transport stored e) hit ≤
      ρ ^ (eligible.card - Fintype.card A) :=
  pow_le_pow_of_le_one hρ0 hρ1
    (unrestrictedEdgeMemory_hit_count_le old transport stored hit e heligible)

/- The literal input and output damping factors admit the old-survivor bound. -/
theorem unrestrictedEdgeMemory_two_damping_le 
    (hit : Z → Prop) {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
    (heligible : ∀ j ∈ eligible, hit (transport (old j)))
    {ρ : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1) :
    ρ ^ orderedPredicateCount ⟨N, old⟩ hit *
        ρ ^ orderedPredicateCount (unrestrictedEdgeMemory old transport stored e) hit ≤
      ρ ^ (eligible.card - Fintype.card A) := by
  have hi : ρ ^ orderedPredicateCount ⟨N, old⟩ hit ≤ 1 := pow_le_one₀ hρ0 hρ1
  calc
    _ ≤ 1 * ρ ^ orderedPredicateCount (unrestrictedEdgeMemory old transport stored e) hit :=
      mul_le_mul_of_nonneg_right hi (pow_nonneg hρ0 _)
    _ ≤ _ := by simpa only [one_mul] using
      unrestrictedEdgeMemory_damping_le old transport stored hit e heligible hρ0 hρ1

/- Exact change of the geometric memory weight for each individual event. -/
theorem unrestrictedEdgeMemory_weight 
    {eligible : Finset (Fin N)} (e : A ↪ ↥eligible) {v : ℝ} (hv : v ≠ 0) :
    v ^ (unrestrictedEdgeMemory old transport stored e).1 =
      v ^ N * (v ^ b / v ^ Fintype.card A) := by
  have ha : Fintype.card A ≤ N := (promotionSlots_card_le e).trans (by
    simpa using card_le_card (subset_univ eligible))
  rw [unrestrictedEdgeMemory_length, pow_add]
  have hn : v ^ N = v ^ (N - Fintype.card A) * v ^ Fintype.card A := by
    rw [← pow_add, Nat.sub_add_cancel ha]
  rw [hn]
  field_simp

end

end

section
open Finset Classical
/- The selected old indices and their complement reconstruct every old index. -/
noncomputable def promotionIndexSplit {A J : Type*} (e : A ↪ J) :
    A ⊕ {j : J // j ∉ Set.range e} ≃ J :=
  (Equiv.sumCongr (Equiv.ofInjective e e.injective) (Equiv.refl _)).trans
    (Equiv.sumCompl (fun j => j ∈ Set.range e))





















end

section
open Finset Classical
abbrev UnrestrictedResidueParticle {P : Type*} (n : P → ℕ) := Σ p : P, ZMod (n p)

/- Move the residue frame by Δ without changing the particle label. -/
def unrestrictedResidueTransport {P : Type*} (n : P → ℕ) (Δ : ℤ) :
    UnrestrictedResidueParticle n ≃ UnrestrictedResidueParticle n where
  toFun z := ⟨z.1, z.2 - (Δ : ZMod (n z.1))⟩
  invFun z := ⟨z.1, z.2 + (Δ : ZMod (n z.1))⟩
  left_inv := by rintro ⟨p, r⟩; simp
  right_inv := by rintro ⟨p, r⟩; simp




theorem unrestrictedResidueTransport_apply {P : Type*} (n : P → ℕ) (Δ : ℤ)
    (p : P) (r : ZMod (n p)) :
    unrestrictedResidueTransport n Δ ⟨p, r⟩ = ⟨p, r - (Δ : ZMod (n p))⟩ := rfl







theorem unrestrictedResidueTransport_symm {P : Type*} (n : P → ℕ) (Δ : ℤ) :
    (unrestrictedResidueTransport n Δ).symm = unrestrictedResidueTransport n (-Δ) := by
  apply Equiv.ext
  rintro ⟨p, r⟩
  simp [unrestrictedResidueTransport]

/- Birth or storage starts a particle at residue zero. -/
def unrestrictedResidueSeed {P : Type*} (n : P → ℕ) (p : P) : UnrestrictedResidueParticle n :=
  ⟨p, 0⟩

def unrestrictedResidueHit {P : Type*} {n : P → ℕ} (z : UnrestrictedResidueParticle n) : Prop :=
  z.2 = 0




theorem unrestrictedResidueTransport_seed {P : Type*} (n : P → ℕ) (Δ : ℤ) (p : P) :
    unrestrictedResidueTransport n Δ (unrestrictedResidueSeed n p) =
      ⟨p, -(Δ : ZMod (n p))⟩ := by
  simp [unrestrictedResidueTransport, unrestrictedResidueSeed]

/- Under the minus-displacement convention, an old particle hits zero
exactly when its old residue equals the displacement. -/
theorem unrestrictedResidueTransport_hit_iff {P : Type*} (n : P → ℕ) (Δ : ℤ)
    (z : UnrestrictedResidueParticle n) :
    unrestrictedResidueHit (unrestrictedResidueTransport n Δ z) ↔
      z.2 = (Δ : ZMod (n z.1)) := by
  rcases z with ⟨p, r⟩
  change r - (Δ : ZMod (n p)) = 0 ↔ r = (Δ : ZMod (n p))
  exact sub_eq_zero

/- The particle measure is label mass times counting measure on residues. -/
def unrestrictedResidueWeight {P : Type*} {n : P → ℕ}
    (μ : P → ℝ) (z : UnrestrictedResidueParticle n) : ℝ := μ z.1

theorem unrestrictedResidueWeight_transport {P : Type*} (n : P → ℕ)
    (μ : P → ℝ) (Δ : ℤ) (z : UnrestrictedResidueParticle n) :
    unrestrictedResidueWeight μ (unrestrictedResidueTransport n Δ z) =
      unrestrictedResidueWeight μ z := rfl







/- Eligibility retains old particle indices and requires the dilation ban.
Nothing in this definition identifies particles with equal labels or residues. -/
noncomputable def unrestrictedResidueEligible {P : Type*} {N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (old : Fin N → UnrestrictedResidueParticle n) : Finset (Fin N) :=
  univ.filter fun j => (old j).2 = (Δ : ZMod (n (old j).1)) ∧ ¬ (n (old j).1 : ℤ) ∣ D

section

variable
  {P : Type*}
  {N : ℕ}
  (n : P → ℕ)
  (Δ D : ℤ)
  (old : Fin N → UnrestrictedResidueParticle n)

include P N n Δ D old

theorem mem_unrestrictedResidueEligible  (j : Fin N) :
    j ∈ unrestrictedResidueEligible n Δ D old ↔
      (old j).2 = (Δ : ZMod (n (old j).1)) ∧ ¬ (n (old j).1 : ℤ) ∣ D := by
  simp [unrestrictedResidueEligible]

theorem unrestrictedResidueEligible_iff_hit  (j : Fin N) :
    j ∈ unrestrictedResidueEligible n Δ D old ↔
      unrestrictedResidueHit (unrestrictedResidueTransport n Δ (old j)) ∧
        ¬ (n (old j).1 : ℤ) ∣ D := by
  rw [mem_unrestrictedResidueEligible, unrestrictedResidueTransport_hit_iff]

/- The precise translated-hit hypothesis consumed by the generic ordered
memory survivor/damping theorems. -/
theorem unrestrictedResidueEligible_translated_hit  :
    ∀ j ∈ unrestrictedResidueEligible n Δ D old,
      unrestrictedResidueHit (unrestrictedResidueTransport n Δ (old j)) := by
  intro j hj
  exact ((unrestrictedResidueEligible_iff_hit n Δ D old j).mp hj).1

end

end

section
open Finset Classical
noncomputable def unrestrictedStoredTuple {P Z : Type*} {t : ℕ}
    (source : Fin t → P) (seed : P → Z) (stores : Finset (Fin t)) :
    Fin stores.card → Z := retainedOrderedTuple (seed ∘ source) stores

noncomputable def unrestrictedEdgeOutput {P Z : Type*} {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (stores promotions : Finset (Fin t)) {eligible : Finset (Fin N)}
    (e : promotions ↪ ↥eligible) : FiniteOrderedTuple Z :=
  unrestrictedEdgeMemory old transport (unrestrictedStoredTuple source seed stores) e

noncomputable def unrestrictedEdgeTarget {P Z : Type*} {t N : ℕ}
    (old : Fin N → Z) (label : Z → P) (promotions : Finset (Fin t))
    {eligible : Finset (Fin N)} (e : promotions ↪ ↥eligible)
    (fresh : UnrestrictedFreshLabels P promotions) : Fin t → P :=
  unrestrictedTargetLabels promotions (fun i => label (old (e i).val)) fresh

/- The two damping factors occur on the actual input and output memories. -/
noncomputable def unrestrictedEdgeEventMass {P Z : Type*} {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (hit : Z → Prop) (μ : P → ℝ) (ρ V : ℝ) (stores promotions : Finset (Fin t))
    {eligible : Finset (Fin N)} (e : promotions ↪ ↥eligible)
    (fresh : UnrestrictedFreshLabels P promotions) : ℝ :=
  (ρ ^ orderedPredicateCount ⟨N, old⟩ hit *
    ρ ^ orderedPredicateCount (unrestrictedEdgeOutput source old seed transport stores promotions e) hit /
      V ^ promotions.card) * unrestrictedFreshWeight μ promotions fresh

section

variable
  {P Z : Type*}
  {t N : ℕ}
  (source : Fin t → P)
  (old : Fin N → Z)
  (seed : P → Z)
  (transport : Z → Z)
  (hit : Z → Prop)
  (μ : P → ℝ)
  {ρ V : ℝ}

include P Z t N source old seed transport hit μ ρ V

theorem unrestrictedEdgeEventMass_nonneg  (hρ : 0 ≤ ρ) (hV : 0 ≤ V)
    (hμ : ∀ p, 0 ≤ μ p) (stores promotions : Finset (Fin t))
    {eligible : Finset (Fin N)} (e : promotions ↪ ↥eligible)
    (fresh : UnrestrictedFreshLabels P promotions) :
    0 ≤ unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores promotions e fresh := by
  unfold unrestrictedEdgeEventMass
  exact mul_nonneg (div_nonneg (mul_nonneg (pow_nonneg hρ _) (pow_nonneg hρ _))
    (pow_nonneg hV _)) (unrestrictedFreshWeight_nonneg μ promotions hμ fresh)

theorem unrestrictedEdgeEventMass_le  (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (hV : 0 ≤ V) (hμ : ∀ p, 0 ≤ μ p) (stores promotions : Finset (Fin t))
    {eligible : Finset (Fin N)} (e : promotions ↪ ↥eligible)
    (heligible : ∀ j ∈ eligible, hit (transport (old j)))
    (fresh : UnrestrictedFreshLabels P promotions) :
    unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores promotions e fresh ≤
      (ρ ^ (eligible.card - promotions.card) / V ^ promotions.card) *
        unrestrictedFreshWeight μ promotions fresh := by
  unfold unrestrictedEdgeEventMass unrestrictedEdgeOutput
  apply mul_le_mul_of_nonneg_right _ (unrestrictedFreshWeight_nonneg μ promotions hμ fresh)
  apply div_le_div_of_nonneg_right _ (pow_nonneg hV _)
  simpa only [Fintype.card_coe] using unrestrictedEdgeMemory_two_damping_le old transport
    (unrestrictedStoredTuple source seed stores) hit e heligible hρ0 hρ1

end


noncomputable def unrestrictedEdgeChoiceRowMass {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (hit : Z → Prop) (μ : P → ℝ) (ρ V v : ℝ) (eligible : Finset (Fin N))
    (stores promotions : Finset (Fin t)) : ℝ :=
  ∑ e : promotions ↪ ↥eligible, ∑ fresh : UnrestrictedFreshLabels P promotions,
    unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores promotions e fresh *
      v ^ (unrestrictedEdgeOutput source old seed transport stores promotions e).1

theorem unrestricted_edge_choice_row_mass_le {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (hit : Z → Prop) (μ : P → ℝ) {ρ V v : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (hV : 0 ≤ V) (hv : 0 < v) (hμ : ∀ p, 0 ≤ μ p) (eligible : Finset (Fin N))
    (heligible : ∀ j ∈ eligible, hit (transport (old j)))
    (stores promotions : Finset (Fin t)) :
    unrestrictedEdgeChoiceRowMass source old seed transport hit μ ρ V v eligible stores promotions ≤
      v ^ N * unrestrictedEdgeChoiceCost ρ v V (∑ p, μ p)
        eligible.card t promotions.card stores.card := by
  calc
    _ ≤ ∑ e : promotions ↪ ↥eligible, ∑ fresh : UnrestrictedFreshLabels P promotions,
        (ρ ^ (eligible.card - promotions.card) / V ^ promotions.card) *
          unrestrictedFreshWeight μ promotions fresh *
            (v ^ N * (v ^ stores.card / v ^ promotions.card)) := by
      apply sum_le_sum
      intro e he
      apply sum_le_sum
      intro fresh hf
      have hout : v ^ (unrestrictedEdgeOutput source old seed transport stores promotions e).1 =
          v ^ N * (v ^ stores.card / v ^ promotions.card) := by
        simpa only [unrestrictedEdgeOutput, Fintype.card_coe] using
          unrestrictedEdgeMemory_weight old transport (unrestrictedStoredTuple source seed stores) e
            (ne_of_gt hv)
      rw [← hout]
      exact mul_le_mul_of_nonneg_right
        (unrestrictedEdgeEventMass_le source old seed transport hit μ hρ0 hρ1 hV hμ stores promotions
          e heligible fresh) (pow_nonneg hv.le _)
    _ = _ := by
      simp_rw [← sum_mul, ← mul_sum]
      simp_rw [unrestricted_fresh_mass_eq μ promotions]
      simp only [Fintype.card_fin, sum_const, card_univ, nsmul_eq_mul,
        promotionChoice_card, Fintype.card_coe]
      unfold unrestrictedEdgeChoiceCost
      ring

noncomputable def unrestrictedEdgeRowMass {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (seed : P → Z) (transport : Z → Z)
    (hit : Z → Prop) (μ : P → ℝ) (ρ V v : ℝ) (eligible : Finset (Fin N)) : ℝ :=
  ∑ stores : Finset (Fin t), ∑ promotions : Finset (Fin t),
    unrestrictedEdgeChoiceRowMass source old seed transport hit μ ρ V v eligible stores promotions

section

variable
  {P Z : Type*}
  [sharedInstance1 : Fintype P]
  {t N : ℕ}
  (source : Fin t → P)
  (old : Fin N → Z)
  (seed : P → Z)
  (transport : Z → Z)
  (hit : Z → Prop)
  (μ : P → ℝ)

include P Z sharedInstance1 t N source old seed transport hit μ

theorem unrestricted_edge_row_mass_le_cost  {ρ V v : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (hV : 0 ≤ V) (hv : 0 < v) (hμ : ∀ p, 0 ≤ μ p) (eligible : Finset (Fin N))
    (heligible : ∀ j ∈ eligible, hit (transport (old j))) :
    unrestrictedEdgeRowMass source old seed transport hit μ ρ V v eligible ≤
      v ^ N * unrestrictedEdgeRowCost ρ v V (∑ p, μ p) t (fun _ _ => eligible.card) := by
  unfold unrestrictedEdgeRowMass unrestrictedEdgeRowCost
  simp_rw [mul_sum]
  apply sum_le_sum
  intro stores hs
  apply sum_le_sum
  intro promotions hp
  exact unrestricted_edge_choice_row_mass_le source old seed transport hit μ hρ0 hρ1 hV hv hμ
    eligible heligible stores promotions

theorem unrestricted_edge_row_mass_le  {ρ V v vmin : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1)
    (hv : 1 < v) (hvmin : 0 < vmin) (hV : vmin ≤ V) (hμ : ∀ p, 0 ≤ μ p)
    (hmass : ∑ p, μ p ≤ 2) (eligible : Finset (Fin N))
    (heligible : ∀ j ∈ eligible, hit (transport (old j))) (T : ℕ) (ht : t ≤ T) :
    unrestrictedEdgeRowMass source old seed transport hit μ ρ V v eligible ≤
      v ^ N * unrestrictedEdgeRowBound ρ v vmin T := by
  have hv0 : 0 < v := zero_lt_one.trans hv
  exact (unrestricted_edge_row_mass_le_cost source old seed transport hit μ hρ0.le hρ1.le
    (hvmin.trans_le hV).le hv0 hμ eligible heligible).trans
      (mul_le_mul_of_nonneg_left
        (unrestricted_edge_row_cost_le hρ0 hρ1 hv hvmin hV (sum_nonneg fun p _ => hμ p)
          hmass T t ht (fun _ _ => eligible.card)) (pow_nonneg hv0.le _))

end

end

section
open Finset Classical
noncomputable def unrestrictedEdgeAction {P Z : Type*} [Fintype P] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Z) (label : Z → P)
    (seed : P → Z) (transport : Z → Z) (hit : Z → Prop) (μ : P → ℝ)
    (ρ V : ℝ) (eligible : Finset (Fin N)) (B : ℕ)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥eligible) → UnrestrictedFreshLabels P promotions → ℂ)
    (F : (Fin t → P) → FiniteOrderedTuple Z → ℂ) : ℂ :=
  ∑ stores : Finset (Fin t), ∑ promotions : Finset (Fin t),
    ∑ e : promotions ↪ ↥eligible, ∑ fresh : UnrestrictedFreshLabels P promotions,
      (unrestrictedEdgeEventMass source old seed transport hit μ ρ V stores promotions e fresh : ℂ) *
        phase stores promotions e fresh *
          (if (unrestrictedEdgeOutput source old seed transport stores promotions e).1 ≤ B then
            F (unrestrictedEdgeTarget old label promotions e fresh)
              (unrestrictedEdgeOutput source old seed transport stores promotions e) else 0)






end

section
open Finset Classical
def unrestrictedResidueStorageAllowed {P : Type*} {t : ℕ}
    (n : P → ℕ) (D : ℤ) (source : Fin t → P) (stores : Finset (Fin t)) : Prop :=
  ∀ i ∈ stores, ¬ (n (source i) : ℤ) ∣ D

/- The displacement and dilation are fixed before the target fresh draws.
Storage and promotion both obey the dilation ban; only old indices may be
promoted. A phase can record additional bounded physical multipliers. -/
noncomputable def unrestrictedResidueEdgeAction {P : Type*} [Fintype P] {t N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (source : Fin t → P)
    (old : Fin N → UnrestrictedResidueParticle n) (μ : P → ℝ)
    (ρ V : ℝ) (B : ℕ)
    (phase : ∀ (_stores promotions : Finset (Fin t)),
      (promotions ↪ ↥(unrestrictedResidueEligible n Δ D old)) →
        UnrestrictedFreshLabels P promotions → ℂ)
    (F : (Fin t → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) : ℂ :=
  unrestrictedEdgeAction source old Sigma.fst (unrestrictedResidueSeed n)
    (unrestrictedResidueTransport n Δ) unrestrictedResidueHit μ ρ V
    (unrestrictedResidueEligible n Δ D old) B
    (fun stores promotions e fresh =>
      if unrestrictedResidueStorageAllowed n D source stores then phase stores promotions e fresh else 0) F






end

section
open Finset Classical
/- Old indices not selected by the ordered retrieval. -/
noncomputable def retrievalSurvivorIndices {a n : ℕ} (e : Fin a ↪ Fin n) :
    Finset (Fin n) := univ \ univ.map e

theorem mem_retrievalSurvivorIndices {a n : ℕ} (e : Fin a ↪ Fin n) (j : Fin n) :
    j ∈ retrievalSurvivorIndices e ↔ j ∉ Set.range e := by
  simp [retrievalSurvivorIndices, Set.mem_range]

theorem retrieval_survivor_card {a n : ℕ} (e : Fin a ↪ Fin n) :
    (retrievalSurvivorIndices e).card = n - a := by
  rw [retrievalSurvivorIndices, card_sdiff_of_subset (subset_univ _)]
  simp

/- Identify the complement subtype with the existing retained tuple's index set. -/
noncomputable def retrievalSurvivorEquiv {a n : ℕ} (e : Fin a ↪ Fin n) :
    {j : Fin n // j ∉ Set.range e} ≃ Fin (retrievalSurvivorIndices e).card :=
  (Equiv.subtypeEquivRight (fun j => (mem_retrievalSurvivorIndices e j).symm)).trans
    (retrievalSurvivorIndices e).equivFin




/- The selected and retained finite coordinates enumerate all old indices. -/
noncomputable def retrievalIndexSplit {a n : ℕ} (e : Fin a ↪ Fin n) :
    Fin a ⊕ Fin (retrievalSurvivorIndices e).card ≃ Fin n :=
  (Equiv.sumCongr (Equiv.refl _) (retrievalSurvivorEquiv e).symm).trans
    (promotionIndexSplit e)

/- The coordinate split with the retained tuple's precise enumeration. -/
noncomputable def retrievalTupleSplit {a n : ℕ} (e : Fin a ↪ Fin n) (Z : Type*) :
    (Fin n → Z) ≃ (Fin a → Z) × (Fin (retrievalSurvivorIndices e).card → Z) :=
  (Equiv.arrowCongr (retrievalIndexSplit e).symm (Equiv.refl Z)).trans
    (Equiv.sumArrowEquivProdArrow (Fin a) (Fin (retrievalSurvivorIndices e).card) Z)

section

variable
  {a n : ℕ}
  {Z : Type*}

include a n Z

/- The product weight splits over selected entries and the retained tuple. -/
theorem ordered_retrieval_weight_split 
    (e : Fin a ↪ Fin n) (μ : Z → ℝ) (q : Fin n → Z) :
    (∏ j, μ (q j)) = (∏ i, μ (q (e i))) *
      ∏ j, μ (retainedOrderedTuple q (retrievalSurvivorIndices e) j) := by
  have hp := (retrievalIndexSplit e).prod_comp (fun j => μ (q j))
  rw [Fintype.prod_sum_type] at hp
  exact hp.symm

/- Exact extraction for one injection, initially retaining the survivor-card index. -/
theorem ordered_retrieval_fixed_sum_card  [Fintype Z]
    (e : Fin a ↪ Fin n) (μ : Z → ℝ)
    (F : (Fin a → Z) → FiniteOrderedTuple Z → ℝ) :
    (∑ q : Fin n → Z, (∏ j, μ (q j)) * F (fun i => q (e i))
      ⟨(retrievalSurvivorIndices e).card,
        retainedOrderedTuple q (retrievalSurvivorIndices e)⟩) =
    ∑ x : Fin a → Z, ∑ u : Fin (retrievalSurvivorIndices e).card → Z,
      ((∏ i, μ (x i)) * ∏ j, μ (u j)) *
        F x ⟨(retrievalSurvivorIndices e).card, u⟩ := by
  let E := retrievalTupleSplit e Z
  let H : (Fin a → Z) × (Fin (retrievalSurvivorIndices e).card → Z) → ℝ :=
    fun v => ((∏ i, μ (v.1 i)) * ∏ j, μ (v.2 j)) *
      F v.1 ⟨(retrievalSurvivorIndices e).card, v.2⟩
  calc
    _ = ∑ q : Fin n → Z, H (E q) := by
      apply sum_congr rfl
      intro q _
      rw [ordered_retrieval_weight_split e μ q]
      rfl
    _ = ∑ v, H v := E.sum_comp H
    _ = _ := Fintype.sum_prod_type H

/- Fixed ordered retrieval leaves exactly `n-a` survivor coordinates. -/
theorem ordered_retrieval_fixed_sum  [Fintype Z]
    (e : Fin a ↪ Fin n) (μ : Z → ℝ)
    (F : (Fin a → Z) → FiniteOrderedTuple Z → ℝ) :
    (∑ q : Fin n → Z, (∏ j, μ (q j)) * F (fun i => q (e i))
      ⟨(retrievalSurvivorIndices e).card,
        retainedOrderedTuple q (retrievalSurvivorIndices e)⟩) =
    ∑ x : Fin a → Z, ∑ u : Fin (n - a) → Z,
      ((∏ i, μ (x i)) * ∏ j, μ (u j)) * F x ⟨n - a, u⟩ := by
  rw [ordered_retrieval_fixed_sum_card]
  let H (k : ℕ) := ∑ x : Fin a → Z, ∑ u : Fin k → Z,
    ((∏ i, μ (x i)) * ∏ j, μ (u j)) * F x ⟨k, u⟩
  change H (retrievalSurvivorIndices e).card = H (n - a)
  exact congrArg H (retrieval_survivor_card e)

/- Summing all ordered retrieval choices gives the descending factorial.
No distinctness of numerical labels or symmetry of the test is required. -/
theorem ordered_retrieval_sum  [Fintype Z]
    (μ : Z → ℝ) (F : (Fin a → Z) → FiniteOrderedTuple Z → ℝ) :
    (∑ e : Fin a ↪ Fin n, ∑ q : Fin n → Z,
      (∏ j, μ (q j)) * F (fun i => q (e i))
        ⟨(retrievalSurvivorIndices e).card,
          retainedOrderedTuple q (retrievalSurvivorIndices e)⟩) =
    (n.descFactorial a : ℝ) *
      ∑ x : Fin a → Z, ∑ u : Fin (n - a) → Z,
        ((∏ i, μ (x i)) * ∏ j, μ (u j)) * F x ⟨n - a, u⟩ := by
  simp_rw [ordered_retrieval_fixed_sum]
  simp [Fintype.card_embedding_eq, nsmul_eq_mul]

/- The full old-memory factorial cancels ordered retrieval multiplicity,
leaving exactly the factorial of the surviving old coordinates. -/
theorem ordered_retrieval_normalized_sum  [Fintype Z]
    (ha : a ≤ n) (μ : Z → ℝ)
    (F : (Fin a → Z) → FiniteOrderedTuple Z → ℝ) :
    (∑ e : Fin a ↪ Fin n, ∑ q : Fin n → Z,
      (∏ j, μ (q j)) * F (fun i => q (e i))
        ⟨(retrievalSurvivorIndices e).card,
          retainedOrderedTuple q (retrievalSurvivorIndices e)⟩) / (n.factorial : ℝ) =
    (1 / ((n - a).factorial : ℝ)) *
      ∑ x : Fin a → Z, ∑ u : Fin (n - a) → Z,
        ((∏ i, μ (x i)) * ∏ j, μ (u j)) * F x ⟨n - a, u⟩ := by
  rw [ordered_retrieval_sum, mul_div_right_comm, ordered_retrieval_factorial ha]

end

end

section
open Finset Classical
def unrestrictedJointInput {P : Type*} {k a : ℕ} (n : P → ℕ) (Δ : ℤ)
    (u : Fin k → UnrestrictedResidueParticle n) (p : Fin a → P) :
    FiniteOrderedTuple (UnrestrictedResidueParticle n) :=
  ⟨k + a, Fin.addCases u (fun i => ⟨p i, (Δ : ZMod (n (p i)))⟩)⟩

def unrestrictedJointOutput {P : Type*} {k b : ℕ} (n : P → ℕ) (Δ : ℤ)
    (u : Fin k → UnrestrictedResidueParticle n) (s : Fin b → P) :
    FiniteOrderedTuple (UnrestrictedResidueParticle n) :=
  unrestrictedJointInput n (-Δ) (unrestrictedResidueTransport n Δ ∘ u) s

theorem unrestricted_joint_reverse_input {P : Type*} {k b : ℕ} (n : P → ℕ) (Δ : ℤ)
    (u : Fin k → UnrestrictedResidueParticle n) (s : Fin b → P) :
    unrestrictedJointInput n (-Δ) (unrestrictedResidueTransport n Δ ∘ u) s =
      unrestrictedJointOutput n Δ u s := rfl

theorem unrestricted_joint_reverse_output {P : Type*} {k a : ℕ} (n : P → ℕ) (Δ : ℤ)
    (u : Fin k → UnrestrictedResidueParticle n) (p : Fin a → P) :
    unrestrictedJointOutput n (-Δ) (unrestrictedResidueTransport n Δ ∘ u) p =
      unrestrictedJointInput n Δ u p := by
  have hback : unrestrictedResidueTransport n (-Δ) ∘ (unrestrictedResidueTransport n Δ ∘ u) = u := by
    funext j
    change unrestrictedResidueTransport n (-Δ) (unrestrictedResidueTransport n Δ (u j)) = u j
    rw [← unrestrictedResidueTransport_symm]
    exact (unrestrictedResidueTransport n Δ).symm_apply_apply (u j)
  simp only [unrestrictedJointOutput, neg_neg, hback]

noncomputable def unrestrictedJointIntegral {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ : ℤ) (k a b : ℕ)
    (F : (Fin a → P) → (Fin b → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) : ℂ :=
  ∑ u : Fin k → UnrestrictedResidueParticle n, ∑ p : Fin a → P, ∑ s : Fin b → P,
    (((∏ j, unrestrictedResidueWeight μ (u j)) * (∏ i, μ (p i)) * (∏ i, μ (s i)) /
      (k.factorial : ℝ) : ℝ) : ℂ) *
        F p s (unrestrictedJointInput n Δ u p) (unrestrictedJointOutput n Δ u s)

/- Translation preserves each residue counting measure; swapping promoted
and stored label integrations preserves the remaining product measure. -/
theorem unrestricted_joint_integral_reverse {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (Δ : ℤ) (k a b : ℕ)
    (F : (Fin a → P) → (Fin b → P) → FiniteOrderedTuple (UnrestrictedResidueParticle n) →
      FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    unrestrictedJointIntegral n μ Δ k a b F =
      unrestrictedJointIntegral n μ (-Δ) k b a (fun s p Y X => F p s X Y) := by
  let E : (Fin k → UnrestrictedResidueParticle n) ≃ (Fin k → UnrestrictedResidueParticle n) :=
    Equiv.piCongrRight (fun _ => unrestrictedResidueTransport n Δ)
  unfold unrestrictedJointIntegral
  conv_rhs => rw [← E.sum_comp]
  apply sum_congr rfl
  intro u hu
  rw [sum_comm]
  apply sum_congr rfl
  intro s hs
  apply sum_congr rfl
  intro p hp
  have hE : E u = unrestrictedResidueTransport n Δ ∘ u := rfl
  rw [hE, unrestricted_joint_reverse_input, unrestricted_joint_reverse_output]
  simp only [Function.comp_apply, unrestrictedResidueWeight_transport]
  congr 1
  congr 1
  ring






end

section
open Finset Classical



/- Joint selection leaves exactly one residue tuple for every label tuple.
The sum is over all label functions, without any distinctness condition. -/
theorem unrestricted_residue_tuple_selection_sum {P E : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] [AddCommMonoid E] [SMul ℝ E]
    (μ : P → ℝ) (Δ : ℤ) (ban : P → Prop) (a : ℕ)
    (F : (Fin a → UnrestrictedResidueParticle n) → E) :
    (∑ q : Fin a → UnrestrictedResidueParticle n,
      if ∀ i, unrestrictedResidueHit (unrestrictedResidueTransport n Δ (q i)) ∧
          ban (q i).1
      then (∏ i, unrestrictedResidueWeight μ (q i)) • F q else 0) =
      ∑ p : Fin a → P, if ∀ i, ban (p i)
        then (∏ i, μ (p i)) • F (fun i => ⟨p i, (Δ : ZMod (n (p i)))⟩)
        else 0 := by
  have hrestore (q : Fin a → UnrestrictedResidueParticle n)
      (hq : ∀ i, unrestrictedResidueHit (unrestrictedResidueTransport n Δ (q i)) ∧
        ban (q i).1) :
      (fun i => (⟨(q i).1, (Δ : ZMod (n (q i).1))⟩ :
        UnrestrictedResidueParticle n)) = q := by
    funext i
    have hi := (unrestrictedResidueTransport_hit_iff n Δ (q i)).mp (hq i).1
    calc
      (⟨(q i).1, (Δ : ZMod (n (q i).1))⟩ : UnrestrictedResidueParticle n) =
          ⟨(q i).1, (q i).2⟩ := congrArg (Sigma.mk (q i).1) hi.symm
      _ = q i := Sigma.eta _
  rw [← Finset.sum_filter, ← Finset.sum_filter]
  apply Finset.sum_bij (fun q _ i => (q i).1)
  · intro q hq
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hq ⊢
    exact fun i => (hq i).2
  · intro q hq q' hq' hqq'
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hq hq'
    rw [← hrestore q hq, ← hrestore q' hq']
    exact congrArg (fun p : Fin a → P => fun i =>
      (⟨p i, (Δ : ZMod (n (p i)))⟩ : UnrestrictedResidueParticle n)) hqq'
  · intro p hp
    refine ⟨fun i => ⟨p i, (Δ : ZMod (n (p i)))⟩, ?_, rfl⟩
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hp ⊢
    intro i
    exact ⟨(unrestrictedResidueTransport_hit_iff n Δ _).mpr rfl, hp i⟩
  · intro q hq
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hq
    change (∏ i, μ (q i).1) • F q =
      (∏ i, μ (q i).1) • F (fun i => ⟨(q i).1, (Δ : ZMod (n (q i).1))⟩)
    rw [hrestore q hq]
end

section
open Finset Classical
/- Reconstruct the source tuple from its retained and selected coordinates. -/
def retrievalSourceTuple {a : ℕ} {Z : Type*} (x : Fin a → Z)
    (u : FiniteOrderedTuple Z) : FiniteOrderedTuple Z :=
  ⟨u.1 + a, Fin.addCases u.2 x⟩

theorem symmetric_ordered_tuple_reindex {Z K : Type*}
    (H : FiniteOrderedTuple Z → K) (hH : OrderedTupleSymmetric H)
    {m n : ℕ} (q : Fin n → Z) (E : Fin m ≃ Fin n) :
    H ⟨m, q ∘ E⟩ = H ⟨n, q⟩ := by
  have hmn : m = n := by simpa using Fintype.card_congr E
  subst m
  exact hH n q E

/- Symmetry identifies the original source with retained entries followed by
the selected entries, using the existing retained-tuple enumeration. -/
theorem symmetric_retrieval_source {a n : ℕ} {Z K : Type*}
    (H : FiniteOrderedTuple Z → K) (hH : OrderedTupleSymmetric H)
    (e : Fin a ↪ Fin n) (q : Fin n → Z) :
    H ⟨n, q⟩ = H (retrievalSourceTuple (fun i => q (e i))
      ⟨(retrievalSurvivorIndices e).card,
        retainedOrderedTuple q (retrievalSurvivorIndices e)⟩) := by
  let E : Fin ((retrievalSurvivorIndices e).card + a) ≃ Fin n :=
    (finSumFinEquiv.symm.trans (Equiv.sumComm _ _)).trans (retrievalIndexSplit e)
  have hq : q ∘ E = Fin.addCases
      (retainedOrderedTuple q (retrievalSurvivorIndices e)) (fun i => q (e i)) := by
    funext j
    refine Fin.addCases (fun i => ?_) (fun i => ?_) j
    · simp only [Function.comp_apply, E, Equiv.trans_apply,
        finSumFinEquiv_symm_apply_castAdd, Equiv.sumComm_apply, Fin.addCases_left]
      rfl
    · simp only [Function.comp_apply, E, Equiv.trans_apply,
        finSumFinEquiv_symm_apply_natAdd, Equiv.sumComm_apply, Fin.addCases_right]
      rfl
  have hs := symmetric_ordered_tuple_reindex H hH q E
  rw [hq] at hs
  exact hs.symm

/- Complex-valued ordered extraction with exact factorial normalization. -/
theorem ordered_retrieval_normalized_sum_complex {a n : ℕ} {Z : Type*} [Fintype Z]
    (ha : a ≤ n) (μ : Z → ℝ)
    (F : (Fin a → Z) → FiniteOrderedTuple Z → ℂ) :
    (∑ e : Fin a ↪ Fin n, ∑ q : Fin n → Z,
      ((∏ j, μ (q j) : ℝ) : ℂ) * F (fun i => q (e i))
        ⟨(retrievalSurvivorIndices e).card,
          retainedOrderedTuple q (retrievalSurvivorIndices e)⟩) /
      ((n.factorial : ℝ) : ℂ) =
    (((1 / ((n - a).factorial : ℝ)) : ℝ) : ℂ) *
      ∑ x : Fin a → Z, ∑ u : Fin (n - a) → Z,
        ((((∏ i, μ (x i)) * ∏ j, μ (u j)) : ℝ) : ℂ) * F x ⟨n - a, u⟩ := by
  apply Complex.ext
  · simpa only [Complex.re_sum, Complex.div_ofReal_re, Complex.mul_re,
      Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero] using
      ordered_retrieval_normalized_sum ha μ (fun x u => (F x u).re)
  · simpa only [Complex.im_sum, Complex.div_ofReal_im, Complex.mul_im,
      Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero] using
      ordered_retrieval_normalized_sum ha μ (fun x u => (F x u).im)




/- The integrand may depend jointly on selected labels, the entire source,
and survivors, provided its source dependence is symmetric. -/
theorem ordered_retrieval_symmetric_normalized_sum_complex
    {a n : ℕ} {Z : Type*} [Fintype Z] (ha : a ≤ n) (μ : Z → ℝ)
    (F : (Fin a → Z) → FiniteOrderedTuple Z → FiniteOrderedTuple Z → ℂ)
    (hF : ∀ x u, OrderedTupleSymmetric (fun source => F x source u)) :
    (∑ e : Fin a ↪ Fin n, ∑ q : Fin n → Z,
      ((∏ j, μ (q j) : ℝ) : ℂ) * F (fun i => q (e i)) ⟨n, q⟩
        ⟨(retrievalSurvivorIndices e).card,
          retainedOrderedTuple q (retrievalSurvivorIndices e)⟩) /
      ((n.factorial : ℝ) : ℂ) =
    (((1 / ((n - a).factorial : ℝ)) : ℝ) : ℂ) *
      ∑ x : Fin a → Z, ∑ u : Fin (n - a) → Z,
        ((((∏ i, μ (x i)) * ∏ j, μ (u j)) : ℝ) : ℂ) *
          F x (retrievalSourceTuple x ⟨n - a, u⟩) ⟨n - a, u⟩ := by
  rw [← ordered_retrieval_normalized_sum_complex ha μ
    (fun x u => F x (retrievalSourceTuple x u) u)]
  congr 1
  apply sum_congr rfl
  intro e _
  apply sum_congr rfl
  intro q _
  congr 1
  exact symmetric_retrieval_source _ (hF _ _) e q
end

section
open Finset Classical
theorem unrestricted_active_weight_split {I P : Type*} [Fintype I] [DecidableEq I]
    (μ : P → ℝ) (S : Finset I) (x : I → P) :
    (∏ i : I, μ (x i)) =
      (∏ i : S, μ (x i)) * unrestrictedFreshWeight μ S (fun i => x i) := by
  let e : S ⊕ {i : I // i ∉ S} ≃ I := Equiv.sumCompl (fun i => i ∈ S)
  have h := e.prod_comp (fun i => μ (x i))
  rw [Fintype.prod_sum_type] at h
  exact h.symm

/- Splitting the source active product measure into stored and complementary
labels is an exact finite-sum reindexing, valid for real and complex outputs. -/
theorem unrestricted_active_sum_split {I P E : Type*} [Fintype I] [DecidableEq I]
    [Fintype P] [AddCommMonoid E] [SMul ℝ E]
    (μ : P → ℝ) (S : Finset I) (F : (I → P) → E) :
    (∑ x : I → P, (∏ i : I, μ (x i)) • F x) =
      ∑ s : S → P, ∑ d : UnrestrictedFreshLabels P S,
        ((∏ i : S, μ (s i)) * unrestrictedFreshWeight μ S d) •
          F (unrestrictedTargetLabels S s d) := by
  let e := Equiv.piEquivPiSubtypeProd (fun i : I => i ∈ S) (fun _ => P)
  let G : (S → P) × UnrestrictedFreshLabels P S → E := fun y =>
    ((∏ i : S, μ (y.1 i)) * unrestrictedFreshWeight μ S y.2) •
      F (unrestrictedTargetLabels S y.1 y.2)
  have hrestore (x : I → P) :
      unrestrictedTargetLabels S (fun i => x i) (fun i => x i) = x := by
    funext i
    by_cases hi : i ∈ S <;> simp [unrestrictedTargetLabels, hi]
  calc
    _ = ∑ x : I → P, G (e x) := by
      apply Finset.sum_congr rfl
      intro x hx
      change (∏ i : I, μ (x i)) • F x =
        ((∏ i : S, μ (x i)) * unrestrictedFreshWeight μ S (fun i => x i)) •
          F (unrestrictedTargetLabels S (fun i => x i) (fun i => x i))
      rw [unrestricted_active_weight_split μ S x, hrestore x]
    _ = ∑ y, G y := e.sum_comp G
    _ = _ := Fintype.sum_prod_type G

/- Index stored labels in the canonical finite order used by the ordered
memory operations. The product measure is unchanged by this reindexing. -/
theorem unrestricted_store_sum_equivFin {I P E : Type*} [DecidableEq I]
    [Fintype P] [AddCommMonoid E] [SMul ℝ E]
    (μ : P → ℝ) (S : Finset I) (F : (S → P) → E) :
    (∑ s : S → P, (∏ i : S, μ (s i)) • F s) =
      ∑ s : Fin S.card → P, (∏ i : Fin S.card, μ (s i)) •
        F (fun i => s (S.equivFin i)) := by
  let e := Equiv.arrowCongr S.equivFin (Equiv.refl P)
  calc
    _ = ∑ s : Fin S.card → P, (∏ i : S, μ (e.symm s i)) • F (e.symm s) :=
      (e.symm.sum_comp (fun s => (∏ i : S, μ (s i)) • F s)).symm
    _ = _ := by
      apply Finset.sum_congr rfl
      intro s hs
      change (∏ i : S, μ (s (S.equivFin i))) • F (fun i => s (S.equivFin i)) = _
      rw [S.equivFin.prod_comp (fun i => μ (s i))]
end

section
open Finset Classical
theorem orderedPredicateCount_permutation {Z : Type*} {N : ℕ}
    (q : Fin N → Z) (hit : Z → Prop) (e : Equiv.Perm (Fin N)) :
    orderedPredicateCount ⟨N, q ∘ e⟩ hit = orderedPredicateCount ⟨N, q⟩ hit :=
  Equiv.sum_comp e (fun j => if hit (q j) then 1 else 0)






end

section
open Finset
/- The literal output index splits into a retained old slot or a birth slot. -/
noncomputable def retainedBirthIndexEquiv {N : ℕ} (s : Finset (Fin N)) (b : ℕ) :
    Fin (s.card + b) ≃ (s ⊕ Fin b) :=
  finSumFinEquiv.symm.trans (Equiv.sumCongr s.equivFin.symm (Equiv.refl _))

theorem retained_birth_index_equiv_left {N b : ℕ} (s : Finset (Fin N))
    (j : Fin s.card) :
    retainedBirthIndexEquiv s b (Fin.castAdd b j) = Sum.inl (s.equivFin.symm j) := by
  simp [retainedBirthIndexEquiv]

theorem retained_birth_index_equiv_right {N b : ℕ} (s : Finset (Fin N))
    (j : Fin b) :
    retainedBirthIndexEquiv s b (Fin.natAdd s.card j) = Sum.inr j := by
  simp [retainedBirthIndexEquiv]

/- Evaluation of the actual tuple under its explicit sum-index equivalence. -/
theorem retained_birth_tuple_apply_index_equiv {ι : Type*} {N b : ℕ}
    (old : Fin N → ι) (s : Finset (Fin N)) (stored : Fin b → ι)
    (j : Fin (s.card + b)) :
    (retainedBirthTuple old s stored).2 j =
      Sum.elim (fun k : s => old k.val) stored (retainedBirthIndexEquiv s b j) := by
  induction j using Fin.addCases with
  | left j =>
    simp [retainedBirthTuple, retainedOrderedTuple, retained_birth_index_equiv_left]
  | right j =>
    simp [retainedBirthTuple, retained_birth_index_equiv_right]

/- Conversely, a sum-indexed entry is the corresponding literal tuple entry. -/
theorem retained_birth_tuple_apply_index_equiv_symm {ι : Type*} {N b : ℕ}
    (old : Fin N → ι) (s : Finset (Fin N)) (stored : Fin b → ι)
    (j : s ⊕ Fin b) :
    (retainedBirthTuple old s stored).2 ((retainedBirthIndexEquiv s b).symm j) =
      Sum.elim (fun k : s => old k.val) stored j := by
  rw [retained_birth_tuple_apply_index_equiv, Equiv.apply_symm_apply]

/- Applying any transport or label map commutes with retaining and appending. -/
theorem retained_birth_tuple_map {ι κ : Type*} {N b : ℕ}
    (map : ι → κ) (old : Fin N → ι) (s : Finset (Fin N)) (stored : Fin b → ι) :
    (retainedBirthTuple (map ∘ old) s (map ∘ stored)).2 =
      map ∘ (retainedBirthTuple old s stored).2 := by
  funext j
  change Fin (s.card + b) at j
  change (retainedBirthTuple (map ∘ old) s (map ∘ stored)).2 j =
    map ((retainedBirthTuple old s stored).2 j)
  rw [retained_birth_tuple_apply_index_equiv]
  simp only [Function.comp_apply, retained_birth_tuple_apply_index_equiv]
  cases retainedBirthIndexEquiv s b j <;> rfl

/- Distinct old entries and distinct appended entries stay distinct when the
retained old entries and appended entries have disjoint labels. -/
theorem retained_birth_tuple_injective {ι : Type*} {N b : ℕ}
    (old : Fin N → ι) (s : Finset (Fin N)) (stored : Fin b → ι)
    (hold : Function.Injective old) (hstored : Function.Injective stored)
    (hdis : ∀ j ∈ s, ∀ k, old j ≠ stored k) :
    Function.Injective (retainedBirthTuple old s stored).2 := by
  have hsum : Function.Injective (Sum.elim (fun k : s => old k.val) stored) := by
    intro x y hxy
    cases x with
    | inl j =>
      cases y with
      | inl k => exact congrArg Sum.inl (Subtype.ext (hold hxy))
      | inr k => exact (hdis j.val j.property k hxy).elim
    | inr j =>
      cases y with
      | inl k => exact (hdis k.val k.property j hxy.symm).elim
      | inr k => exact congrArg Sum.inr (hstored hxy)
  intro i j hij
  apply (retainedBirthIndexEquiv s b).injective
  apply hsum
  exact (retained_birth_tuple_apply_index_equiv old s stored i).symm.trans
    (hij.trans (retained_birth_tuple_apply_index_equiv old s stored j))

/- In particular, distinctness concerns the numerical labels even when each
entry also carries a residue or other data. -/
theorem retained_birth_tuple_label_injective {ι P : Type*} {N b : ℕ}
    (label : ι → P) (old : Fin N → ι) (s : Finset (Fin N)) (stored : Fin b → ι)
    (hold : Function.Injective (label ∘ old))
    (hstored : Function.Injective (label ∘ stored))
    (hdis : ∀ j ∈ s, ∀ k, label (old j) ≠ label (stored k)) :
    Function.Injective (label ∘ (retainedBirthTuple old s stored).2) := by
  rw [← retained_birth_tuple_map]
  exact retained_birth_tuple_injective (label ∘ old) s (label ∘ stored) hold hstored hdis
end

section
open Finset
/- Target slots whose label occurs in the old memory. -/
noncomputable def distinctPromotedTargetSlots {S J P : Type*} [Fintype S]
    [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P) : Finset S :=
  univ.filter (fun s => t s ∈ univ.image f)

theorem mem_distinctPromotedTargetSlots {S J P : Type*} [Fintype S]
    [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P) (s : S) :
    s ∈ distinctPromotedTargetSlots f t ↔ t s ∈ univ.image f := by
  simp only [distinctPromotedTargetSlots, mem_filter, mem_univ, true_and]

/- Matching promoted slots and genuinely fresh complementary slots determine
the selected target-slot set itself, not merely its matching injection. -/
theorem distinct_promoted_slots_forced {S J P : Type*} [Fintype S]
    [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P)
    (U : Finset S) (e : U ↪ J)
    (hmatch : ∀ s : U, f (e s) = t s.val)
    (hfresh : ∀ s, s ∉ U → t s ∉ univ.image f) :
    U = distinctPromotedTargetSlots f t := by
  ext s
  rw [mem_distinctPromotedTargetSlots]
  constructor
  · intro hs
    exact mem_image.mpr ⟨e ⟨s, hs⟩, mem_univ _, hmatch ⟨s, hs⟩⟩
  · intro hs
    by_contra hn
    exact hfresh s hn hs

/- The old index required by each canonically selected target slot exists. -/
theorem distinct_promoted_slot_has_old {S J P : Type*} [Fintype S]
    [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P)
    (s : distinctPromotedTargetSlots f t) : ∃ j, f j = t s.val := by
  obtain ⟨j, hj, he⟩ := mem_image.mp ((mem_distinctPromotedTargetSlots f t s.val).mp s.property)
  exact ⟨j, he⟩

/- The unique matching old-index injection for the forced target subset. -/
noncomputable def distinctCanonicalPromotion {S J P : Type*} [Fintype S]
    [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P) :
    distinctPromotedTargetSlots f t ↪ J :=
  distinctPromotionEmbedding f (fun s : distinctPromotedTargetSlots f t => t s.val)
    (t.injective.comp Subtype.val_injective) (distinct_promoted_slot_has_old f t)

theorem distinct_canonical_promotion_matches {S J P : Type*} [Fintype S]
    [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P)
    (s : distinctPromotedTargetSlots f t) :
    f (distinctCanonicalPromotion f t s) = t s.val :=
  distinct_promotion_embedding_spec f (fun s : distinctPromotedTargetSlots f t => t s.val)
    (t.injective.comp Subtype.val_injective) (distinct_promoted_slot_has_old f t) s
















/- The selected OLD indices are exactly those whose label occurs anywhere
in the target tuple, independently of how the event was initially described. -/
theorem distinct_promotion_selected_old_indices {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (U : Finset S) (e : U ↪ J)
    (hmatch : ∀ s : U, f (e s) = t s.val)
    (hfresh : ∀ s, s ∉ U → t s ∉ univ.image f) :
    univ.image e = univ.filter (fun j => f j ∈ univ.image t) := by
  ext j
  simp only [mem_filter, mem_univ, true_and]
  constructor
  · intro hj
    obtain ⟨s, hs, rfl⟩ := mem_image.mp hj
    exact mem_image.mpr ⟨s.val, mem_univ _, (hmatch s).symm⟩
  · intro hj
    obtain ⟨s, hs, hsj⟩ := mem_image.mp hj
    have hsU : s ∈ U := by
      by_contra hn
      exact hfresh s hn (mem_image.mpr ⟨j, mem_univ _, hsj.symm⟩)
    refine mem_image.mpr ⟨⟨s, hsU⟩, mem_univ _, ?_⟩
    exact f.injective ((hmatch ⟨s, hsU⟩).trans hsj)















end

section
open Finset
/- Matching an eligible promotion event identifies its selected OLD indices
with precisely the old labels occurring in the full target tuple. -/
theorem distinct_eligible_promotion_selected_indices {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (U : Finset S) (Z : Finset J) (e : U ↪ Z)
    (hmatch : ∀ s : U, f (e s).val = t s.val)
    (hfresh : ∀ s, s ∉ U → t s ∉ univ.image f) :
    promotionSelectedIndices e = univ.filter (fun j => f j ∈ univ.image t) := by
  rw [promotionSelectedIndices, map_eq_image]
  exact distinct_promotion_selected_old_indices f t U
    (e.trans ⟨Subtype.val, Subtype.val_injective⟩) hmatch hfresh

/- For the canonical promoted target subset, the fresh-outside-old condition
is automatic, so only matching and eligibility remain as hypotheses. -/
theorem distinct_canonical_eligible_selected_indices {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq J] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (Z : Finset J)
    (e : distinctPromotedTargetSlots f t ↪ Z)
    (hmatch : ∀ s : distinctPromotedTargetSlots f t, f (e s).val = t s.val) :
    promotionSelectedIndices e = univ.filter (fun j => f j ∈ univ.image t) := by
  apply distinct_eligible_promotion_selected_indices f t _ Z e hmatch
  intro s hs hm
  exact hs ((mem_distinctPromotedTargetSlots f t s).mpr hm)






end

section
open Finset
/- The literal unrestricted memory is evaluated on retained old slots and
appended storage slots by the retained/birth index equivalence. -/
theorem unrestricted_edge_memory_apply_index {A Z : Type*} [Fintype A] {N b : ℕ}
    (old : Fin N → Z) (transport : Z → Z) (stored : Fin b → Z)
    {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
    (j : Fin (unrestrictedEdgeMemory old transport stored e).1) :
    (unrestrictedEdgeMemory old transport stored e).2 j =
      Sum.elim (fun k : unrestrictedEdgeSurvivors e => transport (old k.val))
        (transport ∘ stored) (retainedBirthIndexEquiv (unrestrictedEdgeSurvivors e) b j) :=
  retained_birth_tuple_apply_index_equiv (transport ∘ old)
    (unrestrictedEdgeSurvivors e) (transport ∘ stored) j




/- Label-preserving transport keeps a distinct, disjoint old/storage tuple
distinct in the literal unrestricted output. -/
theorem unrestricted_edge_memory_label_injective {A Z P : Type*} [Fintype A]
    {N b : ℕ} (label : Z → P) (old : Fin N → Z) (transport : Z → Z)
    (stored : Fin b → Z) {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
    (htransport : ∀ z, label (transport z) = label z)
    (hold : Function.Injective (label ∘ old))
    (hstored : Function.Injective (label ∘ stored))
    (hdis : ∀ j ∈ unrestrictedEdgeSurvivors e, ∀ k, label (old j) ≠ label (stored k)) :
    Function.Injective (label ∘ (unrestrictedEdgeMemory old transport stored e).2) := by
  apply retained_birth_tuple_label_injective label (transport ∘ old)
    (unrestrictedEdgeSurvivors e) (transport ∘ stored)
  · simpa only [Function.comp_def, htransport] using hold
  · simpa only [Function.comp_def, htransport] using hstored
  · simpa only [Function.comp_apply, htransport] using hdis

/- Moving-frame transport for particles with dependent residue types. -/
def unrestrictedPhaseTransport {P : Type*} {R : P → Type*}
    [∀ p, AddGroup (R p)] (delta : (p : P) → R p) (z : Σ p, R p) : Σ p, R p :=
  ⟨z.1, z.2 - delta z.1⟩

/- Selecting precisely target-active old labels identifies unrestricted
survivors with the old-index subtype used by the phase construction. -/
noncomputable def distinctUnrestrictedSurvivorEquiv {A P : Type*} [Fintype A]
    [Fintype P] {N : ℕ} (atgt : P → Bool) (label : Fin N → P)
    {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
    (he : ∀ j, j ∈ promotionSelectedIndices e ↔ atgt (label j) = true) :
    unrestrictedEdgeSurvivors e ≃ {j : Fin N // label j ∉ ghostPhaseActivitySupport atgt} where
  toFun j := ⟨j.val, by
    have hj := j.property
    simpa only [unrestrictedEdgeSurvivors, mem_sdiff, mem_univ, true_and,
      he, ghostPhaseActivitySupport, mem_filter, mem_univ, true_and] using hj⟩
  invFun j := ⟨j.val, by
    have hj := j.property
    simpa only [unrestrictedEdgeSurvivors, mem_sdiff, mem_univ, true_and,
      he, ghostPhaseActivitySupport, mem_filter, mem_univ, true_and] using hj⟩
  left_inv _ := rfl
  right_inv _ := rfl

/- Exact order map from the literal output to phase survivor/storage indices. -/
noncomputable def distinctUnrestrictedIndexEquiv {A P : Type*} [Fintype A]
    [Fintype P] {N : ℕ} (atgt : P → Bool) (label : Fin N → P)
    {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
    (he : ∀ j, j ∈ promotionSelectedIndices e ↔ atgt (label j) = true) (b : ℕ) :
    Fin ((unrestrictedEdgeSurvivors e).card + b) ≃
      ({j : Fin N // label j ∉ ghostPhaseActivitySupport atgt} ⊕ Fin b) :=
  (retainedBirthIndexEquiv (unrestrictedEdgeSurvivors e) b).trans
    (Equiv.sumCongr (distinctUnrestrictedSurvivorEquiv atgt label e he) (Equiv.refl _))

/- The literal sigma-valued output equals the existing distinct delete/append
embedding and residue tuple, under the explicit index equivalence. -/
theorem distinct_unrestricted_memory_representation {A P : Type*} [Fintype A]
    [Fintype P] {R : P → Type*} [∀ p, AddGroup (R p)] {N b : ℕ}
    (atgt : P → Bool) (delta : (p : P) → R p)
    (f : Fin N ↪ P) (g : Fin b ↪ P) (hdis : ∀ j k, f j ≠ g k)
    (old : (j : Fin N) → R (f j)) {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
    (he : ∀ j, j ∈ promotionSelectedIndices e ↔ atgt (f j) = true)
    (j : Fin (unrestrictedEdgeMemory (fun j => (⟨f j, old j⟩ : Σ p, R p))
      (unrestrictedPhaseTransport delta) (fun k => ⟨g k, 0⟩) e).1) :
    let k := distinctUnrestrictedIndexEquiv atgt f e he b j
    (unrestrictedEdgeMemory (fun j => (⟨f j, old j⟩ : Σ p, R p))
      (unrestrictedPhaseTransport delta) (fun k => ⟨g k, 0⟩) e).2 j =
      ⟨distinctSurvivorStorageEmbedding f g (ghostPhaseActivitySupport atgt) hdis k,
        distinctSurvivorStorageResidue f g (ghostPhaseActivitySupport atgt) hdis R
          (fun p r => r - delta p) old (fun k => -delta (g k)) k⟩ := by
  dsimp only
  have hidx : distinctUnrestrictedIndexEquiv atgt f e he b j =
      (Equiv.sumCongr (distinctUnrestrictedSurvivorEquiv atgt f e he) (Equiv.refl (Fin b)))
        (retainedBirthIndexEquiv (unrestrictedEdgeSurvivors e) b j) := rfl
  rw [hidx, unrestricted_edge_memory_apply_index]
  generalize hk : retainedBirthIndexEquiv (unrestrictedEdgeSurvivors e) b j = k
  cases k with
  | inl k => rfl
  | inr k =>
    change (⟨g k, 0 - delta (g k)⟩ : Σ p, R p) = ⟨g k, -delta (g k)⟩
    rw [zero_sub]

section PhaseOutput

variable {A P : Type*} [Fintype A] [Fintype P]
  {R : P → Type*} [∀ p, AddGroup (R p)] {N b : ℕ}
  (atgt asrc store : P → Bool) (delta : (p : P) → R p)
  (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
  (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true)
  (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
  (g : DistinctOrderedSupport (Fin b) (ghostPhaseChoiceSupport store))
  (old : (j : Fin N) → R (f.val j))
  {eligible : Finset (Fin N)} (e : A ↪ ↥eligible)
  (he : ∀ j, j ∈ promotionSelectedIndices e ↔ atgt (f.val j) = true)

include hw hs

/- The actual unrestricted output has distinct numerical labels. -/
theorem distinct_unrestricted_memory_label_injective :
    Function.Injective (Sigma.fst ∘
      (unrestrictedEdgeMemory (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (unrestrictedPhaseTransport delta) (fun k => ⟨g.val k, 0⟩) e).2) := by
  apply unrestricted_edge_memory_label_injective
  · intro z
    rfl
  · exact f.val.injective
  · exact g.val.injective
  · intro j _ k
    exact distinct_phase_old_storage_disjoint atgt asrc store w hw hs f g j k

include he

/- The image of the literal unrestricted output labels is exactly the pending
support of the selected moving phase output. -/
theorem distinct_unrestricted_memory_support [DecidableEq P] :
    univ.image (fun j =>
      ((unrestrictedEdgeMemory (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (unrestrictedPhaseTransport delta) (fun k => ⟨g.val k, 0⟩) e).2 j).1) =
      ghostPhasePendingSupport (fun p =>
        ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p) (store p) (w p)) := by
  classical
  let hdis := distinct_phase_old_storage_disjoint atgt asrc store w hw hs f g
  let emb := distinctSurvivorStorageEmbedding f.val g.val (ghostPhaseActivitySupport atgt) hdis
  let idx := distinctUnrestrictedIndexEquiv atgt f.val e he b
  have hl (j) :
      ((unrestrictedEdgeMemory (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (unrestrictedPhaseTransport delta) (fun k => ⟨g.val k, 0⟩) e).2 j).1 = emb (idx j) :=
    congrArg Sigma.fst
      (distinct_unrestricted_memory_representation atgt delta f.val g.val hdis old e he j)
  calc
    _ = univ.image emb := by
      ext p
      simp only [mem_image, mem_univ, true_and]
      constructor
      · rintro ⟨j, hj⟩
        exact ⟨idx j, (hl j).symm.trans hj⟩
      · rintro ⟨k, hk⟩
        exact ⟨idx.symm k, (hl (idx.symm k)).trans (by simpa only [idx.apply_symm_apply] using hk)⟩
    _ = _ := distinct_phase_moving_embedding_support atgt asrc store delta w hw hs f g hdis

/- Every literal output particle has exactly its label and residue in the
selected moving phase output, including newly stored particles. -/
theorem distinct_unrestricted_memory_particle
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (j : Fin (unrestrictedEdgeMemory (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
      (unrestrictedPhaseTransport delta) (fun k => ⟨g.val k, 0⟩) e).1) :
    let z := (unrestrictedEdgeMemory (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
      (unrestrictedPhaseTransport delta) (fun k => ⟨g.val k, 0⟩) e).2 j
    ghostPhaseMovingChoiceTarget (atgt z.1) (asrc z.1) (delta z.1) (store z.1) (w z.1) =
      some (some (some z.2)) := by
  let hdis := distinct_phase_old_storage_disjoint atgt asrc store w hw hs f g
  have hv := distinct_unrestricted_memory_representation atgt delta f.val g.val hdis old e he j
  dsimp only
  rw [hv]
  exact distinct_phase_moving_residue atgt asrc store delta w hw hs f g hdis old hold
    (distinctUnrestrictedIndexEquiv atgt f.val e he b j)

end PhaseOutput
end

section
open Finset
/- Enumerate precisely the selected source slots, retaining their literal
`retainedOrderedTuple` enumeration. -/
noncomputable def distinctUnrestrictedStorageEmbedding {P : Type*} {t : ℕ}
    (source : Fin t ↪ P) (stores : Finset (Fin t)) : Fin stores.card ↪ P where
  toFun k := source (stores.equivFin.symm k).val
  inj' := by
    intro i j hij
    apply stores.equivFin.symm.injective
    exact Subtype.ext (source.injective hij)

/- The phase storage choice determined by selected source slots. -/
def distinctUnrestrictedStorageChoice {P : Type*} [DecidableEq P] {t : ℕ}
    (source : Fin t ↪ P) (stores : Finset (Fin t)) (p : P) : Bool :=
  decide (p ∈ stores.image source)

theorem distinct_unrestricted_storage_choice_support {P : Type*}
    [Fintype P] [DecidableEq P] {t : ℕ}
    (source : Fin t ↪ P) (stores : Finset (Fin t)) :
    ghostPhaseChoiceSupport (distinctUnrestrictedStorageChoice source stores) =
      stores.image source := by
  ext p
  simp [ghostPhaseChoiceSupport, distinctUnrestrictedStorageChoice]

/- The selected source enumeration is a distinct ordered enumeration of the
corresponding phase storage support. -/
noncomputable def distinctUnrestrictedStorageSupport {P : Type*}
    [Fintype P] [DecidableEq P] {t : ℕ}
    (source : Fin t ↪ P) (stores : Finset (Fin t)) :
    DistinctOrderedSupport (Fin stores.card)
      (ghostPhaseChoiceSupport (distinctUnrestrictedStorageChoice source stores)) :=
  ⟨distinctUnrestrictedStorageEmbedding source stores, by
    intro p
    rw [distinct_unrestricted_storage_choice_support]
    constructor
    · intro hp
      obtain ⟨j, hj, rfl⟩ := mem_image.mp hp
      refine ⟨stores.equivFin ⟨j, hj⟩, ?_⟩
      change source (stores.equivFin.symm (stores.equivFin ⟨j, hj⟩)).val = source j
      rw [Equiv.symm_apply_apply]
    · rintro ⟨k, rfl⟩
      exact mem_image.mpr ⟨(stores.equivFin.symm k).val,
        (stores.equivFin.symm k).property, rfl⟩⟩

/- Source-active slots that are target-inactive give an allowed phase choice. -/
theorem distinct_unrestricted_storage_allowed {P : Type*} [DecidableEq P] {t : ℕ}
    (source : Fin t ↪ P) (stores : Finset (Fin t)) (atgt asrc : P → Bool)
    (hsource : ∀ j, asrc (source j) = true)
    (hstores : ∀ j ∈ stores, atgt (source j) = false) :
    ∀ p, distinctUnrestrictedStorageChoice source stores p = true →
      atgt p = false ∧ asrc p = true := by
  intro p hp
  have hp' : p ∈ stores.image source := by
    simpa only [distinctUnrestrictedStorageChoice, decide_eq_true_eq] using hp
  obtain ⟨j, hj, rfl⟩ := mem_image.mp hp'
  exact ⟨hstores j hj, hsource j⟩







section ActualOutput

variable {P : Type*} [Fintype P] [DecidableEq P]
  {R : P → Type*} [∀ p, AddGroup (R p)] {t N : ℕ}
  (source : Fin t ↪ P) (stores promotions : Finset (Fin t))
  (atgt asrc : P → Bool) (delta : (p : P) → R p)
  (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
  (hsource : ∀ j, asrc (source j) = true)
  (hstores : ∀ j ∈ stores, atgt (source j) = false)
  (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
  (old : (j : Fin N) → R (f.val j))
  {eligible : Finset (Fin N)} (e : promotions ↪ ↥eligible)
  (he : ∀ j, j ∈ promotionSelectedIndices e ↔ atgt (f.val j) = true)

include hw hsource hstores

/- The actual source-slot output has distinct numerical labels. -/
theorem distinct_unrestricted_output_label_injective :
    Function.Injective (Sigma.fst ∘
      (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores promotions e).2) := by
  exact distinct_unrestricted_memory_label_injective atgt asrc
    (distinctUnrestrictedStorageChoice source stores) delta w hw
    (distinct_unrestricted_storage_allowed source stores atgt asrc hsource hstores)
    f (distinctUnrestrictedStorageSupport source stores) old e

include he

/- The actual source-slot output enumerates all and only the selected moving
phase output's pending labels. -/
theorem distinct_unrestricted_output_support :
    univ.image (fun j =>
      ((unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores promotions e).2 j).1) =
      ghostPhasePendingSupport (fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p)
        (delta p) (distinctUnrestrictedStorageChoice source stores p) (w p)) := by
  exact distinct_unrestricted_memory_support atgt asrc
    (distinctUnrestrictedStorageChoice source stores) delta w hw
    (distinct_unrestricted_storage_allowed source stores atgt asrc hsource hstores)
    f (distinctUnrestrictedStorageSupport source stores) old e he

/- Every actual source-slot output particle agrees with its moving phase
coordinate, including both transported survivors and newly stored labels. -/
theorem distinct_unrestricted_output_particle
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (j : Fin (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
      (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores promotions e).1) :
    let z := (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
      (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores promotions e).2 j
    ghostPhaseMovingChoiceTarget (atgt z.1) (asrc z.1) (delta z.1)
      (distinctUnrestrictedStorageChoice source stores z.1) (w z.1) =
      some (some (some z.2)) := by
  exact distinct_unrestricted_memory_particle atgt asrc
    (distinctUnrestrictedStorageChoice source stores) delta w hw
    (distinct_unrestricted_storage_allowed source stores atgt asrc hsource hstores)
    f (distinctUnrestrictedStorageSupport source stores) old e he hold j

end ActualOutput
end

section
open Finset
/- On slots not canonically promoted, use their fixed target label as fresh. -/
noncomputable def distinctCanonicalFresh {S J P : Type*} [Fintype S] [Fintype J]
    [DecidableEq P] (f : J ↪ P) (t : S ↪ P) :
    UnrestrictedFreshLabels P (distinctPromotedTargetSlots f t) :=
  fun s => t s.val

theorem distinct_canonical_fresh_injective {S J P : Type*} [Fintype S] [Fintype J]
    [DecidableEq P] (f : J ↪ P) (t : S ↪ P) :
    Function.Injective (distinctCanonicalFresh f t) := by
  intro s r hsr
  exact Subtype.ext (t.injective hsr)

theorem distinct_canonical_fresh_outside_old {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P)
    (s : {s : S // s ∉ distinctPromotedTargetSlots f t}) :
    distinctCanonicalFresh f t s ∉ univ.image f := by
  intro hs
  exact s.property ((mem_distinctPromotedTargetSlots f t s.val).mpr hs)

/- The fresh numerical labels are exactly target labels absent from old memory. -/
theorem distinct_canonical_fresh_image {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq S] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) :
    univ.image (distinctCanonicalFresh f t) = univ.image t \ univ.image f := by
  ext p
  simp only [mem_image, mem_univ, true_and, mem_sdiff]
  constructor
  · rintro ⟨s, rfl⟩
    refine ⟨⟨s.val, rfl⟩, ?_⟩
    simpa only [mem_image, mem_univ, true_and] using
      distinct_canonical_fresh_outside_old f t s
  · rintro ⟨⟨s, rfl⟩, hs⟩
    have hn : s ∉ distinctPromotedTargetSlots f t := by
      rw [mem_distinctPromotedTargetSlots]
      simpa only [mem_image, mem_univ, true_and] using hs
    exact ⟨⟨s, hn⟩, rfl⟩

/- Promoted numerical labels are exactly the overlap of target and old labels. -/
theorem distinct_canonical_promoted_image {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P) :
    univ.image (fun s : distinctPromotedTargetSlots f t => t s.val) =
      univ.image t ∩ univ.image f := by
  ext p
  simp only [mem_image, mem_univ, true_and, mem_inter]
  constructor
  · rintro ⟨s, rfl⟩
    refine ⟨⟨s.val, rfl⟩, ?_⟩
    simpa only [mem_image, mem_univ, true_and] using
      (mem_distinctPromotedTargetSlots f t s.val).mp s.property
  · rintro ⟨⟨s, rfl⟩, hs⟩
    have hp : s ∈ distinctPromotedTargetSlots f t := by
      rw [mem_distinctPromotedTargetSlots]
      simpa only [mem_image, mem_univ, true_and] using hs
    exact ⟨⟨s, hp⟩, rfl⟩

theorem distinct_canonical_promotion_card {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq P] (f : J ↪ P) (t : S ↪ P) :
    (distinctPromotedTargetSlots f t).card = (univ.image t ∩ univ.image f).card := by
  rw [← distinct_canonical_promoted_image f t,
    card_image_of_injective _ (show Function.Injective
      (fun s : distinctPromotedTargetSlots f t => t s.val) from
        fun a b h => Subtype.ext (t.injective h)), card_univ,
    Fintype.card_coe]




/- Matching old values on the canonical promotion slots, together with the
fresh restriction on the complement, reconstruct the entire target tuple. -/
theorem distinct_unrestricted_target_labels {S J P : Type*}
    [Fintype S] [Fintype J] [DecidableEq S] [DecidableEq P]
    (f : J ↪ P) (t : S ↪ P) (Z : Finset J)
    (e : distinctPromotedTargetSlots f t ↪ Z)
    (hmatch : ∀ s : distinctPromotedTargetSlots f t, f (e s).val = t s.val) :
    unrestrictedTargetLabels (distinctPromotedTargetSlots f t)
      (fun s => f (e s).val) (distinctCanonicalFresh f t) = t := by
  funext s
  by_cases hs : s ∈ distinctPromotedTargetSlots f t
  · simp only [unrestrictedTargetLabels, dif_pos hs]
    exact hmatch ⟨s, hs⟩
  · simp only [unrestrictedTargetLabels, dif_neg hs, distinctCanonicalFresh]




/- The target tuple generated by the literal unrestricted edge is the given
fixed target, when its old labels and promotion matching agree. -/
theorem distinct_unrestricted_edge_target {P Q : Type*} [DecidableEq P]
    {N n : ℕ} (old : Fin N → Q) (label : Q → P)
    (f : Fin N ↪ P) (hlabel : ∀ j, label (old j) = f j) (t : Fin n ↪ P)
    (eligible : Finset (Fin N)) (e : distinctPromotedTargetSlots f t ↪ eligible)
    (hmatch : ∀ s : distinctPromotedTargetSlots f t, f (e s).val = t s.val) :
    unrestrictedEdgeTarget old label (distinctPromotedTargetSlots f t) e
      (distinctCanonicalFresh f t) = t := by
  unfold unrestrictedEdgeTarget
  have he : (fun s : distinctPromotedTargetSlots f t => label (old (e s).val)) =
      (fun s : distinctPromotedTargetSlots f t => f (e s).val) := by
    funext s
    exact hlabel _
  rw [he]
  exact distinct_unrestricted_target_labels f t eligible e hmatch
end

section
open Finset
/- A distinct literal particle list representing a phase memory has exactly
the phase memory's number of zero residues. -/
theorem distinct_particle_phase_zero_count {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, Zero (R p)] [∀ p, DecidableEq (R p)]
    (q : FiniteOrderedTuple (Σ p, R p)) (w : (p : P) → GhostPhaseState (R p))
    (hinj : Function.Injective (fun j => (q.2 j).1))
    (hsupport : univ.image (fun j => (q.2 j).1) = ghostPhasePendingSupport w)
    (hvalue : ∀ j, w (q.2 j).1 = some (some (some (q.2 j).2))) :
    orderedPredicateCount q (fun z => z.2 = 0) = (ghostPhaseZeroSet w).card := by
  let f : DistinctOrderedSupport (Fin q.1) (ghostPhasePendingSupport w) :=
    ⟨⟨fun j => (q.2 j).1, hinj⟩, by
      intro p
      rw [← hsupport]
      simp only [mem_image, mem_univ, true_and]
      rfl⟩
  have h := distinct_phase_zero_count f w rfl (fun j => (q.2 j).2) hvalue
  rw [ordered_zero_count_eq_sum] at h
  refine Eq.trans ?_ h
  unfold orderedPredicateCount
  apply sum_congr rfl
  intro j _
  by_cases hz : (q.2 j).2 = 0 <;> simp only [hz, if_true, if_false]

/- Distinct fresh slots enumerate their label support once. -/
theorem distinct_unrestricted_fresh_weight {I P : Type*}
    [Fintype I] [DecidableEq I] [DecidableEq P]
    (μ : P → ℝ) (T : Finset I) (fresh : UnrestrictedFreshLabels P T)
    (hinj : Function.Injective fresh) (S : Finset P)
    (hS : univ.image fresh = S) :
    unrestrictedFreshWeight μ T fresh = ∏ p ∈ S, μ p := by
  rw [← hS, prod_image]
  · rfl
  · intro i _ j _ hij
    exact hinj hij

/- The literal unrestricted event mass agrees with the phase endpoint
damping and numerical fresh-label weight on a distinct-label event.
The represented output is the actual unrestrictedEdgeOutput, not a surrogate. -/
theorem distinct_unrestricted_event_mass {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, Zero (R p)] [∀ p, DecidableEq (R p)] {t N : ℕ}
    (source : Fin t → P) (old : Fin N → Σ p, R p)
    (seed : P → Σ p, R p) (transport : (Σ p, R p) → Σ p, R p)
    (μ : P → ℝ) (ρ V : ℝ) (stores promotions : Finset (Fin t))
    {eligible : Finset (Fin N)} (e : promotions ↪ ↥eligible)
    (fresh : UnrestrictedFreshLabels P promotions)
    (w z : (p : P) → GhostPhaseState (R p))
    (holdinj : Function.Injective (fun j => (old j).1))
    (houtsinj : Function.Injective (fun j =>
      ((unrestrictedEdgeOutput source old seed transport stores promotions e).2 j).1))
    (holdsupport : univ.image (fun j => (old j).1) = ghostPhasePendingSupport w)
    (houtsupport : univ.image (fun j =>
      ((unrestrictedEdgeOutput source old seed transport stores promotions e).2 j).1) =
        ghostPhasePendingSupport z)
    (holdvalue : ∀ j, w (old j).1 = some (some (some (old j).2)))
    (houtvalue : ∀ j,
      z ((unrestrictedEdgeOutput source old seed transport stores promotions e).2 j).1 =
        some (some (some ((unrestrictedEdgeOutput source old seed transport stores promotions e).2 j).2)))
    (hfresh : Function.Injective fresh) (S : Finset P) (hS : univ.image fresh = S) :
    unrestrictedEdgeEventMass source old seed transport (fun x => x.2 = 0)
      μ ρ V stores promotions e fresh =
        ρ ^ (ghostPhaseZeroSet w).card * ρ ^ (ghostPhaseZeroSet z).card *
          (V⁻¹) ^ promotions.card * ∏ p ∈ S, μ p := by
  unfold unrestrictedEdgeEventMass
  rw [distinct_particle_phase_zero_count ⟨N, old⟩ w holdinj holdsupport holdvalue,
    distinct_particle_phase_zero_count
      (unrestrictedEdgeOutput source old seed transport stores promotions e)
      z houtsinj houtsupport houtvalue,
    distinct_unrestricted_fresh_weight μ promotions fresh hfresh S hS]
  simp only [div_eq_mul_inv, inv_pow]






end

section
open Finset





end

section
open Finset
/- The old labels among entering active slots are precisely promotions. -/
theorem ghost_phase_new_run_pending {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (atgt asrc : P → Bool)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w) :
    ghostPhaseNewRunSet atgt asrc ∩ ghostPhasePendingSupport w =
      ghostPhasePromotionSet atgt w := by
  classical
  ext p
  have hwp := hw p
  cases ht : atgt p <;> cases hs : asrc p <;> rcases hp : w p with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseNewRunSet, ghostPhasePromotionSet, ghostPhasePendingSupport,
      ghostPhaseActivitySupport]

/- The entering active labels outside the old memory are precisely fresh
labels. Compatibility excludes an attempted rebirth of a completed label. -/
theorem ghost_phase_new_run_without_pending {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)]
    (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true) :
    ghostPhaseNewRunSet atgt asrc \ ghostPhasePendingSupport w =
      ghostPhaseFreshSet atgt asrc w := by
  classical
  ext p
  have hwp := hw p
  have hcp := hc p
  cases ht : atgt p <;> cases hs : asrc p <;> rcases hp : w p with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseNewRunSet, ghostPhasePendingSupport, ghostPhaseFreshSet,
      ghostPhaseEdgeFresh, ghostPhaseMovingEdgeCompatible]
end

section
open Finset
section

variable
  {P : Type*}
  [sharedInstance1 : Fintype P]
  [sharedInstance2 : DecidableEq P]
  {R : P → Type*}
  {N t : ℕ}
  (atgt asrc : P → Bool)
  (w : (p : P) → GhostPhaseState (R p))
  (hw : ghostPhaseMask asrc w)
  (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
  (target : Fin t ↪ P)
  (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)

include P sharedInstance1 sharedInstance2 R N t atgt asrc w hw f target htarget

/- A matching eligible injection selects precisely the target-active old
indices when the target tuple enumerates the newly active labels. -/
theorem distinct_phase_event_selected 
    (eligible : Finset (Fin N)) (e : distinctPromotedTargetSlots f.val target ↪ eligible)
    (hmatch : ∀ s : distinctPromotedTargetSlots f.val target, f.val (e s).val = target s.val) :
    ∀ j, j ∈ promotionSelectedIndices e ↔ atgt (f.val j) = true := by
  rw [distinct_canonical_eligible_selected_indices f.val target eligible e hmatch]
  intro j
  rw [mem_filter, and_iff_right (mem_univ j), htarget]
  have hi := distinct_phase_old_inactive asrc w hw f j
  simp [ghostPhaseNewRunSet, hi]

theorem distinct_phase_event_promotion_card  :
    (distinctPromotedTargetSlots f.val target).card = (ghostPhasePromotionSet atgt w).card := by
  rw [distinct_canonical_promotion_card, htarget, distinct_ordered_support_image f,
    ghost_phase_new_run_pending atgt asrc w hw]

end


theorem distinct_phase_event_fresh_image {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)] {N t : ℕ}
    (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (target : Fin t ↪ P) (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true) :
    univ.image (distinctCanonicalFresh f.val target) = ghostPhaseFreshSet atgt asrc w := by
  rw [distinct_canonical_fresh_image, htarget, distinct_ordered_support_image f,
    ghost_phase_new_run_without_pending atgt asrc delta w hw hc]

/- On a compatible distinct event, the actual unrestricted event mass equals
the product of actual normalized phase kernels. No output-count or scalar
mass equality is assumed: both follow from the ordered event construction. -/
theorem distinct_unrestricted_phase_event_mass {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    {N t : ℕ} (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (source target : Fin t ↪ P) (stores : Finset (Fin t))
    (hsource : ∀ j, asrc (source j) = true)
    (hstores : ∀ j ∈ stores, atgt (source j) = false)
    (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (old : (j : Fin N) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (eligible : Finset (Fin N)) (e : distinctPromotedTargetSlots f.val target ↪ eligible)
    (hmatch : ∀ s : distinctPromotedTargetSlots f.val target, f.val (e s).val = target s.val)
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true)
    (β : P → ℝ) (ρ V : ℝ) :
    unrestrictedEdgeEventMass source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
      (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) (fun z => z.2 = 0)
      (fun p => β p / V) ρ V stores (distinctPromotedTargetSlots f.val target) e
      (distinctCanonicalFresh f.val target) =
        ∏ p, (if atgt p && !(asrc p) then V⁻¹ else 1) *
          ghostPhaseDampedMovingEdge (atgt p) (asrc p) (delta p) (β p) ρ ρ
            (ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p)
              (distinctUnrestrictedStorageChoice source stores p) (w p)) (w p) := by
  have he := distinct_phase_event_selected atgt asrc w hw f target htarget eligible e hmatch
  have hcount := distinct_phase_event_promotion_card atgt asrc w hw f target htarget
  have hfresh := distinct_phase_event_fresh_image atgt asrc delta w hw f target htarget hc
  have hs := distinct_unrestricted_storage_allowed source stores atgt asrc hsource hstores
  have hmass := distinct_unrestricted_event_mass source
    (fun j => (⟨f.val j, old j⟩ : Σ p, R p)) (fun p => ⟨p, 0⟩)
    (unrestrictedPhaseTransport delta) (fun p => β p / V) ρ V stores
    (distinctPromotedTargetSlots f.val target) e (distinctCanonicalFresh f.val target)
    w (fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p)
      (distinctUnrestrictedStorageChoice source stores p) (w p))
    f.val.injective
    (distinct_unrestricted_output_label_injective source stores _ atgt asrc delta w hw
      hsource hstores f old e)
    (distinct_ordered_support_image f)
    (distinct_unrestricted_output_support source stores _ atgt asrc delta w hw
      hsource hstores f old e he)
    hold
    (distinct_unrestricted_output_particle source stores _ atgt asrc delta w hw
      hsource hstores f old e he hold)
    (distinct_canonical_fresh_injective f.val target) (ghostPhaseFreshSet atgt asrc w) hfresh
  rw [hmass, hcount]
  rw [ghost_phase_run_normalized_edge_fresh_measure atgt asrc
    (distinctUnrestrictedStorageChoice source stores) delta β ρ ρ V w hw hs,
    if_pos hc, mul_one]
end

section
open Finset
/- The total number of prime factors, counted with multiplicity. -/
noncomputable def primeFactorMultiplicity (n : ℕ) : ℕ :=
  ∑ p ∈ n.primeFactors, n.factorization p

theorem card_divisors_le_two_pow_multiplicity {n : ℕ} (hn : n ≠ 0) :
    n.divisors.card ≤ 2 ^ primeFactorMultiplicity n := by
  rw [Nat.card_divisors hn, primeFactorMultiplicity, ← Finset.prod_pow_eq_pow_sum]
  exact Finset.prod_le_prod₀ (fun _ _ => Nat.zero_le _) (fun p _ =>
    Nat.succ_le_iff.mpr Nat.lt_two_pow_self)

theorem pow_multiplicity_le_of_large_primeFactors {n : ℕ} (hn : n ≠ 0)
    {W : ℝ} (hW : 0 ≤ W) (hlarge : ∀ p ∈ n.primeFactors, W ≤ (p : ℝ)) :
    W ^ primeFactorMultiplicity n ≤ (n : ℝ) := by
  have hnprod : (n : ℝ) = ∏ p ∈ n.primeFactors, (p : ℝ) ^ n.factorization p := by
    exact_mod_cast Nat.prod_primeFactors_pow_factorization hn
  rw [hnprod, primeFactorMultiplicity, ← Finset.prod_pow_eq_pow_sum]
  exact Finset.prod_le_prod₀ (fun _ _ => pow_nonneg hW _) (fun p hp =>
    pow_le_pow_left₀ hW (hlarge p hp) _)

section

variable
  {n : ℕ}
  (hn : n ≠ 0)
  {W : ℝ}
  (hW : 1 < W)
  (hlarge : ∀ p ∈ n.primeFactors, W ≤ (p : ℝ))

include n hn W hW hlarge

theorem multiplicity_le_log_div_of_large_primeFactors  :
    (primeFactorMultiplicity n : ℝ) ≤ Real.log n / Real.log W := by
  have hW0 : 0 < W := lt_trans zero_lt_one hW
  have h := Real.log_le_log (pow_pos hW0 _) (pow_multiplicity_le_of_large_primeFactors hn hW0.le hlarge)
  rw [Real.log_pow] at h
  exact (le_div_iff₀ (Real.log_pos hW)).mpr h

theorem card_divisors_le_exp_of_large_primeFactors  :
    (n.divisors.card : ℝ) ≤ Real.exp (Real.log 2 * Real.log n / Real.log W) := by
  have hm := multiplicity_le_log_div_of_large_primeFactors hn hW hlarge
  have hc : (n.divisors.card : ℝ) ≤ (2 : ℝ) ^ primeFactorMultiplicity n := by
    exact_mod_cast card_divisors_le_two_pow_multiplicity hn
  calc
    _ ≤ (2 : ℝ) ^ primeFactorMultiplicity n := hc
    _ = Real.exp ((primeFactorMultiplicity n : ℝ) * Real.log 2) := by
      rw [Real.exp_nat_mul, Real.exp_log (by norm_num : (0 : ℝ) < 2)]
    _ ≤ Real.exp (Real.log 2 * Real.log n / Real.log W) := by
      apply Real.exp_le_exp.mpr
      have h := mul_le_mul_of_nonneg_left hm (Real.log_pos (by norm_num : (1 : ℝ) < 2)).le
      simpa only [mul_div_assoc, mul_comm (primeFactorMultiplicity n : ℝ) (Real.log 2)] using h

end


/- Divisors all of whose prime factors are at least `W`. -/
noncomputable def roughDivisors (W : ℝ) (n : ℕ) : Finset ℕ := by
  classical
  exact n.divisors.filter (fun d => ∀ p ∈ d.primeFactors, W ≤ (p : ℝ))

/- The full prime-power part of an integer supported on primes at least `W`. -/
noncomputable def roughPrimePart (W : ℝ) (n : ℕ) : ℕ := by
  classical
  exact primePoolPart (n.primeFactors.filter (fun p => W ≤ (p : ℝ))) n

theorem roughPrimePart_ne_zero (W : ℝ) (n : ℕ) : roughPrimePart W n ≠ 0 :=
  primePoolPart_ne_zero _ _

theorem roughPrimePart_dvd (W : ℝ) (n : ℕ) : roughPrimePart W n ∣ n :=
  primePoolPart_dvd _ _

theorem roughPrimePart_primeFactors_large (W : ℝ) (n : ℕ) :
    ∀ p ∈ (roughPrimePart W n).primeFactors, W ≤ (p : ℝ) := by
  classical
  intro p hp
  exact (mem_filter.mp (Nat.primeFactors_subset_of_mem_factoredNumbers
    (primePoolPart_mem_factoredNumbers (n.primeFactors.filter (fun p => W ≤ (p : ℝ))) n) hp)).2

theorem roughDivisors_eq_divisors_roughPrimePart (W : ℝ) {n : ℕ} (hn : n ≠ 0) :
    roughDivisors W n = (roughPrimePart W n).divisors := by
  classical
  ext d
  simp only [roughDivisors, mem_filter, Nat.mem_divisors]
  constructor
  · rintro ⟨⟨hdn, _⟩, hlarge⟩
    have hd0 : d ≠ 0 := by
      intro hd
      subst d
      exact hn (by simpa using hdn)
    refine ⟨(Nat.factorization_le_iff_dvd hd0 (roughPrimePart_ne_zero W n)).mp ?_,
      roughPrimePart_ne_zero W n⟩
    rw [roughPrimePart, factorization_primePoolPart]
    intro p
    by_cases hp : p ∈ n.primeFactors.filter (fun q : ℕ => W ≤ (q : ℝ))
    · rw [Finsupp.filter_apply_pos _ _ hp]
      exact (Nat.factorization_le_iff_dvd hd0 hn).mpr hdn p
    · have hdf : d.factorization p = 0 := by
        apply Finsupp.notMem_support_iff.mp
        intro hpd
        exact hp (mem_filter.mpr ⟨Nat.primeFactors_mono hdn hn hpd, hlarge p hpd⟩)
      rw [Finsupp.filter_apply_neg _ _ hp, hdf]
  · rintro ⟨hd, _⟩
    refine ⟨⟨hd.trans (roughPrimePart_dvd W n), hn⟩, ?_⟩
    intro p hp
    exact roughPrimePart_primeFactors_large W n p
      (Nat.primeFactors_mono hd (roughPrimePart_ne_zero W n) hp)

theorem roughDivisors_card_le_exp_log {W : ℝ} (hW : 1 < W)
    {n : ℕ} (hn : n ≠ 0) :
    ((roughDivisors W n).card : ℝ) ≤ Real.exp (Real.log 2 * Real.log n / Real.log W) := by
  rw [roughDivisors_eq_divisors_roughPrimePart W hn]
  refine (card_divisors_le_exp_of_large_primeFactors (roughPrimePart_ne_zero W n) hW
    (roughPrimePart_primeFactors_large W n)).trans ?_
  apply Real.exp_le_exp.mpr
  apply div_le_div_of_nonneg_right _ (Real.log_pos hW).le
  apply mul_le_mul_of_nonneg_left _ (Real.log_pos (by norm_num : (1 : ℝ) < 2)).le
  apply Real.log_le_log
  · exact_mod_cast Nat.pos_of_ne_zero (roughPrimePart_ne_zero W n)
  · exact_mod_cast Nat.le_of_dvd (Nat.pos_of_ne_zero hn) (roughPrimePart_dvd W n)
end

section
open Finset
theorem roughDivisors_card_le_exp_of_exp_bound {U V : ℝ} (hV : 0 < V)
    {n : ℕ} (hn : n ≠ 0) (hsize : (n : ℝ) ≤ Real.exp U) :
    ((roughDivisors (Real.exp V) n).card : ℝ) ≤ Real.exp (Real.log 2 * U / V) := by
  have h := roughDivisors_card_le_exp_log (W := Real.exp V)
    (by simpa using Real.exp_lt_exp.mpr hV) hn
  rw [Real.log_exp] at h
  refine h.trans (Real.exp_le_exp.mpr ?_)
  apply div_le_div_of_nonneg_right _ hV.le
  apply mul_le_mul_of_nonneg_left _ (Real.log_pos (by norm_num : (1 : ℝ) < 2)).le
  exact (Real.log_le_iff_le_exp (by exact_mod_cast Nat.pos_of_ne_zero hn)).mpr hsize

theorem roughDivisors_card_le_exp_sqrt {L C : ℝ} (hL : 0 < L)
    {n : ℕ} (hn : n ≠ 0) (hsize : (n : ℝ) ≤ Real.exp (C * L)) :
    ((roughDivisors (Real.exp (Real.sqrt L)) n).card : ℝ) ≤
      Real.exp ((C * Real.log 2) * Real.sqrt L) := by
  have h := roughDivisors_card_le_exp_of_exp_bound (Real.sqrt_pos.mpr hL) hn hsize
  have hid : Real.log 2 * (C * L) / Real.sqrt L = (C * Real.log 2) * Real.sqrt L := by
    apply (div_eq_iff (Real.sqrt_pos.mpr hL).ne').mpr
    calc
      _ = (C * Real.log 2) * (Real.sqrt L ^ 2) := by rw [Real.sq_sqrt hL.le]; ring
      _ = _ := by ring
  simpa only [hid] using h

theorem odd_nat_le_exp_twice {L : ℝ} (hL : Real.log 3 ≤ L)
    {u : ℕ} (hu : (u : ℝ) ≤ Real.exp L) :
    ((2 * u + 1 : ℕ) : ℝ) ≤ Real.exp (2 * L) := by
  have he : (3 : ℝ) ≤ Real.exp L :=
    (Real.log_le_iff_le_exp (by norm_num : (0 : ℝ) < 3)).mp hL
  calc
    _ = 2 * (u : ℝ) + 1 := by norm_cast
    _ ≤ 3 * Real.exp L := by linarith
    _ ≤ Real.exp L * Real.exp L := mul_le_mul_of_nonneg_right he (Real.exp_pos _).le
    _ = Real.exp (2 * L) := by rw [← Real.exp_add]; congr 1; ring

theorem odd_roughDivisors_card_le_exp_sqrt {L : ℝ} (hL : Real.log 3 ≤ L)
    {u : ℕ} (hu : (u : ℝ) ≤ Real.exp L) :
    ((roughDivisors (Real.exp (Real.sqrt L)) (2 * u + 1)).card : ℝ) ≤
      Real.exp ((2 * Real.log 2) * Real.sqrt L) := by
  apply roughDivisors_card_le_exp_sqrt
    ((Real.log_pos (by norm_num : (1 : ℝ) < 3)).trans_le hL)
    (by omega : 2 * u + 1 ≠ 0)
  exact odd_nat_le_exp_twice hL hu
end

