/- Each short integer block is separated; the number of blocks is controlled
by the actual width of the supporting integer interval. -/
theorem rational_phase_interval_row_sum_le {ι : Type*} (S : Finset ι)
    (t : ι → ℤ) (hinj : Set.InjOn t S) (A : ℤ) (V N : ℕ)
    (ht : ∀ i ∈ S, A ≤ t i ∧ t i ≤ A + (V : ℤ))
    {u : ℤ} {r : ℕ} (hr : 2 ≤ r) (hcop : (r : ℤ).gcd u = 1)
    {β : ℝ} (hβ : |β| ≤ 1 / (r : ℝ) ^ 2) (base : ℝ) :
    (∑ i ∈ S, circleGeometricBound N (((u : ℝ) / r + β) * t i - base)) ≤
      (1 + 3 * (V : ℝ) / r) *
        (2 * (N : ℝ) + 2 * (r : ℝ) * (1 + Real.log r)) := by
  classical
  let H : ℕ := r / 2
  let B : ℝ := 2 * (N : ℝ) + 2 * (r : ℝ) * (1 + Real.log r)
  have hH : 0 < H := half_integer_block_pos hr
  have hHZ : (0 : ℤ) < H := by exact_mod_cast hH
  have hr0 : 0 < r := by omega
  have hlog : 0 ≤ Real.log (r : ℝ) := Real.log_nonneg (by exact_mod_cast (show 1 ≤ r by omega))
  have hB : 0 ≤ B := by dsimp [B]; positivity
  have hfiber : ∀ j : ℤ,
      (∑ i ∈ S with (t i - A) / (H : ℤ) = j,
        circleGeometricBound N (((u : ℝ) / r + β) * t i - base)) ≤ B := by
    intro j
    apply circle_geometric_finite_sum_le _ _ N hr0
    intro i hi k hk hik
    obtain ⟨hiS, hiB⟩ := Finset.mem_filter.mp hi
    obtain ⟨hkS, hkB⟩ := Finset.mem_filter.mp hk
    have hsmall := same_positive_ediv_abs_sub_lt hHZ (hiB.trans hkB.symm)
    have heZ : (t i - A) - (t k - A) = t i - t k := by ring
    rw [heZ] at hsmall
    have hsmallR : |((t i - t k : ℤ) : ℝ)| < (H : ℝ) := by exact_mod_cast hsmall
    have hsize : |((t i - t k : ℤ) : ℝ)| ≤ (r : ℝ) / 2 :=
      hsmallR.le.trans (half_integer_block_comparison hr).2
    have hne : t i - t k ≠ 0 := by
      intro he
      exact hik (hinj hiS hkS (sub_eq_zero.mp he))
    have hs := coprime_rational_phase_separation hr0 hcop hne hβ hsize
    have he : (((u : ℝ) / r + β) * t i - base) -
        (((u : ℝ) / r + β) * t k - base) =
          ((u : ℝ) / r + β) * ((t i - t k : ℤ) : ℝ) := by
      push_cast
      ring
    rw [he]
    exact hs
  have hcard : ((S.image (fun i => (t i - A) / (H : ℤ))).card : ℝ) ≤
      1 + 3 * (V : ℝ) / r := by
    have hh : ((S.image (fun i => (t i - A) / (H : ℤ))).card : ℝ) ≤
        ((V / H + 1 : ℕ) : ℝ) := by
      exact_mod_cast shifted_integer_block_image_card_le S t A V hH ht
    exact hh.trans (half_integer_block_count_le hr V)
  rw [← sum_integerBlock_fibers S (fun i => t i - A) (H : ℤ)
    (fun i => circleGeometricBound N (((u : ℝ) / r + β) * t i - base))]
  calc
    _ ≤ ∑ _j ∈ S.image (fun i => (t i - A) / (H : ℤ)), B :=
      Finset.sum_le_sum (fun j hj => hfiber j)
    _ = ((S.image (fun i => (t i - A) / (H : ℤ))).card : ℝ) * B := by
      rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ _ := mul_le_mul_of_nonneg_right hcard hB


theorem circle_geometric_bound_le_length (N : ℕ) (x : ℝ) :
    circleGeometricBound N x ≤ (N : ℝ) := by
  unfold circleGeometricBound
  split_ifs
  · exact le_rfl
  · exact min_le_left _ _

