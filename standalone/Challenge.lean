    {I : G → Type*} [∀ g, DecidableEq (I g)]
    (s : Finset G) (A B : ∀ g, Finset (I g)) (hAB : ∀ g, Disjoint (A g) (B g)) :
    Disjoint (s.sigma A) (univ.sigma B) :=
