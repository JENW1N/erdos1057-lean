theorem candidate_prefix_rest_mass_eq_tuple_sum (c L eps : ℝ) (r jStar J : ℕ) (hr : 0 < r) :
    candidatePrefixRestHarmonicMass c L eps r jStar J hr =
      ∑ y : ∀ slot, candidatePrefixRestChoices c L eps r jStar J hr slot,
        (1 / (orderedSlotProduct (candidatePrefixRestChoices c L eps r jStar J hr) y : ℝ)) /
          ((r.factorial : ℝ)^(candidateQIndices c L).card) := by
  exact ordered_slot_harmonic_eq_tuple_sum _ _

theorem candidate_rest_tuple_complete (c L eps : ℝ) (r jStar J : ℕ) (hr : 0 < r)
    (p0 : candidatePrefixChoices c L eps r jStar J (candidateFreeSlot c L r hr))
    (y : ∀ slot, candidatePrefixRestChoices c L eps r jStar J hr slot) :
    ∃ x : (candidateQIndices c L) × Fin r → ℕ,
      (∀ slot, x slot ∈ candidatePrefixChoices c L eps r jStar J slot) ∧
      candidateRestProduct c L r hr x =
        orderedSlotProduct (candidatePrefixRestChoices c L eps r jStar J hr) y := by
  classical
  let x := fun slot => if h : slot = candidateFreeSlot c L r hr then p0.val else (y ⟨slot, h⟩).val
  refine ⟨x, ?_, ?_⟩
  · intro slot
    by_cases h : slot = candidateFreeSlot c L r hr
    · subst slot
      simpa only [x, dif_pos rfl] using p0.property
    · simpa only [x, dif_neg h, candidatePrefixRestChoices] using (y ⟨slot, h⟩).property
  · unfold candidateRestProduct orderedSlotProduct
    apply prod_congr rfl
    intro slot _
    simp only [x, dif_neg slot.property]

theorem candidate_rest_tuple_nonzero {c L eps : ℝ} {r jStar J : ℕ} (hr : 0 < r)
    (hcL : 0 ≤ c * L) (heps1 : eps ≤ 1/10) (hJ : J < jStar)
    (y : ∀ slot, candidatePrefixRestChoices c L eps r jStar J hr slot) :
    orderedSlotProduct (candidatePrefixRestChoices c L eps r jStar J hr) y ≠ 0 := by
  apply prod_ne_zero_iff.mpr
  intro slot _
  exact candidate_Q_slot_nonzero c L r jStar slot.val
    (candidatePrefixChoices_subset hcL heps1 hJ slot.val (y slot).property)

theorem eventually_candidate_rest_tuple_log_window {c eps : ℝ} {r J : ℕ}
    (hc : 0 < c) (hr : 0 < r) (heps0 : 0 ≤ eps) (heps1 : eps ≤ 1/10)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1)
    (hepsr : eps * (r : ℝ) ≤ 1/400) (hJ : 1000 * (r : ℝ) ≤ 2^J) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J < jStar →
      ∀ y : ∀ slot, candidatePrefixRestChoices c L eps r jStar J hr slot,
      ∀ p ∈ candidateSmallPSet c L (Real.exp ((c / 100) * L)),
      c * L ≤ Real.log (Real.exp L /
        ((p * orderedSlotProduct (candidatePrefixRestChoices c L eps r jStar J hr) y : ℕ) : ℝ)) ∧
      Real.log (Real.exp L /
        ((p * orderedSlotProduct (candidatePrefixRestChoices c L eps r jStar J hr) y : ℕ) : ℝ)) + Real.log 16 ≤
          (6/5 : ℝ) * c * L := by
  classical
  obtain ⟨v, V, hv, _, hband⟩ := exists_candidateQBands_bounds hc
  filter_upwards [eventually_candidate_remainder_log_window hc hr heps0 heps1 hcenter hepsr hJ,
    hband] with L hwindow hb
  intro jStar hJstar y p hp
  have hzero : 0 ∈ candidateQIndices c L := by simp [candidateQIndices]
  have hlower := (hb.2.2 0 hzero).2.2.1
  have hne : (candidateQBand (c * L) 0).Nonempty := by
    by_contra hn
    rw [not_nonempty_iff_eq_empty.mp hn, sum_empty] at hlower
    linarith
  obtain ⟨p0, hp0⟩ := hne
  have hp0' : p0 ∈ candidatePrefixChoices c L eps r jStar J (candidateFreeSlot c L r hr) := by
    rw [candidate_prefix_free_choice c L eps r jStar J hr hJstar]
    exact hp0
  obtain ⟨x, hx, hprod⟩ := candidate_rest_tuple_complete c L eps r jStar J hr ⟨p0, hp0'⟩ y
  have hpLog : Real.log p ≤ c * L / 100 := by
    have h := candidate_small_P_set_log_bound hp
    nlinarith
  have h := hwindow jStar hJstar x hx p (candidate_small_P_set_nonzero hp) hpLog
  rwa [hprod] at h
end

