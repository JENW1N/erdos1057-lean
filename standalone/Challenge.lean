/- Exact character averages for all shifts in the finite off-diagonal energy. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

noncomputable def typeIICharacterAverage (E N M H Z : Finset ℕ)
    (k : ℤ) [NeZero (2 * k.natAbs)] (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ) : ℂ :=
  (1 / ((2 * k.natAbs).totient : ℂ)) *
    ∑ χ : DirichletCharacter ℂ (2 * k.natAbs),
      ∑ y ∈ typeIIFreeDeterminantSlice E N M H Z k,
        typeIIShiftComplexWeight η α aH y * χ (y.2.1.1 : ZMod (2 * k.natAbs)) *
          conj (χ (y.2.2.1 : ZMod (2 * k.natAbs)))

noncomputable def typeIICharacterSlice (E N M H Z : Finset ℕ)
    (k : ℤ) (η : ℕ → ℕ → ℝ) (α aH : ℕ → ℂ) : ℂ :=
  if hk : k = 0 then 0 else
    @typeIICharacterAverage E N M H Z k
      ⟨by simpa only [ne_eq, mul_eq_zero, OfNat.ofNat_ne_zero, false_or,
        Int.natAbs_eq_zero] using hk⟩ η α aH

theorem typeII_determinant_sum_slices (E N M H : Finset ℕ)
    (K : Finset ℤ) (Z : Finset ℕ) (f : TypeIIShiftIndex → ℝ) :
    (∑ y ∈ typeIIDeterminantDomain E N M H K Z, f y) =
      ∑ k ∈ K, ∑ y ∈ typeIIDeterminantDomain E N M H {k} Z, f y := by
  classical
  simp only [typeIIDeterminantDomain, sum_filter, sum_product, sum_singleton]

theorem typeII_zero_determinant_slice (E N M H Z : Finset ℕ) :
    typeIIDeterminantDomain E N M H {0} Z = ∅ := by
  classical
  apply filter_eq_empty_iff.mpr
  intro y hy hc
  have hk : y.1.1 = 0 := mem_singleton.mp (mem_product.mp (mem_product.mp hy).1).1
  exact hc.2.1 hk













end Bounty

