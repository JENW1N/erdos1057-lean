open Finset
theorem roughBand_divisor_filter_subset {A B W : ℝ} {n : ℕ} (hn : n ≠ 0) :
    (roughBand A B W).filter (fun d => d ∣ n) ⊆ roughDivisors W n := by
  intro d hd
  obtain ⟨hdR, hdvd⟩ := mem_filter.mp hd
  apply mem_filter.mpr
  exact ⟨Nat.mem_divisors.mpr ⟨hdvd, hn⟩, fun p hp => ((mem_filter.mp hdR).2 p hp).le⟩

theorem roughBand_divisor_filter_card_le {A B W : ℝ} {n : ℕ} (hn : n ≠ 0) :
    ((roughBand A B W).filter (fun d => d ∣ n)).card ≤ (roughDivisors W n).card :=
  card_le_card (roughBand_divisor_filter_subset hn)

theorem one_mem_roughDivisors (W : ℝ) {n : ℕ} (hn : n ≠ 0) :
    1 ∈ roughDivisors W n := by
  simp [roughDivisors, Nat.mem_divisors, hn]

theorem one_le_roughDivisors_card (W : ℝ) {n : ℕ} (hn : n ≠ 0) :
    1 ≤ (roughDivisors W n).card :=
  card_pos.mpr ⟨1, one_mem_roughDivisors W hn⟩
end

section
open Finset
private theorem prod_replace_eq_mul_div {I : Type*} [Fintype I] [DecidableEq I]
    (x : I → ℕ) (e : I) (q : ℕ) (he : x e ≠ 0) :
    (∏ i, if i = e then q else x i) = q * ((∏ i, x i) / x e) := by
  have hrest : (∏ i ∈ univ.erase e, if i = e then q else x i) =
      ∏ i ∈ univ.erase e, x i := by
    apply prod_congr rfl
    intro i hi
    exact if_neg (mem_erase.mp hi).1
  rw [← mul_prod_erase univ (fun i => if i = e then q else x i) (mem_univ e),
    if_pos rfl, hrest, ← mul_prod_erase univ x (mem_univ e),
    Nat.mul_div_cancel_left _ (Nat.pos_of_ne_zero he)]

/- An injectively represented finite family with one exceptional slot has the stated product-fiber bound. -/
theorem card_one_exception_prime_product_fiber {G Ω : Type*} [Fintype G] [Fintype Ω]
    (P : G → Finset ℕ) (R : Finset ℕ) (r : ℕ) (e : G × Fin r)
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hR0 : ∀ d ∈ R, d ≠ 0) (q0 : ℕ) (hq0 : q0 ∈ P e.1)
    (x : Ω → G × Fin r → ℕ) (hxinj : Function.Injective x)
    (hxR : ∀ a, x a e ∈ R)
    (hxP : ∀ a s, s ≠ e → x a s ∈ P s.1) (n : ℕ) :
    Nat.card {a : Ω // (∏ s, x a s) = n} ≤
      (R.filter (fun d => d ∣ n)).card * ∏ _g : G, r.factorial := by
  classical
  let F := {a : Ω // (∏ s, x a s) = n}
  let D := R.filter (fun d => d ∣ n)
  let B (d : D) := {y : ∀ g : G, Fin r → P g //
    (∏ g, ∏ i, (y g i).val) = q0 * (n / d.val)}
  let y (a : Ω) (g : G) (i : Fin r) : P g :=
    ⟨if (g, i) = e then q0 else x a (g, i), by
      split_ifs with hs
      · have hg : g = e.1 := congrArg Prod.fst hs
        simpa only [hg] using hq0
      · exact hxP a (g, i) hs⟩
  let f : F → Σ d : D, B d := fun a =>
    ⟨⟨x a.val e, by
        refine mem_filter.mpr ⟨hxR a.val, ?_⟩
        simpa only [a.property] using dvd_prod_of_mem (x a.val) (mem_univ e)⟩,
      ⟨y a.val, by
        change (∏ g, ∏ i, if (g, i) = e then q0 else x a.val (g, i)) = q0 * (n / x a.val e)
        rw [← Fintype.prod_prod_type (fun s : G × Fin r => if s = e then q0 else x a.val s),
          prod_replace_eq_mul_div (x a.val) e q0 (hR0 _ (hxR a.val)),
          a.property]⟩⟩
  let recover (b : Σ d : D, B d) (s : G × Fin r) : ℕ :=
    if s = e then b.1.val else (b.2.val s.1 s.2).val
  have hrecovery (a : F) : recover (f a) = x a.val := by
    funext s
    by_cases hs : s = e
    · simp [recover, f, hs]
    · simp [recover, f, y, hs]
  have hfinj : Function.Injective f := by
    intro a b hab
    apply Subtype.ext
    apply hxinj
    rw [← hrecovery a, ← hrecovery b, hab]
  change Nat.card F ≤ D.card * _
  rw [Nat.card_eq_fintype_card]
  calc
    Fintype.card F ≤ Fintype.card (Σ d : D, B d) := Fintype.card_le_of_injective f hfinj
    _ = ∑ d : D, Fintype.card (B d) := Fintype.card_sigma
    _ ≤ ∑ _d : D, ∏ _g : G, r.factorial := by
      apply sum_le_sum
      intro d _
      simpa only [B, Nat.card_eq_fintype_card] using
        card_ordered_prime_group_product_fiber P (fun _ => r) hprime hdisj (q0 * (n / d.val))
    _ = D.card * ∏ _g : G, r.factorial := by simp

/- Slot choices for a single nonprime exception. -/
noncomputable def oneExceptionPrimeChoices {G : Type*} [DecidableEq G]
    (P : G → Finset ℕ) (R : Finset ℕ) {r : ℕ} (e : G × Fin r)
    (s : G × Fin r) : Finset ℕ :=
  if s = e then R else P s.1

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  (P : G → Finset ℕ)
  (R : Finset ℕ)
  (r : ℕ)
  (e : G × Fin r)
  (hprime : ∀ g p, p ∈ P g → p.Prime)
  (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hR0 : ∀ d ∈ R, d ≠ 0)
  (q0 : ℕ)
  (hq0 : q0 ∈ P e.1)
  (n : ℕ)

include G sharedInstance1 sharedInstance2 P R r e hprime hdisj hR0 q0 hq0 n

/- The direct ordered-slot specialization, including arbitrary repeated prime choices. -/
theorem card_one_exception_ordered_slot_fiber  :
    Nat.card {x : ∀ s, oneExceptionPrimeChoices P R e s //
      orderedSlotProduct (oneExceptionPrimeChoices P R e) x = n} ≤
        (R.filter (fun d => d ∣ n)).card * r.factorial ^ Fintype.card G := by
  classical
  have hinj : Function.Injective (fun x : ∀ s, oneExceptionPrimeChoices P R e s =>
      fun s => (x s).val) := by
    intro x y h
    funext s
    exact Subtype.ext (congrFun h s)
  have h := card_one_exception_prime_product_fiber P R r e hprime hdisj hR0 q0 hq0
    (fun x : ∀ s, oneExceptionPrimeChoices P R e s => fun s => (x s).val) hinj
    (fun x => by simpa [oneExceptionPrimeChoices] using (x e).property)
    (fun x s hs => by simpa only [oneExceptionPrimeChoices, if_neg hs] using (x s).property) n
  simpa only [orderedSlotProduct, prod_const, card_univ] using h

/- With the natural factorial normalization, the ordered-slot weight costs only a rough-divisor count. -/
theorem one_exception_ordered_slot_weight_le  :
    orderedSlotWeight (oneExceptionPrimeChoices P R e)
      ((r.factorial : ℝ)^Fintype.card G) n ≤ (R.filter (fun d => d ∣ n)).card := by
  rw [ordered_slot_weight_eq_count]
  apply (div_le_iff₀ (by positivity : (0 : ℝ) < (r.factorial : ℝ)^Fintype.card G)).mpr
  exact_mod_cast card_one_exception_ordered_slot_fiber P R r e hprime hdisj hR0 q0 hq0 n

end

