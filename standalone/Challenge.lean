theorem repeated_big_untilted_kernel_column_bound {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    (target : RepeatedBigLists P J ell) :
    (∑ aux, ∑ source, repeatedBigActiveMass V (fun _ _ => 1) source *
      ‖repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖) ≤
        B * repeatedBigActiveMass V (fun _ _ => 1) target := by
  calc
    _ = ∑ aux, ∑ source, repeatedBigActiveMass V (fun _ _ => 1) target *
        ‖repeatedBigKernel V (fun _ _ => 1) C ζ (fun x y a => K y x a) aux target source‖ := by
      apply sum_congr rfl
      intro aux ha
      apply sum_congr rfl
      intro source hs
      exact repeated_big_untilted_kernel_weighted_norm_reverse V (fun g => (hV g).le) C ζ K aux source target
    _ = repeatedBigActiveMass V (fun _ _ => 1) target *
        ∑ aux, ∑ source, ‖repeatedBigKernel V (fun _ _ => 1) C ζ
          (fun x y a => K y x a) aux target source‖ := by simp_rw [mul_sum]
    _ ≤ repeatedBigActiveMass V (fun _ _ => 1) target * B :=
      mul_le_mul_of_nonneg_left (repeated_big_untilted_kernel_row_bound V C hV hMass ζ
        (fun x y a => K y x a) B hB (fun x y a => hK y x a) target)
        (repeated_big_untilted_active_mass_nonneg V (fun g => (hV g).le) target)
    _ = _ := mul_comm _ _

/- A pointwise error dominated by the actual base transition has a concrete
operator bound; its row and weighted column masses are derived, not assumed. -/
theorem repeated_big_dominated_schur {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    (E : RepeatedBigLists P J ell → RepeatedBigLists P J ell → ℂ)
    (η : ℝ) (hη : 0 ≤ η)
    (hE : ∀ source target, ‖E source target‖ ≤ η *
      ∑ aux, ‖repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖)
    (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
        (fun source => ∑ target, E source target * f target) ≤
      (η * B) * cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  have hμ := repeated_big_untilted_active_mass_nonneg (P := P) (J := J) (ell := ell) V (fun g => (hV g).le)
  have hrow (source : RepeatedBigLists P J ell) :
      ∑ target, ‖E source target‖ ≤ η * B := by
    calc
      _ ≤ ∑ target, η * ∑ aux, ‖repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖ :=
        sum_le_sum (fun target _ => hE source target)
      _ = η * ∑ aux, ∑ target, ‖repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖ := by
        rw [← mul_sum, sum_comm]
      _ ≤ η * B := mul_le_mul_of_nonneg_left
        (repeated_big_untilted_kernel_row_bound V C hV hMass ζ K B hB hK source) hη
  have hcol (target : RepeatedBigLists P J ell) :
      ∑ source, repeatedBigActiveMass V (fun _ _ => 1) source * ‖E source target‖ ≤
        (η * B) * repeatedBigActiveMass V (fun _ _ => 1) target := by
    calc
      _ ≤ ∑ source, repeatedBigActiveMass V (fun _ _ => 1) source *
          (η * ∑ aux, ‖repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖) :=
        sum_le_sum (fun source _ => mul_le_mul_of_nonneg_left (hE source target) (hμ source))
      _ = η * ∑ aux, ∑ source, repeatedBigActiveMass V (fun _ _ => 1) source *
          ‖repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖ := by
        simp_rw [mul_sum]
        rw [sum_comm]
        apply sum_congr rfl
        intro aux ha
        apply sum_congr rfl
        intro source hs
        ring
      _ ≤ η * (B * repeatedBigActiveMass V (fun _ _ => 1) target) :=
        mul_le_mul_of_nonneg_left
          (repeated_big_untilted_kernel_column_bound V C hV hMass ζ K B hB hK target) hη
      _ = _ := by ring
  have h := finite_weighted_schur_transition_norm univ
    (repeatedBigActiveMass V (fun _ _ => 1)) (fun _ => 1) E
    (fun source _ => hμ source) (fun _ _ => zero_lt_one)
    (mul_nonneg hη hB) (mul_nonneg hη hB)
    (fun source _ => by simpa only [mul_one] using hrow source)
    (fun target _ => by simpa only [mul_one] using hcol target) f
  simpa only [cleanActiveNorm, ← pow_two, Real.sqrt_sq (mul_nonneg hη hB)] using h
end

