section

/- Exact reciprocal, phase, and auxiliary factors in a shared-scaled root term. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalPhasedPairCoefficient
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J))
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (a b : ℝ) (w z : ℕ)
    (L R : PhysicalMarkLists P J ell) : ℂ :=
  if physicalListAdmissible C aux L R then
    K L R aux * physicalPhase a (physicalSharedFactor C L * w) *
      physicalPhase b (physicalSharedFactor C L * z) *
      physicalPhase (-(a+b)) (physicalD C L aux)
  else 0

theorem physical_phased_root_term_scaled
    {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (V : G → ℝ) (C : G → Finset (Fin J)) (q a b : ℝ) (k : ℤ)
    (K : PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (f g : ℤ → ℂ) (Ψ : ℝ → ℂ) (Z : ℝ)
    (L R : PhysicalMarkLists P J ell) (w : ℤ)
    (hf : f ((physicalSharedFactor C L : ℤ) * w) = f w)
    (hg : g ((physicalSharedFactor C L : ℤ) *
      (w + k * (physicalFreeFactor C aux : ℕ))) =
      g (w + k * (physicalFreeFactor C aux : ℕ))) :
    physicalRootPositionTerm V C q (-(a+b)) k K aux
      (fun n => physicalPhase (-a) n.natAbs * f n)
      (fun n => physicalPhase b n.natAbs * g n) Ψ Z L R
      ((physicalSharedFactor C L : ℤ) * w) =
    ((physicalAuxMass V C aux * physicalCompletionMass V C ell /
      (physicalSharedFactor C L : ℝ) : ℝ) : ℂ) *
    (Ψ ((w : ℝ) / (Z * physicalFreeFactor C aux)) * (w : ℂ)⁻¹ *
      (starRingEnd ℂ) (f w) * g (w + k * (physicalFreeFactor C aux : ℕ))) *
    ((physicalVertexWeight L q ((physicalSharedFactor C L : ℤ) * (w.natAbs : ℤ)) *
      physicalVertexWeight R q ((physicalSharedFactor C L : ℤ) *
        ((w + k * (physicalFreeFactor C aux : ℕ)).natAbs : ℤ)) : ℝ) : ℂ) *
    physicalPhasedPairCoefficient C K aux a b w.natAbs
      (w + k * (physicalFreeFactor C aux : ℕ)).natAbs L R := by
  have hs : (physicalSharedFactor C L : ℤ) ≠ 0 := by
    exact_mod_cast (physical_shared_factor_pos C L hprime).ne'
  have he : (physicalSharedFactor C L : ℤ) * w + k * (physicalD C L aux : ℕ) =
      (physicalSharedFactor C L : ℤ) * (w + k * (physicalFreeFactor C aux : ℕ)) := by
    rw [physical_D_shared_free, Nat.cast_mul]
    ring
  have harg := physical_shared_scaled_position C L aux hprime
    ((physicalSharedFactor C L : ℤ) * w) Z (dvd_mul_right _ _)
  rw [Int.mul_ediv_cancel_left w hs] at harg
  unfold physicalRootPositionTerm
  dsimp only
  rw [he, hf, hg, harg]
  rw [physical_vertex_weight_scaled_natAbs, physical_vertex_weight_scaled_natAbs]
  simp only [Int.natAbs_mul, Int.natAbs_natCast, map_mul,
    ← physical_phase_reverse, neg_neg, Int.cast_mul, Int.cast_natCast, mul_inv]
  unfold physicalBarePatternScalar physicalPhasedPairCoefficient
  split_ifs
  · push_cast
    ring
  · simp only [mul_zero, zero_mul]

end Bounty
end

