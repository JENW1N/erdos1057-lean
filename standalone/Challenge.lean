      (bounded_primitive_character_card_le Q)
  have hout := hrec.trans (mul_le_mul_of_nonneg_right hc (div_nonneg hδ hξ.le))
  simpa only [primeProductIdealKernel, ψ, starRingEnd_apply, star_star, δ] using hout
