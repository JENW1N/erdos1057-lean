/- Structural edge constraints and all normalized scalar products split exactly by groups. -/

open Finset
open scoped Classical
namespace Bounty
section Groups
variable {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
  (small : G → Prop) (C : G → Finset (Fin J))
  (a : PhysicalAuxLabels P C) (L R : PhysicalMarkLists P J ell)

theorem physical_list_admissible_group_split :
    physicalListAdmissible C a L R ↔
      physicalListAdmissible (fun g : {g // small g} => C g.val)
        (fun g => a g.val) (fun g => L g.val) (fun g => R g.val) ∧
      physicalListAdmissible (fun g : {g // ¬small g} => C g.val)
        (fun g => a g.val) (fun g => L g.val) (fun g => R g.val) := by
  constructor
  · rintro ⟨hshared, hsource, htarget⟩
    exact ⟨⟨(fun g => hshared g.val), (fun g => hsource g.val), (fun g => htarget g.val)⟩,
      ⟨(fun g => hshared g.val), (fun g => hsource g.val), (fun g => htarget g.val)⟩⟩
  · rintro ⟨⟨hs, hLs, hRs⟩, ⟨hb, hLb, hRb⟩⟩
    refine ⟨?_, ?_, ?_⟩
    · intro g
      by_cases hg : small g
      · exact hs ⟨g, hg⟩
      · exact hb ⟨g, hg⟩
    · intro g
      by_cases hg : small g
      · exact hLs ⟨g, hg⟩
      · exact hLb ⟨g, hg⟩
    · intro g
      by_cases hg : small g
      · exact hRs ⟨g, hg⟩
      · exact hRb ⟨g, hg⟩

variable [Fintype G]

theorem physical_D_group_split :
    physicalD C L a =
      physicalD (fun g : {g // small g} => C g.val) (fun g => L g.val) (fun g => a g.val) *
      physicalD (fun g : {g // ¬small g} => C g.val) (fun g => L g.val) (fun g => a g.val) :=
  (Fintype.prod_subtype_mul_prod_subtype small (physicalGroupD C L a)).symm

theorem physical_aux_mass_group_split (V : G → ℝ) :
    physicalAuxMass V C a =
      physicalAuxMass (fun g : {g // small g} => V g.val) (fun g => C g.val) (fun g => a g.val) *
      physicalAuxMass (fun g : {g // ¬small g} => V g.val) (fun g => C g.val) (fun g => a g.val) :=
  (Fintype.prod_subtype_mul_prod_subtype small
    (fun g => ∏ j : C g, physicalLabelLaw V g (a g j))).symm




end Groups
end Bounty
end

