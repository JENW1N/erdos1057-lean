section
open Finset
/- The number of active runs among visits `0,...,n`. -/
def ghostPhaseRunCount (a : ℕ → Bool) : ℕ → ℕ
  | 0 => if a 0 then 1 else 0
  | n + 1 => ghostPhaseRunCount a n + if a (n + 1) && !(a n) then 1 else 0

/- An initial active slot starts one active run. -/
noncomputable def ghostPhaseRunInitial {R : Type*} (a : Bool) (β V : ℝ)
    (x : GhostPhaseState R) : ℝ :=
  (if a then V⁻¹ else 1) * ghostPhaseInitial a β x

/- Only an inactive-to-active entry starts a new run across an edge. -/
noncomputable def ghostPhaseRunEdge {R : Type*} [Fintype R] [DecidableEq R]
    (aTarget aSource : Bool) (hTarget hSource : R) (β V : ℝ)
    (x y : GhostPhaseState R) : ℝ :=
  (if aTarget && !aSource then V⁻¹ else 1) *
    ghostPhaseEdge aTarget aSource hTarget hSource β x y

/- The alternating phase history with the group factor charged at exactly
the start of each active run. The terminal test is unchanged. -/
noncomputable def ghostPhaseRunHistory {R : Type*} [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β V : ℝ) (n : ℕ) : ℝ :=
  ∑ x, ghostPhaseTerminal (a n) x * finitePathAction
    (fun j x y => ∑ z, ghostPhaseVisit (a (j + 1)) (h (j + 1)) (η (j + 1)) β x z *
      ghostPhaseRunEdge (a (j + 1)) (a j) (h (j + 1)) (h j) β V z y)
    (fun x => ∑ y, ghostPhaseVisit (a 0) (h 0) (η 0) β x y *
      ghostPhaseRunInitial (a 0) β V y) n x













/- The full normalized alternating history differs by exactly one group
factor per active run, including the initial run and excluding the terminal test. -/
theorem ghost_phase_run_history_eq {R : Type*} [Fintype R] [DecidableEq R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (β V : ℝ) (n : ℕ) :
    ghostPhaseRunHistory a h η β V n =
      (V⁻¹) ^ ghostPhaseRunCount a n * ghostPhaseHistory a h η β n := by
  let K := fun j (x y : GhostPhaseState R) =>
    ∑ z, ghostPhaseVisit (a (j + 1)) (h (j + 1)) (η (j + 1)) β x z *
      ghostPhaseEdge (a (j + 1)) (a j) (h (j + 1)) (h j) β z y
  let f := fun x : GhostPhaseState R =>
    ∑ y, ghostPhaseVisit (a 0) (h 0) (η 0) β x y * ghostPhaseInitial (a 0) β y
  let c := fun j => if a (j + 1) && !(a j) then V⁻¹ else 1
  let d := if a 0 then V⁻¹ else 1
  have hK : (fun j (x y : GhostPhaseState R) =>
      ∑ z, ghostPhaseVisit (a (j + 1)) (h (j + 1)) (η (j + 1)) β x z *
        ghostPhaseRunEdge (a (j + 1)) (a j) (h (j + 1)) (h j) β V z y) =
      (fun j x y => c j * K j x y) := by
    funext j x y
    simp only [ghostPhaseRunEdge, K, c, mul_sum]
    apply sum_congr rfl
    intro z _
    ring
  have hf : (fun x : GhostPhaseState R =>
      ∑ y, ghostPhaseVisit (a 0) (h 0) (η 0) β x y * ghostPhaseRunInitial (a 0) β V y) =
      (fun x => d * f x) := by
    funext x
    simp only [ghostPhaseRunInitial, d, f, mul_sum]
    apply sum_congr rfl
    intro y _
    ring
  have hc (j : ℕ) : c j * (V⁻¹) ^ ghostPhaseRunCount a j =
      (V⁻¹) ^ ghostPhaseRunCount a (j + 1) := by
    simp only [ghostPhaseRunCount, pow_add, c]
    cases a (j + 1) <;> cases a j <;> simp [mul_comm]
  have haction (m : ℕ) (x : GhostPhaseState R) :
      finitePathAction (fun j x y => c j * K j x y) (fun x => d * f x) m x =
        (V⁻¹) ^ ghostPhaseRunCount a m * finitePathAction K f m x := by
    induction m generalizing x with
    | zero =>
      simp only [finitePathAction, ghostPhaseRunCount, d]
      cases a 0 <;> simp
    | succ m ih =>
      simp only [finitePathAction, ih]
      calc
        _ = (c m * (V⁻¹) ^ ghostPhaseRunCount a m) *
            (∑ y, K m x y * finitePathAction K f m y) := by
          rw [mul_sum]
          apply sum_congr rfl
          intro y _
          ring
        _ = _ := by rw [hc]
  unfold ghostPhaseRunHistory
  rw [hK, hf]
  simp_rw [haction]
  change (∑ x, ghostPhaseTerminal (a n) x *
      ((V⁻¹) ^ ghostPhaseRunCount a n * finitePathAction K f n x)) =
    (V⁻¹) ^ ghostPhaseRunCount a n *
      (∑ x, ghostPhaseTerminal (a n) x * finitePathAction K f n x)
  rw [mul_sum]
  apply sum_congr rfl
  intro x _
  ring

/- Restoring the baseline gives the original residue expectation with
the required `V^(-number of active runs)` mark normalization. -/
theorem ghost_phase_run_history_residue_identity {R : Type*}
    [Fintype R] [DecidableEq R] [Nonempty R]
    (a : ℕ → Bool) (h : ℕ → R) (η : ℕ → ℝ) (V : ℝ) (n : ℕ) (b : ℝ)
    (hb : b = 1 - (∑ j ∈ range (n + 1), η j) / Fintype.card R)
    (hb0 : b ≠ 0) :
    b * ghostPhaseRunHistory a h η ((Fintype.card R : ℝ) * b)⁻¹ V n =
      (V⁻¹) ^ ghostPhaseRunCount a n *
        ((∑ r : R, activeResidueWeight (range (n + 1))
          ((range (n + 1)).filter (fun j => a j = true)) h η r) / Fintype.card R) := by
  rw [ghost_phase_run_history_eq, ← mul_assoc, mul_comm b, mul_assoc]
  rw [ghost_phase_history_residue_identity a h η n b hb hb0]
end

