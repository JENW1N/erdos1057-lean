section

/- Original common-window harmonic pairings from rational local energy and minor bounds. -/

open Finset MeasureTheory
open scoped Classical ComplexConjugate
namespace Bounty

theorem harmonic_cell_aux_local_energy_decay
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1/(p : ℝ) = V g)
    (hA : ∀ a, ‖bA a‖ ≤ 1) (hB : ∀ b, ‖bB b‖ ≤ 1)
    (Z a b v : ℝ) (F₀ G₀ : ℤ → ℂ) {L q K HA HB Y E D : ℝ}
    (hk : k ≠ 0) (hL : 5 ≤ L) (hq : 0 ≤ q) (hK : 0 ≤ K)
    (hkB : (k.natAbs : ℝ) ≤ L^K) (hHA : 0 < HA) (hHB : 0 < HB)
    (hY : 0 < Y) (hscale : L^q ≤ HA*HB)
    (hf : (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellSource Y Z a v F₀ n‖^2) ≤ Y*L^E)
    (hg : (∑ n ∈ harmonicCommonSupport Y, ‖harmonicCellTarget Y b G₀ n‖^2) ≤ Y*L^E)
    (hminor : ∀ θ, θ ∉ productMajorArcSet k L q HA HB →
      ‖physicalAuxFourierMultiplier P V A B hU hAB k bA bB θ‖ ≤ L^(-(D+E+1)))
    (hlocal : ∀ (r : ℕ), 0 < r → (r : ℝ) ≤ L^(K+q) → ∀ u : ℤ,
      (∫ x in Set.Icc
        ((u : ℝ)/r-1/(|(k : ℝ)| *(HA*HB)/L^q))
        ((u : ℝ)/r+1/(|(k : ℝ)| *(HA*HB)/L^q)),
        ‖finiteFourierSum (harmonicCommonSupport Y) (harmonicCellSource Y Z a v F₀) x‖^2) ≤ Y*L^(-((2*D+E+2)+2*q+K+1))) :
    ‖∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
      (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ)*
        bA (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
        bB (repeatedBigAuxSplitEquiv P A B hU hAB aux).2 *
        harmonicCellPairing Y Z a b v
          (k*(∏ g, ∏ j : repeatedBigAuxCut A B g, (aux g j).val : ℕ)) F₀ G₀‖ ≤ Y*L^(-D) := by
  simp_rw [harmonic_cell_pairing_eq_masked_sum hY]
  exact physical_aux_shift_local_energy_decay P V A B hU hAB k bA bB hV hMass hA hB
    (harmonicCommonSupport Y) (harmonicCommonSupport Y)
    (harmonicCellSource Y Z a v F₀) (harmonicCellTarget Y b G₀)
    hk hL hq hK hkB hHA hHB hY.le hscale hf hg hminor hlocal

end Bounty
