    let : MeasurableSpace E := instMeasurableSpaceEL2CompactnessTranslationIntegral (E := E)
    OpensMeasurableSpace E := by
  let : MeasurableSpace E := instMeasurableSpaceEL2CompactnessTranslationIntegral (E := E)
  let : BorelSpace E := instBorelSpaceEL2CompactnessTranslationIntegral (E := E)
  infer_instance
