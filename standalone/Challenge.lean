/- Retained normalized four-factor boxes have uniform polynomial shifted energy. -/

open Finset Filter MeasureTheory

namespace Bounty

theorem eventually_harmonic_four_box_shifted_mean_square {c E : ℝ} (hc : 0 ≤ c) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, 1 ≤ Y → Real.log Y ≤ c*L →
      ∀ (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ) (D₀ A₀ B₀ C₀ : ℝ),
      0 ≤ D₀ → 0 ≤ A₀ → 0 ≤ B₀ → 0 ≤ C₀ → D₀*A₀*B₀*C₀ ≤ L^E →
      (∀ d ∈ D, 0 < d) → (∀ a ∈ A, 0 < a) →
      (∀ b ∈ B, 0 < b) → (∀ z ∈ C, 0 < z) →
      (∀ d ∈ D, ‖δ d‖ ≤ D₀) → (∀ a ∈ A, ‖α a‖ ≤ A₀) →
      (∀ b ∈ B, ‖β b‖ ≤ B₀) → (∀ z ∈ C, ‖γ z‖ ≤ C₀) →
      (∀ d ∈ D, ∀ a ∈ A, ∀ b ∈ B, ∀ z ∈ C,
        Y/128 ≤ ((d*a*b*z : ℕ) : ℝ) ∧
          ((d*a*b*z : ℕ) : ℝ) ≤ 64*Real.exp 2*Y) →
      ∀ T v : ℝ, 0 ≤ T → T ≤ L*Y →
        (∫ t in Set.Icc (-T) T,
          ‖(∑ d ∈ D, δ d * harmonicMellinWeight (t + v) d) *
            (∑ a ∈ A, α a * harmonicMellinWeight (t + v) a) *
            (∑ b ∈ B, β b * harmonicMellinWeight (t + v) b) *
            (∑ z ∈ C, γ z * harmonicMellinWeight (t + v) z)‖ ^ 2) ≤ L^(2*E+17) := by
  filter_upwards [eventually_harmonic_box_mean_square_scalar (E := E) hc] with L hL
  intro Y hY hlogY D A B C δ α β γ D₀ A₀ B₀ C₀
    hD₀ hA₀ hB₀ hC₀ hprod hD hA hB hC hδ hα hβ hγ hgeom T v hT hTY
  let N := ⌈64*Real.exp 2*Y⌉₊
  have hY0 : 0 < Y := zero_lt_one.trans_le hY
  have hb := harmonic_four_box_shifted_mean_square D A B C δ α β γ
    hD₀ hA₀ hB₀ hC₀ (show 0 < Y/128 by positivity) hD hA hB hC
    hδ hα hβ hγ N (by
      intro d hd a ha b hb z hz
      have hp := hgeom d hd a ha b hb z hz
      refine ⟨hp.1, ?_⟩
      exact_mod_cast hp.2.trans (Nat.le_ceil (64*Real.exp 2*Y))) T v hT
  exact hb.trans (hL Y T (D₀*A₀*B₀*C₀) hY hlogY hT hTY (by positivity) hprod)

end Bounty
