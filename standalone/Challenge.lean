    physicalFullHistoryPhase (fun i => C (f i)) (fun i => k (f i))
      (fun i => ω (f i)) β ρ W steps x p := by
  have h := full_permutation_key_ledger_phase (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i _ => PhysicalAuxLabels P (C i))
      (fun i => physicalFullEdgeDelta (C i) (k i)) (fun i => physicalFullEdgeD (C i)) f
    (fullMixedLedgerUpdate (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i _ => PhysicalAuxLabels P (C i))
      (fun i => physicalFullEdgeDelta (C i) (k i)) (fun i => physicalFullEdgeD (C i)))
    (fun tag L x e => physicalFullLedgerEventPhase C k ω β ρ W tag (L, x) e)
    steps (fullActiveInitialLedger x) x p
  have hu : (fun (tag : Option (V ⊕ H)) (L : ∀ g, Finset (P g))
      (x : PhysicalFullBoundedState P J ell B)
      (e : FullPermutationMixedEvent (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C (f i) g)) B
      (fun i _ => PhysicalAuxLabels P (C (f i)))
      (fun i => physicalFullEdgeDelta (C (f i)) (k (f i))) (fun i => physicalFullEdgeD (C (f i))) tag x) =>
      fullMixedLedgerUpdate (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i _ => PhysicalAuxLabels P (C i))
      (fun i => physicalFullEdgeDelta (C i) (k i)) (fun i => physicalFullEdgeD (C i)) (tag.map (Sum.map id f)) L x
        (fullPermutationKeyEventEquiv (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i _ => PhysicalAuxLabels P (C i))
      (fun i => physicalFullEdgeDelta (C i) (k i)) (fun i => physicalFullEdgeD (C i)) f tag x e)) =
    fullMixedLedgerUpdate (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C (f i) g)) B
      (fun i _ => PhysicalAuxLabels P (C (f i)))
      (fun i => physicalFullEdgeDelta (C (f i)) (k (f i))) (fun i => physicalFullEdgeD (C (f i))) := by
    funext tag L x e
    exact (by
      cases tag with
      | none => rfl
      | some tag => cases tag <;> rfl
    )
  have hp : (fun (tag : Option (V ⊕ H)) (L : ∀ g, Finset (P g))
      (x : PhysicalFullBoundedState P J ell B)
      (e : FullPermutationMixedEvent (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C (f i) g)) B
      (fun i _ => PhysicalAuxLabels P (C (f i)))
      (fun i => physicalFullEdgeDelta (C (f i)) (k (f i))) (fun i => physicalFullEdgeD (C (f i))) tag x) =>
      physicalFullLedgerEventPhase C k ω β ρ W (tag.map (Sum.map id f)) (L, x)
        (fullPermutationKeyEventEquiv (fun g (p : P g) => p.val)
      (fun i g => physicalFullSharedIndices (ell := ell) (C i g)) B
      (fun i _ => PhysicalAuxLabels P (C i))
      (fun i => physicalFullEdgeDelta (C i) (k i)) (fun i => physicalFullEdgeD (C i)) f tag x e)) =
    (fun tag L x e => physicalFullLedgerEventPhase (fun i => C (f i)) (fun i => k (f i))
      (fun i => ω (f i)) β ρ W tag (L, x) e) := by
    funext tag L x e
