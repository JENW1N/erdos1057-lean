/- A forest compatible with an injective initial prefix has no selected child in that prefix. -/

namespace Bounty

theorem birth_forest_no_child_in_injective_prefix {m : ℕ} {α : Type*}
    (code : BirthForestCode m) (performed initial : Fin m → Prop) (label : Fin m → α)
    (hdown : ∀ i j, i < j → initial j → initial i)
    (hinj : Set.InjOn label {i | initial i})
    (hcompat : birthForestCompatible performed label code) :
    ∀ j, initial j → code j = none := by
  intro j hj
  cases hc : code j with
  | none => rfl
  | some i =>
    have h := hcompat j
    rw [hc] at h
    have hlt : birthForestParentEmbedding j i < j := i.isLt
    have he := hinj (hdown _ _ hlt hj) hj h.2.2
    exact False.elim ((ne_of_lt hlt) he)

theorem birth_forest_initial_stage_trivial {m L : ℕ} {α : Type*}
    (owner : Fin m → Fin (L + 1)) (code : BirthForestCode m)
    (hcode : ∀ i, owner i = 0 → code i = none) (values : Fin m → Option α) :
    birthForestStageCondition owner 0 values code := by
  intro i hi
  rw [hcode i hi]
  trivial

end Bounty
end

