open Finset
/- A coordinate has left the unborn state. -/
def ghostPhaseBorn {R : Type*} (z : GhostPhaseState R) : Prop := z ≠ some none

/- All coordinates with active, pending, or completed phase tags. -/
noncomputable def ghostPhaseBornSupport {P : Type*} [Fintype P] {R : P → Type*}
    (z : (p : P) → GhostPhaseState (R p)) : Finset P := by
  classical
  exact univ.filter (fun p => ghostPhaseBorn (z p))

theorem ghost_phase_mem_born_support {P : Type*} [Fintype P] {R : P → Type*}
    (z : (p : P) → GhostPhaseState (R p)) (p : P) :
    p ∈ ghostPhaseBornSupport z ↔ z p ≠ some none := by
  classical
  unfold ghostPhaseBornSupport
  exact mem_filter.trans (and_iff_right (mem_univ p))










/- Every pending particle has already left the unborn state. -/
theorem ghost_phase_pending_subset_born {P : Type*} [Fintype P] {R : P → Type*}
    (z : (p : P) → GhostPhaseState (R p)) :
    ghostPhasePendingSupport z ⊆ ghostPhaseBornSupport z := by
  classical
  intro p hp
  obtain ⟨r, hr⟩ : ∃ r, z p = some (some (some r)) := by
    simpa only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and] using hp
  rw [ghost_phase_mem_born_support, hr]
  simp
end

