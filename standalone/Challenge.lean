theorem global_birth_joint_phase_row_eq
    {a b : (g : Fin N) → P g → Bool}
    (step : (g : Fin N) → GlobalBirthRawStep (R := R g) (a g) (b g))
    (cap : Nat) (F : GlobalBirthJointPhase R → ℂ) (w : GlobalBirthJointPhase R) :
    globalBirthJointPhaseRow step cap F w = ∑ z, globalBirthJointKernel step cap z w * F z := by
  classical
  unfold globalBirthJointPhaseRow
  have hrow : (fun g => globalBirthRawStepPhaseRow (step g)) =
      (fun g G v => ∑ z, globalBirthRawStepKernel (step g) z v * G z) := by
    funext g G v
    exact global_birth_raw_step_phase_row_eq (step g) G v
  rw [hrow, fin_tensor_row_kernel]
  apply sum_congr rfl
  intro z _
  unfold globalBirthJointPhaseCutoff globalBirthJointKernel
  split_ifs <;> simp




