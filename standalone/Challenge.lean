theorem rowTwist_eq_fixed_times_good_row_primary
    (Ψ:ActualEisensteinCubic.O→*ℂ) (m f z:ActualEisensteinCubic.O) (hmLam:lambda∣m) (hm2:(2:ActualEisensteinCubic.O)∣m)
    (um:ActualEisensteinCubic.Oˣ) (am bm:ℕ) (g:ActualEisensteinCubic.O) (hg:Supported (Ideal.span {g}))
    (hm:m=um.val*lambda^am*(2:ActualEisensteinCubic.O)^bm*g)
    (u:ActualEisensteinCubic.Oˣ) (a b:ℕ) (r:ActualEisensteinCubic.O) (hr:Supported (Ideal.span {r}))
    (hpr:lambda^2∣r-1) (hx:f^4*z=u.val*lambda^a*(2:ActualEisensteinCubic.O)^b*r)
