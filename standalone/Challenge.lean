    rw [show ψ s x = star (boundedPrimitiveValue s ((∏ j, (x j).val : ℕ) : ZMod (boundedPrimitiveModulus s))) from rfl, norm_star]
    exact prime_tuple_character_norm_one P (boundedPrimitiveValue s)
