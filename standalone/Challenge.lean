theorem floor_interval_length_le {a b : ℝ} (hb : 0 ≤ b) :
    (⌊b⌋₊ : ℝ) - ⌊a⌋₊ ≤ b - a + 1 := by
  have ha' := Nat.lt_floor_add_one a
  have hb' := Nat.floor_le hb
  linarith

theorem real_interval_rough_overcount (lam : ℕ → ℝ) {z K : ℝ} {h : ℕ}
    (hz : 1 ≤ z) (hK : 0 ≤ K)
    (hover : ∀ a b : ℕ, a ≤ b →
      let M := (∑ n ∈ Ioc a b, ∑ d ∈ n.divisors, lam d) -
        (((Ioc a b).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ))).card : ℝ)
      0 ≤ M ∧ M ≤ ((b : ℝ) - a) * K * Real.exp (-(h : ℝ)) + z^(4 * (h : ℝ) + 2))
    {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) :
    let M := (∑ n ∈ Ioc ⌊a⌋₊ ⌊b⌋₊, ∑ d ∈ n.divisors, lam d) -
      ((roughBand a b z).card : ℝ)
    0 ≤ M ∧ M ≤ (K + 1) * ((b - a) * Real.exp (-(h : ℝ)) + z^(4 * (h : ℝ) + 2)) := by
  have hh := hover ⌊a⌋₊ ⌊b⌋₊ (Nat.floor_mono hab)
  change 0 ≤ _ ∧ _ ≤ _ at hh
  have hset : roughBand a b z =
      (Ioc ⌊a⌋₊ ⌊b⌋₊).filter (fun n : ℕ => ∀ p ∈ n.primeFactors, z < (p : ℝ)) := by
    rfl
  dsimp only
  rw [hset]
  refine ⟨hh.1, hh.2.trans ?_⟩
  have he0 := (Real.exp_pos (-(h : ℝ))).le
  have he1 : Real.exp (-(h : ℝ)) ≤ 1 := Real.exp_le_one_iff.mpr (neg_nonpos.mpr (Nat.cast_nonneg h))
  have hD : 1 ≤ z^(4 * (h : ℝ) + 2) := Real.one_le_rpow hz (by positivity)
  have hlen := floor_interval_length_le (a := a) (ha.trans hab)
  have hlen' := mul_le_mul_of_nonneg_right hlen (mul_nonneg hK he0)
  have hKD := mul_le_mul_of_nonneg_left (he1.trans hD) hK
  have hterm := mul_nonneg (sub_nonneg.mpr hab) he0
  nlinarith
end

