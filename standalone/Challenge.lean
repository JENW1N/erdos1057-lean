    (fun z:ℂ=>kernelSourceProjection cubicEisensteinResidue
      (integralOrbitProjection globalKubotaKernel (cuspCoordinateLift (v,z))))
    =ᵐ[volume.restrict periodDomain] (fun z=>sourceBesselFunction (cuspCoordinateLift (v,z))) :=
  letI rootPolicy_hyperbolicMeasurableSpace := @OAI.CubicEisenstein.hyperbolicMeasurableSpace
