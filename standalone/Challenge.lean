section

/- Exact cumulative ledger unions along the existing finite dependent paths. -/

open Finset
namespace Bounty

section Paths
variable {K X Q : Type*} [DecidableEq Q]
    (E : K → X → Type*) (target : ∀ k x, E k x → X)
    (ledger : X → Finset Q) (birth : ∀ k x, E k x → Finset Q)

noncomputable def finiteEventPathPriorBirths (steps : List K) (x : X)
    (p : FiniteEventPath E target steps x) (cut : ℕ) : Finset Q :=
  Finset.univ.biUnion fun i : Fin steps.length =>
    if i.val < cut then
      let e := finiteEventPathOccurrence E target steps x p i
      birth (steps.get i) e.1 e.2
    else ∅

theorem mem_finite_event_path_prior_births (steps : List K) (x : X)
    (p : FiniteEventPath E target steps x) (cut : ℕ) (q : Q) :
    q ∈ finiteEventPathPriorBirths E target birth steps x p cut ↔
      ∃ i : Fin steps.length, i.val < cut ∧
        q ∈ birth (steps.get i)
          (finiteEventPathOccurrence E target steps x p i).1
          (finiteEventPathOccurrence E target steps x p i).2 := by
  classical
  simp only [finiteEventPathPriorBirths, mem_biUnion, mem_univ, true_and]
  apply exists_congr
  intro i
  split_ifs <;> simp_all

theorem finite_event_path_ledger_mem_before (steps : List K) (x : X)
    (p : FiniteEventPath E target steps x)
    (hstep : ∀ i : Fin steps.length,
      let e := finiteEventPathOccurrence E target steps x p i
      ledger (target (steps.get i) e.1 e.2) = ledger e.1 ∪ birth (steps.get i) e.1 e.2)
    (i : Fin steps.length) (q : Q) :
    q ∈ ledger (finiteEventPathOccurrence E target steps x p i).1 ↔
      q ∈ ledger x ∨ ∃ j : Fin steps.length, j.val < i.val ∧
        q ∈ birth (steps.get j)
          (finiteEventPathOccurrence E target steps x p j).1
          (finiteEventPathOccurrence E target steps x p j).2 := by
  induction steps generalizing x with
  | nil => exact Fin.elim0 i
  | cons k steps ih =>
    rcases p with ⟨e, p⟩
    refine Fin.cases ?_ (fun j => ?_) i
    · change q ∈ ledger x ↔ _
      simp only [Fin.val_zero, not_lt_zero, false_and, exists_false, or_false]
    · have hs : ∀ r : Fin steps.length,
          let e' := finiteEventPathOccurrence E target steps (target k x e) p r
          ledger (target (steps.get r) e'.1 e'.2) =
            ledger e'.1 ∪ birth (steps.get r) e'.1 e'.2 := fun r => hstep r.succ
      have h0 : ledger (target k x e) = ledger x ∪ birth k x e := hstep 0
      change q ∈ ledger (finiteEventPathOccurrence E target steps (target k x e) p j).1 ↔ _
      rw [ih _ p hs j, h0, mem_union]
      constructor
      · rintro ((hx | hb) | ⟨r, hr, hb⟩)
        · exact Or.inl hx
        · exact Or.inr ⟨0, Nat.zero_lt_succ _, hb⟩
        · exact Or.inr ⟨r.succ, Nat.succ_lt_succ hr, hb⟩
      · rintro (hx | ⟨r, hr, hb⟩)
        · exact Or.inl (Or.inl hx)
        · revert hr hb
          refine Fin.cases ?_ (fun r => ?_) r
          · intro _ hb
            exact Or.inl (Or.inr hb)
          · intro hr hb
            exact Or.inr ⟨r, Nat.lt_of_succ_lt_succ hr, hb⟩

theorem finite_event_path_ledger_union_before (steps : List K) (x : X)
    (p : FiniteEventPath E target steps x)
    (hstep : ∀ i : Fin steps.length,
      let e := finiteEventPathOccurrence E target steps x p i
      ledger (target (steps.get i) e.1 e.2) = ledger e.1 ∪ birth (steps.get i) e.1 e.2)
    (i : Fin steps.length) :
    ledger (finiteEventPathOccurrence E target steps x p i).1 =
      ledger x ∪ finiteEventPathPriorBirths E target birth steps x p i.val := by
  ext q
  rw [mem_union, mem_finite_event_path_prior_births]
  exact finite_event_path_ledger_mem_before E target ledger birth steps x p hstep i q

end Paths
end Bounty
end

section

/- Active labels and pending particles remain covered by the deterministic ledger. -/

open Finset
open scoped Classical
namespace Bounty

def BoundedResidueLedgerCovers {P : Type*} (n : P → ℕ) {t B : ℕ}
    (H : Finset P) (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B) : Prop :=
  (∀ i, s.1 i ∈ H) ∧ ∀ i, (s.2.2 i).1 ∈ H

theorem retained_birth_tuple_all {Z : Type*} {N b : ℕ} (Q : Z → Prop)
    (old : Fin N → Z) (retained : Finset (Fin N)) (fresh : Fin b → Z)
    (hold : ∀ i, Q (old i)) (hfresh : ∀ i, Q (fresh i)) :
    ∀ i, Q ((retainedBirthTuple old retained fresh).2 i) := by
  dsimp only [retainedBirthTuple]
  intro i
  refine Fin.addCases ?_ ?_ i
  · intro j
    rw [Fin.addCases_left]
    exact hold (retained.equivFin.symm j).val
  · intro j
    rw [Fin.addCases_right]
    exact hfresh j

theorem unrestricted_residue_output_labels_mem {P : Type*} {N t : ℕ}
    (n : P → ℕ) (H : Finset P) (source : Fin t → P)
    (old : Fin N → UnrestrictedResidueParticle n) (Δ : ℤ)
    (stores promotions : Finset (Fin t)) {eligible : Finset (Fin N)}
    (e : promotions ↪ ↥eligible)
    (hsource : ∀ i, source i ∈ H) (hold : ∀ i, (old i).1 ∈ H) :
    ∀ i, ((unrestrictedEdgeOutput source old (unrestrictedResidueSeed n)
      (unrestrictedResidueTransport n Δ) stores promotions e).2 i).1 ∈ H := by
  apply retained_birth_tuple_all (fun z : UnrestrictedResidueParticle n => z.1 ∈ H)
  · intro i
    exact hold i
  · intro i
    exact hsource (stores.equivFin.symm i).val

theorem bounded_ghost_ledger_target_covers {P : Type*} [DecidableEq P]
    (n : P → ℕ) (t B : ℕ) (H : Finset P)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : BoundedGhostEvent t B s) (hs : BoundedResidueLedgerCovers n H s) :
    BoundedResidueLedgerCovers n (boundedGhostLedgerTarget n t B (H, s) e).1
      (boundedGhostLedgerTarget n t B (H, s) e).2 := by
  change BoundedResidueLedgerCovers n (H ∪ univ.image (fun j => (e.2.2 j).1))
    (boundedGhostEventTarget t B s e)
  unfold boundedGhostEventTarget
  dsimp only
  split_ifs
  · constructor
    · intro i
      exact mem_union_left _ (hs.1 i)
    · apply retained_birth_tuple_all (fun z : UnrestrictedResidueParticle n =>
        z.1 ∈ H ∪ univ.image (fun j => (e.2.2 j).1))
      · intro i
        exact mem_union_left _ (hs.2 i)
      · intro i
        exact mem_union_right _ (mem_image_of_mem _ (mem_univ i))
  · constructor
    · intro i
      exact mem_union_left _ (hs.1 i)
    · intro i
      exact mem_union_left _ (hs.2 i)

theorem bounded_edge_ledger_target_covers {P : Type*} [DecidableEq P]
    (n : P → ℕ) (Δ D : ℤ) (t B : ℕ) (H : Finset P)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s) (hs : BoundedResidueLedgerCovers n H s) :
    BoundedResidueLedgerCovers n
      (H ∪ univ.image (unrestrictedBoundedEventTarget n Δ D t B s e).1)
      (unrestrictedBoundedEventTarget n Δ D t B s e) := by
  unfold unrestrictedBoundedEventTarget
  dsimp only
  split_ifs
  · constructor
    · intro i
      exact mem_union_right _ (mem_image_of_mem _ (mem_univ i))
    · intro i
      apply mem_union_left
      exact unrestricted_residue_output_labels_mem n H s.1 s.2.2 Δ e.1 e.2.1 e.2.2.1
        hs.1 hs.2 i
  · constructor
    · intro i
      exact mem_union_left _ (hs.1 i)
    · intro i
      exact mem_union_left _ (hs.2 i)

end Bounty
end

section

/- A nonzero original path coefficient has nonzero coefficient at every occurrence. -/

namespace Bounty

theorem finite_event_path_occurrence_weight_ne_zero {K X : Type*}
    (E : K → X → Type*) (target : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (steps : List K) (x : X) (p : FiniteEventPath E target steps x)
    (hp : finiteEventPathWeight E target w steps x p ≠ 0) (i : Fin steps.length) :
    w (steps.get i) (finiteEventPathOccurrence E target steps x p i).1
      (finiteEventPathOccurrence E target steps x p i).2 ≠ 0 := by
  induction steps generalizing x with
  | nil => exact Fin.elim0 i
  | cons k steps ih =>
    rcases p with ⟨e, p⟩
    have h : w k x e ≠ 0 ∧ finiteEventPathWeight E target w steps (target k x e) p ≠ 0 :=
      mul_ne_zero_iff.mp hp
    refine Fin.cases ?_ (fun j => ?_) i
    · exact h.1
    · exact ih (target k x e) p h.2 j

end Bounty
end

section

/- The exact endpoint baseline gives a positive tilted law of mass at most two. -/

open Finset
namespace Bounty

section Law
variable {G : Type*} {P : G → Finset ℕ} (V : G → ℝ) (q : ℝ) (edges : ℕ)

theorem physical_endpoint_beta_law (g : G) (p : P g) :
    ((p.val : ℝ) * physicalEndpointBaseline q edges p.val)⁻¹ / V g =
      tiltedPhysicalBirthLaw V g (fun p => physicalEndpointBaseline q edges p.val) p := by
  unfold tiltedPhysicalBirthLaw physicalLabelLaw
  simp only [div_eq_mul_inv, mul_inv_rev]
  ring

theorem physical_endpoint_beta_pos (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (g : G)
    (hV : 0 < V g) (p : P g) (hp : 0 < p.val) (hsize : 2 * (edges + 1) ≤ p.val) :
    0 < ((p.val : ℝ) * physicalEndpointBaseline q edges p.val)⁻¹ / V g := by
  exact div_pos (inv_pos.mpr (mul_pos (by exact_mod_cast hp)
    (physical_endpoint_baseline_pos hq0 hq1 edges p.val hp hsize))) hV

theorem physical_endpoint_beta_mass_bounds (hq0 : 0 ≤ q) (hq1 : q ≤ 1) (g : G)
    (hV : 0 < V g) (hMass : ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (hp : ∀ p : P g, 0 < p.val) (hsize : ∀ p : P g, 2 * (edges + 1) ≤ p.val) :
    1 ≤ ∑ p : P g, ((p.val : ℝ) * physicalEndpointBaseline q edges p.val)⁻¹ / V g ∧
    (∑ p : P g, ((p.val : ℝ) * physicalEndpointBaseline q edges p.val)⁻¹ / V g) ≤ 2 := by
  simp_rw [physical_endpoint_beta_law]
  exact tiltedPhysicalBirthLaw_sum_bounds V g _ hV hMass
    (fun p => physical_endpoint_baseline_bounds hq0 hq1 edges p.val (hp p) (hsize p))

end Law

end Bounty
end

section

/- Fixed probe-size choices for the positive-block local estimate. The probe
size is selected before the accuracy and active-slot parameters. -/

open Filter

namespace Bounty

/- Any positive logarithmic block density permits a fixed probe size with
an arbitrarily large power saving, provided the tail length is positive. -/
theorem exists_repeated_big_probe_parameter (ell : ℕ) (hell : 1 ≤ ell)
    {beta E : ℝ} (hbeta : 0 < beta) (hE : 0 ≤ E) :
    ∃ m : ℕ, ell ≤ m ∧ 0 < (ell : ℝ) ^ ell / (m : ℝ) ^ ell ∧
      (ell : ℝ) ^ ell / (m : ℝ) ^ ell ≤ 1 ∧
      beta * Real.log ((ell : ℝ) ^ ell / (m : ℝ) ^ ell) / 2 ≤ -(E + 1) := by
  let delta := Real.exp (-(2 * (E + 1) / beta))
  have hd0 : 0 < delta := Real.exp_pos _
  have hd1 : delta ≤ 1 := Real.exp_le_one_iff.mpr (by apply neg_nonpos.mpr; positivity)
  obtain ⟨m, hm⟩ := exists_nat_gt ((ell : ℝ) / delta)
  have he1 : (1 : ℝ) ≤ ell := by exact_mod_cast hell
  have he0 : (0 : ℝ) < ell := lt_of_lt_of_le zero_lt_one he1
  have hem : (ell : ℝ) ≤ m := by
    apply le_trans _ hm.le
    exact (le_div_iff₀ hd0).mpr (by nlinarith)
  have hm0 : (0 : ℝ) < m := he0.trans_le hem
  have hr0 : 0 < (ell : ℝ) / m := div_pos he0 hm0
  have hr1 : (ell : ℝ) / m ≤ delta := by
    apply (div_le_iff₀ hm0).mpr
    have hh := (div_lt_iff₀ hd0).mp hm
    nlinarith
  have hr2 : (ell : ℝ) / m ≤ 1 := hr1.trans hd1
  have hlog : Real.log ((ell : ℝ) / m) ≤ -(2 * (E + 1) / beta) := by
    have hh := Real.log_le_log hr0 hr1
    simpa only [delta, Real.log_exp] using hh
  have hlog0 : Real.log ((ell : ℝ) / m) ≤ 0 := Real.log_nonpos hr0.le hr2
  refine ⟨m, by exact_mod_cast hem, by positivity, ?_, ?_⟩
  · rw [← div_pow]
    exact pow_le_one₀ hr0.le hr2
  · rw [← div_pow, Real.log_pow]
    have hh : (ell : ℝ) * Real.log ((ell : ℝ) / m) ≤
        Real.log ((ell : ℝ) / m) := by nlinarith
    have hb := mul_le_mul_of_nonneg_left (hh.trans hlog) hbeta.le
    have heq : beta * (-(2 * (E + 1) / beta)) = -2 * (E + 1) := by
      field_simp
    rw [heq] at hb
    linarith

/- The density deficit is at most one per visit. In particular the manuscript
path length `2 * ceil (L ^ (13/25))` gives a density loss at most `L` eventually. -/
theorem eventually_repeated_big_visit_density_le {alpha tau : ℝ}
    (htau : 0 < tau) (hgap : alpha < tau) :
    ∀ᶠ L : ℝ in atTop, ∀ T : ℝ,
      T ≤ 2 * (⌈L ^ alpha⌉₊ : ℝ) + 1 → T ≤ L ^ tau := by
  filter_upwards [eventually_mul_rpow_add_le_mul_rpow htau hgap
    (show (0 : ℝ) < 1 by norm_num) 2 3, eventually_gt_atTop (0 : ℝ)] with L h hL
  intro T hT
  have hceil := Nat.ceil_lt_add_one (Real.rpow_nonneg hL.le alpha)
  nlinarith

end Bounty
end

section

/- Full active-slot averaging is exactly the existing repeated-list
projection in every ordered memory fiber. No memory labels are averaged
away or conditioned out by this identity. -/

open Finset
open scoped Classical

namespace Bounty

def cleanFullSlotPermutationEquiv {G : Type*} (J ell : ℕ) :
    PhysicalPermutations G J ell ≃ FullActiveSlotPermutations (fun _ : G => J + ell) :=
  Equiv.piCongrRight (fun _ => Equiv.permCongr finSumFinEquiv)

theorem clean_full_memory_permutation {G : Type*}
    {P : G → Finset ℕ} {J ell B : ℕ}
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p)
    (σ : PhysicalPermutations G J ell) :
    fullActivePermutation (cleanFullSlotPermutationEquiv J ell σ)
        (cleanFullMemoryState N p source r) =
      cleanFullMemoryState N p (repeatedBigPermutationEquiv σ source) r := by
  funext g
  apply Prod.ext
  · funext j
    simp only [fullActivePermutation, Equiv.coe_fn_mk, cleanFullMemoryState,
      Function.comp_apply, cleanFullSlotPermutationEquiv, Equiv.piCongrRight_apply, Pi.map,
      Equiv.permCongr_apply, Equiv.symm_apply_apply, repeatedBigPermutationEquiv]
  · rfl

theorem clean_full_memory_active_average {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell B : ℕ}
    (N : G → Fin (B + 1)) (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
    (f : CleanFullMemoryState P J ell B → ℂ)
    (source : RepeatedBigLists P J ell) (r : FixedOrderedResidues p) :
    fullActiveAverage f (cleanFullMemoryState N p source r) =
      repeatedBigSymmetrizeLinear (fun target => f (cleanFullMemoryState N p target r)) source := by
  have hs := (cleanFullSlotPermutationEquiv (G := G) J ell).sum_comp
    (fun τ => (fullActivePermutationWeight (fun _ : G => J + ell) τ : ℂ) *
      f (fullActivePermutation τ (cleanFullMemoryState N p source r)))
  unfold fullActiveAverage
  rw [← hs]
  simp only [clean_full_memory_permutation, fullActivePermutationWeight,
    Complex.ofReal_inv, Complex.ofReal_natCast]
  rw [← mul_sum]
  change _ = (Fintype.card (PhysicalPermutations G J ell) : ℂ)⁻¹ * _
  rw [Fintype.card_congr (cleanFullSlotPermutationEquiv (G := G) J ell)]

end Bounty
end

section

/- Exact separation of the full Q-list into retained and omitted bands. -/

open Finset

namespace Bounty

noncomputable def candidateMacroQIndices (c L : ℝ) (J : ℕ) : Finset ℕ :=
  (candidateQIndices c L).filter (fun j => j < J)

noncomputable def candidateQIndexSplit (c L : ℝ) (J : ℕ) :
    (candidateMicroQIndices c L J) ⊕ (candidateMacroQIndices c L J) ≃ candidateQIndices c L := by
  unfold candidateMicroQIndices candidateMacroQIndices
  apply Equiv.ofBijective
    (Sum.elim (fun j => ⟨j.val, (mem_filter.mp j.property).1⟩)
      (fun j => ⟨j.val, (mem_filter.mp j.property).1⟩))
  constructor
  · intro a b hab
    have hv := congrArg Subtype.val hab
    cases a with
    | inl a =>
      cases b with
      | inl b => exact congrArg Sum.inl (Subtype.ext hv)
      | inr b =>
        have ha := (mem_filter.mp a.property).2
        have hb := (mem_filter.mp b.property).2
        change a.val = b.val at hv
        omega
    | inr a =>
      cases b with
      | inl b =>
        have ha := (mem_filter.mp a.property).2
        have hb := (mem_filter.mp b.property).2
        change a.val = b.val at hv
        omega
      | inr b => exact congrArg Sum.inr (Subtype.ext hv)
  · intro j
    by_cases h : J ≤ j.val
    · exact ⟨Sum.inl ⟨j.val, mem_filter.mpr ⟨j.property, h⟩⟩, rfl⟩
    · exact ⟨Sum.inr ⟨j.val, mem_filter.mpr ⟨j.property, Nat.lt_of_not_ge h⟩⟩, rfl⟩

noncomputable def candidateQSlotSplit (c L : ℝ) (r J : ℕ) :
    ((candidateMicroQIndices c L J) × Fin r) ⊕ ((candidateMacroQIndices c L J) × Fin r) ≃
      (candidateQIndices c L) × Fin r :=
  (Equiv.sumProdDistrib _ _ _).symm.trans
    (Equiv.prodCongr (candidateQIndexSplit c L J) (Equiv.refl _))

theorem candidate_Q_choices_split (c L : ℝ) (r jStar J : ℕ) (hJ : J ≤ jStar) :
    (fun i => candidateQSlotChoices c L r jStar (candidateQSlotSplit c L r J i)) =
      Sum.elim (candidateMicroQSlotChoices c L r jStar J)
        (fun i : (candidateMacroQIndices c L J) × Fin r => candidateQBand (c*L) i.1.val) := by
  funext i
  cases i with
  | inl i => rfl
  | inr i =>
    have hlt := (mem_filter.mp i.1.property).2
    have hne : i.1.val ≠ jStar := by omega
    change (if i.1.val = jStar ∧ i.2.val = 0 then _ else _) = _
    rw [if_neg (fun h => hne h.1)]
    rfl

theorem candidate_Q_normalization_split (c L : ℝ) (r J : ℕ) :
    (r.factorial : ℝ)^(candidateQIndices c L).card =
      (r.factorial : ℝ)^(candidateMicroQIndices c L J).card *
        (r.factorial : ℝ)^(candidateMacroQIndices c L J).card := by
  have hcard := Fintype.card_congr (candidateQIndexSplit c L J)
  simp only [Fintype.card_sum, Fintype.card_coe] at hcard
  rw [← pow_add, hcard]




end Bounty
end

section

/- Dropping a normalized product fiber while retaining forced conditions. -/

open Finset

namespace Bounty

theorem ordered_slot_left_product_sum {I : Type*} [Fintype I] [DecidableEq I]
    (B : I → Finset ℕ) (α β : ℝ) {d : ℕ} (hd : 0 < d) (n : ℕ) :
    (∑ y : ∀ i, B i, if d * orderedSlotProduct B y = n then 1/(α*β) else 0) =
      if d ∣ n then (1/α) * orderedSlotWeight B β (n/d) else 0 := by
  classical
  by_cases hdn : d ∣ n
  · rw [if_pos hdn, orderedSlotWeight, mul_sum]
    apply sum_congr (by ext; simp)
    intro y _
    have hi : d * orderedSlotProduct B y = n ↔ orderedSlotProduct B y = n/d := by
      constructor
      · intro h
        rw [← h, Nat.mul_div_cancel_left _ hd]
      · intro h
        rw [h, Nat.mul_div_cancel' hdn]
    by_cases h : d * orderedSlotProduct B y = n
    · rw [if_pos h, if_pos (hi.mp h), one_div_mul_one_div]
    · rw [if_neg h, if_neg (fun he => h (hi.mpr he)), mul_zero]
  · rw [if_neg hdn]
    apply sum_eq_zero
    intro y _
    exact if_neg (fun h => hdn ⟨orderedSlotProduct B y, h.symm⟩)

theorem ordered_slot_split_majorant {I J : Type*} [Fintype I] [Fintype J]
    [DecidableEq I] [DecidableEq J] (A : I → Finset ℕ) (B : J → Finset ℕ)
    {α β : ℝ} (hα : 0 ≤ α) (hA : ∀ x : ∀ i, A i, 0 < orderedSlotProduct A x)
    (hB : ∀ n, orderedSlotWeight B β n ≤ 1) (n : ℕ)
    (R : (∀ i, A i) → Prop) [DecidablePred R]
    (hR : ∀ x y, orderedSlotProduct A x * orderedSlotProduct B y = n → R x) :
    orderedSlotWeight (Sum.elim A B) (α*β) n ≤
      ∑ x : ∀ i, A i, if orderedSlotProduct A x ∣ n ∧ R x then 1/α else 0 := by
  classical
  rw [ordered_slot_weight_sum_split]
  apply sum_le_sum
  intro x _
  by_cases hx : orderedSlotProduct A x ∣ n ∧ R x
  · rw [if_pos hx, ordered_slot_left_product_sum B α β (hA x), if_pos hx.1]
    exact (mul_le_mul_of_nonneg_left (hB _) (by positivity)).trans_eq (mul_one _)
  · rw [if_neg hx]
    apply le_of_eq
    apply sum_eq_zero
    intro y _
    apply if_neg
    intro h
    exact hx ⟨⟨orderedSlotProduct B y, h.symm⟩, hR x y h⟩

end Bounty
end

section

/- Distinct chosen marks leave exactly the unmarked prime-divisor exponent. -/

open Finset

namespace Bounty

noncomputable def chosenMarkSet {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (x : ∀ g, P g) : Finset ℕ := univ.image (fun g => (x g).val)

noncomputable def unmarkedDivisorSet {G : Type*} [Fintype G] (P : G → Finset ℕ)
    (x : ∀ g, P g) (u : ℕ) : Finset ℕ :=
  ((univ.biUnion P).filter (fun p => p ∣ u)) \ chosenMarkSet P x

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  (P : G → Finset ℕ)
  (hdisj : Pairwise (fun g h => Disjoint (P g) (P h)))
  (x : ∀ g, P g)

include G sharedInstance1 P hdisj x

theorem chosen_mark_injective  :
    Function.Injective (fun g => (x g).val) := by
  intro g h heq
  change (x g).val = (x h).val at heq
  by_contra hne
  exact disjoint_left.mp (hdisj hne) (x g).property (by rw [heq]; exact (x h).property)

theorem chosen_mark_card  :
    (chosenMarkSet P x).card = Fintype.card G := by
  rw [chosenMarkSet, card_image_of_injective _ (chosen_mark_injective P hdisj x), card_univ]

theorem unmarked_divisor_card 
    (u : ℕ) (hx : ∀ g, (x g).val ∣ u) :
    (unmarkedDivisorSet P x u).card = ∑ g, (((P g).filter (fun p => p ∣ u)).card - 1) := by
  classical
  have hsub : chosenMarkSet P x ⊆ (univ.biUnion P).filter (fun p => p ∣ u) := by
    intro p hp
    obtain ⟨g, _, rfl⟩ := mem_image.mp hp
    exact mem_filter.mpr ⟨mem_biUnion.mpr ⟨g, mem_univ _, (x g).property⟩, hx g⟩
  have hcard : ((univ.biUnion P).filter (fun p => p ∣ u)).card =
      ∑ g, ((P g).filter (fun p => p ∣ u)).card := by
    rw [filter_biUnion]
    apply card_biUnion
    intro g _ h _ hne
    exact (hdisj hne).mono (filter_subset _ _) (filter_subset _ _)
  rw [unmarkedDivisorSet, card_sdiff_of_subset hsub, hcard, chosen_mark_card P hdisj x]
  have hone : ∀ g ∈ (univ : Finset G), 1 ≤ ((P g).filter (fun p => p ∣ u)).card := by
    intro g _
    exact card_pos.mpr ⟨(x g).val, mem_filter.mpr ⟨(x g).property, hx g⟩⟩
  rw [sum_tsub_distrib univ hone]
  simp only [sum_const, card_univ, smul_eq_mul, mul_one]

theorem one_mark_choice_product 
    (q : ℝ) (V : G → ℝ) (u : ℕ) :
    (∏ g, if (x g).val ∣ u then q^(((P g).filter (fun p => p ∣ u)).card - 1)/V g else 0) =
      if ∀ g, (x g).val ∣ u then q^(unmarkedDivisorSet P x u).card / (∏ g, V g) else 0 := by
  classical
  by_cases hx : ∀ g, (x g).val ∣ u
  · rw [if_pos hx]
    simp_rw [if_pos (hx _)]
    rw [prod_div_distrib, prod_pow_eq_pow_sum, unmarked_divisor_card P hdisj x u hx]
  · rw [if_neg hx]
    obtain ⟨g, hg⟩ := not_forall.mp hx
    exact prod_eq_zero (mem_univ g) (if_neg hg)

end


theorem one_marked_weight_unmarked_sum {G : Type*} [DecidableEq G] (groups : Finset G)
    (P : G → Finset ℕ) (q : ℝ) (V : G → ℝ)
    (hdisj : Pairwise (fun g h : groups => Disjoint (P g.val) (P h.val))) (u : ℕ) :
    markedDivisorWeight groups P q V (fun _ => 1) (u : ℤ) =
      ∑ x : ∀ g : groups, P g.val,
        if ∀ g, (x g).val ∣ u then
          q^(unmarkedDivisorSet (fun g : groups => P g.val) x u).card / (∏ g ∈ groups, V g)
        else 0 := by
  classical
  rw [one_marked_weight_choice_sum]
  apply sum_congr (by ext; simp)
  intro x _
  have hOmega (g : G) : physicalOmega P g (u : ℤ) = ((P g).filter (fun p => p ∣ u)).card := by
    simp only [physicalOmega, physicalDivisorPool, Int.natCast_dvd_natCast]
  simp_rw [hOmega, Int.natCast_dvd_natCast]
  rw [one_mark_choice_product (fun g : groups => P g.val) hdisj x q (fun g => V g.val) u]
  rw [prod_coe_sort groups V]

end Bounty
end

section

/- The actual ghost birth factor selects one residue per prime and retains its V factor. -/

open Finset Classical

namespace Bounty

noncomputable def physicalGhostBirthAtom {P : Type*} (n : P → ℕ)
    (μ : P → ℝ) (q ρ V : ℝ) (z : UnrestrictedResidueParticle n) : ℝ :=
  |physicalGhostBirth n q ρ V z| * unrestrictedResidueWeight μ z

theorem physical_ghost_birth_atom_nonneg {P : Type*} (n : P → ℕ)
    (μ : P → ℝ) (q ρ V : ℝ) (hμ : ∀ p, 0 ≤ μ p)
    (z : UnrestrictedResidueParticle n) : 0 ≤ physicalGhostBirthAtom n μ q ρ V z :=
  mul_nonneg (abs_nonneg _) (hμ z.1)

theorem physical_ghost_birth_atom_residue_sum {P : Type*} (n : P → ℕ)
    [∀ p, NeZero (n p)] (μ : P → ℝ) (q ρ V : ℝ) (p : P) :
    (∑ r : ZMod (n p), physicalGhostBirthAtom n μ q ρ V ⟨p, r⟩) =
      |(1 - q) * V / ρ| * μ p := by
  rw [sum_eq_single (0 : ZMod (n p))]
  · simp [physicalGhostBirthAtom, physicalGhostBirth, unrestrictedResidueHit,
      unrestrictedResidueWeight]
  · intro r _ hr
    simp [physicalGhostBirthAtom, physicalGhostBirth, unrestrictedResidueHit, hr]
  · simp

theorem physical_ghost_birth_atom_prime_sum {P : Type*} [Fintype P] [DecidableEq P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (q ρ V : ℝ) (p : P) :
    (∑ z : UnrestrictedResidueParticle n, if z.1 = p then
      physicalGhostBirthAtom n μ q ρ V z else 0) = |(1 - q) * V / ρ| * μ p := by
  rw [Fintype.sum_sigma, sum_eq_single p]
  · simp only [ite_true]
    exact physical_ghost_birth_atom_residue_sum n μ q ρ V p
  · intro a _ ha
    simp only [ha, if_false, sum_const_zero]
  · simp

theorem physical_ghost_birth_atom_total {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ) (q ρ V : ℝ) :
    (∑ z : UnrestrictedResidueParticle n, physicalGhostBirthAtom n μ q ρ V z) =
      |(1 - q) * V / ρ| * ∑ p, μ p := by
  rw [Fintype.sum_sigma]
  simp_rw [physical_ghost_birth_atom_residue_sum]
  exact (mul_sum _ _ _).symm

theorem physical_ghost_birth_atom_tagged_sum {G : Type*} {P : G → Type*}
    (g : G) [Fintype (P g)] (n : P g → ℕ) [∀ p, NeZero (n p)]
    (μ : P g → ℝ) (q ρ V : ℝ) (p : P g) :
    (∑ z : UnrestrictedResidueParticle n, if (⟨g, z.1⟩ : Sigma P) = ⟨g, p⟩ then
      physicalGhostBirthAtom n μ q ρ V z else 0) = |(1 - q) * V / ρ| * μ p := by
  simpa only [Sigma.mk.inj_iff, heq_eq_eq, true_and] using
    physical_ghost_birth_atom_prime_sum n μ q ρ V p




end Bounty
end

section

/- The physical edge retains its exact admissibility mask after ledger separation. -/

open scoped Classical
namespace Bounty
section Physical
variable {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin N → Finset (Fin J)) (k : ℤ) (L R : PhysicalMarkLists P J ell)
  (H : (g : Fin N) → Finset ↥(P g))
  (q : (g : Fin N) → BoundedOrderedTuple
    (UnrestrictedResidueParticle (fun p : ↥(P g) => p.val)) B)
  (e : PhysicalFullEdgeEvent C k (physicalFullMemoryState C L q))

theorem physical_full_edge_phase_avoidance_factor :
    physicalFullEdgePhase C k L R H q e =
      (if ∀ g i, (e.2 g).2.2.2 i ∉ H g then 1 else 0) *
        physicalFullEdgePhase C k L R (fun _ => ∅) q e := by
  unfold physicalFullEdgePhase
  by_cases h : physicalListAdmissible C e.1 L R
  · rw [if_pos h, if_pos h]
    exact full_edge_ledger_phase_factor _ _ _ _ _ _ _ _ _ _
  · rw [if_neg h, if_neg h, mul_zero]

theorem physical_full_edge_phase_fresh_injective
    (hphase : physicalFullEdgePhase C k L R H q e ≠ 0) (g : Fin N) :
    Function.Injective (e.2 g).2.2.2 := by
  have ha : physicalListAdmissible C e.1 L R := by
    by_contra h
    exact hphase (by simp only [physicalFullEdgePhase, if_neg h])
  have hp := hphase
  rw [physicalFullEdgePhase, if_pos ha] at hp
  apply full_edge_ledger_phase_fresh_injective _ _ _ _ _ _ _ _ _ _ hp
  intro h
  rw [physical_full_split_state_eq]
  exact Function.Embedding.injective _

theorem physical_full_edge_phase_birth_factor :
    physicalFullEdgePhase C k L R H q e =
      (if (∀ g i, (e.2 g).2.2.2 i ∉ H g) ∧
          (∀ g, Function.Injective (e.2 g).2.2.2) then 1 else 0) *
        physicalFullEdgePhase C k L R (fun _ => ∅) q e := by
  rw [physical_full_edge_phase_avoidance_factor C k L R H q e]
  by_cases hz : physicalFullEdgePhase C k L R (fun _ => ∅) q e = 0
  · simp only [hz, mul_zero]
  · have hd := physical_full_edge_phase_fresh_injective C k L R (fun _ => ∅) q e hz
    simp only [hd, forall_true_iff, and_true]

end Physical
end Bounty
end

section

/- A run-normalized phase history depends only on visits through its final index. -/

open Finset
namespace Bounty

theorem ghost_phase_run_history_congr {R : Type*} [Fintype R] [DecidableEq R]
    (a a' : ℕ → Bool) (h h' : ℕ → R) (η η' : ℕ → ℝ) (β V : ℝ) (n : ℕ)
    (ha : ∀ j ≤ n, a j = a' j) (hh : ∀ j ≤ n, h j = h' j)
    (hη : ∀ j ≤ n, η j = η' j) :
    ghostPhaseRunHistory a h η β V n = ghostPhaseRunHistory a' h' η' β V n := by
  unfold ghostPhaseRunHistory
  rw [ha n le_rfl]
  apply sum_congr rfl
  intro x hx
  congr 1
  apply finite_path_action_prefix_congr
  · intro j hj u v
    simp only [ha j (by omega), ha (j + 1) (by omega), hh j (by omega),
      hh (j + 1) (by omega), hη (j + 1) (by omega)]
  · intro u
    simp only [ha 0 (by omega), hh 0 (by omega), hη 0 (by omega)]

end Bounty
end

section

/- Canonical full-slot coordinates for a clean pattern. The full active tuple
uses `finSumFinEquiv`, and its reduced slots enumerate exactly the repeated
fresh-label coordinates. Pending labels and residues are unchanged. -/

open Finset
open scoped Classical

namespace Bounty

def cleanFullSharedSlots {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) : Finset (Fin (J + ell)) :=
  (physicalSharedSlots (ell := ell) (C g)).map finSumFinEquiv.toEmbedding

theorem cleanFullSharedSlots_mem {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) (s : PhysicalSlots J ell) :
    finSumFinEquiv s ∈ cleanFullSharedSlots C g ↔ ¬ repeatedBigUnshared C g s := by
  cases s <;> simp [cleanFullSharedSlots, physicalSharedSlots, repeatedBigUnshared]







def cleanFullUnsharedSlotEquiv {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) :
    ↥((cleanFullSharedSlots (ell := ell) C g)ᶜ) ≃
      {s : PhysicalSlots J ell // repeatedBigUnshared C g s} where
  toFun i := ⟨finSumFinEquiv.symm i.val, by
    have hi : i.val ∉ cleanFullSharedSlots C g := mem_compl.mp i.property
    have hh := cleanFullSharedSlots_mem C g (finSumFinEquiv.symm i.val)
    rw [Equiv.apply_symm_apply] at hh
    exact not_not.mp (mt hh.mpr hi)⟩
  invFun s := ⟨finSumFinEquiv s.val, mem_compl.mpr (by
    rw [cleanFullSharedSlots_mem]
    exact not_not.mpr s.property)⟩
  left_inv i := Subtype.ext (Equiv.apply_symm_apply finSumFinEquiv i.val)
  right_inv s := Subtype.ext (Equiv.symm_apply_apply finSumFinEquiv s.val)

noncomputable def cleanFullUnsharedIndex {G : Type*} {J ell : ℕ}
    (C : G → Finset (Fin J)) (g : G) :
    Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card ≃
      {s : PhysicalSlots J ell // repeatedBigUnshared C g s} :=
  (cleanFullSharedSlots C g)ᶜ.equivFin.symm.trans (cleanFullUnsharedSlotEquiv C g)

noncomputable def cleanFullFreshEquiv {G : Type*} (P : G → Finset ℕ) {J ell : ℕ}
    (C : G → Finset (Fin J)) :
    (∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g) ≃
      RepeatedBigFresh P C ell :=
  Equiv.piCongrRight (fun g => Equiv.arrowCongr (cleanFullUnsharedIndex C g) (Equiv.refl (P g)))

theorem cleanFullFreshEquiv_apply_index {G : Type*} (P : G → Finset ℕ) {J ell : ℕ}
    (C : G → Finset (Fin J))
    (fresh : ∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g)
    (g : G) (i : Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card) :
    cleanFullFreshEquiv P C fresh g (cleanFullUnsharedIndex C g i) = fresh g i := by
  change fresh g ((cleanFullUnsharedIndex C g).symm (cleanFullUnsharedIndex C g i)) = _
  rw [Equiv.symm_apply_apply]

theorem cleanFullFreshEquiv_weight {G : Type*} [Fintype G] (P : G → Finset ℕ)
    {J ell : ℕ} (C : G → Finset (Fin J)) (μ : ∀ g, P g → ℝ)
    (fresh : ∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g) :
    (∏ g, ∏ s, μ g (cleanFullFreshEquiv P C fresh g s)) =
      ∏ g, ∏ i, μ g (fresh g i) := by
  apply prod_congr rfl
  intro g _
  exact Equiv.prod_comp (cleanFullUnsharedIndex C g).symm (fun i => μ g (fresh g i))

section

variable
  {G : Type*}
  {P : G → Finset ℕ}
  {J ell B : ℕ}
  (C : G → Finset (Fin J))
  (N : G → Fin (B + 1))
  (p : FixedOrderedMemoryLabels P (fun g => (N g).val))
  (source : RepeatedBigLists P J ell)
  (r : FixedOrderedResidues p)
  (fresh : ∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g)

include G P J ell B C N p source r fresh

/- Split a filled target using the exact source shared coordinates. -/
theorem cleanFullMemoryState_split_fill  :
    productActiveMemorySplit (cleanFullSharedSlots C) B
        (cleanFullMemoryState N p (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) r) =
      ((productActiveMemorySplit (cleanFullSharedSlots C) B
        (cleanFullMemoryState N p source r)).1,
       fun g => (fresh g, ⟨N g, fun j => ⟨p g j, r g j⟩⟩)) := by
  apply Prod.ext
  · funext g i
    change repeatedBigFill C source (cleanFullFreshEquiv P C fresh) g
      (finSumFinEquiv.symm (((cleanFullSharedSlots C g).equivFin.symm i).val)) = _
    have hs := ((cleanFullSharedSlots (ell := ell) C g).equivFin.symm i).property
    have hh := cleanFullSharedSlots_mem C g
      (finSumFinEquiv.symm (((cleanFullSharedSlots C g).equivFin.symm i).val))
    rw [Equiv.apply_symm_apply] at hh
    simp only [repeatedBigFill, dif_neg (hh.mp hs)]
    rfl
  · funext g
    apply Prod.ext
    · funext i
      change repeatedBigFill C source (cleanFullFreshEquiv P C fresh) g
        (cleanFullUnsharedIndex C g i).val = fresh g i
      rw [repeated_big_fill_unshared, cleanFullFreshEquiv_apply_index]
    · rfl

/- Reassemble a reduced target while preserving every pending occurrence. -/
theorem cleanFullMemoryState_reassemble_fill  :
    (productActiveMemorySplit (cleanFullSharedSlots C) B).symm
      ((productActiveMemorySplit (cleanFullSharedSlots C) B
        (cleanFullMemoryState N p source r)).1,
       fun g => (fresh g, ⟨N g, fun j => ⟨p g j, r g j⟩⟩)) =
      cleanFullMemoryState N p (repeatedBigFill C source (cleanFullFreshEquiv P C fresh)) r := by
  rw [← cleanFullMemoryState_split_fill C N p source r fresh, Equiv.symm_apply_apply]

end


/- The reduced fresh integration has exactly the physical fresh mass. -/
theorem clean_full_fresh_weighted_sum {G : Type*} [Fintype G] [DecidableEq G]
    {P : G → Finset ℕ} {J ell : ℕ} (V : G → ℝ) (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (F : RepeatedBigFresh P C ell → ℂ) :
    (∑ fresh : ∀ g, Fin (cleanFullSharedSlots (ell := ell) C g)ᶜ.card → P g,
      ((∏ g, ∏ i, tiltedPhysicalBirthLaw V g (b g) (fresh g i) : ℝ) : ℂ) *
        F (cleanFullFreshEquiv P C fresh)) =
      ∑ fresh : RepeatedBigFresh P C ell, (repeatedBigFreshMass V b C fresh : ℂ) * F fresh := by
  have h := (cleanFullFreshEquiv P C).sum_comp
    (fun fresh => (repeatedBigFreshMass V b C fresh : ℂ) * F fresh)
  simpa only [repeatedBigFreshMass, cleanFullFreshEquiv_weight] using h

end Bounty
end

section

/- Clean events preserve the literal total-memory size. The joint cutoff
therefore reduces to its source test, without changing the event weight. -/

open Finset
open scoped Classical

namespace Bounty

theorem unrestricted_bounded_clean_event_length {P : Type*}
    (n : P → ℕ) (Δ D : ℤ) (t B : ℕ)
    (s : BoundedOrderedState P (UnrestrictedResidueParticle n) t B)
    (e : UnrestrictedBoundedEvent n Δ D t B s)
    (he : e.1 = ∅ ∧ e.2.1 = ∅) :
    (unrestrictedBoundedEventTarget n Δ D t B s e).2.1.val = s.2.1.val := by
  rcases e with ⟨stores, promotions, select, fresh⟩
  rcases he with ⟨hs, hp⟩
  dsimp only at hs hp
  subst stores
  subst promotions
  have hs := unrestricted_clean_promotion_unique (unrestrictedResidueEligible n Δ D s.2.2) select
  subst select
  have hlen := unrestricted_clean_output_length s.1 s.2.2 (unrestrictedResidueSeed n)
    (unrestrictedResidueTransport n Δ) (unrestrictedResidueEligible n Δ D s.2.2)
  have hb : (unrestrictedEdgeOutput s.1 s.2.2 (unrestrictedResidueSeed n)
      (unrestrictedResidueTransport n Δ) ∅ ∅
      (unrestrictedCleanPromotion t (unrestrictedResidueEligible n Δ D s.2.2))).1 ≤ B := by
    rw [hlen]
    exact Nat.le_of_lt_succ s.2.1.isLt
  unfold unrestrictedBoundedEventTarget
  rw [dif_pos hb]
  exact hlen

theorem unrestricted_joint_clean_event_total_memory {G : Type*} [Fintype G]
    {P : G → Type*} (n : ∀ g, P g → ℕ) (Δ D : G → ℤ) (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (e : UnrestrictedJointEvent n Δ D t B s)
    (he : ∀ g, (e g).1 = ∅ ∧ (e g).2.1 = ∅) :
    productTotalMemory (unrestrictedJointEventTarget n Δ D t B s e) =
      productTotalMemory s := by
  apply sum_congr rfl
  intro g hg
  exact unrestricted_bounded_clean_event_length (n g) (Δ g) (D g) (t g) B (s g) (e g) (he g)

theorem unrestricted_joint_clean_event_weight {G : Type*} [Fintype G]
    {P : G → Type*} (n : ∀ g, P g → ℕ) (Δ D : G → ℤ)
    (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ) (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) t B)
    (e : UnrestrictedJointEvent n Δ D t B s)
    (he : ∀ g, (e g).1 = ∅ ∧ (e g).2.1 = ∅) :
    unrestrictedJointCutoffEventWeight n Δ D μ ρ V t B s e =
      if productTotalMemory s ≤ B then
        ∏ g, unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (μ g) ρ (V g) (t g) B (s g) (e g)
      else 0 := by
  unfold unrestrictedJointCutoffEventWeight
  rw [unrestricted_joint_clean_event_total_memory n Δ D t B s e he]
  simp only [and_self]




end Bounty
end

section

/- Products of original local phases retain their full event-path dependence. -/

open Finset
open scoped Classical
namespace Bounty
section Paths
variable {K X : Type*} (E : K → X → Type*) (target : ∀ k x, E k x → X)

theorem finite_event_local_phase_occurrences (phase : ∀ k x, E k x → ℂ)
    (steps : List K) (x : X) (p : FiniteEventPath E target steps x) :
    finiteEventLocalPhase E target phase steps x p =
      ∏ i : Fin steps.length, phase (steps.get i)
        (finiteEventPathOccurrence E target steps x p i).1
        (finiteEventPathOccurrence E target steps x p i).2 := by
  induction steps generalizing x with
  | nil => simp only [finiteEventLocalPhase, List.length_nil, Fin.prod_univ_zero]
  | cons k steps ih =>
    calc
      _ = phase k x p.1 * finiteEventLocalPhase E target phase steps (target k x p.1) p.2 := rfl
      _ = phase k x p.1 * ∏ i : Fin steps.length, phase (steps.get i)
          (finiteEventPathOccurrence E target steps (target k x p.1) p.2 i).1
          (finiteEventPathOccurrence E target steps (target k x p.1) p.2 i).2 :=
        congrArg (phase k x p.1 * ·) (ih (target k x p.1) p.2)
      _ = _ := (Fin.prod_univ_succ (fun i : Fin (steps.length + 1) =>
        phase ((k :: steps).get i) (finiteEventPathOccurrence E target (k :: steps) x p i).1
          (finiteEventPathOccurrence E target (k :: steps) x p i).2)).symm

theorem finite_event_local_phase_indicator_factor
    (phase residual : ∀ k x, E k x → ℂ) (condition : ∀ k x, E k x → Prop)
    (hphase : ∀ k x e, phase k x e = (if condition k x e then 1 else 0) * residual k x e)
    (steps : List K) (x : X) (p : FiniteEventPath E target steps x) :
    finiteEventLocalPhase E target phase steps x p =
      (if ∀ i : Fin steps.length, condition (steps.get i)
        (finiteEventPathOccurrence E target steps x p i).1
        (finiteEventPathOccurrence E target steps x p i).2 then 1 else 0) *
      finiteEventLocalPhase E target residual steps x p := by
  rw [finite_event_local_phase_occurrences, finite_event_local_phase_occurrences]
  simp_rw [hphase]
  rw [prod_mul_distrib]
  congr 1
  by_cases h : ∀ i : Fin steps.length, condition (steps.get i)
      (finiteEventPathOccurrence E target steps x p i).1
      (finiteEventPathOccurrence E target steps x p i).2
  · rw [if_pos h]
    calc
      _ = ∏ _i : Fin steps.length, (1 : ℂ) := prod_congr rfl (fun i _ => if_pos (h i))
      _ = 1 := prod_const_one
  · rw [if_neg h]
    obtain ⟨i, hi⟩ := not_forall.mp h
    exact prod_eq_zero (mem_univ i) (if_neg hi)

end Paths

theorem complex_indicator_and_of_iff (C A D : Prop)
    (dC : Decidable C) (dA : Decidable A) (dD : Decidable D) (h : C ↔ A ∧ D) :
    @ite ℂ C dC 1 0 = @ite ℂ A dA 1 0 * @ite ℂ D dD 1 0 := by
  let : Decidable C := dC
  let : Decidable A := dA
  let : Decidable D := dD
  by_cases hc : C
  · rcases h.mp hc with ⟨ha, hd⟩
    simp only [if_pos hc, if_pos ha, if_pos hd, one_mul]
  · by_cases ha : A
    · have hd : ¬ D := fun hd => hc (h.mpr ⟨ha, hd⟩)
      simp only [if_neg hc, if_pos ha, if_neg hd, mul_zero]
    · simp only [if_neg hc, if_neg ha, zero_mul]

section Ledger
variable {K L X : Type*} (E : K → X → Type*) (target : ∀ k x, E k x → X)
  (update : ∀ k, L → (x : X) → E k x → L)

theorem finite_ledger_event_local_phase (phase : ∀ k x, E k x → ℂ)
    (steps : List K) (l : L) (x : X)
    (p : FiniteEventPath (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) steps (l, x)) :
    finiteEventLocalPhase (fun k (s : L × X) => E k s.2)
      (finiteLedgerEventTarget E target update) (fun k s => phase k s.2) steps (l, x) p =
      finiteEventLocalPhase E target phase steps x (finiteLedgerEventPathEquiv E target update steps l x p) := by
  induction steps generalizing l x with
  | nil => rfl
  | cons k steps ih =>
    rcases p with ⟨e, p⟩
    exact congrArg (phase k x e * ·) (ih (update k l x e) (target k x e) p)

end Ledger
end Bounty
