section

/- Exact prime convolution of the candidate coefficient with its normalized Q-zero remainder. -/

open Finset Filter

namespace Bounty

theorem candidate_Q_zero_prime_outside_pool {c L : ℝ} (hcL : 0 ≤ c * L)
    {p : ℕ} (hp : p ∈ candidateQBand (c * L) 0) :
    p.Prime ∧ p ∉ (candidatePIndices c L).biUnion (candidatePBand (c * L)) := by
  refine ⟨((mem_dyadicPrimeBand_iff (c * L) 1 (6/5) 0 p).mp hp).1, ?_⟩
  intro hP
  obtain ⟨j, _, hpj⟩ := mem_biUnion.mp hP
  exact disjoint_left.mp (disjoint_candidatePBand_candidateQBand hcL j 0) hpj hp

theorem candidate_marked_weight_div_Q_zero {c L : ℝ} (hcL : 0 ≤ c * L)
    (q : ℝ) {p u : ℕ} (hp : p ∈ candidateQBand (c * L) 0) (hpu : p ∣ u) :
    markedDivisorWeight (candidatePIndices c L) (candidatePBand (c * L)) q
      (fun j => ∑ a ∈ candidatePBand (c * L) j, 1 / (a : ℝ)) (fun _ => 1) ((u / p : ℕ) : ℤ) =
    markedDivisorWeight (candidatePIndices c L) (candidatePBand (c * L)) q
      (fun j => ∑ a ∈ candidatePBand (c * L) j, 1 / (a : ℝ)) (fun _ => 1) (u : ℤ) := by
  obtain ⟨hpp, hpP⟩ := candidate_Q_zero_prime_outside_pool hcL hp
  have hfree : Disjoint p.primeFactors
      ((candidatePIndices c L).biUnion (candidatePBand (c * L))) := by
    simpa only [hpp.primeFactors, disjoint_singleton_left] using hpP
  have h := candidate_marked_weight_mul_of_free c L q hpp.ne_zero hfree (u / p)
  rw [Nat.div_mul_cancel hpu] at h
  exact h.symm

theorem candidate_coefficient_remainder_convolution {c L : ℝ} (hcL : 0 ≤ c * L)
    (q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : 0 < jStar)
    {u : ℕ} (hu : u ≠ 0) :
    candidateCoefficient c L q r jStar u =
      ∑ p ∈ (candidateQBand (c * L) 0).filter (fun p => p ∣ u),
        candidateRemainderCoefficient c L q r jStar hr (u / p) := by
  classical
  unfold candidateCoefficient
  rw [candidate_Q_weight_rest_divisor_split c L r jStar hr hj, sum_mul, sum_filter]
  apply sum_congr rfl
  intro p hp
  obtain ⟨hpp, hpP⟩ := candidate_Q_zero_prime_outside_pool hcL hp
  have hdiv := @prime_dvd_primePoolFreePart_iff
    ((candidatePIndices c L).biUnion (candidatePBand (c * L))) p u hpp hpP
  by_cases hpu : p ∣ u
  · rw [if_pos (hdiv.mpr hpu), if_pos hpu]
    unfold candidateRemainderCoefficient
    rw [primePoolFreePart_div_prime_of_not_mem hpp hpP hu hpu,
      candidate_marked_weight_div_Q_zero hcL q hp hpu]
  · rw [if_neg (fun h => hpu (hdiv.mp h)), if_neg hpu, zero_mul]

theorem candidate_Q_rest_weight_zero_at_zero (c L : ℝ) (r jStar : ℕ) (hr : 0 < r) :
    candidateQRestWeight c L r jStar hr 0 = 0 := by
  classical
  unfold candidateQRestWeight orderedSlotWeight
  apply sum_eq_zero
  intro x _
  apply if_neg
  change (∏ slot, (x slot).val) ≠ 0
  apply prod_ne_zero_iff.mpr
  intro slot _
  exact candidate_Q_slot_nonzero c L r jStar slot.val (x slot).property

theorem candidate_remainder_coefficient_zero_at_zero (c L q : ℝ)
    (r jStar : ℕ) (hr : 0 < r) :
    candidateRemainderCoefficient c L q r jStar hr 0 = 0 := by
  unfold candidateRemainderCoefficient primePoolFreePart
  rw [Nat.zero_div, candidate_Q_rest_weight_zero_at_zero, zero_mul]

theorem candidate_coefficient_remainder_convolution_all {c L : ℝ} (hcL : 0 ≤ c * L)
    (q : ℝ) (r jStar : ℕ) (hr : 0 < r) (hj : 0 < jStar) (u : ℕ) :
    candidateCoefficient c L q r jStar u =
      ∑ p ∈ (candidateQBand (c * L) 0).filter (fun p => p ∣ u),
        candidateRemainderCoefficient c L q r jStar hr (u / p) := by
  by_cases hu : u = 0
  · subst u
    have hz : candidateCoefficient c L q r jStar 0 = 0 := by
      unfold candidateCoefficient primePoolFreePart
      rw [Nat.zero_div, candidate_Q_weight_zero_at_zero, zero_mul]
    rw [hz]
    symm
    exact sum_eq_zero (fun p _ => by
      rw [Nat.zero_div, candidate_remainder_coefficient_zero_at_zero])
  · exact candidate_coefficient_remainder_convolution hcL q r jStar hr hj hu




end Bounty
end

section

/- Fixed distribution levels below one half absorb subexponential coefficient losses. -/

open Filter

namespace Bounty

section

variable
  {a eta theta K C : ℝ}
  (ha : 0 < a)
  (heta : 0 < eta)
  (htheta : theta < 1 / 2)
  (hK : 0 ≤ K)
  (hC : 0 ≤ C)
  (D B : ℝ)

include a eta theta K C ha heta htheta hK hC D B

theorem eventually_large_sieve_profile_decay  :
    ∀ᶠ L : ℝ in atTop,
      (L ^ D * Real.exp (K * Real.sqrt L)) *
        (C * Real.exp ((1 - eta) * L) +
          2 * C * Real.exp ((1 - a / 2) * L) +
            Real.sqrt C * Real.exp ((theta + 1 / 2) * L)) ≤
        Real.exp L * L ^ (-B) := by
  have h1 := eventually_exp_neg_rpow_mul_rpow_mul_exp_sqrt_le
    (by norm_num : (1/2 : ℝ) < 1) heta hK D (B + 1)
  have h2 := eventually_exp_neg_rpow_mul_rpow_mul_exp_sqrt_le
    (by norm_num : (1/2 : ℝ) < 1) (half_pos ha) hK D (B + 1)
  have h3 := eventually_exp_neg_rpow_mul_rpow_mul_exp_sqrt_le
    (by norm_num : (1/2 : ℝ) < 1) (sub_pos.mpr htheta) hK D (B + 1)
  filter_upwards [h1, h2, h3, eventually_ge_atTop (3 * C + Real.sqrt C),
    eventually_gt_atTop (0 : ℝ)] with L h1 h2 h3 hCL hL
  simp only [Real.rpow_one] at h1 h2 h3
  have he (d : ℝ) : Real.exp ((1 - d) * L) = Real.exp L * Real.exp (-d * L) := by
    rw [← Real.exp_add]
    congr 1
    ring
  have hsum := add_le_add
    (add_le_add (mul_le_mul_of_nonneg_left h1 hC)
      (mul_le_mul_of_nonneg_left h2 (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) hC)))
    (mul_le_mul_of_nonneg_left h3 (Real.sqrt_nonneg C))
  have hcoeff : (3 * C + Real.sqrt C) * L ^ (-(B + 1)) ≤ L ^ (-B) := by
    calc
      _ ≤ L * L ^ (-(B + 1)) :=
        mul_le_mul_of_nonneg_right hCL (Real.rpow_nonneg hL.le _)
      _ = _ := by
        nth_rw 1 [← Real.rpow_one L]
        rw [← Real.rpow_add hL]
        congr 1
        ring
  calc
    _ = Real.exp L *
        (C * ((Real.exp (-eta * L) * L ^ D) * Real.exp (K * Real.sqrt L)) +
          (2 * C) * ((Real.exp (-(a / 2) * L) * L ^ D) * Real.exp (K * Real.sqrt L)) +
          Real.sqrt C * ((Real.exp (-(1 / 2 - theta) * L) * L ^ D) *
            Real.exp (K * Real.sqrt L))) := by
      rw [he eta, he (a / 2), show theta + 1 / 2 = 1 - (1 / 2 - theta) by ring,
        he (1 / 2 - theta)]
      ring
    _ ≤ Real.exp L * ((3 * C + Real.sqrt C) * L ^ (-(B + 1))) := by
      apply mul_le_mul_of_nonneg_left _ (Real.exp_nonneg L)
      convert hsum using 1; ring
    _ ≤ _ := mul_le_mul_of_nonneg_left hcoeff (Real.exp_nonneg L)

theorem eventually_large_sieve_subexponential_energy_bound  :
    ∀ᶠ L : ℝ in atTop, ∀ P U R E F : ℝ,
      Real.exp (a * L) ≤ P → Real.exp (a * L) ≤ U →
      P * U ≤ C * Real.exp L →
      Real.exp (eta * L) ≤ R → R ≤ Real.exp (theta * L) →
      0 ≤ F → E ≤ P * Real.exp (K * Real.sqrt L) →
      F ≤ U * Real.exp (K * Real.sqrt L) →
      (L ^ D / R) * Real.sqrt ((P + R ^ 2) * (U + R ^ 2) * E * F) ≤
        Real.exp L * L ^ (-B) := by
  filter_upwards [eventually_large_sieve_profile_decay ha heta htheta hK hC D B,
    eventually_gt_atTop (0 : ℝ)] with L hdecay hL
  intro P U R E F hP hU hPU hRlo hRhi hF hEP hFU
  have hP0 : 0 ≤ P := (Real.exp_pos _).le.trans hP
  have hU0 : 0 ≤ U := (Real.exp_pos _).le.trans hU
  have hR0 : 0 < R := (Real.exp_pos _).trans_le hRlo
  calc
    _ ≤ (L ^ D / R) * (Real.exp (K * Real.sqrt L) *
        Real.sqrt ((P + R ^ 2) * (U + R ^ 2) * P * U)) :=
      mul_le_mul_of_nonneg_left
        (large_sieve_energy_factor hP0 hU0 hF (Real.exp_nonneg _) hEP hFU)
        (div_nonneg (Real.rpow_nonneg hL.le _) hR0.le)
    _ = (L ^ D * Real.exp (K * Real.sqrt L)) *
        (Real.sqrt ((P + R ^ 2) * (U + R ^ 2) * P * U) / R) := by ring
    _ ≤ (L ^ D * Real.exp (K * Real.sqrt L)) *
        (C * Real.exp ((1 - eta) * L) +
          2 * C * Real.exp ((1 - a / 2) * L) +
            Real.sqrt C * Real.exp ((theta + 1 / 2) * L)) :=
      mul_le_mul_of_nonneg_left
        (large_sieve_exponential_ranges hC hP hU hPU hRlo hRhi) (by positivity)
    _ ≤ _ := hdecay

end


end Bounty
end

section

/- A finite dyadic prefix covers each positive support with logarithmic cost. -/

open Finset Filter

namespace Bounty

theorem finite_nat_dyadic_prefix {U : ℝ} (hU : 1 ≤ U)
    (T : Finset ℕ) (hT : ∀ n ∈ T, (n : ℝ) ≤ U) :
    T ⊆ range (2 ^ (⌊U⌋₊.log2 + 1)) ∧
      ∀ n ∈ range (2 ^ (⌊U⌋₊.log2 + 1)), (n : ℝ) ≤ 2*U := by
  have hfloor : 0 < ⌊U⌋₊ := Nat.floor_pos.mpr hU
  obtain ⟨hlower, hupper⟩ := (Nat.log2_eq_iff hfloor.ne').mp (rfl : ⌊U⌋₊.log2 = ⌊U⌋₊.log2)
  have hpow : 2 ^ (⌊U⌋₊.log2 + 1) ≤ 2*⌊U⌋₊ := by
    rw [pow_succ]
    omega
  constructor
  · intro n hn
    apply mem_range.mpr
    exact (Nat.le_floor (hT n hn)).trans_lt hupper
  · intro n hn
    have hnle : n ≤ 2*⌊U⌋₊ := (mem_range.mp hn).le.trans hpow
    have hcast : (n : ℝ) ≤ 2*(⌊U⌋₊ : ℝ) := by exact_mod_cast hnle
    exact hcast.trans (mul_le_mul_of_nonneg_left (Nat.floor_le (zero_le_one.trans hU)) (by norm_num))

theorem eventually_window_dyadic_prefix_cost :
    ∀ᶠ L : ℝ in atTop, ∀ U : ℝ, 1 ≤ U → U ≤ 32*Real.exp L →
      (⌊U⌋₊.log2 + 1 + 1 : ℝ) ≤ L^2 := by
  filter_upwards [eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (Real.log 32),
    eventually_ge_atTop (2/Real.log 2 + 2)] with L hL h32 hcost
  intro U hU hUL
  have hfloor : 0 < (⌊U⌋₊ : ℝ) := by exact_mod_cast (Nat.floor_pos.mpr hU)
  have hfl : (⌊U⌋₊ : ℝ) ≤ 32*Real.exp L :=
    (Nat.floor_le (zero_le_one.trans hU)).trans hUL
  have hlog : Real.log (⌊U⌋₊ : ℝ) ≤ 2*L := by
    have h := Real.log_le_log hfloor hfl
    rw [Real.log_mul (by norm_num : (32 : ℝ) ≠ 0) (Real.exp_ne_zero L), Real.log_exp] at h
    linarith
  have htwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  calc
    _ ≤ Real.log (⌊U⌋₊ : ℝ)/Real.log 2 + 2 := by
      have h := dyadic_log_count_le_log ⌊U⌋₊
      linarith
    _ ≤ 2*L/Real.log 2 + 2 := by
      exact add_le_add (div_le_div_of_nonneg_right hlog htwo.le) le_rfl
    _ ≤ 2*L/Real.log 2 + 2*L := by linarith
    _ = (2/Real.log 2 + 2)*L := by ring
    _ ≤ L^2 := by nlinarith

theorem window_dyadic_prefactor_le {L R : ℝ} (K : ℕ)
    (hR : 0 < R) (hK : (K + 1 : ℝ) ≤ L^2)
    (hL : 4*(6 + 8*Real.pi) ≤ L) :
    2*(K + 1 : ℝ)*((6 + 8*Real.pi)/(R/2)) ≤ L^3/R := by
  have hpi : 0 ≤ 4*(6 + 8*Real.pi) := by positivity
  calc
    _ = (4*(6 + 8*Real.pi)*(K + 1 : ℝ))/R := by ring
    _ ≤ (4*(6 + 8*Real.pi)*L^2)/R := by
      exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hK hpi) hR.le
    _ ≤ (L*L^2)/R := by
      exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right hL (sq_nonneg L)) hR.le
    _ = _ := by ring

end Bounty

end

section

/- Original physical permutation and auxiliary choices remain observable
inside the full event model, including changes of slot coordinates. -/

namespace Bounty

abbrev PhysicalMarkObservation {K : Type*} {N J : ℕ} (P : Fin N → Finset ℕ)
    (ell : ℕ) (C : K → Fin N → Finset (Fin J)) :=
  PhysicalPermutations (Fin N) J ell ⊕ Option (Σ j : K, PhysicalAuxLabels P (C j))

noncomputable def physicalFullEventObservation {I K : Type*} {N J ell B : ℕ}
    {P : Fin N → Finset ℕ} (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
    (before after : Fin N → Finset (Fin J)) :
    (tag : Option (I ⊕ K)) →
    (s : FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B) →
    FullPermutationMixedEvent (fun g (p : ↥(P g)) => p.val)
      (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
      (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j)) tag s.2 →
      PhysicalMarkObservation P ell C
  | none, _, e => .inl ((physicalTransitionPermutationEquiv before after).symm e.down)
  | some (.inl _), _, _ => .inr none
  | some (.inr j), _, e => .inr (some ⟨j, e.1⟩)

end Bounty
end

section

/- Recorded rows with local complex phases are original event paths with
one whole-path phase. Terminal conditions may inspect the complete record. -/

namespace Bounty

section Recorded
