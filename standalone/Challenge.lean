  (μ : ∀ i, X i → ℝ)
  (hμ : ∀ i x, 0 ≤ μ i x)
  (hmass : ∀ i, ∑ y, μ i y = 1)

include I sharedInstance1 sharedInstance2 X sharedInstance4 μ hμ hmass

theorem finite_probe_component_norm_le 
    (U S : Finset I) (hS : S ⊆ U) (f : (∀ i, X i) → ℂ) :
    Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ S U.toList f)) ≤
      Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) := by
  apply Real.sqrt_le_sqrt
  exact finite_coordinate_component_energy_le μ hμ hmass U.toList (nodup_toList U) S
    (by simpa using hS) f

theorem finite_probe_comparison_error_uniform 
    (U V S T : Finset I) (hS : S ⊆ U) (hT : T ⊆ V)
    (f g : (∀ i, X i) → ℂ) (ε : ℝ) (hε : 0 ≤ ε) (e : ℂ)
    (he : ‖e‖ ≤ ε *
      Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ S U.toList f)) *
      Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) (finiteCoordinateComponent μ T V.toList g))) :
    ‖e‖ ≤ ε * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) f) *
      Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ) g) := by
  exact he.trans (mul_le_mul
    (mul_le_mul_of_nonneg_left (finite_probe_component_norm_le μ hμ hmass U S hS f) hε)
    (finite_probe_component_norm_le μ hμ hmass V T hT g)
    (Real.sqrt_nonneg _) (mul_nonneg hε (Real.sqrt_nonneg _)))

