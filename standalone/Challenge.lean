section
open Finset
open scoped Classical
/- The actual target reconstruction and the global all-previous-births ban.
H is cumulative, rather than just the labels currently held in memory. -/
def GlobalBirthEdgeEventValid {S J P : Type*} [DecidableEq S] [DecidableEq P]
    (H : Finset P) (f : J ↪ P) (target : S ↪ P)
    {eligible : Finset J} (event : FixedTargetEdgeEvent S J P eligible) : Prop :=
  unrestrictedTargetLabels event.1 (fun s => f (event.2.1 s).val) event.2.2 = target ∧
    ∀ s, event.2.2 s ∉ H

theorem global_birth_event_implies_fixed_target {S J P : Type*} [Fintype J]
    [DecidableEq S] [DecidableEq P] (H : Finset P) (f : J ↪ P) (target : S ↪ P)
    (hH : univ.image f ⊆ H) {eligible : Finset J}
    (event : FixedTargetEdgeEvent S J P eligible)
    (h : GlobalBirthEdgeEventValid H f target event) :
    FixedTargetEdgeEventValid f target event :=
  ⟨h.1, fun s hs => h.2 s (hH hs)⟩

/- Every fresh value of a compatible fixed-target event is genuinely unborn,
including labels whose previous lifespans have already completed. -/
theorem fixed_target_fresh_outside_born {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)] {N t : ℕ}
    (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (target : Fin t ↪ P) (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true)
    {eligible : Finset (Fin N)} (event : FixedTargetEdgeEvent (Fin t) (Fin N) P eligible)
    (h : FixedTargetEdgeEventValid f.val target event) :
    ∀ s, event.2.2 s ∉ ghostPhaseBornSupport w := by
  intro s
  have hp : event.2.2 s ∈ ghostPhaseFreshSet atgt asrc w := by
    rw [← ghost_phase_new_run_without_pending atgt asrc delta w hw hc,
      ← htarget, ← distinct_ordered_support_image f]
    refine mem_sdiff.mpr ⟨?_, h.2 s⟩
    refine mem_image.mpr ⟨s.val, mem_univ _, ?_⟩
    exact (congrFun (fixed_target_edge_event_fresh f.val target event h) s).symm
  have hu : w (event.2.2 s) = some none := by
    simp only [ghostPhaseFreshSet, mem_filter, mem_univ, true_and,
      ghostPhaseEdgeFresh, Bool.and_eq_true, decide_eq_true_eq] at hp
    exact hp.2
  rw [ghost_phase_mem_born_support, hu]
  exact not_not_intro rfl

/- The global birth ban may replace the local fresh-avoidance filter on every
compatible phase snapshot. The equality concerns all actual events. -/
theorem global_birth_event_valid_iff_fixed_target {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)] {N t : ℕ}
    (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (target : Fin t ↪ P) (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true)
    {eligible : Finset (Fin N)} (event : FixedTargetEdgeEvent (Fin t) (Fin N) P eligible) :
    GlobalBirthEdgeEventValid (ghostPhaseBornSupport w) f.val target event ↔
      FixedTargetEdgeEventValid f.val target event := by
  constructor
  · apply global_birth_event_implies_fixed_target
    rw [distinct_ordered_support_image f]
    exact ghost_phase_pending_subset_born w
  · intro h
    exact ⟨h.1, fixed_target_fresh_outside_born atgt asrc delta w hw f target htarget hc event h⟩



end

section
open Finset
section

variable
  {R : Type*}
  [sharedInstance1 : AddGroup R]
  (atgt asrc store : Bool)
  (delta : R)
  (w : GhostPhaseState R)
  (hw : w.isSome = !asrc)
  (hs : store = true → atgt = false ∧ asrc = true)

include R sharedInstance1 atgt asrc store delta w hw hs

/- An allowed selected local outcome has the target activity tag, independent
of hit compatibility or its numerical coefficient. -/
theorem ghost_phase_selected_moving_isSome  :
    (ghostPhaseMovingChoiceTarget atgt asrc delta store w).isSome = !atgt := by
  cases atgt <;> cases asrc <;> cases store <;>
    rcases w with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseMovingChoiceTarget, ghostPhaseEdgeBaseTarget,
      ghostPhaseEdgeStoreTarget, ghostPhaseShift_unborn,
      ghostPhaseShift_completed, ghostPhaseShift_pending]

/- Selecting an allowed edge output preserves previous birth and adds target
activity, even if the selected coefficient is zero. -/
theorem ghost_phase_selected_moving_born_iff  :
    ghostPhaseBorn (ghostPhaseMovingChoiceTarget atgt asrc delta store w) ↔
      ghostPhaseBorn w ∨ atgt = true := by
  cases atgt <;> cases asrc <;> cases store <;>
    rcases w with _ | (_ | (_ | r)) <;>
    simp_all [ghostPhaseBorn, ghostPhaseMovingChoiceTarget, ghostPhaseEdgeBaseTarget,
      ghostPhaseEdgeStoreTarget, ghostPhaseShift_unborn,
      ghostPhaseShift_completed, ghostPhaseShift_pending]

end


theorem ghost_phase_selected_moving_mask {P : Type*} {R : P → Type*}
    [∀ p, AddGroup (R p)] (atgt asrc store : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true) :
    ghostPhaseMask atgt
      (fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p) (store p) (w p)) :=
  fun p => ghost_phase_selected_moving_isSome (atgt p) (asrc p) (store p)
    (delta p) (w p) (hw p) (hs p)

theorem ghost_phase_selected_moving_active_support {P : Type*} [Fintype P]
    {R : P → Type*} [∀ p, AddGroup (R p)]
    (atgt asrc store : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true) :
    ghostPhaseStateActiveSupport
      (fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p) (store p) (w p)) =
      ghostPhaseActivitySupport atgt :=
  ghost_phase_state_active_support_of_mask atgt _
    (ghost_phase_selected_moving_mask atgt asrc store delta w hw hs)

theorem ghost_phase_selected_moving_born_support {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, AddGroup (R p)]
    (atgt asrc store : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hs : ∀ p, store p = true → atgt p = false ∧ asrc p = true) :
    ghostPhaseBornSupport
      (fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p) (store p) (w p)) =
      ghostPhaseBornSupport w ∪ ghostPhaseActivitySupport atgt := by
  classical
  ext p
  rw [mem_union, ghost_phase_mem_born_support, ghost_phase_mem_born_support]
  change ghostPhaseBorn _ ↔ ghostPhaseBorn (w p) ∨ _
  simpa only [ghostPhaseActivitySupport, mem_filter, mem_univ, true_and] using
    ghost_phase_selected_moving_born_iff (atgt p) (asrc p) (store p)
      (delta p) (w p) (hw p) (hs p)

section ActualOutput

variable {P : Type*} [Fintype P] [DecidableEq P]
  {R : P → Type*} [∀ p, AddGroup (R p)] {t N : ℕ}
  (source : Fin t ↪ P) (stores promotions : Finset (Fin t))
  (atgt asrc : P → Bool) (delta : (p : P) → R p)
  (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
  (hsource : ∀ j, asrc (source j) = true)
  (hstores : ∀ j ∈ stores, atgt (source j) = false)
  (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
  (old : (j : Fin N) → R (f.val j))
  {eligible : Finset (Fin N)} (e : promotions ↪ ↥eligible)
  (he : ∀ j, j ∈ promotionSelectedIndices e ↔ atgt (f.val j) = true)

include hw hsource hstores he

/- The literal retained-and-stored output reconstructs the selected phase
using only target activity and the updated cumulative born-label set. -/
theorem global_birth_selected_edge_readout
    (hold : ∀ j, w (f.val j) = some (some (some (old j)))) :
    globalBirthMemoryReadout (ghostPhaseActivitySupport atgt)
      (ghostPhaseBornSupport w ∪ ghostPhaseActivitySupport atgt)
      (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores promotions e) =
      fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p)
        (distinctUnrestrictedStorageChoice source stores p) (w p) := by
  have hs := distinct_unrestricted_storage_allowed source stores atgt asrc hsource hstores
  rw [← ghost_phase_selected_moving_born_support atgt asrc
    (distinctUnrestrictedStorageChoice source stores) delta w hw hs]
  apply global_birth_memory_readout_eq_of_mask
  · exact ghost_phase_selected_moving_mask atgt asrc
      (distinctUnrestrictedStorageChoice source stores) delta w hw hs
  · exact distinct_unrestricted_output_support source stores promotions atgt asrc delta
      w hw hsource hstores f old e he
  · exact distinct_unrestricted_output_particle source stores promotions atgt asrc delta
      w hw hsource hstores f old e he hold

/- An arbitrary coupled complex phase continuation is read exactly on the
literal distinct output. No nonzero-weight or hit-compatibility assumption is
needed for this deterministic output correspondence. -/
theorem global_birth_selected_edge_symmetric_readout
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    symmetricPhaseReadout
      (globalBirthMemoryBase (ghostPhaseActivitySupport atgt)
        (ghostPhaseBornSupport w ∪ ghostPhaseActivitySupport atgt)) F
      (unrestrictedEdgeOutput source (fun j => (⟨f.val j, old j⟩ : Σ p, R p))
        (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) stores promotions e) =
      F (fun p => ghostPhaseMovingChoiceTarget (atgt p) (asrc p) (delta p)
        (distinctUnrestrictedStorageChoice source stores p) (w p)) := by
  apply symmetric_phase_readout_eq_of_reconstruction
  · exact distinct_unrestricted_output_label_injective source stores promotions atgt asrc
      delta w hw hsource hstores f old e
  · exact distinct_unrestricted_output_support source stores promotions atgt asrc delta
      w hw hsource hstores f old e he
  · exact global_birth_selected_edge_readout source stores promotions atgt asrc delta
      w hw hsource hstores f old e he hold

end ActualOutput
end

section
open Finset
/- Compatibility of global birth metadata with a literal pending tuple. -/
structure GlobalBirthMemoryCoherent {P : Type*} [DecidableEq P]
    {R : P → Type*} (active born : Finset P)
    (q : FiniteOrderedTuple (Σ p, R p)) : Prop where
  label_injective : Function.Injective (Sigma.fst ∘ q.2)
  labels_born : univ.image (fun j => (q.2 j).1) ⊆ born
  labels_inactive : Disjoint (univ.image (fun j => (q.2 j).1)) active
  active_born : active ⊆ born

/- The pending tuple cannot alter a coordinate outside its label image. -/
theorem global_birth_memory_readout_off_labels {P : Type*} [DecidableEq P]
    {R : P → Type*} (active born : Finset P)
    (q : FiniteOrderedTuple (Σ p, R p)) (p : P)
    (hp : p ∉ univ.image (fun j => (q.2 j).1)) :
    globalBirthMemoryReadout active born q p = globalBirthMemoryBase active born p := by
  classical
  have hn : ¬ ∃ j, (q.2 j).1 = p := by
    simpa only [mem_image, mem_univ, true_and] using hp
  simp only [globalBirthMemoryReadout, ghostPhaseMemoryReadout, dif_neg hn]

section

variable
  {P : Type*}
  {R : P → Type*}
  (active born : Finset P)
  (p : P)

include P R active born p

/- The activity tag of the global base is exactly its supplied activity set. -/
theorem global_birth_memory_base_active_iff  :
    @globalBirthMemoryBase P R active born p = none ↔ p ∈ active := by
  classical
  by_cases ha : p ∈ active <;> by_cases hb : p ∈ born <;>
    simp [globalBirthMemoryBase, ha, hb]

/- The global base contains no pending particles. -/
theorem global_birth_memory_base_not_pending  :
    ¬ ∃ r, @globalBirthMemoryBase P R active born p = some (some (some r)) := by
  classical
  by_cases ha : p ∈ active <;> by_cases hb : p ∈ born <;>
    simp [globalBirthMemoryBase, ha, hb]

/- The born tag of the base is the union of its activity and birth metadata. -/
theorem global_birth_memory_base_born_iff  :
    ghostPhaseBorn (@globalBirthMemoryBase P R active born p) ↔ p ∈ active ∨ p ∈ born := by
  classical
  by_cases ha : p ∈ active <;> by_cases hb : p ∈ born <;>
    simp [ghostPhaseBorn, globalBirthMemoryBase, ha, hb]

end


/- On a coherent state, every listed particle is read at its own label with
exactly its own residue. -/
theorem global_birth_coherent_readout_particle {P : Type*} [DecidableEq P]
    {R : P → Type*} (active born : Finset P)
    (q : FiniteOrderedTuple (Σ p, R p)) (hq : GlobalBirthMemoryCoherent active born q)
    (j : Fin q.1) :
    globalBirthMemoryReadout active born q (q.2 j).1 = some (some (some (q.2 j).2)) :=
  ghost_phase_memory_readout_at _ q hq.label_injective j

/- Coherent pending memory leaves exactly the specified labels active. -/
theorem global_birth_coherent_readout_active_support {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    (active born : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent active born q) :
    ghostPhaseStateActiveSupport (globalBirthMemoryReadout active born q) = active := by
  classical
  ext p
  rw [ghost_phase_mem_state_active_support]
  by_cases hp : p ∈ univ.image (fun j => (q.2 j).1)
  · have hna : p ∉ active := fun ha => Finset.disjoint_left.mp hq.labels_inactive hp ha
    obtain ⟨j, _, rfl⟩ := mem_image.mp hp
    rw [global_birth_coherent_readout_particle active born q hq j]
    simp only [Option.some_ne_none, false_iff]
    exact hna
  · rw [global_birth_memory_readout_off_labels active born q p hp]
    exact global_birth_memory_base_active_iff active born p

/- Coherent pending memory neither adds nor erases cumulative born labels. -/
theorem global_birth_coherent_readout_born_support {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    (active born : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent active born q) :
    ghostPhaseBornSupport (globalBirthMemoryReadout active born q) = born := by
  classical
  ext p
  rw [ghost_phase_mem_born_support]
  by_cases hp : p ∈ univ.image (fun j => (q.2 j).1)
  · have hb := hq.labels_born hp
    obtain ⟨j, _, rfl⟩ := mem_image.mp hp
    rw [global_birth_coherent_readout_particle active born q hq j]
    simp [hb]
  · rw [global_birth_memory_readout_off_labels active born q p hp]
    change ghostPhaseBorn _ ↔ p ∈ born
    rw [global_birth_memory_base_born_iff]
    exact or_iff_right_of_imp (fun ha => hq.active_born ha)

/- On the coherent state space the pending support is precisely the literal
tuple's label image; the base contributes no extra pending coordinates. -/
theorem global_birth_coherent_readout_pending_support {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    (active born : Finset P) (q : FiniteOrderedTuple (Σ p, R p))
    (hq : GlobalBirthMemoryCoherent active born q) :
    ghostPhasePendingSupport (globalBirthMemoryReadout active born q) =
      univ.image (fun j => (q.2 j).1) := by
  classical
  ext p
  change (p ∈ univ.filter (fun p => ∃ r,
    globalBirthMemoryReadout active born q p = some (some (some r)))) ↔ _
  simp only [mem_filter, mem_univ, true_and]
  by_cases hp : p ∈ univ.image (fun j => (q.2 j).1)
  · have hex : ∃ r, globalBirthMemoryReadout active born q p = some (some (some r)) := by
      obtain ⟨j, _, rfl⟩ := mem_image.mp hp
      exact ⟨(q.2 j).2, global_birth_coherent_readout_particle active born q hq j⟩
    exact iff_of_true hex hp
  · rw [global_birth_memory_readout_off_labels active born q p hp]
    exact iff_of_false (global_birth_memory_base_not_pending active born p) hp

/- True snapshot metadata always gives a coherent global memory state when
the pending tuple has distinct labels and complete support. No residue
agreement is needed merely to establish this metadata compatibility. -/
theorem global_birth_memory_coherent_of_snapshot {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    (z : (p : P) → GhostPhaseState (R p)) (q : FiniteOrderedTuple (Σ p, R p))
    (hinj : Function.Injective (Sigma.fst ∘ q.2))
    (hsupport : univ.image (fun j => (q.2 j).1) = ghostPhasePendingSupport z) :
    GlobalBirthMemoryCoherent (ghostPhaseStateActiveSupport z) (ghostPhaseBornSupport z) q := by
  refine ⟨hinj, ?_, ?_, ghost_phase_state_active_subset_born z⟩
  · rw [hsupport]
    exact ghost_phase_pending_subset_born z
  · rw [hsupport]
    apply Finset.disjoint_left.mpr
    intro p hp ha
    rw [ghost_phase_mem_state_active_support] at ha
    have hex : ∃ r, z p = some (some (some r)) := by
      simpa only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and] using hp
    obtain ⟨r, hr⟩ := hex
    rw [ha] at hr
    cases hr




section

variable
  {P : Type*}
  [sharedInstance1 : Fintype P]
  [sharedInstance2 : DecidableEq P]
  {R : P → Type*}
  (active born : Finset P)
  (q : FiniteOrderedTuple (Σ p, R p))
  (hq : GlobalBirthMemoryCoherent active born q)

include P sharedInstance1 sharedInstance2 R active born q hq

/- Every coherent tuple belongs to the support of the symmetric readout. -/
theorem global_birth_coherent_readout_supported  :
    GhostPhaseReadoutSupported (globalBirthMemoryBase active born) q :=
  ⟨hq.label_injective, (global_birth_coherent_readout_pending_support active born q hq).symm⟩

/- The symmetric zero extension reads the global snapshot on every coherent
state, with no additional support condition. -/
theorem global_birth_coherent_symmetric_readout 
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    symmetricPhaseReadout (globalBirthMemoryBase active born) F q =
      F (globalBirthMemoryReadout active born q) := by
  classical
  rw [symmetricPhaseReadout, if_pos (global_birth_coherent_readout_supported active born q hq)]
  rfl

end

end

section
open Finset
open scoped Classical






/- Current active and pending labels are already included in a coherent
phase snapshot's cumulative born support. -/
theorem ghost_phase_activity_subset_born_of_mask {P : Type*} [Fintype P]
    {R : P → Type*} (a : P → Bool) (w : (p : P) → GhostPhaseState (R p))
    (hw : ghostPhaseMask a w) : ghostPhaseActivitySupport a ⊆ ghostPhaseBornSupport w := by
  classical
  intro p hp
  have ha : a p = true := by simpa [ghostPhaseActivitySupport] using hp
  rw [ghost_phase_mem_born_support]
  have hm := hw p
  cases he : w p <;> simp_all

/- For target unshared slots, adjoining their image is the same as adjoining
all target-active labels, because shared source activity was already born. -/
theorem global_birth_new_run_update {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (atgt asrc : P → Bool)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w) :
    ghostPhaseBornSupport w ∪ ghostPhaseNewRunSet atgt asrc =
      ghostPhaseBornSupport w ∪ ghostPhaseActivitySupport atgt := by
  have ha := ghost_phase_activity_subset_born_of_mask asrc w hw
  ext p
  by_cases hs : asrc p = true
  · have hb : p ∈ ghostPhaseBornSupport w := ha (by simp [ghostPhaseActivitySupport, hs])
    simp [hb]
  · have hs' : asrc p = false := Bool.eq_false_iff.mpr hs
    simp [ghostPhaseNewRunSet, ghostPhaseActivitySupport, hs']



end

section
open Finset
section

variable
  {P : Type*}
  [sharedInstance1 : Fintype P]
  [sharedInstance2 : DecidableEq P]
  {R : P → Type*}
  [sharedInstance4 : ∀ p, AddGroup (R p)]
  [sharedInstance5 : ∀ p, DecidableEq (R p)]
  {N t : ℕ}
  (atgt asrc : P → Bool)
  (delta : (p : P) → R p)
  (w : (p : P) → GhostPhaseState (R p))
  (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
  (old : (j : Fin N) → R (f.val j))
  (hold : ∀ j, w (f.val j) = some (some (some (old j))))
  (target : Fin t ↪ P)
  (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
  (eligible : Finset (Fin N))
  (heligible : ∀ j, j ∈ eligible ↔ old j = delta (f.val j))
  (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true)

include P sharedInstance1 sharedInstance2 R sharedInstance4 sharedInstance5 N t atgt asrc delta w f old hold target htarget eligible heligible hc

/- Any old pending label needed at a compatible target is eligible when
eligibility is exactly the transported-zero test on old indices. -/
theorem global_birth_required_indices_eligible  :
    univ.filter (fun j => f.val j ∈ univ.image target) ⊆ eligible := by
  intro j hj
  rw [mem_filter, and_iff_right (mem_univ j), htarget] at hj
  have ha : atgt (f.val j) = true ∧ asrc (f.val j) = false := by
    simpa [ghostPhaseNewRunSet] using hj
  have h := hc (f.val j)
  rw [ha.1, ha.2, hold] at h
  apply (heligible j).mpr
  simpa only [ghostPhaseMovingEdgeCompatible, decide_eq_true_eq] using h

/- Compatible target data construct a matching eligible promotion without
assuming its existence as an independent row hypothesis. -/
theorem global_birth_matching_promotion_exists  :
    ∃ e : distinctPromotedTargetSlots f.val target ↪ eligible,
      ∀ s, f.val (e s).val = target s.val := by
  have hreq := global_birth_required_indices_eligible atgt asrc delta w f old hold
    target htarget eligible heligible hc
  exact ⟨canonicalEligiblePromotion f.val target eligible hreq,
    canonical_eligible_promotion_matches f.val target eligible hreq⟩

end

end

section
open Finset
/- Any nonzero actual damped moving edge satisfies its compatibility bit. -/
theorem ghost_phase_damped_moving_edge_compatible {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (atgt asrc : Bool) (delta : R) (β ρtgt ρsrc : ℝ)
    (z w : GhostPhaseState R) (hw : w.isSome = !asrc)
    (hn : ghostPhaseDampedMovingEdge atgt asrc delta β ρtgt ρsrc z w ≠ 0) :
    ghostPhaseMovingEdgeCompatible atgt asrc delta w = true := by
  cases atgt <;> cases asrc <;>
    rcases z with _ | (_ | (_ | r)) <;> rcases w with _ | (_ | (_ | s)) <;>
    simp_all [ghostPhaseDampedMovingEdge, ghostPhaseMovingEdge,
      ghostPhaseEdge, ghostPhaseGather, ghostPhaseScatter, ghostActiveInput,
      ghostActiveOutput, ghostPhaseDiagonal, ghostPhaseShift, ghostMemoryShift,
      ghostPhaseMovingEdgeCompatible, sub_eq_zero]
  all_goals split_ifs at hn <;> simp_all

/- Incompatibility annihilates every output coefficient, irrespective of rho
or beta values. This includes the zero-weight boundary parameter cases. -/
theorem ghost_phase_damped_moving_edge_eq_zero_of_incompatible {R : Type*}
    [AddGroup R] [Fintype R] [DecidableEq R]
    (atgt asrc : Bool) (delta : R) (β ρtgt ρsrc : ℝ)
    (z w : GhostPhaseState R) (hw : w.isSome = !asrc)
    (hc : ghostPhaseMovingEdgeCompatible atgt asrc delta w ≠ true) :
    ghostPhaseDampedMovingEdge atgt asrc delta β ρtgt ρsrc z w = 0 := by
  by_contra hn
  exact hc (ghost_phase_damped_moving_edge_compatible atgt asrc delta β ρtgt ρsrc z w hw hn)

/- A globally valid event can only use an unborn coordinate or promote a
matching eligible pending particle. Thus, after shared-active physical hits
are supplied, every coordinate of the source satisfies edge compatibility. -/
theorem global_birth_event_implies_compatible {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    [∀ p, AddGroup (R p)] [∀ p, DecidableEq (R p)] {N t : ℕ}
    (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (hshared : ∀ p, atgt p = true ∧ asrc p = true → delta p = 0)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (old : (j : Fin N) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (target : Fin t ↪ P) (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (eligible : Finset (Fin N))
    (heligible : ∀ j ∈ eligible, old j = delta (f.val j))
    (event : FixedTargetEdgeEvent (Fin t) (Fin N) P eligible)
    (hvalid : GlobalBirthEdgeEventValid (ghostPhaseBornSupport w) f.val target event) :
    ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true := by
  have hH : univ.image f.val ⊆ ghostPhaseBornSupport w := by
    rw [distinct_ordered_support_image f]
    exact ghost_phase_pending_subset_born w
  have hv := global_birth_event_implies_fixed_target (ghostPhaseBornSupport w)
    f.val target hH event hvalid
  intro p
  rw [ghost_phase_moving_edge_compatible_iff _ _ _ _ (hw p)]
  refine ⟨hshared p, ?_⟩
  intro hp
  have hpt : p ∈ univ.image target := by
    rw [htarget]
    simp [ghostPhaseNewRunSet, hp.1, hp.2]
  obtain ⟨s, _, hs⟩ := mem_image.mp hpt
  by_cases hsp : s ∈ event.1
  · let j := (event.2.1 ⟨s, hsp⟩).val
    have hj : f.val j = p :=
      (fixed_target_edge_event_matches f.val target event hv ⟨s, hsp⟩).trans hs
    have hh : w (f.val j) = some (some (some (delta (f.val j)))) := by
      rw [hold j, heligible j (event.2.1 ⟨s, hsp⟩).property]
    cases hj
    exact Or.inr hh
  · have hf := fixed_target_edge_event_fresh f.val target event hv
    have he : event.2.2 ⟨s, hsp⟩ = p := (congrFun hf ⟨s, hsp⟩).trans hs
    have hn := hvalid.2 ⟨s, hsp⟩
    rw [he, ghost_phase_mem_born_support] at hn
    exact Or.inl (not_not.mp hn)
end

section
open Finset
open scoped Classical
/- On a valid phase snapshot the unborn pool is exactly the complement of
all previously born labels, including completed labels. -/
theorem ghost_visit_births_eq_unborn {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (a : P → Bool) (y : (p : P) → GhostPhaseState (R p))
    (hy : ghostPhaseMask a y) :
    ghostVisitBirths a y = univ \ ghostPhaseBornSupport y := by
  ext p
  simp only [ghostVisitBirths, mem_filter, mem_univ, true_and, mem_sdiff,
    ghost_phase_mem_born_support, not_not]
  constructor
  · exact And.right
  · intro hp
    refine ⟨?_, hp⟩
    have hm := hy p
    rw [hp] at hm
    cases ha : a p <;> simp_all

/- Retain precisely the old slots whose labels were not terminated. -/
noncomputable def ghostVisitSurvivingIndices {P : Type*} [DecidableEq P]
    {R : P → Type*} {N : ℕ} (old : Fin N → Σ p, R p) (D : Finset P) :
    Finset (Fin N) := univ.filter (fun j => (old j).1 ∉ D)

/- The literal visit output is a retained old tuple followed by new particles
at the current hit, with its actual length stored in the sigma type. -/
noncomputable def globalBirthVisitOutput {P : Type*} [DecidableEq P]
    {R : P → Type*} {N b : ℕ} (h : (p : P) → R p)
    (old : Fin N → Σ p, R p) (D : Finset P) (birth : Fin b → P) :
    FiniteOrderedTuple (Σ p, R p) :=
  retainedBirthTuple old (ghostVisitSurvivingIndices old D) (fun j => ⟨birth j, h (birth j)⟩)

/- Labels of the old memory entries at the current hit. -/
noncomputable def globalBirthVisitZeros {P : Type*} [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (old : Fin N → Σ p, R p) : Finset P :=
  (univ.filter (fun j => (old j).2 = h (old j).1)).image (fun j => (old j).1)

/- Label image of a literal retained-and-appended tuple. -/
theorem retained_birth_tuple_label_image {P Z : Type*} [DecidableEq P]
    {N b : ℕ} (label : Z → P) (old : Fin N → Z) (s : Finset (Fin N))
    (birth : Fin b → Z) :
    univ.image (fun j => label ((retainedBirthTuple old s birth).2 j)) =
      s.image (label ∘ old) ∪ univ.image (label ∘ birth) := by
  ext p
  simp only [mem_image, mem_univ, true_and, mem_union, Function.comp_apply]
  constructor
  · rintro ⟨j, hj⟩
    change Fin (s.card + b) at j
    rw [retained_birth_tuple_apply_index_equiv old s birth j] at hj
    cases e : retainedBirthIndexEquiv s b j with
    | inl k => exact Or.inl ⟨k.val, k.property, by simpa only [e, Sum.elim_inl] using hj⟩
    | inr k => exact Or.inr ⟨k, by simpa only [e, Sum.elim_inr] using hj⟩
  · rintro (⟨j, hj, hp⟩ | ⟨j, hp⟩)
    · refine ⟨(retainedBirthIndexEquiv s b).symm (Sum.inl ⟨j, hj⟩), ?_⟩
      simpa only [retained_birth_tuple_apply_index_equiv_symm, Sum.elim_inl] using hp
    · refine ⟨(retainedBirthIndexEquiv s b).symm (Sum.inr j), ?_⟩
      simpa only [retained_birth_tuple_apply_index_equiv_symm, Sum.elim_inr] using hp

section Batch

variable {P : Type*} [Fintype P] [DecidableEq P] {R : P → Type*}
  [∀ p, DecidableEq (R p)] (a : P → Bool) (h : (p : P) → R p)
  (y : (p : P) → GhostPhaseState (R p)) (hy : ghostPhaseMask a y)
  (D B : Finset P) (hD : D ⊆ ghostVisitDeaths a h y) (hB : B ⊆ ghostVisitBirths a y)

include hD hB in
theorem ghost_visit_batch_pending_support :
    ghostPhasePendingSupport (ghostVisitBatchOutput h y D B) =
      (ghostPhasePendingSupport y \ D) ∪ B := by
  have hdis := disjoint_left.mp (ghost_visit_eligible_disjoint a h y)
  ext p
  simp only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and, mem_union, mem_sdiff]
  by_cases hpD : p ∈ D
  · have hpB : p ∉ B := fun hp => hdis (hD hpD) (hB hp)
    simp [ghostVisitBatchOutput, hpD, hpB]
  · by_cases hpB : p ∈ B
    · simp [ghostVisitBatchOutput, hpD, hpB]
    · simp [ghostVisitBatchOutput, hpD, hpB]

include hD in
theorem ghost_visit_batch_born_support :
    ghostPhaseBornSupport (ghostVisitBatchOutput h y D B) =
      ghostPhaseBornSupport y ∪ B := by
  ext p
  rw [ghost_phase_mem_born_support, mem_union, ghost_phase_mem_born_support]
  by_cases hpD : p ∈ D
  · have hp := hD hpD
    simp only [ghostVisitDeaths, mem_filter, mem_univ, true_and] at hp
    simp [ghostVisitBatchOutput, hpD, hp.2]
  · by_cases hpB : p ∈ B <;> simp [ghostVisitBatchOutput, hpD, hpB]

include hy hD hB in
theorem ghost_visit_batch_mask : ghostPhaseMask a (ghostVisitBatchOutput h y D B) := by
  intro p
  by_cases hpD : p ∈ D
  · have hp := hD hpD
    simp only [ghostVisitDeaths, mem_filter, mem_univ, true_and] at hp
    simp [ghostVisitBatchOutput, hpD, hp.1]
  · by_cases hpB : p ∈ B
    · have hp := hB hpB
      simp only [ghostVisitBirths, mem_filter, mem_univ, true_and] at hp
      simp [ghostVisitBatchOutput, hpD, hpB, hp.1]
    · simpa only [ghostVisitBatchOutput, if_neg hpD, if_neg hpB] using hy p

variable {N b : ℕ} (old : Fin N → Σ p, R p)
  (hsupport : univ.image (fun j => (old j).1) = ghostPhasePendingSupport y)
  (hold : ∀ j, y (old j).1 = some (some (some (old j).2)))
  (birth : Fin b → P) (hbirth : univ.image birth = B)

include hD hB hsupport hbirth in
theorem global_birth_visit_output_support :
    univ.image (fun j => ((globalBirthVisitOutput h old D birth).2 j).1) =
      ghostPhasePendingSupport (ghostVisitBatchOutput h y D B) := by
  rw [ghost_visit_batch_pending_support a h y D B hD hB]
  rw [globalBirthVisitOutput, retained_birth_tuple_label_image]
  change (ghostVisitSurvivingIndices old D).image (fun j => (old j).1) ∪
    univ.image birth = _
  rw [hbirth, ← hsupport]
  congr 1
  ext p
  simp only [ghostVisitSurvivingIndices, mem_image, mem_filter, mem_univ, true_and, mem_sdiff]
  constructor
  · rintro ⟨j, hj, rfl⟩
    exact ⟨⟨j, rfl⟩, hj⟩
  · rintro ⟨⟨j, rfl⟩, hj⟩
    exact ⟨j, hj, rfl⟩

include hD hB hold hbirth in
theorem global_birth_visit_output_particle
    (j : Fin (globalBirthVisitOutput h old D birth).1) :
    let q := (globalBirthVisitOutput h old D birth).2 j
    ghostVisitBatchOutput h y D B q.1 = some (some (some q.2)) := by
  dsimp only
  change Fin ((ghostVisitSurvivingIndices old D).card + b) at j
  simp only [globalBirthVisitOutput]
  rw [retained_birth_tuple_apply_index_equiv old (ghostVisitSurvivingIndices old D)
    (fun k => (⟨birth k, h (birth k)⟩ : Σ p, R p)) j]
  generalize he : retainedBirthIndexEquiv (ghostVisitSurvivingIndices old D) b j = k
  cases k with
  | inl k =>
      have hkD : (old k.val).1 ∉ D := by
        simpa only [ghostVisitSurvivingIndices, mem_filter, mem_univ, true_and] using k.property
      have hkB : (old k.val).1 ∉ B := by
        intro hk
        have hb := hB hk
        simp only [ghostVisitBirths, mem_filter, mem_univ, true_and] at hb
        rw [hold k.val] at hb
        simp at hb
      simpa [ghostVisitBatchOutput, hkD, hkB] using hold k.val
  | inr k =>
      have hkB : birth k ∈ B := hbirth ▸ mem_image.mpr ⟨k, mem_univ _, rfl⟩
      have hkD : birth k ∉ D := fun hd =>
        disjoint_left.mp (ghost_visit_eligible_disjoint a h y) (hD hd) (hB hkB)
      simp [ghostVisitBatchOutput, hkD, hkB]

include hy hD hB hsupport hold hbirth in
theorem global_birth_visit_output_readout :
    globalBirthMemoryReadout (ghostPhaseActivitySupport a) (ghostPhaseBornSupport y ∪ B)
      (globalBirthVisitOutput h old D birth) = ghostVisitBatchOutput h y D B := by
  rw [← ghost_visit_batch_born_support a h y D B hD]
  exact global_birth_memory_readout_eq_of_mask a _ (ghost_visit_batch_mask a h y hy D B hD hB)
    _ (global_birth_visit_output_support a h y D B hD hB old hsupport birth hbirth)
    (global_birth_visit_output_particle a h y D B hD hB old hold birth hbirth)

include hB hold hbirth in
omit [∀ p, DecidableEq (R p)] in
theorem global_birth_visit_output_injective
    (hi : Function.Injective (Sigma.fst ∘ old)) (hb : Function.Injective birth) :
    Function.Injective (Sigma.fst ∘ (globalBirthVisitOutput h old D birth).2) := by
  apply retained_birth_tuple_label_injective Sigma.fst old
    (ghostVisitSurvivingIndices old D) (fun j => ⟨birth j, h (birth j)⟩) hi hb
  intro j _ k heq
  have hkB : birth k ∈ B := hbirth ▸ mem_image.mpr ⟨k, mem_univ _, rfl⟩
  have hjB : (old j).1 ∈ B := heq.symm ▸ hkB
  have hj := hB hjB
  simp only [ghostVisitBirths, mem_filter, mem_univ, true_and] at hj
  simp [hold j] at hj

include hD hB hsupport hold hbirth in
theorem global_birth_visit_output_length
    (hi : Function.Injective (Sigma.fst ∘ old)) (hb : Function.Injective birth) :
    (globalBirthVisitOutput h old D birth).1 =
      (ghostPhasePendingSupport (ghostVisitBatchOutput h y D B)).card :=
  ghost_phase_memory_length_eq _ _
    (global_birth_visit_output_injective a h y D B hB old hold birth hbirth hi hb)
    (global_birth_visit_output_support a h y D B hD hB old hsupport birth hbirth)

include hy hD hB hsupport hold hbirth in
theorem global_birth_visit_output_symmetric_readout
    (hi : Function.Injective (Sigma.fst ∘ old)) (hb : Function.Injective birth)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    symmetricPhaseReadout
      (globalBirthMemoryBase (ghostPhaseActivitySupport a) (ghostPhaseBornSupport y ∪ B)) F
      (globalBirthVisitOutput h old D birth) = F (ghostVisitBatchOutput h y D B) := by
  exact symmetric_phase_readout_eq_of_reconstruction _ _ F _
    (global_birth_visit_output_injective a h y D B hB old hold birth hbirth hi hb)
    (global_birth_visit_output_support a h y D B hD hB old hsupport birth hbirth)
    (global_birth_visit_output_readout a h y hy D B hD hB old hsupport hold birth hbirth)

include hy hsupport hold in
theorem global_birth_visit_zeros_eq : globalBirthVisitZeros h old = ghostVisitDeaths a h y := by
  ext p
  simp only [globalBirthVisitZeros, mem_image, mem_filter, mem_univ, true_and,
    ghostVisitDeaths]
  constructor
  · rintro ⟨j, hj, rfl⟩
    have hp : y (old j).1 = some (some (some (h (old j).1))) := by rw [hold j, hj]
    refine ⟨?_, hp⟩
    have hm := hy (old j).1
    rw [hp] at hm
    cases ha : a (old j).1 <;> simp_all
  · rintro ⟨_, hp⟩
    have hmem : p ∈ ghostPhasePendingSupport y := by
      simp only [ghostPhasePendingSupport, mem_filter, mem_univ, true_and]
      exact ⟨h p, hp⟩
    rw [← hsupport] at hmem
    obtain ⟨j, _, rfl⟩ := mem_image.mp hmem
    refine ⟨j, ?_, rfl⟩
    exact Option.some.inj (Option.some.inj (Option.some.inj ((hold j).symm.trans hp)))

end Batch
end

section
open Finset
open scoped Classical
theorem distinct_unrestricted_global_birth_phase_row {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    [∀ p, AddGroup (R p)] [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    {N t : ℕ} (atgt asrc : P → Bool) (delta : (p : P) → R p)
    (w : (p : P) → GhostPhaseState (R p)) (hw : ghostPhaseMask asrc w)
    (source target : Fin t ↪ P)
    (hsource : univ.image source = ghostPhaseActivitySupport asrc \ ghostPhaseActivitySupport atgt)
    (htarget : univ.image target = ghostPhaseNewRunSet atgt asrc)
    (f : DistinctOrderedSupport (Fin N) (ghostPhasePendingSupport w))
    (old : (j : Fin N) → R (f.val j))
    (hold : ∀ j, w (f.val j) = some (some (some (old j))))
    (eligible : Finset (Fin N)) (e : distinctPromotedTargetSlots f.val target ↪ eligible)
    (hmatch : ∀ s : distinctPromotedTargetSlots f.val target, f.val (e s).val = target s.val)
    (hc : ∀ p, ghostPhaseMovingEdgeCompatible (atgt p) (asrc p) (delta p) (w p) = true)
    (β : P → ℝ) (ρ V : ℝ) (B : ℕ)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    unrestrictedEdgeAction source (fun j => (⟨f.val j, old j⟩ : Σ p, R p)) Sigma.fst
      (fun p => ⟨p, 0⟩) (unrestrictedPhaseTransport delta) (fun z => z.2 = 0)
      (fun p => β p / V) ρ V eligible B
      (fun _stores promotions g fresh =>
        if GlobalBirthEdgeEventValid (ghostPhaseBornSupport w) f.val target
          ⟨promotions, g, fresh⟩ then 1 else 0)
      (fun target q => symmetricPhaseReadout
        (globalBirthMemoryBase (ghostPhaseActivitySupport atgt)
          (ghostPhaseBornSupport w ∪ univ.image target)) F q) =
      ∑ z, ((∏ p, (if atgt p && !(asrc p) then V⁻¹ else 1) *
        ghostPhaseDampedMovingEdge (atgt p) (asrc p) (delta p) (β p) ρ ρ (z p) (w p) : ℝ) : ℂ) *
        (if (ghostPhasePendingSupport z).card ≤ B then F z else 0) := by
  simp_rw [global_birth_event_valid_iff_fixed_target atgt asrc delta w hw f target htarget hc]
  have hsrc : ∀ j, asrc (source j) = true ∧ atgt (source j) = false := by
    intro j
    have hj : source j ∈ univ.image source := mem_image.mpr ⟨j, mem_univ _, rfl⟩
    rw [hsource] at hj
    simpa [ghostPhaseActivitySupport] using hj
  have he := distinct_phase_event_selected atgt asrc w hw f target htarget eligible e hmatch
  rw [unrestricted_fixed_target_phase_coefficients atgt asrc delta w hw source target
    (fun j => (hsrc j).1) (fun j => (hsrc j).2) htarget f old hold eligible e hmatch hc β ρ V B
    (fun _ _ _ _ => 1)]
  rw [ghost_phase_measured_edge_complex_slots atgt asrc delta β ρ ρ V w hw source hsource]
  simp only [powerset_univ]
  apply sum_congr rfl
  intro stores _
  simp only [mul_one]
  rw [htarget, global_birth_new_run_update atgt asrc w hw]
  rw [global_birth_selected_edge_symmetric_readout source stores _ atgt asrc delta w hw
    (fun j => (hsrc j).1) (fun j _ => (hsrc j).2) f old e he hold F,
    distinct_unrestricted_output_length source stores _ atgt asrc delta w hw
      (fun j => (hsrc j).1) (fun j _ => (hsrc j).2) f old e he]
  rw [ghost_phase_run_normalized_edge_fresh_measure atgt asrc
    (distinctUnrestrictedStorageChoice source stores) delta β ρ ρ V w hw
      (distinct_unrestricted_storage_allowed source stores atgt asrc
        (fun j => (hsrc j).1) (fun j _ => (hsrc j).2))]
  rfl
end

section
open Finset
open scoped Classical
/- Complex form of the exact measured birth expansion. This is an algebraic
identity with arbitrary coupled continuation, not a norm comparison. -/
theorem ghost_phase_transition_measured_births_complex {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (a : P → Bool) (h : (p : P) → R p) (β : P → ℝ)
    (η V ρ : ℝ) (hV : V ≠ 0)
    (y : (p : P) → GhostPhaseState (R p)) (hy : ghostPhaseMask a y)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    (∑ x, ((∏ p, ghostPhaseDampedVisit (a p) (h p) η (β p) ρ (x p) (y p) : ℝ) : ℂ) * F x) =
      ∑ D ∈ (ghostVisitDeaths a h y).powerset,
        ∑ b ∈ range ((ghostVisitBirths a y).card + 1),
          ∑ f : Fin b ↪ ghostVisitBirths a y,
            ((((-η / ρ) ^ D.card * ((1 - η) / ρ ^ 2) ^ (ghostVisitDeaths a h y \ D).card) *
              ((-η * V / ρ) ^ b * (∏ j, β (f j).val / V)) / (b.factorial : ℝ) : ℝ) : ℂ) *
              F (ghostVisitBatchOutput h y D ((distinctBirthRange f).map
                (Function.Embedding.subtype (fun p => p ∈ ghostVisitBirths a y)))) := by
  have hr (G : ((p : P) → GhostPhaseState (R p)) → ℝ) :=
    ghost_phase_transition_measured_births a h β η V ρ hV y hy G
  apply Complex.ext
  · simpa only [Complex.re_sum, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
      zero_mul, sub_zero, prod_const, sum_div, mul_sum,
      div_mul_eq_mul_div, mul_div_assoc, mul_assoc] using hr (fun x => (F x).re)
  · simpa only [Complex.im_sum, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
      zero_mul, add_zero, prod_const, sum_div, mul_sum,
      div_mul_eq_mul_div, mul_div_assoc, mul_assoc] using hr (fun x => (F x).im)

/- The support in the original pool of an actual ordered birth tuple. -/
noncomputable def globalVisitBirthRange {P : Type*} (U : Finset P) {b : ℕ}
    (f : Fin b ↪ U) : Finset P :=
  (distinctBirthRange f).map (Function.Embedding.subtype (fun p => p ∈ U))

theorem global_visit_birth_range_image {P : Type*} [DecidableEq P]
    (U : Finset P) {b : ℕ} (f : Fin b ↪ U) :
    univ.image (fun j => (f j).val) = globalVisitBirthRange U f := by
  ext p
  simp [globalVisitBirthRange, distinctBirthRange]

theorem global_visit_birth_range_subset {P : Type*}
    (U : Finset P) {b : ℕ} (f : Fin b ↪ U) : globalVisitBirthRange U f ⊆ U := by
  intro p hp
  exact property_of_mem_map_subtype (distinctBirthRange f) hp

/- Literal chronological ghost row with global birth exclusion. Terminations
range over subsets of old hit labels; retained old entries precede new entries.
The memory continuation is the symmetric zero extension of the phase test. -/
noncomputable def globalBirthGhostVisitRow {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, DecidableEq (R p)] {N : ℕ}
    (h : (p : P) → R p) (β : P → ℝ) (η V ρ : ℝ) (cap : ℕ)
    (active H : Finset P) (old : Fin N → Σ p, R p)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) : ℂ :=
  ∑ D ∈ (globalBirthVisitZeros h old).powerset,
    ∑ b ∈ range ((univ \ H).card + 1), ∑ f : Fin b ↪ ↥((univ : Finset P) \ H),
      ((((-η / ρ) ^ D.card * ((1 - η) / ρ ^ 2) ^ (globalBirthVisitZeros h old \ D).card) *
        ((-η * V / ρ) ^ b * (∏ j, β (f j).val / V)) / (b.factorial : ℝ) : ℝ) : ℂ) *
      (if (globalBirthVisitOutput h old D (fun j => (f j).val)).1 ≤ cap then
        symmetricPhaseReadout (globalBirthMemoryBase active
          (H ∪ globalVisitBirthRange (univ \ H) f)) F
          (globalBirthVisitOutput h old D (fun j => (f j).val)) else 0)

/- The exact global-birth-filtered ordered row is the full damped phase
tensor visit with the same output-memory cutoff. No extra old-memory factorial
is inserted, and no completed label may be born again. -/
theorem global_birth_ghost_visit_row_eq {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)] {N : ℕ}
    (a : P → Bool) (h : (p : P) → R p) (β : P → ℝ)
    (η V ρ : ℝ) (hV : V ≠ 0) (cap : ℕ)
    (y : (p : P) → GhostPhaseState (R p)) (hy : ghostPhaseMask a y)
    (old : Fin N → Σ p, R p)
    (hi : Function.Injective (Sigma.fst ∘ old))
    (hsupport : univ.image (fun j => (old j).1) = ghostPhasePendingSupport y)
    (hold : ∀ j, y (old j).1 = some (some (some (old j).2)))
    (H : Finset P) (hH : H = ghostPhaseBornSupport y)
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ) :
    globalBirthGhostVisitRow h β η V ρ cap (ghostPhaseActivitySupport a) H old F =
      ∑ x, ((∏ p, ghostPhaseDampedVisit (a p) (h p) η (β p) ρ (x p) (y p) : ℝ) : ℂ) *
        (if (ghostPhasePendingSupport x).card ≤ cap then F x else 0) := by
  subst H
  have hu := ghost_visit_births_eq_unborn a y hy
  have hz := global_birth_visit_zeros_eq a h y hy old hsupport hold
  rw [ghost_phase_transition_measured_births_complex a h β η V ρ hV y hy]
  unfold globalBirthGhostVisitRow
  rw [hz, ← hu]
  apply sum_congr rfl
  intro D hD
  apply sum_congr rfl
  intro b _
  apply sum_congr rfl
  intro f _
  congr 1
  have hf : Function.Injective (fun j => (f j).val) := by
    intro j k hjk
    exact f.injective (Subtype.ext hjk)
  have hB := global_visit_birth_range_subset (ghostVisitBirths a y) f
  have hbi := global_visit_birth_range_image (ghostVisitBirths a y) f
  have hl := global_birth_visit_output_length a h y D
    (globalVisitBirthRange (ghostVisitBirths a y) f) (mem_powerset.mp hD) hB
    old hsupport hold (fun j => (f j).val) hbi hi hf
  rw [hl]
  have hr := global_birth_visit_output_symmetric_readout a h y hy D
    (globalVisitBirthRange (ghostVisitBirths a y) f) (mem_powerset.mp hD) hB
    old hsupport hold (fun j => (f j).val) hbi hi hf F
  convert congrArg (fun v : ℂ =>
    if (ghostPhasePendingSupport (ghostVisitBatchOutput h y D
      (globalVisitBirthRange (ghostVisitBirths a y) f))).card ≤ cap then v else 0) hr using 1
  congr 1
end

