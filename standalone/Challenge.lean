section

/- Squared Schwartz tails absorb fixed polynomial mean-square costs at a fixed radius exponent. -/

open Filter MeasureTheory Real
namespace Bounty

theorem eventually_schwartz_squared_tail_polynomial (f : SchwartzMap ℝ ℂ)
    {r : ℝ} (hr : 0 < r) (K E F : ℝ) (hK : 0 ≤ K) :
    ∀ᶠ L : ℝ in atTop,
      (∫ u in {u : ℝ | L^r < ‖u‖}, ‖f u‖)^2 * (K*L^E) ≤ L^(-F) := by
  filter_upwards [eventually_schwartz_tail_polynomial f hr 1 0 0 (by norm_num),
    eventually_schwartz_tail_polynomial f hr K E F hK,
    eventually_gt_atTop (0 : ℝ)] with L hsmall hdecay hL
  have ht0 : 0 ≤ ∫ u in {u : ℝ | L^r < ‖u‖}, ‖f u‖ :=
    integral_nonneg (fun _ => norm_nonneg _)
  have ht1 : (∫ u in {u : ℝ | L^r < ‖u‖}, ‖f u‖) ≤ 1 := by
    simpa only [rpow_zero, neg_zero, one_mul, mul_one] using hsmall
  calc
    _ ≤ (∫ u in {u : ℝ | L^r < ‖u‖}, ‖f u‖) * (K*L^E) :=
      mul_le_mul_of_nonneg_right (by nlinarith only [ht0,ht1])
        (mul_nonneg hK (rpow_nonneg hL.le E))
    _ ≤ L^(-F) := by simpa only [mul_assoc] using hdecay

end Bounty
end

section

/- A fixed polynomial factor fits inside any positive linear exponential. -/

open Filter
namespace Bounty

theorem eventually_rpow_le_exp_linear (K : ℝ) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, L^K ≤ Real.exp (ε*L) := by
  filter_upwards [eventually_scaled_log_sublinear (A := max K 0)
    (le_max_right _ _) (s := 0) (by norm_num) hε,
    eventually_ge_atTop (1 : ℝ)] with L hscale hL
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  simp only [Real.rpow_zero, mul_one] at hscale
  rw [Real.rpow_def_of_pos hL0]
  apply Real.exp_le_exp.mpr
  calc
    Real.log L*K = K*Real.log L := mul_comm _ _
    _ ≤ max K 0*Real.log L :=
      mul_le_mul_of_nonneg_right (le_max_left _ _) (Real.log_nonneg hL)
    _ ≤ ε*L := hscale

end Bounty
end

