open Finset
open scoped Classical
theorem unrestricted_residue_eligible_subset_raw_hit {P : Type*} {N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (old : Fin N → UnrestrictedResidueParticle n) :
    unrestrictedResidueEligible n Δ D old ⊆
      globalBirthRawHitIndices (fun p => (Δ : ZMod (n p))) ⟨N, old⟩ := by
  intro j hj
  exact (global_birth_raw_hit_indices_mem (fun p => (Δ : ZMod (n p))) ⟨N, old⟩ j).mpr
    ((mem_unrestrictedResidueEligible n Δ D old j).mp hj).1

theorem global_birth_edge_raw_row_eq_residue_action {P : Type*}
    [Fintype P] [DecidableEq P] {t N : ℕ}
    (n : P → ℕ) (Δ D : ℤ) (source target : Fin t ↪ P)
    (hsource : ∀ i, ¬ (n (source i) : ℤ) ∣ D)
    (htarget : ∀ i, ¬ (n (target i) : ℤ) ∣ D)
    (H : Finset P) (old : Fin N → UnrestrictedResidueParticle n)
    (β : P → ℝ) (ρ V : ℝ) (B : ℕ)
    (F : Finset P → FiniteOrderedTuple (UnrestrictedResidueParticle n) → ℂ) :
    globalBirthEdgeRawRow source target (fun p => (Δ : ZMod (n p))) H old
      (globalBirthRawHitIndices (fun p => (Δ : ZMod (n p))) ⟨N, old⟩) β ρ V B F =
    unrestrictedResidueEdgeAction n Δ D source old (fun p => β p / V) ρ V B
      (fun _stores promotions e fresh =>
        if unrestrictedEdgeTarget old Sigma.fst promotions e fresh = target ∧
          (∀ s, fresh s ∉ H) then 1 else 0)
      (fun target' q => F (H ∪ univ.image target') q) := by
  let small := unrestrictedResidueEligible n Δ D old
  let large := globalBirthRawHitIndices (fun p => (Δ : ZMod (n p))) ⟨N, old⟩
  have hsub : small ⊆ large := unrestricted_residue_eligible_subset_raw_hit n Δ D old
  let phase := fun (_stores promotions : Finset (Fin t))
      (e : promotions ↪ large) (fresh : UnrestrictedFreshLabels P promotions) =>
    if unrestrictedEdgeTarget old Sigma.fst promotions e fresh = target ∧
      (∀ s, fresh s ∉ H) then (1 : ℂ) else 0
  have hz : ∀ stores promotions e fresh,
      (∃ i, (e i).val ∉ small) → phase stores promotions e fresh = 0 := by
    intro stores promotions e fresh he
    obtain ⟨i, hi⟩ := he
    have hn : ¬ (unrestrictedEdgeTarget old Sigma.fst promotions e fresh = target ∧
        (∀ s, fresh s ∉ H)) := by
      intro hv
      apply hi
      apply (mem_unrestrictedResidueEligible n Δ D old _).mpr
      refine ⟨(global_birth_raw_hit_indices_mem _ _ _).mp (e i).property, ?_⟩
      have hlabel : (old (e i).val).1 = target i.val := by
        rw [← hv.1]
        exact (unrestrictedTargetLabels_promoted promotions
          (fun j => (old (e j).val).1) fresh i).symm
      rw [hlabel]
      exact htarget i.val
    exact if_neg hn
  have he := unrestricted_edge_action_restrict_eligibility source old Sigma.fst
    (unrestrictedResidueSeed n) (unrestrictedResidueTransport n Δ)
    unrestrictedResidueHit (fun p => β p / V) ρ V small large hsub B phase hz
    (fun target' q => F (H ∪ univ.image target') q)
  have hs (stores : Finset (Fin t)) :
      unrestrictedResidueStorageAllowed n D source stores := fun i _ => hsource i
  unfold unrestrictedResidueEdgeAction
  simp only [hs, if_true]
  exact he.symm
end

section
open Finset
noncomputable def intervalDivisibilityRemainder (A B d : ℕ) : ℝ :=
  (((Ioc A B).filter (fun n => d ∣ n)).card : ℝ) - ((B : ℝ) - (A : ℝ)) / (d : ℝ)

theorem prime_subset_product_dvd_iff (S : Finset ℕ)
    (hS : ∀ p ∈ S, p.Prime) (n : ℕ) :
    (∏ p ∈ S, p) ∣ n ↔ ∀ p ∈ S, p ∣ n := by
  constructor
  · intro hn p hp
    exact (dvd_prod_of_mem (fun p : ℕ => p) hp).trans hn
  · intro hn
    induction S using Finset.induction_on with
    | empty => simp
    | @insert p S hp ih =>
      rw [prod_insert hp]
      have hpPrime := hS p (mem_insert_self _ _)
      have hSPrime : ∀ q ∈ S, q.Prime := fun q hq => hS q (mem_insert_of_mem hq)
      have hcop : p.Coprime (∏ q ∈ S, q) := by
        apply Nat.Coprime.prod_right
        intro q hq
        exact (Nat.coprime_primes hpPrime (hSPrime q hq)).mpr
          (fun heq => hp (heq ▸ hq))
      exact hcop.mul_dvd_of_dvd_of_dvd (hn p (mem_insert_self _ _))
        (ih hSPrime (fun q hq => hn q (mem_insert_of_mem hq)))

theorem interval_prime_intersection_moment (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (A B : ℕ) (S : Finset ℕ) (hS : S ⊆ P) :
    (∑ _n ∈ (Ioc A B).filter (fun n => ∀ p ∈ S, p ∣ n), (1 : ℝ)) =
      ((B : ℝ) - (A : ℝ)) * (∏ p ∈ S, 1 / (p : ℝ)) +
        intervalDivisibilityRemainder A B (∏ p ∈ S, p) := by
  have hfilter : (Ioc A B).filter (fun n => ∀ p ∈ S, p ∣ n) =
      (Ioc A B).filter (fun n => (∏ p ∈ S, p) ∣ n) := by
    apply filter_congr
    intro n _
    exact (prime_subset_product_dvd_iff S (fun p hp => hP p (hS hp)) n).symm
  have hrecip : (∏ p ∈ S, 1 / (p : ℝ)) = 1 / ((∏ p ∈ S, p : ℕ) : ℝ) := by
    simp only [one_div, prod_inv_distrib, Nat.cast_prod]
  rw [hfilter, hrecip]
  simp only [sum_const, nsmul_eq_mul, mul_one, intervalDivisibilityRemainder]
  ring

theorem interval_divisibility_remainder_abs_le_one (A B d : ℕ)
    (hAB : A ≤ B) (hd : 0 < d) : |intervalDivisibilityRemainder A B d| ≤ 1 :=
  interval_multiples_error_le_one A B d hAB hd

theorem interval_divisibility_remainder_sum_le (P : Finset ℕ)
    (hP : ∀ p ∈ P, p.Prime) (A B : ℕ) (hAB : A ≤ B) (D : ℝ) (hD : 0 ≤ D) :
    (∑ d ∈ blockSieveModuli P D, |intervalDivisibilityRemainder A B d|) ≤ D := by
  calc
    _ ≤ ∑ _d ∈ blockSieveModuli P D, (1 : ℝ) := by
      apply sum_le_sum
      intro d hd
      exact interval_divisibility_remainder_abs_le_one A B d hAB
        (block_sieve_modulus_properties P hP D hd).1
    _ = ((blockSieveModuli P D).card : ℝ) := by simp
    _ ≤ ((Icc 1 ⌊D⌋₊).card : ℝ) := by
      exact_mod_cast card_le_card (filter_subset (fun d => d ∣ ∏ p ∈ P, p) (Icc 1 ⌊D⌋₊))
    _ = (⌊D⌋₊ : ℝ) := by simp
    _ ≤ D := Nat.floor_le hD
end

section
open Finset
theorem exists_reciprocal_prime_sieve_events :
    ∃ K : ℝ, 0 < K ∧
      ∀ {Ω : Type*} (P : Finset ℕ) (T : Finset Ω) (μ : Ω → ℝ)
        (bad : Ω → ℕ → Prop) [∀ t p, Decidable (bad t p)] (r : ℕ → ℝ)
        {z X : ℝ} {h : ℕ},
        1 < z → 0 ≤ X → 1 ≤ h → Even h →
        (∀ p ∈ P, p.Prime) → (∀ p ∈ P, (p : ℝ) ≤ z) →
        (∀ t ∈ T, 0 ≤ μ t) →
        (∀ S ∈ P.powerset,
          (∑ t ∈ T.filter (fun t => ∀ p ∈ S, bad t p), μ t) =
            X * (∏ p ∈ S, 1 / (p : ℝ)) + r (∏ p ∈ S, p)) →
        |(∑ t ∈ T.filter (fun t => ∀ p ∈ P, ¬bad t p), μ t) -
            X * (∏ p ∈ P, (1 - 1 / (p : ℝ)))| ≤
          X * (∏ p ∈ P, (1 - 1 / (p : ℝ))) * K * Real.exp (-(h : ℝ)) +
            ∑ d ∈ blockSieveModuli P (z^(4 * (h : ℝ) + 2)), |r d| := by
  obtain ⟨C, hC, hshell⟩ := exists_finite_prime_reciprocal_shell_bound
  refine ⟨blockSieveModelErrorConstant C (1/2),
    block_sieve_model_error_constant_pos C (1/2), ?_⟩
  intro Ω P T μ bad decBad r z X h hz hX hh heven hP hPz hμ hmoment
  have hg : ∀ p ∈ P, 0 ≤ 1 / (p : ℝ) ∧ 1 / (p : ℝ) ≤ 1 - (1/2 : ℝ) := by
    intro p hp
    have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast (hP p hp).two_le
    refine ⟨by positivity, ?_⟩
    have hb := one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 2) hp2
    norm_num at hb ⊢
    exact hb
  exact finite_prime_sieve_events P T μ bad (fun p => 1 / (p : ℝ)) r
    hz hX hC (by norm_num) hh heven hP hPz hμ hg (hshell P hP) hmoment
end

section
open Finset
theorem prime_predecessor_reciprocal_le_twice {p : ℕ} (hp : p.Prime) :
    1 / ((p : ℝ) - 1) ≤ 2 / (p : ℝ) := by
  have hp2 : (2 : ℝ) ≤ p := by exact_mod_cast hp.two_le
  apply (div_le_div_iff₀ (by linarith) (by linarith)).mpr
  nlinarith

theorem exists_prime_predecessor_reciprocal_shell_bound :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ P : Finset ℕ, (∀ p ∈ P, p.Prime) →
      ∀ w : ℝ, 1 < w →
        (∑ p ∈ P.filter (fun p : ℕ => w < (p : ℝ) ∧ (p : ℝ) ≤ w^2),
          1 / ((p : ℝ) - 1)) ≤ C := by
  obtain ⟨C, hC, hbound⟩ := exists_finite_prime_reciprocal_shell_bound
  refine ⟨2*C, by positivity, ?_⟩
  intro P hP w hw
  calc
    _ ≤ ∑ p ∈ P.filter (fun p : ℕ => w < (p : ℝ) ∧ (p : ℝ) ≤ w^2),
        2 / (p : ℝ) := by
      apply sum_le_sum
      intro p hp
      exact prime_predecessor_reciprocal_le_twice (hP p (mem_filter.mp hp).1)
    _ = 2 * (∑ p ∈ P.filter (fun p : ℕ => w < (p : ℝ) ∧ (p : ℝ) ≤ w^2),
        1 / (p : ℝ)) := by rw [mul_sum]; congr 1; ext p; ring
    _ ≤ 2*C := mul_le_mul_of_nonneg_left (hbound P hP w hw) (by norm_num)

theorem exists_odd_prime_reciprocal_sieve_events :
    ∃ K : ℝ, 0 < K ∧
      ∀ {Ω : Type*} (P : Finset ℕ) (T : Finset Ω) (μ : Ω → ℝ)
        (bad : Ω → ℕ → Prop) [∀ t p, Decidable (bad t p)] (r : ℕ → ℝ)
        {z X : ℝ} {h : ℕ},
        1 < z → 0 ≤ X → 1 ≤ h → Even h →
        (∀ p ∈ P, p.Prime) → (∀ p ∈ P, p ≠ 2) →
        (∀ p ∈ P, (p : ℝ) ≤ z) → (∀ t ∈ T, 0 ≤ μ t) →
        (∀ S ∈ P.powerset,
          (∑ t ∈ T.filter (fun t => ∀ p ∈ S, bad t p), μ t) =
            X * (∏ p ∈ S, 1 / ((p : ℝ) - 1)) + r (∏ p ∈ S, p)) →
        |(∑ t ∈ T.filter (fun t => ∀ p ∈ P, ¬bad t p), μ t) -
            X * (∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1)))| ≤
          X * (∏ p ∈ P, (1 - 1 / ((p : ℝ) - 1))) * K * Real.exp (-(h : ℝ)) +
            ∑ d ∈ blockSieveModuli P (z^(4 * (h : ℝ) + 2)), |r d| := by
  obtain ⟨C, hC, hshell⟩ := exists_prime_predecessor_reciprocal_shell_bound
  refine ⟨blockSieveModelErrorConstant C (1/2),
    block_sieve_model_error_constant_pos C (1/2), ?_⟩
  intro Ω P T μ bad decBad r z X h hz hX hh heven hP hodd hPz hμ hmoment
  have hg : ∀ p ∈ P,
      0 ≤ 1 / ((p : ℝ) - 1) ∧ 1 / ((p : ℝ) - 1) ≤ 1 - (1/2 : ℝ) := by
    intro p hp
    have hp3 : 3 ≤ p := by have := (hP p hp).two_le; have := hodd p hp; omega
    have hp3R : (3 : ℝ) ≤ p := by exact_mod_cast hp3
    have hden : (2 : ℝ) ≤ (p : ℝ) - 1 := by linarith
    refine ⟨by positivity, ?_⟩
    have hb := one_div_le_one_div_of_le (by norm_num : (0 : ℝ) < 2) hden
    norm_num at hb ⊢
    exact hb
  exact finite_prime_sieve_events P T μ bad (fun p => 1 / ((p : ℝ) - 1)) r
    hz hX hC (by norm_num) hh heven hP hPz hμ hg (hshell P hP) hmoment

theorem odd_small_prime_avoidance_iff_rough {z : ℝ} {n : ℕ}
    (hz : 0 ≤ z) (hodd : ¬2 ∣ n) :
    (∀ p ∈ (primeBand 0 z).erase 2, ¬p ∣ n) ↔
      ∀ p ∈ n.primeFactors, z < (p : ℝ) := by
  have hn : n ≠ 0 := by intro hn; subst n; exact hodd (dvd_zero 2)
  rw [← small_prime_avoidance_iff_rough hz hn]
  constructor
  · intro hav p hp
    by_cases hp2 : p = 2
    · simpa only [hp2] using hodd
    · exact hav p (mem_erase.mpr ⟨hp2, hp⟩)
  · intro hav p hp
    exact hav p (mem_of_mem_erase hp)

theorem not_two_dvd_two_mul_add_one (u : ℕ) : ¬2 ∣ 2*u + 1 := by omega

theorem two_mul_add_one_odd_prime_avoidance_iff_rough (u : ℕ) {z : ℝ}
    (hz : 0 ≤ z) :
    (∀ p ∈ (primeBand 0 z).erase 2, ¬p ∣ 2*u + 1) ↔
      ∀ p ∈ (2*u + 1).primeFactors, z < (p : ℝ) :=
  odd_small_prime_avoidance_iff_rough hz (not_two_dvd_two_mul_add_one u)
end

section
open scoped BigOperators Classical
theorem finite_cell_reverse_pairing {X D I : Type*} [Fintype X] [Fintype I]
    [DecidableEq D] (μ : X → ℝ) (cell : X → D) (kept : Finset D)
    (ψ : I → X → ℂ) (k : I) (y : X) (hy : cell y ∈ kept) :
    (∑ x, (μ x : ℂ) * finiteCellFrameKernel μ cell kept ψ x y * (starRingEnd ℂ) (ψ k x)) =
      ∑ x, (finiteCellLaw μ cell (cell y) x : ℂ) * finiteMeasureFrameKernel ψ x y *
        (starRingEnd ℂ) (ψ k x) := by
  apply Finset.sum_congr rfl
  intro x _
  by_cases hxy : cell x = cell y
  · simp only [finiteCellFrameKernel, hxy, hy, and_self, if_true,
      finiteCellLaw]
    push_cast
    ring
  · simp only [finiteCellFrameKernel, hxy, false_and, if_false,
      finiteCellLaw, Complex.ofReal_zero, zero_mul, mul_zero]

theorem finite_cell_character_reproduction {X D I : Type*} [Fintype X] [Fintype I]
    [DecidableEq D] (μ : X → ℝ) (cell : X → D) (kept : Finset D)
    (ψ : I → X → ℂ) (hunit : ∀ i x, μ x ≠ 0 → ‖ψ i x‖ = 1)
    {δ ξ : ℝ} (hδ : 0 ≤ δ) (hξ : 0 < ξ)
    (hkept : ∀ d ∈ kept, ξ ≤ finiteCellMass μ cell d)
    (hraw : ∀ d ∈ kept, ∀ i j, i ≠ j →
      ‖∑ x, if cell x = d then (μ x : ℂ) * (starRingEnd ℂ) (ψ i x) * ψ j x else 0‖ ≤ δ)
    (k : I) (y : X) (hy : cell y ∈ kept) (hψy : ∀ i, ‖ψ i y‖ ≤ 1) :
    ‖(∑ x, (μ x : ℂ) * finiteCellFrameKernel μ cell kept ψ x y * (starRingEnd ℂ) (ψ k x)) -
      (starRingEnd ℂ) (ψ k y)‖ ≤ (Fintype.card I - 1 : ℕ) * (δ / ξ) := by
  rw [finite_cell_reverse_pairing μ cell kept ψ k y hy]
  refine finite_probability_frame_reproduction (finiteCellLaw μ cell (cell y))
    (finite_cell_law_mass μ cell (cell y) (ne_of_gt (hξ.trans_le (hkept _ hy)))) ψ ?_
    (div_nonneg hδ hξ.le) ?_ k y hψy
  · intro i x hx
    apply hunit i x
    intro hzero
    apply hx
    simp only [finiteCellLaw, hzero, zero_div, ite_self]
  · intro i j hij
    exact finite_cell_gram_norm_le μ cell (cell y) ψ i j hδ hξ (hkept _ hy) (hraw _ hy i j hij)
end

