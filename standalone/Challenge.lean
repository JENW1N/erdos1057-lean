/- The inward cutoff permits enlarging the summation domain before Mellin inversion. -/

open Finset Real

namespace Bounty

theorem typeII_window_smooth_nat_support {x δ : ℝ} (hx : 0 < x) (hδ : 0 < δ)
    (u : ℕ) (hu : typeIIWindowSmooth δ ((u : ℝ)/x) ≠ 0) :
    u ∈ arithmeticProductWindow 1 x := by
  have hh := typeII_window_smooth_support hδ hu
  apply (mem_arithmeticProductWindow_iff one_ne_zero x).mpr
  simpa only [one_mul] using
    And.intro ((lt_div_iff₀ hx).mp hh.1) (((div_lt_iff₀ hx).mp hh.2).le)

theorem typeII_smooth_sum_restrict {x δ : ℝ} (hx : 0 < x) (hδ : 0 < δ)
    (S : Finset ℕ) (hS : arithmeticProductWindow 1 x ⊆ S) (a G : ℕ → ℂ) :
    (∑ u ∈ S, a u * (typeIIWindowSmooth δ ((u : ℝ)/x) : ℂ) * G u) =
      ∑ u ∈ arithmeticProductWindow 1 x,
        a u * (typeIIWindowSmooth δ ((u : ℝ)/x) : ℂ) * G u := by
  symm
  apply sum_subset hS
  intro u hu hnot
  have hz : typeIIWindowSmooth δ ((u : ℝ)/x) = 0 := by
    by_contra hn
    exact hnot (typeII_window_smooth_nat_support hx hδ u hn)
  simp only [hz, Complex.ofReal_zero, mul_zero, zero_mul]




end Bounty
