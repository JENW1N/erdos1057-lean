section

/- Applying the smooth spatial partition to the actual determinant support. -/

open Finset

namespace Bounty




theorem typeII_majorant_smooth_partition {y : TypeIIShiftIndex} {L U V E : ℝ}
    (hL : 0 < L) (hU : 0 < U) (hV : 0 < V) (hE : 0 < E)
    (hUV : 4 ≤ U * V) (hk : y.1.1 ≠ 0)
    (hm : (y.2.1.1 : ℝ) ∈ Set.Icc U (2 * U))
    (hm' : (y.2.2.1 : ℝ) ∈ Set.Icc U (2 * U))
    (hz : y.1.2 = y.2.2.1 * y.2.1.2)
    (hne : typeIIEMajorant (L ^ 88) (typeIIRealE y / E) *
      typeIINMajorant (typeIIRealN y / V) ≠ 0) :
    ∑ j ∈ range (⌈Real.logb 2 (192 * L ^ 88)⌉₊ + 1),
      typeIISmoothDyadic ((y.1.2 : ℝ) / (U ^ 2 * V / (16 * E) * 2 ^ j)) = 1 := by
  let Z₀ := U ^ 2 * V / (16 * E)
  have hZ₀ : 0 < Z₀ := by dsimp only [Z₀]; positivity
  have hr := typeII_majorant_cross_scale_range hL hU hV hE hUV hk hm hm' hz hne
  have hlo : 1 ≤ (y.1.2 : ℝ) / Z₀ := (le_div_iff₀ hZ₀).mpr (by simpa using hr.1.le)
  have hhi : (y.1.2 : ℝ) / Z₀ ≤ 192 * L ^ 88 := by
    apply (div_le_iff₀ hZ₀).mpr
    calc
      (y.1.2 : ℝ) ≤ 12 * U ^ 2 * V * L ^ 88 / E := hr.2.le
      _ = (192 * L ^ 88) * Z₀ := by dsimp only [Z₀]; ring
  calc
    _ = ∑ j ∈ range (⌈Real.logb 2 (192 * L ^ 88)⌉₊ + 1),
        typeIISmoothDyadic (((y.1.2 : ℝ) / Z₀) / 2 ^ j) := by
      apply sum_congr rfl
      intro j hj
      congr 1
      dsimp only [Z₀]
      ring
    _ = 1 := typeII_smooth_dyadic_partition_log hlo hhi




end Bounty
end

