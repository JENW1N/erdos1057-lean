lemma kernelTestEnergyDensity_nonneg (f : kernelSmoothTests) (w : HyperbolicSpace) :
    0≤kernelTestEnergyDensity f w := by
  unfold kernelTestEnergyDensity euclideanScalarDirichletDensity
