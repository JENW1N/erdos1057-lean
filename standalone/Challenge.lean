section

/- Global nonprincipal Mellin cancellation for the actual count-matched rough-test proxy. -/

open Finset Filter

namespace Bounty

theorem eventually_rough_test_logarithmic_proxy_mellin_power_bound {a S T γ : ℝ}
    (ha : 0 < a) (hγ : 0 < γ) (hS : 0 ≤ S) (hT : 0 ≤ T) (Bsave : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ∀ (r : ℕ) [NeZero r] (χ : DirichletCharacter ℂ r), χ ≠ 1 → (r : ℝ) ≤ L^T →
      ∀ v : ℝ, |v| ≤ L^T → ∀ m n : ℕ, m ≤ n → Y ≤ (m+1 : ℕ) → (n : ℝ) ≤ 2*Y →
        ‖∑ i ∈ Ioc m n, (roughTestLogarithmicProxy γ L S i : ℂ)*
            harmonicMellinWeight v i*χ (i : ZMod r)‖ ≤ L^(-Bsave) := by
  classical
  have ha2 : 0 < a/2 := by positivity
  filter_upwards [eventually_logarithmic_cell_dyad_bounds ha hS,
    eventually_rough_test_proxy_cell_mellin_power_bound ha2 hγ hT S (Bsave+S+1)]
    with L hcells hlocal
  have hL := hcells.1
  have hδ : 0 < L^(-S) := Real.rpow_pos_of_pos hL _
  intro Y hY r hr χ hχ hrT v hv m n _hmn hYm hn
  let F := Ioc m n
  let f := fun i : ℕ => (roughTestLogarithmicProxy γ L S i : ℂ)*
    harmonicMellinWeight v i*χ (i : ZMod r)
  have hF : ∀ i ∈ F, Y ≤ (i : ℝ) ∧ (i : ℝ) ≤ 2*Y := by
    intro i hi
    exact ⟨hYm.trans (Nat.cast_le.mpr (mem_Ioc.mp hi).1),
      (Nat.cast_le.mpr (mem_Ioc.mp hi).2).trans hn⟩
  obtain ⟨hcount, hbases⟩ := hcells.2 Y hY F hF
  have hYsmall : Real.exp ((a/2)*L) ≤ Y := by
    apply le_trans _ hY
    exact Real.exp_le_exp.mpr (by nlinarith)
  have hfiber : ∀ k ∈ logarithmicCellIndices (L^(-S)) F,
      ‖∑ i ∈ F.filter (fun i => logarithmicCellIndex (L^(-S)) i = k), f i‖ ≤
        L^(-(Bsave+S+1)) := by
    intro k hk
    let Z := logarithmicCellBase (L^(-S)) k
    let lo := max m ⌊Z⌋₊
    let hi := min n ⌊Real.exp (L^(-S))*Z⌋₊
    have heq : (∑ i ∈ F.filter (fun i => logarithmicCellIndex (L^(-S)) i = k), f i) =
        ∑ i ∈ Ioc lo hi, (roughTestCellProxy γ L S Z i : ℂ)*harmonicMellinWeight v i*χ (i : ZMod r) := by
      change (∑ i ∈ (Ioc m n).filter (fun i => logarithmicCellIndex (L^(-S)) i = k), f i) = _
      rw [logarithmic_interval_fiber hδ]
      apply sum_congr rfl
      intro i hiI
      have hiC : i ∈ logarithmicCellSet (L^(-S)) k := mem_Ioc.mpr
        ⟨(le_max_right _ _).trans_lt (mem_Ioc.mp hiI).1,
          (mem_Ioc.mp hiI).2.trans (min_le_right _ _)⟩
      dsimp [f]
      rw [rough_test_logarithmic_proxy_eq_on_cell hL hiC]
    rw [heq]
    by_cases hlohi : lo ≤ hi
    · apply hlocal Y Z hYsmall (hbases k hk) r χ hχ hrT v hv lo hi hlohi
      · exact hYm.trans (Nat.cast_le.mpr (Nat.add_le_add_right (le_max_left _ _) 1))
      · exact (Nat.cast_le.mpr (min_le_left _ _)).trans hn
      · exact le_max_right _ _
      · exact min_le_right _ _
    · rw [Ioc_eq_empty_of_le (by omega : hi ≤ lo), sum_empty, norm_zero]
      positivity
  change ‖∑ i ∈ F, f i‖ ≤ _
  rw [← sum_logarithmic_cell_fibers (L^(-S)) F f]
  calc
    _ ≤ ∑ k ∈ logarithmicCellIndices (L^(-S)) F,
        ‖∑ i ∈ F.filter (fun i => logarithmicCellIndex (L^(-S)) i = k), f i‖ := norm_sum_le _ _
    _ ≤ ∑ _k ∈ logarithmicCellIndices (L^(-S)) F, L^(-(Bsave+S+1)) := sum_le_sum hfiber
    _ = ((logarithmicCellIndices (L^(-S)) F).card : ℝ)*L^(-(Bsave+S+1)) := by
      simp only [sum_const, nsmul_eq_mul]
    _ ≤ L^(S+1)*L^(-(Bsave+S+1)) := mul_le_mul_of_nonneg_right hcount (by positivity)
    _ = L^(-Bsave) := by rw [← Real.rpow_add hL]; congr 1; ring

end Bounty
end

section

/- Principal-character Mellin discrepancy for the actual global rough-test proxy. -/

open Finset Filter

namespace Bounty

theorem eventually_rough_test_proxy_mellin_difference_bound {a S T Bsave γ : ℝ}
    (ha : 0 < a) (hγ : 0 < γ) (hS : 0 ≤ S) (hT : 0 ≤ T) (hprecision : T+Bsave+2 ≤ S) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, Real.exp (a*L) ≤ Y →
      ∀ v : ℝ, |v| ≤ L^T → ∀ m n : ℕ, m ≤ n → Y ≤ (m+1 : ℕ) → (n : ℝ) ≤ 2*Y →
        ‖∑ i ∈ Ioc m n,
          ((roughTestIndicator γ L i-roughTestLogarithmicProxy γ L S i : ℝ) : ℂ)*
            harmonicMellinWeight v i‖ ≤ L^(-Bsave) := by
  filter_upwards [eventually_rough_test_logarithmic_proxy_prefix_bound ha hγ hS,
    eventually_linear_exponential_profile_le_rpow ha ha 20 0 (Bsave+T),
    eventually_ge_atTop (10 : ℝ)] with L hpref hprofile hL10
  have hL : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  intro Y hY v hv m n hmn hYm hn
  have hY0 : 0 < Y := (Real.exp_pos _).trans_le hY
  by_cases heq : m = n
  · subst n
    simp only [Ioc_self, sum_empty, norm_zero]
    positivity
  have hmn' : m < n := lt_of_le_of_ne hmn heq
  let g := fun i : ℕ => ((roughTestIndicator γ L i-roughTestLogarithmicProxy γ L S i : ℝ) : ℂ)
  have hh := norm_harmonic_mellin_interval_sum_le g hY0 hmn' hYm hn
    (v := v) (B := 8*L^(-S)*Y+2) (by positivity)
    (fun i hi => hpref Y hY m i hYm ((Nat.cast_le.mpr (mem_Icc.mp hi).2).trans hn))
  have hpow : 1 ≤ L^T := Real.one_le_rpow hL1 hT
  have hgain : 3+2*|v| ≤ 5*L^T := by nlinarith
  have hfirst : 40*L^T*L^(-S) ≤ L^(-Bsave)/2 := by
    have hcomp : L^(T-S) ≤ L^(-Bsave)/L^2 := by
      rw [show L^(-Bsave)/L^2 = L^(-Bsave+(-2)) by
        rw [Real.rpow_add hL, Real.rpow_neg hL.le]
        norm_num
        ring]
      apply Real.rpow_le_rpow_of_exponent_le hL1
      linarith
    calc
      _ = 40*L^(T-S) := by rw [sub_eq_add_neg, Real.rpow_add hL]; ring
      _ ≤ 40*(L^(-Bsave)/L^2) := mul_le_mul_of_nonneg_left hcomp (by norm_num)
      _ ≤ L^(-Bsave)/2 := by
        have hC : (40 : ℝ)/L^2 ≤ 1/2 := by
          apply (div_le_iff₀ (by positivity : (0 : ℝ) < L^2)).mpr
          nlinarith
        calc
          _ = (40/L^2)*L^(-Bsave) := by ring
          _ ≤ (1/2)*L^(-Bsave) := mul_le_mul_of_nonneg_right hC (by positivity)
          _ = _ := by ring
  have hsecond : 10*L^T/Y ≤ L^(-Bsave)/2 := by
    simp only [zero_mul, add_zero] at hprofile
    have hrecip : 1/Y ≤ Real.exp (-a*L) := by
      have hh := one_div_le_one_div_of_le (Real.exp_pos (a*L)) hY
      simpa only [one_div, Real.exp_neg, neg_mul] using hh
    calc
      _ = (L^T/2)*(20*(1/Y)) := by ring
      _ ≤ (L^T/2)*(20*Real.exp (-a*L)) := by gcongr
      _ ≤ (L^T/2)*L^(-(Bsave+T)) := mul_le_mul_of_nonneg_left hprofile (by positivity)
      _ = L^(-Bsave)/2 := by
        rw [div_mul_eq_mul_div, ← Real.rpow_add hL]
        congr 2
        ring
  calc
    _ = ‖∑ i ∈ Ioc m n, harmonicMellinWeight v i*g i‖ := by
      congr 1
      apply sum_congr rfl
      intro i _
      exact mul_comm _ _
    _ ≤ ((3+2*|v|)/Y)*(8*L^(-S)*Y+2) := hh
    _ ≤ ((5*L^T)/Y)*(8*L^(-S)*Y+2) := by gcongr
    _ = 40*L^T*L^(-S)+10*L^T/Y := by field_simp; ring
    _ ≤ L^(-Bsave)/2+L^(-Bsave)/2 := add_le_add hfirst hsecond
    _ = L^(-Bsave) := by ring

end Bounty
end

