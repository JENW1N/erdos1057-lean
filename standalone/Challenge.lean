      intro I hI hz
      have hh:=FiniteSFactor.mem_fiber.mp hI
      rw [hz] at hh
      simp only [Ideal.absNorm_bot] at hh
      exact hn hh.symm) (by
      intro I hI
      exact_mod_cast (FiniteSFactor.mem_fiber.mp hI).le)
