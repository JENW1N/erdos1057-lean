section

/- Absolute finite factorization and shifted correlation bounds from the divisor fourth moment. -/

open Finset Real

namespace Bounty

noncomputable def factorizationAbsoluteMass (M H : Finset ℕ) (α a : ℕ → ℂ) (z : ℕ) : ℝ :=
  ∑ v ∈ (M ×ˢ H).filter (fun v => v.1*v.2 = z), ‖α v.1 * a v.2‖

theorem factorization_absolute_mass_nonneg (M H : Finset ℕ) (α a : ℕ → ℂ) (z : ℕ) :
    0 ≤ factorizationAbsoluteMass M H α a z := sum_nonneg (fun _ _ => norm_nonneg _)

theorem factorization_absolute_mass_le (M H : Finset ℕ) (α a : ℕ → ℂ)
    {A B : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hα : ∀ m ∈ M, ‖α m‖ ≤ A)
    (ha : ∀ h ∈ H, h ≠ 0 → ‖a h‖ ≤ B*(h.divisors.card : ℝ))
    {z : ℕ} (hz : z ≠ 0) :
    factorizationAbsoluteMass M H α a z ≤ A*B*(z.divisors.card : ℝ)^2 := by
  classical
  let S := (M ×ˢ H).filter (fun v => v.1*v.2 = z)
  have hprod (v : ℕ × ℕ) (hv : v ∈ S) : v.1*v.2 = z := (mem_filter.mp hv).2
  have hc : S.card ≤ z.divisors.card := by
    apply card_le_card_of_injOn Prod.fst
    · intro v hv
      exact Nat.mem_divisors.mpr ⟨⟨v.2, (hprod v hv).symm⟩, hz⟩
    · intro v hv w hw heq
      apply Prod.ext heq
      have hp : v.1 ≠ 0 := by intro h; apply hz; simpa [h] using (hprod v hv).symm
      have hh : v.1*v.2 = v.1*w.2 := by
        simpa only [heq] using (hprod v hv).trans (hprod w hw).symm
      exact Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hp) hh
  have hs : factorizationAbsoluteMass M H α a z ≤ (S.card : ℝ)*(A*B*(z.divisors.card : ℝ)) := by
    unfold factorizationAbsoluteMass
    calc
      _ ≤ ∑ v ∈ S, A*B*(z.divisors.card : ℝ) := by
        apply sum_le_sum
        intro v hv
        have hvp := mem_product.mp (mem_filter.mp hv).1
        have hvz : v.2 ≠ 0 := by intro h; apply hz; simpa [h] using (hprod v hv).symm
        have hd : v.2 ∣ z := ⟨v.1, by simpa [mul_comm] using (hprod v hv).symm⟩
        have hcard : (v.2.divisors.card : ℝ) ≤ z.divisors.card := by
          exact_mod_cast card_le_card (Nat.divisors_subset_of_dvd hz hd)
        rw [norm_mul]
        calc
          _ ≤ A*(B*(v.2.divisors.card : ℝ)) :=
            mul_le_mul (hα v.1 hvp.1) (ha v.2 hvp.2 hvz) (norm_nonneg _) hA
          _ ≤ A*(B*(z.divisors.card : ℝ)) :=
            mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hcard hB) hA
          _ = _ := by ring
      _ = _ := by simp
  calc
    _ ≤ (S.card : ℝ)*(A*B*(z.divisors.card : ℝ)) := hs
    _ ≤ (z.divisors.card : ℝ)*(A*B*(z.divisors.card : ℝ)) := by
      exact mul_le_mul_of_nonneg_right (by exact_mod_cast hc) (by positivity)
    _ = _ := by ring

theorem factorization_absolute_cross_moment {ι : Type*} [DecidableEq ι]
    (S : Finset ι) (f g : ι → ℕ) (N : ℕ)
    (M H : Finset ℕ) (α a : ℕ → ℂ) {A B : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hα : ∀ m ∈ M, ‖α m‖ ≤ A)
    (ha : ∀ h ∈ H, h ≠ 0 → ‖a h‖ ≤ B*(h.divisors.card : ℝ))
    (hf : Set.InjOn f S) (hg : Set.InjOn g S)
    (hf0 : ∀ x ∈ S, f x ≠ 0) (hg0 : ∀ x ∈ S, g x ≠ 0)
    (hfN : ∀ x ∈ S, f x ≤ N) (hgN : ∀ x ∈ S, g x ≤ N) :
    (∑ x ∈ S, factorizationAbsoluteMass M H α a (f x) *
      factorizationAbsoluteMass M H α a (g x)) ≤
      (A*B)^2*(N : ℝ)*(1+log N)^15 := by
  have hmoment := divisor_square_cross_moment S f g N N hf hg hfN hgN
  have hN : 0 ≤ (N : ℝ)*(1+log N)^15 := by
    by_cases h : N = 0
    · simp [h]
    · have hlog : 0 ≤ log (N : ℝ) := log_nonneg (by exact_mod_cast Nat.one_le_iff_ne_zero.mpr h)
      positivity
  rw [← pow_two, sq_sqrt hN] at hmoment
  calc
    _ ≤ ∑ x ∈ S, (A*B)^2*((f x).divisors.card : ℝ)^2*((g x).divisors.card : ℝ)^2 := by
      apply sum_le_sum
      intro x hx
      calc
        _ ≤ (A*B*((f x).divisors.card : ℝ)^2)*(A*B*((g x).divisors.card : ℝ)^2) :=
          mul_le_mul (factorization_absolute_mass_le M H α a hA hB hα ha (hf0 x hx))
            (factorization_absolute_mass_le M H α a hA hB hα ha (hg0 x hx))
            (factorization_absolute_mass_nonneg M H α a (g x)) (by positivity)
        _ = _ := by ring
    _ = (A*B)^2 * ∑ x ∈ S, ((f x).divisors.card : ℝ)^2*((g x).divisors.card : ℝ)^2 := by
      rw [mul_sum]; apply sum_congr rfl; intro x hx; ring
    _ ≤ (A*B)^2*((N : ℝ)*(1+log N)^15) := mul_le_mul_of_nonneg_left hmoment (sq_nonneg _)
    _ = _ := by ring

end Bounty
end

section

/- The actual normalized smooth kernel satisfies the manuscript's quadratic replacement error. -/

open Finset MeasureTheory
open scoped NNReal

namespace Bounty

theorem local_mellin_kernel_unit_support (t : ℝ) (ht : 1 < |t|) :
    localMellinKernelSchwartz t = 0 := by
  change (localMellinKernel t : ℂ) = 0
  rw [local_mellin_kernel_support]
  · norm_num
  · apply lt_trans _ ht
    apply (div_lt_one (by positivity : 0 < 16*Real.pi+1)).mpr
    linarith [Real.pi_gt_three]

theorem normalized_local_kernel_error_bound (S : Finset ℕ) (a : ℕ → ℂ)
    {K : ℝ → ℂ} {C : ℝ≥0} (hK : LipschitzWith C K)
    (hsupp : ∀ t, 1 < |t| → K t = 0) (hS : ∀ n ∈ S, 0 < n)
    {Y H : ℝ} (hY : 0 < Y) (hH : 1 ≤ H) (hsmall : H ≤ Y/8) :
    (∫ v in Set.Icc (Y/2) (3*Y),
      ‖∑ n ∈ S, a n * (K (((n:ℝ)-v)/H) - K (v*Real.log ((n:ℝ)/v)/H))‖^2) / H^2 ≤
        (5120*(C:ℝ)^2) * (H/Y)^2 * (∑ n ∈ S, ‖a n‖^2) := by
  have hHp : 0 < H := lt_of_lt_of_le zero_lt_one hH
  have hi := finite_local_kernel_error_integral S a hK hsupp hS hY hHp hsmall
  apply (div_le_div_of_nonneg_right hi (sq_nonneg H)).trans
  have heq :
      ((4*H+1)*((C:ℝ)*(16*H/Y))^2*(4*H)*(∑ n ∈ S, ‖a n‖^2)) / H^2 =
        1024*(C:ℝ)^2*H*(4*H+1)/Y^2*(∑ n ∈ S, ‖a n‖^2) := by
    field_simp
    ring
  rw [heq]
  have hm : 0 ≤ ∑ n ∈ S, ‖a n‖^2 := sum_nonneg (fun n _ => sq_nonneg _)
  apply mul_le_mul_of_nonneg_right _ hm
  rw [div_pow, ← mul_div_assoc]
  apply (div_le_div_iff_of_pos_right (sq_pos_of_pos hY)).mpr
  nlinarith [mul_nonneg (sq_nonneg (C:ℝ)) (show 0 ≤ H*(H-1) by positivity)]

theorem exists_actual_local_kernel_error_constant :
    ∃ C : ℝ, 0 < C ∧ ∀ (S : Finset ℕ) (a : ℕ → ℂ),
      (∀ n ∈ S, 0 < n) → ∀ Y H : ℝ, 0 < Y → 1 ≤ H → H ≤ Y/8 →
      (∫ v in Set.Icc (Y/2) (3*Y),
        ‖∑ n ∈ S, a n * (localMellinKernelSchwartz (((n:ℝ)-v)/H) -
          localMellinKernelSchwartz (v*Real.log ((n:ℝ)/v)/H))‖^2) / H^2 ≤
          C * (H/Y)^2 * (∑ n ∈ S, ‖a n‖^2) := by
  obtain ⟨K, hK⟩ := local_mellin_kernel_lipschitz
  refine ⟨5120*(K:ℝ)^2+1, by positivity, ?_⟩
  intro S a hS Y H hY hH hsmall
  apply (normalized_local_kernel_error_bound S a hK local_mellin_kernel_unit_support hS hY hH hsmall).trans
  gcongr
  linarith

end Bounty
end

section

/- The weighted Mellin energy is a genuine finite integral for exponents greater than one. -/

open Finset MeasureTheory

namespace Bounty

theorem local_mellin_polynomial_continuous (S : Finset ℕ) (a : ℕ → ℂ) :
    Continuous (localMellinPolynomial S a) := by
  unfold localMellinPolynomial
  fun_prop

theorem local_mellin_polynomial_norm_le (S : Finset ℕ) (a : ℕ → ℂ) (t : ℝ) :
    ‖localMellinPolynomial S a t‖ ≤ ∑ n ∈ S, ‖a n‖ := by
  unfold localMellinPolynomial
  apply (norm_sum_le _ _).trans
  apply sum_le_sum
  intro n hn
  rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]




theorem local_mellin_weighted_energy_integrable (S : Finset ℕ) (a : ℕ → ℂ)
    {h j : ℝ} (hh : 0 < h) (hj : 1 < j) :
    Integrable (fun t : ℝ => (1+|h*t|)^(-j) * ‖localMellinPolynomial S a t‖^2) := by
  have hi : Integrable (fun t : ℝ => (1+|t|)^(-j)) := by
    simpa only [Real.norm_eq_abs] using
      (integrable_one_add_norm (E := ℝ) (r := j) (by simpa using hj))
  have hs := hi.comp_mul_left' hh.ne'
  apply (hs.mul_const ((∑ n ∈ S, ‖a n‖)^2)).mono'
  · have hc : Continuous (fun t : ℝ => (1+|h*t|)^(-j) * ‖localMellinPolynomial S a t‖^2) := by
      have hp := local_mellin_polynomial_continuous S a
      have hb : Continuous (fun t : ℝ => 1+|h*t|) := by fun_prop
      exact (hb.rpow_const (fun t => Or.inl (by positivity))).mul (hp.norm.pow 2)
    exact hc.aestronglyMeasurable
  · filter_upwards [] with t
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    exact mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ (norm_nonneg _) (local_mellin_polynomial_norm_le S a t) 2)
      (Real.rpow_nonneg (by positivity) _)

end Bounty
end

