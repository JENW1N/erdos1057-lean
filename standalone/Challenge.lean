    (measurableSet_ball : MeasurableSet (Metric.ball (0 : E) deltaLoss)).compl
  have hEq :
      Set.EqOn (fun x : E => ENNReal.ofReal (ψ x)) 0 ((Metric.ball (0 : E) deltaLoss)ᶜ) := by
    intro x hx
    simp [hψzero x hx]
