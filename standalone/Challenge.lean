theorem full_active_storage_external_eq_sum
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) (r : R) :
    fullActiveStorageExternal n S B Δ D ω μ ρ V τ f x r =
      fullActiveExternalCoefficientAction n S B A Δ D ω μ ρ V τ
        (fun _ _ e => if (∀ g, (e.2 g).2.1 = ∅) ∧ (∃ g, (e.2 g).1 ≠ ∅)
          then 1 else 0) f x r := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold fullActiveStorageExternal equivExternalFiberAverage finiteExternalFiberAverage
    unrestrictedStorageOnlyProduct fullActiveExternalCoefficientAction
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro a _
  dsimp only
  rw [unrestricted_coupled_cutoff_eq_joint_event_sum]
  simp only [mul_sum, fullActiveEdgeEventWeight, fullActiveEdgeEventTarget,
    Complex.ofReal_mul, mul_assoc]
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _; rfl

theorem full_active_reverse_promotion_external_eq_sum
    (f : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B → R → ℂ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) (r : R) :
    fullActiveReversePromotionExternal n S B Δ D ω μ ρ V τ f x r =
      fullActiveExternalCoefficientAction n S B A (fun c a g => -Δ c a g) D ω μ ρ V
        (fun c a => (τ c a).symm)
        (fun _ _ e => ((∏ g, V g ^ (e.2 g).2.1.card / V g ^ (e.2 g).1.card : ℝ) : ℂ) *
          (if (∀ g, (e.2 g).1 = ∅) ∧ (∃ g, (e.2 g).2.1 ≠ ∅) then 1 else 0))
        f x r := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  unfold fullActiveReversePromotionExternal equivExternalFiberAverage finiteExternalFiberAverage
    unrestrictedReversePromotionOnlyProduct fullActiveExternalCoefficientAction
  rw [Fintype.sum_sigma]
  apply sum_congr rfl
  intro a _
  dsimp only
  rw [unrestricted_coupled_cutoff_eq_joint_event_sum]
  simp only [mul_sum, fullActiveEdgeEventWeight, fullActiveEdgeEventTarget,
    Complex.ofReal_mul, mul_assoc]
  apply sum_congr
  · exact congrArg (fun i : Fintype _ => @Finset.univ _ i) (Subsingleton.elim _ _)
  · intro e _; rfl

