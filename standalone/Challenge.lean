open scoped Classical
def finiteGroupFlattenEquiv {G : Type*} {I X : G → Type*} :
    (∀ g, I g → X g) ≃ (∀ a : Sigma I, X a.1) :=
  (Equiv.piCurry (fun (g : G) (_ : I g) => X g)).symm




theorem finite_group_unflatten_apply {G : Type*} {I X : G → Type*}
    (x : ∀ a : Sigma I, X a.1) (g : G) (i : I g) :
    finiteGroupFlattenEquiv.symm x g i = x ⟨g, i⟩ := rfl

def finiteGroupFlattenFunction {G E : Type*} {I X : G → Type*}
    (f : (∀ g, I g → X g) → E) : (∀ a : Sigma I, X a.1) → E :=
  fun x => f (finiteGroupFlattenEquiv.symm x)










section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  {I X : G → Type*}
  [sharedInstance3 : ∀ g, Fintype (I g)]

include G sharedInstance1 I X sharedInstance3

theorem finite_product_weight_flatten  (μ : ∀ g, X g → ℝ)
    (x : ∀ g, I g → X g) :
    finiteProductWeight (fun a : Sigma I => μ a.1) (finiteGroupFlattenEquiv x) =
      finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g)) x := by
  unfold finiteProductWeight
  exact Fintype.prod_sigma (fun a : Sigma I => μ a.1 (x a.1 a.2))

theorem finite_product_weight_unflatten  (μ : ∀ g, X g → ℝ)
    (x : ∀ a : Sigma I, X a.1) :
    finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))
        (finiteGroupFlattenEquiv.symm x) =
      finiteProductWeight (fun a : Sigma I => μ a.1) x := by
  simpa only [Equiv.apply_symm_apply] using
    (finite_product_weight_flatten μ (finiteGroupFlattenEquiv.symm x)).symm

theorem finite_group_flatten_energy  [∀ g, Fintype (X g)]
    (μ : ∀ g, X g → ℝ) (f : (∀ g, I g → X g) → ℂ) :
    finiteWeightedEnergy (finiteProductWeight (fun a : Sigma I => μ a.1))
        (finiteGroupFlattenFunction f) =
      finiteWeightedEnergy (finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g))) f := by
  have h := (finiteGroupFlattenEquiv (I := I) (X := X)).symm.sum_comp
    (fun x => finiteProductWeight (fun g => finiteProductWeight (fun _ : I g => μ g)) x * ‖f x‖ ^ 2)
  simpa only [finiteWeightedEnergy, finiteGroupFlattenFunction, finite_product_weight_unflatten] using h

end










