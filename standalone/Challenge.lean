/-
# `RellichKondrachov.Analysis.FunctionalSpaces.Sobolev.Euclidean.TranslationEstimateH1`

Extend Euclidean `L²` translation estimates from `C¹_c` to the closure-based Euclidean `H¹` space.

## Main results

- `norm_translateL2_sub_h1ToL2_le`: for `u ∈ H¹`, `‖τ_a u - u‖₂ ≤ ‖a‖ · ‖∇u‖₂`, where `∇u` is the
  `L²(E)` component in our `H¹ ⊆ L² × L²(E)` model.
-/

namespace RellichKondrachov
namespace Analysis
namespace FunctionalSpaces
namespace Sobolev
namespace Euclidean

open scoped ENNReal MeasureTheory Topology
open MeasureTheory Set

noncomputable section

section

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

/- Borel σ-algebra on the model space `E`. -/
abbrev instMeasurableSpaceTranslationEstimateH1 : MeasurableSpace E := borel E







variable (μ : @Measure E (instMeasurableSpaceTranslationEstimateH1 (E := E)))
    [let : MeasurableSpace E := instMeasurableSpaceTranslationEstimateH1 (E := E); μ.IsAddRightInvariant]
    [let : MeasurableSpace E := instMeasurableSpaceTranslationEstimateH1 (E := E); IsFiniteMeasureOnCompacts μ]
    [let : MeasurableSpace E := instMeasurableSpaceTranslationEstimateH1 (E := E); SFinite μ]




end

end

