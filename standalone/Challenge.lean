theorem physical_root_mixed_path_integrand_factor
    {I : Type} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    [∀ a : PhysicalPrime P, NeZero a.2.val]
    (groups : Finset (Fin N)) (patterns : Finset I) (C : I → Fin N → Finset (Fin J))
    (V : Fin N → ℝ) (q : ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ)
    (β : PhysicalPrime P → ℝ) (B : ℕ) (r : PhysicalGroupResidues P groupsᶜ) (θ : ℝ)
    (L : PhysicalMarkLists P J ell)
    (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell) :
    physicalRootMixedPathIntegrand groups patterns C V q ζ k K β B r θ L p =
      (physicalStateMass (fun g : ↥groupsᶜ => V g.val) J ell : ℂ) *
      physicalBareWalkScalar (fun g : ↥groupsᶜ => V g.val) patterns
        (fun i g => C i g.val) (fun _ _ => 0) (fun _ _ _ _ _ => 1)
        (fun j => physicalRestrictedEdge (fun g => g ∈ groupsᶜ) patterns C (finitePathLabels p j))
        (fun j g => finitePathMarks L p j g.val) (n + 1) *
      (∏ j ∈ range (n + 1), physicalMemoryLabeledScalar (fun g : {g // g ∉ groupsᶜ} => V g.val)
        patterns (fun i g => C i g.val) (fun _ => 0)
        (physicalFixedEdgeBigCoefficient (fun g => g ∈ groupsᶜ) patterns C
          (ζ ((n + 1) - 1 - j)) (physicalLocalFourierCoefficient C k K θ ((n + 1) - 1 - j))
          (finitePathLabels p j) (finitePathMarks L p j) (finitePathMarks L p (j + 1)))
        (physicalRestrictedEdge (fun g => g ∉ groupsᶜ) patterns C (finitePathLabels p j))
        (fun g => finitePathMarks L p j g.val) (fun g => finitePathMarks L p (j + 1) g.val)) *
      physicalGroupFiniteVertexWeight groupsᶜ C q k L p r *
      physicalGroupFiniteCappedHistory groups C q k β V B L p := by
  unfold physicalRootMixedPathIntegrand
  rw [← physical_group_path_mass_subtype_factors V groupsᶜ
    (fun j => C (finitePathLabels p j).2.2.1.val) ell (n + 1)]
  rw [physical_group_fourier_fixed_path_factor]

