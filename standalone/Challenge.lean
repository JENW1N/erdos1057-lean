section

/- Fourier moments and uniform truncation for the actual logarithmic window. -/

open MeasureTheory

namespace Bounty

theorem typeII_window_fourier_moment_polynomial (M : ℕ) :
    ∃ (d : ℕ) (C : ℝ), 0 ≤ C ∧ ∀ r : ℝ,
      (∫ ξ : ℝ, ‖ξ‖ ^ M * ‖typeIIWindowFourier r ξ‖) ≤ C * (1 + |r|) ^ d := by
  obtain ⟨R, hR, hs⟩ := typeII_window_support_radius
  exact fourier_domain_moment_polynomial_of_fixed_support typeIIWindowLogSchwartz
    (fun r => 1 + |r|) (fun r => by linarith [abs_nonneg r]) R hR hs
    typeII_window_derivative_polynomial_bound M

theorem typeII_window_fourier_l1_polynomial :
    ∃ (d : ℕ) (C : ℝ), 0 ≤ C ∧ ∀ r : ℝ,
      (∫ ξ : ℝ, ‖typeIIWindowFourier r ξ‖) ≤ C * (1 + |r|) ^ d := by
  simpa only [pow_zero, one_mul] using typeII_window_fourier_moment_polynomial 0

theorem typeII_window_fourier_tail_polynomial (M : ℕ) :
    ∃ (d : ℕ) (C : ℝ), 0 < C ∧ ∀ r R : ℝ, 0 < R →
      (∫ ξ in {ξ : ℝ | R < ‖ξ‖}, ‖typeIIWindowFourier r ξ‖) ≤
        C * (1 + |r|) ^ d * R ^ (-(M : ℝ)) := by
  obtain ⟨d, C, hC, hb⟩ := typeII_window_fourier_moment_polynomial M
  refine ⟨d, C + 1, by linarith, ?_⟩
  intro r R hR
  calc
    _ ≤ (∫ ξ : ℝ, ‖ξ‖^M * ‖typeIIWindowFourier r ξ‖) / R^M :=
      schwartz_norm_tail_le_moment _ M hR
    _ ≤ (C * (1 + |r|)^d) / R^M := div_le_div_of_nonneg_right (hb r) (pow_nonneg hR.le M)
    _ ≤ ((C + 1) * (1 + |r|)^d) / R^M :=
      div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right (by linarith) (by positivity))
        (pow_nonneg hR.le M)
    _ = _ := by rw [Real.rpow_neg hR.le, Real.rpow_natCast, div_eq_mul_inv]

noncomputable def typeIIWindowFourierIntegrand (r s ξ : ℝ) : ℂ :=
  Complex.exp (((2 * Real.pi * ξ * s : ℝ) : ℂ) * Complex.I) * typeIIWindowFourier r ξ

theorem typeII_window_fourier_integrand_norm (r s ξ : ℝ) :
    ‖typeIIWindowFourierIntegrand r s ξ‖ = ‖typeIIWindowFourier r ξ‖ := by
  rw [typeIIWindowFourierIntegrand, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]

theorem typeII_window_fourier_integrand_integrable (r s : ℝ) :
    Integrable (typeIIWindowFourierIntegrand r s) := by
  have hc : Continuous (typeIIWindowFourierIntegrand r s) := by
    unfold typeIIWindowFourierIntegrand
    apply Continuous.mul
    · fun_prop
    · exact (typeIIWindowFourier r).continuous
  apply (typeII_window_fourier_integrable r).norm.mono' hc.aestronglyMeasurable
  exact Filter.Eventually.of_forall (fun ξ => (typeII_window_fourier_integrand_norm r s ξ).le)

theorem typeII_window_fourier_truncation_le_tail (r R s : ℝ) :
    ‖(typeIIWindowLogCutoff r s : ℂ) -
        ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R}, typeIIWindowFourierIntegrand r s ξ‖ ≤
      ∫ ξ in {ξ : ℝ | R < ‖ξ‖}, ‖typeIIWindowFourier r ξ‖ := by
  have hs : MeasurableSet {ξ : ℝ | ‖ξ‖ ≤ R} :=
    (isClosed_le continuous_norm continuous_const).measurableSet
  have heq : {ξ : ℝ | ‖ξ‖ ≤ R}ᶜ = {ξ : ℝ | R < ‖ξ‖} := by ext ξ; simp
  rw [typeII_window_fourier_inversion]
  change ‖(∫ ξ : ℝ, typeIIWindowFourierIntegrand r s ξ) - _‖ ≤ _
  rw [← setIntegral_compl hs (typeII_window_fourier_integrand_integrable r s), heq]
  apply (norm_integral_le_integral_norm _).trans
  exact le_of_eq (integral_congr_ae (Filter.Eventually.of_forall (fun ξ =>
    typeII_window_fourier_integrand_norm r s ξ)))

theorem typeII_window_fourier_truncation_polynomial (M : ℕ) :
    ∃ (d : ℕ) (C : ℝ), 0 < C ∧ ∀ r R : ℝ, 0 < R → ∀ s : ℝ,
      ‖(typeIIWindowLogCutoff r s : ℂ) -
          ∫ ξ in {ξ : ℝ | ‖ξ‖ ≤ R}, typeIIWindowFourierIntegrand r s ξ‖ ≤
        C * (1 + |r|) ^ d * R ^ (-(M : ℝ)) := by
  obtain ⟨d, C, hC, hb⟩ := typeII_window_fourier_tail_polynomial M
  exact ⟨d, C, hC, fun r R hR s =>
    (typeII_window_fourier_truncation_le_tail r R s).trans (hb r R hR)⟩

end Bounty
end

section

/- Absolute finite test mass controls a relative complex coefficient error. -/

open Finset

namespace Bounty

theorem norm_fiber_coefficient_error_le (T : Finset ℕ) (fibers : ℕ → Finset ℕ)
    (a : ℕ → ℝ) (f g : ℕ → ℂ) (F : ℕ → ℕ → ℂ) {err : ℝ}
    (herr : 0 ≤ err) (ha : ∀ u ∈ T, 0 ≤ a u)
    (hfg : ∀ u ∈ T, ‖f u-g u‖ ≤ err*a u) :
    ‖(∑ u ∈ T, f u*∑ m ∈ fibers u, F u m) -
        ∑ u ∈ T, g u*∑ m ∈ fibers u, F u m‖ ≤
      err*(∑ u ∈ T, a u*∑ m ∈ fibers u, ‖F u m‖) := by
  rw [← sum_sub_distrib]
  apply (norm_sum_le _ _).trans
  rw [mul_sum]
  apply sum_le_sum
  intro u hu
  rw [← sub_mul, norm_mul]
  calc
    _ ≤ (err*a u)*(∑ m ∈ fibers u, ‖F u m‖) :=
      mul_le_mul (hfg u hu) (norm_sum_le _ _) (norm_nonneg _) (mul_nonneg herr (ha u hu))
    _ = _ := by ring

end Bounty
end

section

/- The original initial-avoidance and birth-distinctness gates have a single forest expansion on the common address space. -/

open Finset Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))

noncomputable def fullMixedCommonIndexedPerformed
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) : Prop :=
  fullMixedCommonBirthPerformed n S B A Δ D steps x p (fullMixedCommonBirthOrder M B steps i)

noncomputable def fullMixedCommonIndexedValue (encode : ((g : Fin N) × P g) → ℤ)
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)
    (i : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps))) : ℤ :=
  ((fullMixedCommonBirthLabel n S B A Δ D steps x p (fullMixedCommonBirthOrder M B steps i)).map encode).getD 0

variable [∀ g, DecidableEq (P g)]

theorem full_mixed_common_path_forest_expansion {Ω : Type*}
    (paths : Finset Ω)
    (x : Ω → ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : ∀ ω, FullPermutationMixedPath n S B A Δ D steps (x ω))
    (hx : ∀ ω ∈ paths, FullActiveInjective (x ω))
    (encode : ((g : Fin N) × P g) → ℤ) (hencode : Function.Injective encode)
    (w : Ω → ℂ) :
    (∑ ω ∈ paths,
      (if ∀ a z, fullMixedPathBirthLabel n S B A Δ D steps (x ω) (p ω) a = some z →
        z.2 ∉ fullActiveInitialLedger (x ω) z.1 then (1 : ℂ) else 0) *
      (if ∀ a b z, fullMixedPathBirthLabel n S B A Δ D steps (x ω) (p ω) a = some z →
        fullMixedPathBirthLabel n S B A Δ D steps (x ω) (p ω) b = some z → a = b then (1 : ℂ) else 0) * w ω) =
    ∑ code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)),
      (-1 : ℂ) ^ birthForestRank code * birthForestPathSum paths w
        (fun ω => fullMixedCommonIndexedPerformed n S B A Δ D steps (x ω) (p ω))
        (fun ω => fullMixedCommonIndexedValue n S B A Δ D steps encode (x ω) (p ω)) code := by
  have h := initial_birth_path_forest_expansion paths (fullMixedCommonBirthOrder M B steps)
    encode hencode (fun ω => fullMixedCommonInitialPrime (x ω))
    (fun ω => fullMixedCommonPathBirthLabel n S B A Δ D steps (x ω) (p ω)) w
    (fun ω hω => full_mixed_common_initial_injective (x ω) (hx ω hω))
  change _ = ∑ code, (-1 : ℂ) ^ birthForestRank code * birthForestPathSum paths w
    (fun ω => initialBirthIndexedPerformed (fullMixedCommonBirthOrder M B steps)
      (fullMixedCommonInitialPrime (x ω)) (fullMixedCommonPathBirthLabel n S B A Δ D steps (x ω) (p ω)))
    (fun ω => initialBirthIndexedValue (fullMixedCommonBirthOrder M B steps) encode
      (fullMixedCommonInitialPrime (x ω)) (fullMixedCommonPathBirthLabel n S B A Δ D steps (x ω) (p ω))) code
  rw [← h]
  apply sum_congr rfl
  intro ω _
  rw [full_mixed_common_initial_avoidance_iff, full_mixed_common_path_distinct_iff]
  split_ifs <;> rfl

end Full
end Bounty
