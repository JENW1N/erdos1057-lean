section

/- Exact prime products over a selected set of physical groups. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalPrimeGroups {G : Type*} [Fintype G]
    (P : G → Finset ℕ) (groups : Finset G) : Finset (PhysicalPrime P) :=
  univ.filter (fun a => a.1 ∈ groups)

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {P : G → Finset ℕ}

include G sharedInstance1 sharedInstance2 P

theorem physical_prime_groups_prod  (groups : Finset G) (f : PhysicalPrime P → ℝ) :
    (∏ a ∈ physicalPrimeGroups P groups, f a) = ∏ g ∈ groups, ∏ p : ↥(P g), f ⟨g, p⟩ := by
  classical
  simp only [physicalPrimeGroups, prod_filter]
  rw [Fintype.prod_sigma]
  calc
    _ = ∏ g, if g ∈ groups then ∏ p : ↥(P g), f ⟨g, p⟩ else 1 := by
      apply prod_congr rfl
      intro g hg
      by_cases h : g ∈ groups <;> simp [h]
    _ = _ := by rw [← prod_filter]; simp

theorem physical_prime_groups_split  (groups : Finset G) (f : PhysicalPrime P → ℝ) :
    (∏ a : PhysicalPrime P, f a) =
      (∏ a ∈ physicalPrimeGroups P groups, f a) *
      (∏ a ∈ physicalPrimeGroups P groupsᶜ, f a) := by
  classical
  rw [physical_prime_groups_prod, physical_prime_groups_prod, Fintype.prod_sigma]
  exact (prod_mul_prod_compl groups _).symm

theorem physical_selected_group_run_weights  {J ell : ℕ} (groups : Finset G) (V : G → ℝ)
    (L : ℕ → PhysicalMarkLists P J ell) (C : ℕ → G → Finset (Fin J)) (n : ℕ)
    (hnew : ∀ j < n, ∀ g ∈ groups,
      (physicalGroupMarks (L (j + 1)) g \ physicalGroupMarks (L j) g).card =
        ell + (C j g).card) :
    (∏ a ∈ physicalPrimeGroups P groups,
      (V a.1)⁻¹ ^ ghostPhaseRunCount (fun j => decide (a ∈ physicalMarkedPrimes (L j))) n) =
      ∏ g ∈ groups, (1 / V g) ^ ((J + ell) + ∑ j ∈ range n, (ell + (C j g).card)) := by
  classical
  rw [physical_prime_groups_prod]
  apply prod_congr rfl
  intro g hg
  simp only [physical_phase_run_count]
  rw [show (∏ p : ↥(P g), (V g)⁻¹ ^ activeRunCount (fun j => physicalGroupMarks (L j) g) n p.val) =
    ∏ p ∈ P g, (V g)⁻¹ ^ activeRunCount (fun j => physicalGroupMarks (L j) g) n p from
      prod_coe_sort (P g) (fun p => (V g)⁻¹ ^ activeRunCount (fun j => physicalGroupMarks (L j) g) n p)]
  simp only [← one_div]
  rw [prod_pow_eq_pow_sum, physical_group_run_count L C n g (fun j hj => hnew j hj g hg)]

end


end Bounty
end

section

/- Exact group restrictions of the original marks, auxiliary draws, and permutations. -/

open scoped Classical
namespace Bounty
section Groups
variable {G : Type*} (small : G → Prop) (P : G → Finset ℕ) (J ell : ℕ)

noncomputable def physicalMarkGroupSplit :
    PhysicalMarkLists P J ell ≃
      PhysicalMarkLists (fun g : {g // small g} => P g.val) J ell ×
      PhysicalMarkLists (fun g : {g // ¬small g} => P g.val) J ell :=
  Equiv.piEquivPiSubtypeProd small (fun g => PhysicalSlots J ell ↪ ↥(P g))

noncomputable def physicalAuxGroupSplit (C : G → Finset (Fin J)) :
    PhysicalAuxLabels P C ≃
      PhysicalAuxLabels (fun g : {g // small g} => P g.val) (fun g => C g.val) ×
      PhysicalAuxLabels (fun g : {g // ¬small g} => P g.val) (fun g => C g.val) :=
  Equiv.piEquivPiSubtypeProd small (fun g => ↥(C g) → ↥(P g))

noncomputable def physicalPermutationGroupSplit :
    PhysicalPermutations G J ell ≃
      PhysicalPermutations {g // small g} J ell × PhysicalPermutations {g // ¬small g} J ell :=
  Equiv.piEquivPiSubtypeProd small (fun _ => Equiv.Perm (PhysicalSlots J ell))

theorem physical_mark_group_merge_restrict (L : PhysicalMarkLists P J ell) :
    (physicalMarkGroupSplit small P J ell).symm ((fun g => L g.val), (fun g => L g.val)) = L :=
  (physicalMarkGroupSplit small P J ell).symm_apply_apply L

theorem physical_aux_group_merge_restrict (C : G → Finset (Fin J)) (a : PhysicalAuxLabels P C) :
    (physicalAuxGroupSplit small P J C).symm ((fun g => a g.val), (fun g => a g.val)) = a :=
  (physicalAuxGroupSplit small P J C).symm_apply_apply a




theorem physical_permute_group_restrict (σ : PhysicalPermutations G J ell)
    (L : PhysicalMarkLists P J ell) :
    (fun g : {g // small g} => physicalPermuteLabels σ L g.val) =
      physicalPermuteLabels (fun g : {g // small g} => σ g.val) (fun g => L g.val) := rfl

end Groups

section Cardinal
variable {G : Type*} [Fintype G] (small : G → Prop) (J ell : ℕ)

theorem physical_permutation_group_card :
    Fintype.card (PhysicalPermutations G J ell) =
      Fintype.card (PhysicalPermutations {g // small g} J ell) *
        Fintype.card (PhysicalPermutations {g // ¬small g} J ell) := by
