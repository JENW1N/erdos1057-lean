section

/- Polynomial envelopes for the actual finite comparison patterns. -/

open Finset Real
open scoped Classical
namespace Bounty

theorem harmonic_pattern_bound_power {G : Type*} [DecidableEq G]
    {J ell : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G)
    {L q x ξ : ℝ} (hL : 1 ≤ L) (hq : 0 ≤ q) (hx : 0 ≤ x)
    (Q : ℕ) (hQ : (Q : ℝ) ≤ L^q) (hξ : L^(-x) ≤ ξ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t) :
    repeatedBigPrimePatternBound probes r t Q ξ i ≤ L^(4*q+2*x) := by
  have hL0 : 0 < L := lt_of_lt_of_le zero_lt_one hL
  have hξ0 : 0 < ξ := (rpow_pos_of_pos hL0 (-x)).trans_le hξ
  have hQQ : ((Q*Q : ℕ) : ℝ) ≤ L^(2*q) := by
    rw [Nat.cast_mul]
    calc
      _ ≤ L^q*L^q := mul_self_le_mul_self (Nat.cast_nonneg _) hQ
      _ = _ := by rw [← rpow_add hL0]; congr 1; ring
  have hf : ((Q*Q : ℕ) : ℝ)/ξ ≤ L^(2*q+x) := by
    apply (div_le_iff₀ hξ0).mpr
    calc
      _ ≤ L^(2*q) := hQQ
      _ = L^(2*q+x)*L^(-x) := by rw [← rpow_add hL0]; congr 1; ring
      _ ≤ L^(2*q+x)*ξ := mul_le_mul_of_nonneg_left hξ (rpow_nonneg hL0.le _)
  cases i with
  | inl u => exact one_le_rpow hL (by positivity)
  | inr ab =>
      change (((Q*Q : ℕ) : ℝ)/ξ)^2 ≤ _
      calc
        _ ≤ (L^(2*q+x))^2 := by
          simpa only [pow_two] using mul_self_le_mul_self
            (div_nonneg (Nat.cast_nonneg _) hξ0.le) hf
        _ = _ := by rw [pow_two, ← rpow_add hL0]; congr 1; ring

theorem harmonic_pattern_card_power {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    {L A : ℝ} (hL : 2 ≤ L) (hA : 0 ≤ A)
    (hslots : ((J*Fintype.card G : ℕ) : ℝ) ≤ A*log L) :
    (Fintype.card (RepeatedBigPrimePatternIndex (ell := ell) probes r t) : ℝ) ≤
      L^(A*log 2+1) := by
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hc : Fintype.card (RepeatedBigPrimePatternIndex (ell := ell) probes r t) ≤
      1+2^(J*Fintype.card G) := by
    simpa only [RepeatedBigPrimePatternIndex, Fintype.card_sum, Fintype.card_unit, Fintype.card_fin] using
      Nat.add_le_add_left (repeated_big_prime_pattern_pair_card_le_groups (ell := ell)
        probes r t hrt (fun _ => card_le_univ _)) 1
  have hp : (2 : ℝ)^(J*Fintype.card G) ≤ L^(A*log 2) := by
    calc
      _ = exp (log 2*((J*Fintype.card G : ℕ) : ℝ)) := by
        rw [← rpow_natCast, rpow_def_of_pos (by norm_num : (0 : ℝ) < 2)]
      _ ≤ exp (log 2*(A*log L)) := exp_le_exp.mpr
        (mul_le_mul_of_nonneg_left hslots (log_nonneg (by norm_num)))
      _ = _ := by rw [rpow_def_of_pos hL0]; congr 1; ring
  have hone : 1 ≤ L^(A*log 2) := one_le_rpow hL1 (mul_nonneg hA (log_nonneg (by norm_num)))
  calc
    _ ≤ (1 : ℝ)+2^(J*Fintype.card G) := by exact_mod_cast hc
    _ ≤ 1+L^(A*log 2) := add_le_add le_rfl hp
    _ ≤ L^(A*log 2)+L^(A*log 2) := add_le_add hone le_rfl
    _ = 2*L^(A*log 2) := by ring
    _ ≤ L*L^(A*log 2) := mul_le_mul_of_nonneg_right hL (rpow_nonneg hL0.le _)
    _ = L^(A*log 2+1) := by
      nth_rw 1 [← rpow_one L]
      rw [← rpow_add hL0]
      congr 1
      ring

end Bounty
