open Finset Classical
noncomputable def physicalGhostRetention {P : Type*} (n : P → ℕ) (q ρ : ℝ)
    (z : UnrestrictedResidueParticle n) : ℝ :=
  if unrestrictedResidueHit z then q / ρ ^ 2 else 1

noncomputable def physicalGhostTermination {P : Type*} (n : P → ℕ) (q ρ : ℝ)
    (z : UnrestrictedResidueParticle n) : ℝ :=
  if unrestrictedResidueHit z then -((1 - q) / ρ) else 0

noncomputable def physicalGhostBirth {P : Type*} (n : P → ℕ) (q ρ V : ℝ)
    (z : UnrestrictedResidueParticle n) : ℝ :=
  if unrestrictedResidueHit z then -((1 - q) * V / ρ) else 0




theorem physical_ghost_exponent_eq {P : Type*} [Fintype P]
    (n : P → ℕ) [∀ p, NeZero (n p)] (μ : P → ℝ)
    (q ρ V v : ℝ) (hq : q ≤ 1) (hρ : 0 ≤ ρ) (hV : 0 ≤ V) :
    (∑ z : UnrestrictedResidueParticle n,
      (|physicalGhostBirth n q ρ V z| + |physicalGhostTermination n q ρ z|) *
        unrestrictedResidueWeight μ z * v) =
      ((1 - q) * V / ρ + (1 - q) / ρ) * v * ∑ p, μ p := by
  have hη : 0 ≤ 1 - q := sub_nonneg.mpr hq
  have hD : 0 ≤ (1 - q) / ρ := div_nonneg hη hρ
  have hC : 0 ≤ (1 - q) * V / ρ := div_nonneg (mul_nonneg hη hV) hρ
  rw [Fintype.sum_sigma]
  calc
    _ = ∑ p, (((1 - q) * V / ρ + (1 - q) / ρ) * μ p * v) := by
      apply sum_congr rfl
      intro p _
      rw [sum_eq_single (0 : ZMod (n p))]
      · simp [physicalGhostBirth, physicalGhostTermination, unrestrictedResidueHit,
          unrestrictedResidueWeight, abs_of_nonneg hC, abs_of_nonneg hD]
      · intro r _ hr
        simp [physicalGhostBirth, physicalGhostTermination, unrestrictedResidueHit, hr]
      · simp
    _ = _ := by
      rw [mul_sum]
      apply sum_congr rfl
      intro p _
      ring







/- A group-independent energy constant, independent of memory cutoff and
the number or sizes of the prime moduli. -/
noncomputable def physicalGhostUniformEnergyBound (ρ vmax v : ℝ) : ℝ :=
  Real.exp (2 * (vmax + 1) * v / ρ)



end

