  let phi (s:CubeResidueStrata p):=w s.1*cubeStratumSymbol p ((A:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) 1 0) s.1 s.2
  have hpoint (r:(_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {p^3}):
      w (d r).exponent*complexCharacter ⟨(d r).matrix*(A:SL(2,(_root_.OAI.ActualEisensteinCubic.O)))⁻¹,(d r).congruent⟩=
        phi (e.symm (a r)) := by
