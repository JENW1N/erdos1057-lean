theorem unramifiedGaussResidue_nine_family (h:_root_.OAI.ActualEisensteinCubic.O) (u:_root_.OAI.ActualEisensteinCubic.Oˣ) (n:ℕ) :
    ∃j k:Fin 3,unramifiedGaussResidue (h*(9*((u:_root_.OAI.ActualEisensteinCubic.O)*lambda^n)))=
      unramifiedGaussResidue (h*omega^j.val*lambda^k.val) := by
  obtain ⟨j,k,hjk⟩:=unramifiedCubicGaussSeries_nine_family h u n
  exact ⟨j,k,unramifiedGaussResidue_eq_of_initial_eq _ _ (fun s _ _=>hjk s)⟩

