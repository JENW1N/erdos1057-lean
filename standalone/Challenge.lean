section

/- The literal mixed event row factors between the two actual small
conditioning maps. This is an equality for the genuine residue-valid small
measure, with all big event coefficients and targets retained. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def physicalSmallBigPrefixAction {S X : Type*} [Fintype S]
    {P : S → Finset ℕ} {J : ℕ}
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (F : PhysicalSharedLists P J → X → PhysicalResidues P → ℂ)
    (d : PhysicalSharedLists P J) (x : X) (r : PhysicalResidues P) : ℂ :=
  ∑ e : E d x, a r d x e *
    F d (target d x e) (physicalTranslateResidues r (k x * (physicalSharedProduct d : ℕ)))

theorem physical_small_big_action_invalid {S X : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ}
    (V : S → ℝ) (q ζ : ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (F : PhysicalSmallBigState P J ell X → ℂ) (s : PhysicalSmallBigState P J ell X)
    (h : ¬physicalResidueMarksValid s.1.1 s.1.2) :
    physicalSmallBigAction V q ζ aux κ E target a k F s = 0 := by
  simp only [physicalSmallBigAction, physicalSmallBigEventWeight,
    physicalResidueVertexWeight, if_neg h, zero_mul, Complex.ofReal_zero,
    mul_zero, sum_const_zero]

theorem physical_small_big_pairing
    {S X : Type*} [Fintype S] [dS : DecidableEq S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (q ζ : ℝ) (W : X → ℝ)
    (aux : PhysicalAuxLabels P (fun _ => (∅ : Finset (Fin J))))
    (κ : PhysicalSharedLists P J → ℂ)
    (E : PhysicalSharedLists P J → X → Type*) [∀ d x, Fintype (E d x)]
    (target : ∀ d x, E d x → X)
    (a : PhysicalResidues P → ∀ d x, E d x → ℂ) (k : X → ℤ)
    (u F : PhysicalSmallBigState P J ell X → ℂ) :
    (∑ s, (physicalSmallBigMeasure V W s : ℂ) * (starRingEnd ℂ) (u s) *
      physicalSmallBigAction V q ζ aux κ E target a k F s) =
      ∑ d, ∑ r, ∑ x, (W x : ℂ) *
        (starRingEnd ℂ) (physicalSmallBigCondition V q u d x r) *
        (κ d * physicalPhase ζ (physicalSharedProduct d) *
          physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F) d x r) := by
  cases Subsingleton.elim dS (Classical.typeDecidableEq S)
  rw [Fintype.sum_prod_type, sum_comm]
  have hx : (∑ x, ∑ s : PhysicalBareResidueState P J ell,
      (physicalSmallBigMeasure V W (s, x) : ℂ) * (starRingEnd ℂ) (u (s, x)) *
        physicalSmallBigAction V q ζ aux κ E target a k F (s, x)) =
      ∑ x, ∑ r, ∑ d, (W x : ℂ) *
        (starRingEnd ℂ) (physicalSmallBigCondition V q u d x r) *
        (κ d * physicalPhase ζ (physicalSharedProduct d) *
          physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F) d x r) := by
    apply sum_congr rfl
    intro x _
    rw [Fintype.sum_prod_type]
    apply sum_congr rfl
    intro r _
    have h := physical_small_big_action_bilinear V hV q ζ aux κ E target a k
      (fun L => u ((r, L), x)) F r x
    change _ = _ at h
    have hleft : (∑ L, (physicalSmallBigMeasure V W ((r, L), x) : ℂ) *
        (starRingEnd ℂ) (u ((r, L), x)) *
        physicalSmallBigAction V q ζ aux κ E target a k F ((r, L), x)) =
        (W x : ℂ) * ∑ L, (physicalStateMass V J ell : ℂ) *
          (starRingEnd ℂ) (u ((r, L), x)) *
          physicalSmallBigAction V q ζ aux κ E target a k F ((r, L), x) := by
      rw [mul_sum]
      apply sum_congr rfl
      intro L _
      by_cases hv : physicalResidueMarksValid r L
      · simp only [physicalSmallBigMeasure, if_pos hv, Complex.ofReal_mul]
        ring
      · rw [physical_small_big_action_invalid V q ζ aux κ E target a k F ((r, L), x) hv]
        simp only [mul_zero]
    rw [hleft]
    erw [h]
    simp only [mul_sum, physicalSmallBigCondition, physicalSmallBigPrefixAction]
    apply sum_congr rfl
    intro d _
    ring_nf
  erw [hx]
  calc
    (∑ x, ∑ r, ∑ d, (W x : ℂ) *
      (starRingEnd ℂ) (physicalSmallBigCondition V q u d x r) *
      (κ d * physicalPhase ζ (physicalSharedProduct d) *
        physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F) d x r)) =
      ∑ x, ∑ d, ∑ r, (W x : ℂ) *
      (starRingEnd ℂ) (physicalSmallBigCondition V q u d x r) *
      (κ d * physicalPhase ζ (physicalSharedProduct d) *
        physicalSmallBigPrefixAction E target a k (physicalSmallBigCondition V q F) d x r) := by
      apply sum_congr rfl
      intro x _
      exact sum_comm
    _ = _ := by
      rw [sum_comm]
      apply sum_congr rfl
      intro d _
      exact sum_comm

end Bounty
end

section

/- Small-slot permutations preserve the actual mixed measure: the big
state and small residues stay fixed, and only the injective small mark list
is reordered. This is the isometry used before omission averaging. -/

open Finset
open scoped Classical

namespace Bounty

theorem physical_residue_marks_valid_permute {S : Type*}
    {P : S → Finset ℕ} {J ell : ℕ} (σ : PhysicalPermutations S J ell)
    (r : PhysicalResidues P) (L : PhysicalMarkLists P J ell) :
    physicalResidueMarksValid r (physicalPermuteLabels σ L) ↔ physicalResidueMarksValid r L := by
  constructor
  · intro h g s
    obtain ⟨t, rfl⟩ := (σ g).surjective s
    exact h g t
  · intro h g s
    exact h g (σ g s)

def physicalSmallBigPermutation {S X : Type*} {P : S → Finset ℕ} {J ell : ℕ}
    (σ : PhysicalPermutations S J ell) :
    PhysicalSmallBigState P J ell X ≃ PhysicalSmallBigState P J ell X where
  toFun s := ((s.1.1, physicalPermuteLabels σ s.1.2), s.2)
  invFun s := ((s.1.1, physicalPermuteLabels (fun g => (σ g).symm) s.1.2), s.2)
  left_inv s := by
    apply Prod.ext
    · apply Prod.ext
      · rfl
      · funext g
        apply Function.Embedding.ext
        intro i
        change s.1.2 g (σ g ((σ g).symm i)) = s.1.2 g i
        rw [Equiv.apply_symm_apply]
    · rfl
  right_inv s := by
    apply Prod.ext
    · apply Prod.ext
      · rfl
      · funext g
        apply Function.Embedding.ext
        intro i
        change s.1.2 g ((σ g).symm (σ g i)) = s.1.2 g i
        rw [Equiv.symm_apply_apply]
    · rfl

theorem physical_small_vertex_permutation {S : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ} (σ : PhysicalPermutations S J ell)
    (r : PhysicalResidues P) (L : PhysicalMarkLists P J ell) (q : ℝ) :
    physicalResidueVertexWeight (physicalPermuteLabels σ L) q r =
      physicalResidueVertexWeight L q r := by
  simp only [physicalResidueVertexWeight, physical_residue_marks_valid_permute]

theorem physical_small_big_permutation_measure {S X : Type*} [Fintype S]
    {P : S → Finset ℕ} {J ell : ℕ} (V : S → ℝ) (W : X → ℝ)
    (σ : PhysicalPermutations S J ell) (s : PhysicalSmallBigState P J ell X) :
    physicalSmallBigMeasure V W (physicalSmallBigPermutation σ s) =
      physicalSmallBigMeasure V W s := by
  change (if physicalResidueMarksValid s.1.1 (physicalPermuteLabels σ s.1.2)
    then physicalStateMass V J ell * W s.2 else 0) = _
  rw [physical_residue_marks_valid_permute]
  rfl

theorem physical_small_big_permutation_energy {S X : Type*} [Fintype S] [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (W : X → ℝ) (σ : PhysicalPermutations S J ell)
    (f : PhysicalSmallBigState P J ell X → ℂ) :
    physicalSmallBigEnergy V W (fun s => f (physicalSmallBigPermutation σ s)) =
      physicalSmallBigEnergy V W f := by
  rw [← physical_small_big_energy_eq, ← physical_small_big_energy_eq]
  have h := (physicalSmallBigPermutation (P := P) (X := X) σ).sum_comp
    (fun s => physicalSmallBigMeasure V W s * ‖f s‖ ^ 2)
  simpa only [finiteWeightedEnergy, physical_small_big_permutation_measure] using h

end Bounty
end

section

/- Uniform prime-weighted Buchstab kernels and finite-depth induction geometry. -/

namespace Bounty

open Finset Filter Real MeasureTheory
open scoped Topology

noncomputable def buchstabDepthExtendedKernel (n : ℕ) (w α : ℝ) : ℝ :=
  buchstabDepthDensity n α (max (w/2) (w-α))

theorem buchstab_depth_extended_kernel_continuous (n : ℕ) :
    ContinuousOn (fun p : ℝ × ℝ => buchstabDepthExtendedKernel n p.1 p.2)
      {p | 0 < p.1 ∧ 0 < p.2} := by
  apply (buchstab_depth_density_continuous n).comp
    (show ContinuousOn (fun p : ℝ × ℝ => (p.2, max (p.1/2) (p.1-p.2)))
      {p | 0 < p.1 ∧ 0 < p.2} by fun_prop)
  intro p hp
  exact ⟨hp.2, (half_pos hp.1).trans_le (le_max_left _ _)⟩

theorem buchstab_depth_extended_kernel_eq (n : ℕ) {w α : ℝ} (hα : α ≤ w/2) :
    buchstabDepthExtendedKernel n w α = buchstabDepthDensity n α (w-α) := by
  unfold buchstabDepthExtendedKernel
  rw [max_eq_right (by linarith)]

theorem buchstab_depth_extended_integral (n : ℕ) (γ w : ℝ) :
    (∫ α in γ..max γ (w/2), buchstabDepthExtendedKernel n w α/α) =
      buchstabDepthDensity (n+1) γ w-1/w := by
  rw [buchstabDepthDensity, add_sub_cancel_left]
  by_cases hhalf : w/2 ≤ γ
  · simp only [max_eq_left hhalf, intervalIntegral.integral_same]
  · have hhalf' : γ ≤ w/2 := (lt_of_not_ge hhalf).le
    rw [max_eq_right hhalf']
    apply intervalIntegral.integral_congr
    intro α hα
    have hα' : α ≤ w/2 := (show α ∈ Set.Icc γ (w/2) by
      simpa only [Set.uIcc_of_le hhalf'] using hα).2
    change buchstabDepthExtendedKernel n w α/α = buchstabDepthDensity n α (w-α)/α
    rw [buchstab_depth_extended_kernel_eq n hα']

theorem buchstab_depth_prime_kernel_uniform_error (n : ℕ)
    {a b γ₀ : ℝ} (ha : 0 < a) (hγ₀ : 0 < γ₀) (hγb : γ₀ < b)
    {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ w γ : ℝ, a ≤ w → w ≤ b → γ₀ ≤ γ → γ ≤ w →
      |(∑ p ∈ primeBand (exp (γ*L)) (exp (max γ (w/2)*L)),
        buchstabDepthExtendedKernel n w (log (p : ℝ)/L)/(p : ℝ)) -
        (buchstabDepthDensity (n+1) γ w-1/w)| < ε := by
  have hc : ContinuousOn (fun p : ℝ × ℝ => buchstabDepthExtendedKernel n p.1 p.2)
      ((Set.Icc a b) ×ˢ (Set.Icc γ₀ b)) := by
    apply (buchstab_depth_extended_kernel_continuous n).mono
    intro p hp
    exact ⟨ha.trans_le hp.1.1, hγ₀.trans_le hp.2.1⟩
  filter_upwards [exponential_prime_weighted_reciprocal_uniform_error hγ₀ hγb
    (fun p : ℝ × ℝ => buchstabDepthExtendedKernel n p.1 p.2) hc hε] with L hL
  intro w γ haw hwb hγ hγw
  have hmax : max γ (w/2) ≤ b := max_le (hγw.trans hwb) (by linarith)
  have hh := hL w ⟨haw,hwb⟩ γ (max γ (w/2)) hγ (le_max_left _ _) hmax
  rw [buchstab_depth_extended_integral] at hh
  exact hh

theorem buchstab_good_cofactor_domain (n : ℕ)
    {a b γ₀ γ w α η δ : ℝ}
    (hη : 0 ≤ η) (haw : a ≤ w) (hwb : w ≤ b) (hγ₀ : γ₀ ≤ γ)
    (hγα : γ ≤ α) (hα : α ≤ w/2-η)
    (htop : w+δ ≤ ((n : ℝ)+3)*γ) :
    a/2 ≤ w-α ∧ w-α ≤ b-γ₀ ∧ γ₀ ≤ α ∧
      2*η ≤ (w-α)-α ∧ w-α+δ ≤ ((n : ℝ)+2)*α := by
  have hn : 0 ≤ (n : ℝ)+3 := by positivity
  have hm := mul_le_mul_of_nonneg_left hγα hn
  constructor
  · linarith
  constructor
  · linarith
  constructor
  · exact hγ₀.trans hγα
  constructor <;> linarith

theorem exponential_prime_band_short_interval_bound
    {a η ε : ℝ} (ha : 0 < a) (hη : 0 ≤ η) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ u v : ℝ, a ≤ u → u ≤ v → v-u ≤ η →
      primeBandHarmonic (exp (u*L)) (exp (v*L)) ≤ η/a+ε := by
  filter_upwards [exponential_prime_band_harmonic_uniform_error ha hε] with L hL
  intro u v hau huv hwidth
  have hu := ha.trans_le hau
  have hv := hu.trans_le huv
  have hlog : log (v/u) ≤ (v-u)/u := by
    have h := log_le_sub_one_of_pos (div_pos hv hu)
    convert h using 1; field_simp
  have hr : (v-u)/u ≤ η/a := by
    exact (div_le_div_of_nonneg_right hwidth hu.le).trans
      (div_le_div_of_nonneg_left hη ha hau)
  have he := (abs_lt.mp (hL u v hau huv)).2
  linarith

theorem exponential_prime_log_coordinate {L p : ℝ} (hL : L ≠ 0) (hp : 0 < p) :
    exp ((log p/L)*L) = p := by rw [div_mul_cancel₀ _ hL, exp_log hp]

theorem exponential_cofactor_log_coordinate (w : ℝ) {L p : ℝ}
    (hL : L ≠ 0) (hp : 0 < p) :
    exp (w*L)/p = exp ((w-log p/L)*L) := by
  rw [sub_mul, exp_sub, exponential_prime_log_coordinate hL hp]

end Bounty

/- Public declaration closure audit. -/
end

section

/- Finite upper meshes for the continuous Buchstab density, with logarithmic bin weights. -/

open Finset Filter MeasureTheory
open scoped Topology

namespace Bounty

theorem reciprocal_grid_strict_step {a b : ℝ} (hab : a < b) {N : ℕ} (hN : 0 < N) (i : ℕ) :
    reciprocalGrid a b N (i : ℕ) < reciprocalGrid a b N ((i : ℕ) + 1) := by
  have hstep := reciprocal_grid_step a b N (i : ℕ)
  have hp : 0 < (b - a) / (N : ℝ) := div_pos (sub_pos.mpr hab) (Nat.cast_pos.mpr hN)
  linarith

theorem reciprocal_grid_log_weight_sum {a b : ℝ} (ha : 0 < a) (hab : a ≤ b)
    {N : ℕ} (hN : 0 < N) :
    (∑ i ∈ range N, Real.log (reciprocalGrid a b N ((i : ℕ) + 1) / reciprocalGrid a b N (i : ℕ))) =
      Real.log (b / a) := by
  have hlog : ∀ i ∈ range N,
      Real.log (reciprocalGrid a b N ((i : ℕ) + 1) / reciprocalGrid a b N (i : ℕ)) =
        Real.log (reciprocalGrid a b N ((i : ℕ) + 1)) - Real.log (reciprocalGrid a b N (i : ℕ)) := by
    intro i hi
    have hleft := ha.trans_le (reciprocal_grid_mem hab hN (mem_range.mp hi).le).1
    have hright := ha.trans_le (reciprocal_grid_mem hab hN (Nat.succ_le_of_lt (mem_range.mp hi))).1
    exact Real.log_div hright.ne' hleft.ne'
  rw [sum_congr rfl hlog, sum_range_adjacent_real_difference (fun i => Real.log (reciprocalGrid a b N (i : ℕ))) N,
    reciprocal_grid_zero, reciprocal_grid_end a b hN,
    Real.log_div (ha.trans_le hab).ne' ha.ne']

theorem exists_square_reciprocal_grid_oscillation {a b : ℝ} (hab : a < b)
    (F : ℝ × ℝ → ℝ) (hF : ContinuousOn F (Set.Icc a b ×ˢ Set.Icc a b))
    {η : ℝ} (hη : 0 < η) :
    ∃ N : ℕ, 0 < N ∧ ∀ i : ℕ, i < N →
      ∀ x ∈ Set.Icc (reciprocalGrid a b N (i : ℕ)) (reciprocalGrid a b N ((i : ℕ) + 1)),
        |F (reciprocalGrid a b N (i : ℕ), x) - F (reciprocalGrid a b N (i : ℕ), reciprocalGrid a b N (i : ℕ))| ≤ η ∧
        |F (x, x) - F (reciprocalGrid a b N (i : ℕ), reciprocalGrid a b N (i : ℕ))| ≤ η := by
  have hu := (isCompact_Icc.prod isCompact_Icc).uniformContinuousOn_of_continuous hF
  obtain ⟨δ, hδ, hclose⟩ := Metric.uniformContinuousOn_iff_le.mp hu η hη
  obtain ⟨N, hN⟩ := exists_nat_gt ((b - a) / δ)
  have hN0 : 0 < N := by
    have hh : (0 : ℝ) < N := (div_pos (sub_pos.mpr hab) hδ).trans hN
    exact_mod_cast hh
  have hstep : (b - a) / (N : ℝ) ≤ δ := by
    apply (div_le_iff₀ (Nat.cast_pos.mpr hN0)).mpr
    have hh := (div_lt_iff₀ hδ).mp hN
    nlinarith
  refine ⟨N, hN0, ?_⟩
  intro i hi x hx
  have hleft := reciprocal_grid_mem hab.le hN0 hi.le
  have hright := reciprocal_grid_mem hab.le hN0 (Nat.succ_le_of_lt hi)
  have hxmem : x ∈ Set.Icc a b := ⟨hleft.1.trans hx.1, hx.2.trans hright.2⟩
  have hd : dist x (reciprocalGrid a b N (i : ℕ)) ≤ δ := by
    rw [Real.dist_eq, abs_of_nonneg (sub_nonneg.mpr hx.1)]
    calc
      _ ≤ reciprocalGrid a b N ((i : ℕ) + 1) - reciprocalGrid a b N (i : ℕ) := sub_le_sub_right hx.2 _
      _ = (b - a) / (N : ℝ) := reciprocal_grid_step a b N (i : ℕ)
      _ ≤ δ := hstep
  constructor
  · have hh := hclose (reciprocalGrid a b N (i : ℕ), x) ⟨hleft, hxmem⟩
      (reciprocalGrid a b N (i : ℕ), reciprocalGrid a b N (i : ℕ)) ⟨hleft, hleft⟩
      (by simpa only [Prod.dist_eq, dist_self, max_eq_right (dist_nonneg)] using hd)
    simpa only [Real.dist_eq] using hh
  · have hh := hclose (x, x) ⟨hxmem, hxmem⟩
      (reciprocalGrid a b N (i : ℕ), reciprocalGrid a b N (i : ℕ)) ⟨hleft, hleft⟩
      (by simpa only [Prod.dist_eq, max_self] using hd)
    simpa only [Real.dist_eq] using hh

theorem buchstab_bin_density_continuous {b q : ℝ} (hb : 0 < b) (hq : q ≤ 1 / 2) :
    ContinuousOn (fun p : ℝ × ℝ => buchstabDensity p.1 (1 - p.2))
      (Set.Icc b q ×ˢ Set.Icc b q) := by
  apply buchstab_density_continuous.comp
    (show ContinuousOn (fun p : ℝ × ℝ => (p.1, 1 - p.2))
      (Set.Icc b q ×ˢ Set.Icc b q) by fun_prop)
  intro p hp
  exact ⟨hb.trans_le hp.1.1, by linarith [hp.2.2]⟩

theorem reciprocal_grid_added_sample_bound (f : ℝ → ℝ) {b q η : ℝ}
    (hb : 0 < b) (hbq : b ≤ q) (hη : 0 ≤ η) (hf : ContinuousOn f (Set.Icc b q))
    {N : ℕ} (hN : 0 < N)
    (hosc : ∀ i : ℕ, i < N → ∀ α ∈ Set.Icc (reciprocalGrid b q N i) (reciprocalGrid b q N (i + 1)),
      |f α - f (reciprocalGrid b q N i)| ≤ η) :
    (∑ i ∈ range N, (f (reciprocalGrid b q N i) + η) *
      Real.log (reciprocalGrid b q N (i + 1) / reciprocalGrid b q N i)) ≤
        (∫ α in b..q, f α / α) + (η / b) * (q - b) + η * Real.log (q / b) := by
  have happ := reciprocal_grid_integral_approximation f hb hbq hη hf hN hosc
  simp only [add_mul, sum_add_distrib]
  rw [← mul_sum, reciprocal_grid_log_weight_sum hb hbq hN]
  have hh := (abs_le.mp happ).1
  linarith

theorem reciprocal_mesh_error_budget {b q ε : ℝ} (hb : 0 < b) (hbq : b < q) (hε : 0 < ε) :
    let η := ε / ((q - b) / b + |Real.log (q / b)| + 1)
    0 < η ∧ (η / b) * (q - b) + η * Real.log (q / b) ≤ ε := by
  let C := (q - b) / b + |Real.log (q / b)| + 1
  have hC : 0 < C := by dsimp [C]; positivity
  let η := ε / C
  have hη : 0 < η := div_pos hε hC
  refine ⟨hη, ?_⟩
  change (η / b) * (q - b) + η * Real.log (q / b) ≤ ε
  have heq : η * C = ε := by dsimp [η]; field_simp
  calc
    _ ≤ η * C := by
      have hh := mul_le_mul_of_nonneg_left (le_abs_self (Real.log (q / b))) hη.le
      dsimp [C]
      calc
        _ = η * ((q - b) / b) + η * Real.log (q / b) := by ring
        _ ≤ η * ((q - b) / b) + η * |Real.log (q / b)| := add_le_add le_rfl hh
        _ ≤ η * ((q - b) / b + |Real.log (q / b)| + 1) := by nlinarith
    _ = ε := heq


theorem exists_buchstab_upper_mesh {b q ε : ℝ}
    (hb : 0 < b) (hbq : b < q) (hq : q ≤ 1 / 2) (hε : 0 < ε) :
    ∃ N : ℕ, 0 < N ∧ ∃ M : Fin N → ℝ,
      (∀ i : Fin N,
        reciprocalGrid b q N (i : ℕ) < reciprocalGrid b q N ((i : ℕ) + 1) ∧ 0 < M i ∧
        ∀ α ∈ Set.Icc (reciprocalGrid b q N (i : ℕ)) (reciprocalGrid b q N ((i : ℕ) + 1)),
          buchstabDensity (reciprocalGrid b q N (i : ℕ)) (1 - α) ≤ M i) ∧
      (∑ i : Fin N, M i * Real.log (reciprocalGrid b q N ((i : ℕ) + 1) / reciprocalGrid b q N (i : ℕ))) ≤
        (∫ α in b..q, buchstabDensity α (1 - α) / α) + ε := by
  let F : ℝ × ℝ → ℝ := fun p => buchstabDensity p.1 (1 - p.2)
  let f : ℝ → ℝ := fun α => buchstabDensity α (1 - α)
  have hF : ContinuousOn F (Set.Icc b q ×ˢ Set.Icc b q) := buchstab_bin_density_continuous hb hq
  have hf : ContinuousOn f (Set.Icc b q) :=
    hF.comp (f := fun α : ℝ => (α, α))
      (continuousOn_id.prodMk continuousOn_id) (fun α hα => ⟨hα, hα⟩)
  let η : ℝ := ε / ((q - b) / b + |Real.log (q / b)| + 1)
  have hbudget : 0 < η ∧ (η / b) * (q - b) + η * Real.log (q / b) ≤ ε :=
    reciprocal_mesh_error_budget hb hbq hε
  obtain ⟨N, hN, hosc⟩ := exists_square_reciprocal_grid_oscillation hbq F hF hbudget.1
  let M : Fin N → ℝ := fun i => f (reciprocalGrid b q N (i : ℕ)) + η
  refine ⟨N, hN, M, ?_, ?_⟩
  · intro i
    have hi := reciprocal_grid_mem hbq.le hN i.isLt.le
    have hleft0 : 0 < reciprocalGrid b q N (i : ℕ) := hb.trans_le hi.1
    have hlast0 : 0 < 1 - reciprocalGrid b q N (i : ℕ) := by linarith [hi.2]
    refine ⟨reciprocal_grid_strict_step hbq hN (i : ℕ), ?_, ?_⟩
    · change 0 < buchstabDensity (reciprocalGrid b q N (i : ℕ)) (1 - reciprocalGrid b q N (i : ℕ)) + η
      exact add_pos (buchstab_density_pos hleft0 hlast0) hbudget.1
    · intro α hα
      have hh := (abs_le.mp (hosc (i : ℕ) i.isLt α hα).1).2
      change buchstabDensity (reciprocalGrid b q N (i : ℕ)) (1 - α) ≤
        buchstabDensity (reciprocalGrid b q N (i : ℕ)) (1 - reciprocalGrid b q N (i : ℕ)) + η
      change buchstabDensity (reciprocalGrid b q N (i : ℕ)) (1 - α) -
        buchstabDensity (reciprocalGrid b q N (i : ℕ)) (1 - reciprocalGrid b q N (i : ℕ)) ≤ η at hh
      linarith only [hh]
  · have hh := reciprocal_grid_added_sample_bound f hb hbq.le hbudget.1.le hf hN
      (fun i hi α hα => (hosc i hi α hα).2)
    change (∑ i : Fin N, (f (reciprocalGrid b q N (i : ℕ)) + η) *
      Real.log (reciprocalGrid b q N ((i : ℕ) + 1) / reciprocalGrid b q N (i : ℕ))) ≤
      (∫ α in b..q, f α / α) + ε
    rw [Fin.sum_univ_eq_sum_range (fun i : ℕ =>
      (f (reciprocalGrid b q N i) + η) * Real.log (reciprocalGrid b q N (i + 1) / reciprocalGrid b q N i)) N]
    linarith [hbudget.2]

theorem buchstab_partial_kernel_integral_le {b q : ℝ}
    (hb : 0 < b) (hbq : b ≤ q) (hq : q ≤ 1 / 2) :
    (∫ α in b..q, buchstabDensity α (1 - α) / α) ≤ buchstabDensity b 1 - 1 := by
  have hnonneg : ∀ᵐ α ∂volume.restrict (Set.Ioc b (1 / 2 : ℝ)),
      0 ≤ buchstabDensity α (1 - α) / α := by
    apply (ae_restrict_iff' measurableSet_Ioc).mpr
    apply Filter.Eventually.of_forall
    intro α hα
    have hα0 : 0 < α := hb.trans hα.1
    have hlast : 0 < 1 - α := by linarith [hα.2]
    exact div_nonneg (buchstab_density_nonneg hα0 hlast) hα0.le
  have hmono := intervalIntegral.integral_mono_interval (a := b) (b := q)
    (c := b) (d := (1 / 2 : ℝ)) le_rfl hbq hq hnonneg
    (buchstab_density_kernel_intervalIntegrable (w := 1) hb (hbq.trans hq))
  rw [buchstab_density_integral_identity hb (hbq.trans hq)] at hmono
  exact hmono

theorem exists_buchstab_upper_mesh_density_bound {b q ε : ℝ}
    (hb : 0 < b) (hbq : b < q) (hq : q ≤ 1 / 2) (hε : 0 < ε) :
    ∃ N : ℕ, 0 < N ∧ ∃ M : Fin N → ℝ,
      (∀ i : Fin N,
        reciprocalGrid b q N (i : ℕ) < reciprocalGrid b q N ((i : ℕ) + 1) ∧ 0 < M i ∧
        ∀ α ∈ Set.Icc (reciprocalGrid b q N (i : ℕ)) (reciprocalGrid b q N ((i : ℕ) + 1)),
          buchstabDensity (reciprocalGrid b q N (i : ℕ)) (1 - α) ≤ M i) ∧
      (∑ i : Fin N, M i * Real.log (reciprocalGrid b q N ((i : ℕ) + 1) / reciprocalGrid b q N (i : ℕ))) ≤
        buchstabDensity b 1 - 1 + ε := by
  obtain ⟨N, hN, M, hbins, hsum⟩ := exists_buchstab_upper_mesh hb hbq hq hε
  refine ⟨N, hN, M, hbins, ?_⟩
  exact hsum.trans (add_le_add (buchstab_partial_kernel_integral_le hb hbq.le hq) le_rfl)

end Bounty



end

section

/- Norm consequences in the genuine mixed measure. Promotion and
storage estimates combine without replacing the small-state measure. -/

open Finset
open scoped Classical

namespace Bounty

section

variable {S X : Type*} [Fintype S] [Fintype X]
  {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
  (V : S → ℝ) (W : X → ℝ)

theorem physical_small_big_sqrt_energy_eq_norm
    (F : PhysicalSmallBigState P J ell X → ℂ) :
    Real.sqrt (physicalSmallBigEnergy V W F) =
      cleanActiveNorm (physicalSmallBigMeasure V W) F := by
  rw [← physical_small_big_energy_eq]
  rfl

theorem physical_small_big_norm_le_of_energy
    (H K : ℝ) (hH : 0 ≤ H) (hK : 0 ≤ K)
    (F output : PhysicalSmallBigState P J ell X → ℂ)
    (h : physicalSmallBigEnergy V W output ≤ H ^ 2 * K * physicalSmallBigEnergy V W F) :
    cleanActiveNorm (physicalSmallBigMeasure V W) output ≤
      H * Real.sqrt K * cleanActiveNorm (physicalSmallBigMeasure V W) F := by
  have hs := Real.sqrt_le_sqrt h
  rwa [Real.sqrt_mul (mul_nonneg (sq_nonneg H) hK), Real.sqrt_mul (sq_nonneg H),
    Real.sqrt_sq hH, physical_small_big_sqrt_energy_eq_norm,
    physical_small_big_sqrt_energy_eq_norm] at hs

theorem physical_small_big_dirty_energy_of_components
    (hV : ∀ s, 0 < V s) (hW : ∀ x, 0 ≤ W x)
    (F output promotion storage : PhysicalSmallBigState P J ell X → ℂ)
    (δ K : ℝ)
    (hdom : ∀ s, ‖output s‖ ≤ ‖promotion s + storage s‖)
    (hprom : physicalSmallBigEnergy V W promotion ≤ δ * K * physicalSmallBigEnergy V W F)
    (hstore : physicalSmallBigEnergy V W storage ≤ δ * K * physicalSmallBigEnergy V W F) :
    physicalSmallBigEnergy V W output ≤ 4 * δ * K * physicalSmallBigEnergy V W F := by
  have h := (finiteWeightedEnergy_le_of_norm_le (physicalSmallBigMeasure V W)
    (physical_small_big_measure_nonneg V hV W hW) output
    (fun s => promotion s + storage s) hdom).trans
      (finite_weighted_energy_add_le_two (physicalSmallBigMeasure V W)
        (physical_small_big_measure_nonneg V hV W hW) promotion storage)
  simp only [physical_small_big_energy_eq] at h
  nlinarith




theorem physical_small_big_clean_rare_norm_le
    (hV : ∀ s, 0 < V s) (hW : ∀ x, 0 ≤ W x)
    (F output clean dirty : PhysicalSmallBigState P J ell X → ℂ)
    (hdecomp : output = clean + dirty) (εclean εdirty : ℝ)
    (hc : cleanActiveNorm (physicalSmallBigMeasure V W) clean ≤
      εclean * cleanActiveNorm (physicalSmallBigMeasure V W) F)
    (hd : cleanActiveNorm (physicalSmallBigMeasure V W) dirty ≤
      εdirty * cleanActiveNorm (physicalSmallBigMeasure V W) F) :
    cleanActiveNorm (physicalSmallBigMeasure V W) output ≤
      (εclean + εdirty) * cleanActiveNorm (physicalSmallBigMeasure V W) F := by
  rw [hdecomp]
  exact (clean_active_norm_add_le (physicalSmallBigMeasure V W)
    (physical_small_big_measure_nonneg V hV W hW) clean dirty).trans
      ((add_le_add hc hd).trans_eq (by ring))

end

end Bounty
end

section

/- Averaging fixed auxiliary draws on the genuine mixed measure. The
auxiliary law is a subprobability independent of the state being integrated. -/

open Finset
open scoped Classical

namespace Bounty

section

variable
  {S X Q : Type*}
  [sharedInstance1 : Fintype S]
  [sharedInstance2 : Fintype X]
  [sharedInstance3 : Fintype Q]
  {P : S → Finset ℕ}
  [sharedInstance5 : ∀ p : PhysicalPrime P, NeZero p.2.val]
  {J ell : ℕ}
  (V : S → ℝ)
  (hV : ∀ s, 0 < V s)
  (W : X → ℝ)
  (hW : ∀ x, 0 ≤ W x)
  (π : Q → ℝ)
  (hπ : ∀ a, 0 ≤ π a)
  (hmass : ∑ a, π a ≤ 1)
  (output : Q → PhysicalSmallBigState P J ell X → ℂ)

include S X Q sharedInstance1 sharedInstance2 sharedInstance3 P sharedInstance5 J ell V hV W hW π hπ hmass output

theorem physical_small_big_subprobability_energy_le
     :
    physicalSmallBigEnergy V W (fun s => ∑ a, (π a : ℂ) * output a s) ≤
      ∑ a, π a * physicalSmallBigEnergy V W (output a) := by
  simpa only [physical_small_big_energy_eq] using
    finite_subprobability_average_energy_le π (physicalSmallBigMeasure V W)
      hπ hmass (physical_small_big_measure_nonneg V hV W hW) output

theorem physical_small_big_auxiliary_energy_bound
    
    (F : PhysicalSmallBigState P J ell X → ℂ) (K : ℝ) (hK : 0 ≤ K)
    (hbound : ∀ a, physicalSmallBigEnergy V W (output a) ≤ K * physicalSmallBigEnergy V W F) :
    physicalSmallBigEnergy V W (fun s => ∑ a, (π a : ℂ) * output a s) ≤
      K * physicalSmallBigEnergy V W F := by
  have hEF : 0 ≤ physicalSmallBigEnergy V W F := by
    rw [← physical_small_big_energy_eq]
    exact sum_nonneg fun s _ => mul_nonneg
      (physical_small_big_measure_nonneg V hV W hW s) (sq_nonneg ‖F s‖)
  calc
    _ ≤ ∑ a, π a * physicalSmallBigEnergy V W (output a) :=
      physical_small_big_subprobability_energy_le V hV W hW π hπ hmass output
    _ ≤ ∑ a, π a * (K * physicalSmallBigEnergy V W F) :=
      sum_le_sum fun a _ => mul_le_mul_of_nonneg_left (hbound a) (hπ a)
    _ = (∑ a, π a) * (K * physicalSmallBigEnergy V W F) := (sum_mul ..).symm
    _ ≤ 1 * (K * physicalSmallBigEnergy V W F) :=
      mul_le_mul_of_nonneg_right hmass (mul_nonneg hK hEF)
    _ = _ := one_mul _

end


end Bounty
end

section

/- Fixed cross moments retain absolute logarithmic exponents. -/

open Finset

namespace Bounty

theorem divisor_square_cross_moment {α : Type*} [DecidableEq α]
    (S : Finset α) (f g : α → ℕ) (M N : ℕ)
    (hf : Set.InjOn f S) (hg : Set.InjOn g S)
    (hM : ∀ x ∈ S, f x ≤ M) (hN : ∀ x ∈ S, g x ≤ N) :
    (∑ x ∈ S, ((f x).divisors.card : ℝ) ^ 2 * ((g x).divisors.card : ℝ) ^ 2) ≤
      Real.sqrt ((M : ℝ) * (1 + Real.log M) ^ 15) *
        Real.sqrt ((N : ℝ) * (1 + Real.log N) ^ 15) := by
  have h := Real.sum_mul_le_sqrt_mul_sqrt S
    (fun x => ((f x).divisors.card : ℝ) ^ 2) (fun x => ((g x).divisors.card : ℝ) ^ 2)
  simp only [← pow_mul, show 2 * 2 = 4 by omega] at h
  apply h.trans
  apply mul_le_mul
  · exact Real.sqrt_le_sqrt (divisor_fourth_moment_injective S f M hf hM)
  · exact Real.sqrt_le_sqrt (divisor_fourth_moment_injective S g N hg hN)
  · positivity
  · positivity

theorem nonnegative_one_three_le_fourths {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) :
    a * b ^ 3 ≤ a ^ 4 + b ^ 4 := by
  rcases le_total a b with hab | hba
  · calc
      _ ≤ b * b ^ 3 := mul_le_mul_of_nonneg_right hab (pow_nonneg hb _)
      _ = b ^ 4 := by ring
      _ ≤ _ := le_add_of_nonneg_left (pow_nonneg ha _)
  · calc
      _ ≤ a * a ^ 3 := mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hb hba _) ha
      _ = a ^ 4 := by ring
      _ ≤ _ := le_add_of_nonneg_right (pow_nonneg hb _)

theorem divisor_adjacent_cross_moment (N : ℕ) :
    (∑ n ∈ Icc 1 N, (n.divisors.card : ℝ) * ((n - 1).divisors.card : ℝ) ^ 3) ≤
      2 * (N : ℝ) * (1 + Real.log N) ^ 15 := by
  have hshift := divisor_fourth_moment_injective (Icc 1 N) (fun n => n - 1) N
    (by
      intro a ha b hb hab
      simp only [mem_coe, mem_Icc] at ha hb
      change a - 1 = b - 1 at hab
      omega)
    (by intro n hn; exact (Nat.sub_le n 1).trans (mem_Icc.mp hn).2)
  calc
    _ ≤ ∑ n ∈ Icc 1 N, ((n.divisors.card : ℝ) ^ 4 +
        ((n - 1).divisors.card : ℝ) ^ 4) := by
      apply sum_le_sum
      intro n _
      exact nonnegative_one_three_le_fourths (by positivity) (by positivity)
    _ = (∑ n ∈ Icc 1 N, (n.divisors.card : ℝ) ^ 4) +
        ∑ n ∈ Icc 1 N, ((n - 1).divisors.card : ℝ) ^ 4 := sum_add_distrib
    _ ≤ (N : ℝ) * (1 + Real.log N) ^ 15 + (N : ℝ) * (1 + Real.log N) ^ 15 :=
      add_le_add (divisor_fourth_moment N) hshift
    _ = _ := by ring

end Bounty
end

section

/- Full shifted-product pair domains, with no primality or roughness restriction. -/

open Finset
namespace Bounty

noncomputable def shiftedFactorPairs (T : Finset ℕ) : Finset (ℕ × ℕ) := by
  classical
  exact T.biUnion (fun u => (2*u+1).divisors.image (fun d => (d,(2*u+1)/d)))

theorem mem_shifted_factor_pairs_iff (T : Finset ℕ) (v : ℕ × ℕ) :
    v ∈ shiftedFactorPairs T ↔ ∃ u ∈ T, v.1*v.2=2*u+1 := by
  classical
  constructor
  · intro hv
    obtain ⟨u,hu,hv'⟩ := mem_biUnion.mp hv
    obtain ⟨d,hd,rfl⟩ := mem_image.mp hv'
    refine ⟨u,hu,?_⟩
    exact Nat.mul_div_cancel' (Nat.mem_divisors.mp hd).1
  · rintro ⟨u,hu,hprod⟩
    apply mem_biUnion.mpr
    refine ⟨u,hu,mem_image.mpr ⟨v.1,?_,?_⟩⟩
    · exact Nat.mem_divisors.mpr ⟨hprod ▸ dvd_mul_right v.1 v.2,by omega⟩
    · have hp : 0 < v.1 := by nlinarith only [hprod]
      apply Prod.ext
      · rfl
      · change (2*u+1)/v.1=v.2
        rw [← hprod, Nat.mul_div_right _ hp]

theorem shifted_factor_pair_properties (T : Finset ℕ) {v : ℕ × ℕ}
    (hv : v ∈ shiftedFactorPairs T) :
    0 < v.1 ∧ 0 < v.2 ∧ shiftedPairIndex v ∈ T ∧
      v.1*v.2=2*shiftedPairIndex v+1 := by
  obtain ⟨u,hu,hprod⟩ := (mem_shifted_factor_pairs_iff T v).mp hv
  have hindex : shiftedPairIndex v=u := by unfold shiftedPairIndex; rw [hprod]; omega
  rw [hindex]
  exact ⟨by nlinarith only [hprod],by nlinarith only [hprod],hu,hprod⟩

theorem shifted_buchstab_pairs_subset_factor_pairs (T : Finset ℕ) (z : ℝ)
    (hT : ∀ u ∈ T, 0 < u) : shiftedBuchstabPairs T z ⊆ shiftedFactorPairs T := by
  intro v hv
  have h := shifted_buchstab_pair_properties T z hT hv
  exact (mem_shifted_factor_pairs_iff T v).mpr ⟨shiftedPairIndex v,h.2.2.1,h.2.2.2.1⟩

end Bounty
end

