section

/- Split each original injective mark list into its shared and unshared embeddings. -/

open Finset
open scoped Classical
namespace Bounty

abbrev PhysicalCutGroupData (P : Finset ℕ) {J : ℕ} (C : Finset (Fin J)) (ell : ℕ) :=
  {f : (↥(univ \ C) ↪ ↥P) × (Fin (ell+C.card) ↪ ↥P) //
    Disjoint (Set.range f.1) (Set.range f.2)}

noncomputable def physicalCutGroupEquiv (P : Finset ℕ) {J : ℕ}
    (C : Finset (Fin J)) (ell : ℕ) :
    (PhysicalSlots J ell ↪ ↥P) ≃ PhysicalCutGroupData P C ell :=
  (Equiv.embeddingCongr (physicalCutSlotEquiv C).symm (Equiv.refl ↥P)).trans
    Equiv.sumEmbeddingEquivProdEmbeddingDisjoint

noncomputable def physicalCutListEquiv {G : Type*} (P : G → Finset ℕ) {J : ℕ}
    (C : G → Finset (Fin J)) (ell : ℕ) :
    PhysicalMarkLists P J ell ≃ (∀ g, PhysicalCutGroupData (P g) (C g) ell) :=
  Equiv.piCongrRight (fun g => physicalCutGroupEquiv (P g) (C g) ell)




theorem physical_cut_list_unshared {G : Type*} {P : G → Finset ℕ} {J ell : ℕ}
    (C : G → Finset (Fin J)) (L : PhysicalMarkLists P J ell) (g : G) :
    (physicalCutListEquiv P C ell L g).val.2 = physicalGroupUnsharedEmbedding C L g := by
  apply Function.Embedding.ext
  intro i
  rfl




end Bounty
end

section

/- The actual candidate pools supply a common harmonic floor, exponentially
large primes and a logarithmic bound on the total shared-slot count. -/

open Finset Filter
open scoped Classical
namespace Bounty

theorem exists_candidate_shared_error_inputs {c : ℝ} (hc : 0 < c) (J : ℕ) :
    ∃ v A : ℝ, 0 < v ∧ 0 ≤ A ∧ ∀ᶠ L : ℝ in atTop,
      ∀ (S : Finset ℕ), S ⊆ candidatePIndices c L →
        ((J * S.card : ℕ) : ℝ) ≤ A * Real.log L ∧
        ∀ (g : S),
          v ≤ ∑ p ∈ candidatePBand (c*L) g.val, 1/(p : ℝ) ∧
          ∀ p ∈ candidatePBand (c*L) g.val,
            p.Prime ∧ Real.exp (L^(1/10 : ℝ)) ≤ (p : ℝ) := by
  obtain ⟨v, V, hv, _, hpool⟩ := exists_candidate_P_pool_bounds hc
  refine ⟨v, (J : ℝ) * (2 / (5 * Real.log 2)), hv, by positivity, ?_⟩
  filter_upwards [hpool] with L hL
  intro S hS
  refine ⟨?_, ?_⟩
  · have hcard : (S.card : ℝ) ≤ (2 / (5 * Real.log 2)) * Real.log L :=
      (Nat.cast_le.mpr (card_le_card hS)).trans hL.2.2.2.1
    simpa only [Nat.cast_mul, mul_assoc] using mul_le_mul_of_nonneg_left hcard (Nat.cast_nonneg J)
  · intro g
    obtain ⟨hlo, _, hp⟩ := hL.2.2.2.2.2 g.val (hS g.property)
    exact ⟨hlo, fun p hmem => ⟨(hp p hmem).1, (hp p hmem).2.1.le⟩⟩




end Bounty
end

section

/- Finite multiplication pullback retaining the original position guard. -/

open Finset
open scoped Classical
namespace Bounty

theorem integer_guarded_position_sum {s : ℤ} (hs : s ≠ 0)
    (positions W : Finset ℤ) (F : ℤ → ℂ)
    (hzero : ∀ n ∈ positions, ¬ s ∣ n → F n = 0)
    (hW : ∀ n ∈ positions, s ∣ n → F n ≠ 0 → n / s ∈ W) :
    (∑ n ∈ positions, F n) =
      ∑ w ∈ W, if s * w ∈ positions then F (s * w) else 0 := by
  let A := W.filter (fun w => s * w ∈ positions)
  have hp := integer_scaled_position_sum hs A positions
    (fun w hw => (mem_filter.mp hw).2) (fun w => F (s * w))
  calc
    _ = ∑ n ∈ positions, if s ∣ n ∧ n / s ∈ A then F (s * (n / s)) else 0 := by
      apply sum_congr rfl
      intro n hn
      by_cases hd : s ∣ n
      · rw [Int.mul_ediv_cancel' hd]
        by_cases hf : F n = 0
        · simp only [hf, ite_self]
        · exact (if_pos ⟨hd, mem_filter.mpr ⟨hW n hn hd hf,
            by simpa only [Int.mul_ediv_cancel' hd] using hn⟩⟩).symm
      · rw [if_neg (fun h => hd h.1), hzero n hn hd]
    _ = ∑ w ∈ A, F (s * w) := hp
    _ = _ := by rw [sum_filter]

end Bounty
end

