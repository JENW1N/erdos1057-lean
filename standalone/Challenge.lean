    (steps : List (Option (J ⊕ K)))
    (initial : (g : Fin N) → Finset (P g))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FullPermutationMixedPath n S B A Δ D steps x)







