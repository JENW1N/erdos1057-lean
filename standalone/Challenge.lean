theorem full_edge_grouped_restricted_continuation_le
    {G : Type*} [Fintype G] [DecidableEq G] {P : G → Type*}
    [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    {M : G → ℕ} (S : ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : SharedActiveLabels P S → Type*) (Δ D : ∀ c, A c → G → ℤ)
    (ω : ∀ c, A c → ℝ) (μ : ∀ g, P g → ℝ) (ρ : ℝ) (V : G → ℝ)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (sk : FullActiveEdgeSkeleton n S B A Δ D s) {m : ℕ}
    (ord : Fin m ≃ FullActiveEdgeSampleIndex n S B A Δ D s sk)
    {Q : ℕ} (f : FullActiveEdgeSampleIndex n S B A Δ D s sk → Fin Q)
    (code : BirthForestCode Q) (history : Fin Q → Option (Sigma P))
    (d : G → ℕ)
    (hvalid : ∀ i, restrictedBirthAnchors (f ∘ ord) code history i ≠ some none)
    (hd : ∀ g, (univ.filter (fun i : {i : Fin (S g)ᶜ.card // i ∉ (sk.2 g).2.1} => code (f ⟨g, i⟩) ≠ none)).card = d g)
    (η : G → ℝ) (hη : ∀ g, 0 ≤ η g) (hμ : ∀ g p, 0 ≤ μ g p)
    (hμatom : ∀ g p, μ g p ≤ η g)
    (v L : ℝ) (hv : 0 ≤ v) (hL : 0 ≤ L)
    (F : FullActiveEdgeSamples n S B A Δ D s sk → ℝ)
    (hF : ∀ fresh, F fresh ≤ L * productLengthLyapunov v
      (fullActiveEdgeEventTarget n S B A Δ D s
        ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩))) :
    (∑ fresh : FullActiveEdgeSamples n S B A Δ D s sk,
      if birthForestEqualValues (restrictedBirthCode (f ∘ ord) code) (fun j => (⟨(ord j).1, fresh (ord j)⟩ : Sigma P)) ∧
          birthLabelsAnchored (fun i => (restrictedBirthAnchors (f ∘ ord) code history i).join) (fun j => (⟨(ord j).1, fresh (ord j)⟩ : Sigma P)) then
        |fullActiveEdgeEventWeight n S B A Δ D ω μ ρ V s
          ((fullActiveEdgeSkeletonEquiv n S B A Δ D s).symm ⟨sk, fresh⟩)| * F fresh
      else 0) ≤
    fullActiveEdgeSkeletonAbsMass n S B A Δ D ω ρ V s sk *
      (L * v ^ (∑ g, unrestrictedSkeletonOutputCount (n g)
        (Δ (productActiveMemorySplit S B s).1 sk.1 g)
        (D (productActiveMemorySplit S B s).1 sk.1 g)
        (S g)ᶜ.card B ((productActiveMemorySplit S B s).2 g) (sk.2 g))) *
      ∏ g, η g ^ d g * (∑ p, μ g p) ^ ((S g)ᶜ.card - (sk.2 g).2.1.card - d g) := by
  have hb := full_edge_forest_continuation_le n S B A Δ D ω μ ρ V s sk ord
    (restrictedBirthCode (f ∘ ord) code)
    (fun i => (restrictedBirthAnchors (f ∘ ord) code history i).join)
    η hη hμ hμatom v L hv hL F hF
  have hc := grouped_join_restricted_forest_cost_eq
    (fun g => {i : Fin (S g)ᶜ.card // i ∉ (sk.2 g).2.1})
    ord f code history (fun g => ∑ p, μ g p) η d hvalid hd
  refine le_trans (le_of_eq ?_) (le_trans hb (le_of_eq ?_))
  · apply sum_congr rfl
    intro fresh _
    split_ifs <;> rfl
  · congr 1
    convert hc using 1
    · apply prod_congr rfl
      intro i _
      cases restrictedBirthCode (f ∘ ord) code i <;>
        cases (restrictedBirthAnchors (f ∘ ord) code history i).join <;> rfl
    · simp only [Fintype.card_subtype_compl, Fintype.card_fin, Fintype.card_coe]

end Bounty
