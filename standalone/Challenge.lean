open MeasureTheory
open scoped ComplexConjugate

namespace Bounty

theorem exists_local_mellin_transform_energy_constant {j : ℕ} (hj : 2 ≤ j) :
    ∃ C : ℝ, 0 < C ∧ ∀ h : ℝ, 0 < h → ∀ g : ℝ → ℂ, Continuous g →
      (∃ M : ℝ, ∀ t, ‖g t‖ ≤ M) →
      Integrable (fun u : ℝ => ‖(typeIISmoothRho 2 u : ℂ) * localMellinTransform h g u‖^2) ∧
      (∫ u in Set.Icc (Real.log (1/2:ℝ)) (Real.log 3), ‖localMellinTransform h g u‖^2) ≤
        C * ∫ t : ℝ, (1+|h*t|)^(-(j:ℝ)) * ‖g t‖^2 := by
  obtain ⟨M₀, M₁, M₂, hM₀, hM₁, hM₂, hderiv⟩ :=
    local_mellin_amplitude_uniform_derivatives (4*j)
  obtain ⟨C₀, hC₀, hCi, hFourier⟩ := local_mellin_amplitude_product_fourier_bound (4*j)
  have hCbase : 0 ≤ C₀*(2*Real.pi^2)*(2:ℝ)^j := by positivity
  refine ⟨C₀*(2*Real.pi^2)*(2:ℝ)^j+1, by linarith, ?_⟩
  intro h hh g hg hgBound
  obtain ⟨M, hgM⟩ := hgBound
  let f : ℝ → ℂ := fun t => (mellinDecayWeight j h t : ℂ) * g t
  have hfc : Continuous f :=
    (Complex.continuous_ofReal.comp (mellin_decay_weight_continuous j h)).mul hg
  have hfi : Integrable f := mellin_weighted_bounded_integrable hj hh hg hgM
  have hf2 : Integrable (fun t => ‖f t‖^2) :=
    mellin_weighted_bounded_square_integrable hj hh hg hgM
  have hab (v u : ℝ) : ‖localMellinAmplitude (4*j) v u‖ ≤ M₀ := (hderiv v u).1
  have hsupp := local_mellin_amplitude_zero (4*j)
  have hloc := oscillatory_schur_energy_integrable
    (local_mellin_amplitude_joint_continuous (4*j)) hM₀ hab hsupp hfc hfi h
  have hbound := oscillatory_schur_energy_bound
    (local_mellin_amplitude_joint_continuous (4*j)) hM₀ hab hsupp hC₀ hFourier hfc hfi hf2 h
  have heq (u : ℝ) : (∫ t : ℝ, Complex.exp (((-t*u:ℝ):ℂ)*Complex.I) *
      localMellinAmplitude (4*j) (h*t) u * f t) =
      (typeIISmoothRho 2 u : ℂ) * localMellinTransform h g u :=
    (local_mellin_transform_weighted_representation j h g u).symm
  simp_rw [heq] at hloc hbound
  refine ⟨hloc, ?_⟩
  have hsame : (∫ u in Set.Icc (Real.log (1/2:ℝ)) (Real.log 3), ‖localMellinTransform h g u‖^2) =
      ∫ u in Set.Icc (Real.log (1/2:ℝ)) (Real.log 3),
        ‖(typeIISmoothRho 2 u : ℂ) * localMellinTransform h g u‖^2 := by
    apply setIntegral_congr_fun measurableSet_Icc
    intro u hu
    dsimp only
    rw [local_mellin_rho_one_on_log_dyad hu, Complex.ofReal_one, one_mul]
  rw [hsame]
  calc
    _ ≤ ∫ u : ℝ, ‖(typeIISmoothRho 2 u : ℂ) * localMellinTransform h g u‖^2 :=
      setIntegral_le_integral hloc (Filter.Eventually.of_forall (fun u => sq_nonneg _))
    _ ≤ C₀*(2*Real.pi^2) * ∫ t : ℝ, ‖f t‖^2 := hbound
    _ ≤ C₀*(2*Real.pi^2) * ((2:ℝ)^j *
        ∫ t : ℝ, (1+|h*t|)^(-(j:ℝ))*‖g t‖^2) :=
      mul_le_mul_of_nonneg_left (mellin_weighted_square_energy_bound hj hh hg hgM) (by positivity)
    _ ≤ _ := by
      have hE : 0 ≤ ∫ t : ℝ, (1+|h*t|)^(-(j:ℝ))*‖g t‖^2 :=
        integral_nonneg (fun t => by positivity)
      nlinarith

end Bounty
