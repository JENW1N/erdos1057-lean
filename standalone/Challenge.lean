/- The full signed prime block follows from the actual uniform free-tuple comparison estimates. -/

namespace Bounty

open Finset
open scoped Classical

theorem prime_grouped_block_bound_of_free_tuple_estimates {G : Type*} [Fintype G] [DecidableEq G]
    {I : G → Type*} [∀ g, Fintype (I g)] [∀ g, DecidableEq (I g)]
    (P : G → Finset ℕ) (V : G → ℝ) (hV : ∀ g, 0 < V g)
    (hP : ∀ g p, p ∈ P g → 0 < p)
    (hmass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (probes tails : ∀ g, Finset (I g)) (hpt : ∀ g, Disjoint (probes g) (tails g))
    (m ell : ℕ) (hm : 0 < m) (hp : ∀ g, (probes g).card = m) (ht : ∀ g, (tails g).card = ell)
    (s t : Finset G) (hst : Disjoint s t) (active : Finset (Sigma I))
    (hactive : activeᶜ = univ.sigma tails)
    (Q : ℕ) (h : ℝ) (keptA keptB : Finset (Sigma I) → Finset ℤ) (ζ Θ : ℝ)
    (f g : (∀ g, I g → P g) → ℂ)
    (hf : ∀ a, finiteGroupSlotSymmetric a f) (hg : ∀ a, finiteGroupSlotSymmetric a g)
    (ε : ℝ) (hε : 0 ≤ ε)
    (hfree : ∀ A ∈ cleanNonemptySubsets (s.sigma probes),
      ∀ B ∈ cleanNonemptySubsets (t.sigma probes), ∀ α : ℝ,
      ∀ (u : (∀ i : A, P i.1.1) → ℂ) (v : (∀ i : B, P i.1.1) → ℂ),
      ‖finiteTwoKernelPairingError
        (finiteProductWeight (physicalLabelLaw (P := fun i : A => P i.1.1) (fun i => V i.1.1)))
        (finiteProductWeight (physicalLabelLaw (P := fun i : B => P i.1.1) (fun i => V i.1.1)))
        (primeProductIdealKernel (fun i : A => P i.1.1) (fun i => V i.1.1) Q h (keptA A))
        (primeProductIdealKernel (fun i : B => P i.1.1) (fun i => V i.1.1) Q h (keptB B))
        (fun a b => Complex.exp (Complex.I *
          (ζ * Real.log (((∏ i : A, (a i).val : ℕ) : ℝ) * (∏ i : B, (b i).val : ℕ)) +
            2 * Real.pi * (α * (((∏ i : A, (a i).val : ℕ) : ℝ) *
              (∏ i : B, (b i).val : ℕ))) : ℝ))) u v‖ ≤
        ε * Real.sqrt (finiteWeightedEnergy
          (finiteProductWeight (physicalLabelLaw (P := fun i : A => P i.1.1) (fun i => V i.1.1))) u) *
        Real.sqrt (finiteWeightedEnergy
          (finiteProductWeight (physicalLabelLaw (P := fun i : B => P i.1.1) (fun i => V i.1.1))) v)) :
    ‖cleanRawPairing (finiteProductWeight (fun a : Sigma I => physicalLabelLaw V a.1))
            (primeActivePhase (fun a : Sigma I => P a.1) active ζ Θ)
        (finiteGroupedTailTest (physicalLabelLaw V) tails f) (finiteGroupedTailTest (physicalLabelLaw V) tails g) -
      ∑ A ∈ cleanNonemptySubsets (s.sigma probes), ∑ B ∈ cleanNonemptySubsets (t.sigma probes),
        (-1 : ℂ) ^ (A.card + B.card) *
          cleanKernelPairing (finiteProductWeight (fun a : Sigma I => physicalLabelLaw V a.1))
            (primeAsymmetricComparisonKernel (fun a : Sigma I => P a.1) (fun a => V a.1)
              active Q h keptA keptB ζ Θ A B)
            (finiteGroupedTailTest (physicalLabelLaw V) tails f) (finiteGroupedTailTest (physicalLabelLaw V) tails g)‖ ≤
      (Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ s.card) +
        Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ t.card) +
        (3 : ℝ) ^ ((s.sigma probes).card + (t.sigma probes).card) * ε) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight
          (fun g => finiteProductWeight (fun _ : I g => physicalLabelLaw V g))) f) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight
          (fun g => finiteProductWeight (fun _ : I g => physicalLabelLaw V g))) g) := by
  have hsubset (r : Finset G) : r.sigma probes ⊆ active := by
    intro a ha
    by_contra hn
    have ht0 : a ∈ univ.sigma tails := hactive ▸ mem_compl.mpr hn
    exact disjoint_left.mp (hpt a.1) (mem_sigma.mp ha).2 (mem_sigma.mp ht0).2
  have hdis : Disjoint (s.sigma probes) (t.sigma probes) := by
    apply disjoint_left.mpr
    intro a ha hb
    exact disjoint_left.mp hst (mem_sigma.mp ha).1 (mem_sigma.mp hb).1
  apply prime_asymmetric_grouped_block_bound P V hV hP hmass probes tails hpt
    m ell hm hp ht s t hst active Q h keptA keptB ζ Θ f g hf hg ε hε
  intro S hS T hT A hA B hB
  have hAA : A ⊆ s.sigma probes \ S := ((clean_mem_nonempty_subsets _ _).mp hA).2
  have hBB : B ⊆ t.sigma probes \ T := ((clean_mem_nonempty_subsets _ _).mp hB).2
  have hAU : A ∈ cleanNonemptySubsets (s.sigma probes) :=
    clean_nonempty_subsets_mono sdiff_subset hA
  have hBV : B ∈ cleanNonemptySubsets (t.sigma probes) :=
    clean_nonempty_subsets_mono sdiff_subset hB
  have he := prime_admissible_component_error_le (fun a : Sigma I => P a.1)
    (fun a => V a.1) (fun a => hV a.1) (fun a p hp => hP a.1 p hp) (fun a => hmass a.1)
    active (s.sigma probes) (t.sigma probes) S T A B (hsubset s) (hsubset t) hdis hAA hBB
    Q h keptA keptB ζ Θ (finiteGroupFlattenFunction f) (finiteGroupFlattenFunction g)
    ε hε (hfree A hAU B hBV)
  simp only [hactive, finiteGroupedTailTest] at he ⊢
  convert he using 1 <;> congr 1

end Bounty
end

