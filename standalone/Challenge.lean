noncomputable def physicalSelectedBigPrimeEquiv
    {N : ℕ} (P : Fin N → Finset ℕ) (groups : Finset (Fin N)) :
    PhysicalPrime (fun g : {g // g ∉ groupsᶜ} => P g.val) ≃ ↥(physicalPrimeGroups P groups) where
  toFun p := ⟨⟨p.1.val, p.2⟩, by
    have hg : p.1.val ∈ groups := by simpa using p.1.property
    simp [physicalPrimeGroups, hg]⟩
  invFun p := ⟨⟨p.val.1, by
    have hg : p.val.1 ∈ groups := by simpa [physicalPrimeGroups] using p.property
    simpa using hg⟩, p.val.2⟩
  left_inv p := by cases p; rfl
  right_inv p := by cases p; rfl

noncomputable def physicalBigPrimeNumbering
    {N M : ℕ} (P : Fin N → Finset ℕ) (groups : Finset (Fin N))
    (e : {g // g ∉ groupsᶜ} ≃ Fin M) :
    PhysicalPrime (fun h => P (e.symm h).val) ≃ ↥(physicalPrimeGroups P groups) :=
  (physicalPrimeReindex e (fun g => P g.val)).trans (physicalSelectedBigPrimeEquiv P groups)




abbrev physicalNumberedBigPrimeNonzero
    {N M : ℕ} {P : Fin N → Finset ℕ} [∀ a : PhysicalPrime P, NeZero a.2.val]
    (groups : Finset (Fin N)) (e : {g // g ∉ groupsᶜ} ≃ Fin M) :
    ∀ z : PhysicalPrime (fun h => P (e.symm h).val), NeZero z.2.val :=
  fun z => inferInstanceAs (NeZero (⟨(e.symm z.1).val, z.2⟩ : PhysicalPrime P).2.val)

theorem physical_group_capped_history_numbered
    {I : Type} {N M J ell n : ℕ} {P : Fin N → Finset ℕ}
    [∀ a : PhysicalPrime P, NeZero a.2.val]
    (groups : Finset (Fin N)) (e : {g // g ∉ groupsᶜ} ≃ Fin M)
    (patterns : Finset I) (C : I → Fin N → Finset (Fin J)) (q : ℝ) (k : ℕ → I → ℤ)
    (β : PhysicalPrime P → ℝ) (V : Fin N → ℝ) (B : ℕ)
    (L : PhysicalMarkLists P J ell)
    (p : Fin (n + 1) → PhysicalEdgeLabels P J ell patterns C × PhysicalMarkLists P J ell)
    (hB : (physicalPrimeGroups P groups).card ≤ B) :
    let := physicalNumberedBigPrimeNonzero (P := P) groups e
    physicalGroupFiniteCappedHistory groups C q k β V B L p =
    ghostPhaseCappedHistory
      (fun z : PhysicalPrime (fun h => P (e.symm h).val) => fun j =>
        globalBirthFiniteActivity
          (physicalGroupBareFiniteActivity (physicalPathSelectedEquiv patterns C (L, p)).2.2.1
            (e.symm z.1).val) j z.2)
      (fun z => physicalResidueAbsoluteHit (physicalPathSelectedOffset C k L p) (e.symm z.1).val z.2)
      (fun _ j => 1 - physicalEndpointSchedule q (n + 1) (globalBirthFiniteIndex (n + 1) j).val)
      (fun z => β ⟨(e.symm z.1).val, z.2⟩) (fun z => V (e.symm z.1).val)
      (fun _ => B) (fun _ => B) (n + 1) := by
  let := physicalNumberedBigPrimeNonzero (P := P) groups e
  unfold physicalGroupFiniteCappedHistory
  exact (ghost_phase_inactive_capped_history_reindex (physicalBigPrimeNumbering P groups e)
    (fun a : ↥(physicalPrimeGroups P groups) => fun j => globalBirthFiniteActivity
      (physicalGroupBareFiniteActivity (physicalPathSelectedEquiv patterns C (L, p)).2.2.1 a.val.1) j a.val.2)
    (fun a => physicalResidueAbsoluteHit (physicalPathSelectedOffset C k L p) a.val.1 a.val.2)
    (fun _ j => 1 - physicalEndpointSchedule q (n + 1) (globalBirthFiniteIndex (n + 1) j).val)
    (fun a => β a.val) (fun a => V a.val.1) B (n + 1) (by simpa using hB)).symm

