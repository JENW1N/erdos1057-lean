  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)



include hstep in
theorem physical_joint_adjacent_edge_literal_tensor (j : Fin n)
    (F : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val) → ℂ)
    (s : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val)) :
    globalBirthJointCutRawRow
      (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V
        (fun _ => ρ) hV B (2 * j.val + 1)) B B F s =
    jointRawTensorCutoff B
      (physicalFullEdgeRawRow (B := B) (C j) (k j)
        (physicalPermuteLabels (σ j) (L j.castSucc))
        (physicalPermuteLabels (τ j) (L j.succ)) β ρ V (aux j)) F s := by
  have hr :
      (fun g (K : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val) → ℂ)
        (u : GlobalBirthHistoryState (fun p : ↥(P g) => ZMod p.val)) =>
        globalBirthRawStepRow
          (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β η V
            (fun _ => ρ) hV B (2 * j.val + 1) g) (fun H q => K (H, q)) u.1 u.2) =
      physicalFullEdgeRawRow (B := B) (C j) (k j)
        (physicalPermuteLabels (σ j) (L j.castSucc))
        (physicalPermuteLabels (τ j) (L j.succ)) β ρ V (aux j) := by
    funext g K u
    exact (by
      have h := physical_group_adjacent_finite_edge_row C aux k L a σ τ hstep hcompat
