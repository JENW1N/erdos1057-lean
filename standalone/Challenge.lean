theorem eventually_physical_harmonic_log_linear {A s ε : ℝ}
    (hA : 0 ≤ A) (hs : s < 1) (hε : 0 < ε) :
    ∀ᶠ L : ℝ in atTop, ∀ (G : Type*) [Fintype G] (P : G → Finset ℕ)
      (J : ℕ) (C : G → Finset (Fin J)) (aux : PhysicalAuxLabels P C),
      (∀ g p, p ∈ P g → p.Prime) →
      (∀ g p, p ∈ P g → (p : ℝ) ≤ Real.exp (L^s)) →
      (J*Fintype.card G : ℕ) ≤ A*Real.log L →
      ∀ Z : ℝ, 0 < Z → 1 ≤ Z*(physicalFreeFactor C aux : ℝ) →
      3*Z < Real.exp (4*L) →
      Real.log (⌈3*Z*(physicalFreeFactor C aux : ℝ)⌉₊ : ℝ) ≤ (4+ε)*L := by
  filter_upwards [eventually_scaled_log_sublinear hA hs (half_pos hε),
    eventually_ge_atTop (2*Real.log 4/ε), eventually_ge_atTop (0 : ℝ)] with L hb hc hL
  intro G _ P J C aux hprime hp hslots Z hZ hprod hcut
  have hlog := physical_harmonic_log_bound_of_original_cutoff C aux hprime
    (Real.rpow_nonneg hL s) hZ hp hprod hcut
  have hslot : L^s*((J*Fintype.card G : ℕ) : ℝ) ≤ A*L^s*Real.log L := by
    simpa only [mul_assoc, mul_left_comm] using
      mul_le_mul_of_nonneg_left hslots (Real.rpow_nonneg hL s)
  have hconst : 2*Real.log 4 ≤ L*ε := (div_le_iff₀ hε).mp hc
  nlinarith

