section

/- Physical ordered lists carry exactly the restriction of full-state
energy to injective active coordinates. Nonnegative weights allow this
restriction to be bounded without introducing a cardinality factor. -/

open Finset
open scoped Classical
namespace Bounty

section Physical
variable {G : Type*} [Fintype G] [DecidableEq G]
  {P : G → Finset ℕ} {Z : G → Type*} [∀ g, Fintype (Z g)] {J ell B : ℕ}
  (C : G → Finset (Fin J))

theorem physical_full_state_sum_real
    (F : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B → ℝ) :
    (∑ L : PhysicalMarkLists P J ell, ∑ q : (g : G) → BoundedOrderedTuple (Z g) B,
      F (physicalFullMemoryState C L q)) =
    ∑ x : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B,
      if FullActiveInjective x then F x else 0 := by
  rw [← Fintype.sum_prod_type (f := fun s : PhysicalMarkLists P J ell ×
    ((g : G) → BoundedOrderedTuple (Z g) B) => F (physicalFullMemoryState C s.1 s.2))]
  refine (Equiv.sum_comp (physicalFullStateEquiv (Z := Z) (B := B) C)
    (fun x => F x.val)).trans ?_
  rw [← Finset.sum_subtype (univ.filter FullActiveInjective) (by simp) F]
  exact sum_filter _ _

noncomputable def physicalMarkMemoryEnergy
    (μ : (g : G) → ↥(P g) → ℝ) (ν : (g : G) → Z g → ℝ)
    (F : PhysicalMarkLists P J ell → ((g : G) → BoundedOrderedTuple (Z g) B) → ℂ) : ℝ :=
  ∑ L, ∑ q, (∏ g, (∏ i : PhysicalSlots J ell, μ g (L g i)) *
    boundedOrderedMemoryWeight (ν g) (q g)) * ‖F L q‖ ^ 2

theorem physical_full_state_energy_eq
    (μ : (g : G) → ↥(P g) → ℝ) (ν : (g : G) → Z g → ℝ)
    (F : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B → ℂ) :
    physicalMarkMemoryEnergy μ ν (fun L q => F (physicalFullMemoryState C L q)) =
    ∑ x : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B,
      if FullActiveInjective x then productMemoryWeight μ ν x * ‖F x‖ ^ 2 else 0 := by
  have h := physical_full_state_sum_real C (fun x => productMemoryWeight μ ν x * ‖F x‖ ^ 2)
  simpa only [physicalMarkMemoryEnergy, physical_full_memory_state_weight] using h

theorem physical_full_state_energy_le
    (μ : (g : G) → ↥(P g) → ℝ) (ν : (g : G) → Z g → ℝ)
    (hμ : ∀ g p, 0 ≤ μ g p) (hν : ∀ g z, 0 ≤ ν g z)
    (F : ProductBoundedOrderedState (fun g => ↥(P g)) Z (fun _ => J + ell) B → ℂ) :
    physicalMarkMemoryEnergy μ ν (fun L q => F (physicalFullMemoryState C L q)) ≤
      finiteWeightedEnergy (productMemoryWeight μ ν) F := by
  rw [physical_full_state_energy_eq C]
  unfold finiteWeightedEnergy
  apply sum_le_sum
  intro x _
  split_ifs
  · exact le_rfl
  · exact mul_nonneg (productMemoryWeight_nonneg μ ν hμ hν x) (sq_nonneg _)

end Physical
end Bounty
end

section

/- The minor coefficient is small using only a bound on the product of dyad endpoints. -/

namespace Bounty

theorem minor_arc_uniform_factor_le {L C D U V r κ t q B : ℝ}
    (hL : 512 ≤ L) (hC : 0 ≤ C) (hD : 0 ≤ D) (ht : 0 ≤ t) (hq : 0 ≤ q)
    (hparam : 2 * κ + t + 2 * B + 3 ≤ q)
    (hCb : C ≤ L ^ κ) (hDb : D ≤ L ^ κ)
    (hU : L ^ q ≤ U) (hV : L ^ q ≤ V) (hr : L ^ q ≤ r)
    (hrUV : r / (U * V) ≤ L ^ (-q)) (hlog : Real.log (U * V) ≤ L ^ t) :
    33 * Real.sqrt (6 * C * D * (1 + Real.log r) *
      (1 / r + 1 / U + 1 / V + r / (U * V))) ≤ L ^ (-B) := by
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hp : 0 < L ^ q := Real.rpow_pos_of_pos hL0 q
  have hU0 := hp.trans_le hU
  have hV0 := hp.trans_le hV
  have hr0 := hp.trans_le hr
  have hsmall : L ^ (-q) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hL1 (by linarith)
  have hrprod : r ≤ U * V := by
    have hb := (div_le_iff₀ (mul_pos hU0 hV0)).mp hrUV
    exact hb.trans (by simpa only [one_mul] using
      mul_le_mul_of_nonneg_right hsmall (mul_pos hU0 hV0).le)
  have hlogr : Real.log r ≤ L ^ t := (Real.log_le_log hr0 hrprod).trans hlog
  apply minor_arc_factor_absorption (by linarith)
  have hb := minor_arc_dyad_coefficient_small (B := B + 1)
    (by linarith : 48 ≤ L) hC hD ht hq (by linarith)
    hCb hDb hU hV hr hrUV hlogr
  convert hb using 1
  congr 1
  ring

end Bounty
end

section

/- A single marked prime band supplies the lower scale for all product dyads. -/

open Filter
open scoped BigOperators Classical

namespace Bounty

theorem prime_band_product_lower {I : Type*} [Fintype I] [DecidableEq I]
    (P : I → Finset ℕ) (i : I) (hp : ∀ j p, p ∈ P j → 0 < p)
    {a b : ℝ} (hPi : P i = primeBand a b) (ha : 0 ≤ a) (hb : 0 ≤ b)
    (x : ∀ j, P j) : a < ((∏ j, (x j).val : ℕ) : ℝ) := by
  have hmem : (x i).val ∈ primeBand a b := hPi ▸ (x i).property
  have hband := (mem_primeBand_iff ha hb (x i).val).mp hmem
  have hle : (x i).val ≤ ∏ j, (x j).val :=
    Finset.single_le_prod' (f := fun j => (x j).val)
      (fun j _ => hp j (x j).val (x j).property) (Finset.mem_univ i)
  exact hband.2.1.trans_le (by exact_mod_cast hle)

theorem eventually_prime_band_product_scale {c : ℝ} (hc : 0 < c) (q : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ {I : Type*} [Fintype I] [DecidableEq I]
      (P : I → Finset ℕ) (i : I), (∀ j p, p ∈ P j → 0 < p) →
      ∀ a b : ℝ, P i = primeBand a b → Real.exp (L ^ c) ≤ a → 0 ≤ b →
      ∀ x : (∀ j, P j), 2 * L ^ q ≤ ((∏ j, (x j).val : ℕ) : ℝ) := by
  filter_upwards [eventually_mul_rpow_le_exp_rpow q 2 hc] with L hL
  intro I _ _ P i hp a b hPi ha hb x
  exact hL.trans ((ha.trans_lt (prime_band_product_lower P i hp hPi
    ((Real.exp_pos _).le.trans ha) hb x)).le)

end Bounty
end

section

/- Canonical inclusions between memory caps preserve literal lengths,
ordered coordinates, active labels, and the factorial product measures. -/

open Finset

namespace Bounty

def boundedMemoryCapEmbed {Z : Type*} {b B : ℕ} (h : b ≤ B)
    (q : BoundedOrderedTuple Z b) : BoundedOrderedTuple Z B :=
  ⟨⟨q.1.val, lt_of_lt_of_le q.1.isLt (Nat.add_le_add_right h 1)⟩, q.2⟩

def boundedStateCapEmbed {P Z : Type*} {t b B : ℕ} (h : b ≤ B)
    (s : BoundedOrderedState P Z t b) : BoundedOrderedState P Z t B :=
  (s.1, boundedMemoryCapEmbed h s.2)

def productStateCapEmbed {G : Type*} {P Z : G → Type*} {M : G → ℕ} {b B : ℕ}
    (h : b ≤ B) (x : ProductBoundedOrderedState P Z M b) :
    ProductBoundedOrderedState P Z M B :=
  fun g => boundedStateCapEmbed h (x g)



















theorem boundedMemoryCapEmbed_injective {Z : Type*} {b B : ℕ} (h : b ≤ B) :
    Function.Injective (boundedMemoryCapEmbed (Z := Z) h) := by
  intro x y hxy
  rcases x with ⟨⟨k, hk⟩, x⟩
  rcases y with ⟨⟨l, hl⟩, y⟩
  have hkl : k = l := congrArg (fun q => q.1.val) hxy
  subst l
  have hvals : x = y := eq_of_heq (Sigma.mk.inj hxy).2
  subst y
  rfl

theorem boundedStateCapEmbed_injective {P Z : Type*} {t b B : ℕ} (h : b ≤ B) :
    Function.Injective (boundedStateCapEmbed (P := P) (Z := Z) (t := t) h) := by
  intro x y hxy
  apply Prod.ext
  · exact congrArg (fun s : BoundedOrderedState P Z t B => s.1) hxy
  · apply boundedMemoryCapEmbed_injective h
    exact congrArg (fun s : BoundedOrderedState P Z t B => s.2) hxy

theorem productStateCapEmbed_injective {G : Type*} {P Z : G → Type*} {M : G → ℕ}
    {b B : ℕ} (h : b ≤ B) :
    Function.Injective (productStateCapEmbed (P := P) (Z := Z) (M := M) h) := by
  intro x y hxy
  funext g
  exact boundedStateCapEmbed_injective h (congrFun hxy g)










theorem productStateCapEmbed_totalMemory {G : Type*} [Fintype G]
    {P Z : G → Type*} {M : G → ℕ} {b B : ℕ} (h : b ≤ B)
    (x : ProductBoundedOrderedState P Z M b) :
    productTotalMemory (productStateCapEmbed h x) = productTotalMemory x := rfl



















end Bounty
end

