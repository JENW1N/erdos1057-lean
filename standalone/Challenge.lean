section

/- Exact four-way disintegration into specified disjoint coordinate sets. -/

open Finset
open scoped BigOperators Classical

namespace Bounty

variable {I : Type*} [Fintype I] [DecidableEq I] {X : I → Type*}

theorem finite_active_four_partition (active A B : Finset I)
    (hA : A ⊆ active) (hB : B ⊆ active) (hAB : Disjoint A B) :
    Disjoint (active \ (A ∪ B)) A ∧
    Disjoint (active \ (A ∪ B)) B ∧
    Disjoint (active \ (A ∪ B)) activeᶜ ∧
    Disjoint A B ∧ Disjoint A activeᶜ ∧ Disjoint B activeᶜ ∧
    (active \ (A ∪ B)) ∪ A ∪ B ∪ activeᶜ = univ := by
  refine ⟨?_, ?_, ?_, hAB, ?_, ?_, ?_⟩
  · exact disjoint_left.mpr (fun i hi ha => (mem_sdiff.mp hi).2 (mem_union_left B ha))
  · exact disjoint_left.mpr (fun i hi hb => (mem_sdiff.mp hi).2 (mem_union_right A hb))
  · exact disjoint_left.mpr (fun i hi ht => (mem_compl.mp ht) (mem_sdiff.mp hi).1)
  · exact disjoint_left.mpr (fun i hi ht => (mem_compl.mp ht) (hA hi))
  · exact disjoint_left.mpr (fun i hi ht => (mem_compl.mp ht) (hB hi))
  · ext i
    by_cases hi : i ∈ active <;> by_cases hiA : i ∈ A <;> by_cases hiB : i ∈ B <;>
      simp [hi, hiA, hiB]

def finiteFourPartitionFill (S A B T : Finset I) (hcover : S ∪ A ∪ B ∪ T = univ)
    (s : ∀ i : S, X i.1) (a : ∀ i : A, X i.1)
    (b : ∀ i : B, X i.1) (t : ∀ i : T, X i.1) (i : I) : X i :=
  if hiS : i ∈ S then s ⟨i, hiS⟩ else
  if hiA : i ∈ A then a ⟨i, hiA⟩ else
  if hiB : i ∈ B then b ⟨i, hiB⟩ else
  t ⟨i, by
    have hi : i ∈ S ∪ A ∪ B ∪ T := by rw [hcover]; exact mem_univ i
    simpa only [mem_union, hiS, hiA, hiB, false_or] using hi⟩

theorem finite_four_partition_fill_s (S A B T : Finset I) (hcover : S ∪ A ∪ B ∪ T = univ)
    (s : ∀ i : S, X i.1) (a : ∀ i : A, X i.1)
    (b : ∀ i : B, X i.1) (t : ∀ i : T, X i.1) :
    finiteCoordinateRestrict S (finiteFourPartitionFill S A B T hcover s a b t) = s := by
  funext i
  simp only [finiteCoordinateRestrict, finiteFourPartitionFill, dif_pos i.property]

theorem finite_four_partition_fill_a (S A B T : Finset I) (hcover : S ∪ A ∪ B ∪ T = univ)
    (hSA : Disjoint S A) (s : ∀ i : S, X i.1) (a : ∀ i : A, X i.1)
    (b : ∀ i : B, X i.1) (t : ∀ i : T, X i.1) :
    finiteCoordinateRestrict A (finiteFourPartitionFill S A B T hcover s a b t) = a := by
  funext i
  have hiS : i.1 ∉ S := fun hi => disjoint_left.mp hSA hi i.property
  simp only [finiteCoordinateRestrict, finiteFourPartitionFill, dif_neg hiS, dif_pos i.property]

theorem finite_four_partition_fill_b (S A B T : Finset I) (hcover : S ∪ A ∪ B ∪ T = univ)
    (hSB : Disjoint S B) (hAB : Disjoint A B)
    (s : ∀ i : S, X i.1) (a : ∀ i : A, X i.1)
    (b : ∀ i : B, X i.1) (t : ∀ i : T, X i.1) :
    finiteCoordinateRestrict B (finiteFourPartitionFill S A B T hcover s a b t) = b := by
  funext i
  have hiS : i.1 ∉ S := fun hi => disjoint_left.mp hSB hi i.property
  have hiA : i.1 ∉ A := fun hi => disjoint_left.mp hAB hi i.property
  simp only [finiteCoordinateRestrict, finiteFourPartitionFill, dif_neg hiS, dif_neg hiA,
    dif_pos i.property]

theorem finite_four_partition_fill_t (S A B T : Finset I) (hcover : S ∪ A ∪ B ∪ T = univ)
    (hST : Disjoint S T) (hAT : Disjoint A T) (hBT : Disjoint B T)
    (s : ∀ i : S, X i.1) (a : ∀ i : A, X i.1)
    (b : ∀ i : B, X i.1) (t : ∀ i : T, X i.1) :
    finiteCoordinateRestrict T (finiteFourPartitionFill S A B T hcover s a b t) = t := by
  funext i
  have hiS : i.1 ∉ S := fun hi => disjoint_left.mp hST hi i.property
  have hiA : i.1 ∉ A := fun hi => disjoint_left.mp hAT hi i.property
  have hiB : i.1 ∉ B := fun hi => disjoint_left.mp hBT hi i.property
  simp only [finiteCoordinateRestrict, finiteFourPartitionFill, dif_neg hiS, dif_neg hiA,
    dif_neg hiB]

def finiteFourPartitionEquiv (S A B T : Finset I)
    (hSA : Disjoint S A) (hSB : Disjoint S B) (hST : Disjoint S T)
    (hAB : Disjoint A B) (hAT : Disjoint A T) (hBT : Disjoint B T)
    (hcover : S ∪ A ∪ B ∪ T = univ) :
    (∀ i, X i) ≃ ((∀ i : S, X i.1) × (∀ i : A, X i.1) ×
      (∀ i : B, X i.1) × (∀ i : T, X i.1)) where
  toFun x := (finiteCoordinateRestrict S x, finiteCoordinateRestrict A x,
    finiteCoordinateRestrict B x, finiteCoordinateRestrict T x)
  invFun q := finiteFourPartitionFill S A B T hcover q.1 q.2.1 q.2.2.1 q.2.2.2
  left_inv x := by
    funext i
    unfold finiteFourPartitionFill
    dsimp only
    split_ifs <;> rfl
  right_inv q := by
    rcases q with ⟨s, a, b, t⟩
    simp only [finite_four_partition_fill_s, finite_four_partition_fill_a S A B T hcover hSA,
      finite_four_partition_fill_b S A B T hcover hSB hAB,
      finite_four_partition_fill_t S A B T hcover hST hAT hBT]




theorem finite_product_value_four_partition {M : Type*} [CommMonoid M]
    (v : ∀ i, X i → M) (S A B T : Finset I)
    (hSA : Disjoint S A) (hSB : Disjoint S B) (hST : Disjoint S T)
    (hAB : Disjoint A B) (hAT : Disjoint A T) (hBT : Disjoint B T)
    (hcover : S ∪ A ∪ B ∪ T = univ) (x : ∀ i, X i) :
    (∏ i, v i (x i)) = (∏ i : S, v i.1 (x i.1)) * (∏ i : A, v i.1 (x i.1)) *
      (∏ i : B, v i.1 (x i.1)) * ∏ i : T, v i.1 (x i.1) := by
  rw [prod_coe_sort S (fun i => v i (x i)), prod_coe_sort A (fun i => v i (x i)),
    prod_coe_sort B (fun i => v i (x i)), prod_coe_sort T (fun i => v i (x i))]
  rw [← hcover, prod_union (disjoint_union_left.mpr
    ⟨disjoint_union_left.mpr ⟨hST, hAT⟩, hBT⟩),
    prod_union (disjoint_union_left.mpr ⟨hSB, hAB⟩), prod_union hSA]

theorem finite_product_weight_four_partition (μ : ∀ i, X i → ℝ) (S A B T : Finset I)
    (hSA : Disjoint S A) (hSB : Disjoint S B) (hST : Disjoint S T)
    (hAB : Disjoint A B) (hAT : Disjoint A T) (hBT : Disjoint B T)
    (hcover : S ∪ A ∪ B ∪ T = univ) (x : ∀ i, X i) :
    finiteProductWeight μ x =
      finiteProductWeight (fun i : S => μ i.1) (finiteCoordinateRestrict S x) *
      finiteProductWeight (fun i : A => μ i.1) (finiteCoordinateRestrict A x) *
      finiteProductWeight (fun i : B => μ i.1) (finiteCoordinateRestrict B x) *
      finiteProductWeight (fun i : T => μ i.1) (finiteCoordinateRestrict T x) :=
  finite_product_value_four_partition μ S A B T hSA hSB hST hAB hAT hBT hcover x

theorem finite_product_weight_four_fill (μ : ∀ i, X i → ℝ) (S A B T : Finset I)
    (hSA : Disjoint S A) (hSB : Disjoint S B) (hST : Disjoint S T)
    (hAB : Disjoint A B) (hAT : Disjoint A T) (hBT : Disjoint B T)
    (hcover : S ∪ A ∪ B ∪ T = univ)
    (s : ∀ i : S, X i.1) (a : ∀ i : A, X i.1)
    (b : ∀ i : B, X i.1) (t : ∀ i : T, X i.1) :
    finiteProductWeight μ (finiteFourPartitionFill S A B T hcover s a b t) =
      finiteProductWeight (fun i : S => μ i.1) s *
      finiteProductWeight (fun i : A => μ i.1) a *
      finiteProductWeight (fun i : B => μ i.1) b *
      finiteProductWeight (fun i : T => μ i.1) t := by
  rw [finite_product_weight_four_partition μ S A B T hSA hSB hST hAB hAT hBT hcover,
    finite_four_partition_fill_s, finite_four_partition_fill_a S A B T hcover hSA,
    finite_four_partition_fill_b S A B T hcover hSB hAB,
    finite_four_partition_fill_t S A B T hcover hST hAT hBT]

variable [∀ i, Fintype (X i)]













end Bounty
