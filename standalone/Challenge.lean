theorem eventually_harmonic_normalized_full_box_precision
    {r c E : ℝ} (hr : 0 < r) (hc : 0 ≤ c) (F : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ, 1 ≤ Y → Real.log Y ≤ c*L →
      ∀ (D A B C : Finset ℕ) (δ α β γ : ℕ → ℂ) (D₀ A₀ B₀ C₀ : ℝ),
      0 ≤ D₀ → 0 ≤ A₀ → 0 ≤ B₀ → 0 ≤ C₀ → D₀*A₀*B₀*C₀ ≤ L^E →
      (∀ d ∈ D, 0 < d) → (∀ a ∈ A, 0 < a) →
      (∀ b ∈ B, 0 < b) → (∀ z ∈ C, 0 < z) →
      (∀ d ∈ D, ‖δ d‖ ≤ D₀) → (∀ a ∈ A, ‖α a‖ ≤ A₀) →
      (∀ b ∈ B, ‖β b‖ ≤ B₀) → (∀ z ∈ C, ‖γ z‖ ≤ C₀) →
      (∀ d ∈ D, ∀ a ∈ A, ∀ b ∈ B, ∀ z ∈ C,
        Y/128 ≤ ((d*a*b*z : ℕ) : ℝ) ∧
          ((d*a*b*z : ℕ) : ℝ) ≤ 64*Real.exp 2*Y) →
      ∀ T w : ℝ, 0 ≤ T → T ≤ L*Y →
      (∀ u, ‖u‖ ≤ L^r → (∫ s in Set.Icc (-T) T,
        ‖(∑ d ∈ D, δ d * harmonicMellinWeight (s+w+2*Real.pi*u) d) *
          (∑ a ∈ A, α a * harmonicMellinWeight (s+w+2*Real.pi*u) a) *
          (∑ b ∈ B, β b * harmonicMellinWeight (s+w+2*Real.pi*u) b) *
          (∑ z ∈ C, γ z * harmonicMellinWeight (s+w+2*Real.pi*u) z)‖^2) ≤
            L^(-(F+1))) →
      (∫ s in Set.Icc (-T) T,
        ‖∑ d ∈ D, ∑ a ∈ A, ∑ b ∈ B, ∑ z ∈ C,
          (δ d * α a * β b * γ z) *
            ((harmonicCommonCutoff (((d*a*b*z : ℕ) : ℝ) / Y) /
              ((d*a*b*z : ℕ) : ℝ) : ℝ) : ℂ) *
            physicalMellinPhase (s+w) ((d*a*b*z : ℕ) : ℝ)‖^2) ≤ L^(-F) := by
  let M : ℝ := ∫ u, ‖harmonicWindowLogFourier u‖
  filter_upwards [eventually_harmonic_four_box_shifted_mean_square (E := E) hc,
    eventually_schwartz_squared_tail_polynomial harmonicWindowLogFourier hr
      1 (2*E+17) (F+1) (by norm_num),
    eventually_ge_atTop (2+2*M^2), eventually_gt_atTop (0 : ℝ)]
    with L hmean htail hconstant hL
  intro Y hY hlogY D A B C δ α β γ D₀ A₀ B₀ C₀
    hD₀ hA₀ hB₀ hC₀ hprod hD hA hB hC hδ hα hβ hγ hgeom T w hT hTY hcentral
  have hb := harmonic_normalized_full_box_energy (zero_lt_one.trans_le hY)
    (-T) T (L^r) (L^(2*E+17)) (L^(-(F+1))) w
    D A B C δ α β γ hD hA hB hC (by
      intro u
      simpa only [add_assoc] using hmean Y hY hlogY D A B C δ α β γ D₀ A₀ B₀ C₀
        hD₀ hA₀ hB₀ hC₀ hprod hD hA hB hC hδ hα hβ hγ hgeom
        T (w+2*Real.pi*u) hT hTY) hcentral
  have hm : (∫ u in {u : ℝ | ‖u‖ ≤ L^r}, ‖harmonicWindowLogFourier u‖) ≤ M :=
    integral_mono_measure Measure.restrict_le_self
      (Eventually.of_forall (fun u => norm_nonneg (harmonicWindowLogFourier u)))
      harmonic_window_log_fourier_integrable.norm
  have hm0 : 0 ≤ ∫ u in {u : ℝ | ‖u‖ ≤ L^r}, ‖harmonicWindowLogFourier u‖ :=
    integral_nonneg (fun u => norm_nonneg _)
  have hmass := mul_le_mul_of_nonneg_right (pow_le_pow_left₀ hm0 hm 2)
    (Real.rpow_nonneg hL.le (-(F+1)))
  simp only [one_mul] at htail
  apply hb.trans
  calc
    _ ≤ 2*L^(-(F+1)) + 2*M^2*L^(-(F+1)) := by nlinarith only [htail,hmass]
    _ = (2+2*M^2)*L^(-(F+1)) := by ring
    _ ≤ L*L^(-(F+1)) := mul_le_mul_of_nonneg_right hconstant (Real.rpow_nonneg hL.le _)
    _ = L^(-F) := by
      rw [show -F = 1 + -(F+1) by ring, Real.rpow_add hL, Real.rpow_one]

end Bounty
end

