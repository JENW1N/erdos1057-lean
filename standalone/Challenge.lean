open MeasureTheory

namespace Bounty




theorem typeII_e_majorant_log_scale_eq_one {L t : ℝ} (hL : 0 < L)
    (ht : t ∈ Set.Icc ((L ^ 88)⁻¹) 1) :
    typeIIEMajorant (L ^ 88) t = 1 := by
  apply typeII_e_majorant_eq_one _ ht.2
  have hp : 0 < L ^ 88 := pow_pos hL _
  have hb := mul_le_mul_of_nonneg_left ht.1 hp.le
  simpa only [mul_inv_cancel₀ hp.ne'] using hb







