      ∃b d:_root_.OAI.ActualEisensteinCubic.O,a*d-b*(c*r)=1 ∧ M*c∣d-d0 ∧ (9:_root_.OAI.ActualEisensteinCubic.O)∣d ∧
        (9:_root_.OAI.ActualEisensteinCubic.O)∣a*d ∧ (9:_root_.OAI.ActualEisensteinCubic.O)∣b*(c*r)+1 ∧ (3:_root_.OAI.ActualEisensteinCubic.O)∣b+1 ∧ (3:_root_.OAI.ActualEisensteinCubic.O)∣c*r-1 := by
  have hcl:¬lambda∣c:=by
    intro hd
    have hcL:IsCoprime lambda c:=
      (primary_coprime_three c hc).symm.of_isCoprime_of_dvd_left
