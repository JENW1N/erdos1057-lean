section
open Finset Classical
abbrev CoupledGhostEvent {G : Type*} {P Z : G → Type*} (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P Z t B) :=
  ∀ g, BoundedGhostEvent (t g) B (s g)

abbrev CoupledGhostPhase {G : Type*} (P Z : G → Type*) (t : G → ℕ) (B : ℕ) :=
  ∀ s : ProductBoundedOrderedState P Z t B, CoupledGhostEvent t B s → ℂ

noncomputable def coupledGhostOperator {G : Type*} [Fintype G]
    {P Z : G → Type*} [∀ g, Fintype (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (t : G → ℕ) (B : ℕ)
    (phase : CoupledGhostPhase P Z t B) (f : ProductBoundedOrderedState P Z t B → ℂ) :=
  finiteProductEventAction (fun g => BoundedGhostEvent (t g) B)
    (fun g => boundedGhostEventWeight (A g) (D g) (C g) (ν g) (t g) B)
    (fun g => boundedGhostEventTarget (t g) B) phase f

noncomputable def coupledGhostCutoffOperator {G : Type*} [Fintype G]
    {P Z : G → Type*} [∀ g, Fintype (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (t : G → ℕ) (B : ℕ)
    (phase : CoupledGhostPhase P Z t B) (f : ProductBoundedOrderedState P Z t B → ℂ) :=
  productMemoryCutoff (coupledGhostOperator A D C ν t B phase (productMemoryCutoff f))

noncomputable def coupledGhostJointEventTarget {G : Type*} {P Z : G → Type*}
    (t : G → ℕ) (B : ℕ) (s : ProductBoundedOrderedState P Z t B)
    (e : CoupledGhostEvent t B s) : ProductBoundedOrderedState P Z t B :=
  fun g => boundedGhostEventTarget (t g) B (s g) (e g)

noncomputable def coupledGhostJointEventWeight {G : Type*} [Fintype G]
    {P Z : G → Type*} (A D C ν : ∀ g, Z g → ℝ) (t : G → ℕ) (B : ℕ)
    (s : ProductBoundedOrderedState P Z t B) (e : CoupledGhostEvent t B s) : ℝ :=
  if productTotalMemory s ≤ B ∧ productTotalMemory (coupledGhostJointEventTarget t B s e) ≤ B
  then ∏ g, boundedGhostEventWeight (A g) (D g) (C g) (ν g) (t g) B (s g) (e g)
  else 0

theorem coupled_ghost_one_eq_coordinate_action {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)] [∀ g, DecidableEq (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (t : G → ℕ) (B : ℕ)
    (f : ProductBoundedOrderedState P Z t B → ℂ) :
    coupledGhostOperator A D C ν t B (fun _ _ => 1) f =
      finiteCoordinateFinsetAction
        (fun g => boundedOrderedGhostOperator (A g) (D g) (C g) (ν g) (t g) B) univ f := by
  let E := fun g => @BoundedGhostEvent (P g) (Z g) (t g) B
  let w := fun g => @boundedGhostEventWeight (P g) (Z g) (A g) (D g) (C g) (ν g) (t g) B
  let target := fun g => @boundedGhostEventTarget (P g) (Z g) (t g) B
  have hlocal : finiteLocalEventAction E w target =
      fun g => boundedOrderedGhostOperator (A g) (D g) (C g) (ν g) (t g) B := by
    funext g q s
    have h := bounded_ordered_ghost_eq_event_sum (A g) (D g) (C g) (ν g) (t g) B q s
    refine Eq.trans ?_ h.symm
    apply sum_congr
    · ext e
      simp only [mem_univ]
    · intro e _
      rfl
  have h := finite_product_event_eq_coordinate_action E w target f
  rw [hlocal] at h
  exact h

theorem coupled_ghost_cutoff_one_eq_coordinate_action {G : Type*} [Fintype G] [DecidableEq G]
    {P Z : G → Type*} [∀ g, Fintype (P g)] [∀ g, Fintype (Z g)] [∀ g, DecidableEq (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (t : G → ℕ) (B : ℕ)
    (f : ProductBoundedOrderedState P Z t B → ℂ) :
    coupledGhostCutoffOperator A D C ν t B (fun _ _ => 1) f =
      productMemoryCutoff (finiteCoordinateFinsetAction
        (fun g => boundedOrderedGhostOperator (A g) (D g) (C g) (ν g) (t g) B)
        univ (productMemoryCutoff f)) := by
  unfold coupledGhostCutoffOperator
  rw [coupled_ghost_one_eq_coordinate_action]

theorem coupled_ghost_norm_le_positive_re {G : Type*} [Fintype G]
    {P Z : G → Type*} [∀ g, Fintype (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (hA : ∀ g z, 0 ≤ A g z) (hν : ∀ g z, 0 ≤ ν g z)
    (t : G → ℕ) (B : ℕ) (phase : CoupledGhostPhase P Z t B)
    (hphase : ∀ s e, ‖phase s e‖ ≤ 1) (f : ProductBoundedOrderedState P Z t B → ℂ)
    (s : ProductBoundedOrderedState P Z t B) :
    ‖coupledGhostOperator A D C ν t B phase f s‖ ≤
      (coupledGhostOperator A (fun g z => |D g z|) (fun g z => |C g z|) ν t B
        (fun _ _ => 1) (complexNormEnvelope f) s).re := by
  have h := finite_product_event_norm_le_abs_positive_re
    (fun g => @BoundedGhostEvent (P g) (Z g) (t g) B)
    (fun g => boundedGhostEventWeight (A g) (D g) (C g) (ν g) (t g) B)
    (fun g => boundedGhostEventTarget (t g) B) phase hphase f s
  have habs : (fun g x e => |boundedGhostEventWeight (A g) (D g) (C g) (ν g) (t g) B x e|) =
      fun g => @boundedGhostEventWeight (P g) (Z g)
        (A g) (fun z => |D g z|) (fun z => |C g z|) (ν g) (t g) B := by
    funext g x e
    exact boundedGhostEventWeight_abs (A g) (D g) (C g) (ν g) (hA g) (hν g) (t g) B x e
  rw [habs] at h
  exact h

theorem coupled_ghost_cutoff_norm_le_positive_re {G : Type*} [Fintype G]
    {P Z : G → Type*} [∀ g, Fintype (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (hA : ∀ g z, 0 ≤ A g z) (hν : ∀ g z, 0 ≤ ν g z)
    (t : G → ℕ) (B : ℕ) (phase : CoupledGhostPhase P Z t B)
    (hphase : ∀ s e, ‖phase s e‖ ≤ 1) (f : ProductBoundedOrderedState P Z t B → ℂ)
    (s : ProductBoundedOrderedState P Z t B) :
    ‖coupledGhostCutoffOperator A D C ν t B phase f s‖ ≤
      (coupledGhostCutoffOperator A (fun g z => |D g z|) (fun g z => |C g z|) ν t B
        (fun _ _ => 1) (complexNormEnvelope f) s).re := by
  have he : complexNormEnvelope (productMemoryCutoff f) =
      productMemoryCutoff (complexNormEnvelope f) := by
    funext x
    simp only [complexNormEnvelope, productMemoryCutoff]
    split_ifs
    · rfl
    · simp only [norm_zero, Complex.ofReal_zero]
  have h := coupled_ghost_norm_le_positive_re A D C ν hA hν t B phase hphase (productMemoryCutoff f) s
  rw [he] at h
  unfold coupledGhostCutoffOperator
  simp only [productMemoryCutoff]
  split_ifs
  · exact h
  · simp only [norm_zero, Complex.zero_re, le_refl]

theorem coupled_ghost_cutoff_eq_joint_event_sum {G : Type*} [Fintype G]
    {P Z : G → Type*} [∀ g, Fintype (Z g)]
    (A D C ν : ∀ g, Z g → ℝ) (t : G → ℕ) (B : ℕ)
    (phase : CoupledGhostPhase P Z t B) (f : ProductBoundedOrderedState P Z t B → ℂ)
    (s : ProductBoundedOrderedState P Z t B) :
    coupledGhostCutoffOperator A D C ν t B phase f s =
      ∑ e : CoupledGhostEvent t B s, (coupledGhostJointEventWeight A D C ν t B s e : ℂ) *
        phase s e * f (coupledGhostJointEventTarget t B s e) := by
  unfold coupledGhostCutoffOperator coupledGhostOperator finiteProductEventAction productMemoryCutoff
  by_cases hs : productTotalMemory s ≤ B
  · rw [if_pos hs]
    apply sum_congr rfl
    intro e _
    by_cases ht : productTotalMemory (coupledGhostJointEventTarget t B s e) ≤ B
    · simp [coupledGhostJointEventWeight, hs, ht,
        show productTotalMemory (fun g => boundedGhostEventTarget (t g) B (s g) (e g)) ≤ B from ht]
      exact Or.inl rfl
    · simp [coupledGhostJointEventWeight, hs, ht,
        show ¬productTotalMemory (fun g => boundedGhostEventTarget (t g) B (s g) (e g)) ≤ B from ht]
  · simp [hs, coupledGhostJointEventWeight]




theorem coupledGhostJointEventWeight_abs {G : Type*} [Fintype G]
    {P Z : G → Type*} (A D C ν : ∀ g, Z g → ℝ)
    (hA : ∀ g z, 0 ≤ A g z) (hν : ∀ g z, 0 ≤ ν g z)
    (t : G → ℕ) (B : ℕ) (s : ProductBoundedOrderedState P Z t B)
    (e : CoupledGhostEvent t B s) :
    |coupledGhostJointEventWeight A D C ν t B s e| =
      coupledGhostJointEventWeight A (fun g z => |D g z|) (fun g z => |C g z|) ν t B s e := by
  unfold coupledGhostJointEventWeight
  split_ifs
  · rw [abs_prod]
    apply prod_congr rfl
    intro g _
    exact boundedGhostEventWeight_abs (A g) (D g) (C g) (ν g) (hA g) (hν g) (t g) B (s g) (e g)
  · exact abs_zero
end

