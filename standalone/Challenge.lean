variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (V : G → ℝ)

include G sharedInstance1 P J ell V

theorem repeated_big_ban_difference_norm_le  (C : G → Finset (Fin J))
    (hV : ∀ g, 0 ≤ V g) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (_hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    (aux : PhysicalAuxLabels P C) (source target : RepeatedBigLists P J ell) :
    ‖repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K aux source target -
        repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖ ≤
      B * (if repeatedBigSharedCompatible C source target then
          repeatedBigTargetMass V (fun _ _ => 1) C target else 0) *
        (physicalAuxMass V C aux *
          (if ¬(repeatedBigAuxAvoids C aux source ∧ repeatedBigAuxAvoids C aux target) then 1 else 0)) := by
  have ha := physical_aux_mass_nonneg V C hV aux
  have ht := repeated_big_untilted_target_mass_nonneg V hV C target
  by_cases hs : repeatedBigSharedCompatible C source target
  · by_cases hb : repeatedBigAuxAvoids C aux source ∧ repeatedBigAuxAvoids C aux target
    · simp [repeatedBigUnbannedKernel, repeatedBigKernel, hs, hb]
    · simp only [repeatedBigUnbannedKernel, repeatedBigKernel, hs, true_and, if_true,
        hb, if_false, not_false_eq_true, sub_zero, mul_one, norm_mul, physical_phase_norm,
        Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg ha, abs_of_nonneg ht]
      calc
        _ ≤ (physicalAuxMass V C aux * repeatedBigTargetMass V (fun _ _ => 1) C target) * B :=
          mul_le_mul_of_nonneg_left (hK source target aux) (mul_nonneg ha ht)
        _ = _ := by ring
  · simp [repeatedBigUnbannedKernel, repeatedBigKernel, hs]

/- Summing all free-label collisions costs only the total number of endpoint comparisons. -/
theorem repeated_big_ban_difference_absolute_row_bound  (C : G → Finset (Fin J))
    (hV : ∀ g, 0 < V g) (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
    (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (B : ℝ) (hB : 0 ≤ B) (hK : ∀ x y a, ‖K x y a‖ ≤ B)
    {Pmin : ℝ} (hPmin : 0 < Pmin) (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (source : RepeatedBigLists P J ell) :
    (∑ aux, ∑ target, ‖repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K aux source target -
        repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖) ≤
      B * ∑ g, (C g).card * (2 * (J + ell : ℕ)) / (V g * Pmin) := by
  let δ : ℝ := ∑ g, (C g).card * (2 * (J + ell : ℕ)) / (V g * Pmin)
  let mass (target : RepeatedBigLists P J ell) : ℝ :=
    if repeatedBigSharedCompatible C source target then
      repeatedBigTargetMass V (fun _ _ => 1) C target else 0
  have hm (target) : 0 ≤ mass target := by
    dsimp [mass]
    split_ifs
    · exact repeated_big_untilted_target_mass_nonneg V (fun g => (hV g).le) C target
    · exact le_rfl
  calc
    _ = ∑ target, ∑ aux, ‖repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K aux source target -
        repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖ := sum_comm
    _ ≤ ∑ target, B * mass target * δ := by
      apply sum_le_sum
      intro target ht
      calc
        _ ≤ ∑ aux, B * mass target * (physicalAuxMass V C aux *
            (if ¬(repeatedBigAuxAvoids C aux source ∧ repeatedBigAuxAvoids C aux target) then 1 else 0)) :=
          sum_le_sum (fun aux _ => repeated_big_ban_difference_norm_le
            V C (fun g => (hV g).le) ζ K B hB hK aux source target)
        _ = B * mass target * ∑ aux, physicalAuxMass V C aux *
            (if ¬(repeatedBigAuxAvoids C aux source ∧ repeatedBigAuxAvoids C aux target) then 1 else 0) :=
          (mul_sum _ _ _).symm
        _ ≤ _ := mul_le_mul_of_nonneg_left
          (repeated_big_auxiliary_collision_mass_le V C hV hMass source target hPmin hp)
          (mul_nonneg hB (hm target))
    _ = B * δ := by
      rw [← sum_mul, ← mul_sum]
      dsimp [mass]
      rw [repeated_big_untilted_compatible_target_mass_sum V C hV hMass source, mul_one]

theorem repeated_big_unbanned_kernel_weighted_transpose  (b : ∀ g, P g → ℝ)
    (C : G → Finset (Fin J)) (ζ : ℝ)
    (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
    (aux : PhysicalAuxLabels P C) (source target : RepeatedBigLists P J ell) :
    (repeatedBigActiveMass V b source : ℂ) * repeatedBigUnbannedKernel V b C ζ K aux source target =
      (repeatedBigActiveMass V b target : ℂ) *
        repeatedBigUnbannedKernel V b C ζ (fun x y a => K y x a) aux target source := by
  unfold repeatedBigUnbannedKernel
  by_cases hs : repeatedBigSharedCompatible C source target
  · rw [if_pos hs, if_pos (repeated_big_shared_compatible_symm C hs),
      ← repeated_big_D_eq_of_shared C hs aux]
    have hm := congrArg (fun x : ℝ => (x : ℂ))
      (repeated_big_active_target_mass_balance V b C hs)
    push_cast at hm ⊢
    linear_combination (physicalAuxMass V C aux : ℂ) * K source target aux *
      physicalPhase ζ (repeatedBigD C source aux) * hm
  · have hr : ¬ repeatedBigSharedCompatible C target source :=
      fun h => hs (repeated_big_shared_compatible_symm C h)
    rw [if_neg hs, if_neg hr, mul_zero, mul_zero]

end


