theorem eventually_original_mellin_scale_geometry_range {b K R : ℝ} (hb : 0 < b) (hK : 0 ≤ K) (hR : 0 < R) :
    ∀ᶠ L : ℝ in atTop, ∀ U V : ℝ,
      exp (b*L) ≤ U → exp (b*L) ≤ V → 2*U*V ≤ R*exp L →
      1 ≤ U*L^(-K) ∧ log (U*L^(-K)) ≤ (1-b/2)*L := by
  have hgrowth := eventually_mul_rpow_log_add_le_rpow
    (a := (0:ℝ)) (b := (1:ℝ)) (c := b)
    (by norm_num) (by norm_num) hb K 0
  have hconstant := eventually_mul_rpow_log_add_le_rpow
    (a := (0:ℝ)) (b := (1:ℝ)) (c := b/2)
    (by norm_num) (by norm_num) (by positivity) 0 (log R)
  filter_upwards [hgrowth, hconstant, eventually_ge_atTop (1:ℝ)] with L hgrowth hconstant hL
  simp only [rpow_zero, rpow_one, mul_one, zero_mul, zero_add, add_zero] at hgrowth hconstant
  intro U V hUlo hVlo hcoarse
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hU : 0 < U := (exp_pos _).trans_le hUlo
  have hV : 0 < V := (exp_pos _).trans_le hVlo
  have hE : 0 < U*L^(-K) := by positivity
  have hlogUlo : b*L ≤ log U := by simpa only [log_exp] using log_le_log (exp_pos _) hUlo
  have hlogVlo : b*L ≤ log V := by simpa only [log_exp] using log_le_log (exp_pos _) hVlo
  have hUV : U*V ≤ R*exp L := by nlinarith [mul_pos hU hV]
  have hlogUV := log_le_log (mul_pos hU hV) hUV
  rw [log_mul hU.ne' hV.ne', log_mul hR.ne' (exp_ne_zero _), log_exp] at hlogUV
  have hlogE : log (U*L^(-K)) = log U-K*log L := by
    rw [log_mul hU.ne' (rpow_pos_of_pos hL0 _).ne', log_rpow hL0]
    ring
  have hnonneg : 0 ≤ log (U*L^(-K)) := by rw [hlogE]; linarith
  constructor
  · rw [← exp_log hE]
    exact one_le_exp_iff.mpr hnonneg
  · rw [hlogE]
    have hcost : 0 ≤ K*log L := mul_nonneg hK (log_nonneg hL)
    nlinarith

