section

/- An explicit polynomial bound absorbs the complete harmonic energy scale loss. -/

namespace Bounty

theorem harmonic_energy_scalar_polynomial {A s L N Y : ℝ}
    (hA : 0 ≤ A) (hs : 0 ≤ s) (hL : 1 ≤ L)
    (hcost : 16*(5+Real.log 4+A)^15 ≤ L)
    (hN : 1 ≤ N) (hratio : N/Y ≤ 8)
    (hlog : Real.log N ≤ Real.log 4+4*L+A*L^s*Real.log L) :
    2*(N/Y)*(1+Real.log N)^15 ≤ L^(15*(max 1 s+1)+1) := by
  let p : ℝ := max 1 s+1
  let C : ℝ := 5+Real.log 4+A
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  have hm0 : 0 ≤ max 1 s := hs.trans (le_max_right _ _)
  have hp0 : 0 ≤ p := add_nonneg hm0 zero_le_one
  have h1 : 1 ≤ L^p := Real.one_le_rpow hL hp0
  have hlin : L ≤ L^p := by
    simpa only [Real.rpow_one] using
      Real.rpow_le_rpow_of_exponent_le hL (show (1 : ℝ) ≤ p by dsimp [p]; linarith)
  have hpow : L^s*Real.log L ≤ L^p := by
    calc
      _ ≤ L^s*L := mul_le_mul_of_nonneg_left (Real.log_le_self hL0.le) (Real.rpow_nonneg hL0.le s)
      _ = L^(s+1) := by rw [Real.rpow_add hL0, Real.rpow_one]
      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hL (by dsimp [p]; linarith [le_max_right (1 : ℝ) s])
  have hlog4 : 0 ≤ Real.log 4 := Real.log_nonneg (by norm_num)
  have h4 : 4*L ≤ 4*L^p := mul_le_mul_of_nonneg_left hlin (by norm_num)
  have hc : Real.log 4 ≤ Real.log 4*L^p := by
    simpa only [mul_one] using mul_le_mul_of_nonneg_left h1 hlog4
  have ha : A*L^s*Real.log L ≤ A*L^p := by
    simpa only [mul_assoc] using mul_le_mul_of_nonneg_left hpow hA
  have hsum : 1+Real.log N ≤ C*L^p := by dsimp [C]; nlinarith
  have hnonneg : 0 ≤ 1+Real.log N := add_nonneg zero_le_one (Real.log_nonneg hN)
  have hpower : (L^p)^15 = L^(15*p) := by
    rw [← Real.rpow_mul_natCast hL0.le]
    congr 1
    ring
  calc
    _ ≤ 16*(1+Real.log N)^15 := mul_le_mul_of_nonneg_right (by linarith) (pow_nonneg hnonneg _)
    _ ≤ 16*(C*L^p)^15 := mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ hnonneg hsum 15) (by norm_num)
    _ = (16*C^15)*L^(15*p) := by rw [mul_pow, hpower]; ring
    _ ≤ L*L^(15*p) := mul_le_mul_of_nonneg_right hcost (Real.rpow_nonneg hL0.le _)
    _ = _ := by
      change L*L^(15*p) = L^(15*p+1)
      rw [Real.rpow_add hL0, Real.rpow_one]
      exact mul_comm _ _

end Bounty
end

section

/- The exact memory product of a merged selected path reduces to the big
selected data with the original small labels retained in its coefficient. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_selected_split_memory_labeled
    {I G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell n : ℕ}
    (small : G → Prop) (patterns : Finset I) (C : I → G → Finset (Fin J))
    (pattern : Fin n → patterns)
    (ds : PhysicalGroupSelectedData (fun g : {g // small g} => P g.val) ell
      (fun j g => C (pattern j).val g.val))
    (db : PhysicalGroupSelectedData (fun g : {g // ¬small g} => P g.val) ell
      (fun j g => C (pattern j).val g.val))
    (V : G → ℝ) (ζ : I → ℝ)
    (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C i) → ℂ)
    (j : Fin n) :
    let d := (physicalGroupSelectedSplit small (fun j => C (pattern j).val)).symm (ds, db)
    let a : PhysicalEdgeLabels P J ell patterns C := (d.2.2.1 j, d.2.2.2 j, ⟨pattern j, d.1 j⟩)
    physicalMemoryLabeledScalar (fun g : {g // ¬small g} => V g.val) patterns
      (fun i g => C i g.val) (fun _ => 0)
      (physicalFixedEdgeBigCoefficient small patterns C ζ K a (d.2.1 j.castSucc) (d.2.1 j.succ))
      (physicalRestrictedEdge (fun g => ¬small g) patterns C a)
      (fun g => d.2.1 j.castSucc g.val) (fun g => d.2.1 j.succ g.val) =
    (Fintype.card (PhysicalPermutations {g // ¬small g} J ell) : ℂ)⁻¹ *
      (Fintype.card (PhysicalPermutations {g // ¬small g} J ell) : ℂ)⁻¹ *
      (if physicalListAdmissible (fun g => C (pattern j).val g.val) (db.1 j)
        (physicalPermuteLabels (db.2.2.1 j) (db.2.1 j.castSucc))
        (physicalPermuteLabels (db.2.2.2 j) (db.2.1 j.succ)) then
        (physicalAuxMass (fun g : {g // ¬small g} => V g.val)
          (fun g => C (pattern j).val g.val) (db.1 j) : ℂ) *
        physicalCoupledBigCoefficient small (C (pattern j).val) (ζ (pattern j).val) (K (pattern j).val)
          (physicalPermuteLabels (ds.2.2.1 j) (ds.2.1 j.castSucc))
          (physicalPermuteLabels (ds.2.2.2 j) (ds.2.1 j.succ)) (ds.1 j)
          (physicalPermuteLabels (db.2.2.1 j) (db.2.1 j.castSucc))
          (physicalPermuteLabels (db.2.2.2 j) (db.2.1 j.succ)) (db.1 j)
        else 0) := by
  dsimp only
  let d := (physicalGroupSelectedSplit small (fun j => C (pattern j).val)).symm (ds, db)
  have hb := congrArg Prod.snd
    ((physicalGroupSelectedSplit small (fun j => C (pattern j).val)).apply_symm_apply (ds, db))
  have hbl (i) : (fun g : {g // ¬small g} => d.2.1 i g.val) = db.2.1 i :=
    congrArg (fun x => x.2.1 i) hb
  have hbs : (fun g : {g // ¬small g} => d.2.2.1 j g.val) = db.2.2.1 j :=
    congrArg (fun x => x.2.2.1 j) hb
  have hbt : (fun g : {g // ¬small g} => d.2.2.2 j g.val) = db.2.2.2 j :=
    congrArg (fun x => x.2.2.2 j) hb
  have hba : (fun g : {g // ¬small g} => d.1 j g.val) = db.1 j :=
    congrArg (fun x => x.1 j) hb
  simp only [physicalMemoryLabeledScalar, physicalRestrictedEdge,
    physical_phase_zero_frequency, mul_one]
  change _ = _
  rw [hbl, hbl, hbs, hbt, hba]
  rw [physical_selected_split_fixed_coefficient]

end Bounty
end

section

/- Both actual harmonic replacement errors on the same positive support. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_positive_harmonic_replacement_error
    {G : Type*} [Fintype G] [dG : DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (hprime : ∀ g p, p ∈ P g → p.Prime)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    {v : ℝ} (hv : 0 < v) (hV : ∀ g, v ≤ V g)
    (hMass : ∀ g, ∑ p ∈ P g, 1/(p : ℝ) = V g)
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ) (hξ : 0 < ξ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b : ℝ) {Z : ℝ} (hZ : 0 < Z) (k : ℤ) (hk : |(k : ℝ)| ≤ Z)
    {Pmin ε : ℝ} (hPmin : 0 < Pmin) (hε : 0 ≤ ε)
    (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))
    (pool : Finset ℕ) (hpool : ∀ g, P g ⊆ pool) (α β γ α' β' γ' : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ n, ‖γ n‖ ≤ C)
    (hα' : ∀ m, ‖α' m‖ ≤ A) (hβ' : ∀ p, ‖β' p‖ ≤ B) (hγ' : ∀ n, ‖γ' n‖ ≤ C)
    (herror : ∀ n ∈ harmonicPositiveSupport Z k (physicalFreeFactor (repeatedBigPrimePatternCut probes r t i) aux),
      let cut := repeatedBigPrimePatternCut probes r t i
      let δ : ℤ := k*(physicalFreeFactor cut aux : ℤ)
      let H := repeatedBigPrimePatternBound probes r t Q ξ i
      (∑ g, (J-(cut g).card : ℕ) *
        (Real.log n.natAbs / Real.log 2 + Real.log (n+δ).natAbs / Real.log 2 + J) /
          (V g*Pmin)) * (H+H/(1/2 : ℝ)^(2*∑ g : G, (J-(cut g).card))) ≤ ε) :
    let cut := repeatedBigPrimePatternCut probes r t i
    let d := physicalFreeFactor cut aux
    let N := ⌈3*Z*(d : ℝ)⌉₊
    let Y := Z*(d : ℝ)/2
    let M := (markedDivisorBound (1/2) v (ell+J))^Fintype.card G
    let energy := 2*((N : ℝ)/Y)*(1+Real.log N)^15
    let H := repeatedBigPrimePatternBound probes r t Q ξ i
    ‖physicalPositiveHarmonicDifference P V probes r t hrt Q h ξ i aux a b Z k pool α β γ α' β' γ'‖ ≤
      (M*M*(A*B*C)^2*energy)*ε +
      (2*M*M*(A*B*C)^2*energy*H)*(∑ p ∈ physicalFreePrimeSet cut aux, 1/(p : ℝ)) := by
  cases Subsingleton.elim dG (Classical.typeDecidableEq G)
  let cut := repeatedBigPrimePatternCut probes r t i
  let d := physicalFreeFactor cut aux
  let δ : ℤ := k*(d : ℤ)
  let N := ⌈3*Z*(d : ℝ)⌉₊
  let S := harmonicPositiveSupport Z k d
  let θ := fun n : ℤ => (typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)
  let F := fun n : ℤ => θ n/(n : ℂ)*star (invariantTripleEndpoint pool α β γ n.natAbs)*
    invariantTripleEndpoint pool α' β' γ' (n+δ).natAbs
  have hd : 0 < d := prod_pos (fun g _ => prod_pos (fun u _ => (hprime g _ (aux g u).property).pos))
  have hs := harmonic_positive_error_parameters hZ k hd hk
  have hshared := physical_prime_harmonic_pair_error P V probes hprime hdis hv hV hMass
    r t hrt Q h ξ hξ i aux a b hPmin hε hp pool α β γ α' β' γ' hA hB hC
    hα hβ hγ hα' hβ' hγ' S δ N (fun n hn => (hs.2 n hn).1)
    (fun n hn => (hs.2 n hn).2.1) hs.1 (by norm_num : (0 : ℝ) ≤ 2)
    (fun n hn => (hs.2 n hn).2.2.1) θ (fun n hn => (hs.2 n hn).2.2.2) herror
  have haux := physical_prime_aux_harmonic_error P V probes hprime hv hV r t hrt Q h ξ hξ
    i aux a b k pool hpool α β γ α' β' γ' hA hB hC hα hβ hγ hα' hβ' hγ' S N
    (fun n hn => (hs.2 n hn).1)
    (fun n hn => ⟨(hs.2 n hn).2.1.1.le, (hs.2 n hn).2.1.2⟩)
    hs.1 (by norm_num : (0 : ℝ) ≤ 2) (fun n hn => (hs.2 n hn).2.2.1)
    θ (fun n hn => (hs.2 n hn).2.2.2)
  have hdec := physical_prime_harmonic_decomposition P V probes r t hrt Q h ξ i aux a b S δ F
  apply (congrArg norm hdec).trans_le
  apply ((norm_add_le _ _).trans (add_le_add hshared haux)).trans_eq
  ring

end Bounty
end

section

/- The exact unrestricted main term already present in the harmonic difference. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def physicalFreePositiveHarmonicMain {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b Z : ℝ) (k : ℤ) (pool : Finset ℕ) (α β γ α' β' γ' : ℕ → ℂ) : ℂ :=
  let cut := repeatedBigPrimePatternCut probes r t i
  let d := physicalFreeFactor cut aux
  let δ : ℤ := k*(d : ℤ)
  let marks := fun g => ell+(cut g).card
  let W := fun n : ℤ => markedDivisorWeight univ P (1/2) V marks n
  let S := harmonicPositiveSupport Z k d
  let F := fun n : ℤ => ((typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)/(n : ℂ)) *
    star (invariantTripleEndpoint pool α β γ n.natAbs) *
    invariantTripleEndpoint pool α' β' γ' (n+δ).natAbs
  ∑ n ∈ S, F n * ((W n.natAbs * W (n+δ).natAbs : ℝ) : ℂ) *
    groupMarkedAverage P marks (n.natAbs : ℤ) (fun u =>
      groupMarkedAverage P marks ((n+δ).natAbs : ℤ)
        (physicalFreePrimePairCoefficient P V probes r t hrt Q h ξ i aux a b n.natAbs (n+δ).natAbs u))

theorem physical_positive_harmonic_difference_eq_main {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i))
    (a b Z : ℝ) (k : ℤ) (pool : Finset ℕ) (α β γ α' β' γ' : ℕ → ℂ) :
    let cut := repeatedBigPrimePatternCut probes r t i
    let d := physicalFreeFactor cut aux
    let δ : ℤ := k*(d : ℤ)
    physicalPositiveHarmonicDifference P V probes r t hrt Q h ξ i aux a b Z k pool α β γ α' β' γ' =
      (∑ n ∈ harmonicPositiveSupport Z k d,
        ((typeIIHarmonicDyadic ((n : ℝ)/(Z*(d : ℝ))) : ℂ)/(n : ℂ)) *
          star (invariantTripleEndpoint pool α β γ n.natAbs) *
          invariantTripleEndpoint pool α' β' γ' (n+δ).natAbs *
          physicalFullPairCorrelation P cut V (1/2) n.natAbs (n+δ).natAbs
            (physicalOriginalPrimePairCoefficient P V probes r t hrt Q h ξ i aux a b n.natAbs (n+δ).natAbs)) -
      physicalFreePositiveHarmonicMain P V probes r t hrt Q h ξ i aux a b Z k pool α β γ α' β' γ' := rfl

end Bounty
end

