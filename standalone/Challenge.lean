/- Norm envelopes of averaged inputs remain fixed by small-slot averaging.
This permits the genuine two-sided storage estimate to be used in positive
domination of an arbitrary endpoint-dependent dirty coefficient. -/

open Finset
open scoped Classical

namespace Bounty

section

variable
  {S X : Type*}
  [sharedInstance1 : Fintype S]
  [sharedInstance2 : DecidableEq S]

include S X sharedInstance1 sharedInstance2

theorem physical_small_big_average_add
    
    {P : S → Finset ℕ} {J ell : ℕ}
    (F G : PhysicalSmallBigState P J ell X → ℂ) :
    physicalSmallBigAverage (F + G) = physicalSmallBigAverage F + physicalSmallBigAverage G := by
  funext s
  simp only [physicalSmallBigAverage, Pi.add_apply, sum_add_distrib, mul_add]

theorem physical_small_big_average_of_invariant
    
    {P : S → Finset ℕ} {J ell : ℕ}
    (F : PhysicalSmallBigState P J ell X → ℂ)
    (hF : ∀ (σ : PhysicalPermutations S J ell) s, F (physicalSmallBigPermutation σ s) = F s) :
    physicalSmallBigAverage F = F := by
  funext s
  unfold physicalSmallBigAverage
  simp only [hF, sum_const, card_univ, nsmul_eq_mul]
  rw [← mul_assoc, inv_mul_cancel₀, one_mul]
  exact_mod_cast (Fintype.card_ne_zero : Fintype.card (PhysicalPermutations S J ell) ≠ 0)

theorem physical_small_big_average_envelope_fixed
    
    {P : S → Finset ℕ} {J ell : ℕ}
    (F : PhysicalSmallBigState P J ell X → ℂ) :
    physicalSmallBigAverage (complexNormEnvelope (physicalSmallBigAverage F)) =
      complexNormEnvelope (physicalSmallBigAverage F) := by
  apply physical_small_big_average_of_invariant
  intro σ s
  simp only [complexNormEnvelope, physical_small_big_average_invariant]

theorem physical_small_big_average_envelope_energy_le
     [Fintype X]
    {P : S → Finset ℕ} [∀ p : PhysicalPrime P, NeZero p.2.val] {J ell : ℕ}
    (V : S → ℝ) (hV : ∀ s, 0 < V s) (W : X → ℝ) (hW : ∀ x, 0 ≤ W x)
    (F : PhysicalSmallBigState P J ell X → ℂ) :
    physicalSmallBigEnergy V W (complexNormEnvelope (physicalSmallBigAverage F)) ≤
      physicalSmallBigEnergy V W F := by
  calc
    _ = physicalSmallBigEnergy V W (physicalSmallBigAverage F) := by
      simp only [physicalSmallBigEnergy, complexNormEnvelope_norm]
    _ ≤ _ := physical_small_big_average_energy_le V hV W hW F

theorem physical_small_big_average_norm_domination
    
    {P : S → Finset ℕ} {J ell : ℕ}
    (F G : PhysicalSmallBigState P J ell X → ℂ)
    (hdom : ∀ s, ‖F s‖ ≤ (G s).re)
    (s : PhysicalSmallBigState P J ell X) :
    ‖physicalSmallBigAverage F s‖ ≤ (physicalSmallBigAverage G s).re := by
  have hc : 0 ≤ (Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹ :=
    inv_nonneg.mpr (Nat.cast_nonneg _)
  have hf : ‖physicalSmallBigAverage F s‖ ≤
      (Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹ *
        ∑ σ : PhysicalPermutations S J ell, ‖F (physicalSmallBigPermutation σ s)‖ := by
    unfold physicalSmallBigAverage
    rw [norm_mul, ← Complex.ofReal_natCast, ← Complex.ofReal_inv,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hc]
    exact mul_le_mul_of_nonneg_left (norm_sum_le _ _) hc
  apply hf.trans
  calc
    _ ≤ (Fintype.card (PhysicalPermutations S J ell) : ℝ)⁻¹ *
        ∑ σ : PhysicalPermutations S J ell, (G (physicalSmallBigPermutation σ s)).re :=
      mul_le_mul_of_nonneg_left (sum_le_sum fun σ _ => hdom _) hc
    _ = _ := by
      simp only [physicalSmallBigAverage, ← Complex.ofReal_natCast, ← Complex.ofReal_inv,
        Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero, Complex.re_sum]

end


end Bounty
end

