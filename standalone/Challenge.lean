theorem global_birth_joint_initial_pending_zero (a : (g : Fin N) → P g → Bool) :
    globalBirthJointPending (R := R) (fun g => ghostPhaseInitialState (a g)) = 0 := by
  classical
  apply sum_eq_zero
  intro g _
  have he : ghostPhasePendingSupport (R := R g) (ghostPhaseInitialState (a g)) = ∅ := by
    ext p
    change (p ∈ univ.filter (fun q => ∃ r,
      ghostPhaseInitialState (R := R g) (a g) q = some (some (some r)))) ↔ p ∈ (∅ : Finset (P g))
    simp only [mem_filter, mem_univ, true_and, Finset.notMem_empty]
    unfold ghostPhaseInitialState
    split_ifs <;> simp
  rw [he, card_empty]

variable [∀ g p, DecidableEq (R g p)]

theorem ghost_phase_joint_initial_zero_of_pending
    (a : (g : Fin N) → P g → Bool) (β : (g : Fin N) → P g → ℝ)
    (cap : Nat) (z : GlobalBirthJointPhase R) (hz : ¬ globalBirthJointPending z ≤ cap) :
    ((∏ g, ∏ p, ghostPhaseInitial (a g p) (β g p) (z g p) : ℝ) : ℂ) = 0 := by
  classical
  rw [ghost_phase_joint_initial_tensor_point_mass]
  have hne : z ≠ (fun g => ghostPhaseInitialState (a g)) := by
    intro he
    apply hz
    rw [he, global_birth_joint_initial_pending_zero]
    exact Nat.zero_le cap
  rw [if_neg hne, Complex.ofReal_zero]

end Initial

