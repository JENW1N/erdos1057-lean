/- Coherent continuation substitution for original selected physical rows. -/

open Finset
open scoped Classical
namespace Bounty

noncomputable def PhysicalMarkCoherent {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (L : PhysicalMarkLists P J ell) (s : PhysicalBoundedMarkState P J ell B) : Prop :=
  s.1 = L ∧ GlobalBirthJointCoherent (fun g => physicalGroupPhaseActivity L g) (physicalMarkRawReadout s)

theorem physical_mark_raw_extension_coherent_congr {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (L : PhysicalMarkLists P J ell) (F G : PhysicalBoundedMarkState P J ell B → ℂ)
    (hFG : ∀ t, PhysicalMarkCoherent L t → F t = G t)
    (u : GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val))
    (hu : GlobalBirthJointCoherent (fun g => physicalGroupPhaseActivity L g) u) :
    physicalMarkRawExtension F L u = physicalMarkRawExtension G L u := by
  unfold physicalMarkRawExtension
  split_ifs with hc
  · exact hFG _ ⟨rfl, hu⟩
  · rfl

theorem physical_mark_raw_extension_zero {N J ell B : ℕ} {P : Fin N → Finset ℕ}
    (L : PhysicalMarkLists P J ell) :
    physicalMarkRawExtension (fun _ : PhysicalBoundedMarkState P J ell B => 0) L = fun _ => 0 := by
  funext u
  unfold physicalMarkRawExtension
  split_ifs <;> rfl

section Rows
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ)
  (ρ : ℝ) (V : Fin N → ℝ) (hV : ∀ g, V g ≠ 0)

variable [∀ g, ∀ p : ↥(P g), NeZero p.val]

theorem physical_selected_visit_coherent_congr (j : I)
    (L : PhysicalMarkLists P J ell) (F G : PhysicalBoundedMarkState P J ell B → ℂ)
    (hFG : ∀ t, PhysicalMarkCoherent L t → F t = G t)
    (s : PhysicalBoundedMarkState P J ell B) (hs : PhysicalMarkCoherent L s) :
    physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
      (fun o t => if o = .inr none ∧ t.1 = L then F t else 0) s =
    physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
      (fun o t => if o = .inr none ∧ t.1 = L then G t else 0) s := by
  rw [← hs.1, physical_observed_selected_state_visit, physical_observed_selected_state_visit]
  apply global_birth_joint_cut_raw_row_congr
  · intro u hu
    apply physical_mark_raw_extension_coherent_congr
    · intro t ht
      apply hFG
      simpa only [hs.1] using ht
    · exact hu
  · simpa only [hs.1] using hs.2

omit [∀ g, ∀ p : ↥(P g), NeZero p.val] in
theorem physical_selected_visit_zero (j : I) (L : PhysicalMarkLists P J ell)
    (s : PhysicalBoundedMarkState P J ell B) (hs : s.1 = L) :
    physicalObservedMarkRow C k ω β retention ρ V hV (some (.inl j))
      (fun o t => if o = .inr none ∧ t.1 = L then 0 else 0) s = 0 := by
  rw [← hs, physical_observed_selected_state_visit, physical_mark_raw_extension_zero]
  simpa only [zero_mul] using global_birth_joint_cut_raw_row_mul
    (fun g => GlobalBirthRawStep.visit (a := physicalGroupPhaseActivity s.1 g)
      (fun _ => 0) (β g) (1 - retention j) (V g) ρ (hV g) B) B B 0
    (fun _ => 0) (physicalMarkRawReadout s)

theorem physical_selected_edge_coherent_congr (j : K)
    (aux : PhysicalAuxLabels P (C j)) (σ τ : PhysicalPermutations (Fin N) J ell)
    (L R : PhysicalMarkLists P J ell)
    (hlist : physicalListAdmissible (C j) aux (physicalPermuteLabels σ L) (physicalPermuteLabels τ R))
    (hP : ∀ g p, p ∈ P g → Nat.Prime p)
    (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
    (hk : ∀ g s, ¬ ((L g s).val : ℤ) ∣ k j)
    (F G : PhysicalBoundedMarkState P J ell B → ℂ)
    (hFG : ∀ t, PhysicalMarkCoherent R t → F t = G t)
    (s : PhysicalBoundedMarkState P J ell B) (hs : PhysicalMarkCoherent L s) :
    physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j aux σ τ R F s =
      physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j aux σ τ R G s := by
  simp only [physical_selected_state_edge_block_eq, hs.1, if_pos hlist]
  congr 1
  apply physical_raw_tensor_coherent_congr (C j) aux (k j)
    (physicalPermuteLabels σ L) (physicalPermuteLabels τ R) hlist hP hdis
    (fun g i => hk g (σ g i)) β ρ V
  · intro u hu
    apply physical_mark_raw_extension_coherent_congr R F G hFG
    simpa only [physical_group_phase_activity_permute] using hu
  · simpa only [physical_group_phase_activity_permute] using hs.2

omit [∀ g, ∀ p : ↥(P g), NeZero p.val] in
theorem physical_selected_edge_zero (j : K)
    (aux : PhysicalAuxLabels P (C j)) (σ τ : PhysicalPermutations (Fin N) J ell)
    (R : PhysicalMarkLists P J ell) (s : PhysicalBoundedMarkState P J ell B) :
    physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j aux σ τ R (fun _ => 0) s = 0 := by
  rw [physical_selected_state_edge_block_eq, physical_mark_raw_extension_zero]
  split_ifs
  · rw [physical_full_edge_tensor_zero, mul_zero]
  · exact mul_zero _

omit [∀ g, ∀ p : ↥(P g), NeZero p.val] in
omit [∀ g, ∀ p : ↥(P g), NeZero p.val] in
theorem physical_selected_edge_zero_of_bad (j : K)
    (aux : PhysicalAuxLabels P (C j)) (σ τ : PhysicalPermutations (Fin N) J ell)
    (L R : PhysicalMarkLists P J ell)
    (hlist : physicalListAdmissible (C j) aux (physicalPermuteLabels σ L) (physicalPermuteLabels τ R))
    (hbad : ¬ ∀ g a b,
      ((physicalPermuteLabels σ L) g a).val = ((physicalPermuteLabels τ R) g b).val →
      (((physicalPermuteLabels σ L) g a).val : ℤ) ∣
        k j * (physicalD (C j) (physicalPermuteLabels σ L) aux : ℤ))
    (F : PhysicalBoundedMarkState P J ell B → ℂ)
    (s : PhysicalBoundedMarkState P J ell B) (hs : PhysicalMarkCoherent L s) :
    physicalSelectedStateEdgeBlock C k ω β retention ρ V hV j aux σ τ R F s = 0 := by
  rw [physical_selected_state_edge_block_eq, hs.1, if_pos hlist]
  rw [physical_raw_tensor_zero_of_bad_edge (C j) aux (k j)
    (physicalPermuteLabels σ L) (physicalPermuteLabels τ R) hlist β ρ V hbad]
  · exact mul_zero _
  · simpa only [physical_group_phase_activity_permute] using hs.2

end Rows
end Bounty
