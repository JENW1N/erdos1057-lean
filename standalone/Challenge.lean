  have h := hbound S
    (ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    Ps J Vs hVs 0 (productMemoryWeight μ (fun g => unrestrictedResidueWeight (μ g)))
    (productMemoryWeight_nonneg μ _ hμ (fun g z => hμ g z.1)) aux (fun _ => 1)
    (PhysicalSmallBigFullEvent n shared B (fun d c g => -Δ d c g) D)
    (physicalSmallBigFullTarget n shared B (fun d c g => -Δ d c g) D)
    (physicalSmallBigFullCoefficient n shared B (fun d c g => -Δ d c g) D μ ρ V
      (physicalSmallBigReversePhase n shared B Δ D V))
    (fun x => -kbig (productActiveMemorySplit shared B x).1)
    1 (unrestrictedEdgeEnergyBound ρ v vmin vmax T ^ Fintype.card G) zero_le_one
    (pow_nonneg (unrestrictedEdgeEnergyBound_nonneg ρ v vmin vmax T) _) (by intro d; simp) F
    (physical_small_big_reverse_prefix_energy_le n shared B Δ D μ ρ V kbig Vs q
      hρ0 hρ1 hv hvmin hVlo hVhi hμ hmass T ht F hF)
