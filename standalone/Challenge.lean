    (fun (j : Fin (n + 1)) (i : patterns) => physicalMixedEdgeDelta (fun g => C i.val (e.symm g).val) (k (n - j.val) i.val))
    (fun _ (i : patterns) => physicalMixedEdgeD (fun g => C i.val (e.symm g).val))
