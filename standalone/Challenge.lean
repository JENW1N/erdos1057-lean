/- Concrete support parameters for the original invariant harmonic error estimate. -/

open Finset
namespace Bounty

theorem harmonic_positive_error_parameters {Z : ℝ} (hZ : 0 < Z)
    (k : ℤ) {d : ℕ} (hd : 0 < d) (hk : |(k : ℝ)| ≤ Z) :
    0 < Z*(d : ℝ)/2 ∧
    ∀ w ∈ harmonicPositiveSupport Z k d,
      (0 ≤ w ∧ w ≤ (⌈3*Z*(d : ℝ)⌉₊ : ℤ)) ∧
      (0 < w+k*(d : ℤ) ∧ w+k*(d : ℤ) ≤ (⌈3*Z*(d : ℝ)⌉₊ : ℤ)) ∧
      Z*(d : ℝ)/2 ≤ (w : ℝ) ∧
      ‖(typeIIHarmonicDyadic ((w : ℝ)/(Z*(d : ℝ))) : ℂ)‖ ≤ 2 := by
  have hZd : 0 < Z*(d : ℝ) := mul_pos hZ (by exact_mod_cast hd)
  refine ⟨half_pos hZd, ?_⟩
  intro w hw
  have hs := mem_harmonic_positive_support hw
  have hwN : (w : ℝ) ≤ (⌈3*Z*(d : ℝ)⌉₊ : ℝ) := by
    calc
      _ ≤ 2*Z*(d : ℝ) := hs.2.2.1
      _ ≤ 3*Z*(d : ℝ) := by nlinarith
      _ ≤ _ := Nat.le_ceil _
  have htN : ((w+k*(d : ℤ) : ℤ) : ℝ) ≤ (⌈3*Z*(d : ℝ)⌉₊ : ℝ) :=
    (Int.le_floor.mp (harmonic_positive_support_upper_shift k hk hw)).trans (Nat.le_ceil _)
  refine ⟨⟨hs.1.le, by exact_mod_cast hwN⟩,
    ⟨hs.2.2.2, by exact_mod_cast htN⟩, hs.2.1.le, ?_⟩
  rw [Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (typeII_harmonic_dyadic_bounds _).1]
  exact (typeII_harmonic_dyadic_bounds _).2

end Bounty
