theorem global_birth_joint_weighted_empty_history_product
    {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)] [∀ g, DecidableEq (P g)]
    {R : (g : Fin N) → P g → Type*} [∀ g p, AddGroup (R g p)]
    [∀ g p, Fintype (R g p)] [∀ g p, DecidableEq (R g p)]
    (a : ℕ → (g : Fin N) → P g → Bool)
    (steps : (i : ℕ) → (g : Fin N) → GlobalBirthRawStep (R := R g) (a i g) (a (i + 1) g))
    (cap : ℕ → ℕ) (β : (g : Fin N) → P g → ℝ) (n : ℕ) :
    ((∏ g, ∏ p, if a 0 g p then β g p else 1 : ℝ) : ℂ) *
      globalBirthJointRawHistory a steps cap n
        (fun s => if ∀ g, (s g).2.1 = 0 then 1 else 0) (globalBirthJointInitial (a 0)) =
    ∑ x : Fin (n + 1) → GlobalBirthJointPhase R,
      ((∏ g, ∏ p, ghostPhaseTerminal (a n g p) (x (Fin.last n) g p) : ℝ) : ℂ) *
        (((∏ g, ∏ p, ghostPhaseInitial (a 0 g p) (β g p) (x 0 g p) : ℝ) : ℂ) *
          ∏ j : Fin n, globalBirthJointHistoryKernel a steps cap j.val (x j.succ) (x j.castSucc)) := by
  rw [← global_birth_joint_initial_terminal_pairing a steps cap β n]
  exact global_birth_joint_phase_history_trace_pairing a steps cap _ _ n
end

