        (∑ i ∈ roughBand (m : ℝ) (n : ℝ) (Real.exp (γ*L)), harmonicMellinWeight v i*χ (i : ZMod r))-
        ∑ i ∈ Ioc m n, (roughTestLogarithmicProxy γ L S i : ℂ)*
