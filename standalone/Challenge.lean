section

/- Decorating the original blocks retains exactly the selected edge endpoints. -/

namespace Bounty

variable {S I V K : Type} {Ps : S → Finset ℕ} {J ell : ℕ}

theorem physical_selected_big_block_schedule (last : V) (bs : List (V × K))
    (i : Fin bs.length → I) (L : Fin (bs.length + 1) → PhysicalMarkLists Ps J ell)
    (σ τ : Fin bs.length → PhysicalPermutations S J ell) :
    physicalMixedBigSteps (physicalBlockFineSteps bs last) (L 0)
      (physicalSmallBlockPlanPack last bs (fun j => (i j, L j.succ, σ j, τ j))) =
    physicalBlockFineSteps
      (List.ofFn (fun j : Fin bs.length => ((bs.get j).1,
        ((bs.get j).2, i j, physicalPermuteLabels (σ j) (L j.castSucc),
          physicalPermuteLabels (τ j) (L j.succ))))) last := by
  induction bs with
  | nil => rfl
  | cons b bs ih =>
    change some (.inl b.1) :: none :: some (.inr
      (b.2, i 0, physicalPermuteLabels (σ 0) (L 0),
        physicalPermuteLabels (τ 0) (L (Fin.succ 0)))) :: none ::
      physicalMixedBigSteps (physicalBlockFineSteps bs last)
        (physicalPermuteLabels (physicalInversePermutations (τ 0))
          (physicalPermuteLabels (τ 0) (L (Fin.succ 0))))
        (physicalSmallBlockPlanPack last bs
          (fun j => (i j.succ, L j.succ.succ, σ j.succ, τ j.succ))) = _
    rw [physical_permute_inverse, List.ofFn_succ]
    exact congrArg (fun rest => some (.inl b.1) :: none :: some (.inr
      (b.2, i 0, physicalPermuteLabels (σ 0) (L 0),
        physicalPermuteLabels (τ 0) (L (Fin.succ 0)))) :: none :: rest)
      (ih (fun j => i j.succ) (fun j => L j.succ)
        (fun j => σ j.succ) (fun j => τ j.succ))

end Bounty
