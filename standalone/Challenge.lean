/- The absolute row sum has a fixed polynomial bound when there are
logarithmically many groups and polynomial total pattern coefficient mass. -/
theorem exists_physical_residue_operator_power_row_bound {q v : ℝ}
    (hq0 : 0 ≤ q) (hq1 : q < 1) (hv : 0 < v) (ell m : ℕ)
    {C B : ℝ} (hC : 0 ≤ C) (hB : 0 ≤ B) :
    ∃ D : ℝ, 0 ≤ D ∧ ∀ (T : ℝ), 0 < T →
      ∀ (G : Type) [Fintype G] [DecidableEq G],
      (Fintype.card G : ℝ) ≤ C * Real.log T →
      ∀ (P : G → Finset ℕ) [∀ p : PhysicalPrime P, NeZero p.2.val],
      Pairwise (fun g h => Disjoint (P g) (P h)) →
      (∀ g p, p ∈ P g → p.Prime) →
      ∀ (J : ℕ) (V : G → ℝ), (∀ g, v ≤ V g) →
      (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
      ∀ (I : Type) (patterns : Finset I) (slots : I → G → Finset (Fin J))
        (bounds : I → ℝ),
      (∀ i ∈ patterns, ∀ g, (slots i g).card ≤ m) →
      (∀ i ∈ patterns, 0 ≤ bounds i) → (∑ i ∈ patterns, bounds i) ≤ T^B →
      ∀ (ζ : I → ℝ) (k : I → ℤ)
        (K : ∀ i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
          PhysicalAuxLabels P (slots i) → ℂ),
      (∀ i ∈ patterns, ∀ L R aux, ‖K i L R aux‖ ≤ bounds i) →
      letI : Fintype (PhysicalEdgeLabels P J ell patterns slots) := inferInstance
      ∀ x : PhysicalBareResidueState P J ell,
      (∑ y : PhysicalBareResidueState P J ell,
        ∑ a : PhysicalEdgeLabels P J ell patterns slots,
          ‖physicalResidueLabeledCoeff V patterns slots q ζ k K a x y‖) ≤ T^D := by
  obtain ⟨A, hA, hrow⟩ := exists_physical_residue_operator_row_bound hq0 hq1 hv ell m
  refine ⟨B + C * Real.log A, add_nonneg hB (mul_nonneg hC (Real.log_nonneg hA)), ?_⟩
  intro T hT G _ _ hG P _ hP hprime J V hV hMass I patterns slots bounds hslots
    hbounds hsum ζ k K hK
  let _ : Fintype (PhysicalEdgeLabels P J ell patterns slots) := inferInstance
  intro x
  exact (hrow G P hP hprime J V hV hMass I patterns slots bounds hslots hbounds ζ k K hK x).trans
    (group_pattern_weight_power_bound hT hA hG hsum)
end

