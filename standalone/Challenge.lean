theorem physical_root_prime_kernel_equiv
    {H G : Type*} [Fintype H] [Fintype G] [DecidableEq H] [DecidableEq G]
    {J ell : ℕ} (f : H ↪ G) (P : G → Finset ℕ) (V : G → ℝ)
