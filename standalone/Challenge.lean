noncomputable def physicalActiveMarkLabels
    (a : (g : Fin N) → Fin (J + ell) → ↥(P g))
    (ha : ∀ g, Function.Injective (a g)) : PhysicalMarkLists P J ell :=
  fun g => ⟨a g ∘ (physicalFullSlotIndex (before g)).symm,
    (ha g).comp (physicalFullSlotIndex (before g)).symm.injective⟩

noncomputable def physicalActiveCoefficient
    (s t : (g : Fin N) → Fin (J + ell) → ↥(P g)) (a : PhysicalAuxLabels P C) : ℂ :=
  if hs : ∀ g, Function.Injective (s g) then
    if ht : ∀ g, Function.Injective (t g) then
      K (physicalActiveMarkLabels before s hs) (physicalActiveMarkLabels after t ht) a *
        physicalPhase ζ (physicalD C (physicalActiveMarkLabels before s hs) a)
    else 0
  else 0

theorem physical_active_mark_labels_encode (L : PhysicalMarkLists P J ell) :
    physicalActiveMarkLabels before
      (fun g i => L g (physicalFullSlotIndex (before g) i))
      (fun g => (L g).injective.comp (physicalFullSlotIndex (before g)).injective) = L := by
  funext g
  apply Function.Embedding.ext
  intro i
  exact congrArg (L g) ((physicalFullSlotIndex (before g)).apply_symm_apply i)

theorem physical_active_coefficient_encode
    (L R : PhysicalMarkLists P J ell) (a : PhysicalAuxLabels P C) :
    physicalActiveCoefficient before after C ζ K
      (fun g i => L g (physicalFullSlotIndex (before g) i))
      (fun g i => R g (physicalFullSlotIndex (after g) i)) a =
      K L R a * physicalPhase ζ (physicalD C L a) := by
  have hL : ∀ g, Function.Injective (fun i => L g (physicalFullSlotIndex (before g) i)) :=
    fun g => (L g).injective.comp (physicalFullSlotIndex (before g)).injective
  have hR : ∀ g, Function.Injective (fun i => R g (physicalFullSlotIndex (after g) i)) :=
    fun g => (R g).injective.comp (physicalFullSlotIndex (after g)).injective
  simp only [physicalActiveCoefficient, dif_pos hL, dif_pos hR,
    physical_active_mark_labels_encode]

