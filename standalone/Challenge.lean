/- The tuple contains each pending label of its reconstructed phase exactly
once, with no additional pending labels contributed by the base. -/
def GhostPhaseReadoutSupported {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (base : (p : P) → GhostPhaseState (R p))
    (q : FiniteOrderedTuple (Σ p, R p)) : Prop :=
  Function.Injective (Sigma.fst ∘ q.2) ∧
    univ.image (fun j => (q.2 j).1) = ghostPhasePendingSupport (ghostPhaseMemoryReadout base q)

/- Read the phase test on complete distinct particle memories, and extend by
zero on all other tuples, including repeated numerical labels. -/
noncomputable def symmetricPhaseReadout {P : Type*} [Fintype P] [DecidableEq P]
    {R : P → Type*} (base : (p : P) → GhostPhaseState (R p))
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ)
    (q : FiniteOrderedTuple (Σ p, R p)) : ℂ := by
  classical
  exact if GhostPhaseReadoutSupported base q then F (ghostPhaseMemoryReadout base q) else 0










/- On a complete distinct reconstruction the extension is the original phase
test, not merely a bound on that test. -/
theorem symmetric_phase_readout_eq_of_reconstruction {P : Type*}
    [Fintype P] [DecidableEq P] {R : P → Type*}
    (base z : (p : P) → GhostPhaseState (R p))
    (F : ((p : P) → GhostPhaseState (R p)) → ℂ)
    (q : FiniteOrderedTuple (Σ p, R p))
    (hinj : Function.Injective (Sigma.fst ∘ q.2))
    (hsupport : univ.image (fun j => (q.2 j).1) = ghostPhasePendingSupport z)
    (hread : ghostPhaseMemoryReadout base q = z) :
    symmetricPhaseReadout base F q = F z := by
  classical
  have hs : GhostPhaseReadoutSupported base q := ⟨hinj, by rw [hread]; exact hsupport⟩
  rw [symmetricPhaseReadout, if_pos hs, hread]




