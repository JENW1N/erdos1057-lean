section

/- Exact packing of each ghost/permutation/edge/permutation block. -/

namespace Bounty

variable {S I V K : Type} {Ps : S → Finset ℕ} {J ell : ℕ}

def physicalBlockFineSteps (bs : List (V × K)) (last : V) : List (Option (V ⊕ K)) :=
  bs.flatMap (fun b => [some (.inl b.1), none, some (.inr b.2), none]) ++
    [some (.inl last)]

abbrev PhysicalSmallBlockData (Ps : S → Finset ℕ) (J ell : ℕ) (I : Type) :=
  I × PhysicalMarkLists Ps J ell × PhysicalPermutations S J ell × PhysicalPermutations S J ell

def physicalSmallBlockPlanPack (last : V) : ∀ bs : List (V × K),
    (Fin bs.length → PhysicalSmallBlockData Ps J ell I) →
    PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I)
      (physicalBlockFineSteps bs last)
  | [], _ => PUnit.unit
  | _ :: bs, d =>
    ((d 0).2.2.1, (((d 0).1, physicalPermuteLabels (d 0).2.2.2 (d 0).2.1),
      (physicalInversePermutations (d 0).2.2.2,
        physicalSmallBlockPlanPack last bs (fun j => d j.succ))))

noncomputable def physicalSmallBlockPlanUnpack (last : V) : ∀ bs : List (V × K),
    PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I)
      (physicalBlockFineSteps bs last) →
    (Fin bs.length → PhysicalSmallBlockData Ps J ell I)
  | [], _ => Fin.elim0
  | _ :: bs, p => Fin.cons
    (p.2.1.1, physicalPermuteLabels p.2.2.1 p.2.1.2, p.1,
      physicalInversePermutations p.2.2.1)
    (physicalSmallBlockPlanUnpack last bs p.2.2.2)

theorem physical_small_block_plan_unpack_pack (last : V) (bs : List (V × K))
    (d : Fin bs.length → PhysicalSmallBlockData Ps J ell I) :
    physicalSmallBlockPlanUnpack last bs (physicalSmallBlockPlanPack last bs d) = d := by
  induction bs with
  | nil => funext j; exact Fin.elim0 j
  | cons b bs ih =>
    funext j
    refine Fin.cases ?_ (fun i => ?_) j
    · simp only [physicalSmallBlockPlanUnpack, physicalSmallBlockPlanPack, Fin.cons_zero,
        physical_permute_inverse]
      rfl
    · exact congrFun (ih (d := fun j => d j.succ)) i

theorem physical_small_block_plan_pack_unpack (last : V) (bs : List (V × K))
    (p : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I)
      (physicalBlockFineSteps bs last)) :
    physicalSmallBlockPlanPack last bs (physicalSmallBlockPlanUnpack last bs p) = p := by
  induction bs with
  | nil => change (PUnit.unit : PUnit) = p; exact Subsingleton.elim _ _
  | cons b bs ih =>
    rcases p with ⟨σ, ⟨i, R⟩, κ, p⟩
    simp only [physicalSmallBlockPlanPack, physicalSmallBlockPlanUnpack, Fin.cons_zero,
      Fin.cons_succ, physical_permute_inverse]
    change (σ, ((i, R), (κ, physicalSmallBlockPlanPack last bs
      (physicalSmallBlockPlanUnpack last bs p)))) = _
    exact congrArg (fun q => (σ, ((i, R), (κ, q)))) (ih p)

noncomputable def physicalSmallBlockPlanEquiv (last : V) (bs : List (V × K)) :
    (Fin bs.length → PhysicalSmallBlockData Ps J ell I) ≃
    PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I)
      (physicalBlockFineSteps bs last) where
  toFun := physicalSmallBlockPlanPack last bs
  invFun := physicalSmallBlockPlanUnpack last bs
  left_inv := physical_small_block_plan_unpack_pack last bs
  right_inv := physical_small_block_plan_pack_unpack last bs

end Bounty
end

