def quadraticMatrix {ι m n : Type*}
    (p : ι → O) [∀ i, (Ideal.span {p i}).IsMaximal]
    (hg : ∀ i, lambda ∉ Ideal.span {p i})
    (rows : m → Finset ι) (cols : n → Finset ι) : Matrix m n ℂ :=
