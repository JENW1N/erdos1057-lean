section

/- The local norm bound in the exact finite pattern-family form consumed by
CleanHybridUnbannedBound. The raw row and alternating comparison signs remain explicit. -/

open Finset Filter
open scoped Classical

namespace Bounty

theorem eventually_repeated_big_prime_pattern_norm_le
    (hZ : PrimitiveZeroFreeHalfPlane) (c s z a v D ε : ℝ) (m : ℕ)
    (hc : 0 < c) (hs : 0 ≤ s) (hz : 0 ≤ z) (ha : 0 ≤ a)
    (hv : 0 < v) (hD : 0 ≤ D) (hε : 0 < ε) (hm : 0 < m) :
    let κ := a * Real.log (primeFiberFactorBound v m)
    let s' := s + ε
    let A₀ := D + 2 * (s' + 1)
    let q := 2 * κ + (s' + 1) + 2 * A₀ + 3
    let w := 4 * q + max z q + A₀ + 2
    let x := (s' + w + 2) + 2 * A₀ + 2
    ∀ᶠ L : ℝ in atTop,
    let Q := ⌊L ^ q⌋₊
    let h := L ^ (-w)
    let ξ := L ^ (-x)
    ∀ {G : Type} [Fintype G] [DecidableEq G] (J ell : ℕ),
    ∀ (P : G → Finset ℕ) (V : G → ℝ),
    Pairwise (fun g h => Disjoint (P g) (P h)) →
    (∀ g p, p ∈ P g → p.Prime ∧ Q < p) →
    (∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g) →
    (∀ g, v ≤ V g) →
    (∀ g p, p ∈ P g → Real.log p ≤ L ^ s) →
    (Fintype.card G : ℝ) ≤ a * Real.log L →
    (∀ g, ∃ a b : ℝ, P g = primeBand a b ∧ Real.exp (L ^ c) ≤ a ∧ 0 ≤ b) →
    ∀ probes : G → Finset (Fin J), (∀ g, (probes g).card = m) →
    ∀ r t : Finset G, ∀ hrt : Disjoint r t,
    ∀ ζ Θ : ℝ, |ζ| ≤ L ^ z →
    ∀ u : RepeatedBigLists P J ell → ℂ, u ∈ repeatedBigSymmetricSubspace →
    let slots := fun g => (probes g).map (Function.Embedding.inl (β := Fin ell))
    let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) => primeProductRetainedCells
      (fun i : U => P i.1.1) (fun i => V i.1.1) h ξ
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
      (repeatedBigSymmetrizeLinear (fun source => ∑ target,
        (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
          ∑ aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i),
            repeatedBigPrimePatternWeight probes r t i *
              repeatedBigUnbannedKernel V (fun _ _ => 1)
                (repeatedBigPrimePatternCut probes r t i) ζ
                (repeatedBigPrimePatternKernel P V probes r t hrt Q h kept i)
                aux source target *
              physicalReturnPhase Θ
                (repeatedBigD (repeatedBigPrimePatternCut probes r t i) source aux)) * u target)) ≤
      (Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ r.card) +
        Real.sqrt (((ell : ℝ) ^ ell / (m : ℝ) ^ ell) ^ t.card) +
        (3 : ℝ) ^ ((r.sigma slots).card + (t.sigma slots).card) * L ^ (-D)) *
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) u := by
  intro κ s' A₀ q w x
  filter_upwards [eventually_repeated_big_prime_projected_norm_le
    hZ c s z a v D ε m hc hs hz ha hv hD hε hm] with L hnorm
  intro Q h ξ G _ _ J ell P V hdisj hP hmass hV hlog hcard hband
    probes hp r t hrt ζ Θ hζ u hu slots kept
  have hb := hnorm J ell P V hdisj hP hmass hV hlog hcard hband
    probes hp r t hrt ζ Θ hζ u hu
  simpa only [repeated_big_prime_pattern_family_kernel] using hb

end Bounty
end

section

/- Explicit pointwise bounds for the actual raw and comparison pattern
coefficients. Retained-cell membership supplies the required mass floors. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def repeatedBigPrimePatternBound {G : Type*} [DecidableEq G]
    {J ell : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G) (Q : ℕ) (ξ : ℝ) :
    RepeatedBigPrimePatternIndex (ell := ell) probes r t → ℝ
  | .inl _ => 1
  | .inr _ => ((Q * Q : ℕ) / ξ) ^ 2

theorem repeated_big_prime_pattern_bound_nonneg {G : Type*} [DecidableEq G]
    {J ell : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G) (Q : ℕ) (ξ : ℝ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t) :
    0 ≤ repeatedBigPrimePatternBound probes r t Q ξ i := by
  cases i with
  | inl u => exact zero_le_one
  | inr ab => exact sq_nonneg _

theorem repeated_big_prime_pattern_weight_norm {G : Type*} [DecidableEq G]
    {J ell : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t) :
    ‖repeatedBigPrimePatternWeight probes r t i‖ = 1 := by
  cases i <;> simp [repeatedBigPrimePatternWeight, norm_pow]

theorem repeated_big_prime_pattern_kernel_norm_le {G : Type*}
    [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h ξ : ℝ) (hξ : 0 < ξ)
    (i : RepeatedBigPrimePatternIndex (ell := ell) probes r t)
    (source target : RepeatedBigLists P J ell)
    (aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i)) :
    let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) => primeProductRetainedCells
      (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
    ‖repeatedBigPrimePatternKernel P V probes r t hrt Q h kept i source target aux‖ ≤
      repeatedBigPrimePatternBound probes r t Q ξ i := by
  intro kept
  cases i with
  | inl u => simp only [repeatedBigPrimePatternKernel, repeatedBigPrimePatternBound, norm_one, le_refl]
  | inr ab =>
      dsimp only [repeatedBigPrimePatternKernel, repeatedBigPrimePatternBound]
      refine repeated_big_prime_coefficient_norm_le P V ab.1.val ab.2.val _ _
        Q h _ _ hξ ?_ ?_ source target aux
      · intro d hd
        exact prime_product_retained_cell_mass _ _ h ξ hd
      · intro d hd
        exact prime_product_retained_cell_mass _ _ h ξ hd

end Bounty
