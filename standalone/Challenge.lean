section

/- Exact original event rows with the chronological owner indicator. -/

open Finset Classical

namespace Bounty

section Reindex
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, Fintype (P g)]
    {M : Fin N → ℕ}
    (n : ∀ g, P g → ℕ) [∀ g p, NeZero (n g p)]
    (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
    (A : ∀ k, SharedActiveLabels P (S k) → Type*) [∀ k c, Fintype (A k c)]
    (Δ D : ∀ k c, A k c → Fin N → ℤ)
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v : ℝ) (V : Fin N → ℝ)
    (steps : List (Option (J ⊕ K))) (u : Fin steps.length)
    (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (history : Fin (Fintype.card (FullMixedCommonBirthAddress M B steps)) → Option (Sigma P))
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))

theorem full_mixed_common_ghost_stage_reindex (j : J) (htag : steps.get u = some (.inl j)) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    (∑ e : FullPermutationMixedEvent n S B A Δ D (some (.inl j)) s,
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inl j)) s e| *
        fullMixedCommonForestHistoryGain n S B A Δ D steps code u.val (some (.inl j)) s e history *
        productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D (some (.inl j)) s e)) =
    ∑ sk : CoupledGhostSkeleton M B s, ∑ z : CoupledGhostSamples M B s sk,
      if birthForestStageCondition
        (fullMixedCommonIndexStage M B steps) u.succ
        (fullMixedCommonHistoryWrite n S B A Δ D steps u s
          (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inl j)) htag s ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm ⟨sk, z⟩)) history) code then
        |coupledGhostJointEventWeight
          (fun g => physicalGhostRetention (n g) (q j) ρ)
          (fun g => physicalGhostTermination (n g) (q j) ρ)
          (fun g => physicalGhostBirth (n g) (q j) ρ (V g))
          (fun g => unrestrictedResidueWeight (μ g)) M B s
          ((coupledGhostSkeletonEquiv M B s).symm ⟨sk, z⟩)| * productLengthLyapunov v (coupledGhostJointEventTarget M B s ((coupledGhostSkeletonEquiv M B s).symm ⟨sk, z⟩))
      else 0 := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
  have he := ((fullPermutationGhostBirthEquiv n S B A Δ D s j).symm.sum_comp (fun e =>
    |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inl j)) s e| *
      fullMixedCommonForestHistoryGain n S B A Δ D steps code u.val (some (.inl j)) s e history *
      productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D (some (.inl j)) s e))).symm
  rw [Fintype.sum_sigma] at he
  refine he.trans ?_
  apply sum_congr rfl
  intro sk _
  apply sum_congr rfl
  intro z _
  rw [full_mixed_common_forest_history_gain_tagged n S B A Δ D steps code u (some (.inl j)) htag,
    full_permutation_ghost_skeleton_weight, full_permutation_ghost_skeleton_target]
  split_ifs <;> simp only [mul_one, mul_zero, zero_mul]

theorem full_mixed_common_edge_stage_reindex (k : K) (htag : steps.get u = some (.inr k)) :
    let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
    (∑ e : FullPermutationMixedEvent n S B A Δ D (some (.inr k)) s,
      |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inr k)) s e| *
        fullMixedCommonForestHistoryGain n S B A Δ D steps code u.val (some (.inr k)) s e history *
        productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D (some (.inr k)) s e)) =
    ∑ sk : FullActiveEdgeSkeleton n (S k) B (A k) (Δ k) (D k) s, ∑ z : FullActiveEdgeSamples n (S k) B (A k) (Δ k) (D k) s sk,
      if birthForestStageCondition
        (fullMixedCommonIndexStage M B steps) u.succ
        (fullMixedCommonHistoryWrite n S B A Δ D steps u s
          (fullMixedTaggedOwnerEvent n S B A Δ D steps u (some (.inr k)) htag s ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm ⟨sk, z⟩)) history) code then
        |fullActiveEdgeEventWeight n (S k) B (A k) (Δ k) (D k) (ω k) μ ρ V s ((fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s).symm ⟨sk, z⟩)| * productLengthLyapunov v (fullActiveEdgeEventTarget n (S k) B (A k) (Δ k) (D k) s ((fullActiveEdgeSkeletonEquiv n (S k) B (A k) (Δ k) (D k) s).symm ⟨sk, z⟩))
      else 0 := by
  let _ : ∀ (tag : Option (J ⊕ K)) s, Fintype (FullPermutationMixedEvent n S B A Δ D tag s) :=
      fullPermutationMixedEventFintype n S B A Δ D
  have he := ((fullPermutationEdgeBirthEquiv n S B A Δ D s k).symm.sum_comp (fun e =>
    |fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V (some (.inr k)) s e| *
      fullMixedCommonForestHistoryGain n S B A Δ D steps code u.val (some (.inr k)) s e history *
      productLengthLyapunov v (fullPermutationMixedEventTarget n S B A Δ D (some (.inr k)) s e))).symm
  rw [Fintype.sum_sigma] at he
  refine he.trans ?_
  apply sum_congr rfl
  intro sk _
  apply sum_congr rfl
  intro z _
  rw [full_mixed_common_forest_history_gain_tagged n S B A Δ D steps code u (some (.inr k)) htag,
    full_permutation_edge_skeleton_weight, full_permutation_edge_skeleton_target]
  split_ifs <;> simp only [mul_one, mul_zero, zero_mul]

end Reindex
end Bounty
end

section

/- Exact selected-event exponents and Lyapunov factors for seeded common birth histories. -/

open Finset Classical
namespace Bounty

section Factor
variable {J K : Type*} {N : ℕ} (M : Fin N → ℕ) (B : ℕ) (steps : List (Option (J ⊕ K)))
    (code : BirthForestCode (Fintype.card (FullMixedCommonBirthAddress M B steps)))

noncomputable def fullMixedCommonSelectedAt (t : ℕ) : ℕ :=
  if ht : t < steps.length then ∑ g, fullMixedCommonSelectedCount M B steps code ⟨t, ht⟩ g else 0

theorem full_mixed_common_selected_at_owner (u : Fin steps.length) :
    fullMixedCommonSelectedAt M B steps code u.val = ∑ g, fullMixedCommonSelectedCount M B steps code u g := by
  unfold fullMixedCommonSelectedAt
  rw [dif_pos u.isLt]

theorem full_mixed_common_selected_at_sum
    (hcode : ∀ i, fullMixedCommonIndexStage M B steps i = 0 → code i = none) :
    (∑ u : Fin steps.length, fullMixedCommonSelectedAt M B steps code u.val) = birthForestRank code := by
  simp only [full_mixed_common_selected_at_owner]
  exact full_mixed_common_selected_count_sum M B steps code hcode

variable {P : Fin N → Type*} [∀ g, Fintype (P g)]
    (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ v vmin : ℝ) (V : Fin N → ℝ) (T : ℕ) (β : ℝ)

noncomputable def fullMixedCommonForestRowFactor (t : ℕ) (tag : Option (J ⊕ K)) : ℝ :=
  β ^ fullMixedCommonSelectedAt M B steps code t * fullMixedLengthRowFactor μ q ρ v vmin V T tag

theorem full_mixed_common_forest_row_factor_nonneg
    (hβ : 0 ≤ β) (hρ : ρ < 1) (hv : 0 ≤ v) (t : ℕ) (tag : Option (J ⊕ K)) :
    0 ≤ fullMixedCommonForestRowFactor M B steps code μ q ρ v vmin V T β t tag :=
  mul_nonneg (pow_nonneg hβ _)
    (fullMixedLengthRowFactor_nonneg μ q ρ v vmin V T hρ hv tag)




end Factor
end Bounty
