theorem physical_mixed_prime_clean_action_eq_gated
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    (Q : ℕ) (h ξ ζ θ : ℝ) (k : ℤ) (initial : ∀ g, Finset (P g))
    (sourceGate targetGate f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ) :
    let C := repeatedBigPrimePatternCut (ell := ell) probes r t
    let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) => primeProductRetainedCells
      (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
    let K := repeatedBigPrimePatternKernel P V probes r t hrt Q h kept
    physicalMixedPrimePatternAction V b ρ Vs q probes r t hrt Q h ξ k initial
      (fun i => physicalMixedCleanPhase (C i) k
        (physicalMixedFullResidualPhase (C i) ζ θ k sourceGate targetGate)) f =
    physicalMixedGatedCleanPatternAction initial V b C ζ θ ρ k
      (fun i a b c => repeatedBigPrimePatternWeight probes r t i * K i a b c)
      Vs q sourceGate targetGate f := by
  intro C kept K
  funext s
  unfold physicalMixedPrimePatternAction physicalMixedGatedCleanPatternAction
  simp only [Finset.sum_apply]
  apply sum_congr rfl
  intro i _
  rw [← physical_mixed_clean_coefficient_action_eq_gated]
  congr 1
  funext a y e
  dsimp only [C, K, kept]
  unfold physicalMixedCleanPhase
  split_ifs <;> simp_all

theorem physical_mixed_prime_projected_clean_dirty [DecidableEq S]
    (V : G → ℝ) (b : ∀ g, P g → ℝ) (ρ : ℝ) (Vs : S → ℝ) (q : ℝ)
    (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    (Q : ℕ) (h ξ ζ θ : ℝ) (k : ℤ) (initial : ∀ g, Finset (P g))
    (sourceGate targetGate f : PhysicalSmallBigState Ps J ell (CleanFullMemoryState P J ell B) → ℂ) :
    let C := repeatedBigPrimePatternCut (ell := ell) probes r t
    let kept := fun U : Finset (RepeatedBigFlatIndex G J ell) => primeProductRetainedCells
      (fun j : U => P j.val.1) (fun j => V j.val.1) h ξ
    let K := repeatedBigPrimePatternKernel P V probes r t hrt Q h kept
    physicalSmallBigJointAverage (physicalMixedPrimePatternAction V b ρ Vs q probes r t hrt Q h ξ k initial
      (fun i => physicalMixedFullResidualPhase (C i) ζ θ k sourceGate targetGate)
      (physicalSmallBigJointAverage f)) =
    physicalSmallBigJointAverage (physicalMixedGatedCleanPatternAction initial V b C ζ θ ρ k
      (fun i a b c => repeatedBigPrimePatternWeight probes r t i * K i a b c)
      Vs q sourceGate targetGate (physicalSmallBigJointAverage f)) +
    physicalSmallBigJointAverage (physicalMixedPrimePatternAction V b ρ Vs q probes r t hrt Q h ξ k initial
      (fun i => physicalMixedDirtyPhase (C i) k
        (physicalMixedFullResidualPhase (C i) ζ θ k sourceGate targetGate))
      (physicalSmallBigJointAverage f)) := by
  intro C kept K
  rw [physical_mixed_prime_family_clean_dirty, physical_small_big_joint_average_add,
    physical_mixed_prime_clean_action_eq_gated]

end
