variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  {P : G → Finset ℕ}
  {J ell : ℕ}
  (V : G → ℝ)
  (C : G → Finset (Fin J))
  (hV : ∀ g, 0 < V g)
  (hMass : ∀ g, ∑ p ∈ P g, 1 / (p : ℝ) = V g)
  (ζ : ℝ)
  (K : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
  (B : ℝ)
  (hB : 0 ≤ B)
  (hK : ∀ x y a, ‖K x y a‖ ≤ B)
  {Pmin : ℝ}
  (hPmin : 0 < Pmin)
  (hp : ∀ g (p : P g), Pmin ≤ (p.val : ℝ))

include G sharedInstance1 P J ell V C hV hMass ζ K B hB hK Pmin hPmin hp

theorem repeated_big_ban_difference_row_bound 
    (source : RepeatedBigLists P J ell) :
    (∑ target, ‖∑ aux, (repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K aux source target -
        repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target)‖) ≤
      B * ∑ g, (C g).card * (2 * (J + ell : ℕ)) / (V g * Pmin) := by
  calc
    _ ≤ ∑ target, ∑ aux, ‖repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K aux source target -
        repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖ :=
      sum_le_sum (fun target _ => norm_sum_le _ _)
    _ = ∑ aux, ∑ target, ‖repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K aux source target -
        repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target‖ := sum_comm
    _ ≤ _ := repeated_big_ban_difference_absolute_row_bound V C hV hMass ζ K B hB hK hPmin hp source

/- Removing the two actual auxiliary bans costs the global collision probability
in the true product-weighted active norm. No operator bound is assumed. -/
theorem repeated_big_ban_removal_operator_error 
    (f : RepeatedBigLists P J ell → ℂ) :
    cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1))
        (fun source => ∑ target,
          (∑ aux, (repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K aux source target -
            repeatedBigKernel V (fun _ _ => 1) C ζ K aux source target)) * f target) ≤
      (B * ∑ g, (C g).card * (2 * (J + ell : ℕ)) / (V g * Pmin)) *
        cleanActiveNorm (repeatedBigActiveMass V (fun _ _ => 1)) f := by
  let δ : ℝ := ∑ g, (C g).card * (2 * (J + ell : ℕ)) / (V g * Pmin)
  have hδ : 0 ≤ δ := by
    apply sum_nonneg
    intro g hg
    exact div_nonneg (mul_nonneg (Nat.cast_nonneg _)
      (mul_nonneg (by norm_num) (Nat.cast_nonneg _))) (mul_nonneg (hV g).le hPmin.le)
  let E (K' : RepeatedBigLists P J ell → RepeatedBigLists P J ell → PhysicalAuxLabels P C → ℂ)
      (source target : RepeatedBigLists P J ell) : ℂ :=
    ∑ aux, (repeatedBigUnbannedKernel V (fun _ _ => 1) C ζ K' aux source target -
      repeatedBigKernel V (fun _ _ => 1) C ζ K' aux source target)
  have htrans (source target : RepeatedBigLists P J ell) :
      (repeatedBigActiveMass V (fun _ _ => 1) source : ℂ) * E K source target =
        (repeatedBigActiveMass V (fun _ _ => 1) target : ℂ) *
          E (fun x y a => K y x a) target source := by
    unfold E
    rw [mul_sum, mul_sum]
    apply sum_congr rfl
    intro aux ha
    rw [mul_sub, mul_sub,
      repeated_big_unbanned_kernel_weighted_transpose V (fun _ _ => 1) C ζ K aux source target,
      repeated_big_kernel_weighted_transpose V (fun _ _ => 1) C ζ K aux source target]
  have hr (source : RepeatedBigLists P J ell) : ∑ target, ‖E K source target‖ ≤ B * δ :=
    repeated_big_ban_difference_row_bound V C hV hMass ζ K B hB hK hPmin hp source
  have hr' (target : RepeatedBigLists P J ell) :
      ∑ source, ‖E (fun x y a => K y x a) target source‖ ≤ B * δ :=
    repeated_big_ban_difference_row_bound V C hV hMass ζ (fun x y a => K y x a) B hB
      (fun x y a => hK y x a) hPmin hp target
  have h := finite_weighted_schur_of_transpose univ
    (repeatedBigActiveMass V (fun _ _ => 1)) (fun _ => 1) (E K) (E (fun x y a => K y x a))
    (fun source _ => repeated_big_untilted_active_mass_nonneg V (fun g => (hV g).le) source)
    (fun _ _ => zero_lt_one) (fun source _ target _ => htrans source target)
    (fun source _ => by simpa only [mul_one] using hr source)
    (fun target _ => by simpa only [mul_one] using hr' target) f
  have hs := Real.sqrt_le_sqrt h
  simpa only [cleanActiveNorm, E, ← pow_two, Real.sqrt_mul (sq_nonneg (B * δ)),
    Real.sqrt_sq (mul_nonneg hB hδ)] using hs

end

