namespace Bounty

open scoped Topology BigOperators

section

/- The sufficient direction of Korselt's criterion, proved from Fermat's little theorem. -/
theorem isCarmichael_of_korselt {n : ℕ} (hsq : Squarefree n)
    (hn : 1 < n) (hcomp : ¬ n.Prime)
    (hdiv : ∀ p : ℕ, p.Prime → p ∣ n → p - 1 ∣ n - 1) : IsCarmichael n := by
  intro b hb hcoprime
  refine ⟨?_, hcomp, hn⟩
  change n ∣ b ^ (n - 1) - 1
  by_cases hz : b ^ (n - 1) - 1 = 0
  · simp [hz]
  nth_rw 1 [← Nat.prod_primeFactors_of_squarefree hsq]
  rw [Nat.prod_primeFactors_dvd_iff hz]
  intro p hp
  have hp' : p.Prime := (Nat.mem_primeFactors.mp hp).1
  have hpn : p ∣ n := (Nat.mem_primeFactors.mp hp).2.1
  apply Nat.mem_primeFactors.mpr
  refine ⟨hp', ?_, hz⟩
  obtain ⟨k, hk⟩ := hdiv p hp' hpn
  have hfermat := Nat.ModEq.pow_card_sub_one_eq_one hp' (hcoprime.of_dvd_left hpn).symm
  have hpow := hfermat.pow k
  rw [← pow_mul, ← hk, one_pow] at hpow
  exact Nat.dvd_of_mod_eq_zero (Nat.sub_mod_eq_zero_of_mod_eq hpow)

section

variable
  {s : Finset ℕ}
  {L : ℕ}
  (hprime : ∀ p ∈ s, p.Prime)
  (hcard : 2 ≤ s.card)
  (hL : ∀ p ∈ s, p - 1 ∣ L)

include s L hprime hcard hL

/- A product of at least two distinct primes is Carmichael if it is one modulo
    a common multiple of all the prime predecessors. -/
theorem isCarmichael_prod_of_dvd 
    (hprod : L ∣ (∏ p ∈ s, p) - 1) : IsCarmichael (∏ p ∈ s, p) := by
  have hfactor : (∏ p ∈ s, p).primeFactors = s := Nat.primeFactors_prod hprime
  have hnonempty : s.Nonempty := Finset.card_pos.mp (by omega)
  have hgt : 1 < ∏ p ∈ s, p := Nat.nonempty_primeFactors.mp (hfactor.symm ▸ hnonempty)
  have hsq : Squarefree (∏ p ∈ s, p) := by
    apply Finset.squarefree_prod_of_pairwise_isCoprime
    · intro p hp q hq hpq
      exact Nat.coprime_iff_isRelPrime.mp ((Nat.coprime_primes (hprime p hp)
        (hprime q hq)).mpr hpq)
    · intro p hp
      exact (hprime p hp).squarefree
  have hcomp : ¬ (∏ p ∈ s, p).Prime := by
    intro hp
    have hs : s = {∏ p ∈ s, p} := hfactor.symm.trans hp.primeFactors
    have : s.card = 1 := by
      simpa only [Finset.card_singleton] using congrArg Finset.card hs
    omega
  apply isCarmichael_of_korselt hsq hgt hcomp
  intro p hp hpn
  have hps : p ∈ s := by
    rw [← hfactor]
    exact Nat.mem_primeFactors.mpr ⟨hp, hpn, by omega⟩
  exact (hL p hps).trans hprod

/- The congruence form of the finite-prime-product construction. -/
theorem isCarmichael_prod_of_modEq 
    (hprod : Nat.ModEq L (∏ p ∈ s, p) 1) : IsCarmichael (∏ p ∈ s, p) := by
  exact isCarmichael_prod_of_dvd hprime hcard hL hprod.symm.dvd'

end

end

section

/- A finite set of primes can be recovered from its product. -/
theorem prime_subset_product_injective {P : Finset ℕ}
    (hP : ∀ p ∈ P, Nat.Prime p) :
    Set.InjOn (fun s : Finset ℕ => ∏ p ∈ s, p) {s | s ⊆ P} := by
  intro s hs t ht hst
  have hs' : ∀ p ∈ s, Nat.Prime p := fun p hp => hP p (hs hp)
  have ht' : ∀ p ∈ t, Nat.Prime p := fun p hp => hP p (ht hp)
  simpa only [Nat.primeFactors_prod hs', Nat.primeFactors_prod ht'] using
    congrArg Nat.primeFactors hst

/- Every finite family of admissible prime subsets produces as many distinct
Carmichael numbers below the stated bound. -/
theorem subset_family_card_le_carmichaelCounting {P : Finset ℕ}
    (hP : ∀ p ∈ P, Nat.Prime p) (A : Finset (Finset ℕ)) (x : ℝ)
    (hsub : ∀ s ∈ A, s ⊆ P)
    (hcar : ∀ s ∈ A, IsCarmichael (∏ p ∈ s, p))
    (hbound : ∀ s ∈ A, ((∏ p ∈ s, p : ℕ) : ℝ) ≤ x) :
    (A.card : ℝ) ≤ Erdos1057.carmichaelCounting x := by
  have hfinite : Set.Finite {n : ℕ | IsCarmichael n ∧ (n : ℝ) ≤ x} := by
    apply (Set.finite_Iic ⌊x⌋₊).subset
    intro n hn
    exact Nat.le_floor hn.2
  have hinj : Set.InjOn (fun s : Finset ℕ => ∏ p ∈ s, p) (A : Set (Finset ℕ)) := by
    intro s hs t ht hst
    exact prime_subset_product_injective hP (hsub s hs) (hsub t ht) hst
  have hcard := Set.ncard_le_ncard_of_injOn
    (fun s : Finset ℕ => ∏ p ∈ s, p)
    (fun s hs => And.intro (hcar s hs) (hbound s hs)) hinj hfinite
  simp only [Set.ncard_coe_finset] at hcard
  unfold Erdos1057.carmichaelCounting
  exact_mod_cast hcard
end

section

/- A prime-power factor of a finite least common multiple occurs in one of its inputs. -/
theorem lcm_prime_power_le_bound {ι : Type*} (s : Finset ι) (f : ι → ℕ)
    (hs : s.Nonempty) (hne : ∀ i ∈ s, f i ≠ 0) {B : ℕ}
    (hbound : ∀ i ∈ s, f i ≤ B) (q : ℕ) :
    q ^ (s.lcm f).factorization q ≤ B := by
  rw [Finset.factorization_lcm hne q]
  obtain ⟨i, hi, heq⟩ := Finset.exists_mem_eq_sup s hs (fun i => (f i).factorization q)
  rw [heq]
  exact (Nat.ordProj_le q (hne i hi)).trans (hbound i hi)

section

variable
  {ι : Type*}
  (s : Finset ι)
  (f : ι → ℕ)
  (hne : ∀ i ∈ s, f i ≠ 0)

include ι s f hne

/- The least common multiple is at most the input bound raised to the number
of distinct prime factors in the modulus. -/
theorem lcm_le_pow_primeFactors_card  {B : ℕ} (hbound : ∀ i ∈ s, f i ≤ B) :
    s.lcm f ≤ B ^ (s.lcm f).primeFactors.card := by
  classical
  by_cases hs : s.Nonempty
  · have hL : s.lcm f ≠ 0 := Finset.lcm_ne_zero_iff.mpr hne
    calc
      s.lcm f = ∏ q ∈ (s.lcm f).primeFactors, q ^ (s.lcm f).factorization q :=
        Nat.prod_primeFactors_pow_factorization hL
      _ ≤ ∏ _q ∈ (s.lcm f).primeFactors, B := by
        exact Finset.prod_le_prod' (fun q _ => lcm_prime_power_le_bound s f hs hne hbound q)
      _ = B ^ (s.lcm f).primeFactors.card := by simp
  · have hempty : s = ∅ := Finset.not_nonempty_iff_eq_empty.mp hs
    simp [hempty]

/- Smoothness of all inputs passes to their least common multiple. -/
theorem primeFactors_lcm_le  {K : ℕ}
    (hsmooth : ∀ i ∈ s, ∀ q : ℕ, q.Prime → q ∣ f i → q ≤ K)
    {q : ℕ} (hq : q ∈ (s.lcm f).primeFactors) : q ≤ K := by
  classical
  by_cases hs : s.Nonempty
  · have hpos : (s.lcm f).factorization q ≠ 0 := Finsupp.mem_support_iff.mp hq
    rw [Finset.factorization_lcm hne q] at hpos
    obtain ⟨i, hi, heq⟩ := Finset.exists_mem_eq_sup s hs (fun i => (f i).factorization q)
    rw [heq] at hpos
    exact hsmooth i hi q (Nat.prime_of_mem_primeFactors hq)
      (Nat.dvd_of_factorization_pos hpos)
  · have hempty : s = ∅ := Finset.not_nonempty_iff_eq_empty.mp hs
    simp [hempty] at hq

/- A smooth least common multiple obeys a bound independent of the number of inputs. -/
theorem smooth_lcm_le_pow  {B K : ℕ} (hB : 1 ≤ B)
    (hbound : ∀ i ∈ s, f i ≤ B)
    (hsmooth : ∀ i ∈ s, ∀ q : ℕ, q.Prime → q ∣ f i → q ≤ K) :
    s.lcm f ≤ B ^ K := by
  classical
  have hsub : (s.lcm f).primeFactors ⊆ Finset.Icc 1 K := by
    intro q hq
    exact Finset.mem_Icc.mpr ⟨(Nat.prime_of_mem_primeFactors hq).one_le,
      primeFactors_lcm_le s f hne hsmooth hq⟩
  have hcard : (s.lcm f).primeFactors.card ≤ K := by
    have h := Finset.card_le_card hsub
    simpa using h
  exact (lcm_le_pow_primeFactors_card s f hne hbound).trans
    (pow_le_pow_right₀ hB hcard)

/- Logarithmic form of the smooth-modulus bound used in the counting argument. -/
theorem log_smooth_lcm_le  {B K : ℕ} (hB : 1 ≤ B)
    (hbound : ∀ i ∈ s, f i ≤ B)
    (hsmooth : ∀ i ∈ s, ∀ q : ℕ, q.Prime → q ∣ f i → q ≤ K) :
    Real.log ((s.lcm f : ℕ) : ℝ) ≤ (K : ℝ) * Real.log (B : ℝ) := by
  have hL : 0 < ((s.lcm f : ℕ) : ℝ) := by
    exact_mod_cast Nat.pos_of_ne_zero (Finset.lcm_ne_zero_iff.mpr hne)
  have hbound' : ((s.lcm f : ℕ) : ℝ) ≤ (B : ℝ) ^ K := by
    exact_mod_cast smooth_lcm_le_pow s f hne hB hbound hsmooth
  simpa using Real.log_le_log hL hbound'

end

