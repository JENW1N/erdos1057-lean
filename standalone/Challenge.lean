lemma comparison_mod_three (A N:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) (hNA:N*A⁻¹∈levelThree) (i j:Fin 2) :
    (3:(_root_.OAI.ActualEisensteinCubic.O))∣N i j-A i j := by
  have hh:Matrix.SpecialLinearGroup.map (n:=Fin 2)
      (Ideal.Quotient.mk (Ideal.span {(3:(_root_.OAI.ActualEisensteinCubic.O))})) (N*A⁻¹)=1:=hNA
  rw [map_mul,map_inv] at hh
  have he:=mul_inv_eq_one.mp hh
  have he' :=congrArg (fun B:SL(2,(_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {(3:(_root_.OAI.ActualEisensteinCubic.O))})=>B i j) he
  exact Ideal.mem_span_singleton.mp ((Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp he')

lemma comparison_primary (A N:SL(2,(_root_.OAI.ActualEisensteinCubic.O))) (hNA:N*A⁻¹∈levelThree)
    (hA:lambda^2∣A 0 0-1) : lambda^2∣N 0 0-1 := by
