/- Exact cancellation of the shared factor in the manuscript's three phases. -/

namespace Bounty

theorem physical_phase_add (a b : ℝ) (n : ℕ) :
    physicalPhase (a + b) n = physicalPhase a n * physicalPhase b n := by
  simp only [physicalPhase, add_mul, Complex.ofReal_add, Complex.exp_add]

theorem physical_shared_phase_cancel (a b : ℝ) {s w z d : ℕ}
    (hs : 0 < s) (hw : 0 < w) (hz : 0 < z) (hd : 0 < d) :
    physicalPhase a (s * w) * physicalPhase b (s * z) *
      physicalPhase (-(a + b)) (s * d) =
    physicalPhase a w * physicalPhase b z * physicalPhase (-(a + b)) d := by
  rw [physical_phase_mul a hs hw, physical_phase_mul b hs hz,
    physical_phase_mul (-(a + b)) hs hd]
  have he : physicalPhase a s * physicalPhase b s * physicalPhase (-(a + b)) s = 1 := by
    rw [← physical_phase_add, ← physical_phase_add, add_neg_cancel]
    simp only [physicalPhase, zero_mul, Complex.ofReal_zero, Complex.exp_zero]
  calc
    _ = (physicalPhase a s * physicalPhase b s * physicalPhase (-(a + b)) s) *
      (physicalPhase a w * physicalPhase b z * physicalPhase (-(a + b)) d) := by ring
    _ = _ := by rw [he, one_mul]










theorem physical_shared_scaled_position {G : Type*} [Fintype G]
    {P : G → Finset ℕ} {J ell : ℕ} (C : G → Finset (Fin J))
    (L : PhysicalMarkLists P J ell) (aux : PhysicalAuxLabels P C)
    (hprime : ∀ g p, p ∈ P g → p.Prime) (n : ℤ) (Z : ℝ)
    (hdiv : (physicalSharedFactor C L : ℤ) ∣ n) :
    (n : ℝ) / (Z * physicalD C L aux) =
      ((n / physicalSharedFactor C L : ℤ) : ℝ) / (Z * physicalFreeFactor C aux) := by
  have hn : (n : ℝ) = (physicalSharedFactor C L : ℝ) *
      ((n / physicalSharedFactor C L : ℤ) : ℝ) := by
    exact_mod_cast (Int.mul_ediv_cancel' hdiv).symm
  have hs : (physicalSharedFactor C L : ℝ) ≠ 0 := by
    exact_mod_cast (ne_of_gt (physical_shared_factor_pos C L hprime))
  calc
    _ = ((physicalSharedFactor C L : ℝ) * ((n / physicalSharedFactor C L : ℤ) : ℝ)) /
        ((physicalSharedFactor C L : ℝ) * (Z * physicalFreeFactor C aux)) := by
      rw [← hn, physical_D_shared_free, Nat.cast_mul]
      congr 1
      ring
    _ = _ := mul_div_mul_left _ _ hs

end Bounty
