    (L : PhysicalMarkLists Ps J ell)
    (pl : PhysicalMixedSmallPlan (I := I)
      ((List.range (4 * n + 1)).map (physicalSelectedFineTag n)))
    (paths : Finset Ω)
    (x : Ω → ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (sizes g)) M B)
