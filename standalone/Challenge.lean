section

/- Logarithmic marked-list lengths give a polynomial overlap factor, which
is dominated by the lower endpoint of the prime pools. -/

open Filter
namespace Bounty

theorem four_pow_length_le_rpow {L A : ℝ} (hL : 0 < L) {J n : ℕ}
    (hJ : (J : ℝ) ≤ A * Real.log L) :
    (4 : ℝ) ^ (J * n) ≤ L ^ (A * n * Real.log 4) := by
  have h4 : 0 ≤ Real.log (4 : ℝ) := Real.log_nonneg (by norm_num)
  calc
    _ = Real.exp (((J : ℝ) * n) * Real.log 4) := by
      rw [← Nat.cast_mul, Real.exp_nat_mul, Real.exp_log (by norm_num)]
    _ ≤ Real.exp ((A * Real.log L * n) * Real.log 4) := by
      apply Real.exp_le_exp.mpr
      exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hJ (Nat.cast_nonneg n)) h4
    _ = _ := by rw [Real.rpow_def_of_pos hL]; congr 1; ring

theorem eventually_polynomial_div_exp_power {c : ℝ} (hc : 0 < c) (A a D : ℝ) :
    ∀ᶠ L : ℝ in atTop, A * L ^ a / Real.exp (L ^ c) ≤ L ^ (-D) := by
  filter_upwards [eventually_mul_rpow_le_exp_rpow (a+D) A hc,
    eventually_gt_atTop (0 : ℝ)] with L hbound hL
  rw [Real.rpow_neg hL.le, ← one_div]
  apply (le_div_iff₀ (Real.rpow_pos_of_pos hL D)).mpr
  rw [div_mul_eq_mul_div]
  apply (div_le_iff₀ (Real.exp_pos _)).mpr
  calc
    _ = A * L ^ (a+D) := by rw [Real.rpow_add hL]; ring
    _ ≤ _ := by simpa only [one_mul] using hbound

end Bounty
end

section

/- A relative square-error budget gives a linear error for harmonic pairings. -/

open Finset
namespace Bounty

theorem harmonic_replacement_error_envelope {E D ε : ℝ}
    (hE : 0 ≤ E) (hε : 0 ≤ ε) (hε1 : ε ≤ 1) (hD : D ≤ E*ε^2) :
    Real.sqrt D * Real.sqrt E + Real.sqrt (2*(E+D)) * Real.sqrt D ≤ 3*E*ε := by
  have hs : (Real.sqrt E)^2 = E := Real.sq_sqrt hE
  have hDE : D ≤ E := hD.trans (by
    have hsq : ε^2 ≤ (1 : ℝ)^2 := pow_le_pow_left₀ hε hε1 2
    nlinarith [mul_le_mul_of_nonneg_left hsq hE])
  have hd : Real.sqrt D ≤ Real.sqrt E*ε :=
    (Real.sqrt_le_left (mul_nonneg (Real.sqrt_nonneg _) hε)).mpr (by nlinarith)
  have he : Real.sqrt (2*(E+D)) ≤ 2*Real.sqrt E :=
    (Real.sqrt_le_left (by positivity)).mpr (by nlinarith)
  calc
    _ ≤ (Real.sqrt E*ε)*Real.sqrt E + (2*Real.sqrt E)*(Real.sqrt E*ε) :=
      add_le_add (mul_le_mul_of_nonneg_right hd (Real.sqrt_nonneg _))
        (mul_le_mul he hd (Real.sqrt_nonneg _) (by positivity))
    _ = 3*(Real.sqrt E)^2*ε := by ring
    _ = _ := by rw [hs]




end Bounty
end

section

/- The original auxiliary draw measure gives a bilinear Fourier multiplier,
without excluding repeated prime labels or changing the tuple spaces. -/

open Finset MeasureTheory
open scoped Classical ComplexConjugate
namespace Bounty

noncomputable def physicalAuxFourierMultiplier
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (x : ℝ) : ℂ :=
  ∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
    (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ) *
      bA (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
      bB (repeatedBigAuxSplitEquiv P A B hU hAB aux).2 *
      fourier (-(k * (∏ g, ∏ j : repeatedBigAuxCut A B g, (aux g j).val : ℕ)))
        (x : AddCircle (1 : ℝ))

theorem physical_aux_fourier_split
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (x : ℝ) :
    physicalAuxFourierMultiplier P V A B hU hAB k bA bB x =
      ∑ a : (∀ i : A, P i.val.1), ∑ b : (∀ i : B, P i.val.1),
        ((finiteProductWeight (fun i : A => physicalLabelLaw V i.val.1) a : ℂ) * bA a) *
        ((finiteProductWeight (fun i : B => physicalLabelLaw V i.val.1) b : ℂ) * bB b) *
        fourier (-(k * ((∏ i : A, (a i).val) * (∏ i : B, (b i).val) : ℕ)))
          (x : AddCircle (1 : ℝ)) := by
  unfold physicalAuxFourierMultiplier
  rw [repeated_big_aux_split_sum P A B hU hAB]
  apply sum_congr rfl
  intro a _
  apply sum_congr rfl
  intro b _
  rw [repeatedBigAuxSplitEquiv_symm_mass, repeatedBigAuxSplitEquiv_symm_label_prod]
  simp only [Equiv.apply_symm_apply, Complex.ofReal_mul]
  ring

theorem physical_aux_averaged_shift_fourier
    {G : Type*} [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ)
    (A B : Finset (RepeatedBigFlatIndex G J ell))
    (hU : ∀ g (j : Fin ell), (⟨g, Sum.inr j⟩ : RepeatedBigFlatIndex G J ell) ∉ A ∪ B)
    (hAB : Disjoint A B) (k : ℤ)
    (bA : (∀ i : A, P i.val.1) → ℂ) (bB : (∀ i : B, P i.val.1) → ℂ)
    (S T : Finset ℤ) (f g : ℤ → ℂ) :
    (∑ aux : PhysicalAuxLabels P (repeatedBigAuxCut A B),
      (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ) *
        bA (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
        bB (repeatedBigAuxSplitEquiv P A B hU hAB aux).2 *
        ∑ n ∈ S, let δ : ℤ := k * (∏ g, ∏ j : repeatedBigAuxCut A B g, (aux g j).val : ℕ)
          if n+δ ∈ T then conj (f n)*g (n+δ) else 0) =
      ∫ x in (0 : ℝ)..1, conj (finiteFourierSum S f x) * finiteFourierSum T g x *
        physicalAuxFourierMultiplier P V A B hU hAB k bA bB x := by
  exact finite_averaged_shift_fourier univ
    (fun aux => (physicalAuxMass V (repeatedBigAuxCut A B) aux : ℂ) *
      bA (repeatedBigAuxSplitEquiv P A B hU hAB aux).1 *
      bB (repeatedBigAuxSplitEquiv P A B hU hAB aux).2)
    (fun aux => k * (∏ g, ∏ j : repeatedBigAuxCut A B g, (aux g j).val : ℕ)) S T f g

end Bounty
end

section

/- The actual major region is bounded by a finite sum of local Fourier
energies on explicit rational-centered intervals. -/

open Finset MeasureTheory
namespace Bounty

theorem product_major_energy_cover (S : Finset ℤ) (f : ℤ → ℂ)
    {k : ℤ} {L q U V : ℝ} (hk : k ≠ 0) (hU : 0 < U) (hV : 0 < V)
    (hscale : L^q ≤ U*V) :
    let Q := ⌊L^q⌋₊
    let N := Q*(k.natAbs+1)
    let w := L^q/(|(k : ℝ)| * (U*V))
    (∫ x in productMajorArcSet k L q U V ∩ Set.Ioc 0 1,
      ‖finiteFourierSum S f x‖^2) ≤
    ∑ r ∈ Icc 1 Q, ∑ u ∈ Icc (-(N : ℤ)) (N : ℤ),
      ∫ x in Set.Icc (-(u : ℝ)/((k : ℝ)*r)-w) (-(u : ℝ)/((k : ℝ)*r)+w),
        ‖finiteFourierSum S f x‖^2 := by
  classical
  dsimp only
  let s := (Icc 1 ⌊L^q⌋₊).product
    (Icc (-((⌊L^q⌋₊*(k.natAbs+1) : ℕ) : ℤ)) ((⌊L^q⌋₊*(k.natAbs+1) : ℕ) : ℤ))
  let C (i : ℕ × ℤ) := Set.Icc
    (-(i.2 : ℝ)/((k : ℝ)*i.1)-L^q/(|(k : ℝ)| * (U*V)))
    (-(i.2 : ℝ)/((k : ℝ)*i.1)+L^q/(|(k : ℝ)| * (U*V)))
  have hc := (continuous_finiteFourierSum S f).norm.pow 2
  have hb := finite_cover_integral_le volume s
    (productMajorArcSet k L q U V ∩ Set.Ioc 0 1) C
    (fun x => ‖finiteFourierSum S f x‖^2)
    ((product_major_arc_set_measurable k L q U V).inter measurableSet_Ioc)
    (fun _ _ => measurableSet_Icc) (fun _ => sq_nonneg _)
    (hc.integrableOn_Ioc.mono_set Set.inter_subset_right)
    (fun _ _ => hc.integrableOn_Icc) ?_
  · apply hb.trans_eq
    exact Finset.sum_finset_product s (Icc 1 ⌊L^q⌋₊)
      (fun _ => Icc (-((⌊L^q⌋₊*(k.natAbs+1) : ℕ) : ℤ))
        ((⌊L^q⌋₊*(k.natAbs+1) : ℕ) : ℤ))
      (fun _ => mem_product)
  · intro x hx
    obtain ⟨r, u, hr, hu, hclose⟩ := product_major_arc_finite_cover hk hU hV hscale
      ⟨hx.2.1.le, hx.2.2⟩ hx.1
    refine ⟨(r,u), mem_product.mpr ⟨hr,hu⟩, ?_⟩
    dsimp only [C, Set.mem_Icc]
    have hh := abs_le.mp hclose
    constructor <;> linarith

end Bounty
