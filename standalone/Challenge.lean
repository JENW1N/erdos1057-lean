    · exact hγ n hn
    · simpa only [norm_zero] using hC0
  refine ⟨(fun j => ⌊(2 : ℝ)^j.val*(V/2)⌋₊+1),
    (fun j => ⌊(2 : ℝ)^(j.val+1)*(V/2)⌋₊),
    (fun _ n => if n ∈ Icc 1 ⌊16*V⌋₊ then endpointTripleConvolution α' β' γ' n/(n : ℂ) else 0),
    (fun j => (2 : ℝ)^j.val*(V/2)),?_,?_⟩
  · intro j
    have hg := five_dyad_full_geometry hV hlog j
    refine ⟨hg.1,hg.2.1,hg.2.2.1,hg.2.2.2.1,hg.2.2.2.2,?_⟩
    refine (finite_masked_energy_le _ _ _).trans ?_
    apply henergy α' β' γ' A0 B0 C0 _ hA0 hB0 hC0 hg.2.1 hg.2.2.1 hprod hα' hβ' hγ'
    intro n hn
    obtain ⟨hnlo,hnhi⟩ := mem_Icc.mp hn
    exact ⟨hg.2.2.2.1.trans (Nat.cast_le.mpr hnlo),
      (Nat.cast_le.mpr hnhi).trans hg.2.2.2.2⟩
  · intro t
    exact (by
      classical
      dsimp only
      have hApos : ∀ a ∈ A, 0 < a := fun a ha => Nat.cast_pos.mp (hUA.trans_le (hA a ha).1)
      have hBpos : ∀ b ∈ B, 0 < b := fun b hb => Nat.cast_pos.mp (hUB.trans_le (hB b hb).1)
      have hCpos : ∀ c ∈ C, 0 < c := fun c hc => Nat.cast_pos.mp (hUC.trans_le (hC c hc).1)
      have hprod : ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C,
          UA*UB*UC ≤ (a*b*c : ℕ) ∧ (a*b*c : ℕ) ≤ 16*(UA*UB*UC) := by
        intro a ha b hb c hc
        simpa only [one_mul,Nat.one_mul] using four_dyadic_factor_product_bounds
          (UD := 1) (UA := UA) (UB := UB) (UC := UC) (d := 1) (a := a) (b := b) (c := c)
          (by norm_num) hUA hUB hUC (by norm_num) (hA a ha) (hB b hb) (hC c hc)
      have hs : ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C, a*b*c ∈ Icc 1 ⌊16*(UA*UB*UC)⌋₊ := by
        intro a ha b hb c hc
        exact mem_Icc.mpr ⟨Nat.mul_pos (Nat.mul_pos (hApos a ha) (hBpos b hb)) (hCpos c hc),
          Nat.le_floor (hprod a ha b hb c hc).2⟩
      have hsize : ∀ a ∈ A, ∀ b ∈ B, ∀ c ∈ C,
