     (E := KernelEnergyGraph→L[ℂ]KernelEnergyGraph)
     (F := KernelQuotientL2→L[ℂ]KernelQuotientL2) kernelL2SandwichCLM
       (Ring.inverse (kernelSpectralFormOperator z))).comp_of_eq
