section

/- A single finite physical pattern family for the raw row minus the
alternating prime-comparison rows. The raw pattern is kept explicitly. -/

open Finset
open scoped Classical

namespace Bounty

def repeatedBigPrimeProbeSlots {G : Type*} {J ell : ℕ}
    (probes : G → Finset (Fin J)) (g : G) : Finset (PhysicalSlots J ell) :=
  (probes g).map (Function.Embedding.inl (β := Fin ell))

abbrev RepeatedBigPrimePatternPair {G : Type*} [DecidableEq G] {J ell : ℕ}
    (probes : G → Finset (Fin J)) (r t : Finset G) :=
  ↥(cleanNonemptySubsets (r.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes))) ×
    ↥(cleanNonemptySubsets (t.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes)))

abbrev RepeatedBigPrimePatternIndex {G : Type*} [DecidableEq G] {J ell : ℕ}
    (probes : G → Finset (Fin J)) (r t : Finset G) :=
  Unit ⊕ RepeatedBigPrimePatternPair (ell := ell) probes r t

theorem repeated_big_prime_pattern_pair_valid {G : Type*} [Fintype G] [DecidableEq G]
    {J ell : ℕ} (probes : G → Finset (Fin J)) (r t : Finset G) (hrt : Disjoint r t)
    (ab : RepeatedBigPrimePatternPair (ell := ell) probes r t) :
    ab.1.val ⊆ repeatedBigFlatActive J ell ∧
      ab.2.val ⊆ repeatedBigFlatActive J ell ∧ Disjoint ab.1.val ab.2.val := by
  have hsub (u : Finset G) :
      u.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes) ⊆ repeatedBigFlatActive J ell := by
    rintro ⟨g, i⟩ hi
    rcases mem_map.mp (mem_sigma.mp hi).2 with ⟨j, _, rfl⟩
    exact repeatedBigFlatActive_mem_inl J ell g j
  have ha := ((clean_mem_nonempty_subsets _ _).mp ab.1.property).2
  have hb := ((clean_mem_nonempty_subsets _ _).mp ab.2.property).2
  refine ⟨ha.trans (hsub r), hb.trans (hsub t), ?_⟩
  apply disjoint_left.mpr
  intro i hi hj
  exact disjoint_left.mp hrt (mem_sigma.mp (ha hi)).1 (mem_sigma.mp (hb hj)).1

noncomputable def repeatedBigPrimePatternCut {G : Type*} [DecidableEq G] {J ell : ℕ}
    (probes : G → Finset (Fin J)) (r t : Finset G) :
    RepeatedBigPrimePatternIndex (ell := ell) probes r t → G → Finset (Fin J)
  | .inl _ => fun _ => ∅
  | .inr ab => repeatedBigAuxCut ab.1.val ab.2.val

noncomputable def repeatedBigPrimePatternWeight {G : Type*} [DecidableEq G] {J ell : ℕ}
    (probes : G → Finset (Fin J)) (r t : Finset G) :
    RepeatedBigPrimePatternIndex (ell := ell) probes r t → ℂ
  | .inl _ => 1
  | .inr ab => -(-1 : ℂ) ^ (ab.1.val.card + ab.2.val.card)

noncomputable def repeatedBigPrimePatternKernel {G : Type*}
    [Fintype G] [DecidableEq G] {J ell : ℕ}
    (P : G → Finset ℕ) (V : G → ℝ) (probes : G → Finset (Fin J))
    (r t : Finset G) (hrt : Disjoint r t) (Q : ℕ) (h : ℝ)
    (kept : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ) :
    ∀ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      RepeatedBigLists P J ell → RepeatedBigLists P J ell →
        PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i) → ℂ
  | .inl _ => fun _ _ _ => 1
  | .inr ab =>
      let hv := repeated_big_prime_pattern_pair_valid probes r t hrt ab
      repeatedBigPrimeCoefficient P V ab.1.val ab.2.val
        (repeated_big_active_pair_avoids_tail hv.1 hv.2.1) hv.2.2
        Q h (kept ab.1.val) (kept ab.2.val)

section

variable
  {G : Type*}
  [sharedInstance1 : Fintype G]
  [sharedInstance2 : DecidableEq G]
  {J ell : ℕ}
  (P : G → Finset ℕ)
  (V : G → ℝ)
  (probes : G → Finset (Fin J))
  (r t : Finset G)
  (hrt : Disjoint r t)
  (Q : ℕ)
  (h : ℝ)
  (kept : Finset (RepeatedBigFlatIndex G J ell) → Finset ℤ)
  (ζ Θ : ℝ)
  (source target : RepeatedBigLists P J ell)

include G sharedInstance1 sharedInstance2 J ell P V probes r t hrt Q h kept ζ Θ source target

theorem repeated_big_prime_pattern_raw_row  :
    (∑ aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut (ell := ell) probes r t (.inl ())),
      repeatedBigPrimePatternWeight (ell := ell) probes r t (.inl ()) *
        repeatedBigUnbannedKernel V (fun _ _ => 1)
          (repeatedBigPrimePatternCut (ell := ell) probes r t (.inl ())) ζ
          (repeatedBigPrimePatternKernel P V probes r t hrt Q h kept (.inl ())) aux source target *
        physicalReturnPhase Θ
          (repeatedBigD (repeatedBigPrimePatternCut (ell := ell) probes r t (.inl ())) source aux)) =
      repeatedBigPrimeRawRow P V ζ Θ source target := by
  simp only [repeatedBigPrimePatternWeight, one_mul]
  rfl

theorem repeated_big_prime_pattern_pair_row 
    (ab : RepeatedBigPrimePatternPair (ell := ell) probes r t) :
    (∑ aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t (.inr ab)),
      repeatedBigPrimePatternWeight probes r t (.inr ab) *
        repeatedBigUnbannedKernel V (fun _ _ => 1)
          (repeatedBigPrimePatternCut probes r t (.inr ab)) ζ
          (repeatedBigPrimePatternKernel P V probes r t hrt Q h kept (.inr ab)) aux source target *
        physicalReturnPhase Θ
          (repeatedBigD (repeatedBigPrimePatternCut probes r t (.inr ab)) source aux)) =
      -(-1 : ℂ) ^ (ab.1.val.card + ab.2.val.card) *
        repeatedBigPrimeComparisonRow P V ab.1.val ab.2.val Q h kept kept ζ Θ source target := by
  have hv := repeated_big_prime_pattern_pair_valid probes r t hrt ab
  rw [repeatedBigPrimeComparisonRow_eq P V ab.1.val ab.2.val hv.1 hv.2.1 hv.2.2]
  change (∑ aux, -(-1 : ℂ) ^ (ab.1.val.card + ab.2.val.card) * _ * _) =
    -(-1 : ℂ) ^ (ab.1.val.card + ab.2.val.card) * (∑ aux, _ * _)
  rw [mul_sum]
  apply sum_congr rfl
  intro aux haux
  dsimp only [repeatedBigPrimePatternCut, repeatedBigPrimePatternKernel]
  ring

theorem repeated_big_prime_pattern_family_kernel  :
    (∑ i : RepeatedBigPrimePatternIndex (ell := ell) probes r t,
      ∑ aux : PhysicalAuxLabels P (repeatedBigPrimePatternCut probes r t i),
        repeatedBigPrimePatternWeight probes r t i *
          repeatedBigUnbannedKernel V (fun _ _ => 1)
            (repeatedBigPrimePatternCut probes r t i) ζ
            (repeatedBigPrimePatternKernel P V probes r t hrt Q h kept i) aux source target *
          physicalReturnPhase Θ (repeatedBigD (repeatedBigPrimePatternCut probes r t i) source aux)) =
      repeatedBigPrimeDifferenceKernel P V probes r t Q h kept ζ Θ source target := by
  rw [Fintype.sum_sum_type]
  simp only [Fintype.sum_unique, repeated_big_prime_pattern_raw_row,
    repeated_big_prime_pattern_pair_row]
  rw [Fintype.sum_prod_type]
  simp only [repeatedBigPrimeDifferenceKernel, Pi.sub_apply, Finset.sum_apply,
    Pi.smul_apply, smul_eq_mul]
  rw [sub_eq_add_neg]
  congr 1
  simp only [neg_mul, ← sum_neg_distrib]
  let As := cleanNonemptySubsets (r.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes))
  let Bs := cleanNonemptySubsets (t.sigma (repeatedBigPrimeProbeSlots (ell := ell) probes))
  let F := fun a b : Finset (RepeatedBigFlatIndex G J ell) =>
    -((-1 : ℂ) ^ (a.card + b.card) *
      repeatedBigPrimeComparisonRow P V a b Q h kept kept ζ Θ source target)
  change (∑ a : As, ∑ b : Bs, F a.val b.val) = ∑ a ∈ As, ∑ b ∈ Bs, F a b
  calc
    _ = ∑ a : As, ∑ b ∈ Bs, F a.val b := by
      apply sum_congr rfl
      intro a ha
      exact sum_coe_sort Bs (F a.val)
    _ = _ := sum_coe_sort As (fun a => ∑ b ∈ Bs, F a b)

end





end Bounty
end

section

/- An actual rough pair box avoiding the nonallowed shifted divisibility classes. -/

open Finset

namespace Bounty

noncomputable def oddMaskedPairBox (a b c d m : ℕ) (W z : ℝ) (A : Finset ℕ) : Finset (ℕ × ℕ) := by
  classical
  exact (pairSieveBaseBox a b c d m).filter (fun v =>
    (∀ p ∈ primeBand 0 W, ¬p ∣ v.1*v.2) ∧
    (∀ p ∈ primeBand 0 z, p ≠ 2 → ¬p ∣ m → p ∉ A → (v.1*v.2) % p ≠ 1 % p))

theorem odd_masked_pair_box_subset (a b c d m : ℕ) (W z : ℝ)
    (hW : 0 ≤ W) (hWz : W ≤ z) (A : Finset ℕ) :
    oddMaskedPairBox a b c d m W z A ⊆
      pairSieveAvoidance a b c d m (maskedPairPrimes m z)
        (maskedPairRoughFlag W) (maskedPairBannedFlag A) := by
  classical
  have hz := hW.trans hWz
  intro v hv
  obtain ⟨hvbase, hvrough, hvban⟩ := mem_filter.mp hv
  apply mem_filter.mpr
  refine ⟨hvbase, ?_⟩
  intro p hp hbad
  obtain ⟨hprime, hpz, hp2, hpm⟩ := (mem_masked_pair_primes hz).mp hp
  rcases hbad with ⟨hr, hzero⟩ | ⟨hb, hone⟩
  · have hpW : (p : ℝ) ≤ W := by simpa [maskedPairRoughFlag] using hr
    exact hvrough p ((mem_primeBand_iff le_rfl hW p).mpr
      ⟨hprime, Nat.cast_pos.mpr hprime.pos, hpW⟩) (Nat.dvd_of_mod_eq_zero hzero)
  · have hpA : p ∉ A := by simpa [maskedPairBannedFlag] using hb
    exact hvban p ((mem_primeBand_iff le_rfl hz p).mpr
      ⟨hprime, Nat.cast_pos.mpr hprime.pos, hpz⟩) hp2 hpm hpA hone

theorem exists_odd_masked_pair_box_upper :
    ∃ K : ℝ, 0 < K ∧ ∀ (L : ℝ) (a b c d m : ℕ) [NeZero m]
      (W z : ℝ) (A : Finset ℕ),
      1 ≤ L → (m : ℝ) ≤ Real.exp L →
      (∀ p ∈ m.primeFactors, L^2 ≤ (p : ℝ)) →
      a ≤ b → c ≤ d → 0 ≤ W → W ≤ z → 1 < z →
      (∀ p ∈ A, 2 ≤ p) →
      ((oddMaskedPairBox a b c d m W z A).card : ℝ) ≤
        K * (((b : ℝ)-a)*((d : ℝ)-c)/(m : ℝ)) *
          (∏ p ∈ primeBand 0 W, (1 - 1/(p : ℝ)))^2 *
          (∏ p ∈ primeBand 0 z, (1 - 1/(p : ℝ))) *
          (∏ p ∈ A, (1 - 1/(p : ℝ))⁻¹) +
        ((m : ℝ)*(z^(10 : ℝ))^3 + (((b : ℝ)-a)+((d : ℝ)-c))*(z^(10 : ℝ))^2) := by
  classical
  obtain ⟨K, hK, hb⟩ := exists_finite_pair_sieve_product_upper
  refine ⟨K*(8*Real.exp 12), by positivity, ?_⟩
  intro L a b c d m hm W z A hL hmL hmin hab hcd hW hWz hz hA
  have hprop := fun (p : ℕ) (hp : p ∈ maskedPairPrimes m z) =>
    (mem_masked_pair_primes (zero_lt_one.trans hz).le).mp hp
  have hprime : ∀ p ∈ maskedPairPrimes m z, p.Prime := fun p hp => (hprop p hp).1
  have h3 : ∀ p ∈ maskedPairPrimes m z, 3 ≤ p := by
    intro p hp
    have h2 := (hprime p hp).two_le
    have hn := (hprop p hp).2.2.1
    omega
  have h := hb a b c d m (maskedPairPrimes m z) (maskedPairRoughFlag W) (maskedPairBannedFlag A)
    hab hcd hz hprime h3 (fun p hp => (hprop p hp).2.2.2) (fun p hp => (hprop p hp).2.1)
  have hrf : (maskedPairPrimes m z).filter (fun p => maskedPairRoughFlag W p = true) =
      maskedPairRoughPrimes m W z := by ext p; simp [maskedPairRoughPrimes, maskedPairRoughFlag]
  have hbf : (maskedPairPrimes m z).filter (fun p => maskedPairBannedFlag A p = true) =
      maskedPairBannedPrimes m z A := by ext p; simp [maskedPairBannedPrimes, maskedPairBannedFlag]
  rw [hrf, hbf] at h
  have hcard : ((oddMaskedPairBox a b c d m W z A).card : ℝ) ≤
      ((pairSieveAvoidance a b c d m (maskedPairPrimes m z)
        (maskedPairRoughFlag W) (maskedPairBannedFlag A)).card : ℝ) :=
    Nat.cast_le.mpr (card_le_card (odd_masked_pair_box_subset a b c d m W z hW hWz A))
  have hX : 0 ≤ (b : ℝ)-a := sub_nonneg.mpr (Nat.cast_le.mpr hab)
  have hY : 0 ≤ (d : ℝ)-c := sub_nonneg.mpr (Nat.cast_le.mpr hcd)
  have hc : 0 ≤ K * (((b : ℝ)-a)*((d : ℝ)-c)/(m : ℝ)) := by positivity
  have he := mul_le_mul_of_nonneg_left
    (masked_pair_euler_uniform_bound hL m (NeZero.ne m) hmL hmin W z hW hWz A hA) hc
  apply (hcard.trans h).trans
  apply add_le_add _ le_rfl
  convert he using 1 <;> ring

end Bounty
end

section

/- The original coefficient is retained exactly, including the zero-weight support. -/

open scoped Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*} [∀ g, DecidableEq (P g)]
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (edgePhase : ∀ k, ((g : Fin N) → Finset (P g)) →
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) →
    FullActiveEdgeEvent n (S k) B (A k) (Δ k) (D k) x → ℂ)
  (hedge : ∀ k H x e,
    edgePhase k H x e =
      (if FullMixedLocalBirthAvoids (J := J) n S B A Δ D H (some (.inr k)) x e ∧
          FullMixedLocalBirthDistinct (J := J) n S B A Δ D (some (.inr k)) x e then 1 else 0) *
        edgePhase k (fun _ => ∅) x e)
  (ω : ∀ k c, A k c → ℝ) (μ : (g : Fin N) → P g → ℝ)
  (q : J → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
  (steps : List (Option (J ⊕ K)))
  (initial : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B →
    (g : Fin N) → Finset (P g))
  (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (p : FullPermutationMixedPath n S B A Δ D steps x)

include hedge in
theorem full_mixed_physical_weighted_phase_factor
    (hx : FullMixedLedgerCovers n B (initial x, x)) :
    let w := finiteEventPathWeight (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps x p
    (w : ℂ) * (
    fullMixedLedgerInducedPhase n S B A Δ D steps initial
      (finiteEventLocalPhase
        (fun tag (s : FullMixedLedgerState n (M := M) B) =>
          FullPermutationMixedEvent n S B A Δ D tag s.2)
        (fullMixedLedgerTarget n S B A Δ D) (fullMixedLedgerPhase n S B A Δ D edgePhase) steps) x p) =
    (w : ℂ) * (
    (if ∀ (a : FullMixedBirthAddress S B steps) (z : (g : Fin N) × P g),
        fullMixedPathBirthLabel n S B A Δ D steps x p a = some z → z.2 ∉ initial x z.1
      then 1 else 0) *
    (if ∀ (a b : FullMixedBirthAddress S B steps) z,
        fullMixedPathBirthLabel n S B A Δ D steps x p a = some z →
        fullMixedPathBirthLabel n S B A Δ D steps x p b = some z → a = b
      then 1 else 0) *
    finiteEventLocalPhase (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullMixedBirthResidualPhase n S B A Δ D edgePhase) steps x p) := by
  dsimp only
  by_cases hw : finiteEventPathWeight (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D)
      (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps x p = 0
  · simp only [hw, Complex.ofReal_zero, zero_mul]
  · rw [full_mixed_physical_path_phase_factor n S B A Δ D edgePhase hedge
      ω μ q ρ V steps initial x p hx hw]

end Full
end Bounty
