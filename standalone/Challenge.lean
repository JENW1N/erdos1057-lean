section

/- Removing integer quotient guards using the support of the actual real cutoff. -/

open Finset
open scoped ComplexConjugate

namespace Bounty

theorem typeII_smooth_cutoff_guard_removal {y : TypeIIShiftIndex}
    (E N : Finset ℕ) (η : ℝ → ℝ → ℝ)
    (hm : 0 < y.2.1.1) (hm' : 0 < y.2.2.1) (hk : y.1.1 ≠ 0)
    (hz : y.1.2 = y.2.2.1 * y.2.1.2)
    (hcross : (y.1.2 : ℤ) + y.1.1 = (y.2.1.1 : ℤ) * y.2.2.2)
    (hc : IsCoprime (y.2.1.1 : ℤ) y.1.1)
    (hmod : Int.ModEq (2 * |y.1.1|) (y.2.1.1 : ℤ) (y.2.2.1 : ℤ))
    (hpos : ∀ e n, η e n ≠ 0 → 0 < e)
    (hmem : ∀ e n : ℕ, η e n ≠ 0 → e ∈ E ∧ n ∈ N) :
    (if 0 < typeIIRecoveredE y ∧ 0 < typeIIRecoveredN y ∧
        (typeIIRecoveredE y).toNat ∈ E ∧ (typeIIRecoveredN y).toNat ∈ N
      then η (typeIIRecoveredE y).toNat (typeIIRecoveredN y).toNat else 0) =
        η (typeIIRealE y) (typeIIRealN y) := by
  classical
  by_cases he : 0 < typeIIRealE y
  · obtain ⟨hE, hN, hEr, hNr⟩ :=
      typeII_positive_real_reconstruction hm hm' hk hz hcross hc hmod he
    by_cases hη : η (typeIIRealE y) (typeIIRealN y) = 0
    · simp [hEr, hNr, hη]
    · have hη' : η (typeIIRecoveredE y).toNat (typeIIRecoveredN y).toNat ≠ 0 := by
        rwa [hEr, hNr]
      obtain ⟨hmE, hmN⟩ := hmem _ _ hη'
      simp [hE, hN, hmE, hmN, hEr, hNr]
  · have hE : ¬ 0 < typeIIRecoveredE y := by
      intro hp
      apply he
      rw [← typeII_recovered_e_real_of_congruence hmod]
      exact_mod_cast hp
    have hη : η (typeIIRealE y) (typeIIRealN y) = 0 := by
      by_contra hne
      exact he (hpos _ _ hne)
    simp [hE, hη]

def TypeIICrossConditions (y : TypeIIShiftIndex) : Prop :=
  0 < y.2.1.1 ∧ y.1.1 ≠ 0 ∧ y.1.2 = y.2.2.1 * y.2.1.2 ∧
    (y.1.2 : ℤ) + y.1.1 = (y.2.1.1 : ℤ) * y.2.2.2

noncomputable def typeIICrossSlice (M H Z : Finset ℕ) (k : ℤ) : Finset TypeIIShiftIndex := by
  classical
  exact ((({k} : Finset ℤ) ×ˢ Z) ×ˢ ((M ×ˢ H) ×ˢ (M ×ˢ H))).filter
    TypeIICrossConditions

noncomputable def typeIIRealShiftWeight (η : ℝ → ℝ → ℝ) (α aH : ℕ → ℂ)
    (y : TypeIIShiftIndex) : ℂ :=
  (η (typeIIRealE y) (typeIIRealN y) : ℂ) *
    (α y.2.1.1 * conj (α y.2.2.1) * aH y.2.1.2 * conj (aH y.2.2.2))

theorem typeII_smooth_shift_pointwise {y : TypeIIShiftIndex}
    (E N : Finset ℕ) (η : ℝ → ℝ → ℝ) (α aH : ℕ → ℂ)
    (hm' : 0 < y.2.2.1) {W : ℝ}
    (hrough : ∀ p ∈ y.2.1.1.primeFactors, W < (p : ℝ))
    (hsmall : |(y.1.1 : ℝ)| ≤ W)
    (hpos : ∀ e n, η e n ≠ 0 → 0 < e)
    (hmem : ∀ e n : ℕ, η e n ≠ 0 → e ∈ E ∧ n ∈ N) : by
  classical
  exact (if TypeIIShiftConditions E N y then
      typeIIShiftComplexWeight (fun e n => η e n) α aH y else 0) =
    (if TypeIICrossConditions y ∧ Nat.ModEq (2 * y.1.1.natAbs) y.2.1.1 y.2.2.1
      then typeIIRealShiftWeight η α aH y else 0) := by
  classical
  by_cases hcross : TypeIICrossConditions y
  · obtain ⟨hm, hk, hz, hcross⟩ := hcross
    by_cases hmod : Int.ModEq (2 * |y.1.1|) (y.2.1.1 : ℤ) (y.2.2.1 : ℤ)
    · have hnmod := (typeII_signed_congruence_iff (k := y.1.1) (m := y.2.1.1) (m' := y.2.2.1)).mp hmod
      have hc := typeII_rough_coprime_determinant hm hk hrough hsmall
      have hg := typeII_smooth_cutoff_guard_removal E N η hm hm' hk hz hcross hc hmod hpos hmem
      have hcc : TypeIICrossConditions y := ⟨hm, hk, hz, hcross⟩
      have hs : TypeIIShiftConditions E N y ↔
          0 < typeIIRecoveredE y ∧ 0 < typeIIRecoveredN y ∧
            (typeIIRecoveredE y).toNat ∈ E ∧ (typeIIRecoveredN y).toNat ∈ N := by
        unfold TypeIIShiftConditions
        tauto
      rw [if_pos (show TypeIICrossConditions y ∧
        Nat.ModEq (2 * y.1.1.natAbs) y.2.1.1 y.2.2.1 from ⟨hcc, hnmod⟩)]
      simp only [hs, typeIIShiftComplexWeight, typeIIRealShiftWeight]
      rw [← hg]
      split_ifs <;> simp
    · have hnmod := mt (typeII_signed_congruence_iff (k := y.1.1) (m := y.2.1.1) (m' := y.2.2.1)).mpr hmod
      simp [TypeIIShiftConditions, TypeIICrossConditions, hmod, hnmod]
  · have hc : ¬ TypeIIShiftConditions E N y := by
      intro h
      exact hcross ⟨h.1, h.2.1, h.2.2.1, h.2.2.2.1⟩
    simp [hc, hcross]

end Bounty
end

section

/- All actual allocation patterns may be truncated before Cauchy, at arbitrary logarithmic saving. -/

open Finset Filter Real

namespace Bounty

theorem eventually_candidate_allocation_box_error {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) (A D : ℝ) :
    ∀ᶠ L : ℝ in atTop, ∀ (jStar : ℕ) (E : ℝ) (F : ℕ → ℕ → ℂ),
      (∀ u ∈ arithmeticProductWindow 1 (exp L), ∀ m ∈ (2*u+1).divisors, ‖F u m‖ ≤ L^A) →
      ‖(∑ u ∈ arithmeticProductWindow 1 (exp L),
          (candidateCompactRangeCoefficient c L q r jStar E u : ℂ)*
            ∑ m ∈ (2*u+1).divisors, F u m) -
        ∑ u ∈ arithmeticProductWindow 1 (exp L),
          candidateBoxRangeCoefficient c L q r jStar E L u*
            ∑ m ∈ (2*u+1).divisors, F u m‖ ≤ exp L*L^(-D) := by
  obtain ⟨B,hB,hmass⟩ := exists_candidate_divisor_test_absolute_bound hc hr hq0 hq1 A
  obtain ⟨C,hC,hL1,hdecay⟩ := active_allocation_fourier_bounds (candidateAllocationRadius r)
  obtain ⟨M,hM⟩ := exists_candidate_truncation_order hc hC r (D+B)
  obtain ⟨CM,hCM,htrunc⟩ := hdecay M
  filter_upwards [hmass, hM M le_rfl CM hCM.le, eventually_ge_atTop (1 : ℝ)]
    with L hmassL hcost hL
  intro jStar E F hF
  have hL0 : 0 < L := zero_lt_one.trans_le hL
  let N := (candidateQIndices c L).card*r
  let err : ℝ := N*CM*C^(N-1)*L^(-(M : ℝ))
  have herr : 0 ≤ err := by dsimp [err]; positivity
  have hall : 0 ≤ (2 : ℝ)^N*err := mul_nonneg (by positivity) herr
  have hsingle (x : ∀ slot, candidateQSlotChoices c L r jStar slot) :
      ‖(candidateRangeAllocationMass c L r jStar x E : ℂ) -
        candidateBoxRangeAllocationMass c L r jStar x E L‖ ≤ (2 : ℝ)^N*err := by
    apply candidate_range_box_error c L r jStar x E L herr
    intro take hkeep
    exact htrunc _ (log E) _ _ _ take hkeep L hL
  have hcost' : (2 : ℝ)^N*err ≤ L^(-(D+B)) := by
    convert hcost using 1
    dsimp [N,err]
    ring
  have hbound := norm_fiber_coefficient_error_le (arithmeticProductWindow 1 (exp L))
    (fun u => (2*u+1).divisors) (candidateCoefficient c L q r jStar)
    (fun u => (candidateCompactRangeCoefficient c L q r jStar E u : ℂ))
    (candidateBoxRangeCoefficient c L q r jStar E L) F hall
    (fun u hu => candidate_coefficient_nonneg c L hq0 r jStar u)
    (fun u hu => candidate_box_coefficient_error c L hq0 r jStar E L u hsingle)
  calc
    _ ≤ ((2 : ℝ)^N*err)*(∑ u ∈ arithmeticProductWindow 1 (exp L),
        candidateCoefficient c L q r jStar u*∑ m ∈ (2*u+1).divisors, ‖F u m‖) := hbound
    _ ≤ L^(-(D+B))*(exp L*L^B) :=
      mul_le_mul hcost' (hmassL jStar F hF)
        (sum_nonneg (fun u hu => mul_nonneg (candidate_coefficient_nonneg c L hq0 r jStar u)
          (sum_nonneg (fun _ _ => norm_nonneg _)))) (rpow_nonneg hL0.le _)
    _ = exp L*L^(-D) := by
      rw [mul_left_comm, ← rpow_add hL0]
      congr 2
      ring

end Bounty
end

