open Finset Filter
open scoped Topology
theorem candidate_restricted_ordinary_mass_le {c L eps q : ℝ} {r jStar J : ℕ}
    (hcL : 0 ≤ c * L) (heps : eps ≤ 1/10) (hq : 0 ≤ q) (hJ : J < jStar) :
    candidateRestrictedOrdinaryMass c L eps q r jStar J ≤
      candidateOrdinaryWindowMass c L q r jStar := by
  apply sum_le_sum
  intro p _
  apply mul_le_mul_of_nonneg_left _ (candidate_P_weight_nonneg c L hq p)
  apply sum_le_sum
  intro n _
  exact ordered_slot_weight_mono _ _ (candidatePrefixChoices_subset hcL heps hJ) (by positivity) n

theorem candidate_localized_mass_le_ordinary {c L eps q : ℝ} {r jStar J : ℕ}
    (hr : 0 < r) (hcL : 0 ≤ c * L) (heps : eps ≤ 1/10) (hq : 0 ≤ q) (hJ : J < jStar) :
    candidateLocalizedWindowMass c L eps q r jStar J hr ≤
      candidateOrdinaryWindowMass c L q r jStar := by
  rw [← candidate_restricted_ordinary_eq_localized c L eps q r jStar J hr hJ]
  exact candidate_restricted_ordinary_mass_le hcL heps hq hJ

/- The small P-part and full Q candidate supply positive ordinary mass in
the exact wider interval (exp L, 16 exp L]. Constants and thresholds are
uniform in every later rough-slot index jStar > J. -/
theorem exists_candidate_ordinary_window_mass_lower {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1)
    (hcenter : (11/5 : ℝ) * (r : ℝ) * c = 1) :
    ∃ K : ℝ, 0 < K ∧ ∃ J : ℕ,
      ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, J < jStar →
        K * (Real.exp L / L) * candidateOneMarkedHarmonicMass c L q *
          candidateQHarmonicMass c L r jStar ≤
        candidateOrdinaryWindowMass c L q r jStar := by
  obtain ⟨eps, J, K, _, heps1, hK, hmass⟩ :=
    exists_candidate_localized_window_mass_lower hc hr hq0 hq1 hcenter
  refine ⟨K, hK, J, ?_⟩
  filter_upwards [hmass, eventually_ge_atTop (0 : ℝ)] with L hL hL0
  intro jStar hJ
  exact (hL jStar hJ).trans (candidate_localized_mass_le_ordinary hr
    (mul_nonneg hc.le hL0) heps1 hq0 hJ)
