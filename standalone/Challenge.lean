def fixedRayExpansion {ι : Type*} (p : ι → O) (F S : Finset ι) : ℂ :=
  letI importedWitness0 := @OAI.RayFourExpansion.rayCharacterFintype
  ∑ χ : RayCharacter, ∑ η : RayCharacter,
