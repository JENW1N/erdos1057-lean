theorem weighted_fiber_mass_le_of_atom_bound {X I : Type*} [Fintype X]
    (π : X → I) (n : I → ℕ) (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x)
    {C P : ℝ} (hC : 0 ≤ C) (hP : 0 < P)
    (hlower : ∀ x, P ≤ (n (π x) : ℝ))
    (hatom : ∀ m : ℕ,
      (∑ x ∈ Finset.univ.filter (fun x => n (π x) = m), μ x) ≤ C / (m : ℝ))
    (i : I) :
    (∑ x ∈ Finset.univ.filter (fun x => π x = i), μ x) ≤ C / P := by
  classical
  by_cases hi : ∃ x, π x = i
  · obtain ⟨x, hx⟩ := hi
    have hPi : P ≤ (n i : ℝ) := by simpa only [hx] using hlower x
    have hs : Finset.univ.filter (fun x => π x = i) ⊆
        Finset.univ.filter (fun x => n (π x) = n i) := by
      intro y hy
      obtain ⟨hyU, hyi⟩ := Finset.mem_filter.mp hy
      exact Finset.mem_filter.mpr ⟨hyU, congrArg n hyi⟩
    calc
      _ ≤ ∑ x ∈ Finset.univ.filter (fun x => n (π x) = n i), μ x :=
        Finset.sum_le_sum_of_subset_of_nonneg hs (fun x _ _ => hμ x)
      _ ≤ C / (n i : ℝ) := hatom (n i)
      _ ≤ C / P := div_le_div_of_nonneg_left hC hP hPi
  · have he : Finset.univ.filter (fun x => π x = i) = ∅ := by
      apply Finset.filter_eq_empty_iff.mpr
      intro x hx hxi
      exact hi ⟨x, hxi⟩
    rw [he, Finset.sum_empty]
    exact div_nonneg hC hP.le

theorem weighted_fiber_energy_le_of_atom_bound {X I : Type*} [Fintype X]
    (values : Finset I) (π : X → I) (n : I → ℕ)
    (μ : X → ℝ) (hμ : ∀ x, 0 ≤ μ x) (f : X → ℂ)
    {C P : ℝ} (hC : 0 ≤ C) (hP : 0 < P)
    (hlower : ∀ x, P ≤ (n (π x) : ℝ))
    (hatom : ∀ m : ℕ,
      (∑ x ∈ Finset.univ.filter (fun x => n (π x) = m), μ x) ≤ C / (m : ℝ)) :
    (∑ i ∈ values,
      ‖∑ x ∈ Finset.univ.filter (fun x => π x = i), (μ x : ℂ) * f x‖ ^ 2) ≤
      (C / P) * ∑ x, μ x * ‖f x‖ ^ 2 :=
  finite_weighted_fiber_energy_le values π μ hμ f (div_nonneg hC hP.le)
    (fun i _ => weighted_fiber_mass_le_of_atom_bound π n μ hμ hC hP hlower hatom i)
end

