def infinityCoefficientScalar : ℂ := star (sourceResidualFourierCoefficient 1)

theorem infinityCoefficient_squarefree (I:Ideal _root_.OAI.ActualEisensteinCubic.O) (hI:primaryGenerator I≠0)
    (hsq:Squarefree I) :
