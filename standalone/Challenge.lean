open Finset
theorem exists_rough_sieve_divisor_weights :
    ∃ K : ℝ, 0 < K ∧ ∀ (P : Finset ℕ) {z : ℝ}, 1 < z →
      (∀ p ∈ P, p.Prime) → (∀ p ∈ P, (p : ℝ) ≤ z) →
      ∀ h : ℕ, 1 ≤ h → Even h → ∃ lam : ℕ → ℝ,
        (∀ d, |lam d| ≤ 1) ∧
        (∀ d, lam d ≠ 0 → 0 < d ∧ (d : ℝ) ≤ z^(4 * (h : ℝ) + 2) ∧
          Squarefree d ∧ d ∣ ∏ p ∈ P, p) ∧
        (∀ n : ℕ, n ≠ 0 → 0 ≤ ∑ d ∈ n.divisors, lam d ∧
          (if ∀ p ∈ P, ¬p ∣ n then (1 : ℝ) else 0) ≤ ∑ d ∈ n.divisors, lam d) ∧
        (∑ d ∈ blockSieveModuli P (z^(4 * (h : ℝ) + 2)), |lam d| / (d : ℝ)) ≤
          ∏ p ∈ P, (1 + 1 / (p : ℝ)) ∧
        ∀ a b : ℕ, a ≤ b →
          let M := (∑ n ∈ Ioc a b, ∑ d ∈ n.divisors, lam d) -
            (((Ioc a b).filter (fun n => ∀ p ∈ P, ¬p ∣ n)).card : ℝ)
          0 ≤ M ∧ M ≤ ((b : ℝ) - a) * K * Real.exp (-(h : ℝ)) + z^(4 * (h : ℝ) + 2) := by
  obtain ⟨K, hK, hblocks⟩ := exists_rough_interval_sieve_blocks
  refine ⟨K, hK, ?_⟩
  intro P z hz hP hPz h hh heven
  obtain ⟨J, B, hunion, hdisj, hsize, hcontrol⟩ := hblocks P hz hP hPz
  let cap := fun j => (j + 1) * h
  let a := blockSieveSubsetUpperCoefficient J B cap
  let D := z^(4 * (h : ℝ) + 2)
  let lam := natSieveCoefficient P D a
  have ha : ∀ S ∈ P.powerset, |a S| ≤ 1 :=
    fun S _ => abs_block_sieve_subset_upper_coefficient_le_one J B cap S
  have hlevel : ∀ S ∈ P.powerset, a S ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D := by
    intro S _ hS
    have hprime : ∀ j ∈ J, ∀ p ∈ B j, p.Prime := by
      intro j hj p hp
      apply hP p
      rw [← hunion]
      exact mem_biUnion.mpr ⟨j, hj, hp⟩
    simpa only [Nat.cast_prod] using
      (block_sieve_upper_coefficient_level J B S h hz.le hdisj hprime hsize hS).2
  have heq (n : ℕ) (hn : n ≠ 0) : roughBlockUpper J B h n = ∑ d ∈ n.divisors, lam d := by
    have hexp := block_sieve_upper_expansion J B (fun p => if p ∣ n then (1 : ℝ) else 0) cap hdisj
    rw [hunion] at hexp
    exact hexp.trans (nat_sieve_polynomial_eq_sum_divisors P D a hP hlevel hn)
  have hpoint := (hcontrol h hh heven).1
  have hover := (hcontrol h hh heven).2
  refine ⟨lam, fun d => nat_sieve_coefficient_abs_le_one P D a hP ha d,
    fun d hd => nat_sieve_coefficient_support P D a hP hd, ?_,
    nat_sieve_coefficient_harmonic_bound P D a hP ha hlevel, ?_⟩
  · intro n hn
    simpa only [heq n hn] using hpoint n
  · intro a b hab
    have hsum : (∑ n ∈ Ioc a b, roughBlockUpper J B h n) =
        ∑ n ∈ Ioc a b, ∑ d ∈ n.divisors, lam d := by
      apply sum_congr rfl
      intro n hn
      exact heq n (Nat.ne_of_gt (lt_of_le_of_lt (Nat.zero_le a) (mem_Ioc.mp hn).1))
    have hm := hover a b hab
    dsimp only at hm ⊢
    rwa [hsum] at hm
end

