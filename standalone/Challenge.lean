open Filter Finset
open scoped Topology
noncomputable def candidatePHarmonicMass (s L : ℝ) : ℝ :=
  ∑ j ∈ candidatePIndices s L, ∑ p ∈ candidatePBand (s * L) j, 1 / (p : ℝ)

noncomputable def candidateOneMarkedHarmonicMass (s L q : ℝ) : ℝ :=
  ∑' n : Nat.factoredNumbers ((candidatePIndices s L).biUnion (candidatePBand (s * L))),
    oneMarkedGroupTerm (candidatePIndices s L) (candidatePBand (s * L)) q
      (fun j => ∑ p ∈ candidatePBand (s * L) j, 1 / (p : ℝ)) n.val

theorem candidate_P_harmonic_mass_nonneg (s L : ℝ) : 0 ≤ candidatePHarmonicMass s L := by
  exact sum_nonneg (fun _ _ => sum_nonneg (fun _ _ => by positivity))

theorem eventually_candidate_one_marked_mass_lower {s q : ℝ}
    (hs : 0 < s) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) :
    ∀ᶠ L : ℝ in atTop,
      Real.exp (q * candidatePHarmonicMass s L) ≤ candidateOneMarkedHarmonicMass s L q := by
  obtain ⟨v, V, hv, _, hpool⟩ := exists_candidate_P_pool_bounds hs
  filter_upwards [hpool] with L hp
  rcases hp with ⟨_, _, _, _, hpair, hdata⟩
  apply one_marked_groups_harmonic_lower (candidatePIndices s L) (candidatePBand (s * L))
    (fun i _ j _ hij => hpair hij) (fun j hj p hp => ((hdata j hj).2.2 p hp).1)
    hq0 hq1
  · exact fun j hj => hv.trans_le (hdata j hj).1
  · exact fun _ _ => rfl

theorem eventually_candidate_one_marked_mass_ge_one {s q : ℝ}
    (hs : 0 < s) (hq0 : 0 ≤ q) (hq1 : q ≤ 1) :
    ∀ᶠ L : ℝ in atTop, 1 ≤ candidateOneMarkedHarmonicMass s L q := by
  filter_upwards [eventually_candidate_one_marked_mass_lower hs hq0 hq1] with L h
  exact (Real.one_le_exp (mul_nonneg hq0 (candidate_P_harmonic_mass_nonneg s L))).trans h









end

