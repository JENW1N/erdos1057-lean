variable
  {ι : Type*}
  (S : Finset ι)
  (t : ι → ℤ)
  (hinj : Set.InjOn t S)
  (A : ℤ)
  (V N : ℕ)
  (ht : ∀ i ∈ S, A ≤ t i ∧ t i ≤ A + (V : ℤ))

include ι S t hinj A V N ht

theorem integer_interval_trivial_circle_row  (θ : ι → ℝ) :
    (∑ i ∈ S, circleGeometricBound N (θ i)) ≤ ((V : ℝ) + 1) * N := by
  calc
    _ ≤ ∑ _i ∈ S, (N : ℝ) :=
      Finset.sum_le_sum (fun i hi => circle_geometric_bound_le_length N (θ i))
    _ = (S.card : ℝ) * N := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (by exact_mod_cast integer_interval_injOn_card_le S t hinj A V ht) (by positivity)

/- Positive moduli, including modulus one by the finite interval count. -/
theorem rational_phase_interval_row_sum_le_of_pos 
    {u : ℤ} {r : ℕ} (hr : 0 < r) (hcop : (r : ℤ).gcd u = 1)
    {β : ℝ} (hβ : |β| ≤ 1 / (r : ℝ) ^ 2) (base : ℝ) :
    (∑ i ∈ S, circleGeometricBound N (((u : ℝ) / r + β) * t i - base)) ≤
      (1 + 3 * (V : ℝ) / r) *
        (2 * (N : ℝ) + 2 * (r : ℝ) * (1 + Real.log r)) := by
  by_cases hr1 : r = 1
  · subst r
    have hb := integer_interval_trivial_circle_row S t hinj A V N ht
      (fun i => ((u : ℝ) / 1 + β) * t i - base)
    simp only [Nat.cast_one, div_one, Real.log_one] at hb ⊢
    have hprod : 0 ≤ (V : ℝ) * (N : ℝ) := by positivity
    nlinarith
  · exact rational_phase_interval_row_sum_le S t hinj A V N ht (by omega) hcop hβ base

