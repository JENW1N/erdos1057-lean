    Tendsto (fun s : ℂ => (s-4/3)•kernelLocalCorrectedSeed S hS a b ha hab s)
      (𝓝[≠] (4/3:ℂ))
      (𝓝 (kernelMassRestrictionCLM S hS.measurableSet (kernelEisensteinResidueVector a b ha hab))) :=
  letI rootPolicy_hyperbolicMeasurableSpace := @OAI.CubicEisenstein.hyperbolicMeasurableSpace
  letI rootPolicy_complexSLTopology := @OAI.CubicEisenstein.complexSLTopology
  fun (S : Set KernelQuotient) (hS : IsCompact S)
