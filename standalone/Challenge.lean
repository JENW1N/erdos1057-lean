open Finset Filter
open scoped Topology
theorem candidate_coefficient_full_convolution_of_free (c L q : ℝ) (r jStar : ℕ)
    (hfree : ∀ n, candidateQWeight c L r jStar n ≠ 0 →
      n ≠ 0 ∧ Disjoint n.primeFactors
        ((candidatePIndices c L).biUnion (candidatePBand (c * L)))) :
    candidateCoefficientWindowMass c L q r jStar =
      ∑ p ∈ candidateSmallPSet c L (16 * Real.exp L + 1),
        candidatePWeight c L q p *
          ∑ n ∈ arithmeticProductWindow p (Real.exp L), candidateQWeight c L r jStar n := by
  symm
  apply supported_free_window_convolution_eq
    ((candidatePIndices c L).biUnion (candidatePBand (c * L)))
    (candidateSmallPSet c L (16 * Real.exp L + 1))
    (candidatePWeight c L q) (candidateQWeight c L r jStar)
    (candidateCoefficient c L q r jStar) (Real.exp L)
  · intro p hp
    exact ((mem_candidateSmallPSet_iff c L _ p).mp hp).2
  · exact hfree
  · intro p hp n hn
    exact candidate_coefficient_mul_of_free c L q r jStar
      ((mem_candidateSmallPSet_iff c L _ p).mp hp).2 (hfree n hn).1 (hfree n hn).2
  · intro u hu hWu
    let P := (candidatePIndices c L).biUnion (candidatePBand (c * L))
    let p := primePoolPart P u
    let n := primePoolFreePart P u
    have hurange : Real.exp L < (u : ℝ) ∧ (u : ℝ) ≤ 16 * Real.exp L := by
      simpa only [one_mul] using
        (mem_arithmeticProductWindow_iff one_ne_zero (Real.exp L)).mp hu
    have hu0 : u ≠ 0 := by
      have hpos : (0 : ℝ) < u := (Real.exp_pos L).trans hurange.1
      exact_mod_cast ne_of_gt hpos
    have hpu : p ≤ u := Nat.le_of_dvd (Nat.pos_of_ne_zero hu0) (primePoolPart_dvd P u)
    have hpSupport : p ∈ Nat.factoredNumbers P := primePoolPart_mem_factoredNumbers P u
    have hpn : p * n = u := primePoolPart_mul_primePoolFreePart P u
    have hp : p ∈ candidateSmallPSet c L (16 * Real.exp L + 1) := by
      apply (mem_candidateSmallPSet_iff c L _ p).mpr
      refine ⟨?_, hpSupport⟩
      have hpuR : (p : ℝ) ≤ u := Nat.cast_le.mpr hpu
      linarith [hurange.2]
    have hn : n ∈ arithmeticProductWindow p (Real.exp L) := by
      apply (mem_arithmeticProductWindow_iff (primePoolPart_ne_zero P u) (Real.exp L)).mpr
      change Real.exp L < (p * n : ℕ) ∧ (p * n : ℕ) ≤ 16 * Real.exp L
      simpa only [hpn] using hurange
    exact ⟨p, hp, n, hn, left_ne_zero_of_mul hWu, hpn⟩

/- The eventual threshold is uniform over the damping parameter, the number
of slots, and the distinguished rough-slot index. -/
theorem eventually_candidate_coefficient_full_convolution {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ),
      candidateCoefficientWindowMass c L q r jStar =
        ∑ p ∈ candidateSmallPSet c L (16 * Real.exp L + 1),
          candidatePWeight c L q p *
            ∑ n ∈ arithmeticProductWindow p (Real.exp L), candidateQWeight c L r jStar n := by
  filter_upwards [eventually_candidate_P_pool_below_rough_cutoff hc,
    eventually_ge_atTop (0 : ℝ)] with L hpool hL
  intro q r jStar
  apply candidate_coefficient_full_convolution_of_free
  intro n hn
  obtain ⟨x, hx⟩ := ordered_slot_weight_ne_zero_support _ _ hn
  refine ⟨?_, ?_⟩
  · rw [← hx]
    exact prod_ne_zero_iff.mpr
      (fun slot _ => candidate_Q_slot_nonzero c L r jStar slot (x slot).property)
  · rw [← hx]
    exact candidate_Q_tuple_primeFactors_disjoint (mul_nonneg hc.le hL) hpool x
end

