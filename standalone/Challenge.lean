section

/- The existing chronological forest bound with separate root and atom costs at every address. -/

open Finset Classical

namespace Bounty

theorem birthForestCausalMass_le_coordinate_costs {n : ℕ} {α : Type*} [Fintype α]
    (code : BirthForestCode n) (w : BirthForestCausalWeights n α)
    (M ε : Fin n → ℝ) (hM : ∀ i, 0 ≤ M i) (hε : ∀ i, 0 ≤ ε i)
    (hw : ∀ i h a, 0 ≤ w i h a)
    (hsum : ∀ i h, ∑ a, w i h a ≤ M i) (hatom : ∀ i h a, w i h a ≤ ε i) :
    birthForestCausalMass code w ≤ ∏ i, match code i with | none => M i | some _ => ε i := by
  induction n with
  | zero => simp [birthForestCausalMass, birthForestCausalAssignmentMass, birthForestAssignmentMass]
  | succ n ih =>
    have hprev := ih (birthForestCodeInit code) (fun i => w i.castSucc)
      (fun i => M i.castSucc) (fun i => ε i.castSucc) (fun i => hM i.castSucc)
      (fun i => hε i.castSucc) (fun i h a => hw i.castSucc h a)
      (fun i h => hsum i.castSucc h) (fun i h a => hatom i.castSucc h a)
    rw [birthForestCausalMass_last, Fin.prod_univ_castSucc]
    cases hc : code (Fin.last n) with
    | none =>
      calc
        _ ≤ ∑ f : Fin n → α,
            birthForestCausalAssignmentMass (birthForestCodeInit code) (fun i => w i.castSucc) f * M (Fin.last n) := by
          apply sum_le_sum
          intro f _
          exact mul_le_mul_of_nonneg_left (hsum _ _)
            (birthForestCausalAssignmentMass_nonneg _ _ (fun i h a => hw i.castSucc h a) f)
        _ = birthForestCausalMass (birthForestCodeInit code) (fun i => w i.castSucc) * M (Fin.last n) :=
          (sum_mul _ _ _).symm
        _ ≤ _ := by
          apply le_trans (mul_le_mul_of_nonneg_right hprev (hM (Fin.last n)))
          apply le_of_eq
          congr 1
          apply prod_congr rfl
          intro i _
          unfold birthForestCodeInit
          cases code i.castSucc <;> rfl
    | some p =>
      calc
        _ ≤ ∑ f : Fin n → α,
            birthForestCausalAssignmentMass (birthForestCodeInit code) (fun i => w i.castSucc) f * ε (Fin.last n) := by
          apply sum_le_sum
          intro f _
          exact mul_le_mul_of_nonneg_left (hatom _ _ _)
            (birthForestCausalAssignmentMass_nonneg _ _ (fun i h a => hw i.castSucc h a) f)
        _ = birthForestCausalMass (birthForestCodeInit code) (fun i => w i.castSucc) * ε (Fin.last n) :=
          (sum_mul _ _ _).symm
        _ ≤ _ := by
          apply le_trans (mul_le_mul_of_nonneg_right hprev (hε (Fin.last n)))
          apply le_of_eq
          congr 1
          apply prod_congr rfl
          intro i _
          unfold birthForestCodeInit
          cases code i.castSucc <;> rfl

end Bounty
end

section

/- External finite coordinates may be permuted separately on each retained
parameter and auxiliary fiber. The auxiliary average is taken after the
permutation, so no number-of-residues loss is incurred. -/

open Finset
open scoped Classical

namespace Bounty

noncomputable def finiteExternalFiberAverage {C R Y : Type*} {A : C → Type*}
    [∀ c, Fintype (A c)] (ω : ∀ c, A c → ℝ)
    (T : ∀ c, A c → (Y → ℂ) → Y → ℂ) (τ : ∀ c, A c → R ≃ R)
    (f : C → Y → R → ℂ) (c : C) (y : Y) (r : R) : ℂ :=
  ∑ a, (ω c a : ℂ) * T c a (fun z => f c z (τ c a r)) y

theorem finite_external_fiber_average_energy_le {C R Y : Type*}
    [Fintype R] [Fintype Y] {A : C → Type*} [∀ c, Fintype (A c)]
    (μ : Y → ℝ) (hμ : ∀ y, 0 ≤ μ y)
    (ω : ∀ c, A c → ℝ) (hω : ∀ c a, 0 ≤ ω c a)
    (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    (T : ∀ c, A c → (Y → ℂ) → Y → ℂ) (τ : ∀ c, A c → R ≃ R)
    (f : C → Y → R → ℂ) {L : ℝ} (hL : 0 ≤ L)
    (hT : ∀ c a r, finiteWeightedEnergy μ (T c a (fun z => f c z r)) ≤
      L * finiteWeightedEnergy μ (fun z => f c z r)) (c : C) :
    (∑ r, finiteWeightedEnergy μ (fun y => finiteExternalFiberAverage ω T τ f c y r)) ≤
      L * ∑ r, finiteWeightedEnergy μ (fun y => f c y r) := by
  calc
    _ ≤ ∑ r, ∑ a, ω c a * finiteWeightedEnergy μ
        (T c a (fun z => f c z (τ c a r))) := by
      apply sum_le_sum
      intro r _
      exact finite_subprobability_average_energy_le (ω c) μ (hω c) (hωmass c) hμ _
    _ ≤ ∑ r, ∑ a, ω c a * (L * finiteWeightedEnergy μ (fun z => f c z (τ c a r))) := by
      apply sum_le_sum
      intro r _
      exact sum_le_sum fun a _ => mul_le_mul_of_nonneg_left (hT c a (τ c a r)) (hω c a)
    _ = (∑ a, ω c a) * (L * ∑ r, finiteWeightedEnergy μ (fun y => f c y r)) := by
      rw [sum_comm]
      simp only [← mul_sum]
      rw [sum_mul]
      apply sum_congr rfl
      intro a _
      rw [Equiv.sum_comp (τ c a) (fun r => finiteWeightedEnergy μ (fun z => f c z r))]
    _ ≤ 1 * (L * ∑ r, finiteWeightedEnergy μ (fun y => f c y r)) := by
      apply mul_le_mul_of_nonneg_right (hωmass c)
      exact mul_nonneg hL (sum_nonneg fun r _ =>
        sum_nonneg fun y _ => mul_nonneg (hμ y) (sq_nonneg _))
    _ = _ := one_mul _

noncomputable def equivExternalFiberAverage {X C Y R : Type*} {A : C → Type*}
    [∀ c, Fintype (A c)] (e : X ≃ C × Y) (ω : ∀ c, A c → ℝ)
    (T : ∀ c, A c → (Y → ℂ) → Y → ℂ) (τ : ∀ c, A c → R ≃ R)
    (f : X → R → ℂ) (x : X) (r : R) : ℂ :=
  finiteExternalFiberAverage ω T τ (fun c y r => f (e.symm (c, y)) r) (e x).1 (e x).2 r

theorem equiv_external_fiber_average_energy_le {X C Y R : Type*}
    [Fintype X] [Fintype C] [Fintype Y] [Fintype R]
    {A : C → Type*} [∀ c, Fintype (A c)]
    (e : X ≃ C × Y) (W : X → ℝ) (κ : C → ℝ) (μ : Y → ℝ)
    (hW : ∀ c y, W (e.symm (c, y)) = κ c * μ y)
    (hκ : ∀ c, 0 ≤ κ c) (hμ : ∀ y, 0 ≤ μ y)
    (ω : ∀ c, A c → ℝ) (hω : ∀ c a, 0 ≤ ω c a)
    (hωmass : ∀ c, ∑ a, ω c a ≤ 1)
    (T : ∀ c, A c → (Y → ℂ) → Y → ℂ) (τ : ∀ c, A c → R ≃ R)
    (f : X → R → ℂ) {L : ℝ} (hL : 0 ≤ L)
    (hT : ∀ c a r, finiteWeightedEnergy μ (T c a (fun y => f (e.symm (c, y)) r)) ≤
      L * finiteWeightedEnergy μ (fun y => f (e.symm (c, y)) r)) :
    (∑ r, finiteWeightedEnergy W (fun x => equivExternalFiberAverage e ω T τ f x r)) ≤
      L * ∑ r, finiteWeightedEnergy W (fun x => f x r) := by
  simp_rw [finite_energy_equiv_fibers e W κ μ hW]
  unfold finiteFiberEnergy equivFiberSlice
  dsimp only [equivExternalFiberAverage]
  simp only [Equiv.apply_symm_apply]
  rw [sum_comm, sum_comm (f := fun r c => κ c * finiteWeightedEnergy μ (fun y => f (e.symm (c,y)) r))]
  simp only [← mul_sum]
  rw [mul_sum]
  apply sum_le_sum
  intro c _
  calc
    _ ≤ κ c * (L * ∑ r, finiteWeightedEnergy μ (fun y => f (e.symm (c,y)) r)) :=
      mul_le_mul_of_nonneg_left
        (finite_external_fiber_average_energy_le μ hμ ω hω hωmass T τ _ hL hT c) (hκ c)
    _ = _ := by ring

end Bounty
end

