noncomputable def cleanSignedPatternBlock {I J : Type*} [DecidableEq I] [DecidableEq J] (U : Finset I) (V : Finset J)
    (r : Finset I → Finset J → ℂ) (q : Finset I → Finset J → Finset I → Finset J → ℂ) : ℂ :=
  (∑ S ∈ U.powerset, ∑ T ∈ V.powerset, r S T) -
    ∑ A ∈ cleanNonemptySubsets U, ∑ B ∈ cleanNonemptySubsets V,
      (-1 : ℂ) ^ (A.card + B.card) * (∑ S ∈ U.powerset, ∑ T ∈ V.powerset, q S T A B)

theorem clean_comparison_sum_restrict {I J : Type*} [DecidableEq I] [DecidableEq J] (U : Finset I) (V : Finset J)
    (q : Finset I → Finset J → ℂ) (S : Finset I) (T : Finset J)
    (hzero : ∀ A ∈ cleanNonemptySubsets U, ∀ B ∈ cleanNonemptySubsets V,
      ¬(A ⊆ U \ S ∧ B ⊆ V \ T) → q A B = 0) :
    (∑ A ∈ cleanNonemptySubsets U, ∑ B ∈ cleanNonemptySubsets V,
      (-1 : ℂ) ^ (A.card + B.card) * q A B) =
    ∑ A ∈ cleanNonemptySubsets (U \ S), ∑ B ∈ cleanNonemptySubsets (V \ T),
      (-1 : ℂ) ^ (A.card + B.card) * q A B := by
  have hA := clean_nonempty_subsets_mono (sdiff_subset (s := U) (t := S))
  have hB := clean_nonempty_subsets_mono (sdiff_subset (s := V) (t := T))
  calc
    _ = ∑ A ∈ cleanNonemptySubsets (U \ S), ∑ B ∈ cleanNonemptySubsets V,
        (-1 : ℂ) ^ (A.card + B.card) * q A B := by
      symm
      apply sum_subset hA
      intro A ha hn
      apply sum_eq_zero
      intro B hb
      rw [hzero A ha B hb, mul_zero]
      intro h
      exact hn ((clean_mem_nonempty_subsets _ _).mpr
        ⟨((clean_mem_nonempty_subsets _ _).mp ha).1, h.1⟩)
    _ = _ := by
      apply sum_congr rfl
      intro A ha
      symm
      apply sum_subset hB
      intro B hb hn
      rw [hzero A (hA ha) B hb, mul_zero]
      intro h
      exact hn ((clean_mem_nonempty_subsets _ _).mpr
        ⟨((clean_mem_nonempty_subsets _ _).mp hb).1, h.2⟩)

theorem clean_pattern_component_sum_comm {I J : Type*} [DecidableEq I] [DecidableEq J] (U : Finset I) (V : Finset J)
    (q : Finset I → Finset J → Finset I → Finset J → ℂ) :
    (∑ A ∈ cleanNonemptySubsets U, ∑ B ∈ cleanNonemptySubsets V,
      ∑ S ∈ U.powerset, ∑ T ∈ V.powerset, (-1 : ℂ) ^ (A.card + B.card) * q S T A B) =
    ∑ S ∈ U.powerset, ∑ T ∈ V.powerset,
      ∑ A ∈ cleanNonemptySubsets U, ∑ B ∈ cleanNonemptySubsets V,
        (-1 : ℂ) ^ (A.card + B.card) * q S T A B := by
  calc
    _ = ∑ A ∈ cleanNonemptySubsets U, ∑ S ∈ U.powerset,
        ∑ B ∈ cleanNonemptySubsets V, ∑ T ∈ V.powerset,
          (-1 : ℂ) ^ (A.card + B.card) * q S T A B := by
      apply sum_congr rfl; intro A _; exact sum_comm
    _ = ∑ S ∈ U.powerset, ∑ A ∈ cleanNonemptySubsets U,
        ∑ B ∈ cleanNonemptySubsets V, ∑ T ∈ V.powerset,
          (-1 : ℂ) ^ (A.card + B.card) * q S T A B := sum_comm
    _ = _ := by
      apply sum_congr rfl
      intro S _
      calc
        _ = ∑ A ∈ cleanNonemptySubsets U, ∑ T ∈ V.powerset,
            ∑ B ∈ cleanNonemptySubsets V, (-1 : ℂ) ^ (A.card + B.card) * q S T A B := by
          apply sum_congr rfl; intro A _; exact sum_comm
        _ = _ := sum_comm

