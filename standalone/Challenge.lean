/- The original fixed-small-plan memory product is exactly the selected big
memory product, retaining the full Fourier coefficient and all zero rows. -/

open Finset
open scoped Classical
namespace Bounty

theorem physical_root_plan_memory_product
    {I : Type} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
    (groups : Finset (Fin N)) (patterns : Finset I)
    (C : I → Fin N → Finset (Fin J))
    (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
    (V : Fin N → ℝ) (ζ : ℕ → I → ℝ) (k : ℕ → I → ℤ)
    (K : ∀ (_ : ℕ) i, PhysicalMarkLists P J ell → PhysicalMarkLists P J ell →
      PhysicalAuxLabels P (C i) → ℂ) (θ : ℝ)
    (p : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns)
    (db : PhysicalRootSmallPlanBigData groups patterns C hC p) :
    let old := physicalRootSmallPlanPath groups patterns C hC p db
    (∏ j ∈ range (n + 1), physicalMemoryLabeledScalar (fun g : {g // g ∉ groupsᶜ} => V g.val)
      patterns (fun i g => C i g.val) (fun _ => 0)
      (physicalFixedEdgeBigCoefficient (fun g => g ∈ groupsᶜ) patterns C
        (ζ ((n + 1) - 1 - j)) (physicalLocalFourierCoefficient C k K θ ((n + 1) - 1 - j))
        (finitePathLabels old.2 j) (finitePathMarks old.1 old.2 j)
        (finitePathMarks old.1 old.2 (j + 1)))
      (physicalRestrictedEdge (fun g => g ∉ groupsᶜ) patterns C (finitePathLabels old.2 j))
      (fun g => finitePathMarks old.1 old.2 j g.val)
      (fun g => finitePathMarks old.1 old.2 (j + 1) g.val)) =
    physicalSelectedMemoryProduct
      (fun j (g : {g // g ∉ groupsᶜ}) => C (physicalRootSmallPlanPattern groups patterns C hC p j).val g.val)
      (fun g : {g // g ∉ groupsᶜ} => V g.val) (fun _ => 0)
      (physicalRootPlanBigCoefficient groups patterns C hC ζ k K θ p) db := by
  dsimp only
  rw [← Fin.prod_univ_eq_prod_range, physicalSelectedMemoryProduct]
  apply prod_congr rfl
  intro j _
  have hs := physical_root_path_mark_coordinate groups patterns C hC p db j.castSucc
  have ht := physical_root_path_mark_coordinate groups patterns C hC p db j.succ
  dsimp only [Fin.val_castSucc, Fin.val_succ] at hs ht
  rw [hs, ht, physical_root_path_edge_coordinate]
  simp only [physical_phase_zero_frequency, mul_one, Nat.add_sub_cancel]
  have h := physical_selected_split_memory_labeled (fun g => g ∈ groupsᶜ) patterns C
      (physicalRootSmallPlanPattern groups patterns C hC p)
      (physicalRootSmallPlanSmallData groups patterns C hC p) db V (ζ (n - j.val))
      (physicalLocalFourierCoefficient C k K θ (n - j.val)) j
  simp only [physicalRootPlanBigCoefficient, ← Nat.card_eq_fintype_card] at h ⊢
  convert h using 1
  · exact physical_memory_labeled_scalar_instances _ _ _ _ _ _ _ _ _ _ _ _
  · congr 1
    split_ifs
    · congr 2
      exact physical_aux_mass_instances _ _ _ _ _
    · rfl

end Bounty
end

section

/- The small coordinates of the original reconstructed path are exactly
those of the fixed selected small plan. -/

open scoped Classical
namespace Bounty
section Coordinates
variable {I : Type} {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (groups : Finset (Fin N)) (patterns : Finset I)
  (C : I → Fin N → Finset (Fin J))
  (hC : ∀ i : patterns, ∀ g : ↥groupsᶜ, C i.val g.val = ∅)
  (p : PhysicalRootSmallPlan (P := P) (J := J) (ell := ell) (n := n) groups patterns)
  (db : PhysicalRootSmallPlanBigData groups patterns C hC p)

theorem physical_root_path_small_marks (j : Fin (n + 2)) :
    let old := physicalRootSmallPlanPath groups patterns C hC p db
    (fun g : ↥groupsᶜ => finitePathMarks old.1 old.2 j.val g.val) =
      (physicalRootSmallPlanSmallData groups patterns C hC p).2.1 j := by
  dsimp only
  rw [physical_root_path_mark_coordinate]
  exact congrArg (fun d => d.1.2.1 j)
    ((physicalGroupSelectedSplit (fun g => g ∈ groupsᶜ)
      (fun j => C (physicalRootSmallPlanPattern groups patterns C hC p j).val)).apply_symm_apply
      (physicalRootSmallPlanSmallData groups patterns C hC p, db))

theorem physical_root_path_small_edge (j : Fin (n + 1)) :
    let old := physicalRootSmallPlanPath groups patterns C hC p db
    let ds := physicalRootSmallPlanSmallData groups patterns C hC p
    physicalRestrictedEdge (fun g => g ∈ groupsᶜ) patterns C (old.2 j).1 =
      (ds.2.2.1 j, ds.2.2.2 j, ⟨physicalRootSmallPlanPattern groups patterns C hC p j, ds.1 j⟩) := by
  dsimp only
  have he := physical_root_path_edge_coordinate groups patterns C hC p db j
  simp only [finitePathLabels, dif_pos j.isLt] at he
  rw [he]
  let ds := physicalRootSmallPlanSmallData groups patterns C hC p
  let d := (physicalGroupSelectedSplit (fun g => g ∈ groupsᶜ)
    (fun j => C (physicalRootSmallPlanPattern groups patterns C hC p j).val)).symm (ds, db)
  have hs := congrArg Prod.fst
    ((physicalGroupSelectedSplit (fun g => g ∈ groupsᶜ)
      (fun j => C (physicalRootSmallPlanPattern groups patterns C hC p j).val)).apply_symm_apply (ds, db))
  have hσ : (fun g : ↥groupsᶜ => d.2.2.1 j g.val) = ds.2.2.1 j :=
    congrArg (fun d => d.2.2.1 j) hs
  have hτ : (fun g : ↥groupsᶜ => d.2.2.2 j g.val) = ds.2.2.2 j :=
    congrArg (fun d => d.2.2.2 j) hs
  have ha : (fun g : ↥groupsᶜ => d.1 j g.val) = ds.1 j := congrArg (fun d => d.1 j) hs
  change (((fun g : ↥groupsᶜ => d.2.2.1 j g.val), (fun g : ↥groupsᶜ => d.2.2.2 j g.val),
    ⟨physicalRootSmallPlanPattern groups patterns C hC p j, (fun g : ↥groupsᶜ => d.1 j g.val)⟩) :
    PhysicalEdgeLabels (fun g : ↥groupsᶜ => P g.val) J ell patterns (fun i g => C i g.val)) = _
  rw [hσ, hτ, ha]

end Coordinates
end Bounty
