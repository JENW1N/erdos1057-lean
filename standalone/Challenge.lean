/- The fresh unpromoted edge draws are exactly its local performed birth labels. -/

open scoped Classical
namespace Bounty
section Full
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ)
  (k : K) (H : (g : Fin N) → Finset (P g))
  (s : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (e : FullPermutationMixedEvent (J := J) n S B A Δ D (some (.inr k)) s)

theorem full_mixed_edge_birth_avoids_iff :
    FullMixedLocalBirthAvoids n S B A Δ D H (some (.inr k)) s e ↔
      ∀ g i, (e.2 g).2.2.2 i ∉ H g := by
  constructor
  · intro h g i
    exact h ⟨g, i.val⟩ ⟨g, (e.2 g).2.2.2 i⟩
      (full_mixed_edge_local_label n S B A Δ D k s e g i.val i.property)
  · rintro h ⟨g, i⟩ z hz
    obtain ⟨hi, rfl⟩ := full_mixed_edge_local_label_some n S B A Δ D k s e g i z hz
    exact h g ⟨i, hi⟩

theorem full_mixed_edge_birth_distinct_iff :
    FullMixedLocalBirthDistinct n S B A Δ D (some (.inr k)) s e ↔
      ∀ g, Function.Injective (e.2 g).2.2.2 := by
  constructor
  · intro h g i l hil
    have hi := full_mixed_edge_local_label n S B A Δ D k s e g i.val i.property
    have hl := full_mixed_edge_local_label n S B A Δ D k s e g l.val l.property
    have he := h ⟨g, i.val⟩ ⟨g, l.val⟩ ⟨g, (e.2 g).2.2.2 i⟩ hi (by simpa only [hil] using hl)
    exact Subtype.ext (Fin.ext (congrArg (fun c => c.2.val) he))
  · rintro h ⟨g, i⟩ ⟨l, m⟩ z hi hm
    obtain ⟨hi', rfl⟩ := full_mixed_edge_local_label_some n S B A Δ D k s e g i z hi
    obtain ⟨hm', hz⟩ := full_mixed_edge_local_label_some n S B A Δ D k s e l m _ hm
    have hgl : g = l := congrArg Sigma.fst hz
    subst l
    have hp : (e.2 g).2.2.2 ⟨i, hi'⟩ = (e.2 g).2.2.2 ⟨m, hm'⟩ := by
      simpa only [Sigma.mk.inj_iff, heq_eq_eq, true_and] using hz
    have him : i = m := congrArg Subtype.val (h g hp)
    subst m
    rfl

end Full
end Bounty
