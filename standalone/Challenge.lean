  let : BorelSpace E := instBorelSpaceEL2CompactnessTranslationIntegral (E := E)
  let : OpensMeasurableSpace E := instOpensMeasurableSpaceEL2CompactnessTranslationIntegral (E := E)
  let : MeasurableAdd E := instMeasurableAddEL2CompactnessTranslationIntegral (E := E)
  let : MeasurableNeg E := instMeasurableNegEL2CompactnessTranslationIntegral (E := E)
  change
    ∫ t,
        ‖(translateL2 (μ := (volume : Measure E)) (-t)) F - F‖ ^ 2
      ∂kernelMeasure (E := E) ψ ≤ η ^ 2
  classical
  let μ : Measure E := kernelMeasure (E := E) ψ
  have : MeasureTheory.IsProbabilityMeasure μ :=
    ⟨kernelMeasure_univ (E := E) (ψ := ψ) hψc hψcs hψ0 hψint⟩
  have hμzero : μ ((Metric.ball (0 : E) deltaLoss)ᶜ) = 0 := by
    simpa [μ] using kernelMeasure_compl_ball_eq_zero_of_tsupport_subset (E := E) (ψ := ψ) hψsupp
