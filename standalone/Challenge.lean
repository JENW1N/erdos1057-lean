      ∀ qRat : ℕ, 0 < qRat → (qRat : ℝ) ≤ L^Rmod → ∀ aRat : ℤ,
      ∀ w : ℝ, |w| ≤ L^W →
      (∫ u in Set.Icc (-R) R,
        ‖rationalFourBoxKernelSum qRat aRat s
