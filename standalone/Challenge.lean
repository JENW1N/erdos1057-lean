lemma unramifiedCubicGaussSeries_square_cube (p:(_root_.OAI.ActualEisensteinCubic.O)) (hp:Prime p)
    (hprimary:lambda^2∣p-1) (s:ℂ) (hs:2<s.re) (h:(_root_.OAI.ActualEisensteinCubic.O)) (hph:¬p∣h) :
    unramifiedCubicGaussSeries s (h*p^5)=
