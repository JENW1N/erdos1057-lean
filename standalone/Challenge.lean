section

/- Literal positive support of the original harmonic dyadic cutoff. -/

open Finset
namespace Bounty

theorem typeII_harmonic_dyadic_support {t : ℝ} (h : typeIIHarmonicDyadic t ≠ 0) :
    t ∈ Set.Ioo (1/2) 2 := by
  apply typeII_smooth_dyadic_support
  intro hz
  exact h (by simp only [typeIIHarmonicDyadic, hz, mul_zero])

noncomputable def harmonicPositiveSupport (Z : ℝ) (k : ℤ) (d : ℕ) : Finset ℤ :=
  (Icc 1 ⌊2*Z*(d : ℝ)⌋).filter
    (fun w => Z*(d : ℝ)/2 < (w : ℝ) ∧ 0 < w + k*(d : ℤ))

theorem mem_harmonic_positive_support {Z : ℝ} {k w : ℤ} {d : ℕ}
    (hw : w ∈ harmonicPositiveSupport Z k d) :
    0 < w ∧ Z*(d : ℝ)/2 < (w : ℝ) ∧ (w : ℝ) ≤ 2*Z*(d : ℝ) ∧
      0 < w + k*(d : ℤ) := by
  have h := mem_filter.mp hw
  have hi := mem_Icc.mp h.1
  exact ⟨by omega, h.2.1, (Int.le_floor.mp hi.2), h.2.2⟩

theorem original_harmonic_test_support
    (P : Finset ℕ) (α₀ β₀ γ₀ α₁ β₁ γ₁ : ℕ → ℂ)
    {Z : ℝ} (hZ : 0 < Z) (k : ℤ) {d : ℕ} (hd : 0 < d) (w : ℤ)
    (h : (typeIIHarmonicDyadic ((w : ℝ)/(Z*(d : ℝ))) : ℂ) * (w : ℂ)⁻¹ *
      (starRingEnd ℂ) (positiveInvariantEndpoint P α₀ β₀ γ₀ w) *
      positiveInvariantEndpoint P α₁ β₁ γ₁ (w+k*(d : ℤ)) ≠ 0) :
    w ∈ harmonicPositiveSupport Z k d := by
  have hψ : typeIIHarmonicDyadic ((w : ℝ)/(Z*(d : ℝ))) ≠ 0 := by
    intro hz
    apply h
    simp only [hz, Complex.ofReal_zero, zero_mul]
  have hs := typeII_harmonic_dyadic_support hψ
  have hZd : 0 < Z*(d : ℝ) := mul_pos hZ (by exact_mod_cast hd)
  have hlo : Z*(d : ℝ)/2 < (w : ℝ) := by
    have hh := (lt_div_iff₀ hZd).mp hs.1
    linarith
  have hhi : (w : ℝ) < 2*Z*(d : ℝ) := by
    have hh := (div_lt_iff₀ hZd).mp hs.2
    linarith
  have hwpos : 0 < w := by
    have : 0 < (w : ℝ) := lt_trans (half_pos hZd) hlo
    exact_mod_cast this
  have htpos : 0 < w+k*(d : ℤ) := by
    apply positive_invariant_endpoint_nonzero P α₁ β₁ γ₁
    intro hz
    exact h (by rw [hz, mul_zero])
  exact mem_filter.mpr ⟨mem_Icc.mpr ⟨by omega, Int.le_floor.mpr hhi.le⟩, hlo, htpos⟩

theorem harmonic_positive_support_upper_shift {Z : ℝ} (k : ℤ) {d : ℕ}
    (hk : |(k : ℝ)| ≤ Z) {w : ℤ} (hw : w ∈ harmonicPositiveSupport Z k d) :
    (w + k*(d : ℤ) : ℤ) ≤ ⌊3*Z*(d : ℝ)⌋ := by
  have hs := mem_harmonic_positive_support hw
  apply Int.le_floor.mpr
  have hh := mul_le_mul_of_nonneg_right (le_trans (le_abs_self (k : ℝ)) hk)
    (Nat.cast_nonneg d : (0 : ℝ) ≤ d)
  push_cast
  linarith [hs.2.2.1]

