lemma cube_affine_coefficient_unit (p C:(_root_.OAI.ActualEisensteinCubic.O)) (hprimary:lambda^2∣p-1) (hC:IsCoprime C p) :
    IsUnit (Ideal.Quotient.mk (Ideal.span {p^3}) (3*C)) := by
  obtain ⟨t,ht⟩:=(three_dvd_primary_sub_one p hprimary)
  have hp3:IsCoprime p (3:(_root_.OAI.ActualEisensteinCubic.O)):=by
    refine ⟨1,-t,?_⟩
    linear_combination ht
  apply (isUnit_quotient_span_iff _ _).mpr
  exact hp3.pow_left.mul_right hC.symm.pow_left

def cubeCuspAffineEquiv (p A C:(_root_.OAI.ActualEisensteinCubic.O)) (hprimary:lambda^2∣p-1) (hC:IsCoprime C p) :
    ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {p^3})≃((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {p^3}) := by
  let a:=Ideal.Quotient.mk (Ideal.span {p^3}) A
  let u:Units ((_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {p^3}):=(cube_affine_coefficient_unit p C hprimary hC).unit
  exact {
    toFun:=fun r=>a+(u:_) * r
    invFun:=fun r=>(↑u⁻¹:_)*(r-a)
    left_inv:=by
      intro r
      simp only [add_sub_cancel_left,←mul_assoc,Units.inv_mul,one_mul]
    right_inv:=by
      intro r
      simp only [←mul_assoc,Units.mul_inv,one_mul,add_sub_cancel] }

lemma cubeCuspAffineEquiv_apply (p A C:(_root_.OAI.ActualEisensteinCubic.O)) (hprimary:lambda^2∣p-1) (hC:IsCoprime C p)
    (r:(_root_.OAI.ActualEisensteinCubic.O)⧸Ideal.span {p^3}) :
    cubeCuspAffineEquiv p A C hprimary hC r=
      Ideal.Quotient.mk (Ideal.span {p^3}) A+
        Ideal.Quotient.mk (Ideal.span {p^3}) (3*C)*r := by
  simp only [cubeCuspAffineEquiv,IsUnit.unit_spec]
  rfl

lemma cubeCuspAffineEquiv_mk (p A C q:(_root_.OAI.ActualEisensteinCubic.O)) (hprimary:lambda^2∣p-1) (hC:IsCoprime C p) :
    cubeCuspAffineEquiv p A C hprimary hC (Ideal.Quotient.mk _ q)=
      Ideal.Quotient.mk (Ideal.span {p^3}) (A+3*q*C) := by
  rw [cubeCuspAffineEquiv_apply]
  simp only [map_add,map_mul]
  ring

