/- Equality of finite row compositions uses only rows actually traversed.
For a constant state space, visit/three-row grouping needs no terminal casts. -/

namespace Bounty

theorem finite_row_composition_congr_before {S : ℕ → Type*} {V : Type*}
    (row other : ∀ i, (S (i + 1) → V) → S i → V) (n : ℕ)
    (hrow : ∀ i, i < n → ∀ F, row i F = other i F) (F : S n → V) :
    finiteRowComposition row n F = finiteRowComposition other n F := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [finite_row_composition_succ, hrow n (Nat.lt_succ_self n),
      finite_row_composition_succ]
    exact ih (fun i hi => hrow i (Nat.lt_trans hi (Nat.lt_succ_self n))) (other n F)

