       cuspIntervalWhittakerHeightFactor a b ρ s h) domain := fun s hs=>
     (translatedCuspFamily_analyticAt_nonreal h oppositeSource 2 3 (by norm_num) (by norm_num) s hs.1.ne' hs.2.ne').mul
