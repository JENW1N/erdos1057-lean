section

/- Absolute divisor cross mass on the original candidate window. -/

open Finset Filter Real

namespace Bounty

theorem shifted_divisor_cross_mass_le (T : Finset ℕ) (N : ℕ)
    (hN : ∀ u ∈ T, 2*u+1 ≤ N) :
    (∑ u ∈ T, (u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ)) ≤
      (N : ℝ) * (1 + log N) ^ 15 := by
  have h := divisor_square_cross_moment T (fun u => u) (fun u => 2*u+1) N N
    (fun _ _ _ _ h => h) (by intro a _ b _ h; dsimp at h; omega)
    (fun u hu => by have := hN u hu; omega) hN
  have hpos : 0 ≤ (N : ℝ) * (1 + log N)^15 := by positivity
  rw [← sq, sq_sqrt hpos] at h
  apply le_trans ?_ h
  apply sum_le_sum
  intro u _
  have hp := Nat.le_mul_self (u.divisors.card * (2*u+1).divisors.card)
  have hp' : (u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ) ≤
      ((u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ)) *
        ((u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ)) := by exact_mod_cast hp
  nlinarith only [hp']

theorem eventually_arithmetic_window_divisor_cross_mass :
    ∀ᶠ L : ℝ in atTop,
      (∑ u ∈ arithmeticProductWindow 1 (exp L),
        (u.divisors.card : ℝ) * ((2*u+1).divisors.card : ℝ)) ≤ exp L * L^(16 : ℝ) := by
  filter_upwards [eventually_ge_atTop (1 : ℝ),
    eventually_ge_atTop (33*(2+log 33)^15 : ℝ)] with L hL hK
  have hL0 : 0 < L := by linarith
  have hE : 1 ≤ exp L := one_le_exp hL0.le
  let N : ℕ := ⌊33*exp L⌋₊
  have hN0 : 0 < N := Nat.floor_pos.mpr (by linarith)
  have hNpos : (0 : ℝ) < N := by exact_mod_cast hN0
  have hNle : (N : ℝ) ≤ 33*exp L := Nat.floor_le (by positivity)
  have hlog : 1+log N ≤ (2+log 33)*L := by
    have hh := log_le_log hNpos hNle
    rw [log_mul (by norm_num : (33 : ℝ) ≠ 0) (exp_ne_zero L), log_exp] at hh
    have h33 : 0 ≤ log 33 := log_nonneg (by norm_num)
    nlinarith
  have hmass := shifted_divisor_cross_mass_le (arithmeticProductWindow 1 (exp L)) N
    (by
      intro u hu
      have huhi : (u : ℝ) ≤ 16*exp L := by
        simpa only [one_mul] using ((mem_arithmeticProductWindow_iff one_ne_zero (exp L)).mp hu).2
      apply Nat.le_floor
      push_cast
      linarith)
  calc
    _ ≤ (N : ℝ) * (1+log N)^15 := hmass
    _ ≤ (33*exp L) * ((2+log 33)*L)^15 :=
      mul_le_mul hNle (pow_le_pow_left₀ (by positivity) hlog 15) (by positivity) (by positivity)
    _ = (33*(2+log 33)^15) * exp L * L^15 := by rw [mul_pow]; ring
    _ ≤ L * exp L * L^15 := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_right hK (exp_pos _).le) (pow_nonneg hL0.le _)
    _ = exp L * L^(16 : ℝ) := by norm_num only [rpow_ofNat]; ring

end Bounty
end

section

/- Fold the original P-weight into the retained h coefficient by exact supported/free uniqueness. -/

open Finset Filter

namespace Bounty

theorem supported_free_complex_product_reindex (P A B : Finset ℕ)
    (hA : ∀ p ∈ A, p ∈ Nat.factoredNumbers P)
    (hB : ∀ n ∈ B, n ≠ 0 ∧ Disjoint n.primeFactors P)
    (W Q F : ℕ → ℂ) :
    (∑ p ∈ A, ∑ n ∈ B, W p * Q n * F (p * n)) =
      ∑ h ∈ (A ×ˢ B).image (fun z => z.1 * z.2),
        W (primePoolPart P h) * Q (primePoolFreePart P h) * F h := by
  classical
  have hinj : Set.InjOn (fun z : ℕ × ℕ => z.1 * z.2) (↑(A ×ˢ B) : Set (ℕ × ℕ)) := by
    intro x hx y hy hxy
    obtain ⟨hxp, hxn⟩ := mem_product.mp hx
    obtain ⟨hyp, hyn⟩ := mem_product.mp hy
    obtain ⟨hp, hn⟩ := supported_free_product_unique (hA _ hxp) (hB _ hxn).1 (hB _ hxn).2
      (hA _ hyp) (hB _ hyn).1 (hB _ hyn).2 hxy
    exact Prod.ext hp hn
  rw [sum_image hinj, sum_product]
  apply sum_congr rfl
  intro p hp
  apply sum_congr rfl
  intro n hn
  rw [primePoolPart_mul_of_free (hA _ hp) (hB _ hn).1 (hB _ hn).2,
    primePoolFreePart_mul_of_free (hA _ hp) (hB _ hn).1 (hB _ hn).2]

noncomputable def candidateRetainedComplexCoefficient (c L q : ℝ) (r jStar : ℕ)
    (take : Fin ((candidateQIndices c L).card * r) → Bool)
    (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (h : ℕ) : ℂ :=
  (markedDivisorWeight (candidatePIndices c L) (candidatePBand (c * L)) q
    (fun j => ∑ p ∈ candidatePBand (c * L) j, 1 / (p : ℝ)) (fun _ => 1) (h : ℤ) : ℂ) *
      candidateRemainingComplexCoefficient c L r jStar take twist
        (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c * L))) h)

theorem eventually_candidate_retained_convolution {c : ℝ} (hc : 0 < c) :
    ∀ᶠ L : ℝ in atTop, ∀ (q : ℝ) (r jStar : ℕ)
      (take : Fin ((candidateQIndices c L).card * r) → Bool)
      (twist : (candidateQIndices c L) × Fin r → ℕ → ℂ) (S : Finset ℕ),
      (∀ p ∈ S, p ∈ Nat.factoredNumbers
        ((candidatePIndices c L).biUnion (candidatePBand (c * L)))) → ∀ F : ℕ → ℂ,
      (∑ p ∈ S, ∑ n ∈ orderedSlotProductSupport
        (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val),
        (candidatePWeight c L q p : ℂ) *
          candidateRemainingComplexCoefficient c L r jStar take twist n * F (p * n)) =
      ∑ h ∈ (S ×ˢ orderedSlotProductSupport
        (fun slot : CandidateRemainingSlot c L r take => candidateQSlotChoices c L r jStar slot.val)).image
          (fun z => z.1 * z.2), candidateRetainedComplexCoefficient c L q r jStar take twist h * F h := by
  filter_upwards [eventually_candidate_remaining_support_free hc] with L hfree
  intro q r jStar take twist S hS F
  classical
  rw [supported_free_complex_product_reindex _ S _ hS (hfree r jStar take)]
  apply sum_congr rfl
  intro h hh
  obtain ⟨pn, hpn, rfl⟩ := mem_image.mp hh
  obtain ⟨hp, hn⟩ := mem_product.mp hpn
  obtain ⟨hn0, hnfree⟩ := hfree r jStar take pn.2 hn
  have hp0 := Nat.ne_zero_of_mem_factoredNumbers (hS _ hp)
  rw [primePoolPart_mul_of_free (hS _ hp) hn0 hnfree,
    primePoolFreePart_mul_of_free (hS _ hp) hn0 hnfree]
  unfold candidateRetainedComplexCoefficient
  rw [candidate_marked_weight_mul_of_free c L q hn0 hnfree pn.1,
    primePoolFreePart_mul_of_free (hS _ hp) hn0 hnfree,
    candidate_P_weight_eq_marked c L q hp0]

end Bounty

end

section

/- Divisor-product mass on small finite subsets, with an absolute logarithmic loss. -/

open Finset

namespace Bounty

theorem divisor_product_subset_concentration {α : Type*} [DecidableEq α]
    (S : Finset α) (f g : α → ℕ) (N : ℕ)
    (hf : Set.InjOn f S) (hg : Set.InjOn g S)
    (hNf : ∀ x ∈ S, f x ≤ N) (hNg : ∀ x ∈ S, g x ≤ N) :
    (∑ x ∈ S, ((f x).divisors.card : ℝ) * ((g x).divisors.card : ℝ)) ≤
      Real.sqrt (S.card : ℝ) * Real.sqrt ((N : ℝ) * (1 + Real.log N) ^ 15) := by
  have hmoment := divisor_square_cross_moment S f g N N hf hg hNf hNg
  rw [Real.mul_self_sqrt (by positivity)] at hmoment
  have hcs := Real.sum_mul_le_sqrt_mul_sqrt S (fun _ => (1 : ℝ))
    (fun x => ((f x).divisors.card : ℝ) * ((g x).divisors.card : ℝ))
  simp only [one_mul, one_pow, sum_const, nsmul_eq_mul, mul_one, mul_pow] at hcs
  exact hcs.trans (mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt hmoment) (Real.sqrt_nonneg _))

theorem shifted_divisor_subset_concentration (S : Finset ℕ) (N : ℕ)
    (hN : ∀ u ∈ S, 2 * u + 1 ≤ N) :
    (∑ u ∈ S, (u.divisors.card : ℝ) * ((2 * u + 1).divisors.card : ℝ)) ≤
      Real.sqrt (S.card : ℝ) * Real.sqrt ((N : ℝ) * (1 + Real.log N) ^ 15) := by
  apply divisor_product_subset_concentration S (fun u => u) (fun u => 2 * u + 1) N
  · intro a _ b _ hab
    exact hab
  · intro a _ b _ hab
    change 2 * a + 1 = 2 * b + 1 at hab
    omega
  · intro u hu
    have := hN u hu
    omega
  · exact hN


end Bounty
end

section

/- Real logarithmic phases, with an explicit integration-frequency convention. -/

open MeasureTheory

namespace Bounty

noncomputable def physicalMellinPhase (v t : ℝ) : ℂ :=
  Complex.exp ((v * Real.log t : ℝ) * Complex.I)

theorem physical_mellin_phase_norm (v t : ℝ) : ‖physicalMellinPhase v t‖ = 1 := by
  exact Complex.norm_exp_ofReal_mul_I _

theorem physical_mellin_phase_conj (v t : ℝ) :
    (starRingEnd ℂ) (physicalMellinPhase v t) = physicalMellinPhase (-v) t := by
  unfold physicalMellinPhase
  rw [← Complex.exp_conj]
  congr 1
  simp only [map_mul, Complex.conj_ofReal, Complex.conj_I, neg_mul, Complex.ofReal_neg]
  ring

theorem physical_mellin_phase_ratio (v n Z : ℝ) (D : ℕ)
    (hn : n ≠ 0) (hZ : Z ≠ 0) (hD : D ≠ 0) :
    physicalMellinPhase v (n / Z) * physicalPhase (-v) D =
      physicalMellinPhase v (n / (Z * D)) := by
  have hDr : (D : ℝ) ≠ 0 := by exact_mod_cast hD
  unfold physicalMellinPhase physicalPhase
  rw [← Complex.exp_add, Real.log_div hn hZ,
    Real.log_div hn (mul_ne_zero hZ hDr), Real.log_mul hZ hDr]
  congr 1
  push_cast
  ring

theorem physical_mellin_phase_integrable (ρ : ℝ → ℂ) (ν : ℝ → ℝ)
    (hρ : Integrable ρ) (hν : Continuous ν) (t : ℝ) :
    Integrable (fun v => ρ v * physicalMellinPhase (ν v) t) := by
  have hc : Continuous (fun v => physicalMellinPhase (ν v) t) := by
    unfold physicalMellinPhase
    fun_prop
  exact hρ.mul_bdd hc.aestronglyMeasurable
    (Filter.Eventually.of_forall (fun v => (physical_mellin_phase_norm (ν v) t).le))

end Bounty
end

section

/- The original permutation/ghost/edge path is preserved by exact edge parameter transport. -/

open Finset
open scoped Classical
namespace Bounty
section Events
variable {J K G : Type*} {P : G → Type*}
  (n : ∀ g, P g → ℕ) {M : G → ℕ}
  (S : K → ∀ g, Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ Δ' D D' : ∀ k c, A k c → G → ℤ)
  (hΔ : ∀ k, Δ k = Δ' k)
  (hD : ∀ k c a g p, ((n g p : ℤ) ∣ D k c a g ↔ (n g p : ℤ) ∣ D' k c a g))

noncomputable def fullPermutationParameterEventEquiv
    (tag : Option (J ⊕ K))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FullPermutationMixedEvent n S B A Δ D tag x ≃
      FullPermutationMixedEvent n S B A Δ' D' tag x :=
  match tag with
  | none => Equiv.refl _
  | some (.inl _) => Equiv.refl _
  | some (.inr k) => fullActiveParameterEventEquiv n (S k) B (A k)
      (Δ k) (Δ' k) (D k) (D' k) (hΔ k) (hD k) x

theorem full_permutation_parameter_target
    (tag : Option (J ⊕ K))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag x) :
    fullPermutationMixedEventTarget n S B A Δ' D' tag x
        (fullPermutationParameterEventEquiv n S B A Δ Δ' D D' hΔ hD tag x e) =
      fullPermutationMixedEventTarget n S B A Δ D tag x e := by
  cases tag with
  | none => rfl
  | some tag =>
    cases tag with
    | inl j => rfl
    | inr k =>
      exact full_active_parameter_target n (S k) B (A k)
        (Δ k) (Δ' k) (D k) (D' k) (hΔ k) (hD k) x e

theorem full_permutation_parameter_weight [Fintype G] [DecidableEq G]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (tag : Option (J ⊕ K))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (e : FullPermutationMixedEvent n S B A Δ D tag x) :
    fullPermutationMixedEventWeight n S B A Δ' D' ω μ q ρ V tag x
        (fullPermutationParameterEventEquiv n S B A Δ Δ' D D' hΔ hD tag x e) =
      fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V tag x e := by
  cases tag with
  | none => rfl
  | some tag =>
    cases tag with
    | inl j => rfl
    | inr k =>
      exact full_active_parameter_weight n (S k) B (A k)
        (Δ k) (Δ' k) (D k) (D' k) (hΔ k) (hD k) (ω k) μ ρ V x e

noncomputable def fullPermutationParameterPathEquiv (steps : List (Option (J ⊕ K)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B) :
    FiniteEventPath (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x ≃
    FiniteEventPath (FullPermutationMixedEvent n S B A Δ' D')
      (fullPermutationMixedEventTarget n S B A Δ' D') steps x :=
  finiteEventPathEquiv _ _ _ _ id
    (fullPermutationParameterEventEquiv n S B A Δ Δ' D D' hΔ hD)
    (fun tag x e => (full_permutation_parameter_target n S B A Δ Δ' D D' hΔ hD tag x e).symm)
    steps x

theorem full_permutation_parameter_path_terminal (steps : List (Option (J ⊕ K)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FiniteEventPath (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x) :
    finiteEventPathTerminal _ (fullPermutationMixedEventTarget n S B A Δ' D') steps x
        (fullPermutationParameterPathEquiv n S B A Δ Δ' D D' hΔ hD steps x p) =
      finiteEventPathTerminal _ (fullPermutationMixedEventTarget n S B A Δ D) steps x p :=
  finite_event_path_equiv_terminal _ _ _ _ id _ _ steps x p

theorem full_permutation_parameter_path_weight [Fintype G] [DecidableEq G]
    (ω : ∀ k c, A k c → ℝ) (μ : ∀ g, P g → ℝ) (q : J → ℝ) (ρ : ℝ) (V : G → ℝ)
    (steps : List (Option (J ⊕ K)))
    (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
    (p : FiniteEventPath (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x) :
    finiteEventPathWeight _ (fullPermutationMixedEventTarget n S B A Δ' D')
        (fullPermutationMixedEventWeight n S B A Δ' D' ω μ q ρ V) steps x
        (fullPermutationParameterPathEquiv n S B A Δ Δ' D D' hΔ hD steps x p) =
      finiteEventPathWeight _ (fullPermutationMixedEventTarget n S B A Δ D)
        (fullPermutationMixedEventWeight n S B A Δ D ω μ q ρ V) steps x p :=
  finite_event_path_equiv_weight _ _ _ _ id _ _ _ _
    (full_permutation_parameter_weight n S B A Δ Δ' D D' hΔ hD ω μ q ρ V) steps x p

end Events
end Bounty
end

section

/- A fixed-support logarithmic cutoff with the inverse smoothing width as parameter. -/

open MeasureTheory
open scoped ContDiff FourierTransform

namespace Bounty

noncomputable def typeIIWindowLogLocalizer (s : ℝ) : ℝ :=
  Real.smoothTransition (s + 1) * Real.smoothTransition (Real.log 16 + 1 - s)

noncomputable def typeIIWindowLogCutoff (r s : ℝ) : ℝ :=
  typeIIWindowLogLocalizer s * Real.smoothTransition (r * (Real.exp s - 1)) *
    Real.smoothTransition (r * (16 - Real.exp s))

noncomputable def typeIIWindowLogJoint (y : ℝ × ℝ) : ℝ :=
  typeIIWindowLogLocalizer y.2 *
    Real.smoothTransition (y.1 * (typeIITameExp (Real.log 16 + 1) y.2 - 1)) *
    Real.smoothTransition (y.1 * (16 - typeIITameExp (Real.log 16 + 1) y.2))

theorem typeII_window_log_localizer_eq_one {s : ℝ} (hs : s ∈ Set.Icc 0 (Real.log 16)) :
    typeIIWindowLogLocalizer s = 1 := by
  rw [typeIIWindowLogLocalizer, Real.smoothTransition.one_of_one_le (by linarith [hs.1]),
    Real.smoothTransition.one_of_one_le (by linarith [hs.2]), mul_one]

theorem typeII_window_log_localizer_eq_zero {s : ℝ}
    (hs : s ∉ Set.Icc (-1) (Real.log 16 + 1)) : typeIIWindowLogLocalizer s = 0 := by
  by_cases hlo : s < -1
  · rw [typeIIWindowLogLocalizer, Real.smoothTransition.zero_of_nonpos (by linarith), zero_mul]
  · have hhi : Real.log 16 + 1 < s := lt_of_not_ge (fun h => hs ⟨le_of_not_gt hlo, h⟩)
    rw [typeIIWindowLogLocalizer, Real.smoothTransition.zero_of_nonpos (by linarith : Real.log 16+1-s≤0), mul_zero]

theorem typeII_window_log_localizer_hasCompactSupport :
    HasCompactSupport typeIIWindowLogLocalizer :=
  HasCompactSupport.intro isCompact_Icc (fun _ hs => typeII_window_log_localizer_eq_zero hs)

theorem typeII_window_log_localizer_contDiff : ContDiff ℝ ∞ typeIIWindowLogLocalizer := by
  unfold typeIIWindowLogLocalizer
  fun_prop

theorem typeII_window_log_cutoff_contDiff (r : ℝ) : ContDiff ℝ ∞ (typeIIWindowLogCutoff r) := by
  have hl := typeII_window_log_localizer_contDiff
  unfold typeIIWindowLogCutoff
  fun_prop

theorem typeII_window_log_cutoff_hasCompactSupport (r : ℝ) :
    HasCompactSupport (typeIIWindowLogCutoff r) :=
  typeII_window_log_localizer_hasCompactSupport.mul_right.mul_right

theorem typeII_window_log_cutoff_eq_smooth {δ : ℝ} (hδ : 0 < δ) (s : ℝ) :
    typeIIWindowLogCutoff δ⁻¹ s = typeIIWindowSmooth δ (Real.exp s) := by
  have heq : typeIIWindowLogCutoff δ⁻¹ s =
      typeIIWindowLogLocalizer s * typeIIWindowSmooth δ (Real.exp s) := by
    simp only [typeIIWindowLogCutoff, typeIIWindowSmooth, div_eq_mul_inv]
    rw [mul_comm δ⁻¹ (Real.exp s - 1), mul_comm δ⁻¹ (16 - Real.exp s)]
    ring
  rw [heq]
  by_cases hz : typeIIWindowSmooth δ (Real.exp s) = 0
  · rw [hz, mul_zero]
  · have hs := typeII_window_smooth_support hδ hz
    have hlo : 0 < s := by simpa using hs.1
    have hhi : s < Real.log 16 := (Real.lt_log_iff_exp_lt (by norm_num)).mpr hs.2
    rw [typeII_window_log_localizer_eq_one ⟨hlo.le, hhi.le⟩, one_mul]

theorem typeII_window_log_joint_hasTemperateGrowth :
    Function.HasTemperateGrowth typeIIWindowLogJoint := by
  have hr : Function.HasTemperateGrowth (fun y : ℝ × ℝ => y.1) :=
    (ContinuousLinearMap.fst ℝ ℝ ℝ).hasTemperateGrowth
  have hs : Function.HasTemperateGrowth (fun y : ℝ × ℝ => y.2) :=
    (ContinuousLinearMap.snd ℝ ℝ ℝ).hasTemperateGrowth
  have hl := (typeII_window_log_localizer_hasCompactSupport.hasTemperateGrowth
    typeII_window_log_localizer_contDiff).comp hs
  have he := (typeII_tame_exp_hasTemperateGrowth (Real.log 16 + 1)).comp hs
  have hg := smoothTransition_hasTemperateGrowth
  unfold typeIIWindowLogJoint
  fun_prop

theorem typeII_window_log_joint_eq (r s : ℝ) :
    typeIIWindowLogJoint (r, s) = typeIIWindowLogCutoff r s := by
  by_cases hz : typeIIWindowLogLocalizer s = 0
  · simp only [typeIIWindowLogJoint, typeIIWindowLogCutoff, hz, zero_mul]
  · have hs : s ∈ Set.Icc (-1) (Real.log 16 + 1) :=
      by_contra (fun h => hz (typeII_window_log_localizer_eq_zero h))
    have hp : 0 < Real.log 16 := Real.log_pos (by norm_num)
    have hb : |s| ≤ 2 * (Real.log 16 + 1 + 1) :=
      abs_le.mpr ⟨by linarith [hs.1], by linarith [hs.2]⟩
    simp only [typeIIWindowLogJoint, typeIIWindowLogCutoff, typeII_tame_exp_eq hb]

noncomputable def typeIIWindowLogSchwartz (r : ℝ) : SchwartzMap ℝ ℂ :=
  ((typeII_window_log_cutoff_hasCompactSupport r).comp_left
    (g := fun x : ℝ => (x : ℂ)) (by simp)).toSchwartzMap
    (Complex.ofRealCLM.contDiff.comp (typeII_window_log_cutoff_contDiff r))

noncomputable def typeIIWindowFourier (r : ℝ) : SchwartzMap ℝ ℂ := 𝓕 (typeIIWindowLogSchwartz r)

theorem typeII_window_fourier_integrable (r : ℝ) : Integrable (typeIIWindowFourier r) :=
  (typeIIWindowFourier r).integrable




theorem typeII_window_fourier_inversion (r s : ℝ) :
    (typeIIWindowLogCutoff r s : ℂ) =
      ∫ ξ : ℝ, Complex.exp (((2 * Real.pi * ξ * s : ℝ) : ℂ) * Complex.I) *
        typeIIWindowFourier r ξ := by
  have hi := congrArg (fun f : SchwartzMap ℝ ℂ => f s)
    (FourierPair.fourierInv_fourier_eq (E := SchwartzMap ℝ ℂ) (F := SchwartzMap ℝ ℂ)
      (typeIIWindowLogSchwartz r))
  rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq'] at hi
  change (∫ ξ : ℝ, Complex.exp (((2 * Real.pi * inner ℝ ξ s : ℝ) : ℂ) * Complex.I) •
    typeIIWindowFourier r ξ) = (typeIIWindowLogCutoff r s : ℂ) at hi
  rw [← hi]
  apply integral_congr_ae
  filter_upwards [] with ξ
  simp only [RCLike.inner_apply, starRingEnd_apply, star_trivial, smul_eq_mul]
  congr 2
  push_cast
  ring

end Bounty
end

section

/- Pool-invariant endpoint energy on the exceptional square-divisibility set. -/

open Finset

namespace Bounty

theorem invariant_triple_endpoint_square_energy
    (Q P : Finset ℕ) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (hP : ∀ p ∈ P, p ∈ Nat.factoredNumbers Q)
    (S : Finset ℕ) (N : ℕ) (hS : ∀ n ∈ S, n ≤ N) :
    (∑ n ∈ S.filter (fun n => ∃ p ∈ P, p ^ 2 ∣ n),
      ‖invariantTripleEndpoint Q α β γ n‖ ^ 2) ≤
      ((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) *
        ∑ p ∈ P, 1 / (p : ℝ) ^ 2 := by
  classical
  let f := fun n : ℕ => ‖invariantTripleEndpoint Q α β γ n‖ ^ 2
  have hpoint (n : ℕ) : (if ∃ p ∈ P, p ^ 2 ∣ n then f n else 0) ≤
      ∑ p ∈ P, if p ^ 2 ∣ n then f n else 0 := by
    by_cases hn : ∃ p ∈ P, p ^ 2 ∣ n
    · obtain ⟨p, hp, hpn⟩ := hn
      rw [if_pos ⟨p, hp, hpn⟩]
      calc
        f n = (if p ^ 2 ∣ n then f n else 0) := (if_pos hpn).symm
        _ ≤ _ := single_le_sum (s := P)
          (f := fun r => if r ^ 2 ∣ n then f n else 0)
          (fun r _ => by split_ifs <;> positivity) hp
    · rw [if_neg hn]
      exact sum_nonneg (fun p _ => by split_ifs <;> positivity)
  change (∑ n ∈ S.filter (fun n => ∃ p ∈ P, p ^ 2 ∣ n), f n) ≤ _
  rw [sum_filter]
  calc
    _ ≤ ∑ n ∈ S, ∑ p ∈ P, if p ^ 2 ∣ n then f n else 0 :=
      sum_le_sum (fun n _ => hpoint n)
    _ = ∑ p ∈ P, ∑ n ∈ S.filter (fun n => p ^ 2 ∣ n), f n := by
      rw [sum_comm]
      simp only [sum_filter]
    _ ≤ ∑ p ∈ P, (A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15 /
        (p : ℝ) ^ 2 := by
      apply sum_le_sum
      intro p hp
      have hsq : p ^ 2 ∈ Nat.factoredNumbers Q := by
        simpa only [pow_two] using Nat.mul_mem_factoredNumbers (hP p hp) (hP p hp)
      simpa only [Nat.cast_pow] using
        invariant_triple_endpoint_divisible_energy Q α β γ hA hB hC hα hβ hγ
          (S.filter (fun n => p ^ 2 ∣ n)) (p ^ 2) N hsq
          (fun n hn => (mem_filter.mp hn).2)
          (fun n hn => hS n (mem_filter.mp hn).1)
    _ = _ := by rw [mul_sum]; apply sum_congr rfl; intro p _; ring

theorem invariant_triple_endpoint_square_error_energy
    (Q P : Finset ℕ) (α β γ : ℕ → ℂ)
    {A B C : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C)
    (hα : ∀ m, ‖α m‖ ≤ A) (hβ : ∀ p, ‖β p‖ ≤ B) (hγ : ∀ r, ‖γ r‖ ≤ C)
    (hP : ∀ p ∈ P, p ∈ Nat.factoredNumbers Q)
    (S : Finset ℕ) (N : ℕ) (hS : ∀ n ∈ S, n ≤ N)
    (e : ℕ → ℂ) {H : ℝ}
    (he : ∀ n ∈ S, (∀ p ∈ P, ¬ p ^ 2 ∣ n) → e n = 0)
    (hbound : ∀ n ∈ S, ‖e n‖ ≤ H * ‖invariantTripleEndpoint Q α β γ n‖) :
    (∑ n ∈ S, ‖e n‖ ^ 2) ≤
      H ^ 2 * (((A * B * C) ^ 2 * (N : ℝ) * (1 + Real.log N) ^ 15) *
        ∑ p ∈ P, 1 / (p : ℝ) ^ 2) := by
  classical
  have heq : (∑ n ∈ S, ‖e n‖ ^ 2) =
      ∑ n ∈ S.filter (fun n => ∃ p ∈ P, p ^ 2 ∣ n), ‖e n‖ ^ 2 := by
    rw [sum_filter]
    apply sum_congr rfl
    intro n hn
    split_ifs with hp
    · rfl
    · have hz := he n hn (by simpa only [not_exists, not_and] using hp)
      simp only [hz, norm_zero, zero_pow (by decide : 2 ≠ 0)]
  rw [heq]
  calc
    _ ≤ ∑ n ∈ S.filter (fun n => ∃ p ∈ P, p ^ 2 ∣ n),
        H ^ 2 * ‖invariantTripleEndpoint Q α β γ n‖ ^ 2 := by
      apply sum_le_sum
      intro n hn
      simpa only [mul_pow] using pow_le_pow_left₀ (norm_nonneg _)
        (hbound n (mem_filter.mp hn).1) 2
    _ = H ^ 2 * ∑ n ∈ S.filter (fun n => ∃ p ∈ P, p ^ 2 ∣ n),
        ‖invariantTripleEndpoint Q α β γ n‖ ^ 2 := (mul_sum ..).symm
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (invariant_triple_endpoint_square_energy Q P α β γ hA hB hC hα hβ hγ hP S N hS)
      (sq_nonneg H)

end Bounty
end

section

/- Common birth labels on the unchanged original paths retain their exact owning event. -/

open Classical
namespace Bounty
section Path
variable {J K : Type*} {N : ℕ} {P : Fin N → Type*}
  (n : (g : Fin N) → P g → ℕ) {M : Fin N → ℕ}
  (S : K → (g : Fin N) → Finset (Fin (M g))) (B : ℕ)
  (A : ∀ k, SharedActiveLabels P (S k) → Type*)
  (Δ D : ∀ k c, A k c → Fin N → ℤ) (steps : List (Option (J ⊕ K)))
  (x : ProductBoundedOrderedState P (fun g => UnrestrictedResidueParticle (n g)) M B)
  (p : FullPermutationMixedPath n S B A Δ D steps x)

noncomputable def fullMixedCommonPathBornData : FullMixedCommonStepAddress M B steps → Option (FullMixedBornData n) :=
  optionalBirthExtension (fullMixedCommonStepEmbedding S B steps) (fullMixedPathBornData n S B A Δ D steps x p)

noncomputable def fullMixedCommonPathBirthLabel (a : FullMixedCommonStepAddress M B steps) :
    Option ((g : Fin N) × P g) :=
  (fullMixedCommonPathBornData n S B A Δ D steps x p a).map (fullMixedBornPrime n)










theorem full_mixed_common_path_label_extension (a : FullMixedCommonStepAddress M B steps) :
    fullMixedCommonPathBirthLabel n S B A Δ D steps x p a =
      optionalBirthExtension (fullMixedCommonStepEmbedding S B steps)
        (fullMixedPathBirthLabel n S B A Δ D steps x p) a := optional_birth_extension_map _ _ _ _

theorem full_mixed_common_path_data_occurrence (i : Fin steps.length)
    (a : FullMixedCommonLocalAddress M B (steps.get i)) :
    let e := finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p i
    fullMixedCommonPathBornData n S B A Δ D steps x p ⟨i, a⟩ =
      fullMixedCommonEventBornData n S B A Δ D (steps.get i) e.1 e.2 a := by
  exact optional_birth_extension_sigma (fun i => fullMixedCommonLocalEmbedding S B (steps.get i))
    (fullMixedPathBornData n S B A Δ D steps x p) i a

theorem full_mixed_common_path_label_occurrence (i : Fin steps.length)
    (a : FullMixedCommonLocalAddress M B (steps.get i)) :
    let e := finiteEventPathOccurrence (FullPermutationMixedEvent n S B A Δ D)
      (fullPermutationMixedEventTarget n S B A Δ D) steps x p i
    fullMixedCommonPathBirthLabel n S B A Δ D steps x p ⟨i, a⟩ =
      fullMixedCommonEventBirthLabel n S B A Δ D (steps.get i) e.1 e.2 a := by
  unfold fullMixedCommonPathBirthLabel fullMixedCommonEventBirthLabel
  rw [full_mixed_common_path_data_occurrence]

theorem full_mixed_common_path_distinct_iff :
    (∀ a b z, fullMixedCommonPathBirthLabel n S B A Δ D steps x p a = some z →
      fullMixedCommonPathBirthLabel n S B A Δ D steps x p b = some z → a = b) ↔
    (∀ a b z, fullMixedPathBirthLabel n S B A Δ D steps x p a = some z →
      fullMixedPathBirthLabel n S B A Δ D steps x p b = some z → a = b) := by
  simp only [full_mixed_common_path_label_extension]
  exact optional_birth_extension_distinct_iff _ _

theorem full_mixed_common_path_all_labels_iff (Q : ((g : Fin N) × P g) → Prop) :
    (∀ a z, fullMixedCommonPathBirthLabel n S B A Δ D steps x p a = some z → Q z) ↔
      (∀ a z, fullMixedPathBirthLabel n S B A Δ D steps x p a = some z → Q z) := by
  simp only [full_mixed_common_path_label_extension]
  exact optional_birth_extension_all_iff _ _ _

end Path
end Bounty
