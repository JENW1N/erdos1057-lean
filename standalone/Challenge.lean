section

/- Exact compatibility support of the original finite residue vertex product. -/

open Finset
open scoped Classical
namespace Bounty

section Compatibility
variable {G : Type*} [Fintype G] {P : G → Finset ℕ} {J ell : ℕ}

noncomputable def physicalResiduePathCompatible
    (labels : ℕ → PhysicalMarkLists P J ell) (visits : Finset ℕ)
    (offset : ℕ → ℤ) (r : PhysicalResidues P) : Prop :=
  ∀ j ∈ visits, ∀ p ∈ physicalMarkedPrimes (labels j), r p = -(offset j : ZMod p.2.val)

theorem physical_residue_translated_marks_valid_iff
    (r : PhysicalResidues P) (L : PhysicalMarkLists P J ell) (a : ℤ) :
    physicalResidueMarksValid (physicalTranslateResidues r a) L ↔
      ∀ p ∈ physicalMarkedPrimes L, r p = -(a : ZMod p.2.val) := by
  rw [physical_residue_marks_valid_iff_marked]
  simp only [physicalTranslateResidues, add_eq_zero_iff_eq_neg]

theorem physical_residue_path_compatible_iff
    (labels : ℕ → PhysicalMarkLists P J ell) (visits : Finset ℕ)
    (offset : ℕ → ℤ) (r : PhysicalResidues P) :
    physicalResiduePathCompatible labels visits offset r ↔
      ∀ j ∈ visits, physicalResidueMarksValid (physicalTranslateResidues r (offset j)) (labels j) := by
  simp only [physicalResiduePathCompatible, physical_residue_translated_marks_valid_iff]

theorem physical_residue_path_compatible_range_iff
    (labels : ℕ → PhysicalMarkLists P J ell) (n : ℕ)
    (offset : ℕ → ℤ) (r : PhysicalResidues P) :
    physicalResiduePathCompatible labels (range n) offset r ↔
      ∀ j : Fin n, ∀ p ∈ physicalMarkedPrimes (labels j.val),
        r p = -(offset j.val : ZMod p.2.val) := by
  constructor
  · intro h j
    exact h j.val (mem_range.mpr j.isLt)
  · intro h j hj
    exact h ⟨j, mem_range.mp hj⟩

theorem physical_residue_vertex_product_zero_of_incompatible
    (labels : ℕ → PhysicalMarkLists P J ell) (visits : Finset ℕ)
    (offset : ℕ → ℤ) (q : ℕ → ℝ) (r : PhysicalResidues P)
    (h : ¬ physicalResiduePathCompatible labels visits offset r) :
    (∏ j ∈ visits, physicalResidueVertexWeight (labels j) (q j)
      (physicalTranslateResidues r (offset j))) = 0 := by
  rw [physical_residue_path_compatible_iff] at h
  push Not at h
  obtain ⟨j, hj, hinvalid⟩ := h
  exact prod_eq_zero hj (physical_residue_vertex_weight_zero_of_invalid
    (labels j) (q j) (physicalTranslateResidues r (offset j)) hinvalid)




end Compatibility
end Bounty
end

section

/- The actual ordered Q slots in the microscopic bands and their harmonic mass. -/

open Finset

namespace Bounty

noncomputable def candidateMicroQIndices (c L : ℝ) (J : ℕ) : Finset ℕ :=
  (candidateQIndices c L).filter (fun j => J ≤ j)

noncomputable def candidateMicroQSlotChoices (c L : ℝ) (r jStar J : ℕ)
    (slot : (candidateMicroQIndices c L J) × Fin r) : Finset ℕ :=
  if slot.1.val = jStar ∧ slot.2.val = 0 then candidateRoughBand c L jStar
  else candidateQBand (c*L) slot.1.val

noncomputable def candidateMicroQWeight (c L : ℝ) (r jStar J n : ℕ) : ℝ :=
  orderedSlotWeight (candidateMicroQSlotChoices c L r jStar J)
    ((r.factorial : ℝ)^(candidateMicroQIndices c L J).card) n

noncomputable def candidateMicroQHarmonicMass (c L : ℝ) (r jStar J : ℕ) : ℝ :=
  ∑' n : ℕ, candidateMicroQWeight c L r jStar J n / (n : ℝ)

noncomputable def candidateQBandHarmonicFactor (c L : ℝ) (r jStar j : ℕ) : ℝ :=
  (∏ k : Fin r, ∑ p ∈ (if j = jStar ∧ k.val = 0 then candidateRoughBand c L jStar
    else candidateQBand (c*L) j), 1/(p : ℝ)) / (r.factorial : ℝ)

theorem candidate_micro_Q_weight_nonneg (c L : ℝ) (r jStar J n : ℕ) :
    0 ≤ candidateMicroQWeight c L r jStar J n :=
  ordered_slot_weight_nonneg _ (by positivity) n

theorem candidate_micro_Q_harmonic_nonneg (c L : ℝ) (r jStar J : ℕ) :
    0 ≤ candidateMicroQHarmonicMass c L r jStar J :=
  tsum_nonneg (fun n => div_nonneg (candidate_micro_Q_weight_nonneg c L r jStar J n) (Nat.cast_nonneg n))

theorem candidate_Q_harmonic_eq_band_factors (c L : ℝ) (r jStar : ℕ) :
    candidateQHarmonicMass c L r jStar =
      ∏ j ∈ candidateQIndices c L, candidateQBandHarmonicFactor c L r jStar j := by
  rw [candidate_Q_harmonic_eq_group_product]
  exact prod_coe_sort _ (candidateQBandHarmonicFactor c L r jStar)

theorem candidate_micro_Q_harmonic_eq_band_factors (c L : ℝ) (r jStar J : ℕ) :
    candidateMicroQHarmonicMass c L r jStar J =
      ∏ j ∈ candidateMicroQIndices c L J, candidateQBandHarmonicFactor c L r jStar j := by
  classical
  unfold candidateMicroQHarmonicMass candidateMicroQWeight
  rw [ordered_slot_harmonic_sum, Fintype.prod_prod_type]
  have he := prod_coe_sort (candidateMicroQIndices c L J) (candidateQBandHarmonicFactor c L r jStar)
  convert he using 1
  simp only [candidateQBandHarmonicFactor, candidateMicroQSlotChoices, prod_div_distrib,
    prod_const, card_univ, Fintype.card_coe]

theorem candidate_Q_band_factor_pure (c L : ℝ) (r jStar j : ℕ) (hne : j ≠ jStar) :
    candidateQBandHarmonicFactor c L r jStar j =
      (∑ p ∈ candidateQBand (c*L) j, 1/(p : ℝ))^r / (r.factorial : ℝ) := by
  simp [candidateQBandHarmonicFactor, hne]

theorem candidate_Q_harmonic_split_micro (c L : ℝ) (r jStar J : ℕ) :
    candidateQHarmonicMass c L r jStar =
      (∏ j ∈ (candidateQIndices c L).filter (fun j => j < J),
        candidateQBandHarmonicFactor c L r jStar j) * candidateMicroQHarmonicMass c L r jStar J := by
  rw [candidate_Q_harmonic_eq_band_factors, candidate_micro_Q_harmonic_eq_band_factors]
  symm
  simpa only [candidateMicroQIndices, Nat.not_lt] using
    prod_filter_mul_prod_filter_not (candidateQIndices c L) (fun j => j < J)
      (candidateQBandHarmonicFactor c L r jStar)

end Bounty
end

