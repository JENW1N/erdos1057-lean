section
open scoped BigOperators Classical
noncomputable def finiteCoordinateChoice {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (i : I) (active : Finset I) (f : (∀ j, X j) → ℂ) : (∀ j, X j) → ℂ :=
  if i ∈ active then f - finiteCoordinateAverage μ i f else finiteCoordinateAverage μ i f

noncomputable def finiteCoordinateComponent {I : Type*} [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)] (μ : ∀ i, X i → ℝ)
    (active : Finset I) : List I → ((∀ j, X j) → ℂ) → ((∀ j, X j) → ℂ)
  | [], f => f
  | i :: is, f => finiteCoordinateChoice μ i active (finiteCoordinateComponent μ active is f)

section

variable
  {I : Type*}
  [sharedInstance1 : DecidableEq I]
  {X : I → Type*}
  [sharedInstance3 : ∀ i, Fintype (X i)]
  (μ : ∀ i, X i → ℝ)

include I sharedInstance1 X sharedInstance3 μ

theorem finite_coordinate_average_zero  (i : I) :
    finiteCoordinateAverage μ i 0 = 0 := by
  funext x
  simp only [finite_coordinate_average_update, Pi.zero_apply, mul_zero, Finset.sum_const_zero]

theorem finite_coordinate_choice_zero  (i : I) (S : Finset I) :
    finiteCoordinateChoice μ i S 0 = 0 := by
  simp only [finiteCoordinateChoice, finite_coordinate_average_zero, sub_self, ite_self]

theorem finite_coordinate_average_choice 
    (i j : I) (S : Finset I) (f : (∀ k, X k) → ℂ) :
    finiteCoordinateAverage μ i (finiteCoordinateChoice μ j S f) =
      finiteCoordinateChoice μ j S (finiteCoordinateAverage μ i f) := by
  by_cases hj : j ∈ S
  · simp only [finiteCoordinateChoice, if_pos hj, finite_coordinate_average_sub]
    rw [finite_coordinate_average_commute μ i j]
  · simp only [finiteCoordinateChoice, if_neg hj]
    exact finite_coordinate_average_commute μ i j f

theorem finite_coordinate_component_congr 
    (S T : Finset I) (is : List I) (h : ∀ i ∈ is, (i ∈ S ↔ i ∈ T))
    (f : (∀ j, X j) → ℂ) :
    finiteCoordinateComponent μ S is f = finiteCoordinateComponent μ T is f := by
  induction is with
  | nil => rfl
  | cons i is ih =>
    simp only [finiteCoordinateComponent]
    rw [ih (fun j hj => h j (List.mem_cons_of_mem _ hj))]
    simp only [finiteCoordinateChoice, h i (List.mem_cons_self)]

theorem finite_coordinate_component_average 
    (hmass : ∀ i, ∑ y, μ i y = 1) (S : Finset I) (is : List I) (i : I)
    (hi : i ∈ is) (f : (∀ j, X j) → ℂ) :
    finiteCoordinateAverage μ i (finiteCoordinateComponent μ S is f) =
      if i ∈ S then 0 else finiteCoordinateComponent μ S is f := by
  induction is with
  | nil => simp only [List.not_mem_nil] at hi
  | cons j js ih =>
    by_cases hij : i = j
    · subst j
      by_cases his : i ∈ S
      · simp only [finiteCoordinateComponent, finiteCoordinateChoice, if_pos his]
        exact finite_coordinate_average_complement_zero μ i (hmass i) _
      · simp only [finiteCoordinateComponent, finiteCoordinateChoice, if_neg his]
        exact finite_coordinate_average_idempotent μ i (hmass i) _
    · have hit : i ∈ js := (List.mem_cons.mp hi).resolve_left hij
      rw [finiteCoordinateComponent, finite_coordinate_average_choice, ih hit]
      by_cases his : i ∈ S
      · simp only [if_pos his, finite_coordinate_choice_zero]
      · simp only [if_neg his]

end

end

section
open Finset
theorem finite_block_sieve {Ω : Type*} (J : Finset ℕ) (B : ℕ → Finset ℕ)
    (T : Finset Ω) (μ : Ω → ℝ) (x : Ω → ℕ → ℝ) (g r : ℕ → ℝ)
    {z X C η : ℝ} {h : ℕ} (hz : 1 ≤ z) (hX : 0 ≤ X) (hC : 0 ≤ C)
    (hη : 0 < η) (hh : 1 ≤ h) (heven : Even h)
    (hdisj : (J : Set ℕ).PairwiseDisjoint B)
    (hprime : ∀ j ∈ J, ∀ p ∈ B j, p.Prime)
    (hsize : ∀ j ∈ J, ∀ p ∈ B j, Real.log (p : ℝ) ≤ Real.log z / (2 : ℝ)^j)
    (hμ : ∀ t ∈ T, 0 ≤ μ t)
    (hx : ∀ t ∈ T, ∀ p ∈ J.biUnion B, 0 ≤ x t p ∧ x t p ≤ 1)
    (hg : ∀ j ∈ J, ∀ p ∈ B j, 0 ≤ g p ∧ g p ≤ 1 - η)
    (hsum : ∀ j ∈ J, (∑ p ∈ B j, g p) ≤ C)
    (hmoment : ∀ S ∈ (J.biUnion B).powerset,
      (∑ t ∈ T, μ t * ∏ p ∈ S, x t p) = X * (∏ p ∈ S, g p) + r (∏ p ∈ S, p)) :
    |(∑ t ∈ T, μ t * ∏ p ∈ J.biUnion B, (1 - x t p)) -
        X * (∏ p ∈ J.biUnion B, (1 - g p))| ≤
      X * (∏ p ∈ J.biUnion B, (1 - g p)) * blockSieveModelErrorConstant C η *
        Real.exp (-(h : ℝ)) + ∑ d ∈ blockSieveModuli (J.biUnion B) (z^(4 * (h : ℝ) + 2)), |r d| := by
  classical
  let P := J.biUnion B
  let cap := fun j => (j + 1) * h
  let a := blockSieveSubsetUpperCoefficient J B cap
  let b := blockSieveSubsetLowerCoefficient J B cap
  let A := ∏ p ∈ P, (1 - g p)
  let E := A * blockSieveModelErrorConstant C η * Real.exp (-(h : ℝ))
  let D := z^(4 * (h : ℝ) + 2)
  let R := ∑ d ∈ blockSieveModuli P D, |r d|
  have hP : ∀ p ∈ P, p.Prime := by
    intro p hp
    obtain ⟨j, hj, hp⟩ := mem_biUnion.mp hp
    exact hprime j hj p hp
  have haeq (w : ℕ → ℝ) : subsetPolynomial P a w = blockSieveUpper J B w cap :=
    (block_sieve_upper_expansion J B w cap hdisj).symm
  have hbeq (w : ℕ → ℝ) : subsetPolynomial P b w = blockSieveLower J B w cap :=
    (block_sieve_lower_expansion J B w cap hdisj).symm
  have hA : (∏ j ∈ J, ∏ p ∈ B j, (1 - g p)) = A := (prod_biUnion hdisj).symm
  have hmodel := block_sieve_model_bounds hη hC hh heven J B g hg hsum
  dsimp only at hmodel
  rw [hA] at hmodel
  have hma : |subsetPolynomial P a g - A| ≤ E := by rw [haeq]; exact hmodel.2.2.1
  have hmb : |subsetPolynomial P b g - A| ≤ E := by rw [hbeq]; exact hmodel.2.2.2
  have hla : ∀ S ∈ P.powerset, a S ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D := by
    intro S _ hS
    simpa only [Nat.cast_prod] using
      (block_sieve_upper_coefficient_level J B S h hz hdisj hprime hsize hS).2
  have hlb : ∀ S ∈ P.powerset, b S ≠ 0 → ((∏ p ∈ S, p : ℕ) : ℝ) ≤ D := by
    intro S _ hS
    simpa only [Nat.cast_prod] using
      (block_sieve_lower_coefficient_level J B S h hz hdisj hprime hsize hS).2
  have herra := subset_polynomial_average_error_level P T a r μ x g X D hP
    (fun S _ => abs_block_sieve_subset_upper_coefficient_le_one J B cap S) hla hmoment
  have herrb := subset_polynomial_average_error_level P T b r μ x g X D hP
    (fun S _ => abs_block_sieve_subset_lower_coefficient_le_one J B cap S) hlb hmoment
  have hpoint : ∀ t ∈ T,
      subsetPolynomial P b (x t) ≤ (∏ p ∈ P, (1 - x t p)) ∧
      (∏ p ∈ P, (1 - x t p)) ≤ subsetPolynomial P a (x t) := by
    intro t ht
    rw [haeq, hbeq]
    have hs := block_sieve_sandwich J B (x t) cap
      (fun j hj p hp => hx t ht p (mem_biUnion.mpr ⟨j, hj, hp⟩))
      (fun j _ => heven.mul_left (j + 1))
    simpa only [P, prod_biUnion hdisj] using hs
  have hfinal := subset_polynomial_sandwich_transfer P T a b μ
    (fun t => ∏ p ∈ P, (1 - x t p)) x g X A E R hμ hX hpoint hma hmb herra herrb
  exact hfinal.trans_eq (by dsimp only [E, A, R, P, D]; ring)
end

