  have h2 := hB 2
  have h3 := hB 3
  have h4 := hB 4
  refine ⟨B 0 * B 1 * B 2 * B 3 * B 4, by positivity, ?_⟩
  intro z ud ue uv kap
  simp only [outerWindow, norm_mul]
  gcongr
  all_goals first | positivity | apply hbound




