  (ζ : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K) → ℝ)
  (coeff : ∀ key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K),
    PhysicalMarkLists P J ell → PhysicalMarkLists P J ell → PhysicalAuxLabels P (C key.2.1) → ℂ)

noncomputable def physicalEffectivePlanCoefficientPhase
    (ks : List (Option (V ⊕ K))) (L : PhysicalMarkLists Ps J ell)
    (pl : PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks)
    (x : PhysicalFullBoundedState P J ell B)
    (p : PhysicalEffectivePlannedBigPath C k B ks L pl x) : ℂ :=
  let Cb := fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K) => C key.2.1
  let kb := fun key : PhysicalMixedBigKey (Ps := Ps) (J := J) (ell := ell) (I := I) (K := K) =>
    k key.1 key.2.1 * (physicalSharedProduct (physicalSharedPrefix key.2.2.1) : ℕ)
  finiteEventLocalPhase
    (FullPermutationMixedEvent (fun g (p : P g) => p.val)
      (fun key g => physicalFullSharedIndices (ell := ell) (Cb key g)) B
      (fun key _ => PhysicalAuxLabels P (Cb key))
      (fun key => physicalFullEdgeDelta (Cb key) (kb key))
      (fun key => physicalFullEdgeD (Cb key)))
    (fullPermutationMixedEventTarget (fun g (p : P g) => p.val)
      (fun key g => physicalFullSharedIndices (ell := ell) (Cb key g)) B
      (fun key _ => PhysicalAuxLabels P (Cb key))
      (fun key => physicalFullEdgeDelta (Cb key) (kb key))
      (fun key => physicalFullEdgeD (Cb key)))
    (physicalFullKeyCoefficientPhase Cb kb ζ coeff)
    (physicalMixedBigSteps ks L pl) x p

theorem physical_effective_coefficient_plan_cast
    (ks : List (Option (V ⊕ K)))
    {a b : PhysicalMarkLists Ps J ell ×
      PhysicalMixedSmallPlan (Ps := Ps) (J := J) (ell := ell) (I := I) ks}
    (h : a = b) (x : PhysicalFullBoundedState P J ell B)
    (p : PhysicalEffectivePlannedBigPath C k B ks a.1 a.2 x) :
    physicalEffectivePlanCoefficientPhase C k B ζ coeff ks b.1 b.2 x
        (physicalEffectivePlanPathCastEquiv C k B ks h x p) =
      physicalEffectivePlanCoefficientPhase C k B ζ coeff ks a.1 a.2 x p := by
  cases h
  rfl

