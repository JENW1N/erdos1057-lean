section ResiduePath
variable {N J ell n : ℕ} {P : Fin N → Finset ℕ}
  (C : Fin n → Fin N → Finset (Fin J)) (aux : ∀ j, PhysicalAuxLabels P (C j))
  (k : Fin n → ℤ) (L : Fin (n + 1) → PhysicalMarkLists P J ell)
  (a : Fin (n + 1) → ℤ) (σ τ : Fin n → PhysicalPermutations (Fin N) J ell)
  (hstep : ∀ j : Fin n, a j.succ = a j.castSucc +
    k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hcompat : ∀ j : Fin n, ∀ g s t,
    ((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val =
      ((physicalPermuteLabels (τ j) (L j.succ)) g t).val →
    (((physicalPermuteLabels (σ j) (L j.castSucc)) g s).val : ℤ) ∣
      k j * (physicalD (C j) (physicalPermuteLabels (σ j) (L j.castSucc)) (aux j) : ℤ))
  (hlist : ∀ j : Fin n, physicalListAdmissible (C j) (aux j)
    (physicalPermuteLabels (σ j) (L j.castSucc))
    (physicalPermuteLabels (τ j) (L j.succ)))
  (hP : ∀ g p, p ∈ P g → Nat.Prime p)
  (hdis : Pairwise (fun g h => Disjoint (P g) (P h)))
  (hk : ∀ j : Fin n, ∀ g s, ¬ ((L j.castSucc g s).val : ℤ) ∣ k j)
  (β : (g : Fin N) → ↥(P g) → ℝ) (η : Fin N → Fin (n + 1) → ℝ)
  (V : Fin N → ℝ) (ρ : ℝ) (hV : ∀ g, V g ≠ 0) (B : ℕ)

variable
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (retention : Fin (n + 1) → ℝ)

include hstep in
theorem physical_selected_coarse_adjacent_extension (i : ℕ) (hi : i < 2 * n + 1)
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalMarkRawExtension
      (physicalSelectedCoarseRow (B := B) C aux k L σ τ β V ρ hV ω retention i F)
      (physicalMarkAtCut L i) =
      fun s => physicalSelectedCoarseScalar C aux L σ ω i *
        globalBirthJointCutRawRow
          (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β
            (fun _ j => 1 - retention j) V (fun _ => ρ) hV B i) B B
          (physicalMarkRawExtension F (physicalMarkAtCut L (i + 1))) s := by
  by_cases he : i % 2 = 0
  · let j : Fin (n + 1) := ⟨i / 2, by omega⟩
    have hiEq : i = 2 * j.val := by dsimp [j]; omega
    rw [hiEq, physical_selected_coarse_row_even,
      physical_mark_at_cut_even, physical_mark_at_cut_odd, physical_selected_coarse_scalar_even]
    simp only [one_mul]
    exact physical_selected_adjacent_visit_extension C aux k L a σ τ hcompat
      hlist hP hdis hk β V ρ hV B ω retention j F
  · let j : Fin n := ⟨i / 2, by omega⟩
    have hiEq : i = 2 * j.val + 1 := by dsimp [j]; omega
    have hnext : 2 * j.val + 1 + 1 = 2 * j.succ.val := by simp only [Fin.val_succ]; omega
    have hsource : physicalMarkAtCut L (2 * j.val + 1) = L j.castSucc :=
      physical_mark_at_cut_odd L j.castSucc
    have htarget : physicalMarkAtCut L (2 * j.val + 1 + 1) = L j.succ := by
      rw [hnext, physical_mark_at_cut_even]
    rw [hiEq, physical_selected_coarse_row_odd, hsource, htarget,
      physical_selected_coarse_scalar_odd]
    exact physical_selected_adjacent_edge_extension C aux k L a σ τ hstep hcompat
      hlist hP hdis hk β (fun _ j => 1 - retention j) V ρ hV B ω retention j F

include hstep in
theorem physical_selected_coarse_adjacent_composition
    (F : PhysicalBoundedMarkState P J ell B → ℂ) :
    physicalMarkRawExtension
      (finiteRowComposition (S := fun _ => PhysicalBoundedMarkState P J ell B)
        (physicalSelectedCoarseRow (B := B) C aux k L σ τ β V ρ hV ω retention) (2 * n + 1) F)
      (L 0) =
      finiteRowComposition (S := fun _ => GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val))
        (fun i G s => physicalSelectedCoarseScalar C aux L σ ω i *
          globalBirthJointCutRawRow
            (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β
              (fun _ j => 1 - retention j) V (fun _ => ρ) hV B i) B B G s)
        (2 * n + 1) (physicalMarkRawExtension F (L (Fin.last n))) := by
  have h := finite_row_composition_test_maps
    (S := fun _ => GlobalBirthJointState (fun g (p : ↥(P g)) => ZMod p.val))
    (T := fun _ => PhysicalBoundedMarkState P J ell B)
    (fun i G s => physicalSelectedCoarseScalar C aux L σ ω i *
      globalBirthJointCutRawRow
        (physicalJointAdjacentStep C aux k L a σ τ hcompat hlist hP hdis hk β
          (fun _ j => 1 - retention j) V (fun _ => ρ) hV B i) B B G s)
    (physicalSelectedCoarseRow (B := B) C aux k L σ τ β V ρ hV ω retention)
    (fun i G => physicalMarkRawExtension G (physicalMarkAtCut L i)) (2 * n + 1)
    (fun i hi G => physical_selected_coarse_adjacent_extension C aux k L a σ τ hstep hcompat
      hlist hP hdis hk β V ρ hV B ω retention i hi G) F
  have hfirst : physicalMarkAtCut L 0 = L 0 := by
    simpa using physical_mark_at_cut_even L (0 : Fin (n + 1))
  have hlast : physicalMarkAtCut L (2 * n + 1) = L (Fin.last n) := by
    simpa using physical_mark_at_cut_odd L (Fin.last n)
  simpa only [hfirst, hlast] using h

end ResiduePath
end Bounty
