namespace Bounty

universe uK uX uY uE uF

noncomputable def finiteSafePathPhase {K : Type uK} {X : Type uX} {Y : Type uY}
    (E : K → X → Type uE) (F : K → Y → Type uF)
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (w : ∀ k x, E k x → ℝ) (v : ∀ k y, F k y → ℝ)
    (height : Y → ℕ) (b : ℕ) (e : X → Y) (P : X → Prop)
    (closed : ∀ k x, P x → ∀ a : FiniteNonzeroEvent E w k x, P (t k x a.val))
    (δ : ∀ k x, P x → FiniteNonzeroEvent E w k x ≃
      FiniteSelectedEvent F (finiteSafeEventPredicate F u v height b) k (e x))
    (ht : ∀ k x (hx : P x) a, e (t k x a.val) = u k (e x) (δ k x hx a).val)
    (ks : List K) (phase : ∀ y, FiniteEventPath F u ks y → ℂ) :
    ∀ x, FiniteEventPath E t ks x → ℂ :=
  finiteSupportedPathPhase E F t u w (finiteSafeEventPredicate F u v height b)
    e P closed δ ht ks phase




theorem finite_safe_path_action_transport {K : Type uK} {X : Type uX} {Y : Type uY}
    (E : K → X → Type uE) (F : K → Y → Type uF)
    [∀ k x, Fintype (E k x)] [∀ k y, Fintype (F k y)]
    (t : ∀ k x, E k x → X) (u : ∀ k y, F k y → Y)
    (w : ∀ k x, E k x → ℝ) (v : ∀ k y, F k y → ℝ)
    (height : Y → ℕ) (b : ℕ) (e : X → Y) (P : X → Prop)
    (closed : ∀ k x, P x → ∀ a : FiniteNonzeroEvent E w k x, P (t k x a.val))
    (δ : ∀ k x, P x → FiniteNonzeroEvent E w k x ≃
      FiniteSelectedEvent F (finiteSafeEventPredicate F u v height b) k (e x))
    (ht : ∀ k x (hx : P x) a, e (t k x a.val) = u k (e x) (δ k x hx a).val)
    (hw : ∀ k x (hx : P x) a, v k (e x) (δ k x hx a).val = w k x a.val)
    (ks : List K) (phase : ∀ y, FiniteEventPath F u ks y → ℂ)
    (f : Y → ℂ) (x : X) (hx : P x) (hheight : height (e x) ≤ b) :
    finiteEventPathAction E t w ks
        (finiteSafePathPhase E F t u w v height b e P closed δ ht ks phase)
        (fun x => f (e x)) x =
      finiteEventPathAction F u v ks
        (fun y p => if finiteEventPathMaximum F u height ks y p ≤ b then phase y p else 0)
        f (e x) := by
  let Q := finiteSafeEventPredicate F u v height b
  let _ : ∀ k y, Fintype (FiniteSelectedEvent F Q k y) := finiteSelectedEventFintype F Q
  exact (finite_supported_path_action_transport E F t u w v Q e P closed δ ht hw
    ks phase f x hx).trans
      ((finite_event_path_action_selected F u Q v ks phase f (e x)).trans
        (finite_event_path_action_safe F u v height b ks phase f (e x) hheight).symm)

theorem finite_event_path_action_sub_safe {K : Type uK} {X : Type uX}
    (E : K → X → Type uE) [∀ k x, Fintype (E k x)]
    (t : ∀ k x, E k x → X) (w : ∀ k x, E k x → ℝ)
    (height : X → ℕ) (b : ℕ) (ks : List K)
    (phase : ∀ x, FiniteEventPath E t ks x → ℂ) (f : X → ℂ) (x : X) :
    finiteEventPathAction E t w ks phase f x -
      finiteEventPathAction E t w ks
        (fun x p => if finiteEventPathMaximum E t height ks x p ≤ b then phase x p else 0) f x =
      finiteEventPathAction E t w ks
        (fun x p => if b < finiteEventPathMaximum E t height ks x p then phase x p else 0) f x := by
  unfold finiteEventPathAction
  rw [← sum_sub_distrib]
  apply sum_congr rfl
  intro p _
  by_cases hp : finiteEventPathMaximum E t height ks x p ≤ b
  · simp only [if_pos hp, if_neg (not_lt.mpr hp), mul_zero, zero_mul, sub_self]
  · simp only [if_neg hp, if_pos (Nat.lt_of_not_ge hp), mul_zero, zero_mul, sub_zero]

end Bounty
end

section

/- Bilinear large-sieve bounds retaining a two-sided hyperbolic product window. -/

open Finset

namespace Bounty

theorem dyadic_product_prefix_filter (K X m : ℕ) (hm : 0 < m)
    (T : Finset ℕ) (hT : T ⊆ range (2 ^ K)) :
    (range (min (2 ^ K) (X / m + 1))).filter (fun n => n ∈ T) =
      T.filter (fun n => m * n ≤ X) := by
  ext n
  simp only [mem_filter, mem_range, lt_min_iff, Nat.lt_succ_iff]
  constructor
  · rintro ⟨⟨_, hn⟩, hnT⟩
    refine ⟨hnT, ?_⟩
    simpa only [Nat.mul_comm] using (Nat.le_div_iff_mul_le hm).mp hn
  · rintro ⟨hnT, hprod⟩
    refine ⟨⟨mem_range.mp (hT hnT), ?_⟩, hnT⟩
    exact (Nat.le_div_iff_mul_le hm).mpr (by simpa only [Nat.mul_comm] using hprod)

theorem multiplicative_large_sieve_product_upper (Q : Finset ℕ) {D R N V : ℝ}
    (hD : 0 < D) (hR : 1 ≤ R)
    (hQD : ∀ q ∈ Q, D ≤ (q : ℝ)) (hQR : ∀ q ∈ Q, (q : ℝ) ≤ R)
    (K X : ℕ) (S T : Finset ℕ) (hSpos : ∀ m ∈ S, 0 < m)
    (hT : T ⊆ range (2 ^ K)) (a b : ℕ → ℂ) (hN : 0 ≤ N) (hV : 0 ≤ V)
    (hS : ∀ m ∈ S, (m : ℝ) ≤ N) (hcol : ∀ n ∈ range (2 ^ K), (n : ℝ) ≤ V) :
    (∑ q ∈ Q, 1 / (q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q,
      ‖∑ m ∈ S, ∑ n ∈ T.filter (fun n => m * n ≤ X),
        a m * b n * χ ((m * n : ℕ) : ZMod q)‖) ≤
      (K + 1 : ℝ) * ((6 + 8 * Real.pi) / D) *
        Real.sqrt ((N + R ^ 2) * (V + R ^ 2) *
          (∑ m ∈ S, ‖a m‖ ^ 2) * ∑ n ∈ T, ‖b n‖ ^ 2) := by
  classical
  let κ : ℕ → ℕ := fun m => min (2 ^ K) (X / m + 1)
  let b' : ℕ → ℂ := fun n => if n ∈ T then b n else 0
  have henergy : (∑ n ∈ range (2 ^ K), ‖b' n‖ ^ 2) = ∑ n ∈ T, ‖b n‖ ^ 2 := by
    calc
      _ = ∑ n ∈ T, ‖b' n‖ ^ 2 := by
        symm
        apply sum_subset hT
        intro n hn hnT
        simp [b', hnT]
      _ = _ := sum_congr rfl (fun n hn => by simp [b', hn])
  have hrow (q : ℕ) (χ : DirichletCharacter ℂ q) (m : ℕ) (hm : m ∈ S) :
      (∑ n ∈ range (κ m), a m * b' n * χ ((m * n : ℕ) : ZMod q)) =
        ∑ n ∈ T.filter (fun n => m * n ≤ X),
          a m * b n * χ ((m * n : ℕ) : ZMod q) := by
    simp only [b', mul_ite, ite_mul, mul_zero, zero_mul]
    rw [← sum_filter]
    rw [dyadic_product_prefix_filter K X m (hSpos m hm) T hT]
  have h := multiplicative_large_sieve_dyadic_prefix Q hD hR hQD hQR K S κ
    (fun m _ => min_le_left _ _) a b' hN hV hS hcol
  rw [henergy] at h
  convert h using 1
  apply sum_congr rfl
  intro q hq
  congr 1
  apply sum_congr rfl
  intro χ hχ
  congr 1
  symm
  exact sum_congr rfl (hrow q χ)


theorem sum_product_window_eq_sub {E : Type*} [AddCommGroup E]
    (A B : ℕ) (hAB : A ≤ B) (T : Finset ℕ) (m : ℕ) (w : ℕ → E) :
    (∑ n ∈ T.filter (fun n => A < m * n ∧ m * n ≤ B), w n) =
      (∑ n ∈ T.filter (fun n => m * n ≤ B), w n) -
        ∑ n ∈ T.filter (fun n => m * n ≤ A), w n := by
  have hset : T.filter (fun n => A < m * n ∧ m * n ≤ B) =
      T.filter (fun n => m * n ≤ B) \ T.filter (fun n => m * n ≤ A) := by
    ext n
    simp only [mem_filter, mem_sdiff]
    constructor
    · rintro ⟨hnT, hnA, hnB⟩
      exact ⟨⟨hnT, hnB⟩, fun h => (not_le_of_gt hnA) h.2⟩
    · rintro ⟨⟨hnT, hnB⟩, hnA⟩
      exact ⟨hnT, Nat.lt_of_not_ge (fun h => hnA ⟨hnT, h⟩), hnB⟩
  rw [hset, sum_sdiff_eq_sub]
  intro n hn
  obtain ⟨hnT, hnA⟩ := mem_filter.mp hn
  exact mem_filter.mpr ⟨hnT, hnA.trans hAB⟩

theorem multiplicative_large_sieve_product_window (Q : Finset ℕ) {D R N V : ℝ}
    (hD : 0 < D) (hR : 1 ≤ R)
    (hQD : ∀ q ∈ Q, D ≤ (q : ℝ)) (hQR : ∀ q ∈ Q, (q : ℝ) ≤ R)
    (K A B : ℕ) (S T : Finset ℕ) (hSpos : ∀ m ∈ S, 0 < m)
    (hT : T ⊆ range (2 ^ K)) (a b : ℕ → ℂ) (hN : 0 ≤ N) (hV : 0 ≤ V)
    (hS : ∀ m ∈ S, (m : ℝ) ≤ N) (hcol : ∀ n ∈ range (2 ^ K), (n : ℝ) ≤ V) :
    (∑ q ∈ Q, 1 / (q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q,
      ‖∑ m ∈ S, ∑ n ∈ T.filter (fun n => A < m * n ∧ m * n ≤ B),
        a m * b n * χ ((m * n : ℕ) : ZMod q)‖) ≤
      2 * (K + 1 : ℝ) * ((6 + 8 * Real.pi) / D) *
        Real.sqrt ((N + R ^ 2) * (V + R ^ 2) *
          (∑ m ∈ S, ‖a m‖ ^ 2) * ∑ n ∈ T, ‖b n‖ ^ 2) := by
  by_cases hAB : A ≤ B
  · have hdiff (q : ℕ) (χ : DirichletCharacter ℂ q) :
        (∑ m ∈ S, ∑ n ∈ T.filter (fun n => A < m * n ∧ m * n ≤ B),
          a m * b n * χ ((m * n : ℕ) : ZMod q)) =
        (∑ m ∈ S, ∑ n ∈ T.filter (fun n => m * n ≤ B),
          a m * b n * χ ((m * n : ℕ) : ZMod q)) -
        (∑ m ∈ S, ∑ n ∈ T.filter (fun n => m * n ≤ A),
          a m * b n * χ ((m * n : ℕ) : ZMod q)) := by
      rw [← sum_sub_distrib]
      apply sum_congr rfl
      intro m hm
      exact sum_product_window_eq_sub A B hAB T m _
    have htri :
        (∑ q ∈ Q, 1 / (q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q,
          ‖∑ m ∈ S, ∑ n ∈ T.filter (fun n => A < m * n ∧ m * n ≤ B),
            a m * b n * χ ((m * n : ℕ) : ZMod q)‖) ≤
        (∑ q ∈ Q, 1 / (q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q,
          ‖∑ m ∈ S, ∑ n ∈ T.filter (fun n => m * n ≤ B),
            a m * b n * χ ((m * n : ℕ) : ZMod q)‖) +
        (∑ q ∈ Q, 1 / (q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q,
          ‖∑ m ∈ S, ∑ n ∈ T.filter (fun n => m * n ≤ A),
            a m * b n * χ ((m * n : ℕ) : ZMod q)‖) := by
      rw [← sum_add_distrib]
      apply sum_le_sum
      intro q hq
      rw [← mul_add, ← sum_add_distrib]
      apply mul_le_mul_of_nonneg_left _ (by positivity)
      apply sum_le_sum
      intro χ hχ
      rw [hdiff]
      exact norm_sub_le _ _
    have hB := multiplicative_large_sieve_product_upper Q hD hR hQD hQR
      K B S T hSpos hT a b hN hV hS hcol
    have hA := multiplicative_large_sieve_product_upper Q hD hR hQD hQR
      K A S T hSpos hT a b hN hV hS hcol
    have h := htri.trans (add_le_add hB hA)
    nlinarith only [h]
  · have hempty (m : ℕ) : T.filter (fun n => A < m * n ∧ m * n ≤ B) = ∅ := by
      apply filter_eq_empty_iff.mpr
      intro n hn
      omega
    simp only [hempty, sum_empty, sum_const_zero, norm_zero, mul_zero]
    positivity

theorem multiplicative_large_sieve_product_window_real (Q : Finset ℕ) {D R N V A B : ℝ}
    (hD : 0 < D) (hR : 1 ≤ R)
    (hQD : ∀ q ∈ Q, D ≤ (q : ℝ)) (hQR : ∀ q ∈ Q, (q : ℝ) ≤ R)
    (hA : 0 ≤ A) (hB : 0 ≤ B)
    (K : ℕ) (S T : Finset ℕ) (hSpos : ∀ m ∈ S, 0 < m)
    (hT : T ⊆ range (2 ^ K)) (a b : ℕ → ℂ) (hN : 0 ≤ N) (hV : 0 ≤ V)
    (hS : ∀ m ∈ S, (m : ℝ) ≤ N) (hcol : ∀ n ∈ range (2 ^ K), (n : ℝ) ≤ V) :
    (∑ q ∈ Q, 1 / (q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q,
      ‖∑ m ∈ S, ∑ n ∈ T.filter (fun n : ℕ => A < (m : ℝ) * (n : ℝ) ∧ (m : ℝ) * (n : ℝ) ≤ B),
        a m * b n * χ ((m * n : ℕ) : ZMod q)‖) ≤
      2 * (K + 1 : ℝ) * ((6 + 8 * Real.pi) / D) *
        Real.sqrt ((N + R ^ 2) * (V + R ^ 2) *
          (∑ m ∈ S, ‖a m‖ ^ 2) * ∑ n ∈ T, ‖b n‖ ^ 2) := by
  have h := multiplicative_large_sieve_product_window Q hD hR hQD hQR
    K ⌊A⌋₊ ⌊B⌋₊ S T hSpos hT a b hN hV hS hcol
  simpa only [Nat.floor_lt hA, Nat.le_floor_iff hB, Nat.cast_mul] using h


end Bounty
end

section

/- The physical edge with every target list and auxiliary draw is one
unified full-state row. Its globally extended phase is bounded everywhere. -/

open Finset
open scoped Classical
namespace Bounty

section Physical
variable {I K : Type*} {N J ell B : ℕ} {P : Fin N → Finset ℕ}
  [∀ g, ∀ p : ↥(P g), NeZero p.val]
  (C : K → Fin N → Finset (Fin J)) (k : K → ℤ)
  (ω : ∀ j, SharedActiveLabels (fun g => ↥(P g))
    (fun g => physicalFullSharedIndices (ell := ell) (C j g)) → PhysicalAuxLabels P (C j) → ℝ)
  (β : (g : Fin N) → ↥(P g) → ℝ) (retention : I → ℝ) (ρ : ℝ) (V : Fin N → ℝ)

noncomputable def physicalFullObservedRow (before after : Fin N → Finset (Fin J)) : Option (I ⊕ K) →
    (PhysicalMarkObservation P ell C →
      FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ) →
    FullMixedLedgerState (fun g (p : ↥(P g)) => p.val) (M := fun _ => J + ell) B → ℂ :=
  fullMixedObservedRow (fun g (p : ↥(P g)) => p.val)
    (fun j g => physicalFullSharedIndices (C j g)) B (fun j _ => PhysicalAuxLabels P (C j))
    (fun j => physicalFullEdgeDelta (C j) (k j)) (fun j => physicalFullEdgeD (C j))
    (fun j H x e => physicalFullGlobalEdgePhase (C j) (k j) H (ω j)
      (fun g p => β g p / V g) ρ V x e) ω (fun g p => β g p / V g) retention ρ V
      (physicalFullEventObservation C k before after)

end Physical
end Bounty
end

section

/- Finite dyadic assembly for primitive character norms and complementary moduli. -/

open Finset

namespace Bounty

theorem primitiveCharacterBlockNorm_dyadic_moduli (Q : Finset ℕ)
    (V : (q : ℕ) → DirichletCharacter ℂ q → ℂ) :
    primitiveCharacterBlockNorm Q V =
      ∑ k ∈ dyadicNatIndices Q, primitiveCharacterBlockNorm (dyadicNatBucket Q k) V := by
  exact (sum_dyadicNatBuckets Q
    (fun q => 1 / (q.totient : ℝ) * ∑ χ ∈ primitiveCharacters q, ‖V q χ‖)).symm

theorem primitiveCharacterBlockNorm_le_dyadic_blocks (Q S T : Finset ℕ)
    (F : ℕ → ℕ → (q : ℕ) → DirichletCharacter ℂ q → ℂ) {B : ℝ}
    (hblock : ∀ k ∈ dyadicNatIndices Q, ∀ i ∈ dyadicNatIndices S,
      ∀ j ∈ dyadicNatIndices T,
      primitiveCharacterBlockNorm (dyadicNatBucket Q k)
        (∑ m ∈ dyadicNatBucket S i, ∑ n ∈ dyadicNatBucket T j, F m n) ≤ B) :
    primitiveCharacterBlockNorm Q (∑ m ∈ S, ∑ n ∈ T, F m n) ≤
      ((dyadicNatIndices Q).card : ℝ) * (dyadicNatIndices S).card *
        (dyadicNatIndices T).card * B := by
  rw [primitiveCharacterBlockNorm_dyadic_moduli]
  calc
    _ ≤ ∑ k ∈ dyadicNatIndices Q, ∑ i ∈ dyadicNatIndices S,
        ∑ j ∈ dyadicNatIndices T, B := by
      apply sum_le_sum
      intro k hk
      rw [← sum_dyadicNatBuckets_bilinear S T F]
      apply (subadditive_finset_sum_le _
        (primitiveCharacterBlockNorm_zero _) (primitiveCharacterBlockNorm_add_le _) _ _).trans
      apply sum_le_sum
      intro i hi
      apply (subadditive_finset_sum_le _
        (primitiveCharacterBlockNorm_zero _) (primitiveCharacterBlockNorm_add_le _) _ _).trans
      exact sum_le_sum (fun j hj => hblock k hk i hi j hj)
    _ = _ := by simp only [sum_const, nsmul_eq_mul]; ring

theorem complementary_conductor_sum_le_character_blockNorm {Ω : Type*}
    (Q : Finset ℕ) (h : ℕ) (T : Finset Ω) (μ : Ω → ℂ) (value : Ω → ℕ)
    (V : (q : ℕ) → DirichletCharacter ℂ q → ℂ)
    (hV : ∀ f ∈ Q, ∀ χ : DirichletCharacter ℂ f,
      (∑ t ∈ T.filter (fun t => (value t).Coprime h), μ t * χ (value t : ZMod f)) = V f χ) :
    (∑ f ∈ Q, complementaryConductorNormTerm f h T μ value / (f.totient : ℝ)) ≤
      primitiveCharacterBlockNorm Q V := by
  classical
  unfold primitiveCharacterBlockNorm
  apply sum_le_sum
  intro f hf
  rw [div_eq_mul_inv, mul_comm, one_div]
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  unfold complementaryConductorNormTerm
  calc
    _ = ∑ χ ∈ (univ : Finset (DirichletCharacter ℂ f)).filter
        (fun χ => χ.IsPrimitive ∧ χ ≠ 1), ‖V f χ‖ := by
      apply sum_congr rfl
      intro χ hχ
      rw [hV f hf χ]
    _ ≤ ∑ χ ∈ primitiveCharacters f, ‖V f χ‖ := by
      apply sum_le_sum_of_subset_of_nonneg _ (fun χ _ _ => norm_nonneg _)
      intro χ hχ
      exact mem_filter.mpr ⟨mem_univ _, (mem_filter.mp hχ).2.1⟩

theorem candidate_large_mass_le_uniform_complementary (c L q : ℝ)
    (r jStar N R : ℕ) {X Y : ℝ} (hX : 1 ≤ X) (hNX : (N : ℝ) ≤ X)
    (hY : 0 ≤ Y)
    (hbound : ∀ h ∈ (Icc 1 N).filter Squarefree,
      (∑ f ∈ Icc (max 2 (R + 1)) (N / h),
        complementaryConductorNormTerm f h (arithmeticProductWindow 1 (Real.exp L))
          (fun u => (candidateCoefficient c L q r jStar u : ℂ)) (fun u => u) /
            (f.totient : ℝ)) ≤ Y) :
    candidateLargePrimitiveTypeIMass c L q r jStar N R ≤
      ((2 * primeEulerProductUpperConstant) * Real.log (2 * X)) * Y := by
  apply (candidate_large_primitive_mass_le_complementary c L q r jStar N R).trans
  calc
    _ ≤ ∑ h ∈ (Icc 1 N).filter Squarefree, (1 / (h.totient : ℝ)) * Y := by
      apply sum_le_sum
      intro h hh
      exact mul_le_mul_of_nonneg_left (hbound h hh) (by positivity)
    _ = (∑ h ∈ (Icc 1 N).filter Squarefree, 1 / (h.totient : ℝ)) * Y :=
      (sum_mul ..).symm
    _ ≤ _ := mul_le_mul_of_nonneg_right (totient_sieve_squarefree_mass_le_log N hX hNX) hY


end Bounty
end

section

/- Admissible actual components satisfy the shared-slice comparison estimate. -/

namespace Bounty

open Finset
open scoped Classical

theorem finite_admissible_component_slice_error_le {I : Type*} [Fintype I] [DecidableEq I]
    {X : I → Type*} [∀ i, Fintype (X i)]
    (μ : ∀ i, X i → ℝ) (hμ : ∀ i x, 0 ≤ μ i x) (hmass : ∀ i, ∑ x, μ i x = 1)
    (active U V S T A B : Finset I) (hU : U ⊆ active) (hV : V ⊆ active) (hUV : Disjoint U V)
    (hA : A ⊆ U \ S) (hB : B ⊆ V \ T)
    (KA : (∀ i : A, X i.1) → (∀ i : A, X i.1) → ℂ)
    (KB : (∀ i : B, X i.1) → (∀ i : B, X i.1) → ℂ)
    (phase : (∀ i : ↥(active \ (A ∪ B)), X i.1) →
      (∀ i : A, X i.1) → (∀ i : B, X i.1) → ℂ)
    (f g : (∀ i, X i) → ℂ) (ε : ℝ) (hε : 0 ≤ ε)
    (hfree : ∀ c, ∀ (u : (∀ i : A, X i.1) → ℂ) (v : (∀ i : B, X i.1) → ℂ),
      ‖finiteTwoKernelPairingError
        (finiteProductWeight (fun i : A => μ i.1)) (finiteProductWeight (fun i : B => μ i.1))
        KA KB (phase c) u v‖ ≤
      ε * Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun i : A => μ i.1)) u) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight (fun i : B => μ i.1)) v)) :
    ‖cleanRawPairing (finiteProductWeight μ)
        (fun x => phase (finiteCoordinateRestrict (active \ (A ∪ B)) x)
          (finiteCoordinateRestrict A x) (finiteCoordinateRestrict B x))
        (finiteCoordinateComponent μ S U.toList (finiteCoordinateComponent μ ∅ activeᶜ.toList f))
        (finiteCoordinateComponent μ T V.toList (finiteCoordinateComponent μ ∅ activeᶜ.toList g)) -
      cleanKernelPairing (finiteProductWeight μ)
        (finiteAsymmetricKernel μ (active \ (A ∪ B)) A B (fun c a b => finiteTwoKernelAverage
          (finiteProductWeight (fun i : A => μ i.1)) (finiteProductWeight (fun i : B => μ i.1))
          KA KB a b (phase c)))
        (finiteCoordinateComponent μ S U.toList (finiteCoordinateComponent μ ∅ activeᶜ.toList f))
        (finiteCoordinateComponent μ T V.toList (finiteCoordinateComponent μ ∅ activeᶜ.toList g))‖ ≤
      ε * Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ)
        (finiteCoordinateComponent μ S U.toList (finiteCoordinateComponent μ ∅ activeᶜ.toList f))) *
        Real.sqrt (finiteWeightedEnergy (finiteProductWeight μ)
          (finiteCoordinateComponent μ T V.toList (finiteCoordinateComponent μ ∅ activeᶜ.toList g))) := by
  have hAU : A ⊆ U := fun i hi => (mem_sdiff.mp (hA hi)).1
  have hBV : B ⊆ V := fun i hi => (mem_sdiff.mp (hB hi)).1
  have hAa : A ⊆ active := hAU.trans hU
  have hBa : B ⊆ active := hBV.trans hV
  have hAB : Disjoint A B := hUV.mono hAU hBV
  obtain ⟨hsA, hsB, hsT, _, hAT, hBT, hc⟩ := finite_active_four_partition active A B hAa hBa hAB
  obtain ⟨F, hF⟩ := finite_four_component_factors_shared_b μ hmass
    (active \ (A ∪ B)) A B activeᶜ hsA hsB hsT hAB hAT hBT hc U S hA f
  obtain ⟨G, hG⟩ := finite_four_component_factors_shared_a μ hmass
    (active \ (A ∪ B)) A B activeᶜ hsA hsB hsT hAB hAT hBT hc V T hB g
  apply finite_four_asymmetric_pairing_error_le μ hμ hmass
    (active \ (A ∪ B)) A B activeᶜ hsA hsB hsT hAB hAT hBT hc KA KB phase _ _ F G hF hG ε hε
  intro c
  simpa only [finiteWeightedEnergy, Complex.norm_conj] using
    hfree c (G c) (fun b => (starRingEnd ℂ) (F c b))

end Bounty
end

