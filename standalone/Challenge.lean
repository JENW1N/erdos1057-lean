section

/- Dyadic endpoint, cardinality, and occupied-cell bounds from polynomial logarithmic scales. -/

open scoped BigOperators Classical

namespace Bounty

theorem finite_dyadic_test_ne_zero {X : Type*} (π : X → ℕ) (f : X → ℂ)
    {j : ℕ} {x : X} (hx : finiteDyadicTest π j f x ≠ 0) : f x ≠ 0 := by
  unfold finiteDyadicTest at hx
  split_ifs at hx
  · exact hx
  · exact (hx rfl).elim

theorem finite_dyadic_endpoint_scales {X : Type*} (π : X → ℕ) (f : X → ℂ)
    (hπ : ∀ x, 0 < π x) {M H : ℝ}
    (hmin : ∀ x, f x ≠ 0 → 2 * M ≤ (π x : ℝ))
    (hmax : ∀ x, Real.log (π x) ≤ H) {j : ℕ}
    (hj : ∃ x, finiteDyadicTest π j f x ≠ 0) :
    M ≤ (2 ^ j : ℕ) ∧ Real.log (2 ^ j : ℕ) ≤ H := by
  obtain ⟨x, hx⟩ := hj
  have hfx := finite_dyadic_test_ne_zero π f hx
  have hb := finite_dyadic_test_range π f (fun x _ => hπ x) j x hx
  constructor
  · have hu : (π x : ℝ) < 2 * (2 ^ j : ℕ) := by exact_mod_cast hb.2
    linarith [hmin x hfx]
  · exact (Real.log_le_log (by positivity) (by exact_mod_cast hb.1)).trans (hmax x)

theorem finite_dyadic_card_polynomial {X : Type*} [Fintype X]
    (π : X → ℕ) (hπ : ∀ x, 0 < π x) {L s : ℝ} (hL : 4 ≤ L) (hs : 0 ≤ s)
    (hmax : ∀ x, Real.log (π x) ≤ L ^ s) :
    ((finiteDyadicIndices π).card : ℝ) ≤ L ^ (s + 1) := by
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hp1 : 1 ≤ L ^ s := Real.one_le_rpow hL1 hs
  have hlog2 : (1 : ℝ) / 2 ≤ Real.log 2 := by linarith [Real.log_two_gt_d9]
  have hbound := finite_dyadic_indices_card_le π hπ (Real.rpow_pos_of_pos hL0 s).le hmax
  have hdiv : L ^ s / Real.log 2 ≤ 2 * L ^ s := by
    apply (div_le_iff₀ (Real.log_pos (by norm_num : (1 : ℝ) < 2))).mpr
    nlinarith [mul_nonneg (Real.rpow_pos_of_pos hL0 s).le (sub_nonneg.mpr hlog2)]
  calc
    _ ≤ L ^ s / Real.log 2 + 1 := hbound
    _ ≤ 3 * L ^ s := by linarith
    _ ≤ L * L ^ s := mul_le_mul_of_nonneg_right (by linarith) (by positivity)
    _ = L ^ (s + 1) := by rw [Real.rpow_add hL0, Real.rpow_one]; ring

theorem dyadic_log_product_polynomial {U V L s : ℝ}
    (hU : 0 < U) (hV : 0 < V) (hL : 2 ≤ L)
    (hlogU : Real.log U ≤ L ^ s) (hlogV : Real.log V ≤ L ^ s) :
    Real.log (U * V) ≤ L ^ (s + 1) := by
  have hL0 : 0 < L := by linarith
  rw [Real.log_mul hU.ne' hV.ne', Real.rpow_add hL0, Real.rpow_one]
  have hm := mul_le_mul_of_nonneg_right hL (Real.rpow_pos_of_pos hL0 s).le
  nlinarith

theorem polynomial_width_le_log_two {L w : ℝ} (hL : 4 ≤ L) (hw : 1 ≤ w) :
    L ^ (-w) ≤ Real.log 2 := by
  have hL0 : 0 < L := by linarith
  calc
    _ ≤ L ^ (-(1 : ℝ)) := Real.rpow_le_rpow_of_exponent_le (by linarith) (by linarith)
    _ = 1 / L := by rw [Real.rpow_neg_one, one_div]
    _ ≤ (1 : ℝ) / 4 := one_div_le_one_div_of_le (by norm_num) hL
    _ ≤ Real.log 2 := by linarith [Real.log_two_gt_d9]

theorem two_upper_log_cell_cards_polynomial
    {X Y : Type*} [Fintype X] [Fintype Y] (p : X → ℝ) (q : Y → ℝ)
    {L s w : ℝ} (hL : 4 ≤ L) (hs : 0 ≤ s) (hw : 0 ≤ w)
    (hp : ∀ x, 0 ≤ p x ∧ p x ≤ L ^ s) (hq : ∀ y, 0 ≤ q y ∧ q y ≤ L ^ s) :
    (((finiteOccupiedCells (fun x => upperLogCell (L ^ (-w)) (p x))).card +
      (finiteOccupiedCells (fun y => upperLogCell (L ^ (-w)) (q y))).card : ℕ) : ℝ) ≤
      L ^ (s + w + 2) := by
  have hL0 : 0 < L := by linarith
  have hL1 : 1 ≤ L := by linarith
  have hh : 0 < L ^ (-w) := Real.rpow_pos_of_pos hL0 _
  have hP := upper_log_occupied_cells_card_real_le p hh (by positivity : 0 ≤ L ^ s) hp
  have hQ := upper_log_occupied_cells_card_real_le q hh (by positivity : 0 ≤ L ^ s) hq
  have he : (L ^ s - 0) / L ^ (-w) = L ^ (s + w) := by
    rw [sub_zero, ← Real.rpow_sub hL0]
    congr 1
    ring
  rw [he] at hP hQ
  have hp1 : 1 ≤ L ^ (s + w) := Real.one_le_rpow hL1 (by linarith)
  have hsq : (6 : ℝ) ≤ L ^ (2 : ℕ) := by nlinarith
  have hm := mul_le_mul_of_nonneg_right hsq (Real.rpow_pos_of_pos hL0 (s + w)).le
  push_cast
  calc
    _ ≤ 2 * L ^ (s + w) + 4 := by linarith
    _ ≤ 6 * L ^ (s + w) := by linarith
    _ ≤ L ^ (2 : ℕ) * L ^ (s + w) := hm
    _ = L ^ (s + w) * L ^ (2 : ℝ) := by rw [Real.rpow_two]; ring
    _ = L ^ (s + w + 2) := (Real.rpow_add hL0 _ _).symm

theorem finite_weighted_pairing_reorder {X Y : Type*} [Fintype X] [Fintype Y]
    (μ : X → ℝ) (ν : Y → ℝ) (f : X → ℂ) (g : Y → ℂ) (K : X → Y → ℂ) :
    (∑ x, ∑ y, ((μ x * ν y : ℝ) : ℂ) * (K x y * f x * g y)) =
      ∑ x, ∑ y, ((μ x : ℂ) * f x) * ((ν y : ℂ) * g y) * K x y := by
  apply Finset.sum_congr rfl
  intro x _
  apply Finset.sum_congr rfl
  intro y _
  push_cast
  ring

end Bounty
end

section

/- Exact finite dyadic partitions of positive natural-number supports. -/

open Finset Filter

namespace Bounty

def dyadicNatBucket (S : Finset ℕ) (k : ℕ) : Finset ℕ :=
  S.filter (fun n => n.log2 = k)

def dyadicNatIndices (S : Finset ℕ) : Finset ℕ := S.image Nat.log2

theorem mem_dyadicNatBucket (S : Finset ℕ) (k n : ℕ) :
    n ∈ dyadicNatBucket S k ↔ n ∈ S ∧ n.log2 = k := by
  exact mem_filter

theorem dyadicNatBucket_subset (S : Finset ℕ) (k : ℕ) :
    dyadicNatBucket S k ⊆ S := filter_subset _ _

section

variable
  (S : Finset ℕ)
  (hS : ∀ n ∈ S, 0 < n)
  {k n : ℕ}
  (hn : n ∈ dyadicNatBucket S k)

include S hS k n hn

theorem dyadicNatBucket_bounds  :
    2 ^ k ≤ n ∧ n < 2 ^ (k + 1) := by
  obtain ⟨hnS, hnk⟩ := (mem_dyadicNatBucket S k n).mp hn
  exact (Nat.log2_eq_iff (hS n hnS).ne').mp hnk

theorem dyadicNatBucket_upper_scale  :
    n ≤ 2 ^ (k + 1) ∧ 2 ^ (k + 1) ≤ 2 * n := by
  obtain ⟨hlow, hupp⟩ := dyadicNatBucket_bounds S hS hn
  constructor
  · exact hupp.le
  · rw [pow_succ]
    omega

theorem dyadicNatBucket_upper_scale_real  :
    (n : ℝ) ≤ (2 : ℝ) ^ (k + 1) ∧ (2 : ℝ) ^ (k + 1) ≤ 2 * (n : ℝ) := by
  exact_mod_cast dyadicNatBucket_upper_scale S hS hn

end


theorem dyadicNatBucket_eq_filter_interval (S : Finset ℕ)
    (hS : ∀ n ∈ S, 0 < n) (k : ℕ) :
    dyadicNatBucket S k = S.filter (fun n => 2 ^ k ≤ n ∧ n < 2 ^ (k + 1)) := by
  ext n
  simp only [mem_dyadicNatBucket, mem_filter]
  exact and_congr_right (fun hn => Nat.log2_eq_iff (hS n hn).ne')




theorem dyadicNatBucket_nonempty_iff (S : Finset ℕ) (k : ℕ) :
    (dyadicNatBucket S k).Nonempty ↔ k ∈ dyadicNatIndices S := by
  simp only [Finset.Nonempty, mem_dyadicNatBucket, dyadicNatIndices, mem_image]




theorem sum_dyadicNatBuckets {E : Type*} [AddCommMonoid E]
    (S : Finset ℕ) (w : ℕ → E) :
    (∑ k ∈ dyadicNatIndices S, ∑ n ∈ dyadicNatBucket S k, w n) = ∑ n ∈ S, w n := by
  exact sum_fiberwise_of_maps_to (fun n hn => mem_image_of_mem Nat.log2 hn) w

theorem dyadicNatIndices_subset_range (S : Finset ℕ) (N : ℕ)
    (hN : ∀ n ∈ S, n ≤ N) :
    dyadicNatIndices S ⊆ range (N.log2 + 1) := by
  intro k hk
  obtain ⟨n, hn, rfl⟩ := mem_image.mp hk
  apply mem_range.mpr
  have h := Nat.log_mono_right (b := 2) (hN n hn)
  simpa only [← Nat.log2_eq_log_two] using Nat.lt_succ_of_le h




theorem dyadicNatIndices_card_le (S : Finset ℕ) (N : ℕ)
    (hN : ∀ n ∈ S, n ≤ N) : (dyadicNatIndices S).card ≤ N.log2 + 1 := by
  simpa only [card_range] using card_le_card (dyadicNatIndices_subset_range S N hN)

theorem dyadic_log_count_le_log (N : ℕ) :
    (N.log2 + 1 : ℝ) ≤ Real.log N / Real.log 2 + 1 := by
  have h := Real.log2_le_logb N
  simp only [Real.logb] at h
  linarith

theorem dyadicNatIndices_card_le_log (S : Finset ℕ) (N : ℕ)
    (hN : ∀ n ∈ S, n ≤ N) :
    ((dyadicNatIndices S).card : ℝ) ≤ Real.log N / Real.log 2 + 1 := by
  have h : ((dyadicNatIndices S).card : ℝ) ≤ N.log2 + 1 := by
    exact_mod_cast dyadicNatIndices_card_le S N hN
  exact h.trans (dyadic_log_count_le_log N)

theorem sum_dyadicNatBuckets_bilinear {E : Type*} [AddCommMonoid E]
    (S T : Finset ℕ) (w : ℕ → ℕ → E) :
    (∑ i ∈ dyadicNatIndices S, ∑ j ∈ dyadicNatIndices T,
      ∑ m ∈ dyadicNatBucket S i, ∑ n ∈ dyadicNatBucket T j, w m n) =
      ∑ m ∈ S, ∑ n ∈ T, w m n := by
  rw [← sum_dyadicNatBuckets S (fun m => ∑ n ∈ T, w m n)]
  apply sum_congr rfl
  intro i hi
  rw [sum_comm]
  apply sum_congr rfl
  intro m hm
  exact sum_dyadicNatBuckets T (w m)





theorem dyadic_log_count_le_linear_of_le_exp {L : ℝ}
    (hL : 1 ≤ L) (h16 : Real.log 16 ≤ L) (N : ℕ)
    (hN : (N : ℝ) ≤ 16 * Real.exp L) :
    (N.log2 + 1 : ℝ) ≤ (2 / Real.log 2 + 1) * L := by
  have hlog : Real.log N ≤ 2 * L := by
    by_cases hn : N = 0
    · simp only [hn, Nat.cast_zero, Real.log_zero]
      linarith
    · have h := Real.log_le_log
        (show (0 : ℝ) < N from Nat.cast_pos.mpr (Nat.pos_of_ne_zero hn)) hN
      rw [Real.log_mul (by norm_num) (Real.exp_pos L).ne', Real.log_exp] at h
      linarith
  have htwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  calc
    (N.log2 + 1 : ℝ) ≤ Real.log N / Real.log 2 + 1 := dyadic_log_count_le_log N
    _ ≤ 2 * L / Real.log 2 + 1 :=
      add_le_add (div_le_div_of_nonneg_right hlog htwo.le) le_rfl
    _ ≤ 2 * L / Real.log 2 + L := add_le_add le_rfl hL
    _ = _ := by ring

theorem eventually_dyadic_log_count_le_linear :
    ∀ᶠ L : ℝ in atTop, ∀ N : ℕ, (N : ℝ) ≤ 16 * Real.exp L →
      (N.log2 + 1 : ℝ) ≤ (2 / Real.log 2 + 1) * L := by
  filter_upwards [eventually_ge_atTop (1 : ℝ), eventually_ge_atTop (Real.log 16)] with L hL h16
  exact dyadic_log_count_le_linear_of_le_exp hL h16

theorem eventually_dyadicNatIndices_card_le_linear :
    ∀ᶠ L : ℝ in atTop, ∀ (N : ℕ) (S : Finset ℕ),
      (N : ℝ) ≤ 16 * Real.exp L → (∀ n ∈ S, n ≤ N) →
      ((dyadicNatIndices S).card : ℝ) ≤ (2 / Real.log 2 + 1) * L := by
  filter_upwards [eventually_dyadic_log_count_le_linear] with L hL
  intro N S hN hS
  have hcard : ((dyadicNatIndices S).card : ℝ) ≤ N.log2 + 1 := by
    exact_mod_cast dyadicNatIndices_card_le S N hS
  exact hcard.trans (hL N hN)


end Bounty
end

section

/- Removing a prime outside a finite pool commutes with extracting the pool-free part. -/

namespace Bounty

theorem prime_not_dvd_primePoolPart {P : Finset ℕ} {p u : ℕ}
    (hp : p.Prime) (hpP : p ∉ P) : ¬ p ∣ primePoolPart P u := by
  intro h
  exact hpP (Nat.primeFactors_subset_of_mem_factoredNumbers
    (primePoolPart_mem_factoredNumbers P u)
    (hp.mem_primeFactors h (primePoolPart_ne_zero P u)))

theorem prime_dvd_primePoolFreePart_iff {P : Finset ℕ} {p u : ℕ}
    (hp : p.Prime) (hpP : p ∉ P) :
    p ∣ primePoolFreePart P u ↔ p ∣ u := by
  conv_rhs => rw [← primePoolPart_mul_primePoolFreePart P u]
  rw [hp.dvd_mul]
  exact (or_iff_right (prime_not_dvd_primePoolPart hp hpP)).symm

theorem primePoolPart_prime_of_not_mem {P : Finset ℕ} {p : ℕ}
    (hp : p.Prime) (hpP : p ∉ P) : primePoolPart P p = 1 := by
  apply primePoolPart_eq_one_of_disjoint (Q := {p})
  · simpa using hpP
  · apply Nat.mem_factoredNumbers_of_primeFactors_subset hp.ne_zero
    rw [hp.primeFactors]

theorem primePoolPart_div_prime_of_not_mem {P : Finset ℕ} {p u : ℕ}
    (hp : p.Prime) (hpP : p ∉ P) (hu : u ≠ 0) (hpu : p ∣ u) :
    primePoolPart P (u / p) = primePoolPart P u := by
  have hmul : p * (u / p) = u := Nat.mul_div_cancel' hpu
  have hquot : u / p ≠ 0 := by
    intro h
    rw [h, mul_zero] at hmul
    exact hu hmul.symm
  calc
    primePoolPart P (u / p) = primePoolPart P p * primePoolPart P (u / p) := by
      rw [primePoolPart_prime_of_not_mem hp hpP, one_mul]
    _ = primePoolPart P (p * (u / p)) := (primePoolPart_mul P hp.ne_zero hquot).symm
    _ = primePoolPart P u := congrArg (primePoolPart P) hmul

theorem primePoolFreePart_div_prime_of_not_mem {P : Finset ℕ} {p u : ℕ}
    (hp : p.Prime) (hpP : p ∉ P) (hu : u ≠ 0) (hpu : p ∣ u) :
    primePoolFreePart P (u / p) = primePoolFreePart P u / p := by
  unfold primePoolFreePart
  rw [primePoolPart_div_prime_of_not_mem hp hpP hu hpu]
  exact Nat.div_right_comm u p (primePoolPart P u)

end Bounty

end

section

/- The actual normalized remainder after extracting the distinguished Q-zero prime. -/

open Finset Filter

namespace Bounty

theorem ordered_slot_rest_weight_le {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (i : I) (p : choices i) {Z : ℝ} (hZ : 0 ≤ Z) (n : ℕ) :
    orderedSlotWeight (fun j : {j : I // j ≠ i} => choices j.val) Z n ≤
      orderedSlotWeight choices Z (p.val * n) := by
  classical
  rw [ordered_slot_weight_split choices i]
  apply le_trans _ (single_le_sum
    (f := fun q : choices i => ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
      if q.val * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y = p.val * n
      then 1 / Z else 0) (fun _ _ => sum_nonneg (fun _ _ => by split_ifs <;> positivity)) (mem_univ p))
  unfold orderedSlotWeight
  trans ∑ y : ∀ j : {j : I // j ≠ i}, choices j.val,
    if orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y = n then 1 / Z else 0
  · apply le_of_eq
    apply sum_congr
    · ext y; simp
    · intro y _; rfl
  · apply sum_le_sum
    intro y _
    split_ifs with hy hmul hmul
    · exact le_rfl
    · exact False.elim (hmul (congrArg (fun k => p.val * k) hy))
    · positivity
    · exact le_rfl

theorem ordered_slot_weight_divisor_split {I : Type*} [Fintype I] [DecidableEq I]
    (choices : I → Finset ℕ) (i : I) (Z : ℝ)
    (hp0 : ∀ p ∈ choices i, p ≠ 0) (n : ℕ) :
    orderedSlotWeight choices Z n =
      ∑ p ∈ choices i, if p ∣ n then
        orderedSlotWeight (fun j : {j : I // j ≠ i} => choices j.val) Z (n / p) else 0 := by
  classical
  rw [ordered_slot_weight_split choices i, ← sum_coe_sort (choices i)]
  apply sum_congr rfl
  intro p _
  by_cases hd : p.val ∣ n
  · rw [if_pos hd]
    unfold orderedSlotWeight
    apply sum_congr
    · ext y; simp
    · intro y _
      have heq : p.val * orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y = n ↔
          orderedSlotProduct (fun j : {j : I // j ≠ i} => choices j.val) y = n / p.val := by
        constructor
        · intro h
          apply Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero (hp0 p.val p.property))
          exact h.trans (Nat.mul_div_cancel' hd).symm
        · intro h
          rw [h, Nat.mul_div_cancel' hd]
      simp only [heq]
  · rw [if_neg hd]
    apply sum_eq_zero
    intro y _
    apply if_neg
    intro h
    exact hd ⟨_, h.symm⟩

noncomputable def candidateQRestWeight (c L : ℝ) (r jStar : ℕ) (hr : 0 < r) (n : ℕ) : ℝ :=
  orderedSlotWeight (candidateQRestChoices c L r jStar hr)
    ((r.factorial : ℝ) ^ (candidateQIndices c L).card) n

theorem candidate_Q_rest_weight_nonneg (c L : ℝ) (r jStar : ℕ) (hr : 0 < r) (n : ℕ) :
    0 ≤ candidateQRestWeight c L r jStar hr n :=
  ordered_slot_weight_nonneg _ (by positivity) n

theorem candidate_Q_rest_weight_le_full (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : 0 < jStar) {p : ℕ} (hp : p ∈ candidateQBand (c * L) 0) (n : ℕ) :
    candidateQRestWeight c L r jStar hr n ≤ candidateQWeight c L r jStar (p * n) := by
  have hp' : p ∈ candidateQSlotChoices c L r jStar (candidateFreeSlot c L r hr) := by
    rwa [candidate_Q_free_choice c L r jStar hr hj]
  exact ordered_slot_rest_weight_le (candidateQSlotChoices c L r jStar)
    (candidateFreeSlot c L r hr) ⟨p, hp'⟩ (by positivity) n

theorem candidate_Q_weight_rest_divisor_split (c L : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (hj : 0 < jStar) (n : ℕ) :
    candidateQWeight c L r jStar n =
      ∑ p ∈ candidateQBand (c * L) 0, if p ∣ n then candidateQRestWeight c L r jStar hr (n / p) else 0 := by
  have h := ordered_slot_weight_divisor_split (candidateQSlotChoices c L r jStar)
    (candidateFreeSlot c L r hr) ((r.factorial : ℝ) ^ (candidateQIndices c L).card)
    (fun p hp => candidate_Q_slot_nonzero c L r jStar _ hp) n
  rw [candidate_Q_free_choice c L r jStar hr hj] at h
  exact h

theorem eventually_candidate_Q_rest_weight_le_exp_sqrt {c : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, 0 < jStar → ∀ n : ℕ,
      (n : ℝ) ≤ 16 * Real.exp L →
      candidateQRestWeight c L r jStar hr n ≤
        Real.exp ((((6/5 : ℝ) * c + 2) * Real.log 2) * Real.sqrt L) := by
  filter_upwards [eventually_candidateQBand_nonempty hc,
    eventually_candidate_Q_weight_le_roughDivisors hc hr,
    eventually_ge_atTop (Real.log 16), eventually_gt_atTop (0 : ℝ)] with L hband hQ hlarge hL
  intro jStar hj n hn
  obtain ⟨p, hp⟩ := hband 0 (by simp [candidateQIndices])
  have hpdata := (mem_dyadicPrimeBand_iff (c * L) 1 (6/5) 0 p).mp hp
  have hle := candidate_Q_rest_weight_le_full c L r jStar hr hj hp n
  by_cases hn0 : n = 0
  · subst n
    simp only [mul_zero, candidate_Q_weight_zero_at_zero] at hle
    exact hle.trans (Real.exp_pos ((((6/5 : ℝ) * c + 2) * Real.log 2) * Real.sqrt L)).le
  · have hpbound : (p : ℝ) ≤ Real.exp (((6/5 : ℝ) * c) * L) := by
      simpa only [pow_zero, div_one, mul_assoc] using hpdata.2.2
    have hsize : ((p * n : ℕ) : ℝ) ≤ Real.exp (((6/5 : ℝ) * c + 2) * L) := by
      calc
        ((p * n : ℕ) : ℝ) = (p : ℝ) * n := Nat.cast_mul p n
        _ ≤ Real.exp (((6/5 : ℝ) * c) * L) * Real.exp (2 * L) :=
          mul_le_mul hpbound (wide_window_nat_le_exp_twice hlarge hn) (Nat.cast_nonneg n)
            (Real.exp_pos _).le
        _ = _ := by rw [← Real.exp_add]; congr 1; ring
    exact hle.trans ((hQ jStar (p * n)).trans
      (roughDivisors_card_le_exp_sqrt hL (Nat.mul_ne_zero hpdata.1.ne_zero hn0) hsize))

noncomputable def candidateRemainderCoefficient (c L q : ℝ) (r jStar : ℕ)
    (hr : 0 < r) (u : ℕ) : ℝ :=
  candidateQRestWeight c L r jStar hr
    (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c * L))) u) *
  markedDivisorWeight (candidatePIndices c L) (candidatePBand (c * L)) q
    (fun j => ∑ p ∈ candidatePBand (c * L) j, 1 / (p : ℝ)) (fun _ => 1) (u : ℤ)

theorem candidate_remainder_coefficient_nonneg (c L : ℝ) {q : ℝ} (hq : 0 ≤ q)
    (r jStar : ℕ) (hr : 0 < r) (u : ℕ) :
    0 ≤ candidateRemainderCoefficient c L q r jStar hr u := by
  apply mul_nonneg (candidate_Q_rest_weight_nonneg _ _ _ _ _ _)
  exact marked_divisor_weight_nonneg _ _ hq _ _
    (fun _ _ => sum_nonneg (fun _ _ => by positivity)) _

theorem eventually_candidate_remainder_coefficient_le_exp_sqrt {c q : ℝ} {r : ℕ}
    (hc : 0 < c) (hr : 0 < r) (hq0 : 0 ≤ q) (hq1 : q < 1) :
    ∀ᶠ L : ℝ in atTop, ∀ jStar : ℕ, 0 < jStar → ∀ u : ℕ,
      (u : ℝ) ≤ 16 * Real.exp L →
      candidateRemainderCoefficient c L q r jStar hr u ≤
        Real.exp (((((6/5 : ℝ) * c + 2) * Real.log 2) + 1) * Real.sqrt L) := by
  filter_upwards [eventually_candidate_Q_rest_weight_le_exp_sqrt hc hr,
    eventually_candidate_marked_multiplier_bound hc hq0 hq1 (((6/5 : ℝ) * c + 2) * Real.log 2)]
      with L hrest hmarked
  intro jStar hj u hu
  have hfree : (primePoolFreePart ((candidatePIndices c L).biUnion (candidatePBand (c * L))) u : ℝ) ≤
      16 * Real.exp L :=
    (Nat.cast_le.mpr (Nat.div_le_self _ _)).trans hu
  exact hmarked (u : ℤ) _ (candidate_Q_rest_weight_nonneg _ _ _ _ _ _)
    (hrest jStar hj _ hfree)

end Bounty
end

section

/- Elementary numerical bounds for bilinear large-sieve errors. -/

namespace Bounty

theorem sqrt_add_square_le {P R : ℝ} (hP : 0 ≤ P) (hR : 0 ≤ R) :
    Real.sqrt (P + R ^ 2) ≤ Real.sqrt P + R := by
  apply Real.sqrt_le_iff.mpr
  constructor
  · positivity
  · nlinarith [Real.sq_sqrt hP, mul_nonneg (Real.sqrt_nonneg P) hR]

theorem large_sieve_sqrt_expand {P U R : ℝ} (hP : 0 ≤ P) (hU : 0 ≤ U) (hR : 0 ≤ R) :
    Real.sqrt ((P + R ^ 2) * (U + R ^ 2) * P * U) ≤
      P * U + R * P * Real.sqrt U + R * U * Real.sqrt P +
        R ^ 2 * Real.sqrt (P * U) := by
  have hP' : 0 ≤ P + R ^ 2 := by positivity
  have hU' : 0 ≤ U + R ^ 2 := by positivity
  have heq : (P + R ^ 2) * (U + R ^ 2) * P * U =
      ((P + R ^ 2) * P) * ((U + R ^ 2) * U) := by ring
  rw [heq, Real.sqrt_mul (mul_nonneg hP' hP), Real.sqrt_mul hP', Real.sqrt_mul hU']
  calc
    _ ≤ ((Real.sqrt P + R) * Real.sqrt P) *
        ((Real.sqrt U + R) * Real.sqrt U) := by
      exact mul_le_mul
        (mul_le_mul_of_nonneg_right (sqrt_add_square_le hP hR) (Real.sqrt_nonneg P))
        (mul_le_mul_of_nonneg_right (sqrt_add_square_le hU hR) (Real.sqrt_nonneg U))
        (by positivity) (by positivity)
    _ = _ := by
      rw [Real.sqrt_mul hP]
      simp only [add_mul, Real.mul_self_sqrt hP, Real.mul_self_sqrt hU]
      ring

theorem large_sieve_sqrt_div_expand {P U R : ℝ}
    (hP : 0 ≤ P) (hU : 0 ≤ U) (hR : 0 < R) :
    Real.sqrt ((P + R ^ 2) * (U + R ^ 2) * P * U) / R ≤
      P * U / R + P * Real.sqrt U + U * Real.sqrt P + R * Real.sqrt (P * U) := by
  apply (div_le_div_of_nonneg_right (large_sieve_sqrt_expand hP hU hR.le) hR.le).trans
  exact le_of_eq (by field_simp)

theorem large_sieve_energy_factor {P U R E F W : ℝ}
    (hP : 0 ≤ P) (hU : 0 ≤ U) (hF : 0 ≤ F) (hW : 0 ≤ W)
    (hEP : E ≤ P * W) (hFU : F ≤ U * W) :
    Real.sqrt ((P + R ^ 2) * (U + R ^ 2) * E * F) ≤
      W * Real.sqrt ((P + R ^ 2) * (U + R ^ 2) * P * U) := by
  have hfactor : 0 ≤ (P + R ^ 2) * (U + R ^ 2) := by positivity
  have hEF : E * F ≤ (P * W) * (U * W) :=
    mul_le_mul hEP hFU hF (mul_nonneg hP hW)
  have h := Real.sqrt_le_sqrt (mul_le_mul_of_nonneg_left hEF hfactor)
  have heq : ((P + R ^ 2) * (U + R ^ 2)) * ((P * W) * (U * W)) =
      W ^ 2 * ((P + R ^ 2) * (U + R ^ 2) * P * U) := by ring
  rw [heq, Real.sqrt_mul (sq_nonneg W), Real.sqrt_sq hW] at h
  simpa only [mul_assoc] using h

theorem sqrt_exp_half (x : ℝ) : Real.sqrt (Real.exp x) = Real.exp (x / 2) := by
  apply (Real.sqrt_eq_iff_mul_self_eq (Real.exp_nonneg _) (Real.exp_nonneg _)).mpr
  rw [← Real.exp_add]
  congr 1
  ring

theorem large_sieve_exponential_ranges {P U R L a eta theta C : ℝ}
    (hC : 0 ≤ C) (hP : Real.exp (a * L) ≤ P) (hU : Real.exp (a * L) ≤ U)
    (hPU : P * U ≤ C * Real.exp L)
    (hRlo : Real.exp (eta * L) ≤ R) (hRhi : R ≤ Real.exp (theta * L)) :
    Real.sqrt ((P + R ^ 2) * (U + R ^ 2) * P * U) / R ≤
      C * Real.exp ((1 - eta) * L) +
        2 * C * Real.exp ((1 - a / 2) * L) +
          Real.sqrt C * Real.exp ((theta + 1 / 2) * L) := by
  have hP0 : 0 < P := (Real.exp_pos _).trans_le hP
  have hU0 : 0 < U := (Real.exp_pos _).trans_le hU
  have hR0 : 0 < R := (Real.exp_pos _).trans_le hRlo
  have hsP : Real.exp ((a / 2) * L) ≤ Real.sqrt P := by
    have h := Real.sqrt_le_sqrt hP
    rw [sqrt_exp_half] at h
    convert h using 1
    congr 1
    ring
  have hsU : Real.exp ((a / 2) * L) ≤ Real.sqrt U := by
    have h := Real.sqrt_le_sqrt hU
    rw [sqrt_exp_half] at h
    convert h using 1
    congr 1
    ring
  have hfirst : P * U / R ≤ C * Real.exp ((1 - eta) * L) := by
    calc
      _ ≤ (C * Real.exp L) / R := div_le_div_of_nonneg_right hPU hR0.le
      _ ≤ (C * Real.exp L) / Real.exp (eta * L) :=
        div_le_div_of_nonneg_left (mul_nonneg hC (Real.exp_nonneg _)) (Real.exp_pos _) hRlo
      _ = _ := by rw [mul_div_assoc, ← Real.exp_sub]; congr 2; ring
  have hsecond : P * Real.sqrt U ≤ C * Real.exp ((1 - a / 2) * L) := by
    calc
      _ = P * U / Real.sqrt U := by rw [mul_div_assoc, Real.div_sqrt]
      _ ≤ (C * Real.exp L) / Real.sqrt U :=
        div_le_div_of_nonneg_right hPU (Real.sqrt_nonneg _)
      _ ≤ (C * Real.exp L) / Real.exp ((a / 2) * L) :=
        div_le_div_of_nonneg_left (mul_nonneg hC (Real.exp_nonneg _)) (Real.exp_pos _) hsU
      _ = _ := by rw [mul_div_assoc, ← Real.exp_sub]; congr 2; ring
  have hthird : U * Real.sqrt P ≤ C * Real.exp ((1 - a / 2) * L) := by
    calc
      _ = P * U / Real.sqrt P := by rw [mul_comm P U, mul_div_assoc, Real.div_sqrt]
      _ ≤ (C * Real.exp L) / Real.sqrt P :=
        div_le_div_of_nonneg_right hPU (Real.sqrt_nonneg _)
      _ ≤ (C * Real.exp L) / Real.exp ((a / 2) * L) :=
        div_le_div_of_nonneg_left (mul_nonneg hC (Real.exp_nonneg _)) (Real.exp_pos _) hsP
      _ = _ := by rw [mul_div_assoc, ← Real.exp_sub]; congr 2; ring
  have hfourth : R * Real.sqrt (P * U) ≤
      Real.sqrt C * Real.exp ((theta + 1 / 2) * L) := by
    calc
      _ ≤ Real.exp (theta * L) * Real.sqrt (C * Real.exp L) :=
        mul_le_mul hRhi (Real.sqrt_le_sqrt hPU) (Real.sqrt_nonneg _) (Real.exp_nonneg _)
      _ = _ := by
        rw [Real.sqrt_mul hC, sqrt_exp_half, mul_left_comm, ← Real.exp_add]
        congr 2
        ring
  exact (large_sieve_sqrt_div_expand hP0.le hU0.le hR0).trans (by linarith)

end Bounty
end

section

/- Finite coefficient energies from pointwise bounds on positive integer supports. -/

open Finset

namespace Bounty

theorem positive_nat_finset_card_le_real (S : Finset ℕ) {P : ℝ} (hP : 0 ≤ P)
    (hpos : ∀ n ∈ S, 0 < n) (hbound : ∀ n ∈ S, (n : ℝ) ≤ P) :
    (S.card : ℝ) ≤ P := by
  have hsub : S ⊆ Icc 1 ⌊P⌋₊ := by
    intro n hn
    exact mem_Icc.mpr ⟨hpos n hn, Nat.le_floor (hbound n hn)⟩
  calc
    _ ≤ ((Icc 1 ⌊P⌋₊).card : ℝ) := Nat.cast_le.mpr (card_le_card hsub)
    _ = (⌊P⌋₊ : ℝ) := by simp
    _ ≤ P := Nat.floor_le hP

theorem positive_nat_finset_energy_le (S : Finset ℕ) (a : ℕ → ℂ) {P M : ℝ}
    (hP : 0 ≤ P) (hpos : ∀ n ∈ S, 0 < n) (hbound : ∀ n ∈ S, (n : ℝ) ≤ P)
    (ha : ∀ n ∈ S, ‖a n‖ ≤ M) :
    (∑ n ∈ S, ‖a n‖ ^ 2) ≤ P * M ^ 2 := by
  calc
    _ ≤ ∑ _n ∈ S, M ^ 2 := by
      apply sum_le_sum
      intro n hn
      exact pow_le_pow_left₀ (norm_nonneg _) (ha n hn) 2
    _ = (S.card : ℝ) * M ^ 2 := by simp
    _ ≤ P * M ^ 2 := mul_le_mul_of_nonneg_right
      (positive_nat_finset_card_le_real S hP hpos hbound) (sq_nonneg M)

theorem positive_nat_finset_exponential_energy_le (S : Finset ℕ) (a : ℕ → ℂ)
    {P H L : ℝ} (hP : 0 ≤ P) (hpos : ∀ n ∈ S, 0 < n)
    (hbound : ∀ n ∈ S, (n : ℝ) ≤ P)
    (ha : ∀ n ∈ S, ‖a n‖ ≤ Real.exp (H * Real.sqrt L)) :
    (∑ n ∈ S, ‖a n‖ ^ 2) ≤ P * Real.exp ((2 * H) * Real.sqrt L) := by
  apply (positive_nat_finset_energy_le S a hP hpos hbound ha).trans_eq
  rw [pow_two, ← Real.exp_add]
  congr 2
  ring

end Bounty
end

section

/- Growth margins and complementary-modulus mass for the final large-sieve summation. -/

open Filter Finset

namespace Bounty

theorem eventually_const_mul_exp_le_exp {a b : ℝ} (hab : a < b) (C : ℝ) :
    ∀ᶠ L : ℝ in atTop, C * Real.exp (a * L) ≤ Real.exp (b * L) := by
  have ht := Real.tendsto_exp_atTop.comp (tendsto_id.const_mul_atTop (sub_pos.mpr hab))
  filter_upwards [ht.eventually_ge_atTop C] with L hL
  calc
    _ ≤ Real.exp ((b - a) * L) * Real.exp (a * L) :=
      mul_le_mul_of_nonneg_right hL (Real.exp_nonneg _)
    _ = _ := by rw [← Real.exp_add]; congr 1; ring




end Bounty
end

