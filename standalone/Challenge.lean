open scoped BigOperators ComplexConjugate
open MeasureTheory

namespace Bounty

theorem dirichlet_polynomial_hasDerivAt (s : Finset ℕ) (c : ℕ → ℂ) (t : ℝ) :
    HasDerivAt
      (fun t => ∑ n ∈ s, c n * Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I))
      (∑ n ∈ s, (c n * ((Real.log (n : ℝ) : ℂ) * Complex.I)) *
        Complex.exp ((Real.log (n : ℝ) * t : ℝ) * Complex.I)) t := by
  apply HasDerivAt.fun_sum
  intro n _
  have hd : HasDerivAt
      (fun y : ℝ => ((Real.log (n : ℝ) : ℂ) * Complex.I) * y)
      ((Real.log (n : ℝ) : ℂ) * Complex.I) t := by
    simpa only [mul_one, id_eq] using!
      ((hasDerivAt_id (t : ℂ)).const_mul ((Real.log (n : ℝ) : ℂ) * Complex.I)).comp_ofReal
  have he := ((Complex.hasDerivAt_exp _).comp t hd).const_mul (c n)
  simpa only [Complex.ofReal_mul, mul_comm, mul_left_comm, mul_assoc, Function.comp_apply] using! he

theorem dirichlet_derivative_coefficient_energy (s : Finset ℕ) (c : ℕ → ℂ) (N : ℕ)
    (hs : ∀ n ∈ s, 1 ≤ n ∧ n ≤ N) :
    (∑ n ∈ s, ‖c n * ((Real.log (n : ℝ) : ℂ) * Complex.I)‖ ^ 2) ≤
      (Real.log N) ^ 2 * ∑ n ∈ s, ‖c n‖ ^ 2 := by
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro n hn
  have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast (hs n hn).1
  have hn0 : (0 : ℝ) < n := zero_lt_one.trans_le hn1
  have hlog0 := Real.log_nonneg hn1
  have hlog := Real.log_le_log hn0 (show (n : ℝ) ≤ N by exact_mod_cast (hs n hn).2)
  simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hlog0,
    Complex.norm_I, mul_one, mul_pow]
  have hsq := (sq_le_sq₀ hlog0 (hlog0.trans hlog)).mpr hlog
  nlinarith [mul_le_mul_of_nonneg_left hsq (sq_nonneg ‖c n‖)]

end Bounty
end

section

open Finset
open scoped ComplexConjugate

namespace Bounty

noncomputable def integerIntervalPhase (a b : ℤ) (φ : ℝ → ℝ) (n : ℤ) : ℂ :=
  if n ∈ Icc a b then Complex.exp ((φ (n:ℝ):ℂ)*Complex.I) else 0

theorem integer_interval_phase_support (a b : ℤ) (φ : ℝ → ℝ) (n : ℤ)
    (hn : n ∉ Icc a b) : integerIntervalPhase a b φ n = 0 := by
  simp only [integerIntervalPhase, if_neg hn]

theorem integer_interval_phase_norm (a b : ℤ) (φ : ℝ → ℝ) (n : ℤ) :
    ‖integerIntervalPhase a b φ n‖ ≤ 1 := by
  unfold integerIntervalPhase
  split_ifs
  · rw [Complex.norm_exp_ofReal_mul_I]
  · simp only [norm_zero, zero_le_one]

theorem integer_interval_phase_sum (a b : ℤ) (φ : ℝ → ℝ) :
    (∑ n ∈ Icc a b, integerIntervalPhase a b φ n) =
      ∑ n ∈ Icc a b, Complex.exp ((φ (n:ℝ):ℂ)*Complex.I) := by
  apply sum_congr rfl
  intro n hn
  simp only [integerIntervalPhase, if_pos hn]

theorem integer_interval_phase_correlation (a b h : ℤ) (φ : ℝ → ℝ) (hh : 0 ≤ h) :
    finiteShiftCorrelation (Icc a b) (integerIntervalPhase a b φ) h =
      ∑ n ∈ Icc a (b-h), Complex.exp (((φ ((n:ℝ)+(h:ℝ))-φ (n:ℝ)):ℂ)*Complex.I) := by
  classical
  have hsub : Icc a (b-h) ⊆ Icc a b := by
    intro n hn
    have hn' := mem_Icc.mp hn
    apply mem_Icc.mpr
    omega
  unfold finiteShiftCorrelation
  rw [← sum_subset hsub (fun n hn hnnot => ?_)]
  · apply sum_congr rfl
    intro n hn
    have hn' := mem_Icc.mp hn
    have hns : n ∈ Icc a b := hsub hn
    have hnh : n+h ∈ Icc a b := by apply mem_Icc.mpr; omega
    simp only [integerIntervalPhase, if_pos hns, if_pos hnh,
      ← Complex.exp_conj, map_mul, Complex.conj_ofReal, Complex.conj_I]
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  · have hnh : n+h ∉ Icc a b := by
      intro hnh
      apply hnnot
      have hn' := mem_Icc.mp hn
      have hnh' := mem_Icc.mp hnh
      apply mem_Icc.mpr
      omega
    rw [integer_interval_phase_support a b φ (n+h) hnh, zero_mul]




theorem integer_phase_van_der_corput_subinterval (A B a b H : ℤ) (φ : ℝ → ℝ)
    (hAB : A ≤ B) (hAa : A ≤ a) (hbB : b ≤ B)
    (hH : 1 ≤ H) (hHN : H ≤ B-A+1) :
    ‖∑ n ∈ Icc a b, Complex.exp ((φ (n:ℝ):ℂ)*Complex.I)‖^2 ≤
      2*((B-A+1:ℤ):ℝ)^2/(H:ℝ) + (4*((B-A+1:ℤ):ℝ)/(H:ℝ)) *
        ∑ h ∈ Icc (1:ℤ) (H-1),
          ‖∑ n ∈ Icc a (b-h), Complex.exp (((φ ((n:ℝ)+(h:ℝ))-φ (n:ℝ)):ℂ)*Complex.I)‖ := by
  let f := integerIntervalPhase a b φ
  have hsub : Icc a b ⊆ Icc A B := by
    intro n hn
    have hn' := mem_Icc.mp hn
    apply mem_Icc.mpr
    omega
  have hsupp (n : ℤ) (hn : n ∉ Icc A B) : f n = 0 :=
    integer_interval_phase_support a b φ n (fun h => hn (hsub h))
  have hsum : (∑ n ∈ Icc A B, f n) =
      ∑ n ∈ Icc a b, Complex.exp ((φ (n:ℝ):ℂ)*Complex.I) := by
    rw [← sum_subset hsub (fun n hn hnnot => integer_interval_phase_support a b φ n hnnot)]
    exact integer_interval_phase_sum a b φ
  have hcorr (h : ℤ) : finiteShiftCorrelation (Icc A B) f h =
      finiteShiftCorrelation (Icc a b) f h := by
    unfold finiteShiftCorrelation
    symm
    apply sum_subset hsub
    intro n hn hnnot
    have hz : f n = 0 := integer_interval_phase_support a b φ n hnnot
    rw [hz, map_zero, mul_zero]
  have hv := integer_interval_van_der_corput_unit A B H f hAB hH hHN hsupp
    (fun n hn => integer_interval_phase_norm a b φ n)
  rw [hsum] at hv
  apply hv.trans_eq
  congr 2
  apply sum_congr rfl
  intro h hh
  rw [hcorr, integer_interval_phase_correlation a b h φ (by have := (mem_Icc.mp hh).1; omega)]

end Bounty
end

section

/- First-derivative exponential-sum test on a finite natural range. -/

open Finset

namespace Bounty

theorem first_derivative_range_sum_bound (f : ℕ → ℝ) (N : ℕ) (k : ℤ)
    {δ : ℝ} (hδ : 0 < δ) (hδhalf : δ ≤ 1/2)
    (hband : ∀ n < N, (k : ℝ)+δ ≤ f (n+1)-f n ∧
      f (n+1)-f n ≤ (k : ℝ)+1-δ)
    (hmono : MonotoneOn (fun n => f (n+1)-f n) (Set.Iio N) ∨
      AntitoneOn (fun n => f (n+1)-f n) (Set.Iio N)) :
    ‖∑ n ∈ range N, realUnitPhase (f n)‖ ≤ 2/δ := by
  apply discrete_unit_phase_sum_bound (fun n => realUnitPhase (f n))
    (fun n => f (n+1)-f n-k) N hδ hδhalf
  · intro n hn
    exact (real_unit_phase_norm _).le
  · intro n hn
    exact real_unit_phase_increment (f n) (f (n+1)) k
  · intro n hn
    have hb := hband n hn
    constructor <;> linarith
  · rcases hmono with hm | hm
    · left
      intro a ha b hb hab
      exact sub_le_sub_right (hm ha hb hab) _
    · right
      intro a ha b hb hab
      exact sub_le_sub_right (hm ha hb hab) _

end Bounty
end

section

/- Natural interval adapter for the proved discrete Kusmin-Landau estimate. -/

open Finset

namespace Bounty

theorem nat_first_derivative_sum_bound (f : ℕ → ℝ) (a b : ℕ) (k : ℤ)
    {δ : ℝ} (hδ : 0 < δ) (hδhalf : δ ≤ 1/2)
    (hband : ∀ n ∈ Icc a b, (k : ℝ)+δ ≤ f (n+1)-f n ∧ f (n+1)-f n ≤ k+1-δ)
    (hmono : MonotoneOn (fun n => f (n+1)-f n) (Set.Icc a b)) :
    ‖∑ n ∈ Icc a b, realUnitPhase (f n)‖ ≤ 2/δ := by
  have he := discrete_unit_phase_sum_bound
    (fun n => realUnitPhase (f (a+n)))
    (fun n => f (a+n+1)-f (a+n)-k) (b+1-a) hδ hδhalf
    (fun n _ => (real_unit_phase_norm _).le)
    (fun n _ => by
      simpa only [Nat.add_assoc,realUnitPhase] using
        real_unit_phase_increment (f (a+n)) (f (a+n+1)) k)
    (fun n hn => by
      have h := hband (a+n) (mem_Icc.mpr ⟨by omega,by omega⟩)
      constructor <;> linarith)
    (Or.inl (by
      intro i hi j hj hij
      change i < b+1-a at hi
      change j < b+1-a at hj
      have h := hmono (a := a+i) (b := a+j) ⟨by omega,by omega⟩ ⟨by omega,by omega⟩ (by omega)
      exact sub_le_sub_right h k))
  have hset : Icc a b = Ico a (b+1) := by
    ext n
    simp only [mem_Icc,mem_Ico]
    omega
  rw [hset,sum_Ico_eq_sum_range]
  exact he

end Bounty
end

section

/- The literal reciprocal prime polynomial and all unit intervals meeting
its exceptional-time set in a bounded time window. -/

open Finset Set
open scoped Classical

namespace Bounty

noncomputable def primeReciprocalPolynomial (P : Finset ℕ) (b : P → ℂ) (t : ℝ) : ℂ :=
  ∑ p : P, (b p / (p.val : ℂ)) *
    Complex.exp (((Real.log (p.val : ℝ) * t : ℝ) : ℂ) * Complex.I)

def primeExceptionalTimes (P : Finset ℕ) (b : P → ℂ) (η R : ℝ) : Set ℝ :=
  {t | |t| ≤ R ∧ η < ‖primeReciprocalPolynomial P b t‖}

noncomputable def primeExceptionalIntervals (P : Finset ℕ) (b : P → ℂ)
    (η R : ℝ) : Finset ℤ :=
  occupiedUnitIntervals (Finset.Icc (-(⌈R⌉₊ : ℤ) - 1) (⌈R⌉₊ : ℤ))
    (primeExceptionalTimes P b η R)

theorem mem_primeExceptionalIntervals (P : Finset ℕ) (b : P → ℂ)
    (η R : ℝ) (i : ℤ) :
    i ∈ primeExceptionalIntervals P b η R ↔
      ∃ t ∈ Set.Icc (i : ℝ) ((i : ℝ) + 1),
        |t| ≤ R ∧ η < ‖primeReciprocalPolynomial P b t‖ := by
  rw [primeExceptionalIntervals, mem_occupiedUnitIntervals]
  constructor
  · exact fun h => h.2
  · intro h
    refine ⟨?_, h⟩
    obtain ⟨t, ht, hR, _⟩ := h
    have hc : R ≤ (⌈R⌉₊ : ℝ) := Nat.le_ceil R
    have htl : -R ≤ t := (abs_le.mp hR).1
    have htr : t ≤ R := (abs_le.mp hR).2
    apply Finset.mem_Icc.mpr
    constructor
    · have hl : -(⌈R⌉₊ : ℝ) - 1 ≤ (i : ℝ) := by linarith [ht.2]
      exact_mod_cast hl
    · have hr : (i : ℝ) ≤ (⌈R⌉₊ : ℝ) := by linarith [ht.1]
      exact_mod_cast hr




theorem prime_exceptional_window_bounds (R : ℝ) (i : ℤ)
    (hi : i ∈ Finset.Icc (-(⌈R⌉₊ : ℤ) - 1) (⌈R⌉₊ : ℤ)) :
    -(⌈R⌉₊ : ℝ) - 1 ≤ (i : ℝ) ∧ (i : ℝ) + 2 ≤ (⌈R⌉₊ : ℝ) + 2 := by
  obtain ⟨hl, hr⟩ := Finset.mem_Icc.mp hi
  constructor
  · exact_mod_cast hl
  · have h : (i : ℝ) ≤ (⌈R⌉₊ : ℝ) := by exact_mod_cast hr
    linarith

end Bounty
end

section

/- Sparse Dirichlet energy for finite integer supports, from a logarithmic kernel bound. -/

open scoped BigOperators

namespace Bounty

theorem sparse_dirichlet_polynomial_energy {ι : Type*}
    (indices : Finset ι) (x : ι → ℝ) (support : Finset ℕ) (c : ℕ → ℂ)
    (N : ℕ) {U E : ℝ} (hU : 0 ≤ U) (hE : 0 ≤ E)
    (hsep : ∀ i ∈ indices, ∀ j ∈ indices, i ≠ j → 1 ≤ |x i - x j|)
    (hspan : ∀ i ∈ indices, ∀ j ∈ indices, |x i - x j| ≤ N)
    (hkernel : ∀ z : ℝ, |z| ≤ N →
      ‖∑ n ∈ support, Complex.exp ((Real.log (n : ℝ) * z : ℝ) * Complex.I)‖ ≤
        U / (1 + |z|) + E) :
    (∑ i ∈ indices, ‖∑ n ∈ support, c n *
      Complex.exp ((Real.log (n : ℝ) * x i : ℝ) * Complex.I)‖ ^ 2) ≤
      (U * (1 + 2 * (1 + Real.log N)) + (indices.card : ℝ) * E) *
        ∑ n ∈ support, ‖c n‖ ^ 2 := by
  have hcs (f : ℕ → ℂ) : (∑ n : ↥support, f n) = ∑ n ∈ support, f n :=
    Finset.sum_coe_sort support f
  have hrs (f : ℕ → ℝ) : (∑ n : ↥support, f n) = ∑ n ∈ support, f n :=
    Finset.sum_coe_sort support f
  have his (f : ι → ℝ) : (∑ i : ↥indices, f i) = ∑ i ∈ indices, f i :=
    Finset.sum_coe_sort indices f
  have h := sparse_exponential_polynomial_energy (I := ↥indices) (X := ↥support)
    (fun i => x i) (fun n => Real.log (n.val : ℝ)) (fun n => c n) N hU hE
    (fun i j hij => hsep i i.property j j.property (fun he => hij (Subtype.ext he)))
    (fun i j => hspan i i.property j j.property)
    (fun z hz => by
      rw [hcs (fun n => Complex.exp ((Real.log (n : ℝ) * z : ℝ) * Complex.I))]
      exact hkernel z hz)
  have hp (i : ι) : (∑ n : ↥support, c n *
      Complex.exp ((Real.log (n.val : ℝ) * x i : ℝ) * Complex.I)) =
      ∑ n ∈ support, c n * Complex.exp ((Real.log (n : ℝ) * x i : ℝ) * Complex.I) :=
    hcs (fun n => c n * Complex.exp ((Real.log (n : ℝ) * x i : ℝ) * Complex.I))
  simp_rw [hp] at h
  rw [hrs (fun n => ‖c n‖ ^ 2)] at h
  rw [his (fun i => ‖∑ n ∈ support, c n *
    Complex.exp ((Real.log (n : ℝ) * x i : ℝ) * Complex.I)‖ ^ 2)] at h
  simpa only [Fintype.card_coe] using h

end Bounty
end

section

namespace Bounty

section

variable
  (hs : List ℝ)
  (u c : ℝ)
  (k : ℕ)
  (x lo hi : ℝ)
  (hhs : ∀ h ∈ hs, 0 ≤ h)
  (hlo : 0 < lo)
  (hxlo : lo ≤ x+c)
  (hxhi : x+c+hs.sum ≤ hi)

include hs u c k x lo hi hhs hlo hxlo hxhi

theorem mixed_logarithmic_difference_abs_bounds_on_box
     :
    (hs.prod * |u| * ((k+hs.length).factorial:ℝ)) / hi^(k+hs.length+1) ≤
      |mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x| ∧
    |mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x| ≤
      (hs.prod * |u| * ((k+hs.length).factorial:ℝ)) / lo^(k+hs.length+1) := by
  have hx : 0 < x+c := lt_of_lt_of_le hlo hxlo
  have hsum : 0 ≤ hs.sum := List.sum_nonneg hhs
  have htop : 0 < x+c+hs.sum := by linarith
  have hprod : 0 ≤ hs.prod := List.prod_nonneg hhs
  have hn : 0 ≤ hs.prod * |u| * ((k+hs.length).factorial:ℝ) := by positivity
  obtain ⟨hl, hu⟩ := mixed_logarithmic_difference_abs_bounds hs u c k x hhs hx
  constructor
  · refine le_trans ?_ hl
    exact div_le_div_of_nonneg_left hn (by positivity)
      (pow_le_pow_left₀ (le_of_lt htop) hxhi _)
  · refine le_trans hu ?_
    exact div_le_div_of_nonneg_left hn (by positivity)
      (pow_le_pow_left₀ (le_of_lt hlo) hxlo _)

theorem mixed_logarithmic_difference_positive_bounds_on_box
    
    (hsign : 0 ≤ u * (-1:ℝ)^(k+hs.length)) :
    (hs.prod * |u| * ((k+hs.length).factorial:ℝ)) / hi^(k+hs.length+1) ≤
      mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x ∧
    mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x ≤
      (hs.prod * |u| * ((k+hs.length).factorial:ℝ)) / lo^(k+hs.length+1) := by
  have hh := mixed_logarithmic_difference_abs_bounds_on_box hs u c k x lo hi hhs hlo hxlo hxhi
  rwa [abs_of_nonneg (mixed_logarithmic_difference_nonneg hs u c k x hhs
    (lt_of_lt_of_le hlo hxlo) hsign)] at hh

theorem mixed_logarithmic_difference_negative_bounds_on_box
    
    (hsign : u * (-1:ℝ)^(k+hs.length) ≤ 0) :
    -((hs.prod * |u| * ((k+hs.length).factorial:ℝ)) / lo^(k+hs.length+1)) ≤
      mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x ∧
    mixedForwardDifference hs (logarithmicDerivativeChain u c (k+1)) x ≤
      -((hs.prod * |u| * ((k+hs.length).factorial:ℝ)) / hi^(k+hs.length+1)) := by
  have hh := mixed_logarithmic_difference_abs_bounds_on_box hs u c k x lo hi hhs hlo hxlo hxhi
  rw [abs_of_nonpos (mixed_logarithmic_difference_nonpos hs u c k x hhs
    (lt_of_lt_of_le hlo hxlo) hsign)] at hh
  constructor <;> linarith [hh.1, hh.2]

end





end Bounty
end

section

/- The derivative-order parameter yields an explicit fixed power saving. -/

namespace Bounty

theorem derivative_order_scalar_power_saving (B C N ε : ℝ) (k : ℕ)
    (hN : 1 ≤ N) (hε : 0 < ε) (hk : 2 ≤ k) (hC : 4 ≤ C)
    (hpow : 2 ≤ N^(ε/(2*(k : ℝ)))) (hB : B ≤ C*N^(-(ε/4))) :
    vanDerCorputScalarBound (Nat.floor (N^(ε/(2*(k : ℝ)))) : ℝ) B (k-2) ≤
      5^(k-2)*C*N^(-((ε/(2*(k : ℝ)))/(2:ℝ)^(k-2))) := by
  have hkR : (2 : ℝ) ≤ k := by exact_mod_cast hk
  have hθ : 0 ≤ ε/(2*(k : ℝ)) := by positivity
  have hle : ε/(2*(k : ℝ)) ≤ ε/4 :=
    div_le_div_of_nonneg_left hε.le (by norm_num) (by linarith)
  apply van_der_corput_floor_power_saving B C N (ε/(2*(k : ℝ))) (k-2) hN hθ hC hpow
  exact hB.trans (mul_le_mul_of_nonneg_left
    (Real.rpow_le_rpow_of_exponent_le hN (neg_le_neg hle)) (by linarith))




end Bounty
