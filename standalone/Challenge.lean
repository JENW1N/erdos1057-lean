theorem sum_stdAddChar_mul_eq_finiteFourierSum {q : ℕ} [NeZero q]
    (freq : Finset ℤ) (a : ℤ → ℂ) (k : ZMod q) :
    (∑ n ∈ freq, a n * ZMod.stdAddChar ((n : ZMod q) * k)) =
      finiteFourierSum freq a ((k.val : ℝ) / q) := by
  simp only [stdAddChar_mul_eq_fourier, finiteFourierSum]

def reducedResidues (q : ℕ) : Finset ℕ :=
  (Finset.range q).filter (fun a => a.Coprime q)

theorem reducedResidues_eq_unit_val_image (q : ℕ) [NeZero q] :
    reducedResidues q =
      (Finset.univ.filter (fun k : ZMod q => IsUnit k)).image ZMod.val := by
  classical
  ext a
  simp only [reducedResidues, Finset.mem_filter, Finset.mem_range, Finset.mem_image,
    Finset.mem_univ, true_and]
  constructor
  · rintro ⟨ha, hacop⟩
    exact ⟨(a : ZMod q), (ZMod.isUnit_iff_coprime a q).mpr hacop,
      ZMod.val_natCast_of_lt ha⟩
  · rintro ⟨k, hk, rfl⟩
    refine ⟨ZMod.val_lt k, ?_⟩
    apply (ZMod.isUnit_iff_coprime k.val q).mp
    simpa only [ZMod.natCast_zmod_val] using hk

theorem sum_unit_stdAddChar_energy_eq_reducedResidues {q : ℕ} [NeZero q]
    (freq : Finset ℤ) (a : ℤ → ℂ) :
    (∑ k ∈ Finset.univ.filter (fun k : ZMod q => IsUnit k),
      ‖∑ n ∈ freq, a n * ZMod.stdAddChar ((n : ZMod q) * k)‖ ^ 2) =
      ∑ k ∈ reducedResidues q, ‖finiteFourierSum freq a ((k : ℝ) / q)‖ ^ 2 := by
  classical
  rw [reducedResidues_eq_unit_val_image, Finset.sum_image]
  · apply Finset.sum_congr rfl
    intro k _
    rw [sum_stdAddChar_mul_eq_finiteFourierSum]
  · intro k _ l _ hkl
    exact ZMod.val_injective q hkl

def reducedFractionSamples (Q : Finset ℕ) : Finset (ℕ × ℕ) :=
  (Q.sigma reducedResidues).image (fun v => (v.2, v.1))

theorem mem_reducedFractionSamples {Q : Finset ℕ} {a q : ℕ} :
    (a, q) ∈ reducedFractionSamples Q ↔ q ∈ Q ∧ a ∈ reducedResidues q := by
  simp [reducedFractionSamples, Finset.mem_sigma, Prod.ext_iff]

theorem sum_reducedFractionSamples (Q : Finset ℕ) (F : ℕ × ℕ → ℝ) :
    (∑ v ∈ reducedFractionSamples Q, F v) =
      ∑ q ∈ Q, ∑ a ∈ reducedResidues q, F (a, q) := by
  rw [reducedFractionSamples, Finset.sum_image]
  · rw [Finset.sum_sigma]
  · rintro ⟨q, a⟩ _ ⟨r, b⟩ _ h
    simp only [Prod.mk.injEq] at h
    rcases h with ⟨rfl, rfl⟩
    rfl

theorem additive_large_sieve_moduli (Q : Finset ℕ) {R N : ℝ} (hR : 1 ≤ R)
    (hQ0 : ∀ q ∈ Q, 0 < q) (hQR : ∀ q ∈ Q, (q : ℝ) ≤ R)
    (freq : Finset ℤ) (a : ℤ → ℂ) (hN : 0 ≤ N)
    (hfreq : ∀ n ∈ freq, |(n : ℝ)| ≤ N) :
    (∑ q ∈ Q, ∑ k ∈ reducedResidues q,
      ‖finiteFourierSum freq a ((k : ℝ) / q)‖ ^ 2) ≤
      (6 + 8 * Real.pi) * (N + R ^ 2) * ∑ n ∈ freq, ‖a n‖ ^ 2 := by
  rw [← sum_reducedFractionSamples Q (fun v => ‖finiteFourierSum freq a ((v.1 : ℝ) / v.2)‖ ^ 2)]
  apply additive_large_sieve_reduced_fractions_coarse _ hR _ freq a hN hfreq
  intro v hv
  obtain ⟨hq, hk⟩ := mem_reducedFractionSamples.mp hv
  have hk' : v.1 < v.2 ∧ v.1.Coprime v.2 := by
    simpa only [reducedResidues, Finset.mem_filter, Finset.mem_range] using hk
  exact ⟨hQ0 _ hq, hk'.1, hk'.2, hQR _ hq⟩



end

