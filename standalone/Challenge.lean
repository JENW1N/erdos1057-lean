/- Full finite tensor trace coefficient, including initial and terminal tests. -/
noncomputable def ghostPhaseFiniteTensorTraceWeight {P : Type*} [Fintype P]
    {R : P → Type*} [∀ p, Fintype (R p)] [∀ p, DecidableEq (R p)]
    (isVisit : ℕ → Bool) (atgt asrc : ℕ → P → Bool)
    (htgt hsrc : ℕ → (p : P) → R p) (η β : ℕ → P → ℝ)
    (a0 : P → Bool) (β0 : P → ℝ) (an : P → Bool) {n : ℕ}
    (x : Fin (n + 1) → (p : P) → GhostPhaseState (R p)) : ℝ :=
  ∏ p, ghostPhaseFiniteTraceWeight isVisit (fun j => atgt j p) (fun j => asrc j p)
    (fun j => htgt j p) (fun j => hsrc j p) (fun j => η j p) (fun j => β j p)
    (a0 p) (β0 p) (an p) (fun j => x j p)

