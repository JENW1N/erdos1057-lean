/- Full-cell prime proxies: support, positivity, exact mass, and uniform size. -/

open Finset Filter

namespace Bounty

noncomputable def primeCellProxy (L S Y : ℝ) (n : ℕ) : ℝ :=
  if n ∈ roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L)) then
    primeCellProxyCoefficient L S Y else 0

theorem prime_cell_proxy_nonneg (L S Y : ℝ) (n : ℕ) :
    0 ≤ primeCellProxy L S Y n := by
  unfold primeCellProxy primeCellProxyCoefficient
  split <;> positivity

theorem prime_cell_proxy_ne_zero_mem {L S Y : ℝ} {n : ℕ}
    (h : primeCellProxy L S Y n ≠ 0) :
    n ∈ roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L)) := by
  by_contra hn
  exact h (by simp only [primeCellProxy, if_neg hn])

theorem prime_cell_proxy_avoids_small_primes {L S Y : ℝ} {n : ℕ}
    (h : primeCellProxy L S Y n ≠ 0) :
    ∀ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), ¬p ∣ n := by
  intro p hp hpn
  have hn := prime_cell_proxy_ne_zero_mem h
  have hpp : p.Prime := (mem_filter.mp hp).2
  have hpf : p ∈ n.primeFactors := Nat.mem_primeFactors.mpr
    ⟨hpp, hpn, (roughBand_pos hn).ne'⟩
  have hlarge := (mem_filter.mp hn).2 p hpf
  have hsmall : (p : ℝ) ≤ Real.exp (Real.sqrt L) :=
    (Nat.cast_le.mpr (mem_Ioc.mp (mem_filter.mp hp).1).2).trans
      (Nat.floor_le (Real.exp_pos _).le)
  exact (not_lt_of_ge hsmall) hlarge

section

variable
  {L S Y : ℝ}
  (hR : 0 < (roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L))).card)

include L S Y hR

theorem prime_cell_proxy_count_match  :
    (∑ n ∈ Ioc ⌊Y⌋₊ ⌊Real.exp (L^(-S))*Y⌋₊, primeCellProxy L S Y n) =
      ((primeBand Y (Real.exp (L^(-S))*Y)).card : ℝ) := by
  classical
  have hsubset : roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L)) ⊆
      Ioc ⌊Y⌋₊ ⌊Real.exp (L^(-S))*Y⌋₊ := fun _ hn => (mem_filter.mp hn).1
  rw [← sum_subset hsubset (fun n _ hn => by simp only [primeCellProxy, if_neg hn])]
  trans ∑ _n ∈ roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L)),
    primeCellProxyCoefficient L S Y
  · exact sum_congr rfl (fun n hn => by simp only [primeCellProxy, if_pos hn])
  simp only [sum_const, nsmul_eq_mul]
  unfold primeCellProxyCoefficient
  have hcard : ((roughBand Y (Real.exp (L^(-S))*Y) (Real.exp (Real.sqrt L))).card : ℝ) ≠ 0 :=
    (Nat.cast_pos.mpr hR).ne'
  field_simp

theorem prime_cell_proxy_full_cell_zero_sum  :
    (∑ n ∈ Ioc ⌊Y⌋₊ ⌊Real.exp (L^(-S))*Y⌋₊,
      ((if n.Prime then 1 else 0 : ℝ)-primeCellProxy L S Y n)) = 0 := by
  classical
  rw [sum_sub_distrib, prime_cell_proxy_count_match hR, sum_boole]
  exact sub_self _

end


theorem exists_prime_cell_proxy_uniform_bound {a : ℝ} (ha : 0 < a) :
    ∃ C : ℝ, 0 < C ∧ ∀ S : ℝ, ∀ᶠ L : ℝ in atTop, ∀ Y : ℝ,
      Real.exp (a*L) ≤ Y → ∀ n : ℕ,
        0 ≤ primeCellProxy L S Y n ∧ primeCellProxy L S Y n ≤ 1 ∧
        primeCellProxy L S Y n ≤
          C/(L*(∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1-1/(p : ℝ)))) := by
  obtain ⟨C, hC, hbound⟩ := exists_prime_cell_proxy_bound ha
  refine ⟨C, hC, ?_⟩
  intro S
  filter_upwards [hbound S, eventually_gt_atTop (0 : ℝ)] with L hb hL
  intro Y hY n
  have hV : 0 < ∏ p ∈ primeBand 0 (Real.exp (Real.sqrt L)), (1-1/(p : ℝ)) :=
    finite_prime_avoidance_product_pos _ (fun _ hp => (mem_filter.mp hp).2)
  unfold primeCellProxy
  split
  · exact hb Y hY
  · exact ⟨le_rfl, zero_le_one, by positivity⟩

end Bounty
end

