      (fun _ j => η (globalBirthFiniteIndex (n + 1) j).val)
      (fun a => β a.val) (fun a => V a.val.1) (fun _ => B) (fun _ => B) (n + 1) =
    ∏ a ∈ physicalPrimeGroups P groups, ghostPhaseRunHistory
