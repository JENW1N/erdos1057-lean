lemma kernelMassRestriction_coe :
  letI rootPolicy_hyperbolicMeasurableSpace := @OAI.CubicEisenstein.hyperbolicMeasurableSpace
  ∀ (K : Set KernelQuotient) (hK : MeasurableSet K)
    (f : KernelQuotientL2),
    (kernelMassRestriction K hK f : KernelQuotient→ℂ)=ᵐ[integralQuotientVolume globalKubotaKernel]
      K.indicator f :=
  letI rootPolicy_hyperbolicMeasurableSpace := @OAI.CubicEisenstein.hyperbolicMeasurableSpace
