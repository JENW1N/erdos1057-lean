    cubeLegTarget_finiteIndex p hp.ne_zero
  let : ∀i : CubeLegIndex p,(cubeLegTarget p hp.ne_zero i).IsFiniteRelIndex globalKubotaKernel :=
    fun i=>Subgroup.isFiniteRelIndex_of_finiteIndex
