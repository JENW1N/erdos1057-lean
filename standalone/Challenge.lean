    (e : UnrestrictedJointEvent n Δ D t B (fun g => (source g, q g))) : ℂ :=
  ∏ g, globalBirthBoundedEdgePhase (n g) (Δ g) (D g) (t g) B (target g) (H g)
    (source g, q g) (e g).1 (e g).2.1 (e g).2.2.1 (e g).2.2.2




theorem joint_raw_tensor_cutoff_edge_events
    (β : (g : Fin N) → P g → ℝ) (ρ : ℝ) (V : Fin N → ℝ)
    (row : (g : Fin N) → (GlobalBirthHistoryState (fun p => ZMod (n g p)) → ℂ) →
      GlobalBirthHistoryState (fun p => ZMod (n g p)) → ℂ)
    (hrows : ∀ g (K : GlobalBirthHistoryState (fun p => ZMod (n g p)) → ℂ),
      row g K (H g, boundedOrderedTupleToFinite (q g)) =
      ∑ e : UnrestrictedBoundedEvent (n g) (Δ g) (D g) (t g) B (source g, q g),
        (unrestrictedBoundedEventWeight (n g) (Δ g) (D g)
          (fun p => β g p / V g) ρ (V g) (t g) B (source g, q g) e : ℂ) *
        globalBirthBoundedEdgePhase (n g) (Δ g) (D g) (t g) B (target g) (H g)
          (source g, q g) e.1 e.2.1 e.2.2.1 e.2.2.2 *
        K (H g ∪ univ.image (unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B (source g, q g) e).1,
          boundedOrderedTupleToFinite (unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B (source g, q g) e).2))
    (F : GlobalBirthJointState (fun g p => ZMod (n g p)) → ℂ) :
    jointRawTensorCutoff B row F (fun g => (H g, boundedOrderedTupleToFinite (q g))) =
      ∑ e : UnrestrictedJointEvent n Δ D t B (fun g => (source g, q g)),
        (unrestrictedJointCutoffEventWeight n Δ D (fun g p => β g p / V g) ρ V t B
          (fun g => (source g, q g)) e : ℂ) *
        jointStateEdgePhase n Δ D t B source target H q e *
          F (jointStateEdgeRawTarget n Δ D t B source H q e) := by
  have hr := fin_tensor_row_events_at N
    row
    (fun g => (H g, boundedOrderedTupleToFinite (q g)))
    (fun g => UnrestrictedBoundedEvent (n g) (Δ g) (D g) (t g) B (source g, q g))
    (fun g e =>
      (H g ∪ univ.image (unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B (source g, q g) e).1,
        boundedOrderedTupleToFinite (unrestrictedBoundedEventTarget (n g) (Δ g) (D g) (t g) B (source g, q g) e).2))
    (fun g e =>
      (unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (fun p => β g p / V g)
        ρ (V g) (t g) B (source g, q g) e : ℂ) *
      globalBirthBoundedEdgePhase (n g) (Δ g) (D g) (t g) B (target g) (H g)
        (source g, q g) e.1 e.2.1 e.2.2.1 e.2.2.2)
    hrows (globalBirthJointRawCutoff B F)
  simp only [prod_mul_distrib, ← Complex.ofReal_prod] at hr
  change finTensorRow N row (globalBirthJointRawCutoff B F) (fun g => (H g, boundedOrderedTupleToFinite (q g))) =
    ∑ e : UnrestrictedJointEvent n Δ D t B (fun g => (source g, q g)),
      ((∏ g, unrestrictedBoundedEventWeight (n g) (Δ g) (D g) (fun p => β g p / V g)
        ρ (V g) (t g) B (source g, q g) (e g) : ℝ) : ℂ) *
      jointStateEdgePhase n Δ D t B source target H q e *
      globalBirthJointRawCutoff B F (jointStateEdgeRawTarget n Δ D t B source H q e) at hr
  unfold jointRawTensorCutoff
  change (if productTotalMemory (fun g => (source g, q g)) ≤ B then
    finTensorRow N row (globalBirthJointRawCutoff B F) (fun g => (H g, boundedOrderedTupleToFinite (q g))) else 0) = _
  rw [hr]
  have hout (e : UnrestrictedJointEvent n Δ D t B (fun g => (source g, q g))) :
      globalBirthJointRawCutoff B F (jointStateEdgeRawTarget n Δ D t B source H q e) =
      if productTotalMemory (unrestrictedJointEventTarget n Δ D t B (fun g => (source g, q g)) e) ≤ B
      then F (jointStateEdgeRawTarget n Δ D t B source H q e) else 0 := rfl
  simp only [hout]
  unfold unrestrictedJointCutoffEventWeight
  by_cases hi : productTotalMemory (fun g => (source g, q g)) ≤ B
  · rw [if_pos hi]
    apply sum_congr rfl
    intro e _
    by_cases ho : productTotalMemory (unrestrictedJointEventTarget n Δ D t B (fun g => (source g, q g)) e) ≤ B
    · have hb : productTotalMemory (fun g => (source g, q g)) ≤ B ∧
          productTotalMemory (unrestrictedJointEventTarget n Δ D t B (fun g => (source g, q g)) e) ≤ B := ⟨hi, ho⟩
      rw [if_pos ho, if_pos hb]
    · have hb : ¬ (productTotalMemory (fun g => (source g, q g)) ≤ B ∧
          productTotalMemory (unrestrictedJointEventTarget n Δ D t B (fun g => (source g, q g)) e) ≤ B) :=
        fun h => ho h.2
      rw [if_neg ho, if_neg hb]
      simp only [mul_zero, Complex.ofReal_zero, zero_mul]
  · rw [if_neg hi]
    symm
    apply sum_eq_zero
    intro e _
    have hb : ¬ (productTotalMemory (fun g => (source g, q g)) ≤ B ∧
        productTotalMemory (unrestrictedJointEventTarget n Δ D t B (fun g => (source g, q g)) e) ≤ B) :=
      fun h => hi h.1
    rw [if_neg hb]
    simp only [Complex.ofReal_zero, zero_mul]


end Joint
