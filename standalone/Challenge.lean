  · have hp := hrough (m : ℝ) (n : ℝ) hm1 (Nat.cast_nonneg _) hnexp r hrpos hrT χ hχ v hv
    have hb := hproxy Y hY r χ hχ hrT v hv m n hmn hYm hn
