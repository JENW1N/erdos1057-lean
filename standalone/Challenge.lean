theorem ghost_phase_joint_initial_tensor_point_mass
    (a : (g : Fin N) → P g → Bool) (β : (g : Fin N) → P g → ℝ)
    (z : GlobalBirthJointPhase R) :
    (∏ g, ∏ p, ghostPhaseInitial (a g p) (β g p) (z g p)) =
      if z = (fun g => ghostPhaseInitialState (a g)) then
        ∏ g, ∏ p, if a g p then β g p else 1
      else 0 := by
  simp_rw [ghost_phase_initial_tensor_point_mass]
  by_cases hz : z = (fun g => ghostPhaseInitialState (a g))
  · subst z
    simp only [ite_true]
  · rw [if_neg hz]
    have hg : ∃ g, z g ≠ ghostPhaseInitialState (a g) := by
      by_contra h
      apply hz
      funext g
      exact not_not.mp (not_exists.mp h g)
    obtain ⟨g, hg⟩ := hg
    exact prod_eq_zero (mem_univ g) (if_neg hg)

theorem ghost_phase_joint_initial_tensor_sum
    (a : (g : Fin N) → P g → Bool) (β : (g : Fin N) → P g → ℝ)
    (F : GlobalBirthJointPhase R → ℂ) :
    (∑ z, ((∏ g, ∏ p, ghostPhaseInitial (a g p) (β g p) (z g p) : ℝ) : ℂ) * F z) =
      ((∏ g, ∏ p, if a g p then β g p else 1 : ℝ) : ℂ) *
        F (fun g => ghostPhaseInitialState (a g)) := by
  simp_rw [ghost_phase_joint_initial_tensor_point_mass]
  simp only [apply_ite, Complex.ofReal_zero, ite_mul, zero_mul, sum_ite_eq', mem_univ, if_true]

variable [∀ g p, AddGroup (R g p)]

theorem global_birth_joint_initial_terminal_pairing
    (a : ℕ → (g : Fin N) → P g → Bool)
    (steps : (i : ℕ) → (g : Fin N) → GlobalBirthRawStep (R := R g) (a i g) (a (i + 1) g))
    (cap : ℕ → ℕ) (β : (g : Fin N) → P g → ℝ) (n : ℕ) :
    (∑ w, ((∏ g, ∏ p, ghostPhaseInitial (a 0 g p) (β g p) (w g p) : ℝ) : ℂ) *
      globalBirthJointPhaseHistory a steps cap n
        (fun z => ((∏ g, ∏ p, ghostPhaseTerminal (a n g p) (z g p) : ℝ) : ℂ)) w) =
      ((∏ g, ∏ p, if a 0 g p then β g p else 1 : ℝ) : ℂ) *
        globalBirthJointRawHistory a steps cap n
          (fun s => if ∀ g, (s g).2.1 = 0 then 1 else 0) (globalBirthJointInitial (a 0)) := by
  rw [ghost_phase_joint_initial_tensor_sum, global_birth_joint_raw_history_empty_boundary]
  rfl

