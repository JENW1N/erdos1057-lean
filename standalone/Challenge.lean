/- Exact phase convention for a normalized harmonic source at a positive integer. -/

namespace Bounty

theorem fourier_real_eq_phase (n : ℕ) (c : ℝ) :
    fourier (n : ℤ) (c : AddCircle (1 : ℝ)) =
      Complex.exp (Complex.I * (2*Real.pi*(c*n) : ℝ)) := by
  rw [fourier_coe_apply]
  congr 1
  push_cast
  ring

theorem normalized_source_mellin_phase {Z : ℝ} (hZ : 0 < Z)
    (a v t : ℝ) {n : ℕ} (hn : 0 < n) :
    physicalMellinPhase (-v) ((n : ℝ)/Z)*physicalPhase (-a) n*
        physicalMellinPhase t n =
      physicalMellinPhase v Z*physicalMellinPhase (t-a-v) n := by
  have hnR : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  unfold physicalMellinPhase physicalPhase
  rw [Real.log_div hnR hZ.ne']
  simp only [← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem normalized_harmonic_source_factor {Y Z : ℝ} (hY : 0 < Y) (hZ : 0 < Z)
    (a v t c : ℝ) (F : ℤ → ℂ) {n : ℕ} (hn : 0 < n) :
    (Y : ℂ)⁻¹*(harmonicCellSource Y Z a v F n *
      fourier (n : ℤ) (c : AddCircle (1 : ℝ)) * physicalMellinPhase t n) =
      physicalMellinPhase v Z *
        (F n * ((harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)/(n : ℂ)) *
          physicalMellinPhase (t-a-v) n *
          Complex.exp (Complex.I * (2*Real.pi*(c*n) : ℝ))) := by
  have hYC : (Y : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hY.ne'
  have hnC : (n : ℂ) ≠ 0 := by exact_mod_cast hn.ne'
  rw [fourier_real_eq_phase]
  unfold harmonicCellSource physicalMellinSource
  simp only [Int.cast_natCast, Int.natAbs_natCast, Complex.ofReal_div, Complex.ofReal_natCast]
  calc
    _ = (F n * ((harmonicCommonCutoff ((n : ℝ)/Y) : ℂ)/(n : ℂ)) *
        Complex.exp (Complex.I * (2*Real.pi*(c*n) : ℝ))) *
        (physicalMellinPhase (-v) ((n : ℝ)/Z)*physicalPhase (-a) n*
          physicalMellinPhase t n) := by field_simp
    _ = _ := by rw [normalized_source_mellin_phase hZ a v t hn]; ring

end Bounty
